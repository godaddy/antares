/pagination-11","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#default-active","content":"Use `defaultActiveIndex` to set the starting page in uncontrolled mode."},"820":{"id":"/docs/components/pagination-12","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#with-limit","content":"Limit the number of items shown per page. When `limit` is greater than 1, the number of pages (dots) is derived from `Math.ceil(total / limit)`. For example, 10 items with a limit of 3 produces 4 pages (dots)."},"821":{"id":"/docs/components/pagination-13","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#onchange-event","content":"The `onChange` callback fires with the new page index whenever the user navigates."},"822":{"id":"/docs/components/popover","page_id":"/docs/components/popover","type":"page","content":"Popover","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/popover"},"823":{"id":"/docs/components/popover-0","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover","content":"The Popover component is an overlay element positioned relative to a trigger element."},"824":{"id":"/docs/components/popover-1","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#installation","content":"Installation"},"825":{"id":"/docs/components/popover-2","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#examples","content":"Examples"},"826":{"id":"/docs/components/popover-3","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#default","content":"Default"},"827":{"id":"/docs/components/popover-4","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#custom-anchor","content":"Custom Anchor"},"828":{"id":"/docs/components/popover-5","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#close-button-and-header","content":"Close Button and Header"},"829":{"id":"/docs/components/popover-6","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#best-practices","content":"Best Practices"},"830":{"id":"/docs/components/popover-7","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#props","content":"Props"},"831":{"id":"/docs/components/popover-8","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#default","content":"Use it with `<PopoverTrigger>`, which wraps both the popover content and an interactive trigger element (for example, a `Button`)."},"832":{"id":"/docs/components/popover-9","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#custom-anchor","content":"To position a popover relative to a different element than its trigger, use the `triggerRef` and `isOpen` props instead of `<PopoverTrigger>`. `onOpenChange` is called when the user opens or closes the popover."},"833":{"id":"/docs/components/popover-10","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#close-button-and-header","content":"Use `showCloseButton` to show a close button in the popover header. Use the `header` prop to render content alongside it."},"834":{"id":"/docs/components/popover-11","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#best-practices","content":"Popover width is determined by its content, and it’s recommended to keep it under 400px."},"835":{"id":"/docs/components/pressable","page_id":"/docs/components/pressable","type":"page","content":"Pressable","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pressable"},"836":{"id":"/docs/components/pressable-0","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable","content":"A wrapperless interaction primitive that adds accessible press behavior to a single child element."},"837":{"id":"/docs/components/pressable-1","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#features","content":"Features"},"838":{"id":"/docs/components/pressable-2","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#installation","content":"Installation"},"839":{"id":"/docs/components/pressable-3","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#examples","content":"Examples"},"840":{"id":"/docs/components/pressable-4","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#default","content":"Default"},"841":{"id":"/docs/components/pressable-5","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#customization","content":"Customization"},"842":{"id":"/docs/components/pressable-6","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#accessibility","content":"Accessibility"},"843":{"id":"/docs/components/pressable-7","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#best-practices","content":"Best Practices"},"844":{"id":"/docs/components/pressable-8","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#troubleshooting","content":"Troubleshooting"},"845":{"id":"/docs/components/pressable-9","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#props","content":"Props"},"846":{"id":"/docs/components/pressable-10","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Adds accessible press behavior to an existing visual component."},"847":{"id":"/docs/components/pressable-11","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Applies interaction states directly to the child without adding a wrapper element."},"848":{"id":"/docs/components/pressable-12","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Supports pointer, touch, and keyboard interactions through React Aria."},"849":{"id":"/docs/components/pressable-13","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Preserves the child's layout, shape, and visual styling."},"850":{"id":"/docs/components/pressable-14","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#default","content":"Add accessible press behavior to an existing visual component without adding a wrapper element.\nThe callback is invoked for pointer, touch, and keyboard activation."},"851":{"id":"/docs/components/pressable-15","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Pressable` when an existing visual component or layout surface needs press behavior while keeping its own DOM element, layout, and styles. The child must be a single element that forwards its ref and accepts the props applied by React Aria."},"852":{"id":"/docs/components/pressable-16","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Button` when you need a standard button control with button-specific sizing, layout, and visual variants."},"853":{"id":"/docs/components/pressable-17","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Pass `onPress` for the action instead of wiring separate pointer and keyboard handlers:"},"854":{"id":"/docs/components/pressable-18","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"`Pressable` accepts the React Aria press props, including `onPress`, `onPressStart`, `onPressEnd`, `onPressUp`, and `onPressChange`."},"855":{"id":"/docs/components/pressable-19","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Use a semantic interactive element when possible. For a non-semantic child such as `Avatar` or `Box`, provide an appropriate interactive role and an accessible name:"},"856":{"id":"/docs/components/pressable-20","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Do not add `role=\"button\"` to a native `<button>` or `<a>` unless you intentionally need to change its semantics. Use a dedicated semantic component such as `Button`, `LinkButton`, `Menu`, or `ToggleButton` when that control's meaning is known."},"857":{"id":"/docs/components/pressable-21","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Prefer a native interactive element or a semantic Antares component when the interaction meaning is known."},"858":{"id":"/docs/components/pressable-22","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Use `Pressable` for custom visual surfaces that need a press interaction without an additional DOM wrapper."},"859":{"id":"/docs/components/pressable-23","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Give every pressable control an accessible name with visible text, `aria-label`, or `aria-labelledby`."},"860":{"id":"/docs/components/pressable-24","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/do