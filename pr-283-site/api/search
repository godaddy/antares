gs":[],"url":"/docs/components/chart/line-chart#city-temperature","content":"City temperature"},"1515":{"id":"/docs/components/chart/line-chart-25","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#browser-usage","content":"Browser usage"},"1516":{"id":"/docs/components/chart/line-chart-26","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#rtl","content":"RTL"},"1517":{"id":"/docs/components/chart/line-chart-27","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#customization","content":"Customization"},"1518":{"id":"/docs/components/chart/line-chart-28","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#data-attributes","content":"Data Attributes"},"1519":{"id":"/docs/components/chart/line-chart-29","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#component-customization","content":"Component Customization"},"1520":{"id":"/docs/components/chart/line-chart-30","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#accessibility","content":"Accessibility"},"1521":{"id":"/docs/components/chart/line-chart-31","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#aria-support","content":"ARIA Support"},"1522":{"id":"/docs/components/chart/line-chart-32","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#best-practices","content":"Best Practices"},"1523":{"id":"/docs/components/chart/line-chart-33","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"When to Use LineChart"},"1524":{"id":"/docs/components/chart/line-chart-34","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#troubleshooting","content":"Troubleshooting"},"1525":{"id":"/docs/components/chart/line-chart-35","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#chart-not-sizing-or-empty","content":"Chart Not Sizing or Empty"},"1526":{"id":"/docs/components/chart/line-chart-36","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#dates-not-displaying-correctly","content":"Dates Not Displaying Correctly"},"1527":{"id":"/docs/components/chart/line-chart-37","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#tooltip-or-crosshair-not-showing","content":"Tooltip or Crosshair Not Showing"},"1528":{"id":"/docs/components/chart/line-chart-38","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#props","content":"Props"},"1529":{"id":"/docs/components/chart/line-chart-39","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#default","content":"One line, a time-scale X axis, and almost nothing else configured - the everyday starting point. You give the chart a \\`series\\` array and it reads \\`x\\`/\\`y\\` from each point."},"1530":{"id":"/docs/components/chart/line-chart-40","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#multiple-series","content":"Several lines sharing one X axis, with a legend naming each of them. Reach for this when the comparison between series is the story."},"1531":{"id":"/docs/components/chart/line-chart-41","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#gridlines","content":"\\`xGridlines\\` and \\`yGridlines\\` add faint lines across the plot so it is easier to read a value back off an axis."},"1532":{"id":"/docs/components/chart/line-chart-42","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#titles","content":"\\`xTitle\\` and \\`yTitle\\` label what each axis actually measures, e.g. \"Month\" and \"Temperature (°F)\"."},"1533":{"id":"/docs/components/chart/line-chart-43","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#labels","content":"\\`xLabels\\` and \\`yLabels\\` toggle the tick labels on each axis. Turn them off for sparklines or when the surrounding UI already names the values."},"1534":{"id":"/docs/components/chart/line-chart-44","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#ticks","content":"\\`xTickMarks\\` and \\`yTickMarks\\` draw the short lines at each tick value, which helps tie a label to its exact position on the axis."},"1535":{"id":"/docs/components/chart/line-chart-45","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#baselines","content":"\\`xBaseline\\` and \\`yBaseline\\` control the main axis lines themselves. Dropping them gives a lighter, more editorial chart."},"1536":{"id":"/docs/components/chart/line-chart-46","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#legend","content":"\\`legendPosition\\` puts the legend above or below the plot, or hides it with \\`null\\`. Multi-series charts get a bottom legend by default."},"1537":{"id":"/docs/components/chart/line-chart-47","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#axis-and-tooltip-formatting","content":"\\`xTickFormat\\` and \\`yTickFormat\\` shape the axis labels - dates, currency, units, percentages - and the tooltip follows the same formatting."},"1538":{"id":"/docs/components/chart/line-chart-48","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-accessors","content":"When your data does not use \\`x\\`/\\`y\\`, point \\`xAccessor\\` and \\`yAccessor\\` at the fields it does use (here \\`date\\` and \\`value\\`) instead of reshaping the data first."},"1539":{"id":"/docs/components/chart/line-chart-49","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#missing-values","content":"A \\`null\\` Y value breaks the line instead of drawing through the gap, so missing data reads as missing rather than as a straight interpolation."},"1540":{"id":"/docs/components/chart/line-chart-50","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#fixed-domain","content":"\\`xDomain\\` and \\`yDomain\\` pin the visible range. Use them to keep a fixed scale, or to keep several charts comparable."},"1541":{"id":"/docs/components/chart/line-chart-51","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#nice-values","content":"\\`xNice\\` and \\`yNice\\` round the domain out to friendlier numbers (e.g. 0.2 to 1.0), so ticks land on values people expect."},"1542":{"id":"/docs/components/chart/line-chart-52","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#zero-included","content":"\\`xZero\\` and \\`yZero\\` stretch the domain to include zero. Worth doing when the absolute size of the values matters, not just their movement."},"1543":{"id":"/docs/components/chart/line-chart-53","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-ticks","content":"Choose the ticks yourself with \\`xTickValues\\`/\\`yTickValues\\`, or just ask for roughly how many you want with \\`xNumTicks\\`/\\`yNumTicks\\`."},"1544":{"id":"/docs/components/chart/line-chart-54","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#band-padding","content":"\\`xPaddingOuter\\` and \\`yPaddingOuter\\` add breathing room at the ends of a band or point scale so the first and last values are not pinned to the edges."},"1545":{"id":"/docs/components/chart/line-chart-55","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#tooltip-disabled","content":"Turn off the hover affordances entirely with \\`tooltip=\\{false}\\`, \\`showCrosshair=\\{false}\\`, and \\`showDataPoints=\\{false}\\` - useful for a static or print-style chart."},"1546":{"id":"/docs/components/chart/line-chart-56","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#crosshair-only","content":"Keep the vertical crosshair for orientation while hiding the tooltip and the data point glyphs."},"1547":{"id":"/docs/components/chart/line-chart-57","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip-formatting","content":"\\`tooltipValueFormatter\\` shapes only the tooltip values, so you can show full currency or units there while the axis stays compact."},"1548":{"id":"/docs/components/chart/line-chart-58","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#fixed-size","content":"Pass \\`width\\` and \\`height\\` to size the chart explicitly instead of letting it fill its container."},"1549":{"id":"/docs/components/chart/line-chart-59","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#bitcoin-price","content":"A real time series: date formatting on the X axis, currency on the Y axis, gridlines, and a nice-rounded domain."},"1550":{"id":"/docs/components/chart/line-chart-60","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#city-temperature","content":"Several cities over the same period, with a legend and a shared time axis - the multi-series case as it usually looks in a product."},"1551":{"id":"/docs/components/chart/line-chart-61","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#browser-usage","content":"A categorical X axis (band scale) with several series and percentage formatting, for when the X values are names rather than numbers or dates."},"1552":{"id":"/docs/components/chart/line-chart-62","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#rtl","content":"The chart follows the current layout direction, normally detected from the browser or system settings. In right-to-left it mirrors the axes and labels; this example forces RTL so you can see it in a left-to-right page."},"1553":{"id":"/docs/components/chart/line-chart-63","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#data-attributes","content":"The chart root exposes data attributes that reflect prop state for styling:"},"1554":{"id":"/docs/components/chart/line-chart-64","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#data-attributes","content":"**Chart container:** `data-width`, `data-height`, `data-x-labels`, `data-y-labels`, `data-x-labels-vertical`, `data-x-baseline`, `data-y-baseline`, `data-x-tick-marks`, `data-y-tick-marks`"},"1555":{"id":"/docs/components/chart/line-chart-65","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#component-customization","content":"Use the `className` prop on the chart container to add or override styles:"},"1556":{"id":"/docs/components/chart/line-chart-66","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"Provide &#x2A;*`aria-label`** to describe the chart (e.g. \"Monthly sales revenue from January to May 2024\")."},"1557":{"id":"/docs/components/chart/line-chart-67","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"Use &#x2A;*`desc`** for a longer description rendered in the SVG `<desc>` for screen readers."},"1558":{"id":"/docs/components/chart/line-chart-68","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"The component sets ARIA attributes on interactive and structural elements as needed."},"1559":{"id":"/docs/components/chart/line-chart-69","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Use for trends over time or along a continuous scale."},"1560":{"id":"/docs/components/chart/line-chart-70","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Use when comparing a few series (e.g. 2-5 lines); avoid too many overlapping lines."},"1561":{"id":"/docs/components/chart/line-chart-71","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Prefer a single chart with a legend over multiple small charts when comparing the same X range."},"1562":{"id":"/docs/components/chart/line-chart-72","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#chart-not-sizing-or-empty","content":"Ensure the chart has a non-zero size. Place it in a container with explicit dimensions or use `width` and `height`:"},"1563":{"id":"/docs/components/chart/line-chart-73","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#dates-not-displaying-correctly","content":"Use `xType=\"time\"` when the X-axis values are Date objects:"},"1564":{"id":"/docs/components/chart/line-chart-74","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#tooltip-or-crosshair-not-showing","content":"Ensure `tooltip`, `showCrosshair`, or `showDataPoints` are not set to `false`, and that the chart receives pointer events (e.g. no overlay blocking hover)."},"1565":{"id":"/docs/components/layout/flex","page_id":"/docs/components/layout/flex","type":"page","content":"Flex","breadcrumbs":["Docs","Components","Layout"],"tags":[],"url":"/docs/components/layout/flex"},"1566":{"id":"/docs/components/layout/flex-0","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex","content":"One-dimensional layout component for arranging children in rows or columns with alignment and spacing control"},"1567":{"id":"/docs/components/layout/flex-1","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#installation","content":"Installation"},"1568":{"id":"/docs/components/layout/flex-2","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#scale-sizes","content":"Scale Sizes"},"1569":{"id":"/docs/components/layout/flex-3","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#examples","content":"Examples"},"1570":{"id":"/docs/components/layout/flex-4","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#default","content":"Default"},"1571":{"id":"/docs/components/layout/flex-5","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#direction","content":"Direction"},"1572":{"id":"/docs/components/layout/flex-6","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#alignment","content":"Alignment"},"1573":{"id":"/docs/components/layout/flex-7","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#gap","content":"Gap"},"1574":{"id":"/docs/components/layout/flex-8","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#wrap","content":"Wrap"},"1575":{"id":"/docs/components/layout/flex-9","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#navbar","content":"Navbar"},"1576":{"id":"/docs/components/layout/flex-10","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#sidebar","content":"Sidebar"},"1577":{"id":"/docs/components/layout/flex-11","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#rtl-support","content":"RTL Support"},"1578":{"id":"/docs/components/layout/flex-12","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#design-tokens","content":"Design Tokens"},"1579":{"id":"/docs/components/layout/flex-13","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#migration-from-uxbox","content":"Migration from @ux/box"},"1580":{"id":"/docs/components/layout/flex-14","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#props","content":"Props"},"1581":{"id":"/docs/components/layout/flex-15","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex","content":"`Flex` is a one-dimensional layout component for arranging children in rows or columns with alignment and spacing control. It extends `Box`, inheriting all `Box` capabilities (padding, elevation, rounding, self-alignment, and polymorphic `as` prop)."},"1582":{"id":"/docs/components/layout/flex-16","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex","content":"**Recommended default**: Use `Flex` for most layouts. Since it extends `Box`, you get all `Box` capabilities without needing to nest components."},"1583":{"id":"/docs/components/layout/flex-17","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#scale-sizes","content":"We use the same scale sizes as the `Box` component. For more information, see the **Box component documentation**."},"1584":{"id":"/docs/components/layout/flex-18","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#default","content":"Basic horizontal flex layout with gap."},"1585":{"id":"/docs/components/layout/flex-19","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#direction","content":"The \\`direction\\` prop controls the main axis orientation."},"1586":{"id":"/docs/components/layout/flex-20","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#alignment","content":"Use \\`justifyContent\\` for main-axis distribution and \\`alignItems\\` for cross-axis alignment."},"1587":{"id":"/docs/components/layout/flex-21","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#gap","content":"The \\`gap\\` prop controls spacing between children. Use \\`rowGap\\` and \\`columnGap\\` for independent control."},"1588":{"id":"/docs/components/layout/flex-22","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#wrap","content":"The \\`wrap\\` prop controls whether items wrap to multiple lines."},"1589":{"id":"/docs/components/layout/flex-23","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#navbar","content":"A common navigation bar pattern using space-between and nested Flex containers."},"1590":{"id":"/docs/components/layout/flex-24","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#sidebar","content":"A sidebar layout demonstrating Flex child props (\\`flexShrink\\`, \\`flexGrow\\`)."},"1591":{"id":"/docs/components/layout/flex-25","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#rtl-support","content":"Flex uses CSS logical properties which automatically adapt to RTL layouts. The `direction` prop values (`row`, `row-reverse`) respect the document direction."},"1592":{"id":"/docs/components/layout/flex-26","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#design-tokens","content":"All gap and padding values are derived from the theme. If no theme is provided, default values are used. This ensures consistency across the design system."},"1593":{"id":"/docs/components/layout/flex-27","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#migration-from-uxbox","content":"Current `@ux/box`"},"1594":{"id":"/docs/components/layout/flex-28","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#migration-from-uxbox","content":"New Pattern"},"1595":{"id":"/docs/components/layout/flex-29","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#migration-from-uxbox","content":"`<Box orientation=\"horizontal\">`"},"1596":{"id":"/docs/components/layout/flex-30","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#migration-from-uxbox","content":"`<Flex direction=\"row\" >`"},"1597":{"id":"/docs/components/layout/flex-31","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#migration-from-uxbox","content":"`<Box orientation=\"vertical\">`"},"1598":{"id":"/docs/components/layout/flex-32","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#migration-from-uxbox","content":"`<Flex direction=\"column\" >`"},"1599":{"id":"/docs/components/layout/flex-33","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#migration-from-uxbox","content":"`<Box blockAlignChildren=\"center\">`"},"1600":{"id":"/docs/components/layout/flex-34","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#migration-from-uxbox","content":"`<Flex justifyContent=\"center\">`"},"1601":{"id":"/docs/components/layout/flex-35","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#migration-from-uxbox","content":"`<Box inlineAlignChildren=\"center\">`"},"1602":{"id":"/docs/components/layout/flex-36","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#migration-from-uxbox","content":"`<Flex alignItems=\"center\">`"},"1603":{"id":"/docs/components/layout/flex-37","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#props","content":"The `Flex` component accepts the following props:"},"1604":{"id":"/docs/components/layout/box","page_id":"/docs/components/layout/box","type":"page","content":"Box","breadcrumbs":["Docs","Components","Layout"],"tags":[],"url":"/docs/components/layout/box"},"1605":{"id":"/docs/components/layout/box-0","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box","content":"Polymorphic layout component providing consistent spacing, elevation, rounding, and self-alignment"},"1606":{"id":"/docs/components/layout/box-1","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#installation","content":"Installation"},"1607":{"id":"/docs/components/layout/box-2","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#scale-sizes","content":"Scale Sizes"},"1608":{"id":"/docs/components/layout/box-3","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#polymorphic-as-details","content":"Polymorphic `as` details"},"1609":{"id":"/docs/components/layout/box-4","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#examples","content":"Examples"},"1610":{"id":"/docs/components/layout/box-5","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#padding","content":"Padding"},"1611":{"id":"/docs/components/layout/box-6","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#elevation","content":"Elevation"},"1612":{"id":"/docs/components/layout/box-7","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#rounding","content":"Rounding"},"1613":{"id":"/docs/components/layout/box-8","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#polymorphic-as-prop","content":"Polymorphic as Prop"},"1614":{"id":"/docs/components/layout/box-9","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#alignment","content":"Alignment"},"1615":{"id":"/docs/components/layout/box-10","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#rtl-support","content":"RTL Support"},"1616":{"id":"/docs/components/layout/box-11","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#design-tokens","content":"Design Tokens"},"1617":{"id":"/docs/components/layout/box-12","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#props","content":"Props"},"1618":{"id":"/docs/components/layout/box-13","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box","content":"`Box` is a polymorphic layout component that renders as any HTML element or custom component via the `as` prop. It provides consistent spacing, elevation, rounding, and self-alignment within flex or grid containers."},"1619":{"id":"/docs/components/layout/box-14","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box","content":"**Important**: Since `Flex` and `Grid` extend `Box`, prefer them for layouts. Use `Box` only when you need a non-flex, non-grid container."},"1620":{"id":"/docs/components/layout/box-15","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"The spacing props use semantic t-shirt sizes for padding, gap, and other spacing properties:"},"1621":{"id":"/docs/components/layout/box-16","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`xs` - Extra small spacing"},"1622":{"id":"/docs/components/layout/box-17","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`sm` - Small spacing"},"1623":{"id":"/docs/components/layout/box-18","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`md` - Medium spacing"},"1624":{"id":"/docs/components/layout/box-19","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`lg` - Large spacing"},"1625":{"id":"/docs/components/layout/box-20","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`xl` - Extra large spacing"},"1626":{"id":"/docs/components/layout/box-21","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`2xl` - 2x extra large spacing"},"1627":{"id":"/docs/components/layout/box-22","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"Custom CSS values are also supported for edge cases."},"1628":{"id":"/docs/components/layout/box-23","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#polymorphic-as-details","content":"**HTML Elements:** When using `as=\"button\"`, TypeScript enforces button-specific props like `type`, `disabled`, and `onClick`."},"1629":{"id":"/docs/components/layout/box-24","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#polymorphic-as-details","content":"**Custom Components:** When using `as={MyComponent}`, Box accepts that component's props. If there's a prop name conflict, Box's props take priority."},"1630":{"id":"/docs/components/layout/box-25","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#polymorphic-as-details","content":"**Typed Refs:** Refs are correctly typed based on the `as` value - `useRef<HTMLButtonElement>` works with `as=\"button\"`."},"1631":{"id":"/docs/components/layout/box-26","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#padding","content":"The padding props support t-shirt sizes and CSS logical properties for RTL support."},"1632":{"id":"/docs/components/layout/box-27","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#elevation","content":"The elevation prop adds visual depth using box-shadow."},"1633":{"id":"/docs/components/layout/box-28","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#rounding","content":"The rounding prop sets border-radius. Use \\`full\\` for fully rounded corners."},"1634":{"id":"/docs/components/layout/box-29","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#polymorphic-as-prop","content":"Box is fully polymorphic - the \\`as\\` prop allows rendering as any HTML element or custom component while preserving type-safe props."},"1635":{"id":"/docs/components/layout/box-30","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#alignment","content":"Self-alignment props allow Box to position itself within flex or grid containers."},"1636":{"id":"/docs/components/layout/box-31","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#rtl-support","content":"Box uses CSS logical properties (`padding-inline-start`, `padding-block-end`, etc.) which automatically adapt to RTL layouts. No additional configuration is needed."},"1637":{"id":"/docs/components/layout/box-32","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#design-tokens","content":"All spacing, elevation, and rounding values are derived from the theme. If no theme is provided, default values are used. This ensures consistency across the design system."},"1638":{"id":"/docs/components/layout/box-33","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#props","content":"The `Box` component accepts the following props:"},"1639":{"id":"/docs/components/layout/grid","page_id":"/docs/components/layout/grid","type":"page","content":"Grid","breadcrumbs":["Docs","Components","Layout"],"tags":[],"url":"/docs/components/layout/grid"},"1640":{"id":"/docs/components/layout/grid-0","page_id":"/docs/components/layout/grid","tags":[],"type":"text","url":"/docs/components/layout/grid","conten