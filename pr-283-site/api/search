cs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#controlled","content":"Use `isExpanded` and `onExpandedChange` to drive state externally."},"608":{"id":"/docs/components/inline-drawer-22","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#sidebar-navigation","content":"A rail whose content stays visible when collapsed is a composition, not a mode: drive `isExpanded` yourself, render always-visible children (no `InlineDrawerPanel`), and let `minSize`/`maxSize` size the rail. Use numeric (px) sizes so the width animates; intrinsic keywords like `min-content`/`max-content` fit the content exactly but don't animate."},"609":{"id":"/docs/components/inline-drawer-23","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Key"},"610":{"id":"/docs/components/inline-drawer-24","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Action"},"611":{"id":"/docs/components/inline-drawer-25","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"`Enter` / `Space`"},"612":{"id":"/docs/components/inline-drawer-26","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Toggle via the slotted trigger"},"613":{"id":"/docs/components/inline-drawer-27","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"`Tab`"},"614":{"id":"/docs/components/inline-drawer-28","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Move focus through the content"},"615":{"id":"/docs/components/inline-drawer-29","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#aria","content":"A `<Button slot=\"trigger\">` gets `aria-expanded` + `aria-controls` wired to the `InlineDrawerPanel` automatically (via RAC Disclosure)."},"616":{"id":"/docs/components/inline-drawer-30","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#aria","content":"For the sidebar rail, the toggle is your own control (e.g. a `ToggleButton`) — give icon-only buttons an `aria-label`, and the content stays in the DOM and accessible since nothing is hidden."},"617":{"id":"/docs/components/inline-drawer-31","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"Accordion → `Button slot=\"trigger\"` + `InlineDrawerPanel`. Sidebar rail → controlled state + always-visible children."},"618":{"id":"/docs/components/inline-drawer-32","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"For the rail, use numeric (px) `minSize`/`maxSize` so the width animates; `min-content`/`max-content` fit the content exactly but won't animate."},"619":{"id":"/docs/components/inline-drawer-33","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"`placement` does not flip in RTL; the side is decided by document/flex order."},"620":{"id":"/docs/components/inline-drawer-34","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"Don't nest InlineDrawers."},"621":{"id":"/docs/components/listbox","page_id":"/docs/components/listbox","type":"page","content":"ListBox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/listbox"},"622":{"id":"/docs/components/listbox-0","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox","content":"ListBox is a selectab