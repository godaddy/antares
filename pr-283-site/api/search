ayout/grid","tags":[],"type":"text","url":"/docs/components/layout/grid#gap","content":"The \\`gap\\` prop controls spacing between grid cells. Use \\`rowGap\\` and \\`columnGap\\` for independent control."},"1660":{"id":"/docs/components/layout/grid-20","page_id":"/docs/components/layout/grid","tags":[],"type":"text","url":"/docs/components/layout/grid#named-areas","content":"Use \\`areas\\` to define named grid regions. Children use the \\`gridArea\\` prop for placement."},"1661":{"id":"/docs/components/layout/grid-21","page_id":"/docs/components/layout/grid","tags":[],"type":"text","url":"/docs/components/layout/grid#responsive-grid","content":"Use CSS \\`auto-fill\\` and \\`minmax()\\` for responsive column counts without media queries."},"1662":{"id":"/docs/components/layout/grid-22","page_id":"/docs/components/layout/grid","tags":[],"type":"text","url":"/docs/components/layout/grid#alignment","content":"Use \\`justifyItems\\` and \\`alignItems\\` to control default alignment of all grid children."},"1663":{"id":"/docs/components/layout/grid-23","page_id":"/docs/components/layout/grid","tags":[],"type":"text","url":"/docs/components/layout/grid#form","content":"A common two-column form pattern with auto-sized label column."},"1664":{"id":"/docs/components/layout/grid-24","page_id":"/docs/components/layout/grid","tags":[],"type":"text","url":"/docs/components/layout/grid#rtl-support","content":"Grid uses CSS logical properties which automatically adapt to RTL layouts. Grid areas and alignment respect the document direction."},"1665":{"id":"/docs/components/layout/grid-25","page_id":"/docs/components/layout/grid","tags":[],"type":"text","url":"/docs/components/layout/grid#grid-vs-flex","content":"Use Case"},"1666":{"id":"/docs/components/layout/grid-26","page_id":"/docs/components/layout/grid","tags":[],"type":"text","url":"/docs/components/layout/grid#grid-vs-flex","content":"Recommended"},"1667":{"id":"/docs/components/layout/grid-27","page_id":"/docs/component