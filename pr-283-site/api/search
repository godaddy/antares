Field","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/number-field"},"770":{"id":"/docs/components/number-field-0","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field","content":"NumberField is a numeric input with optional label, description, error message, min/max/step, and increment/decrement stepper buttons. Use it in forms for quantities, amounts, or percentages."},"771":{"id":"/docs/components/number-field-1","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#installation","content":"Installation"},"772":{"id":"/docs/components/number-field-2","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#examples","content":"Examples"},"773":{"id":"/docs/components/number-field-3","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#default","content":"Default"},"774":{"id":"/docs/components/number-field-4","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-controlled","content":"Number Field Controlled"},"775":{"id":"/docs/components/number-field-5","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-invalid","content":"Number Field Invalid"},"776":{"id":"/docs/components/number-field-6","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-disabled","content":"Number Field Disabled"},"777":{"id":"/docs/components/number-field-7","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-hide-stepper","content":"Number Field Hide Stepper"},"778":{"id":"/docs/components/number-field-8","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-value-scale","content":"Number Field Value Scale"},"779":{"id":"/docs/components/number-field-9","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#format-options-numbering-system","content":"Format options (numbering system)"},"780":{"id":"/docs/components/number-field-10","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-sizes","content":"Number Field Sizes"},"781":{"id":"/docs/components/number-field-11","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#accessibility","content":"Accessibility"},"782":{"id":"/docs/components/number-field-12","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#keyboard","content":"Keyboard"},"783":{"id":"/docs/components/number-field-13","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#aria-and-labeling","content":"ARIA and labeling"},"784":{"id":"/docs/components/number-field-14","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#best-practices","content":"Best practices"},"785":{"id":"/docs/components/number-field-15","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#props","content":"Props"},"786":{"id":"/docs/components/number-field-16","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#default","content":"Minimal usage with label, placeholder, and min/max."},"787":{"id":"/docs/components/number-field-17","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-controlled","content":"Use `value` and `onChange` for controlled state."},"788":{"id":"/docs/components/number-field-18","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-invalid","content":"Use `isInvalid` with `errorMessage` for validation feedback."},"789":{"id":"/docs/components/number-field-19","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-disabled","content":"Use `isDisabled` to prevent input."},"790":{"id":"/docs/components/number-field-20","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-hide-stepper","content":"Use `hideStepper` to show only the input without +/- buttons."},"791":{"id":"/docs/components/number-field-21","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-value-scale","content":"Use `minValue`, `maxValue`, and `step` to set the allowed values. Steps are calculated from the minimum value."},"792":{"id":"/docs/components/number-field-22","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#format-options-numbering-system","content":"By default, NumberField displays the value using the numbering system for the user's locale. Use the `formatOptions` prop to override the numbering system by setting the Unicode numbering system locale extension."},"793":{"id":"/docs/components/number-field-23","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-sizes","content":"Compare the supported `md` and `sm` visual sizes."},"794":{"id":"/docs/components/number-field-24","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#keyboard","content":"When focus is in the input (and the field is not read-only), keyboard behavior follows common spinbutton-style conventions:"},"795":{"id":"/docs/components/number-field-25","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#keyboard","content":"**Arrow Up** / **Arrow Down** (or **Up** / **Down**): increase or decrease by `step`"},"796":{"id":"/docs/components/number-field-26","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#keyboard","content":"**Page Up** / **Page Down**: larger increase or decrease when supported"},"797":{"id":"/docs/components/number-field-27","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#keyboard","content":"**Home** / **End**: jump to `minValue` or `maxValue` when those props are set"},"798":{"id":"/docs/components/number-field-28","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#keyboard","content":"Stepper buttons are real buttons and follow standard button keyboard activation. Use &#x2A;*`incrementAriaLabel`*&#x2A; and &#x2A;*`decrementAriaLabel`** when the default labels are not enough in your locale or UI."},"799":{"id":"/docs/components/number-field-29","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#aria-and-labeling","content":"The input is associated with the visible label and optional description and error content for assistive technologies."},"800":{"id":"/docs/components/number-field-30","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#aria-and-labeling","content":"Invalid and required states are exposed to assistive technologies when you use `isInvalid`, `errorMessage`, and `isRequired`."},"801":{"id":"/docs/components/number-field-31","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#aria-and-labeling","content":"Set &#x2A;*`isWheelDisabled`** if the value should not change when the user scrolls with a pointer wheel while the field is focused."},"802":{"id":"/docs/components/number-field-32","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#best-practices","content":"Pair &#x2A;*`isInvalid`*&#x2A; with &#x2A;*`errorMessage`** so users get both visual and programmatic feedback."},"803":{"id":"/docs/components/number-field-33","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#best-practices","content":"Remember valid steps start from &#x2A;*`minValue`**."},"804":{"id":"/docs/components/number-field-34","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#best-practices","content":"Use &#x2A;*`isDisabled`*&#x2A; when the value cannot be changed; use &#x2A;*`isReadOnly`** when the value should be visible but not editable. Do not use them interchangeably."},"805":{"id":"/docs/components/number-field-35","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#best-practices","content":"For currency or units, ensure &#x2A;*`formatOptions`** (and locale) match what users are allowed to type."},"806":{"id":"/docs/components/number-field-36","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#props","content":"The `NumberField` component accepts the following props:"},"807":{"id":"/docs/components/pagination","page_id":"/docs/components/pagination","type":"page","content":"Pagination","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pagination"},"808":{"id":"/docs/components/pagination-0","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination","content":"A pagination component with prev/next buttons and dot indicators, configurable page limits, and optional visibility of controls and dots"},"809":{"id":"/docs/components/pagination-1","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#installation","con