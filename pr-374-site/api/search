ontrol for use inside a field."},"784":{"id":"/docs/components/input-1","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#installation","content":"Installation"},"785":{"id":"/docs/components/input-2","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#examples","content":"Examples"},"786":{"id":"/docs/components/input-3","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#default","content":"Default"},"787":{"id":"/docs/components/input-4","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#props","content":"Props"},"788":{"id":"/docs/components/input-5","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#input","content":"Input"},"789":{"id":"/docs/components/input-6","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input","content":"`Input` is the single-line control inside a field, not a field on its own. Prefer `TextField` or `NumberField` as the parent; see those components for fuller examples."},"790":{"id":"/docs/components/input-7","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#default","content":"Input inside TextField."},"791":{"id":"/docs/components/listbox","page_id":"/docs/components/listbox","type":"page","content":"ListBox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/listbox"},"792":{"id":"/docs/components/listbox-0","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox","content":"ListBox is a selectable collection of items rendered inline. Use it for non-popover pickers, inline lists, or as a building block for higher-level components like Select."},"793":{"id":"/docs/components/listbox-1","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#features","content":"Feature