omponents/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Layout primitive**: `ListBox` and `ListBoxItem` accept layout props (`gap`, `padding`, etc.) — they extend `FlexOwnProps`."},"805":{"id":"/docs/components/listbox-13","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Composes into other components**: `Select` uses `ListBox` internally; reach for `ListBox` directly when you need an inline list rather than a popover dropdown."},"806":{"id":"/docs/components/listbox-14","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**React Aria integration**: Built on React Aria ListBox for accessibility, keyboard navigation, and typeahead."},"807":{"id":"/docs/components/listbox-15","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"`ListBox` requires either `aria-label` or `aria-labelledby`. For a labeled, popover-style picker, prefer `Select`."},"808":{"id":"/docs/components/listbox-16","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#default","content":"Single selection with static children. Use `aria-label` to give the listbox an accessible name."},"809":{"id":"/docs/components/listbox-17","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-controlled","content":"Use `selectedKeys` and `onSelectionChange` for controlled state."},"810":{"id":"/docs/components/listbox-18","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-multiple","content":"Set `selectionMode=\"multiple\"` to allow multiple values. `selectedKeys` is a `Set<Key>` (or the literal `'all'`)."},"811":{"id":"/docs/components/menu","page_id":"/docs/components/menu","type":"page","content":"Menu","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/menu"},"812":{"id":"/docs/components/menu-0","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"Accessible dropdown menu with grouping, multi-select checkbox items, leading icons, and submenus."},"813":{"id":"/docs/components/menu-1","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#features","content":"Features"},"814":{"id":"/docs/components/menu-2","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#installation","content":"Installation"},"815":{"id":"/docs/components/menu-3","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#examples","content":"Examples"},"816":{"id":"/docs/components/menu-4","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#default","content":"Default"},"817":{"id":"/docs/components/menu-5","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#controlled","content":"Controlled"},"818":{"id":"/docs/components/menu-6","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#bottom-sheet","content":"Bottom Sheet"},"819":{"id":"/docs/components/menu-7","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#groups","content":"Groups"},"820":{"id":"/docs/components/menu-8","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#multiple-selection","content":"Multiple Selection"},"821":{"id":"/docs/components/menu-9","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#rich-content-from-an-item","content":"Rich Content From an Item"},"822":{"id":"/docs/components/menu-10","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#single-selection","content":"Single Selection"},"823":{"id":"/docs/components/menu-11","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#sizes","content":"Sizes"},"824":{"id":"/docs/components/menu-12","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenu","content":"Submenu"},"825":{"id":"/docs/components/menu-13","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#accessibility","content":"Accessibility"},"826":{"id":"/docs/components/menu-14","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#best-practices","content":"Best Practices"},"827":{"id":"/docs/components/menu-15","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#props","content":"Props"},"828":{"id":"/docs/components/menu-16","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menu","content":"Menu"},"829":{"id":"/docs/components/menu-17","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menutrigger","content":"MenuTrigger"},"830":{"id":"/docs/components/menu-18","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menugroup","content":"MenuGroup"},"831":{"id":"/docs/components/menu-19","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menuitem","content":"MenuItem"},"832":{"id":"/docs/components/menu-20","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menuseparator","content":"MenuSeparator"},"833":{"id":"/docs/components/menu-21","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenutrigger","content":"SubmenuTrigger"},"834":{"id":"/docs/components/menu-22","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"An accessible dropdown menu built on React Aria. It supports grouping with optional\ntitles, multi-select checkbox items, leading icons, submenus, and two sizes. It\nreuses Antares' `Popover` for the overlay and `Checkbox` indicator for selection."},"835":{"id":"/docs/components/menu-23","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Grouping with an optional title via `MenuGroup`, plus `MenuSeparator` dividers"},"836":{"id":"/docs/components/menu-24","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Multi-select groups: set `selectionMode=\"multiple\"` on a `MenuGroup` to render\nits items as checkboxes, while other groups stay plain action items"},"837":{"id":"/docs/components/menu-25","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Optional leading `icon` per item; links (`href`) and disabled items"},"838":{"id":"/docs/components/menu-26","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Submenus via `SubmenuTrigger`"},"839":{"id":"/docs/components/menu-27","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Two sizes (`sm`, `md`); set `size` explicitly on each submenu `Menu`"},"840":{"id":"/docs/components/menu-28","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Usable anchored to a trigger or standalone (e.g. inside a bottom-sheet `Drawer`)"},"841":{"id":"/docs/components/menu-29","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#default","content":"A trigger with plain action items."},"842":{"id":"/docs/components/menu-30","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#controlled","content":"`MenuTrigger` exposes its open state via `isOpen`/`onOpenChange`,\nwhich can be used to drive the rotation of a chevron icon."},"843":{"id":"/docs/components/menu-31","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#bottom-sheet","content":"On small screens a menu often reads better as a bottom sheet than an anchored\npopover. Since `Menu` works standalone, drop it into a bottom `Drawer`."},"844":{"id":"/docs/components/menu-32","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#groups","content":"Labeled groups separated by dividers, a multi-select checkbox group mixed with\nplain action groups, leading icons, a disabled item, and a link."},"845":{"id":"/docs/components/menu-33","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#multiple-selection","content":"A `MenuGroup` with `selectionMode=\"multiple\"` renders its items as checkboxes.\nDrive the checked items with `selectedKeys` + `onSelectionChange` or\nseed them uncontrolled with `defaultSelectedKeys`. Keys correspond to each\n`MenuItem`'s `id`."},"846":{"id":"/docs/components/menu-34","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#rich-content-from-an-item","content":"A `Menu` is a collection, so it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger` children. Rich content inside a `Menu`\nor submenu is not supported. To show a `Calendar`, let the item close the\nmenu from `onAction` and open a separate `Popover` anchored to the trigger\nwith `triggerRef`."},"847":{"id":"/docs/components/menu-35","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#single-selection","content":"A `MenuGroup` with `selectionMode=\"single\"` lets one item be selected at a time.\nDrive it with `selectedKeys` + `onSelectionChange` or seed it uncontrolled with\n`defaultSelectedKeys`. Keys correspond to each `MenuItem`'s `id`."},"848":{"id":"/docs/components/menu-36","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#sizes","content":"`size` controls item density. Shown here as two standalone menus so both\nsizes are visible at once; in practice you set `size` on the `Menu` inside a\n`MenuTrigger`."},"849":{"id":"/docs/components/menu-37","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#submenu","content":"Nested menus via `SubmenuTrigger`."},"850":{"id":"/docs/components/menu-38","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Space/Enter**: activate an item; **Escape**: close"},"851":{"id":"/docs/components/menu-39","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Up/Down**: move between items; **Home/End**: first/last"},"852":{"id":"/docs/components/menu-40","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Right/Left**: open/close a submenu"},"853":{"id":"/docs/components/menu-41","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Type to select**: jump to a matching item (string labels are used as `textValue`)"},"854":{"id":"/docs/components/menu-42","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"Multi-select items use RAC's `menuitemcheckbox` role; the checkbox indicator is\ndecorative (`aria-hidden`) and the item owns interaction"},"855":{"id":"/docs/components/menu-43","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Give each selectable `MenuItem` a stable `id`, and provide the `Menu` an\n`aria-label` when there is no visible label."},"856":{"id":"/docs/components/menu-44","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Use a leading `icon` for recognition, not as the only label - keep a text label."},"857":{"id":"/docs/components/menu-45","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Reserve checkbox groups for multi-select; use plain groups for one-shot actions."},"858":{"id":"/docs/components/menu-46","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"A `Menu` is a collection: it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger`. For rich content (a `Calendar`, a form),\nclose the menu from `onAction` and open a separate `Popover` anchored with\n`triggerRef` instead of putting it in a submenu."},"859":{"id":"/docs/components/alert","page_id":"/docs/components/alert","type":"page","content":"Alert","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/alert"},"860":{"id":"/docs/components/alert-0","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert","content":"In-page alerts are non-intrusive notifications within a webpage, providing users with timely information or feedback without disrupting their experience."},"861":{"id":"/docs/components/alert-1","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#installation","content":"Installation"},"862":{"id":"/docs/components/alert-2","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#examples","content":"Examples"},"863":{"id":"/docs/components/alert-3","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#default","content":"Default"},"864":{"id":"/docs/components/alert-4","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#emphasis-variants","content":"Emphasis Variants"},"865":{"id":"/docs/components/alert-5","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#dismissible","content":"Dismissible"},"866":{"id":"/docs/components/alert-6","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#with-action","content":"With Action"},"867":{"id":"/docs/components/alert-7","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#accessibility","content":"Accessibility"},"868":{"id":"/docs/components/alert-8","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#keyboard","content":"Keyboard"},"869":{"id":"/docs/components/alert-9","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#screen-readers","content":"Screen readers"},"870":{"id":"/docs/components/alert-10","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#dismiss-button-label","content":"Dismiss button label"},"871":{"id":"/docs/components/alert-11","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#best-practices","content":"Best Practices"},"872":{"id":"/docs/components/alert-12","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#props","content":"Props"},"873":{"id":"/docs/components/alert-13","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#alert","content":"Alert"},"874":{"id":"/docs/components/alert-14","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#default","content":"A minimal alert with a title and body text."},"875":{"id":"/docs/components/alert-15","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#emphasis-variants","content":"All 7 emphasis categories. Each variant carries a distinct visual accent and semantic icon so the type of message is never communicated by color alone."},"876":{"id":"/docs/components/alert-16","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#dismissible","content":"When an `onClose` callback is provided, a dismiss button is rendered. The component does not manage its own visibility — the parent is responsible for unmounting or hiding the alert when `onClose` fires."},"877":{"id":"/docs/components/alert-17","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#with-action","content":"Pass a `Button` to the `actions` slot to give the user a clear path to resolve the alert."},"878":{"id":"/docs/components/alert-18","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Key"},"879":{"id":"/docs/components/alert-19","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Description"},"880":{"id":"/docs/components/alert-20","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"`Tab`"},"881":{"id":"/docs/components/alert-21","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Moves focus to the dismiss button or action button"},"882":{"id":"/docs/components/alert-22","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"`Space` / `Enter`"},"883":{"id":"/docs/components/alert-23","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Activates the focused button"},"884":{"id":"/docs/components/alert-24","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#screen-readers","content":"The alert container uses `role=\"alert\"`, which creates an ARIA live region. When an alert is rendered or its content changes, screen readers announce the message automatically — the user does not need to navigate to the alert to hear it."},"885":{"id":"/docs/components/alert-25","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#dismiss-button-label","content":"The dismiss button defaults to `aria-label=\"Close\"`. Override it via `ariaLabels={{ close: '...' }}` to provide more specific context for screen readers (e.g. `\"Dismiss payment warning\"`). This is especially useful when multiple alerts are visible at the same time."},"886":{"id":"/docs/components/alert-26","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Write alert content from the user's perspective: describe what happened and what they can do next, not the underlying technical error."},"887":{"id":"/docs/components/alert-27","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Use `critical` only when the user truly cannot continue without resolving the issue. Overusing it reduces its impact."},"888":{"id":"/docs/components/alert-28","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Always provide a `title` when the alert includes a dismiss button — it improves the reading experience for screen reader users."},"889":{"id":"/docs/components/alert-29","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"When using `actions`, prefer `secondary` or `tertiary` Button variants. Avoid placing a primary action inside an alert."},"890":{"id":"/docs/components/alert-30","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Do not stack multiple alerts of the same emphasis; consolidate the message into a single alert."},"891":{"id":"/docs/components/metrics-lockup","page_id":"/docs/components/metrics-lockup","type":"page","content":"MetricsLockup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/metrics-lockup"},"892":{"id":"/docs/components/metrics-lockup-0","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"The MetricsLockup component displays a single metric with an optional title, info tooltip, trend indicator, and description."},"893":{"id":"/docs/components/metrics-lockup-1","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#installation","content":"Installation"},"894":{"id":"/docs/components/metrics-lockup-2","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#examples","content":"Examples"},"895":{"id":"/docs/components/metrics-lockup-3","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#default","content":"Default"},"896":{"id":"/docs/components/metrics-lockup-4","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#with-trend","content":"With Trend"},"897":{"id":"/docs/components/metrics-lockup-5","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#compact","content":"Compact"},"898":{"id":"/docs/components/metrics-lockup-6","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#accessibility","content":"Accessibility"},"899":{"id":"/docs/components/metrics-lockup-7","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#keyboard","content":"Keyboard"},"900":{"id":"/docs/components/metrics-lockup-8","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#aria","content":"ARIA"},"901":{"id":"/docs/components/metrics-lockup-9","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#best-practices","content":"Best Practices"},"902":{"id":"/docs/components/metrics-lockup-10","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#props","content":"Props"},"903":{"id":"/docs/components/metrics-lockup-11","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#metricslockup","content":"MetricsLockup"},"904":{"id":"/docs/components/metrics-lockup-12","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"MetricsLockup displays a metric value prominently, with an optional title and tooltip for context, an optional trend icon to show direction of change, and a description label below the value."},"905":{"id":"/docs/components/metrics-lockup-13","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#default","content":"A metric with a title, info tooltip, value, and description."},"906":{"id":"/docs/components/metrics-lockup-14","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#with-trend","content":"Use the `trend` prop to show a directional icon next to the description. Accepts `'positive'`, `'negative'`, or `'neutral'`."},"907":{"id":"/docs/components/metrics-lockup-15","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#compact","content":"Use the `compact` prop to render the metric value and description inline rather than stacked."},"908":{"id":"/docs/components/metrics-lockup-16","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Key"},"909":{"id":"/docs/components/metrics-lockup-17","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Description"},"910":{"id":"/docs/components/metrics-lockup-18","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Tab"},"911":{"id":"/docs/components/metrics-lockup-19","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Moves focus to the info trigger button and shows the tooltip"},"912":{"id":"/docs/components/metrics-lockup-20","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Escape"},"913":{"id":"/docs/components/metrics-lockup-21","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Closes the tooltip"},"914":{"id":"/docs/components/metrics-lockup-22","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger button uses `aria-label=\"More information\"` to describe its purpose."},"915":{"id":"/docs/components/metrics-lockup-23","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The tooltip uses `role=\"tooltip\"` and is associated with the info trigger via `aria-describedby`."},"916":{"id":"/docs/components/metrics-lockup-24","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger has a minimum touch target of 44×44px, achieved via a CSS pseudo-element, to meet WCAG 2.5.5."},"917":{"id":"/docs/components/metrics-lockup-25","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"Keep tooltip content concise and informative."},"918":{"id":"/docs/components/metrics-lockup-26","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"The `data` prop accepts strings or numbers — format currency and percentages before passing them in."},"919":{"id":"/docs/components/metrics-lockup-27","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`titleInfo` requires `title` to be set — the info icon is contextually tied to the title label. If `title` is absent, `titleInfo` has no effect."},"920":{"id":"/docs/components/metrics-lockup-28","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`trend` is intended to accompany `description` to provide temporal context (e.g. \"↑ +3% vs. last month\"). A trend icon alone, with no description, leaves the direction unanchored (\"up since *when*?\"). If `description` is not provided, `trend` has no effect."},"921":{"id":"/docs/components/modal","page_id":"/docs/components/modal","type":"page","content":"Modal","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/modal"},"922":{"id":"/docs/components/modal-0","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"The Modal component presents a dialog window over the page that focuses the user's attention on a single task or piece of information."},"923":{"id":"/docs/components/modal-1","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#installation","content":"Installation"},"924":{"id":"/docs/components/modal-2","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#examples","content":"Examples"},"925":{"id":"/docs/components/modal-3","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#default","content":"Default"},"926":{"id":"/docs/components/modal-4","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#controlled","content":"Controlled"},"927":{"id":"/docs/components/modal-5","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#scrollable","content":"Scrollable"},"928":{"id":"/docs/components/modal-6","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#triggerless","content":"Triggerless"},"929":{"id":"/docs/components/modal-7","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#size","content":"Size"},"930":{"id":"/docs/components/modal-8","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#with-text-lockup","content":"With Text Lockup"},"931":{"id":"/docs/components/modal-9","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#accessibility","content":"Accessibility"},"932":{"id":"/docs/components/modal-10","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#keyboard-interaction","content":"Keyboard interaction"},"933":{"id":"/docs/components/modal-11","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#aria","content":"ARIA"},"934":{"id":"/docs/components/modal-12","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#best-practices","content":"Best Practices"},"935":{"id":"/docs/components/modal-13","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#props","content":"Props"},"936":{"id":"/docs/components/modal-14","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#modal","content":"Modal"},"937":{"id":"/docs/components/modal-15","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#modaltrigger","content":"ModalTrigger"},"938":{"id":"/docs/components/modal-16","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"`ModalTrigger` wraps a trigger button and a `<Modal>`, handling open state automatically. Based on RAC `DialogTrigger`."},"939":{"id":"/docs/components/modal-17","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"The modal is a `SizeProvider`. It opens at the size of the scope around its trigger, even though it renders in a portal, and `size` overrides that."},"940":{"id":"/docs/components/modal-18","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#default","content":"Compose a Modal from a `Heading slot=\"title\"`, a `CloseButton`, `Content`, and a\n`ButtonGroup`. `ModalTrigger` opens the Modal and manages its open/close state."},"941":{"id":"/docs/components/modal-19","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#controlled","content":"Pass `isOpen` and `onOpenChange` to `ModalTrigger` to control the open state externally."},"942":{"id":"/docs/components/modal-20","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#scrollable","content":"When the content is taller than the viewport, the `Content` region scrolls while the title\nrow and the `ButtonGroup` stay pinned."},"943":{"id":"/docs/components/modal-21","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#triggerless","content":"`Modal` accepts `isOpen` and `onOpenChange` directly, so it can be controlled without a\n`ModalTrigger`. Useful when the modal is opened from several places at once."},"944":{"id":"/docs/components/modal-22","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#size","content":"`size` sets the modal's text, controls, and spacing. Without it, the modal follows the size\nscope around its trigger."},"945":{"id":"/docs/components/modal-23","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#with-text-lockup","content":"A `TextLockup` in the content keeps its own title. The modal's `Heading slot=\"title\"` still names\nthe dialog."},"946":{"id":"/docs/components/modal-24","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Key"},"947":{"id":"/docs/components/modal-25","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Action"},"948":{"id":"/docs/components/modal-26","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"`Tab`"},"949":{"id":"/docs/components/modal-27","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Moves focus to the next focusable element inside the modal"},"950":{"id":"/docs/components/modal-28","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"`Escape`"},"951":{"id":"/docs/components/modal-29","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Closes the modal (unless `isKeyboardDismissDisabled`)"},"952":{"id":"/docs/components/modal-30","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#aria","content":"`role=\"dialog\"` is applied automatically by the underlying React Aria `Dialog`"},"953":{"id":"/docs/components/modal-31","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#aria","content":"Focus is trapped within the modal while open and returned to the trigger on close"},"954":{"id":"/docs/components/modal-32","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#best-practices","content":"Always include a `Heading slot=\"title\"` so the dialog has an accessible name; otherwise pass `aria-label`/`aria-labelledby` on `<Modal>`"},"955":{"id":"/docs/components/modal-33","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#best-practices","content":"Pair every action button with `slot=\"close\"` when it should dismiss the modal"},"956":{"id":"/docs/components/modal-34","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#best-practices","content":"Set `isDismissable={false}` to prevent outside-click dismissal for required confirmations; to also block `Escape`, pass `isKeyboardDismissDisabled`"},"957":{"id":"/docs/components/number-field","page_id":"/docs/components/number-field","type":"page","content":"NumberField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/number-field"},"958":{"id":"/docs/components/number-field-0","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field","content":"NumberField is a composed numeric input with min/max/step and optional increment/decrement stepper buttons. Use it in forms for quantities, amounts, or percentages."},"959":{"id":"/docs/components/number-field-1","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#features","content":"Features"},"960":{"id":"/docs/components/number-field-2","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#installation","content":"Installation"},"961":{"id":"/docs/components/number-field-3","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#examples","content":"Examples"},"962":{"id":"/docs/components/number-field-4","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#default","content":"Default"},"963":{"id":"/docs/components/number-field-5","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#controlled","content":"Controlled"},"964":{"id":"/docs/components/number-field-6","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#invalid","content":"Invalid"},"965":{"id":"/docs/components/number-field-7","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#disabled","content":"Disabled"},"966":{"id":"/docs/components/number-field-8","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#hide-stepper","content":"Hide Stepper"},"967":{"id":"/docs/components/number-field-9","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#value-scale","content":"Value Scale"},"968":{"id":"/docs/components/number-field-10","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#format-options-numbering-system","content":"Format options (numbering system)"},"969":{"id":"/docs/components/number-field-11","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#sizes","content":"Sizes"},"970":{"id":"/docs/components/number-field-12","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#text-steppers","content":"Text Steppers"},"971":{"id":"/docs/components/number-field-13","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#props","content":"Props"},"972":{"id":"/docs/components/number-field-14","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#numberfield","content":"NumberField"},"973":{"id":"/docs/components/number-field-15","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Composable interior**: Compose `Label`, the control, `Text slot=\"description\"`, and `FieldError`. Nothing is added for you, and what you write keeps the order you wrote it in"},"974":{"id":"/docs/components/number-field-16","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Steppers**: A stepper is a `Group` holding `Button slot=\"decrement\"`, an `Input`, and `Button slot=\"increment\"`. Left empty, each button takes its icon and `variant=\"control\"` from the field, so no icon imports are needed. Compose a bare `Input` instead for a plain numeric input"},"975":{"id":"/docs/components/number-field-17","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Sizes**: The field is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets its label, input, steppers, description, and error; without it, the field follows the surrounding scope"},"976":{"id":"/docs/components/number-field-18","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Value scale**: `minValue`, `maxValue`, `step`, and `formatOptions` configure the numeric behavior"},"977":{"id":"/docs/components/number-field-19","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"978":{"id":"/docs/components/number-field-20","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"979":{"id":"/docs/components/number-field-21","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#default","content":"Minimal usage with a `Label`, min/max, and stepper `Button`s."},"980":{"id":"/docs/components/number-field-22","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#controlled","content":"Use `value` and `onChange` for controlled state."},"981":{"id":"/docs/components/number-field-23","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#invalid","content":"Use `isInvalid` with a `FieldError` for validation feedback."},"982":{"id":"/docs/components/number-field-24","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#disabled","content":"Use `isDisabled` to prevent input."},"983":{"id":"/docs/components/number-field-25","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#hide-stepper","content":"Compose without stepper `Button`s for a plain numeric input."},"984":{"id":"/docs/components/number-field-26","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#value-scale","content":"Use `minValue`, `maxValue`, and `step` to set the allowed values. Steps are calculated from the minimum value."},"985":{"id":"/docs/components/number-field-27","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#format-options-numbering-system","content":"By default, NumberField displays the value using the numbering system for the user's locale. Use the `formatOptions` prop to override the numbering system by setting the Unicode numbering system locale extension."},"986":{"id":"/docs/components/number-field-28","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#sizes","content":"`size` sets the label, input, and steppers. Without it, the field follows the surrounding size\nscope."},"987":{"id":"/docs/components/number-field-29","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#text-steppers","content":"Compose with `children` to replace the stepper icons with your own content, such as text."},"988":{"id":"/docs/components/pagination","page_id":"/docs/components/pagination","type":"page","content":"Pagination","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pagination"},"989":{"id":"/docs/components/pagination-0","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination","content":"A pagination component with prev/next buttons and dot indicators, configurable page limits, and optional visibility of controls and dots"},"990":{"id":"/docs/components/pagination-1","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#installation","content":"Installation"},"991":{"id":"/docs/components/pagination-2","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#examples","content":"Examples"},"992":{"id":"/docs/components/pagination-3","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#default","content":"Default"},"993":{"id":"/docs/components/pagination-4","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#controlled","content":"Controlled"},"994":{"id":"/docs/components/pagination-5","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#default-active","content":"Default Active"},"995":{"id":"/docs/components/pagination-6","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#with-limit","content":"With Limit"},"996":{"id":"/docs/components/pagination-7","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#onchange-event","content":"onChange Event"},"997":{"id":"/docs/components/pagination-8","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#props","content":"Props"},"998":{"id":"/docs/components/pagination-9","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#pagination","content":"Pagination"},"999":{"id":"/docs/components/pagination-10","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#default","content":"The default pagination is uncontrolled. It renders prev/next buttons and one dot per page. The `total` prop sets the number of items."},"1000":{"id":"/docs/components/pagination-11","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#controlled","content":"Pass `activeIndex` and `onChange` to control the active page externally."},"1001":{"id":"/docs/components/pagination-12","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#default-active","content":"Use `defaultActiveIndex` to set the starting page in uncontrolled mode."},"1002":{"id":"/docs/components/pagination-13","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#with-limit","content":"Limit the number of items shown per page. When `limit` is greater than 1, the number of pages (dots) is derived from `Math.ceil(total / limit)`. For example, 10 items with a limit of 3 produces 4 pages (dots)."},"1003":{"id":"/docs/components/pagination-14","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#onchange-event","content":"The `onChange` callback fires with the new page index whenever the user navigates."},"1004":{"id":"/docs/components/popover","page_id":"/docs/components/popover","type":"page","content":"Popover","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/popover"},"1005":{"id":"/docs/components/popover-0","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover","content":"The Popover component is an overlay element positioned relative to a trigger element."},"1006":{"id":"/docs/components/popover-1","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#installation","content":"Installation"},"1007":{"id":"/docs/components/popover-2","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#examples","content":"Examples"},"1008":{"id":"/docs/components/popover-3","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#default","content":"Default"},"1009":{"id":"/docs/components/popover-4","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#custom-anchor","content":"Custom Anchor"},"1010":{"id":"/docs/components/popover-5","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#title-and-close-button","content":"Title and Close Button"},"1011":{"id":"/docs/components/popover-6","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#accessibility","content":"Accessibility"},"1012":{"id":"/docs/components/popover-7","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#keyboard","content":"Keyboard"},"1013":{"id":"/docs/components/popover-8","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#aria","content":"ARIA"},"1014":{"id":"/docs/components/popover-9","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#best-practices","content":"Best Practices"},"1015":{"id":"/docs/components/popover-10","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#props","content":"Props"},"1016":{"id":"/docs/components/popover-11","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#popover","content":"Popover"},"1017":{"id":"/docs/components/popover-12","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#popovertrigger","content":"PopoverTrigger"},"1018":{"id":"/docs/components/popover-13","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover","content":"`PopoverTrigger` wraps a trigger button and a `<Popover>`, handling open state and positioning automatically.\nBased on RAC `DialogTrigger`. To anchor a popover to an element it doesn't wrap, pass `triggerRef` instead."},"1019":{"id":"/docs/components/popover-14","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#default","content":"Use it with `<PopoverTrigger>`, which wraps both the popover content and an interactive trigger element (for example, a `Button`)."},"1020":{"id":"/docs/components/popover-15","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#custom-anchor","content":"To position a popover relative to a different element than its trigger, use the `triggerRef` and `isOpen` props instead of `<PopoverTrigger>`. `onOpenChange` is called when the user opens or closes the popover."},"1021":{"id":"/docs/components/popover-16","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#title-and-close-button","content":"Add a `Heading slot=\"title\"` and a `CloseButton` for a titled, dismissible popover. The heading\nalso gives the dialog its accessible name."},"1022":{"id":"/docs/components/popover-17","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Key"},"1023":{"id":"/docs/components/popover-18","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Action"},"1024":{"id":"/docs/components/popover-19","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"`Enter/Space`"},"1025":{"id":"/docs/components/popover-20","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Opens the popover from its trigger"},"1026":{"id":"/docs/components/popover-21","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"`Escape`"},"1027":{"id":"/docs/components/popover-22","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Closes the popover"},"1028":{"id":"/docs/components/popover-23","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#aria","content":"`role=\"dialog\"` is applied automatically by the underlying React Aria `Dialog`"},"1029":{"id":"/docs/components/popover-24","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#aria","content":"A `Heading slot=\"title\"` labels the dialog via `aria-labelledby`. Without one, a popover inside\na `PopoverTrigger` falls back to being labelled by its trigger; standing alone with\n`triggerRef` it needs an explicit `aria-label`"},"1030":{"id":"/docs/components/popover-25","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#best-practices","content":"Pass an `aria-label` when anchoring with `triggerRef` instead of wrapping a `PopoverTrigger`,\nsince there is no trigger to borrow the name from."},"1031":{"id":"/docs/components/popover-26","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#best-practices","content":"Popover width is determined by its content, and it's recommended to keep it under 400px."},"1032":{"id":"/docs/components/pressable","page_id":"/docs/components/pressable","type":"page","content":"Pressable","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pressable"},"1033":{"id":"/docs/components/pressable-0","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable","content":"A wrapperless interaction primitive that adds accessible press behavior to a single child element."},"1034":{"id":"/docs/components/pressable-1","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#features","content":"Features"},"1035":{"id":"/docs/components/pressable-2","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#installation","content":"Installation"},"1036":{"id":"/docs/components/pressable-3","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#examples","content":"Examples"},"1037":{"id":"/docs/components/pressable-4","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#default","content":"Default"},"1038":{"id":"/docs/components/pressable-5","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#customization","content":"Customization"},"1039":{"id":"/docs/components/pressable-6","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#accessibility","content":"Accessibility"},"1040":{"id":"/docs/components/pressable-7","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#best-practices","content":"Best Practices"},"1041":{"id":"/docs/components/pressable-8","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#troubleshooting","content":"Troubleshooting"},"1042":{"id":"/docs/components/pressable-9","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#props","content":"Props"},"1043":{"id":"/docs/components/pressable-10","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#pressable","content":"Pressable"},"1044":{"id":"/docs/components/pressable-11","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Adds accessible press behavior to an existing visual component."},"1045":{"id":"/docs/components/pressable-12","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Applies interaction states directly to the child without adding a wrapper element."},"1046":{"id":"/docs/components/pressable-13","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Supports pointer, touch, and keyboard interactions through React Aria."},"1047":{"id":"/docs/components/pressable-14","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Preserves the child's layout, shape, and base visual styling while adding state feedback."},"1048":{"id":"/docs/components/pressable-15","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#default","content":"Add accessible press behavior to an existing visual component without adding a wrapper element.\nThe surface supports pointer, touch, and keyboard activation."},"1049":{"id":"/docs/components/pressable-16","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Pressable` when an existing visual component or layout surface needs press behavior while keeping its own DOM element, layout, and styles. The child must be a single element that forwards its ref and accepts the DOM, ARIA, and event props supplied by React Aria."},"1050":{"id":"/docs/components/pressable-17","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Button` when you need a standard button control with button-specific sizing, layout, and visual variants."},"1051":{"id":"/docs/components/pressable-18","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Pass `onPress` for the action instead of wiring separate pointer and keyboard handlers:"},"1052":{"id":"/docs/components/pressable-19","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"`Pressable` accepts the React Aria press props, including `onPress`, `onPressStart`, `onPressEnd`, `onPressUp`, and `onPressChange`."},"1053":{"id":"/docs/components/pressable-20","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Use a semantic interactive element when possible. For a non-semantic child such as `Avatar` or `Box`, provide an appropriate interactive role and an accessible name. Pressable makes the child focusable when the required props are forwarded."},"1054":{"id":"/docs/components/pressable-21","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Do not add `role=\"button\"` to a native `<button>` or `<a>` unless you intentionally need to change its semantics. Use a dedicated semantic component such as `Button`, `LinkButton`, `Menu`, or `ToggleButton` when that control's meaning is known."},"1055":{"id":"/docs/components/pressable-22","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Prefer a native interactive element or a semantic Antares component when the interaction meaning is known."},"1056":{"id":"/docs/components/pressable-23","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Avoid nesting interactive elements inside the child passed to `Pressable`."},"1057":{"id":"/docs/components/pressable-24","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"`Pressable` automatically applies React Aria state attributes such as `[data-hovered]`, `[data-pressed]`, `[data-focus-visible]`, and `[data-disabled]` to the child. Ensure the child component styles these states appropriately if it overrides the default `Pressable` styles."},"1058":{"id":"/docs/components/pressable-25","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If React Aria warns that the child must be focusable, ensure it is a single element that forwards its ref, `tabIndex`, DOM props, and ARIA attributes."},"1059":{"id":"/docs/components/pressable-26","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If `onPress` does not fire, confirm that the child forwards event handlers and is not disabled by another component."},"1060":{"id":"/docs/components/progress-steps","page_id":"/docs/components/progress-steps","type":"page","content":"ProgressSteps","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/progress-steps"},"1061":{"id":"/docs/components/progress-steps-0","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps","content":"A multi-step progress indicator for wizard and onboarding flows."},"1062":{"id":"/docs/components/progress-steps-1","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#features","content":"Features"},"1063":{"id":"/docs/components/progress-steps-2","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#installation","content":"Installation"},"1064":{"id":"/docs/components/progress-steps-3","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#examples","content":"Examples"},"1065":{"id":"/docs/components/progress-steps-4","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#default","content":"Default"},"1066":{"id":"/docs/components/progress-steps-5","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#not-started","content":"Not started"},"1067":{"id":"/docs/components/progress-steps-6","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#vertical","content":"Vertical"},"1068":{"id":"/docs/components/progress-steps-7","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#interactive","content":"Interactive"},"1069":{"id":"/docs/components/progress-steps-8","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#disabled","content":"Disabled"},"1070":{"id":"/docs/components/progress-steps-9","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#hide-step-numbers","content":"Hide Step Numbers"},"1071":{"id":"/docs/components/progress-steps-10","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#customization","content":"Customization"},"1072":{"id":"/docs/components/progress-steps-11","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#accessibility","content":"Accessibility"},"1073":{"id":"/docs/components/progress-steps-12","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#best-practices","content":"Best Practices"},"1074":{"id":"/docs/components/progress-steps-13","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#troubleshooting","content":"Troubleshooting"},"1075":{"id":"/docs/components/progress-steps-14","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#props","content":"Props"},"1076":{"id":"/docs/components/progress-steps-15","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#progresssteps","content":"ProgressSteps"},"1077":{"id":"/docs/components/progress-steps-16","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#progressstep","content":"ProgressStep"},"1078":{"id":"/docs/components/progress-steps-17","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Horizontal and vertical orientations"},"1079":{"id":"/docs/components/progress-steps-18","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Four completion statuses (`none`, `partial`, `complete`, `error`) with status icons"},"1080":{"id":"/docs/components/progress-steps-19","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Timeline (past / current / future) derived from a single `currentStep` prop"},"1081":{"id":"/docs/components/progress-steps-20","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Auto-generated step numbers (opt out with `hideStepNumbers`)"},"1082":{"id":"/docs/components/progress-steps-21","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Interactive (navigable) and inert (display-only) steps"},"1083":{"id":"/docs/components/progress-steps-22","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Title truncation and RTL support"},"1084":{"id":"/docs/components/progress-steps-23","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Rendered as a `<nav>` landmark with an ordered list for assistive technology"},"1085":{"id":"/docs/components/progress-steps-24","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#default","content":"A horizontal stepper. `currentStep` marks the active step; earlier steps are `past`, later are `future`. Each `status` sets the step's icon, and an `error` step turns its accent bar red."},"1086":{"id":"/docs/components/progress-steps-25","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#not-started","content":"No `currentStep`: the flow hasn't started, so every step is `future` and none is marked current."},"1087":{"id":"/docs/components/progress-steps-26","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#vertical","content":"Vertical orientation: accent bar on the leading edge, steps stacked in a column."},"1088":{"id":"/docs/components/progress-steps-27","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#interactive","content":"Interactive steps: each `onPress` navigates the wizard by updating `currentStep`."},"1089":{"id":"/docs/components/progress-steps-28","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#disabled","content":"A disabled interactive step is muted, not focusable, and cannot be activated."},"1090":{"id":"/docs/components/progress-steps-29","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#hide-step-numbers","content":"Step numbers are shown by default; `hideStepNumbers` omits the \"N. \" prefix."},"1091":{"id":"/docs/components/progress-steps-30","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"Step numbers (`\"N. \"`) are prepended automatically — keep them where possible, as user testing shows people recognize the component better with them. Set `hideStepNumbers` to omit them."},"1092":{"id":"/docs/components/progress-steps-31","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"`orientation` switches between `horizontal` (accent bar on top) and `vertical` (accent bar on the leading edge)."},"1093":{"id":"/docs/components/progress-steps-32","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"`currentStep` is the single source of truth for the timeline. Omit it for a not-yet-started flow where every step is `future`; pass the step count for a fully completed flow where every step is `past`."},"1094":{"id":"/docs/components/progress-steps-33","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"`status` is independent of timeline and only controls the status icon and (for `error`) the accent bar color."},"1095":{"id":"/docs/components/progress-steps-34","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"Pass `className` to the container or an individual step to extend the styles."},"1096":{"id":"/docs/components/progress-steps-35","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"The container renders a `<nav>` landmark; set `aria-label` to name it (defaults to `\"Progress\"`)."},"1097":{"id":"/docs/components/progress-steps-36","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"Steps are an ordered list (`<ol>`/`<li>`) so assistive technology conveys position and count."},"1098":{"id":"/docs/components/progress-steps-37","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"The current step is marked with `aria-current=\"step\"`."},"1099":{"id":"/docs/components/progress-steps-38","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"Interactive steps are real buttons: focusable in the natural **Tab** order and activated with **Enter** or **Space**. Status icons are decorative (`aria-hidden`)."},"1100":{"id":"/docs/components/progress-steps-39","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"Focus is shown with a visible outline; disabled steps use `0.4` opacity and are not focusable."},"1101":{"id":"/docs/components/progress-steps-40","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Drive the timeline from `currentStep` rather than styling individual steps."},"1102":{"id":"/docs/components/progress-steps-41","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Provide `onPress` only for steps a user can actually navigate to; leave it off for display-only steps."},"1103":{"id":"/docs/components/progress-steps-42","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Keep titles short — they truncate with an ellipsis when space is tight."},"1104":{"id":"/docs/components/progress-steps-43","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Al