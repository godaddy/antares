omponents/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#composed-range","content":"Composed range"},"369":{"id":"/docs/components/date-picker-14","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#props","content":"Props"},"370":{"id":"/docs/components/date-picker-15","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepicker","content":"DatePicker"},"371":{"id":"/docs/components/date-picker-16","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepicker","content":"DateRangePicker"},"372":{"id":"/docs/components/date-picker-17","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepickercalendar","content":"DatePickerCalendar"},"373":{"id":"/docs/components/date-picker-18","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepickercalendar","content":"DateRangePickerCalendar"},"374":{"id":"/docs/components/date-picker-19","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepickervalue","content":"DatePickerValue"},"375":{"id":"/docs/components/date-picker-20","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepickervalue","content":"DateRangePickerValue"},"376":{"id":"/docs/components/date-picker-21","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"**Composable interior**: Compose `Label`, a `Button slot=\"trigger\"`, `DatePickerCalendar`, and optional `Text` / `FieldError`. Nothing is added for you, and what you write keeps the order you wrote it in. `children` also accepts a function for picker state"},"377":{"id":"/docs/components/date-picker-22","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"**Trigger and calendar**: An empty `Button slot=\"trigger\"` renders a calendar icon and the formatted value from the field. `DatePickerCalendar` (and `DateRangePickerCalendar`) is the calendar in the popover it opens: it takes `Calendar` props plus `popoverProps` for the overlay. Write `Popover`, `Content`, and `Calendar` yourself to replace the whole overlay"},"378":{"id":"/docs/components/date-picker-23","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"`DatePicker` (single) and `DateRangePicker` (range): a read-only formatted date label; the whole field opens a calendar popover"},"379":{"id":"/docs/components/date-picker-24","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"Built on React Aria - native form integration, validation, focus management, and screen-reader support"},"380":{"id":"/docs/components/date-picker-25","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"Label formatting via `formatOptions` / `placeholder` on the picker itself, or on `DatePickerValue` / `DateRangePickerValue` in a trigger you write"},"381":{"id":"/docs/components/date-picker-26","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"`minValue` / `maxValue` bounds and `isDateUnavailable` per-day disabling"},"382":{"id":"/docs/components/date-picker-27","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#working-with-dates","content":"Values are `CalendarDate` objects. Import the date primitives you need from the `@godaddy/antares/date` subpath:"},"383":{"id":"/docs/components/date-picker-28","page_id":"/docs/components/date-picker","tags":[],"type":"text"