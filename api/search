es } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './skeleton.stories.tsx';\n\n<"},"1360":{"id":"/docs/components/skeleton-19","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"Every Skeleton is hidden from assistive technology, so a page with many placeholders stays quiet."},"1361":{"id":"/docs/components/skeleton-20","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"Mark the region the Skeletons fill with `role=\"status\"`, `aria-busy=\"true\"`, and an `aria-label` that describes what is loading."},"1362":{"id":"/docs/components/skeleton-21","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"Set `aria-busy` to `false`, or remove it, once the real content replaces the Skeletons."},"1363":{"id":"/docs/components/skeleton-22","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"The shimmer stops when the user prefers reduced motion, and the shape gets an outline in forced colors mode."},"1364":{"id":"/docs/components/skeleton-23","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#best-practices","content":"Approximate the final layout; a skeleton doesn't need to be pixel-perfect."},"1365":{"id":"/docs/components/skeleton-24","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#best-practices","content":"Use size presets for text and basic controls, and `aspectRatio` for images and media."},"1366":{"id":"/docs/components/skeleton-25","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#best-practices","content":"Vary the widths of text bars so a paragraph reads like real sentences."},"1367":{"id":"/docs/components/skeleton-26","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#best-practices","content":"Match `width` to `size` for squares, and add `full` rounding for circles."},"1368":{"id":"/docs/components/skeleton-27","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#troubleshooting","content":"If the shimmer doesn't reverse in a right-to-left app, set `dir=\"rtl\"` on `<html>` or a parent element. Skeleton follows the `dir` attribute, and a locale set only through `I18nProvider` doesn't change it."},"1369":{"id":"/docs/components/structure","page_id":"/docs/components/structure","type":"page","content":"Structure primitives","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/structure"},"1370":{"id":"/docs/components/structure-0","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"Generic structural containers for composing a component's interior."},"1371":{"id":"/docs/components/structure-1","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#hybrid-styling","content":"Hybrid styling"},"1372":{"id":"/docs/components/structure-2","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#examples","content":"Examples"},"1373":{"id":"/docs/components/structure-3","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#props","content":"Props"},"1374":{"id":"/docs/components/structure-4","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#content","content":"Content"},"1375":{"id":"/docs/components/structure-5","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#header","content":"Header"},"1376":{"id":"/docs/components/structure-6","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#footer","content":"Footer"},"1377":{"id":"/docs/components/structure-7","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#buttongroup","content":"ButtonGroup"},"1378":{"id":"/docs/components/structure-8","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#group-1","content":"Group"},"1379":{"id":"/docs/components/structure-9","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#corneractions","content":"CornerActions"},"1380":{"id":"/docs/components/structure-10","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**Shared structural containers.** These generic, layout-only components are the building blocks for composing a component's interior (a `Modal`, a card, a panel). They are semantic containers built on `Flex`, so they accept the same layout props (`direction`, `gap`, `alignItems`, `justifyContent`, `padding`, ...)."},"1381":{"id":"/docs/components/structure-11","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Content`** — the primary body region (a `<section>`, a column that grows to fill)."},"1382":{"id":"/docs/components/structure-12","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Header`** — the top region: title area and optional trailing close (a `<header>` row that spaces its contents apart)."},"1383":{"id":"/docs/components/structure-13","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Footer`** — the bottom region: secondary content and/or actions (a `<footer>` row that spaces its contents apart)."},"1384":{"id":"/docs/components/structure-14","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","cont