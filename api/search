ponents"],"tags":[],"url":"/docs/components/listbox"},"715":{"id":"/docs/components/listbox-0","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox","content":"ListBox is a selectable collection of items rendered inline. Use it for non-popover pickers, inline lists, or as a building block for higher-level components like Select."},"716":{"id":"/docs/components/listbox-1","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#features","content":"Features"},"717":{"id":"/docs/components/listbox-2","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#installation","content":"Installation"},"718":{"id":"/docs/components/listbox-3","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#examples","content":"Examples"},"719":{"id":"/docs/components/listbox-4","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#default","content":"Default"},"720":{"id":"/docs/components/listbox-5","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#list-box-controlled","content":"List Box Controlled"},"721":{"id":"/docs/components/listbox-6","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#list-box-multiple","content":"List Box Multiple"},"722":{"id":"/docs/components/listbox-7","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#props","content":"Props"},"723":{"id":"/docs/components/listbox-8","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#listbox","content":"ListBox"},"724":{"id":"/docs/components/listbox-9","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#listboxitem","content":"ListBoxItem"},"725":{"id":"/docs/components/listbox-10","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Single or multiple selection**: Set `selectionMode=\"single\"` or `\"multiple\"`."},"726":{"id":"/docs/components/listbox-11","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Controlled or uncontrolled**: Use `selectedKeys` and `onSelectionChange` for controlled state, or `defaultSelectedKeys` for uncontrolled."},"727":{"id":"/docs/components/listbox-12","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Layout primitive**: `ListBox` and `ListBoxItem` accept layout props (`gap`, `padding`, etc.) — they extend `FlexOwnProps`."},"728":{"id":"/docs/components/listbox-13","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Composes into other components**: `Select` uses `ListBox` internally; reach for `ListBox` directly when you need an inline list rather than a popover dropdown."},"729":{"id":"/docs/components/listbox-14","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**React Aria integration**: Built on React Aria ListBox for accessibility, keyboard navigation, and typeahead."},"730":{"id":"/docs/components/listbox-15","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"`ListBox` requires either `aria-label` or `aria-labelledby`. For a labeled, popover-style picker, prefer `Select`."},"731":{"id":"/docs/components/listbox-16","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#default","content":"Single selection with static children. Use `aria-label` to give the listbox an accessible name."},"732":{"id":"/docs/components/listbox-17","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-controlled","content":"Use `selectedKeys` and `onSelectionChange` for controlled state."},"733":{"id":"/docs/components/listbox-18","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-multiple","content":"Set `selectionMode=\"multiple\"` to allow multiple values. `selectedKeys` is a `Set<Key>` (or the literal `'all'`)."},"734":{"id":"/docs/components/menu","page_id":"/docs/components/menu","type":"page","content":"Menu","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/menu"},"735":{"id":"/docs/components/menu-0","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"Accessible dropdown menu with grouping, multi-select checkbox items, leading icons, and submenus."},"736":{"id":"/docs/components/menu-1","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#features","content":"Features"},"737":{"id":"/docs/components/menu-2","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#installation","content":"Installation"},"738":{"id":"/docs/components/menu-3","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#examples","content":"Examples"},"739":{"id":"/docs/components/menu-4","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#default","content":"Default"},"740":{"id":"/docs/components/menu-5","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#controlled","content":"Controlled"},"741":{"id":"/docs/components/menu-6","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#bottom-sheet","content":"Bottom Sheet"},"742":{"id":"/docs/components/menu-7","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#groups","content":"Groups"},"743":{"id":"/docs/components/menu-8","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#multiple-selection","content":"Multiple Selection"},"744":{"id":"/docs/components/menu-9","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#rich-content-from-an-item","content":"Rich Content From an Item"},"745":{"id":"/docs/components/menu-10","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#single-selection","content":"Single Selection"},"746":{"id":"/docs/components/menu-11","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#sizes","content":"Sizes"},"747":{"id":"/docs/components/menu-12","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenu","content":"Submenu"},"748":{"id":"/docs/components/menu-13","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#accessibility","content":"Accessibility"},"749":{"id":"/docs/components/menu-14","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#best-practices","content":"Best Practices"},"750":{"id":"/docs/components/menu-15","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#props","content":"Props"},"751":{"id":"/docs/components/menu-16","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menu","content":"Menu"},"752":{"id":"/docs/components/menu-17","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menutrigger","content":"MenuTrigger"},"753":{"id":"/docs/components/menu-18","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menugroup","content":"MenuGroup"},"754":{"id":"/docs/components/menu-19","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menuitem","content":"MenuItem"},"755":{"id":"/docs/components/menu-20","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menuseparator","content":"MenuSeparator"},"756":{"id":"/docs/components/menu-21","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenutrigger","content":"SubmenuTrigger"},"757":{"id":"/docs/components/menu-22","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"An accessible dropdown menu built on React Aria. It supports grouping with optional\ntitles, multi-select checkbox items, leading icons, submenus, and two sizes. It\nreuses Antares' `Popover` for the overlay and `Checkbox` indicator for selection."},"758":{"id":"/docs/components/menu-23","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Grouping with an optional title via `MenuGroup`, plus `MenuSeparator` dividers"},"759":{"id":"/docs/components/menu-24","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Multi-select groups: set `selectionMode=\"multiple\"` on a `MenuGroup` to render\nits items as checkboxes, while other groups stay plain action items"},"760":{"id":"/docs/components/menu-25","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Optional leading `icon` per item; links (`href`) and disabled items"},"761":{"id":"/docs/components/menu-26","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Submenus via `SubmenuTrigger`"},"762":{"id":"/docs/components/menu-27","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Two sizes (`sm`, `md`); set `size` explicitly on each submenu `Menu`"},"763":{"id":"/docs/components/menu-28","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Usable anchored to a trigger or standalone (e.g. inside a bottom-sheet `Drawer`)"},"764":{"id":"/docs/components/menu-29","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#default","content":"A trigger with plain action items."},"765":{"id":"/docs/components/menu-30","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#controlled","content":"`MenuTrigger` exposes its open state via `isOpen`/`onOpenChange`,\nwhich can be used to drive the rotation of a chevron icon."},"766":{"id":"/docs/components/menu-31","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#bottom-sheet","content":"On small screens a menu often reads better as a bottom sheet than an anchored\npopover. Since `Menu` works standalone, drop it into a bottom `Drawer`."},"767":{"id":"/docs/components/menu-32","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#groups","content":"Labeled groups separated by dividers, a multi-select checkbox group mixed with\nplain action groups, leading icons, a disabled item, and a link."},"768":{"id":"/docs/components/menu-33","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#multiple-selection","content":"A `MenuGroup` with `selectionMode=\"multiple\"` renders its items as checkboxes.\nDrive the checked items with `selectedKeys` + `onSelectionChange` or\nseed them uncontrolled with `defaultSelectedKeys`. Keys correspond to each\n`MenuItem`'s `id`."},"769":{"id":"/docs/components/menu-34","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#rich-content-from-an-item","content":"A `Menu` is a collection, so it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger` children. Rich content inside a `Menu`\nor submenu is not supported. To show a `Calendar`, let the item close the\nmenu from `onAction` and open a separate `Popover` anchored to the trigger\nwith `triggerRef`."},"770":{"id":"/docs/components/menu-35","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#single-selection","content":"A `MenuGroup` with `selectionMode=\"single\"` lets one item be selected at a time.\nDrive it with `selectedKeys` + `onSelectionChange` or seed it uncontrolled with\n`defaultSelectedKeys`. Keys correspond to each `MenuItem`'s `id`."},"771":{"id":"/docs/components/menu-36","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#sizes","content":"`size` controls item density. Shown here as two standalone menus so both\nsizes are visible at once; in practice you set `size` on the `Menu` inside a\n`MenuTrigger`."},"772":{"id":"/docs/components/menu-37","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#submenu","content":"Nested menus via `SubmenuTrigger`."},"773":{"id":"/docs/components/menu-38","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Space/Enter**: activate an item; **Escape**: close"},"774":{"id":"/docs/components/menu-39","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Up/Down**: move between items; **Home/End**: first/last"},"775":{"id":"/docs/components/menu-40","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Right/Left**: open/close a submenu"},"776":{"id":"/docs/components/menu-41","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Type to select**: jump to a matching item (string labels are used as `textValue`)"},"777":{"id":"/docs/components/menu-42","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"Multi-select items use RAC's `menuitemcheckbox` role; the checkbox indicator is\ndecorative (`aria-hidden`) and the item owns interaction"},"778":{"id":"/docs/components/menu-43","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Give each selectable `MenuItem` a stable `id`, and provide the `Menu` an\n`aria-label` when there is no visible label."},"779":{"id":"/docs/components/menu-44","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Use a leading `icon` for recognition, not as the only label - keep a text label."},"780":{"id":"/docs/components/menu-45","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Reserve checkbox groups for multi-select; use plain groups for one-shot actions."},"781":{"id":"/docs/components/menu-46","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"A `Menu` is a collection: it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger`. For rich content (a `Calendar`, a form),\nclose the menu from `onAction` and open a separate `Popover` anchored with\n`triggerRef` instead of putting it in a submenu."},"782":{"id":"/docs/components/metrics-lockup","page_id":"/docs/components/metrics-lockup","type":"page","content":"MetricsLockup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/metrics-lockup"},"783":{"id":"/docs/components/metrics-lockup-0","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"The MetricsLockup component displays a single metric with an optional title, info tooltip, trend indicator, and description."},"784":{"id":"/docs/components/metrics-lockup-1","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#installation","content":"Installation"},"785":{"id":"/docs/components/metrics-lockup-2","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#examples","content":"Examples"},"786":{"id":"/docs/components/metrics-lockup-3","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#default","content":"Default"},"787":{"id":"/docs/components/metrics-lockup-4","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#with-trend","content":"With Trend"},"788":{"id":"/docs/components/metrics-lockup-5","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#compact","content":"Compact"},"789":{"id":"/docs/components/metrics-lockup-6","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#accessibility","content":"Accessibility"},"790":{"id":"/docs/components/metrics-lockup-7","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#keyboard","content":"Keyboard"},"791":{"id":"/docs/components/metrics-lockup-8","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#aria","content":"ARIA"},"792":{"id":"/docs/components/metrics-lockup-9","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#best-practices","content":"Best Practices"},"793":{"id":"/docs/components/metrics-lockup-10","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#props","content":"Props"},"794":{"id":"/docs/components/metrics-lockup-11","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#metricslockup","content":"MetricsLockup"},"795":{"id":"/docs/components/metrics-lockup-12","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"MetricsLockup displays a metric value prominently, with an optional title and tooltip for context, an optional trend icon to show direction of change, and a description label below the value."},"796":{"id":"/docs/components/metrics-lockup-13","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#default","content":"A metric with a title, info tooltip, value, and description."},"797":{"id":"/docs/components/metrics-lockup-14","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#with-trend","content":"Use the `trend` prop to show a directional icon next to the description. Accepts `'positive'`, `'negative'`, or `'neutral'`."},"798":{"id":"/docs/components/metrics-lockup-15","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#compact","content":"Use the `compact` prop to render the metric value and description inline rather than stacked."},"799":{"id":"/docs/components/metrics-lockup-16","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Key"},"800":{"id":"/docs/components/metrics-lockup-17","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Description"},"801":{"id":"/docs/components/metrics-lockup-18","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Tab"},"802":{"id":"/docs/components/metrics-lockup-19","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Moves focus to the info trigger button and shows the tooltip"},"803":{"id":"/docs/components/metrics-lockup-20","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Escape"},"804":{"id":"/docs/components/metrics-lockup-21","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Closes the tooltip"},"805":{"id":"/docs/components/metrics-lockup-22","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger button uses `aria-label=\"More information\"` to describe its purpose."},"806":{"id":"/docs/components/metrics-lockup-23","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The tooltip uses `role=\"tooltip\"` and is associated with the info trigger via `aria-describedby`."},"807":{"id":"/docs/components/metrics-lockup-24","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger has a minimum touch target of 44×44px, achieved via a CSS pseudo-element, to meet WCAG 2.5.5."},"808":{"id":"/docs/components/metrics-lockup-25","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"Keep tooltip content concise and informative."},"809":{"id":"/docs/components/metrics-lockup-26","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"The `data` prop accepts strings or numbers — format currency and percentages before passing them in."},"810":{"id":"/docs/components/metrics-lockup-27","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`titleInfo` requires `title` to be set — the info icon is contextually tied to the title label. If `title` is absent, `titleInfo` has no effect."},"811":{"id":"/docs/components/metrics-lockup-28","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`trend` is intended to accompany `description` to provide temporal context (e.g. \"↑ +3% vs. last month\"). A trend icon alone, with no description, leaves the direction unanchored (\"up since *when*?\"). If `description` is not provided, `trend` has no effect."},"812":{"id":"/docs/components/modal","page_id":"/docs/components/modal","type":"page","content":"Modal","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/modal"},"813":{"id":"/docs/components/modal-0","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"The Modal component presents a dialog window over the page that focuses the user's attention on a single task or piece of information."},"814":{"id":"/docs/components/modal-1","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#installation","content":"Installation"},"815":{"id":"/docs/components/modal-2","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#examples","content":"Examples"},"816":{"id":"/docs/components/modal-3","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#default","content":"Default"},"817":{"id":"/docs/components/modal-4","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#controlled","content":"Controlled"},"818":{"id":"/docs/components/modal-5","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#scrollable","content":"Scrollable"},"819":{"id":"/docs/components/modal-6","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#triggerless","content":"Triggerless"},"820":{"id":"/docs/components/modal-7","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#size","content":"Size"},"821":{"id":"/docs/components/modal-8","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#with-text-lockup","content":"With Text Lockup"},"822":{"id":"/docs/components/modal-9","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#accessibility","content":"Accessibility"},"823":{"id":"/docs/components/modal-10","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#keyboard-interaction","content":"Keyboard interaction"},"824":{"id":"/docs/components/modal-11","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#aria","content":"ARIA"},"825":{"id":"/docs/components/modal-12","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#best-practices","content":"Best Practices"},"826":{"id":"/docs/components/modal-13","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#props","content":"Props"},"827":{"id":"/docs/components/modal-14","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#modal","content":"Modal"},"828":{"id":"/docs/components/modal-15","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#modaltrigger","content":"ModalTrigger"},"829":{"id":"/docs/components/modal-16","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"`ModalTrigger` wraps a trigger button and a `<Modal>`, handling open state automatically. Based on RAC `DialogTrigger`."},"830":{"id":"/docs/components/modal-17","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"The modal is a `SizeProvider`. It opens at the size of the scope around its trigger, even though it renders in a portal, and `size` overrides that."},"831":{"id":"/docs/components/modal-18","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#default","content":"Compose a Modal from a `Heading slot=\"title\"`, a `CloseButton`, `Content`, and a\n`ButtonGroup`. `ModalTrigger` opens the Modal and manages its open/close state."},"832":{"id":"/docs/components/modal-19","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#controlled","content":"Pass `isOpen` and `onOpenChange` to `ModalTrigger` to control the open state externally."},"833":{"id":"/docs/components/modal-20","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#scrollable","content":"When the content is taller than the viewport, the `Content` region scrolls while the title\nrow and the `ButtonGroup` stay pinned."},"834":{"id":"/docs/components/modal-21","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#triggerless","content":"`Modal` accepts `isOpen` and `onOpenChange` directly, so it can be controlled without a\n`ModalTrigger`. Useful when the modal is opened from several places at once."},"835":{"id":"/docs/components/modal-22","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#size","content":"`size` sets the modal's text, controls, and spacing. Without it, the modal follows the size\nscope around its trigger."},"836":{"id":"/docs/components/modal-23","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#with-text-lockup","content":"A `TextLockup` in the content keeps its own title. The modal's `Heading slot=\"title\"` still names\nthe dialog."},"837":{"id":"/docs/components/modal-24","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Key"},"838":{"id":"/docs/components/modal-25","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Action"},"839":{"id":"/docs/components/modal-26","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"`Tab`"},"840":{"id":"/docs/components/modal-27","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Moves focus to the next focusable element inside the modal"},"841":{"id":"/docs/components/modal-28","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"`Escape`"},"842":{"id":"/docs/components/modal-29","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Closes the modal (unless `isKeyboardDismissDisabled`)"},"843":{"id":"/docs/components/modal-30","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#aria","content":"`role=\"dialog\"` is applied automatically by the underlying React Aria `Dialog`"},"844":{"id":"/docs/components/modal-31","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#aria","content":"Focus is trapped within the modal while open and returned to the trigger on close"},"845":{"id":"/docs/components/modal-32","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#best-practices","content":"Always include a `Heading slot=\"title\"` so the dialog has an accessible name; otherwise pass `aria-label`/`aria-labelledby` on `<Modal>`"},"846":{"id":"/docs/components/modal-33","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#best-practices","content":"Pair every action button with `slot=\"close\"` when it should dismiss the modal"},"847":{"id":"/docs/components/modal-34","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#best-practices","content":"Set `isDismissable={false}` to prevent outside-click dismissal for required confirmations; to also block `Escape`, pass `isKeyboardDismissDisabled`"},"848":{"id":"/docs/components/number-field","page_id":"/docs/components/number-field","type":"page","content":"NumberField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/number-field"},"849":{"id":"/docs/components/number-field-0","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field","content":"NumberField is a composed numeric input with min/max/step and optional increment/decrement stepper buttons. Use it in forms for quantities, amounts, or percentages."},"850":{"id":"/docs/components/number-field-1","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#features","content":"Features"},"851":{"id":"/docs/components/number-field-2","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#installation","content":"Installation"},"852":{"id":"/docs/components/number-field-3","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#examples","content":"Examples"},"853":{"id":"/docs/components/number-field-4","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#default","content":"Default"},"854":{"id":"/docs/components/number-field-5","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#controlled","content":"Controlled"},"855":{"id":"/docs/components/number-field-6","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#invalid","content":"Invalid"},"856":{"id":"/docs/components/number-field-7","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#disabled","content":"Disabled"},"857":{"id":"/docs/components/number-field-8","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#hide-stepper","content":"Hide Stepper"},"858":{"id":"/docs/components/number-field-9","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#value-scale","content":"Value Scale"},"859":{"id":"/docs/components/number-field-10","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#format-options-numbering-system","content":"Format options (numbering system)"},"860":{"id":"/docs/components/number-field-11","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#sizes","content":"Sizes"},"861":{"id":"/docs/components/number-field-12","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#text-steppers","content":"Text Steppers"},"862":{"id":"/docs/components/number-field-13","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#props","content":"Props"},"863":{"id":"/docs/components/number-field-14","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#numberfield","content":"NumberField"},"864":{"id":"/docs/components/number-field-15","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Composable interior**: Compose `Label`, the control, `Text slot=\"description\"`, and `FieldError`. Nothing is added for you, and what you write keeps the order you wrote it in"},"865":{"id":"/docs/components/number-field-16","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Steppers**: A stepper is a `Group` holding `Button slot=\"decrement\"`, an `Input`, and `Button slot=\"increment\"`. Left empty, each button takes its icon and `variant=\"control\"` from the field, so no icon imports are needed. Compose a bare `Input` instead for a plain numeric input"},"866":{"id":"/docs/components/number-field-17","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Sizes**: The field is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets its label, input, steppers, description, and error; without it, the field follows the surrounding scope"},"867":{"id":"/docs/components/number-field-18","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Value scale**: `minValue`, `maxValue`, `step`, and `formatOptions` configure the numeric behavior"},"868":{"id":"/docs/components/number-field-19","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"869":{"id":"/docs/components/number-field-20","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"870":{"id":"/docs/components/number-field-21","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#default","content":"Minimal usage with a `Label`, min/max, and stepper `Button`s."},"871":{"id":"/docs/components/number-field-22","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#controlled","content":"Use `value` and `onChange` for controlled state."},"872":{"id":"/docs/components/number-field-23","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#invalid","content":"Use `isInvalid` with a `FieldError` for validation feedback."},"873":{"id":"/docs/components/number-field-24","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#disabled","content":"Use `isDisabled` to prevent input."},"874":{"id":"/docs/components/number-field-25","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#hide-stepper","content":"Compose without stepper `Button`s for a plain numeric input."},"875":{"id":"/docs/components/number-field-26","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#value-scale","content":"Use `minValue`, `maxValue`, and `step` to set the allowed values. Steps are calculated from the minimum value."},"876":{"id":"/docs/components/number-field-27","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#format-options-numbering-system","content":"By default, NumberField displays the value using the numbering system for the user's locale. Use the `formatOptions` prop to override the numbering system by setting the Unicode numbering system locale extension."},"877":{"id":"/docs/components/number-field-28","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#sizes","content":"`size` sets the label, input, and steppers. Without it, the field follows the surrounding size\nscope."},"878":{"id":"/docs/components/number-field-29","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#text-steppers","content":"Compose with `children` to replace the stepper icons with your own content, such as text."},"879":{"id":"/docs/components/popover","page_id":"/docs/components/popover","type":"page","content":"Popover","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/popover"},"880":{"id":"/docs/components/popover-0","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover","content":"The Popover component is an overlay element positioned relative to a trigger element."},"881":{"id":"/docs/components/popover-1","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#installation","content":"Installation"},"882":{"id":"/docs/components/popover-2","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#examples","content":"Examples"},"883":{"id":"/docs/components/popover-3","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#default","content":"Default"},"884":{"id":"/docs/components/popover-4","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#custom-anchor","content":"Custom Anchor"},"885":{"id":"/docs/components/popover-5","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#title-and-close-button","content":"Title and Close Button"},"886":{"id":"/docs/components/popover-6","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#accessibility","content":"Accessibility"},"887":{"id":"/docs/components/popover-7","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#keyboard","content":"Keyboard"},"888":{"id":"/docs/components/popover-8","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#aria","content":"ARIA"},"889":{"id":"/docs/components/popover-9","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#best-practices","content":"Best Practices"},"890":{"id":"/docs/components/popover-10","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#props","content":"Props"},"891":{"id":"/docs/components/popover-11","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#popover","content":"Popover"},"892":{"id":"/docs/components/popover-12","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#popovertrigger","content":"PopoverTrigger"},"893":{"id":"/docs/components/popover-13","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover","content":"`PopoverTrigger` wraps a trigger button and a `<Popover>`, handling open state and positioning automatically.\nBased on RAC `DialogTrigger`. To anchor a popover to an element it doesn't wrap, pass `triggerRef` instead."},"894":{"id":"/docs/components/popover-14","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#default","content":"Use it with `<PopoverTrigger>`, which wraps both the popover content and an interactive trigger element (for example, a `Button`)."},"895":{"id":"/docs/components/popover-15","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#custom-anchor","content":"To position a popover relative to a different element than its trigger, use the `triggerRef` and `isOpen` props instead of `<PopoverTrigger>`. `onOpenChange` is called when the user opens or closes the popover."},"896":{"id":"/docs/components/popover-16","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#title-and-close-button","content":"Add a `Heading slot=\"title\"` and a `CloseButton` for a titled, dismissible popover. The heading\nalso gives the dialog its accessible name."},"897":{"id":"/docs/components/popover-17","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Key"},"898":{"id":"/docs/components/popover-18","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Action"},"899":{"id":"/docs/components/popover-19","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"`Enter/Space`"},"900":{"id":"/docs/components/popover-20","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Opens the popover from its trigger"},"901":{"id":"/docs/components/popover-21","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"`Escape`"},"902":{"id":"/docs/components/popover-22","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Closes the popover"},"903":{"id":"/docs/components/popover-23","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#aria","content":"`role=\"dialog\"` is applied automatically by the underlying React Aria `Dialog`"},"904":{"id":"/docs/components/popover-24","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#aria","content":"A `Heading slot=\"title\"` labels the dialog via `aria-labelledby`. Without one, a popover inside\na `PopoverTrigger` falls back to being labelled by its trigger; standing alone with\n`triggerRef` it needs an explicit `aria-label`"},"905":{"id":"/docs/components/popover-25","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#best-practices","content":"Pass an `aria-label` when anchoring with `triggerRef` instead of wrapping a `PopoverTrigger`,\nsince there is no trigger to borrow the name from."},"906":{"id":"/docs/components/popover-26","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#best-practices","content":"Popover width is determined by its content, and it's recommended to keep it under 400px."},"907":{"id":"/docs/components/pagination","page_id":"/docs/components/pagination","type":"page","content":"Pagination","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pagination"},"908":{"id":"/docs/components/pagination-0","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination","content":"A pagination component with prev/next buttons and dot indicators, configurable page limits, and optional visibility of controls and dots"},"909":{"id":"/docs/components/pagination-1","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#installation","content":"Installation"},"910":{"id":"/docs/components/pagination-2","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#examples","content":"Examples"},"911":{"id":"/docs/components/pagination-3","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#default","content":"Default"},"912":{"id":"/docs/components/pagination-4","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#controlled","content":"Controlled"},"913":{"id":"/docs/components/pagination-5","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#default-active","content":"Default Active"},"914":{"id":"/docs/components/pagination-6","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#with-limit","content":"With Limit"},"915":{"id":"/docs/components/pagination-7","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#onchange-event","content":"onChange Event"},"916":{"id":"/docs/components/pagination-8","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#props","content":"Props"},"917":{"id":"/docs/components/pagination-9","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#pagination","content":"Pagination"},"918":{"id":"/docs/components/pagination-10","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#default","content":"The default pagination is uncontrolled. It renders prev/next buttons and one dot per page. The `total` prop sets the number of items."},"919":{"id":"/docs/components/pagination-11","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#controlled","content":"Pass `activeIndex` and `onChange` to control the active page externally."},"920":{"id":"/docs/components/pagination-12","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#default-active","content":"Use `defaultActiveIndex` to set the starting page in uncontrolled mode."},"921":{"id":"/docs/components/pagination-13","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#with-limit","content":"Limit the number of items shown per page. When `limit` is greater than 1, the number of pages (dots) is derived from `Math.ceil(total / limit)`. For example, 10 items with a limit of 3 produces 4 pages (dots)."},"922":{"id":"/docs/components/pagination-14","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#onchange-event","content":"The `onChange` callback fires with the new page index whenever the user navigates."},"923":{"id":"/docs/components/pressable","page_id":"/docs/components/pressable","type":"page","content":"Pressable","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pressable"},"924":{"id":"/docs/components/pressable-0","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable","content":"A wrapperless interaction primitive that adds accessible press behavior to a single child element."},"925":{"id":"/docs/components/pressable-1","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#features","content":"Features"},"926":{"id":"/docs/components/pressable-2","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#installation","content":"Installation"},"927":{"id":"/docs/components/pressable-3","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#examples","content":"Examples"},"928":{"id":"/docs/components/pressable-4","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#default","content":"Default"},"929":{"id":"/docs/components/pressable-5","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#customization","content":"Customization"},"930":{"id":"/docs/components/pressable-6","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#accessibility","content":"Accessibility"},"931":{"id":"/docs/components/pressable-7","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#best-practices","content":"Best Practices"},"932":{"id":"/docs/components/pressable-8","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#troubleshooting","content":"Troubleshooting"},"933":{"id":"/docs/components/pressable-9","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#props","content":"Props"},"934":{"id":"/docs/components/pressable-10","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#pressable","content":"Pressable"},"935":{"id":"/docs/components/pressable-11","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Adds accessible press behavior to an existing visual component."},"936":{"id":"/docs/components/pressable-12","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Applies interaction states directly to the child without adding a wrapper element."},"937":{"id":"/docs/components/pressable-13","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Supports pointer, touch, and keyboard interactions through React Aria."},"938":{"id":"/docs/components/pressable-14","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Preserves the child's layout, shape, and base visual styling while adding state feedback."},"939":{"id":"/docs/components/pressable-15","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#default","content":"Add accessible press behavior to an existing visual component without adding a wrapper element.\nThe surface supports pointer, touch, and keyboard activation."},"940":{"id":"/docs/components/pressable-16","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Pressable` when an existing visual component or layout surface needs press behavior while keeping its own DOM element, layout, and styles. The child must be a single element that forwards its ref and accepts the DOM, ARIA, and event props supplied by React Aria."},"941":{"id":"/docs/components/pressable-17","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Button` when you need a standard button control with button-specific sizing, layout, and visual variants."},"942":{"id":"/docs/components/pressable-18","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Pass `onPress` for the action instead of wiring separate pointer and keyboard handlers:"},"943":{"id":"/docs/components/pressable-19","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"`Pressable` accepts the React Aria press props, including `onPress`, `onPressStart`, `onPressEnd`, `onPressUp`, and `onPressChange`."},"944":{"id":"/docs/components/pressable-20","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Use a semantic interactive element when possible. For a non-semantic child such as `Avatar` or `Box`, provide an appropriate interactive role and an accessible name. Pressable makes the child focusable when the required props are forwarded."},"945":{"id":"/docs/components/pressable-21","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Do not add `role=\"button\"` to a native `<button>` or `<a>` unless you intentionally need to change its semantics. Use a dedicated semantic component such as `Button`, `LinkButton`, `Menu`, or `ToggleButton` when that control's meaning is known."},"946":{"id":"/docs/components/pressable-22","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Prefer a native interactive element or a semantic Antares component when the interaction meaning is known."},"947":{"id":"/docs/components/pressable-23","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Avoid nesting interactive elements inside the child passed to `Pressable`."},"948":{"id":"/docs/components/pressable-24","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"`Pressable` automatically applies React Aria state attributes such as `[data-hovered]`, `[data-pressed]`, `[data-focus-visible]`, and `[data-disabled]` to the child. Ensure the child component styles these states appropriately if it overrides the default `Pressable` styles."},"949":{"id":"/docs/components/pressable-25","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If React Aria warns that the child must be focusable, ensure it is a single element that forwards its ref, `tabIndex`, DOM props, and ARIA attributes."},"950":{"id":"/docs/components/pressable-26","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If `onPress` does not fire, confirm that the child forwards event handlers and is not disabled by another component."},"951":{"id":"/docs/components/progress-bar","page_id":"/docs/components/progress-bar","type":"page","content":"ProgressBar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/progress-bar"},"952":{"id":"/docs/components/progress-bar-0","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar","content":"A progress bar shows determinate or indeterminate progress of an operation over time"},"953":{"id":"/docs/components/progress-bar-1","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#installation","content":"Installation"},"954":{"id":"/docs/components/progress-bar-2","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#examples","content":"Examples"},"955":{"id":"/docs/components/progress-bar-3","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#default","content":"Default"},"956":{"id":"/docs/components/progress-bar-4","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#sizes","content":"Sizes"},"957":{"id":"/docs/components/progress-bar-5","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#statuses","content":"Statuses"},"958":{"id":"/docs/components/progress-bar-6","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#indeterminate","content":"Indeterminate"},"959":{"id":"/docs/components/progress-bar-7","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#accessibility","content":"Accessibility"},"960":{"id":"/docs/components/progress-bar-8","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#aria-support","content":"ARIA Support"},"961":{"id":"/docs/components/progress-bar-9","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#props","content":"Props"},"962":{"id":"/docs/components/progress-bar-10","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#progressbar","content":"ProgressBar"},"963":{"id":"/docs/components/progress-bar-11","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#default","content":"A determinate progress bar with a label and helper text."},"964":{"id":"/docs/components/progress-bar-12","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#sizes","content":"Three track heights are available: `xs` (6px), `sm` (12px), and `md` (24px)."},"965":{"id":"/docs/components/progress-bar-13","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#statuses","content":"Use the `status` prop to communicate intent: `default`, `success`, `warning`, or `critical`. Pair with `helperText` to provide additional context."},"966":{"id":"/docs/components/progress-bar-14","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#indeterminate","content":"Use indeterminate progress while preparing an upload whose total size is unknown.\nOnce the total is known, set `isIndeterminate` to false and supply a measured value."},"967":{"id":"/docs/components/progress-bar-15","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components