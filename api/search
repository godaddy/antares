":"/docs/components/input-2","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#examples","content":"Examples"},"806":{"id":"/docs/components/input-3","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#default","content":"Default"},"807":{"id":"/docs/components/input-4","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#props","content":"Props"},"808":{"id":"/docs/components/input-5","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#input","content":"Input"},"809":{"id":"/docs/components/input-6","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input","content":"`Input` is the single-line control inside a field, not a field on its own. Prefer `TextField` or `NumberField` as the parent; see those components for fuller examples."},"810":{"id":"/docs/components/input-7","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#default","content":"Input inside TextField."},"811":{"id":"/docs/components/label","page_id":"/docs/components/label","type":"page","content":"Label","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/label"},"812":{"id":"/docs/components/label-0","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label","content":"Names a form field. The required asterisk appears when the field is required."},"813":{"id":"/docs/components/label-1","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#features","content":"Features"},"814":{"id":"/docs/components/label-2","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#installation","content":"Installation"},"815":{"id":"/docs/components/label-3","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#examples","content":"Examples"},"816":{"id":"/docs/components/label-4","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#default","content":"Default"},"817":{"id":"/docs/components/label-5","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#props","content":"Props"},"818":{"id":"/docs/components/label-6","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#label","content":"Label"},"819":{"id":"/docs/components/label-7","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#features","content":"Associates the visible name with the field control."},"820":{"id":"/docs/components/label-8","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#features","content":"Applies the label treatment, medium weight, at the surrounding\n`SizeProvider` tier. `size` and `emphasis` work as on `Text`."},"821":{"id":"/docs/components/label-9","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#features","content":"Field CSS adds the required asterisk when the field root is `isRequired`. That is not a Label prop."},"822":{"id":"/docs/components/label-10","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#default","content":"Label names a field. The required asterisk comes from Field CSS when the root is `isRequired`."},"823":{"id":"/docs/components/listbox","page_id":"/docs/components/listbox","type":"page","content":"ListBox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/listbox"},"824":{"id":"/docs/components/listbox-0","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox","content":"ListBox is a selectable collection of items rendered inline. Use it for non-popover pickers, inline lists, or as a building block for higher-level components like Select."},"825":{"id":"/docs/components/listbox-1","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#features","content":"Features"},"826":{"id":"/docs/components/listbox-2","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#installation","content":"Installation"},"827":{"id":"/docs/components/listbox-3","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#examples","content":"Examples"},"828":{"id":"/docs/components/listbox-4","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#default","content":"Default"},"829":{"id":"/docs/components/listbox-5","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#list-box-controlled","content":"List Box Controlled"},"830":{"id":"/docs/components/listbox-6","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#list-box-multiple","content":"List Box Multiple"},"831":{"id":"/docs/components/listbox-7","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#props","content":"Props"},"832":{"id":"/docs/components/listbox-8","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#listbox","content":"ListBox"},"833":{"id":"/docs/components/listbox-9","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#listboxitem","content":"ListBoxItem"},"834":{"id":"/docs/components/listbox-10","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Single or multiple selection**: Set `selectionMode=\"single\"` or `\"multiple\"`."},"835":{"id":"/docs/components/listbox-11","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Controlled or uncontrolled**: Use `selectedKeys` and `onSelectionChange` for controlled state, or `defaultSelectedKeys` for uncontrolled."},"836":{"id":"/docs/components/listbox-12","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Layout primitive**: `ListBox` and `ListBoxItem` accept layout props (`gap`, `padding`, etc.) — they extend `FlexOwnProps`."},"837":{"id":"/docs/components/listbox-13","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Composes into other components**: `Select` uses `ListBox` internally; reach for `ListBox` directly when you need an inline list rather than a popover dropdown."},"838":{"id":"/docs/components/listbox-14","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**React Aria integration**: Built on React Aria ListBox for accessibility, keyboard navigation, and typeahead."},"839":{"id":"/docs/components/listbox-15","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"`ListBox` requires either `aria-label` or `aria-labelledby`. For a labeled, popover-style picker, prefer `Select`."},"840":{"id":"/docs/components/listbox-16","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#default","content":"Single selection with static children. Use `aria-label` to give the listbox an accessible name."},"841":{"id":"/docs/components/listbox-17","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-controlled","content":"Use `selectedKeys` and `onSelectionChange` for controlled state."},"842":{"id":"/docs/components/listbox-18","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-multiple","content":"Set `selectionMode=\"multiple\"` to allow multiple values. `selectedKeys` is a `Set<Key>` (or the literal `'all'`)."},"843":{"id":"/docs/components/menu","page_id":"/docs/components/menu","type":"page","content":"Menu","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/menu"},"844":{"id":"/docs/components/menu-0","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"Accessible dropdown menu with grouping, multi-select checkbox items, leading icons, and submenus."},"845":{"id":"/docs/components/menu-1","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#features","content":"Features"},"846":{"id":"/docs/components/menu-2","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#installation","content":"Installation"},"847":{"id":"/docs/components/menu-3","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#examples","content":"Examples"},"848":{"id":"/docs/components/menu-4","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#default","content":"Default"},"849":{"id":"/docs/components/menu-5","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#controlled","content":"Controlled"},"850":{"id":"/docs/components/menu-6","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#bottom-sheet","content":"Bottom Sheet"},"851":{"id":"/docs/components/menu-7","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#groups","content":"Groups"},"852":{"id":"/docs/components/menu-8","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#multiple-selection","content":"Multiple Selection"},"853":{"id":"/docs/components/menu-9","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#rich-content-from-an-item","content":"Rich Content From an Item"},"854":{"id":"/docs/components/menu-10","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#single-selection","content":"Single Selection"},"855":{"id":"/docs/components/menu-11","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#sizes","content":"Sizes"},"856":{"id":"/docs/components/menu-12","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenu","content":"Submenu"},"857":{"id":"/docs/components/menu-13","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#accessibility","content":"Accessibility"},"858":{"id":"/docs/components/menu-14","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#best-practices","content":"Best Practices"},"859":{"id":"/docs/components/menu-15","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#props","content":"Props"},"860":{"id":"/docs/components/menu-16","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menu","content":"Menu"},"861":{"id":"/docs/components/menu-17","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menutrigger","content":"MenuTrigger"},"862":{"id":"/docs/components/menu-18","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menugroup","content":"MenuGroup"},"863":{"id":"/docs/components/menu-19","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menuitem","content":"MenuItem"},"864":{"id":"/docs/components/menu-20","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menuseparator","content":"MenuSeparator"},"865":{"id":"/docs/components/menu-21","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenutrigger","content":"SubmenuTrigger"},"866":{"id":"/docs/components/menu-22","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"An accessible dropdown menu built on React Aria. It supports grouping with optional\ntitles, multi-select checkbox items, leading icons, submenus, and two sizes. It\nreuses Antares' `Popover` for the overlay and `Checkbox` indicator for selection."},"867":{"id":"/docs/components/menu-23","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Grouping with an optional title via `MenuGroup`, plus `MenuSeparator` dividers"},"868":{"id":"/docs/components/menu-24","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Multi-select groups: set `selectionMode=\"multiple\"` on a `MenuGroup` to render\nits items as checkboxes, while other groups stay plain action items"},"869":{"id":"/docs/components/menu-25","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Optional leading `icon` per item; links (`href`) and disabled items"},"870":{"id":"/docs/components/menu-26","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Submenus via `SubmenuTrigger`"},"871":{"id":"/docs/components/menu-27","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Two sizes (`sm`, `md`); set `size` explicitly on each submenu `Menu`"},"872":{"id":"/docs/components/menu-28","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Usable anchored to a trigger or standalone (e.g. inside a bottom-sheet `Drawer`)"},"873":{"id":"/docs/components/menu-29","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#default","content":"A trigger with plain action items."},"874":{"id":"/docs/components/menu-30","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#controlled","content":"`MenuTrigger` exposes its open state via `isOpen`/`onOpenChange`,\nwhich can be used to drive the rotation of a chevron icon."},"875":{"id":"/docs/components/menu-31","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#bottom-sheet","content":"On small screens a menu often reads better as a bottom sheet than an anchored\npopover. Since `Menu` works standalone, drop it into a bottom `Drawer`."},"876":{"id":"/docs/components/menu-32","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#groups","content":"Labeled groups separated by dividers, a multi-select checkbox group mixed with\nplain action groups, leading icons, a disabled item, and a link."},"877":{"id":"/docs/components/menu-33","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#multiple-selection","content":"A `MenuGroup` with `selectionMode=\"multiple\"` renders its items as checkboxes.\nDrive the checked items with `selectedKeys` + `onSelectionChange` or\nseed them uncontrolled with `defaultSelectedKeys`. Keys correspond to each\n`MenuItem`'s `id`."},"878":{"id":"/docs/components/menu-34","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#rich-content-from-an-item","content":"A `Menu` is a collection, so it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger` children. Rich content inside a `Menu`\nor submenu is not supported. To show a `Calendar`, let the item close the\nmenu from `onAction` and open a separate `Popover` anchored to the trigger\nwith `triggerRef`."},"879":{"id":"/docs/components/menu-35","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#single-selection","content":"A `MenuGroup` with `selectionMode=\"single\"` lets one item be selected at a time.\nDrive it with `selectedKeys` + `onSelectionChange` or seed it uncontrolled with\n`defaultSelectedKeys`. Keys correspond to each `MenuItem`'s `id`."},"880":{"id":"/docs/components/menu-36","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#sizes","content":"`size` controls item density. Shown here as two standalone menus so both\nsizes are visible at once; in practice you set `size` on the `Menu` inside a\n`MenuTrigger`."},"881":{"id":"/docs/components/menu-37","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#submenu","content":"Nested menus via `SubmenuTrigger`."},"882":{"id":"/docs/components/menu-38","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Space/Enter**: activate an item; **Escape**: close"},"883":{"id":"/docs/components/menu-39","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Up/Down**: move between items; **Home/End**: first/last"},"884":{"id":"/docs/components/menu-40","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Right/Left**: open/close a submenu"},"885":{"id":"/docs/components/menu-41","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Type to select**: jump to a matching item (string labels are used as `textValue`)"},"886":{"id":"/docs/components/menu-42","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"Multi-select items use RAC's `menuitemcheckbox` role; the checkbox indicator is\ndecorative (`aria-hidden`) and the item owns interaction"},"887":{"id":"/docs/components/menu-43","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Give each selectable `MenuItem` a stable `id`, and provide the `Menu` an\n`aria-label` when there is no visible label."},"888":{"id":"/docs/components/menu-44","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Use a leading `icon` for recognition, not as the only label - keep a text label."},"889":{"id":"/docs/components/menu-45","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Reserve checkbox groups for multi-select; use plain groups for one-shot actions."},"890":{"id":"/docs/components/menu-46","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"A `Menu` is a collection: it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger`. For rich content (a `Calendar`, a form),\nclose the menu from `onAction` and open a separate `Popover` anchored with\n`triggerRef` instead of putting it in a submenu."},"891":{"id":"/docs/components/modal","page_id":"/docs/components/modal","type":"page","content":"Modal","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/modal"},"892":{"id":"/docs/components/modal-0","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"The Modal component presents a dialog window over the page that focuses the user's attention on a single task or piece of information."},"893":{"id":"/docs/components/modal-1","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#installation","content":"Installation"},"894":{"id":"/docs/components/modal-2","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#examples","content":"Examples"},"895":{"id":"/docs/components/modal-3","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#default","content":"Default"},"896":{"id":"/docs/components/modal-4","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#controlled","content":"Controlled"},"897":{"id":"/docs/components/modal-5","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#scrollable","content":"Scrollable"},"898":{"id":"/docs/components/modal-6","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#triggerless","content":"Triggerless"},"899":{"id":"/docs/components/modal-7","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#size","content":"Size"},"900":{"id":"/docs/components/modal-8","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#with-text-lockup","content":"With Text Lockup"},"901":{"id":"/docs/components/modal-9","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#accessibility","content":"Accessibility"},"902":{"id":"/docs/components/modal-10","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#keyboard-interaction","content":"Keyboard interaction"},"903":{"id":"/docs/components/modal-11","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#aria","content":"ARIA"},"904":{"id":"/docs/components/modal-12","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#best-practices","content":"Best Practices"},"905":{"id":"/docs/components/modal-13","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#props","content":"Props"},"906":{"id":"/docs/components/modal-14","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#modal","content":"Modal"},"907":{"id":"/docs/components/modal-15","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#modaltrigger","content":"ModalTrigger"},"908":{"id":"/docs/components/modal-16","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"`ModalTrigger` wraps a trigger button and a `<Modal>`, handling open state automatically. Based on RAC `DialogTrigger`."},"909":{"id":"/docs/components/modal-17","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"The modal is a `SizeProvider`. It opens at the size of the scope around its trigger, even though it renders in a portal, and `size` overrides that."},"910":{"id":"/docs/components/modal-18","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#default","content":"Compose a Modal from a `Heading slot=\"title\"`, a `CloseButton`, `Content`, and a\n`ButtonGroup`. `ModalTrigger` opens the Modal and manages its open/close state."},"911":{"id":"/docs/components/modal-19","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#controlled","content":"Pass `isOpen` and `onOpenChange` to `ModalTrigger` to control the open state externally."},"912":{"id":"/docs/components/modal-20","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#scrollable","content":"When the content is taller than the viewport, the `Content` region scrolls while the title\nrow and the `ButtonGroup` stay pinned."},"913":{"id":"/docs/components/modal-21","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#triggerless","content":"`Modal` accepts `isOpen` and `onOpenChange` directly, so it can be controlled without a\n`ModalTrigger`. Useful when the modal is opened from several places at once."},"914":{"id":"/docs/components/modal-22","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#size","content":"`size` sets the modal's text, controls, and spacing. Without it, the modal follows the size\nscope around its trigger."},"915":{"id":"/docs/components/modal-23","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#with-text-lockup","content":"A `TextLockup` in the content keeps its own title. The modal's `Heading slo