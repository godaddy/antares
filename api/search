ternative and version-pinning notes."},"21":{"id":"/docs-19","page_id":"/docs","tags":[],"type":"text","url":"/docs#framework-setup","content":"Antares ships CSS alongside its JavaScript modules. Each component chunk imports a corresponding `.css` file (e.g., `import './src-BZhWcxqJ.css'`). Most bundlers handle this automatically, but some frameworks need extra configuration to process CSS imports from `node_modules`."},"22":{"id":"/docs-20","page_id":"/docs","tags":[],"type":"text","url":"/docs#nextjs","content":"Add `@godaddy/antares` to `transpilePackages` so Next.js processes the package through its own CSS pipeline instead of treating it as a pre-built external:"},"23":{"id":"/docs-21","page_id":"/docs","tags":[],"type":"text","url":"/docs#nextjs","content":"Without this, Next.js will throw:"},"24":{"id":"/docs-22","page_id":"/docs","tags":[],"type":"text","url":"/docs#remix","content":"Remix with Vite handles CSS imports from `node_modules` in the client bundle automatically. However, during SSR, Vite treats `node_modules` as externals by default, which bypasses CSS processing. Add `@godaddy/antares` to `ssr.noExternal` to fix this:"},"25":{"id":"/docs-23","page_id":"/docs","tags":[],"type":"text","url":"/docs#vite","content":"Vite processes CSS imports from `node_modules` out of the box. No additional configuration is needed for client-side SPAs."},"26":{"id":"/docs-24","page_id":"/docs","tags":[],"type":"text","url":"/docs#vite","content":"If you are using Vite with SSR (e.g., custom SSR setup, not Remix), add `@godaddy/antares` to `ssr.noExternal` as shown in the Remix section."},"27":{"id":"/docs-25","page_id":"/docs","tags":[],"type":"text","url":"/docs#other-bundlers","content":"Any bundler that supports CSS imports will work with Antares. If your bundler does not process CSS imports from `node_modules` by default, ensure it is configured to do so. For example, with raw webpack you may need `css-loader` configured to handle `.css` files from `node_modules`."},"28":{"id":"/docs/components/accordion","page_id":"/docs/components/accordion","type":"page","content":"Accordion","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/accordion"},"29":{"id":"/docs/components/accordion-0","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion","content":"Accordion coordinates related collapsible sections with single or multiple expansion."},"30":{"id":"/docs/components/accordion-1","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#features","content":"Features"},"31":{"id":"/docs/components/accordion-2","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#installation","content":"Installation"},"32":{"id":"/docs/components/accordion-3","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#examples","content":"Examples"},"33":{"id":"/docs/components/accordion-4","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#customization","content":"Customization"},"34":{"id":"/docs/components/accordion-5","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#accessibility","content":"Accessibility"},"35":{"id":"/docs/components/accordion-6","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#keyboard","content":"Keyboard"},"36":{"id":"/docs/components/accordion-7","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#aria","content":"ARIA"},"37":{"id":"/docs/components/accordion-8","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#best-practices","content":"Best Practices"},"38":{"id":"/docs/components/accordion-9","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/ac