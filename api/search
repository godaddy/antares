red context"},"1188":{"id":"/docs/components/toggle-button-63","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"❌ For more than 5 choices — cognitive overload; consider a **Select** instead"},"1189":{"id":"/docs/components/toggle-button-64","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"❌ When actions require strong visual distinction (e.g. Save vs. Delete)"},"1190":{"id":"/docs/components/toggle-button-65","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"❌ When selecting an option leads to a different page or workflow — use navigation instead"},"1191":{"id":"/docs/components/toggle-button-66","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"❌ For mutually exclusive content views (e.g. Monthly / Yearly) — use **SegmentedController** instead"},"1192":{"id":"/docs/components/toggle-button-67","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keep-variants-consistent","content":"Avoid mixing different content types (text-only, icon-only, icon+text) within the same group. Mixing styles creates visual noise and makes the set feel fragmented rather than unified."},"1193":{"id":"/docs/components/toggle-button-68","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#balance-label-lengths","content":"Keep button labels of similar length. Large differences in text length cause irregular button widths and make the group appear uneven. Prefer short, concise wording."},"1194":{"id":"/docs/components/toggle-button-69","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#alignment","content":"Align the group to reflect its relationship to surrounding content:"},"1195":{"id":"/docs/components/toggle-button-70","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#alignment","content":"**Left** — when the group controls content directly below or within the same column (dashboards, tables)."},"1196":{"id":"/docs/components/toggle-button-71","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#alignment","content":"**Center** — when the group acts as a prominent toggle affecting an entire section or page."},"1197":{"id":"/docs/components/toggle-button-72","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#alignment","content":"**Right** — when the group represents utility or contextual controls (e.g. grid/list view toggle)."},"1198":{"id":"/docs/components/toggle-button-73","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#label-guidelines","content":"Use **title case**: capitalize the first letter of each word, except short prepositions."},"1199":{"id":"/docs/components/toggle-button-74","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#label-guidelines","content":"Keep labels to one or two words. Omit articles (a, an, the) and filler words."},"1200":{"id":"/docs/components/toggle-button-75","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#label-guidelines","content":"Prefer action-focused or descriptive language that communicates the option instantly."},"1201":{"id":"/docs/components/toggle-button-76","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#icon-only-items","content":"Use icon-only items only when the icon's meaning is universally recognized. Always provide an `aria-label` on each icon-only `ToggleButton`:"},"1202":{"id":"/docs/components/tooltip","page_id":"/docs/components/tooltip","type":"page","content":"Tooltip","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tooltip"},"1203":{"id":"/docs/components/tooltip-0","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip","content":"The Tooltip component displays a description of an element on hover or focus."},"1204":{"id":"/docs/components/tooltip-1","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#installation","content":"Installation"},"1205":{"id":"/docs/components/tooltip-2","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#examples","content":"Examples"},"1206":{"id":"/docs/components/tooltip-3","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#default","content":"Default"},"1207":{"id":"/docs/components/tooltip-4","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#custom-anchor","content":"Custom Anchor"},"1208":{"id":"/docs/components/tooltip-5","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#accessibility","content":"Accessibility"},"1209":{"id":"/docs/components/tooltip-6","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#keyboard","content":"Keyboard"},"1210":{"id":"/docs/components/tooltip-7","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#aria","content":"ARIA"},"1211":{"id":"/docs/components/tooltip-8","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#best-practices","content":"Best Practices"},"1212":{"id":"/docs/components/tooltip-9","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#props","content":"Props"},"1213":{"id":"/docs/components/tooltip-10","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip","content":"Tooltips appear after a short delay when hovering, and immediately when the element receives focus.\nOnce a tooltip has been shown, subsequent tooltips appear without delay."},"1214":{"id":"/docs/components/tooltip-11","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#default","content":"Use it with \\`TooltipTrigger\\`, which wraps both the tooltip content and a focusable element such as a \\`Button\\`. The tooltip appears on hover and focus."},"1215":{"id":"/docs/components/tooltip-12","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#custom-anchor","content":"To position a tooltip relative to a different focusable element, use the \\`triggerRef\\` prop. \\`TooltipTrigger\\` still handles showing and hiding on hover and focus."},"1216":{"id":"/docs/components/tooltip-13","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Key"},"1217":{"id":"/docs/components/tooltip-14","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Description"},"1218":{"id":"/docs/components/tooltip-15","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Tab"},"1219":{"id":"/docs/components/tooltip-16","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Moves focus to the focusable element and shows the tooltip"},"1220":{"id":"/docs/components/tooltip-17","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Escape"},"1221":{"id":"/docs/components/tooltip-18","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Closes the tooltip"},"1222":{"id":"/docs/components/tooltip-19","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#aria","content":"The tooltip uses `role=\"tooltip\"` and is associated with its focusable element via `aria-describedby`."},"1223":{"id":"/docs/components/tooltip-20","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Keep tooltip content short and informative."},"1224":{"id":"/docs/components/tooltip-21","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Tooltips are not shown on touch screen interactions. Ensure your UI is usable without tooltips."},"1225":{"id":"/docs/components/tooltip-22","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Do not place interactive content inside tooltips. Use a `Popover` instead."},"1226":{"id":"/docs/components/chart/bar-chart","page_id":"/docs/components/chart/bar-chart","type":"page","content":"Bar Chart","breadcrumbs":["Docs","Components","Chart"],"tags":[],"url":"/docs/components/chart/bar-chart"},"1227":{"id":"/docs/components/chart/bar-chart-0","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart","content":"A flexible, accessible, and design-aligned data visualization solution for displaying single or multi-series bar charts."},"1228":{"id":"/docs/components/chart/bar-chart-1","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#features","content":"Features"},"1229":{"id":"/docs/components/chart/bar-chart-2","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#installation","content":"Installation"},"1230":{"id":"/docs/components/chart/bar-chart-3","page_id":"/docs/components/chart/bar-cha