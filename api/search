chart#recommendations","content":"Use **custom domains** to maintain consistent scales across multiple charts"},"1754":{"id":"/docs/components/chart/bar-chart-76","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#recommendations","content":"**Tooltips** use absolute positioning and scroll-aware calculations for accurate placement"},"1755":{"id":"/docs/components/chart/bar-chart-77","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"The BarChart component is in active development. Current focus areas:"},"1756":{"id":"/docs/components/chart/bar-chart-78","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"✅ Single and multi-series support"},"1757":{"id":"/docs/components/chart/bar-chart-79","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"✅ Vertical and horizontal orientations"},"1758":{"id":"/docs/components/chart/bar-chart-80","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"✅ Responsive behavior with sticky axes"},"1759":{"id":"/docs/components/chart/bar-chart-81","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"✅ Interactive tooltips"},"1760":{"id":"/docs/components/chart/bar-chart-82","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"✅ Custom domains"},"1761":{"id":"/docs/components/chart/bar-chart-83","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"✅ Design system alignment"},"1762":{