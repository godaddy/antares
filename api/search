rt/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#development-status","content":"Development Status"},"1702":{"id":"/docs/components/chart/bar-chart-24","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#troubleshooting","content":"Troubleshooting"},"1703":{"id":"/docs/components/chart/bar-chart-25","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#bars-not-showing","content":"Bars Not Showing"},"1704":{"id":"/docs/components/chart/bar-chart-26","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#tooltip-positioning-issues","content":"Tooltip Positioning Issues"},"1705":{"id":"/docs/components/chart/bar-chart-27","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#performance-issues","content":"Performance Issues"},"1706":{"id":"/docs/components/chart/bar-chart-28","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#props","content":"Props"},"1707":{"id":"/docs/components/chart/bar-chart-29","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#barchart","content":"BarChart"},"1708":{"id":"/docs/components/chart/bar-chart-30","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Single and multi-series support**: Display one or multiple data series with grouped bars"},"1709":{"id":"/docs/components/chart/bar-chart-31","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Vertical and horizontal orientations**: Choose the best layout for your data and use case"},"1710":{"id":"/docs/components/chart/bar-chart-32","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Responsive behavior**: Auto-sizing with horizontal scrolling for many data points, sticky axes"},"1711":{"id":"/docs/components/chart/bar-chart-33","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Design system alignment**: 8px border radius, 12px bar width (1.5 GU), consistent spacing"},"1712":{"id":"/docs/components/chart/bar-chart-34","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Interactive tooltips**: Hover to see exact values, with smart positioning and scroll-awareness"},"1713":{"id":"/docs/components/chart/bar-chart-35","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Customizable axes**: Control gridlines, tick marks, axis titles, and tick formatting"},"1714":{"id":"/docs/components/chart/bar-chart-36","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Custom domains**: Set explicit x and y ranges for controlled scales across multiple charts"},"1715":{"id":"/docs/components/chart/bar-chart-37","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**RTL support*&#x2A;: Full right-to-left layout support for international audiences &#x2A;(in development)*"},"1716":{"id":"/docs/components/chart/bar-chart-38","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Accessibility ready**: Keyboard navigation, screen reader support, and semantic HTML"},"1717":{"id":"/docs/components/chart/bar-chart-39","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**TypeScript support**: Fully typed with comprehensive prop interfaces"},"1718":{"id":"/docs/components/chart/bar-chart-40","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**VisX integration**: Leverages VisX primitives for scales, axes, shapes, and responsive layout"},"1719":{"id":"/docs/components/chart/bar-chart-41","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#default","content":"You give the chart a `series` array plus `xAccessor` and `yAccessor` so it knows which field is the category and which is the value - this is the everyday setup for one set of vertical bars."},"1720":{"id":"/docs/components/chart/bar-chart-42","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#multi-series","content":"Pass more than one entry in `series` and the bars group by category, with a legend naming each series. Use it when the comparison between series matters as much as the values themselves."},"1721":{"id":"/docs/components/chart/bar-chart-43","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#horizontal-single-series","content":"`orientation=\"horizontal\"` swaps the axes: categories run down the side and values across the bottom. Reach for it when the labels are long or the chart is really a ranking."},"1722":{"id":"/docs/components/chart/bar-chart-44","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#horizontal-multi-series","content":"Grouped bars work horizontally too. With many categories the chart scrolls vertically, which is usually easier on a phone than scrolling sideways."},"1723":{"id":"/docs/components/chart/bar-chart-45","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#custom-domain","content":"`xDomain` and `yDomain` pin down exactly which categories and value range to draw. Here category `F` has no data and still gets an empty slot, and the Y range stays `[0, 40]` even though the largest bar is 30 - handy when several charts need to share a scale."},"1724":{"id":"/docs/components/chart/bar-chart-46","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#formatted-tick-marks","content":"`xTickFormat` and `yTickFormat` shape the axis labels - abbreviated dates on one axis, thousands separators on the other. The functions receive the raw accessor value, so they also cover currency, units, or percentages."},"1725":{"id":"/docs/components/chart/bar-chart-47","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#rtl-multi-series","content":"The chart follows the current layout direction, which is normally detected from the browser or system settings. In right-to-left it mirrors the axes, bars, and labels; this example forces RTL so you can see it in a left-to-right page. RTL support is still being refined - axis rendering and tick spacing in particular."},"1726":{"id":"/docs/components/chart/bar-chart-48","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#rtl-horizontal-multi-series","content":"Horizontal grouped bars in a right-to-left layout: bars grow from the right edge and the category axis moves to the right side."},"1727":{"id":"/docs/components/chart/bar-chart-49","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#series-colors","content":"Set `colorIndex` on a series to pin every bar in it to a specific color from the\nshared nine-color palette. Give two series the same `colorIndex` and separate them\nwith `opacity` instead of hue — a common way to show a comparison period against the\ncurrent one while keeping a single color identity."},"1728":{"id":"/docs/components/chart/bar-chart-50","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#series-colors","content":"Series can also have sparse data: a `null` value simply omits that bar. Each series\nhere drops out of a different date, and one date drops two of them at once, so the bars\npresent per group keep changing — yet every series stays the color its `colorIndex`\npins it to. Colors follow the series, never the bar's position, so the shifting gaps\nnever move a color onto the wrong series."},"1729":{"id":"/docs/components/chart/bar-chart-51","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#category-colors","content":"`categoryColors` maps individual category values to palette color indices, overriding\nthe series color for just those bars — so a single series can carry a different color\nper category. All three periods here share the same category-to-color map, so each\nchannel keeps one color across every period; the comparison periods are dropped to\nreduced opacity."},"1730":{"id":"/docs/components/chart/bar-chart-52","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#category-colors","content":"A category missing from the map falls back to the series' own default color. `Marketplace`\nand `Gift Cards` are both absent from `categoryColors`, so each period draws them in that\nperiod's default palette color instead of a shared channel color — showing the sparse-map\nfallback alongside the mapped channels."},"1731":{"id":"/docs/components/chart/bar-chart-53","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#custom-tooltip","content":"A `renderTooltip` example styled as a period-over-period comparison card, using\n`categoryColors` so each date owns its color. Hovering a bar group shows both years'\nvalues and the percent change; the tooltip swatch is resolved per category from the\nhovered datum, demonstrating category colors inside a custom tooltip."},"1732":{"id":"/docs/components/chart/bar-chart-54","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#spacing-and-sizing","content":"**Bar width**: 12px (1.5 grid units)"},"1733":{"id":"/docs/components/chart/bar-chart-55","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#spacing-and-sizing","content":"**Bar padding** (multi-series): 4px between bars within a group"},"1734":{"id":"/docs/components/chart/bar-chart-56","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#spacing-and-sizing","content":"**Group gap**: Minimum 24px between bar groups"},"1735":{"id":"/docs/components/chart/bar-chart-57","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#spacing-and-sizing","content":"**Border radius**: 8px on all bars"},"1736":{"id":"/docs/components/chart/bar-chart-58","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#spacing-and-sizing","content":"**Margins**: 20px top/right, 60px bottom/left for axes and labels"},"1737":{"id":"/docs/components/chart/bar-chart-59","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#responsive-behavior","content":"**Auto-sizing**: Uses VisX's `useParentSize` hook to adapt to container width"},"1738":{"id":"/docs/components/chart/bar-chart-60","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#responsive-behavior","content":"**Horizontal scrolling**: When data points exceed available width, the chart becomes horizontally scrollable"},"1739":{"id":"/docs/components/chart/bar-chart-61","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#responsive-behavior","content":"**Sticky y-axis**: The y-axis remains visible during horizontal scroll"},"1740":{"id":"/docs/components/chart/bar-chart-62","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#responsive-behavior","content":"**Minimum spacing**: Group gaps never fall below 24px, triggering scroll instead"},"1741":{"id":"/docs/components/chart/bar-chart-63","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#accessibility","content":"**Keyboard navigation**: Bar groups are keyboard accessible with `tabIndex={0}` and `role=\"group\"`"},"1742":{"id":"/docs/components/chart/bar-chart-64","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#accessibility","content":"**Screen reader support**: Semantic HTML structure with proper ARIA attributes"},"1743":{"id":"/docs/components/chart/bar-chart-65","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#accessibility","content":"**Tooltips**: Show on both hover and focus for keyboard users"},"1744":{"id":"/docs/components/chart/bar-chart-66","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#rendering-strategy","content":"The component uses VisX primitives for optimal SVG rendering:"},"1745":{"id":"/docs/components/chart/bar-chart-67","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#rendering-strategy","content":"**Scales**: VisX's `scaleBand` and `scaleLinear` for efficient coordinate mapping"},"1746":{"id":"/docs/components/chart/bar-chart-68","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/