onents/accordion-37","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"Toggle the focused section; focus stays on the trigger"},"62":{"id":"/docs/components/accordion-38","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#aria","content":"Each section's trigger is a native button with `aria-expanded` and `aria-controls` linked to its panel."},"63":{"id":"/docs/components/accordion-39","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#aria","content":"Each panel is labeled by its trigger through `aria-labelledby` automatically."},"64":{"id":"/docs/components/accordion-40","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Group related sections and keep essential information visible outside the accordion."},"65":{"id":"/docs/components/accordion-41","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Use descriptive section titles and heading levels that fit the page hierarchy."},"66":{"id":"/docs/components/accordion-42","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Use multiple expansion when users need to compare information across sections."},"67":{"id":"/docs/components/accordion-43","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Keep item IDs stable when reordering or filtering data."},"68":{"id":"/docs/components/accordion-44","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Manage expansion on Accordion when sections belong to a group."},"69":{"id":"/docs/components/accordion-45","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Keep form validation and step progression in application logic."},"70":{"id":"/docs/components/accordion-46","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#controlled-state-not-updating","content":"Update `expandedKeys` from `onExpandedChange` and make sure the keys match the item IDs.\nChanging `defaultExpandedKeys` after mounting does not control expansion."},"71":{"id":"/docs/components/accordion-47","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#sections-close-when-another-opens","content":"Enable `allowsMultipleExpanded` when several sections should remain open together.\nFor a single independent section, use Collapsible without an Accordion."},"72":{"id":"/docs/components/alert","page_id":"/docs/components/alert","type":"page","content":"Alert","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/alert"},"73":{"id":"/docs/components/alert-0","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert","content":"In-page alerts are non-intrusive notifications within a webpage, providing users with timely information or feedback without disrupting their experience."},"74":{"id":"/docs/components/alert-1","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#installation","content":"Installation"},"75":{"id":"/docs/components/alert-2","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#examples","content":"Examples"},"76":{"id":"/docs/components/alert-3","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#default","content":"Default"},"77":{"id":"/docs/components/alert-4","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#emphasis-variants","content":"Emphasis Variants"},"78":{"id":"/docs/components/alert-5","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#dismissible","content":"Dismissible"},"79":{"id":"/docs/components/alert-6","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#with-action","content":"With Action"},"80":{"id":"/docs/components/alert-7","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#accessibility","content":"Accessibility"},"81":{"id":"/docs/components/alert-8","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#keyboard","content":"Keyboard"},"82":{"id":"/docs/components/alert-9","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#screen-readers","content":"Screen readers"},"83":{"id":"/docs/components/alert-10","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#dismiss-button-label","content":"Dismiss button label"},"84":{"id":"/docs/components/alert-11","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#best-practices","content":"Best Practices"},"85":{"id":"/docs/components/alert-12","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#props","content":"Props"},"86":{"id":"/docs/components/alert-13","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#alert","content":"Alert"},"87":{"id":"/docs/components/alert-14","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#default","content":"A minimal alert with a title and body text."},"88":{"id":"/docs/components/alert-15","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#emphasis-variants","content":"All 7 emphasis categories. Each variant carries a distinct visual accent and semantic icon so the type of message is never communicated by color alone."},"89":{"id":"/docs/components/alert-16","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#dismissible","content":"When an `onClose` callback is provided, a dismiss button is rendered. The component does not manage its own visibility — the parent is responsible for unmounting or hiding the alert when `onClose` fires."},"90":{"id":"/docs/components/alert-17","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#with-action","content":"Pass a `Button` to the `actions` slot to give the user a clear path to resolve the alert."},"91":{"id":"/docs/components/alert-18","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Key"},"92":{"id":"/docs/components/alert-19","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Description"},"93":{"id":"/docs/components/alert-20","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"`Tab`"},"94":{"id":"/docs/components/alert-21","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Moves focus to the dismiss button or action button"},"95":{"id":"/docs/components/alert-22","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"`Space` / `Enter`"},"96":{"id":"/docs/components/alert-23","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Activates the focused button"},"97":{"id":"/docs/components/alert-24","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#screen-readers","content":"The alert container uses `role=\"alert\"`, which creates an ARIA live region. When an alert is rendered or its content changes, screen readers announce the message automatically — the user does not need to navigate to the alert to hear it."},"98":{"id":"/docs/components/alert-25","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#dismiss-button-label","content":"The dismiss button defaults to `aria-label=\"Close\"`. Override it via `ariaLabels={{ close: '...' }}` to provide more specific context for screen readers (e.g. `\"Dismiss payment warning\"`). This is especially useful when multiple alerts are visible at the same time."},"99":{"id":"/docs/components/alert-26","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Write alert content from the user's perspective: describe what happened and what they can do next, not the underlying technical error."},"100":{"id":"/docs/components/alert-27","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Use `critical` only when the user truly cannot continue without resolving the issue. Overusing it reduces its impact."},"101":{"id":"/docs/components/alert-28","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Always provide a `title` when the alert includes a dismiss button — it improves the reading experience for screen reader users."},"102":{"id":"/docs/components/alert-29","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"When using `actions`, prefer `secondary` or `tertiary` Button variants. Avoid placing a primary action inside an alert."},"103":{"id":"/docs/components/alert-30","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Do not stack multiple alerts of the same emphasis; consolidate the message into a single alert."},"104":{"id":"/docs/components/avatar","page_id":"/docs/components/avatar","type":"page","content":"Avatar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/avatar"},"105":{"id":"/docs/components/avatar-0","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar","content":"A visual representation of a user or entity, shown as a photo or a monogram of their initials."},"106":{"id":"/docs/components/avatar-1","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#features","content":"Features"},"107":{"id":"/docs/components/avatar-2","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#installation","content":"Installation"},"108":{"id":"/docs/components/avatar-3","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#examples","content":"Examples"},"109":{"id":"/docs/components/avatar-4","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#default","content":"Default"},"110":{"id":"/docs/components/avatar-5","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#image","content":"Image"},"111":{"id":"/docs/components/avatar-6","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#image-fallback","content":"Image Fallback"},"112":{"id":"/docs/components/avatar-7","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#shapes-and-sizes","content":"Shapes and sizes"},"113":{"id":"/docs/components/avatar-8","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#emphasis","content":"Emphasis"},"114":{"id":"/docs/components/avatar-9","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#avatar-button","content":"Avatar Button"},"115":{"id":"/docs/components/avatar-10","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#account-menu","content":"Account Menu"},"116":{"id":"/docs/components/avatar-11","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#customization","content":"Customization"},"117":{"id":"/docs/components/avatar-12","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#accessibility","content":"Accessibility"},"118":{"id":"/docs/components/avatar-13","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#best-practices","content":"Best Practices"},"119":{"id":"/docs/components/avatar-14","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#troubleshooting","content":"Troubleshooting"},"120":{"id":"/docs/components/avatar-15","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#props","content":"Props"},"121":{"id":"/docs/components/avatar-16","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#avatar","content":"Avatar"},"122":{"id":"/docs/components/avatar-17","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Composable `Avatar`, `Image`, and `Text` parts"},"123":{"id":"/docs/components/avatar-18","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Circle and rounded-square shapes at four named sizes"},"124":{"id":"/docs/components/avatar-19","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Automatic image loading with a Text monogram fallback"},"125":{"id":"/docs/components/avatar-20","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Primary, subtle, and 15 categorical figure emphases"},"126":{"id":"/docs/components/avatar-21","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Avatar Button and Account Menu compositions built with Pressable"},"127":{"id":"/docs/components/avatar-22","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#default","content":"Use an Avatar with a one- or two-character monogram when no image is available."},"128":{"id":"/docs/components/avatar-23","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#image","content":"Place Image before Text so the monogram is available while the image loads or if it fails."},"129":{"id":"/docs/components/avatar-24","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#image-fallback","content":"Include a Text fallback so an unavailable photo never leaves an empty identity marker."},"130":{"id":"/docs/components/avatar-25","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#shapes-and-sizes","content":"Use circular Avatars for people and square Avatars for organizations, workspaces, and accounts."},"131":{"id":"/docs/components/avatar-26","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#emphasis","content":"Use primary or subtle for standard treatments, and a deterministic figure emphasis to categorize entities in a list."},"132":{"id":"/docs/components/avatar-27","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#avatar-button","content":"Use `Pressable` to add accessible interaction to an Avatar while preserving its shape."},"133":{"id":"/docs/components/avatar-28","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#account-menu","content":"Wrap an Avatar in a Pressable inside MenuTrigger for an account or profile menu."},"134":{"id":"/docs/components/avatar-29","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#customization","content":"Use Image native image props for responsive image sources. Choose a deterministic `figure0` through `figure14` emphasis in lists that categorize multiple entities."},"135":{"id":"/docs/components/avatar-30","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#customization","content":"When an Avatar triggers an action, compose it with `Pressable` so the Avatar keeps its own shape and receives the interaction behavior directly. Use this pattern for an Avatar Button, or place it inside `MenuTrigger` for an Account Menu:"},"136":{"id":"/docs/components/avatar-31","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Give Image meaningful `alt` text when the image conveys an identity."},"137":{"id":"/docs/components/avatar-32","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Text remains available to assistive technology when no image loads."},"138":{"id":"/docs/components/avatar-33","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Use `alt=\"\"` on the Image and `aria-hidden=\"true\"` on the Avatar when the entire avatar is purely decorative."},"139":{"id":"/docs/components/avatar-34","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Give an Avatar Button or Account Menu an accessible name with `aria-label` or `aria-labelledby`."},"140":{"id":"/docs/components/avatar-35","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"When using `Pressable`, provide an interactive role for the non-semantic Avatar child."},"141":{"id":"/docs/components/avatar-36","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use Avatar for informational identity; compose it with `Pressable` for an Avatar Button or Account Menu when it is independently actionable."},"142":{"id":"/docs/components/avatar-37","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use circle for people and square for businesses, workspaces, and accounts."},"143":{"id":"/docs/components/avatar-38","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Keep monograms to one or two uppercase characters."},"144":{"id":"/docs/components/avatar-39","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use the same `figure*` emphasis for the same entity wherever it appears."},"145":{"id":"/docs/components/avatar-40","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"If an image is unavailable because of a bad URL or CORS policy, Text remains visible."},"146":{"id":"/docs/components/avatar-41","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"Long Text content is clipped to the avatar shape; provide a one- or two-character monogram."},"147":{"id":"/docs/components/avatar-42","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"Figure colors repeat after 15 values; assign a deterministic figure emphasis in the consuming application."},"148":{"id":"/docs/components/button","page_id":"/docs/components/button","type":"page","content":"Button","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/button"},"149":{"id":"/docs/components/button-0","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"The Button component allows users to initiate actions or submit forms with a single click"},"150":{"id":"/docs/components/button-1","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#installation","content":"Installation"},"151":{"id":"/docs/components/button-2","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#examples","content":"Examples"},"152":{"id":"/docs/components/button-3","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#default","content":"Default"},"153":{"id":"/docs/components/button-4","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#primary","content":"Primary"},"154":{"id":"/docs/components/button-5","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#secondary","content":"Secondary"},"155":{"id":"/docs/components/button-6","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#tertiary","content":"Tertiary"},"156":{"id":"/docs/components/button-7","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#critical","content":"Critical"},"157":{"id":"/docs/components/button-8","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#disabled","content":"Disabled"},"158":{"id":"/docs/components/button-9","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#icon","content":"Icon"},"159":{"id":"/docs/components/button-10","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#icons-and-alignment","content":"Icons And Alignment"},"160":{"id":"/docs/components/button-11","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#inline","content":"Inline"},"161":{"id":"/docs/components/button-12","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#minimal","content":"Minimal"},"162":{"id":"/docs/components/button-13","page_id":"