ccordion","tags":[],"type":"text","url":"/docs/components/accordion#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Exam"},"49":{"id":"/docs/components/accordion-20","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Compose related `Collapsible` sections inside Accordion. Give each section a stable, unique `id`.\nSee the Collapsible component documentation for more information about section anatomy, panel content, and trigger styling."},"50":{"id":"/docs/components/accordion-21","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Use `defaultExpandedKeys` for initial expansion, or `expandedKeys` with `onExpandedChange` for\ncontrolled state. Keys must match the section IDs; the callback receives a `Set` of expanded keys.\nBy default, only one section can stay open. Set `allowsMultipleExpanded` to keep several open.\nBoth behaviors are shown in the examples."},"51":{"id":"/docs/components/accordion-22","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Use `className` and `style` to customize the group container. `data-disabled` reflects the group's\ndisabled state. Customize individual headings, triggers, and panels on the composed Collapsible sections."},"52":{"id":"/docs/components/accordion-23","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"| Key                   | Action                                                        |\n| --------------------- | ------------------------------------------------------------- |\n| `Tab` / `Shift + Tab` | Move between enabled triggers and controls in expanded panels |","table":"table-0"},"53":{"id":"/docs/components/accordion-24","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"| Key               | Action                                                 |\n| ----------------- | ------------------------------------------------------ |\n| `Enter` / `Space` | Toggle the focused section; focus stays on the trigger |","table":"table-0"},"54":{"id":"/docs/components/accordion-25","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#aria","content":"Each section's trigger is a native button with `aria-expanded` and `aria-controls` linked to its panel."},"55":{"id":"/docs/components/accordion-26","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#aria","content":"Each panel is labeled by its trigger through `aria-labelledby` automatically."},"56":{"id":"/docs/components/accordion-27","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Group related sections and keep essential information visible outside the accordion."},"57":{"id":"/docs/components/accordion-28","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Use descriptive section titles and heading levels that fit the page hierarchy."},"58":{"id":"/docs/components/accordion-29","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Use multiple expansion when users need to compare information across sections."},"59":{"id":"/docs/components/accordion-30","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Keep item IDs stable when reordering or filtering data."},"60":{"id":"/docs/components/accordion-31","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Manage expansion on Accordion when sections belong to a group."},"61":{"id":"/docs/components/accordion-32","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Keep form validation and step progression in application logic."},"62":{"id":"/docs/components/accordion-33","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#controlled-state-not-updating","content":"Update `expandedKeys` from `onExpandedChange` and make sure the keys match the item IDs.\nChanging `defaultExpandedKeys` after mounting does not control expansion."},"63":{"id":"/docs/components/accordion-34","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#sections-close-when-another-opens","content":"Enable `allowsMultipleExpanded` when several sections should remain open together.\nFor a single independent section, use Collapsible without an Accordion."},"64":{"id":"/docs/components/alert","page_id":"/docs/components/alert","type":"page","content":"Alert","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/alert"},"65":{"id":"/docs/components/alert-0","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert","content":"In-page alerts are non-intrusive notifications within a webpage, providing users with timely information or feedback without disrupting their experience."},"66":{"id":"/docs/components/alert-1","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#installation","content":"Installation"},"67":{"id":"/docs/components/alert-2","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#examples","content":"Examples"},"68":{"id":"/docs/components/alert-3","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#accessibility","content":"Accessibility"},"69":{"id":"/docs/components/alert-4","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#keyboard","content":"Keyboard"},"70":{"id":"/docs/components/alert-5","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#screen-readers","content":"Screen readers"},"71":{"id":"/docs/components/alert-6","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#dismiss-button-label","content":"Dismiss button label"},"72":{"id":"/docs/components/alert-7","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#best-practices","content":"Best Practices"},"73":{"id":"/docs/components/alert-8","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#props","content":"Props"},"74":{"id":"/docs/components/alert-9","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#alert","content":"Alert"},"75":{"id":"/docs/components/alert-10","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#examples","content":"import { Meta, ArgTypes } from '@story"},"76":{"id":"/docs/components/alert-11","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stor"},"77":{"id":"/docs/components/alert-12","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './alert.stories.tsx';\n\n<Meta of={Stories}"},"78":{"id":"/docs/components/alert-13","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"| Key   | Description                                        |\n| ----- | -------------------------------------------------- |\n| `Tab` | Moves focus to the dismiss button or action button |","table":"table-0"},"79":{"id":"/docs/components/alert-14","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"| Key               | Description                  |\n| ----------------- | ---------------------------- |\n| `Space` / `Enter` | Activates the focused button |","table":"table-0"},"80":{"id":"/docs/components/alert-15","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#screen-readers","content":"The alert container uses `role=\"alert\"`, which creates an ARIA live region. When an alert is rendered or its content changes, screen readers announce the message automatically — the user does not need to navigate to the alert to hear it."},"81":{"id":"/docs/components/alert-16","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#dismiss-button-label","content":"The dismiss button defaults to `aria-label=\"Close\"`. Override it via `ariaLabels={{ close: '...' }}` to provide more specific context for screen readers (e.g. `\"Dismiss payment warning\"`). This is especially useful when multiple alerts are visible at the same time."},"82":{"id":"/docs/components/alert-17","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Write alert content from the user's perspective: describe what happened and what they can do next, not the underlying technical error."},"83":{"id":"/docs/components/alert-18","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Use `critical` only when the user truly cannot continue without resolving the issue. Overusing it reduces its impact."},"84":{"id":"/docs/components/alert-19","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Always provide a `title` when the alert includes a dismiss button — it improves the reading experience for screen reader users."},"85":{"id":"/docs/components/alert-20","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"When using `actions`, prefer `secondary` or `tertiary` Button variants. Avoid placing a primary action inside an alert."},"86":{"id":"/docs/components/alert-21","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Do not stack multiple alerts of the same emphasis; consolidate the message into a single alert."},"87":{"id":"/docs/components/avatar","page_id":"/docs/components/avatar","type":"page","content":"Avatar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/avatar"},"88":{"id":"/docs/components/avatar-0","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar","content":"A visual representation of a user or entity, shown as a photo or a monogram of their initials."},"89":{"id":"/docs/components/avatar-1","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#features","content":"Features"},"90":{"id":"/docs/components/avatar-2","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#installation","content":"Installation"},"91":{"id":"/docs/components/avatar-3","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#examples","content":"Examples"},"92":{"id":"/docs/components/avatar-4","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#customization","content":"Customization"},"93":{"id":"/docs/components/avatar-5","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#accessibility","content":"Accessibility"},"94":{"id":"/docs/components/avatar-6","page_id":