-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer","content":"`InlineDrawerPanel` is the collapsible content for the accordion pattern — a thin wrapper over RAC `DisclosurePanel` that hides when collapsed. The trigger is any component you slot in with `slot=\"trigger\"` — there's no dedicated trigger component."},"672":{"id":"/docs/components/inline-drawer-15","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"In-flow collapsible built on RAC Disclosure — bring your own trigger via `slot=\"trigger\"`"},"673":{"id":"/docs/components/inline-drawer-16","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Animated by default; `animate={false}` disables the transition"},"674":{"id":"/docs/components/inline-drawer-17","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"`placement` selects the collapse axis (`left`/`right` → width, `top`/`bottom` → height)"},"675":{"id":"/docs/components/inline-drawer-18","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Controlled and uncontrolled modes (`isExpanded` / `defaultExpanded` / `onExpandedChange`)"},"676":{"id":"/docs/components/inline-drawer-19","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Accordion collapse uses the browser's `hidden=\"until-found\"` for find-in-page"},"677":{"id":"/docs/components/inline-drawer-20","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"`prefers-reduced-motion` support"},"678":{"id":"/docs/components/inline-drawer-21","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#default","content":"Put a `<Button slot=\"trigger\">` and an `<InlineDrawerPanel>` inside `InlineDrawer`. The panel hides when collapsed and animates open."},"679":{"id":"/docs/components/inline-drawer-22","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#controlled","content":"Use `isExpanded` and `onExpandedChange` to drive state externally."},"680":{"id":"/docs/components/inline-drawer-23","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#sidebar-nav","content":"A rail whose content stays visible when collapsed is a composition, not a mode: drive `isExpanded` yourself, render always-visible children (no `InlineDrawerPanel`), and let `minSize`/`maxSize` size the rail. Use numeric (px) sizes so the width animates; intrinsic keywords like `min-content`/`max-content` fit the content exactly but don't animate."},"681":{"id":"/docs/components/inline-drawer-24","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Key"},"682":{"id":"/docs/components/inline-drawer-25","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Action"},"683":{"id":"/docs/components/inline-drawer-26","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"`Enter` / `Space`"},"684":{"id":"/docs/components/inline-drawer-27","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Toggle via the slotted trigger"},"685":{"id":"/docs/components/inline-drawer-28","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"`Tab`"},"686":{"id":"/docs/components/inline-drawer-29","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Move focus through the content"},"687":{"id":"/docs/components/inline-drawer-30","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#aria","content":"A `<Button slot=\"trigger\">` gets `aria-expanded` + `aria-controls` wired to the `InlineDrawerPanel` automatically (via RAC Disclosure)."},"688":{"id":"/docs/components/inline-drawer-31","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#aria","content":"For the sidebar rail, the toggle is your own control (e.g. a `ToggleButton`) — give icon-only buttons an `aria-label`, and the content stays in the DOM and accessible since nothing is hidden."},"689":{"id":"/docs/components/inline-drawer-32","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"Accordion → `Button slot=\"trigger\"` + `InlineDrawerPanel`. Sidebar rail → controlled state + always-visible children."},"690":{"id":"/docs/components/inline-drawer-33","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"For the rail, use numeric (px) `minSize`/`maxSize` so the width animates; `min-content`/`max-content` fit the content exactly but won't animate."},"691":{"id":"/docs/components/inline-drawer-34","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"`placement` does not flip in RTL; the side is decided by document/flex order."},"692":{"id":"/docs/components/inline-drawer-35","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"Don't nest InlineDrawers."},"693":{"id":"/docs/components/input","page_id":"/docs/components/input","type":"page","content":"Input","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/input"},"694":{"id":"/docs/components/input-0","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input","content":"Single-line text control for use inside a field."},"695":{"id":"/docs/components/input-1","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#installation","content":"Installation"},"696":{"id":"/docs/components/input-2","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#examples","content":"Examples"},"697":{"id":"/docs/components/input-3","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#default","content":"Default"},"698":{"id":"/docs/components/input-4","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#props","content":"Props"},"699":{"id":"/docs/components/input-5","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#input","content":"Input"},"700":{"id":"/docs/components/input-6","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input","content":"`Input` is the single-line control inside a field, not a field on its own. Prefer `TextField` or `NumberField` as the parent; see those components for fuller examples."},"701":{"id":"/docs/components/input-7","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#default","content":"Input inside TextField."},"702":{"id":"/docs/components/label","page_id":"/docs/components/label","type":"page","content":"Label","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/label"},"703":{"id":"/docs/components/label-0","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label","content":"Names a form field. The required asterisk appears when the field is required."},"704":{"id":"/docs/components/label-1","page_id":"/docs/components/label","type":"hea