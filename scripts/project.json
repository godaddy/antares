{
  "name": "scripts",
  "implicitDependencies": [
    "@bento/block-explorer",
    "@bento/storybook-addon-helpers",
    "@godaddy/antares"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        {
          "projects": ["@godaddy/antares"],
          "target": "build"
        }
      ],
      "options": {
        "cwd": ".",
        "command": "vitest run --config scripts/test/vitest.config.mts"
      }
    }
  }
}
