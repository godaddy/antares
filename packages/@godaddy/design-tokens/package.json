{
  "name": "@godaddy/design-tokens",
  "version": "0.1.0",
  "description": "The GoDaddy design tokens library",
  "type": "module",
  "scripts": {
    "test:watch": "vitest",
    "build:schema": "shx cp src/schema.json dist/schema.json && shx cp src/extensions.d.ts dist/extensions.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "bundle-size:check": "node ../../../scripts/bundle-analysis.ts --package-from-cwd --check",
    "build": "pnpm run build:sd && pnpm run build:schema",
    "build:sd": "tsx src/build-tokens.ts",
    "bundle-size:build": "node ../../../scripts/bundle-analysis.ts --package-from-cwd"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godaddy/antares.git",
    "directory": "packages/design-tokens"
  },
  "keywords": [
    "design",
    "tokens",
    "design-tokens",
    "dtcg",
    "css-variables",
    "scss",
    "style-dictionary"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/godaddy/antares/issues"
  },
  "homepage": "https://github.com/godaddy/antares/tree/main/packages/design-tokens#readme",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "vitest": "catalog:",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "ajv": "^8.20.0",
    "@upft/schemas": "^0.0.6",
    "style-dictionary": "^5.8.0",
    "shx": "^0.4.0"
  },
  "exports": {
    "./css-in-js": {
      "import": "./dist/css-in-js.js",
      "default": "./dist/css-in-js.js"
    },
    "./scss": {
      "default": "./dist/scss.scss"
    },
    "./classnames.module.css": {
      "default": "./dist/classnames.module.css"
    },
    "./css-data": {
      "default": "./dist/design-tokens.css-data.json"
    },
    "./dtcg.json": {
      "default": "./dist/dtcg.json"
    },
    "./schema": {
      "default": "./dist/schema.json"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
