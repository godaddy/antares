// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`@godaddy/antares > #Card > renders a native linked content region 1`] = `"<div data-card="interactive" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><a class="link box flex column content" data-rac="" aria-label="About this product" href="/about" tabindex="0" data-react-aria-pressable="true"><span class="text">About this product</span></a><button class="button tertiary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_a_"><span class="text">Save</span></button></div>"`;

exports[`@godaddy/antares > #Card > renders a selection composition 1`] = `"<div class="box flex" style="display:contents" data-rac=""><div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)">Selectable card content<div data-corner-actions="true" class="box flex" style="align-items:center;gap:var(--sp-sm)"><label data-card-selection-control="true" data-react-aria-pressable="true" class="control" data-rac=""><span style="border:0;clip:rect(0 0 0 0);clip-path:inset(50%);height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px;white-space:nowrap"><input aria-label="Select this card" aria-describedby="react-aria-_R_0_ react-aria-_R_0H1_" type="checkbox" data-react-aria-pressable="true" tabindex="0"/></span><span data-testid="card-selection-indicator" aria-hidden="true" data-card-selection-indicator="true" data-visibility="always" class="indicator"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon checkmark" aria-hidden="true" data-override="className" data-loading="true" data-icon="checkmark" data-slot="content"></svg></span></label></div></div></div>"`;

exports[`@godaddy/antares > #Card > renders separate linked and selection controls 1`] = `"<div class="box flex" style="display:contents" data-rac=""><div data-card="interactive" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><a class="link box flex column content" data-rac="" aria-label="Select details" href="/details" tabindex="0" data-react-aria-pressable="true"><span class="text" id="react-aria-_R_0_" slot="description">Open details</span></a><div data-corner-actions="true" class="box flex" style="align-items:center;gap:var(--sp-sm)"><label data-card-selection-control="true" data-react-aria-pressable="true" class="control" data-rac=""><span style="border:0;clip:rect(0 0 0 0);clip-path:inset(50%);height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px;white-space:nowrap"><input aria-label="Select details" aria-describedby="react-aria-_R_0_ react-aria-_R_0H1_" type="checkbox" data-react-aria-pressable="true" tabindex="0" value="details"/></span><span data-testid="combined-selection-indicator" aria-hidden="true" data-card-selection-indicator="true" data-visibility="always" class="indicator"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon checkmark" aria-hidden="true" data-override="className" data-loading="true" data-icon="checkmark" data-slot="content"></svg></span></label></div></div></div>"`;

exports[`@godaddy/antares > #Card > renders the default composition 1`] = `"<div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><h3 class="heading">A composed card</h3><span class="text">Cards provide a surface while consumers own the interior layout.</span></div>"`;
