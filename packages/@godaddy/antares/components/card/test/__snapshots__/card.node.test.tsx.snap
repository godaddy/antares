exports[`@godaddy/antares > #Card > renders inset, full bleed, standalone and custom media 1`] = `"<div class="box grid" style="grid-template-columns:repeat(auto-fit, minmax(min(100%, 16rem), 1fr));align-items:start;gap:var(--sp-lg)"><div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg);--card-padding:var(--sp-lg)"><img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 640 360%22%3E%3Crect width=%22640%22 height=%22360%22 fill=%22%23145fa9%22/%3E%3Ccircle cx=%22480%22 cy=%22110%22 r=%2270%22 fill=%22%234ecdc4%22/%3E%3Cpath d=%22M0 300 180 150l120 100 90-75 250 185H0z%22 fill=%22%230b3d91%22/%3E%3C/svg%3E" alt="Blue mountain landscape" width="640" height="360" style="display:block;width:100%;height:auto"/><div data-size="md" data-align="start" data-legible-lines="" class="box flex column lockup" style="gap:var(--sp-sm)"><span slot="eyebrow" class="tag" data-emphasis="passive" data-size="md" data-design="filled">Inset</span><h3 slot="title" class="title heading">Inset media</h3><span class="body text" slot="body">The default Card padding keeps media inset.</span></div></div><div data-card="static" class="box flex column card" style="padding:0;gap:var(--sp-lg);--card-padding:0"><div class="box" style="overflow:hidden;border-start-start-radius:inherit;border-start-end-radius:inherit"><img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 640 360%22%3E%3Crect width=%22640%22 height=%22360%22 fill=%22%23145fa9%22/%3E%3Ccircle cx=%22480%22 cy=%22110%22 r=%2270%22 fill=%22%234ecdc4%22/%3E%3Cpath d=%22M0 300 180 150l120 100 90-75 250 185H0z%22 fill=%22%230b3d91%22/%3E%3C/svg%3E" alt="Blue mountain landscape" width="640" height="360" style="display:block;width:100%;height:auto"/></div><div class="box flex column" style="padding:var(--sp-lg);flex:1 1 auto;gap:var(--sp-lg);min-block-size:0;overflow:visible"><div data-size="md" data-align="start" data-legible-lines="" class="box flex column lockup" style="gap:var(--sp-sm)"><span slot="eyebrow" class="tag" data-emphasis="passive" data-size="md" data-design="filled">Full bleed</span><h3 slot="title" class="title heading">Full bleed media</h3><span class="body text" slot="body">Content supplies its own padding beneath the edge-to-edge image.</span></div></div></div><div data-card="static" class="box flex column card" style="padding:0;gap:0;--card-padding:0"><div class="box" style="overflow:hidden;border-radius:inherit"><img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 640 360%22%3E%3Crect width=%22640%22 height=%22360%22 fill=%22%23145fa9%22/%3E%3Ccircle cx=%22480%22 cy=%22110%22 r=%2270%22 fill=%22%234ecdc4%22/%3E%3Cpath d=%22M0 300 180 150l120 100 90-75 250 185H0z%22 fill=%22%230b3d91%22/%3E%3C/svg%3E" alt="A media-only card showing a blue mountain landscape" width="640" height="360" style="display:block;width:100%;height:auto"/></div></div><div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg);--card-padding:var(--sp-lg)"><div data-size="md" data-align="start" data-legible-lines="" class="box flex column lockup" style="gap:var(--sp-sm)"><span slot="eyebrow" class="tag" data-emphasis="passive" data-size="md" data-design="filled">Custom</span><h3 slot="title" class="title heading">Custom media after content</h3><span class="body text" slot="body">A plain Box can hold a gradient or illustration, before or after the text.</span></div><div class="box" style="aspect-ratio:16 / 9;background:linear-gradient(135deg, #145fa9 0%, #4ecdc4 100%);border-radius:6px"></div></div></div>"`;

