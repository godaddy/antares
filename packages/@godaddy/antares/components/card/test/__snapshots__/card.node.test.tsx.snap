exports[`@godaddy/antares > #Card > renders a responsive composition 1`] = `"<div data-testid="container-query-container" class="box container"><div data-testid="container-query-card" data-card="static" class="box flex column card card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 320 240%22%3E%3Crect width=%22320%22 height=%22240%22 fill=%22%23145fa9%22/%3E%3Ccircle cx=%22220%22 cy=%2270%22 r=%2250%22 fill=%22%234ecdc4%22/%3E%3C/svg%3E" alt="Blue abstract landscape" width="320" height="240" data-testid="container-query-media" slot="media"/><div data-testid="container-query-content" class="box flex column" style="flex-grow:1;gap:var(--sp-sm)"><h3 class="heading">Container-owned responsiveness</h3><span class="text">The surrounding container decides when this composition stacks or becomes horizontal.</span></div></div></div>"`;

exports[`@godaddy/antares > #Card > renders collections with bottom actions and corner spacing 1`] = `"<div class="box grid" style="grid-template-columns:repeat(auto-fit, minmax(min(100%, 16rem), 1fr));align-items:stretch;gap:var(--sp-md)"><div data-testid="collection-card-0" data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-md)"><header class="box flex" style="padding:0;justify-content:space-between;align-items:start;flex-wrap:wrap;gap:var(--sp-sm)"><h3 style="min-width:0;flex:1 1 10rem" class="heading">Card 1</h3><div data-corner-actions="true" class="box flex" style="align-self:start;align-items:center;gap:var(--sp-sm)"><button class="button minimal md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" aria-label="More options for card 1" id="react-aria-_R_4p_"><span class="text">...</span></button></div></header><div class="box flex column" style="padding:0;flex:1 1 auto;flex-grow:1;gap:var(--sp-lg);min-block-size:0;overflow:visible"><div data-size="md" data-align="start" data-legible-lines="" class="box flex column lockup" style="gap:var(--sp-sm)"><span class="eyebrow text" slot="eyebrow">Recommended</span><span class="body text" slot="body">Short description</span></div></div><footer class="box flex" style="padding:0;justify-content:end;align-items:center;gap:var(--sp-md)"><button data-testid="collection-action-0" class="button tertiary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_1p_"><span class="text">View details</span></button></footer></div><div data-testid="collection-card-1" data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-md)"><header class="box flex" style="padding:0;justify-content:space-between;align-items:start;flex-wrap:wrap;gap:var(--sp-sm)"><h3 style="min-width:0;flex:1 1 10rem" class="heading">Card 2</h3><div data-corner-actions="true" class="box flex" style="align-self:start;align-items:center;g