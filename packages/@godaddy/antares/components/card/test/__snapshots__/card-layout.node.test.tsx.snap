exports[`@godaddy/antares > #Card layout compositions > renders consumer-owned collections and responsiveness 1`] = `"<div class="box grid" style="grid-template-columns:repeat(3, minmax(0, 1fr));align-items:stretch;gap:var(--sp-md)"><div data-testid="collection-card-0" data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-md)"><div class="box flex column" style="flex-grow:1;gap:var(--sp-sm)"><h3 class="heading">Card <!-- -->1</h3><span class="text">Short description</span></div><button data-testid="collection-action-0" class="button tertiary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_19_"><span class="text">View details</span></button></div><div data-testid="collection-card-1" data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-md)"><div class="box flex column" style="flex-grow:1;gap:var(--sp-sm)"><h3 class="heading">Card <!-- -->2</h3><span class="text">A medium description gives this card more content.</span></div><button data-testid="collection-action-1" class="button tertiary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_1a_"><span class="text">View details</span></button></div><div data-testid="collection-card-2" data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-md)"><div class="box flex column" style="flex-grow:1;gap:var(--sp-sm)"><h3 class="heading">Card <!-- -->3</h3><span class="text">A longer description demonstrates that each card can grow while its action stays aligned.</span></div><button data-testid="collection-action-2" class="button tertiary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_1b_"><span class="text">View details</span></button></div></div>"`;

exports[`@godaddy/antares > #Card layout compositions > renders consumer-owned collections and responsiveness 2`] = `"<div data-testid="container-query-container" class="box container"><div data-testid="container-query-card" data-card="static" class="box flex column card card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 320 240%22%3E%3Crect width=%22320%22 height=%22240%22 fill=%22%23145fa9%22/%3E%3Ccircle cx=%22220%22 cy=%2270%22 r=%2250%22 fill=%22%234ecdc4%22/%3E%3C/svg%3E" alt="Blue abstract landscape" width="320" height="240" data-testid="container-query-media" slot="media"/><div data-testid="container-query-content" class="box flex column" style="flex-grow:1;gap:var(--sp-sm)"><h3 class="heading">Container-owned responsiveness</h3><span class="text">The surrounding container decides when this composition stacks or becomes horizontal.</span></div></div></div>"`;

exports[`@godaddy/antares > #Card layout compositions > renders explicit corner spacing for long text 1`] = `"<div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><div class="box flex column" style="gap:var(--sp-md);min-width:0"><div class="box flex" style="justify-content:space-between;align-items:start;flex-wrap:wrap;gap:var(--sp-md)"><h3 style="min-width:0;flex:1 1 12rem" class="heading">A long title wraps without colliding with the corner actions</h3><div data-corner-actions="true" class="box flex" style="align-items:center;gap:var(--sp-sm)"><button class="button minimal md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" aria-label="More options" id="react-aria-_R_16_"><span class="text">...</span></button></div></div><span class="text">Keep corner controls in an explicit layout region so text remains readable at narrow widths. The Card does not measure or reorder arbitrary children for you.</span></div></div>"`;

exports[`@godaddy/antares > #Card layout compositions > renders text and media compositions 1`] = `
"<div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><div class="box flex column" style="flex-grow:1;gap:var(--sp-sm)"><h3 class="heading">A text-only card</h3><span class="text">Use ordinary children when a card needs no media.</span></div><div class="box flex" style="justify-content:end;gap:var(--sp-sm)"><button class="button secondary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_q_"><span class="text">Cancel</span></button><button class="button tertiary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_1a_"><span class="text">Continue</span></button></div></div>
<div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><div data-size="md" data-align="start" data-legible-lines="" class="box flex column lockup" style="gap:var(--sp-sm)"><span class="eyebrow text" slot="eyebrow">Recommended</span><h3 slot="title" class="title heading">A coordinated text lockup</h3><span class="body text" slot="body">TextLockup keeps the type hierarchy together while Card owns only the surface.</span></div></div>
<div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 640 360%22%3E%3Crect width=%22640%22 height=%22360%22 fill=%22%23145fa9%22/%3E%3Ccircle cx=%22480%22 cy=%22110%22 r=%2270%22 fill=%22%234ecdc4%22/%3E%3Cpath d=%22M0 300 180 150l120 100 90-75 250 185H0z%22 fill=%22%230b3d91%22/%3E%3C/svg%3E" alt="Blue mountain landscape" width="640" height="360" slot="media"/><div class="box flex column" style="gap:var(--sp-sm)"><h3 class="heading">Inset media</h3><span class="text">The image participates in the consumer-owned layout and keeps the card&#x27;s standard inset.</span></div></div>
<div data-card="static" class="box flex column card" style="padding:0;gap:0"><div slot="media" class="box" style="overflow:hidden;border-radius:inherit"><img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 640 360%22%3E%3Crect width=%22640%22 height=%22360%22 fill=%22%23f1b24a%22/%3E%3Cpath d=%22M0 360 210 120l130 120 80-70 220 190H0z%22 fill=%22%23d45d3f%22/%3E%3C/svg%3E" alt="Warm abstract landscape" width="640" height="360" style="display:block;width:100%"/></div></div>
<div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><div slot="media" class="box" style="aspect-ratio:16 / 9;background:linear-gradient(135deg, #145fa9 0%, #4ecdc4 100%);border-radius:6px"></div><h3 class="heading">Custom media</h3><span class="text">A slotted Box is useful for gradients, illustrations, or other media containers.</span></div>
<div data-card="interactive" class="box flex column card" style="padding:0;gap:0"><a class="link box flex column content" data-rac="" aria-label="Read the full bleed story" href="/stories/full-bleed" tabindex="0" data-react-aria-pressable="true"><div slot="media" class="box" style="overflow:hidden;border-radius:inherit"><img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 640 360%22%3E%3Crect width=%22640%22 height=%22360%22 fill=%22%230b3d91%22/%3E%3Ccircle cx=%22500%22 cy=%22100%22 r=%2280%22 fill=%22%23f1b24a%22/%3E%3C/svg%3E" alt="Blue sky with a yellow sun" width="640" height="360" style="display:block;width:100%"/></div><div class="box" style="padding:var(--sp-lg)"><h3 class="heading">Full bleed media</h3><span class="text">The content region supplies its own padding while Card keeps the media edge to edge.</span></div></a></div>
<div data-card="static" class="box flex card" style="padding:var(--sp-lg);align-items:stretch;gap:var(--sp-lg)"><img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 320 360%22%3E%3Crect width=%22320%22 height=%22360%22 fill=%22%234ecdc4%22/%3E%3Cpath d=%22M0 360 120 160l70 70 55-55 75 185H0z%22 fill=%22%230b3d91%22/%3E%3C/svg%3E" alt="Abstract teal landscape" width="160" height="180" style="width:40%;object-fit:cover" slot="media"/><div class="box" style="flex:1 1 0;min-width:0"><div class="box flex column" style="gap:var(--sp-sm)"><h3 class="heading">Horizontal media</h3><span class="text">The consumer chooses the 40% media width and can change it for the surrounding layout.</span></div></div></div>
<div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><div class="box"><h3 class="heading">Vertical media order</h3><span class="text">Media may follow the content when the consumer&#x27;s information hierarchy calls for it.</span></div><img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 640 240%22%3E%3Crect width=%22640%22 height=%22240%22 fill=%22%23d45d3f%22/%3E%3Cpath d=%22M0 240 200 40l100 100 100-80 240 180H0z%22 fill=%22%23f1b24a%22/%3E%3C/svg%3E" alt="Abstract orange landscape" width="640" height="240" style="width:100%" slot="media"/></div>"
`;
