// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`@godaddy/antares > #Text > renders empty Text with span element 1`] = `"<span class="text type typeText"></span>"`;

exports[`@godaddy/antares > #Text > renders the align example 1`] = `"<p class="text type typeText" style="--align:center">Text is aligned to the center</p>"`;

exports[`@godaddy/antares > #Text > renders the as example 1`] = `"<marquee class="text type typeText">A scrolling marquee</marquee>"`;

exports[`@godaddy/antares > #Text > renders the detail example 1`] = `"<div class="box flex column" style="gap:var(--sp-xs)"><span class="text type typeText">Quarterly report</span><span class="text type typeDetail typePassive">Updated 2 hours ago</span></div>"`;

exports[`@godaddy/antares > #Text > renders the emphasis example 1`] = `"<div class="box flex column" style="gap:var(--sp-sm)"><span class="text type typeText typeCritical">Payment failed</span><span class="text type typeText typeWarning">Card expires soon</span><span class="text type typeText typeSuccess">Payment received</span><span class="text type typeText typeInfo">Invoice sent</span><span class="text type typeText typePassive">No recent activity</span></div>"`;

exports[`@godaddy/antares > #Text > renders the maxLines example 1`] = `"<div style="width:300px;border:1px solid red"><p class="text type typeText" style="--max-lines:2">This will have a maximum of two lines. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p></div>"`;

exports[`@godaddy/antares > #Text > renders the sizes example 1`] = `"<div class="box flex column" style="gap:var(--sp-sm)"><span class="text type typeText">Inherited</span><span class="text type typeText typeXs">Extra small</span><span class="text type typeText typeSm">Small</span><span class="text type typeText typeMd">Medium</span><span class="text type typeText typeLg">Large</span><span class="text type typeText typeXl">Extra large</span><span class="text type typeText type2xl">2x large</span></div>"`;

exports[`@godaddy/antares > #Text > renders the text example 1`] = `"<span class="text type typeText">Hello, world!</span>"`;

exports[`@godaddy/antares > #Text > renders the wrap example 1`] = `"<div style="width:300px;border:1px solid red"><p class="text type typeText" style="--wrap:pretty">Text is wrapped in a way that best balances the number of characters on each line, enhancing layout quality and legibility. Because counting characters and balancing them across multiple lines is computationally expensive, this value is only supported for blocks of text spanning a limited number of lines</p></div>"`;
