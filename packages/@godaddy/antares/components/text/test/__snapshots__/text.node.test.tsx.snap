// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`@godaddy/antares > #Text > renders empty Text with span element 1`] = `"<span class="text typography body md"></span>"`;

exports[`@godaddy/antares > #Text > renders the align example 1`] = `"<p class="text typography body md" style="--align:center">Text is aligned to the center</p>"`;

exports[`@godaddy/antares > #Text > renders the as example 1`] = `"<marquee class="text typography body md">A scrolling marquee</marquee>"`;

exports[`@godaddy/antares > #Text > renders the maxLines example 1`] = `"<div style="width:300px;border:1px solid red"><p class="text typography body md" style="--max-lines:2">This will have a maximum of two lines. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p></div>"`;

exports[`@godaddy/antares > #Text > renders the text example 1`] = `"<span class="text typography body md">Hello, world!</span>"`;

exports[`@godaddy/antares > #Text > renders the wrap example 1`] = `"<div style="width:300px;border:1px solid red"><p class="text typography body md" style="--wrap:pretty">Text is wrapped in a way that best balances the number of characters on each line, enhancing layout quality and legibility. Because counting characters and balancing them across multiple lines is computationally expensive, this value is only supported for blocks of text spanning a limited number of lines</p></div>"`;

exports[`@godaddy/antares > #Text > renders typography treatments 1`] = `"<div class="box flex column" style="gap:var(--sp-md)"><div class="box flex" style="align-items:baseline;flex-wrap:wrap;gap:var(--sp-md)"><h3 class="heading typography heading xs explicitSize">Heading <!-- -->xs</h3><span class="text typography body xs explicitSize">Body <!-- -->xs</span><span class="text typography detail xs explicitSize">Detail <!-- -->xs</span><label class="typography label xs explicitSize">Label <!-- -->xs</label></div><div class="box flex" style="align-items:baseline;flex-wrap:wrap;gap:var(--sp-md)"><h3 class="heading typography heading sm explicitSize">Heading <!-- -->sm</h3><span class="text typography body sm explicitSize">Body <!-- -->sm</span><span class="text typography detail sm explicitSize">Detail <!-- -->sm</span><label class="typography label sm explicitSize">Label <!-- -->sm</label></div><div class="box flex" style="align-items:baseline;flex-wrap:wrap;gap:var(--sp-md)"><h3 class="heading typography heading md explicitSize">Heading <!-- -->md</h3><span class="text typography body md explicitSize">Body <!-- -->md</span><span class="text typography detail md explicitSize">Detail <!-- -->md</span><label class="typography label md explicitSize">Label <!-- -->md</label></div><div class="box flex" style="align-items:baseline;flex-wrap:wrap;gap:var(--sp-md)"><h3 class="heading typography heading lg explicitSize">Heading <!-- -->lg</h3><span class="text typography body lg explicitSize">Body <!-- -->lg</span><span class="text typography detail lg explicitSize">Detail <!-- -->lg</span><label class="typography label lg explicitSize">Label <!-- -->lg</label></div><div class="box flex" style="align-items:baseline;flex-wrap:wrap;gap:var(--sp-md)"><h3 class="heading typography heading xl explicitSize">Heading <!-- -->xl</h3><span class="text typography body xl explicitSize">Body <!-- -->xl</span><span class="text typography detail xl explicitSize">Detail <!-- -->xl</span><label class="typography label xl explicitSize">Label <!-- -->xl</label></div><div class="box flex" style="align-items:baseline;flex-wrap:wrap;gap:var(--sp-md)"><h3 class="heading typography heading 2xl explicitSize">Heading <!-- -->2xl</h3><span class="text typography body 2xl explicitSize">Body <!-- -->2xl</span><span class="text typography detail 2xl explicitSize">Detail <!-- -->2xl</span><label class="typography label 2xl explicitSize">Label <!-- -->2xl</label></div><strong class="text typography body md">Strong body</strong><em class="text typography detail md">Emphasized detail</em><p class="text typography body md">Paragraph body</p><span class="text typography body md critical">critical</span><span class="text typography body md warning">warning</span><span class="text typography body md success">success</span><span class="text typography body md info">info</span><span class="text typography body md highlight">highlight</span><span class="text typography body md premium">premium</span><span class="text typography body md internal">internal</span><span class="text typography body md neutral">neutral</span><span class="text typography body md passive">passive</span></div>"`;
