// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`@godaddy/antares > #Text > renders empty Text with span element 1`] = `"<span class="text type typeText scaleMd"></span>"`;

exports[`@godaddy/antares > #Text > renders the align example 1`] = `"<p class="text type typeText scaleMd" style="--align:center">Text is aligned to the center</p>"`;

exports[`@godaddy/antares > #Text > renders the as example 1`] = `"<marquee class="text type typeText scaleMd">A scrolling marquee</marquee>"`;

exports[`@godaddy/antares > #Text > renders the detail example 1`] = `"<div class="box flex column" style="gap:var(--sp-xs)"><span class="text type typeText scaleMd">Quarterly report</span><span class="text type typeDetail scaleMd typePassive">Updated 2 hours ago</span></div>"`;

exports[`@godaddy/antares > #Text > renders the emphasis example 1`] = `"<div class="box flex column" style="gap:var(--sp-sm)"><span class="text type typeText scaleMd typeCritical">Payment failed</span><span class="text type typeText scaleMd typeWarning">Card expires soon</span><span class="text type typeText scaleMd typeSuccess">Payment received</span><span class="text type typeText scaleMd typeInfo">Invoice sent</span><span class="text type typeText scaleMd typePassive">No recent activity</span></div>"`;

exports[`@godaddy/antares > #Text > renders the maxLines example 1`] = `"<div style="width:300px;border:1px solid red"><p class="text type typeText scaleMd" style="--max-lines:2">This will have a maximum of two lines. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p></div>"`;

exports[`@godaddy/antares > #Text > renders the sizes example 1`] = `"<div class="box flex column" style="gap:var(--sp-sm)"><span class="text type typeText scaleMd">Default</span><span class="text type typeText scaleMd typeXs">Extra small</span><span class="text type typeText scaleMd typeSm">Small</span><span class="text type typeText scaleMd typeMd">Medium</span><span class="text type typeText scaleMd typeLg">Large</span><span class="text type typeText scaleMd typeXl">Extra large</span><span class="text type typeText scaleMd type2xl">2x large</span></div>"`;

exports[`@godaddy/antares > #Text > renders the text example 1`] = `"<span class="text type typeText scaleMd">Hello, world!</span>"`;

exports[`@godaddy/antares > #Text > renders the wrap example 1`] = `"<div style="width:300px;border:1px solid red"><p class="text type typeText scaleMd" style="--wrap:pretty">Text is wrapped in a way that best balances the number of characters on each line, enhancing layout quality and legibility. Because counting characters and balancing them across multiple lines is computationally expensive, this value is only supported for blocks of text spanning a limited number of lines</p></div>"`;
