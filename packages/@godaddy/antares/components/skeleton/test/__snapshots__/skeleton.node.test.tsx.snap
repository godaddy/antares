exports[`@godaddy/antares > #Skeleton > renders MediaCardExample 1`] = `"<div class="box grid" style="grid-template-columns:repeat(auto-fit, minmax(min(100%, 16rem), 1fr));align-items:start;gap:var(--sp-lg)"><div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><span aria-hidden="true" data-size="md" data-rounding="default" class="skeleton" style="height:auto;aspect-ratio:16 / 9"></span><div class="box flex column" style="gap:var(--sp-sm)"><span aria-hidden="true" data-size="lg" data-rounding="default" data-fixed-width="" class="skeleton" style="width:60%"></span><span aria-hidden="true" data-size="sm" data-rounding="default" class="skeleton"></span><span aria-hidden="true" data-size="sm" data-rounding="default" data-fixed-width="" class="skeleton" style="width:80%"></span></div></div><div data-card="static" class="box flex column card" style="padding:var(--sp-lg);gap:var(--sp-lg)"><div class="box grid" style="grid-template-columns:6rem 1fr;align-items:center;gap:var(--sp-lg)"><span aria-hidden="true" data-size="md" data-rounding="default" class="skeleton" style="height:auto;aspect-ratio:1"></span><div class="box flex column" style="gap:var(--sp-sm)"><span aria-hidden="true" data-size="lg" data-rounding="default" data-fixed-width="" class="skeleton" style="width:70%"></span><span aria-hidden="true" data-size="sm" data-rounding="default" class="skeleton"></span><span aria-hidden="true" data-size="sm" data-rounding="default" data-fixed-width="" class="skeleton" style="width:50%"></span></div></div></div></div>"`;

