exports[`@godaddy/antares > #Skeleton > renders AspectRatioExample 1`] = `"<div class="box grid" style="grid-template-columns:repeat(5, 1fr);align-items:end;gap:var(--sp-md)"><span aria-hidden="true" data-size="md" data-rounding="default" class="skeleton" style="height:auto;aspect-ratio:16 / 9"></span><span aria-hidden="true" data-size="md" data-rounding="default" class="skeleton" style="height:auto;aspect-ratio:4 / 3"></span><span aria-hidden="true" data-size="md" data-rounding="default" class="skeleton" style="height:auto;aspect-ratio:1"></span><span aria-hidden="true" data-size="md" data-rounding="default" class="skeleton" style="height:auto;aspect-ratio:3 / 4"></span><span aria-hidden="true" data-size="md" data-rounding="default" class="skeleton" style="height:auto;aspect-ratio:9 / 16"></span></div>"`;

