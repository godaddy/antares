exports[`@godaddy/antares > #Alert > renders the composed default alert 1`] = `"<div role="alert" data-emphasis="info" class="box alert"><div class="box grid layout"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon emphasisIcon" aria-hidden="true" data-override="className" data-slot="content" data-loading="true" data-icon="information"></svg><div class="box flex column textRegion" style="padding-block:0;padding-inline:0;flex:1 1 auto;gap:var(--alert-gap);min-block-size:auto;overflow:visible"><h3 slot="title" class="typeInherit title heading type typeHeading scaleMd">Your domain is ready</h3><span class="typeInherit text type typeText scaleMd">You can now start building your website.</span></div></div></div>"`;

exports[`@godaddy/antares > #Alert > renders the dismissible example and default close label 1`] = `"<div role="alert" data-emphasis="success" class="box alert"><div class="box grid layout"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon emphasisIcon" aria-hidden="true" data-override="className" data-slot="content" data-loading="true" data-icon="checkmark"></svg><div class="box flex column textRegion" style="padding-block:0;padding-inline:0;flex:1 1 auto;gap:var(--alert-gap);min-block-size:auto;overflow:visible"><h3 slot="title" class="typeInherit title heading type typeHeading scaleMd">Your account&#x27;s been verified</h3><span class="typeInherit text type typeText scaleMd">We&#x27;ve successfully verified your identity.</span></div><button class="close button minimal sm" style="margin-inline-start:var(--alert-gap)" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" aria-label="Close" id="react-aria-_R_3_" slot="close"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon" data-override="className" data-loading="true" data-icon="x" data-slot="content"></svg></button></div></div>"`;

exports[`@godaddy/antares > #Alert > renders the playground defaults 1`] = `"<div role="alert" data-emphasis="info" class="box alert" style="box-sizing:content-box"><div class="box grid layout"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon emphasisIcon" aria-hidden="true" data-override="className" data-slot="content" data-loading="true" data-icon="information"></svg><div class="box flex column textRegion" style="padding-block:0;padding-inline:0;flex:1 1 auto;gap:var(--alert-gap);min-block-size:auto;overflow:visible"><h3 slot="title" class="typeInherit title heading type typeHeading scaleMd">Alert title</h3><span class="typeInherit text type typeText scaleMd">Optional description text providing additional context.</span></div></div></div>"`;

exports[`@godaddy/antares > #Alert > renders title-only content 1`] = `"<div role="alert" data-emphasis="info" class="box alert" style="box-sizing:content-box"><div class="box grid layout"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon emphasisIcon" aria-hidden="true" data-override="className" data-slot="content" data-loading="true" data-icon="information"></svg><div class="box flex column textRegion" style="padding-block:0;padding-inline:0;flex:1 1 auto;gap:var(--alert-gap);min-block-size:auto;overflow:visible"><h3 slot="title" class="typeInherit title heading type typeHeading scaleMd">Alert title</h3></div></div></div>"`;
