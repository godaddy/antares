exports[`@godaddy/antares > #Alert > renders the composition example 1`] = `"<div class="box flex column" style="gap:var(--_box-space-md)"><div aria-label="Message only" role="alert" data-emphasis="info" class="box alert"><div class="box grid layout"><div class="box flex column content" style="padding-block:0;padding-inline:0;flex:1 1 auto;gap:var(--alert-gap);min-block-size:auto;overflow:visible"><span class="typeInherit typeSlotSm text type typeText scaleMd">Your preferences have been saved.</span></div></div></div><div aria-label="Title only" role="alert" data-emphasis="info" class="box alert"><div class="box grid layout"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon indicator" aria-hidden="true" data-override="className" data-slot="content" data-loading="true" data-icon="information"></svg><div class="box flex column content" style="padding-block:0;padding-inline:0;flex:1 1 auto;gap:var(--alert-gap);min-block-size:auto;overflow:visible"><h3 slot="title" class="title heading type typeHeading scaleMd">Your domain is ready</h3></div></div></div><div aria-label="Documentation notice" role="alert" data-emphasis="warning" class="box alert"><div class="box grid layout"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon indicator" aria-hidden="true" data-override="className" data-slot="content" data-loading="true" data-icon="star"></svg><div class="box flex column content" style="padding-block:0;padding-inline:0;flex:1 1 auto;gap:var(--alert-gap);min-block-size:auto;overflow:visible"><span class="typeInherit typeSlotSm text type typeText scaleMd">Your payment method needs attention.</span><span class="typeInherit typeSlotSm text type typeText scaleMd">Visit <strong>Billing</strong> to review your options.</span></div><div role="group" class="box flex actions" style="align-items:center;flex-wrap:wrap;gap:var(--_box-space-sm)"><a class="button secondary sm" data-rac="" href="#billing" tabindex="0" data-react-aria-pressable="true">Learn more</a></div></div></div></div>"`;

