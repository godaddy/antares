exports[`@godaddy/antares > #SizeProvider > renders SizesExample 1`] = `"<div class="box flex column" style="gap:var(--sp-lg)"><div class="box flex column" style="align-items:start;gap:var(--sp-sm)"><h3 class="heading type typeHeading scaleSm">Size <!-- -->sm</h3><span class="text type typeText scaleSm">Body copy follows the scope.</span><span class="text type typeDetail scaleSm">Supporting copy too.</span><button class="button primary sm" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_h_">Save</button></div><div class="box flex column" style="align-items:start;gap:var(--sp-sm)"><h3 class="heading type typeHeading scaleMd">Size <!-- -->md</h3><span class="text type typeText scaleMd">Body copy follows the scope.</span><span class="text type typeDetail scaleMd">Supporting copy too.</span><button class="button primary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_i_">Save</button></div><div class="box flex column" style="align-items:start;gap:var(--sp-sm)"><h3 class="heading type typeHeading scaleLg">Size <!-- -->lg</h3><span class="text type typeText scaleLg">Body copy follows the scope.</span><span class="text type typeDetail scaleLg">Supporting copy too.</span><button class="button primary lg" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_j_">Save</button></div></div>"`;

exports[`@godaddy/antares > #SizeProvider > renders no element of its own 1`] = `"<p>A plain paragraph keeps the page&#x27;s typography.</p><span class="text type typeText scaleLg">Text follows the scope.</span>"`;
