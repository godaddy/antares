exports[`@godaddy/antares > #SizeProvider > renders DefaultExample 1`] = `"<div class="box flex column" style="align-items:start;gap:var(--sp-md)"><div data-align="start" data-legible-lines="" class="box flex column lockup" style="gap:var(--sp-sm)"><h2 slot="title" class="part heading type typeHeading scaleSm">Billing</h2><span class="part typeBody text type typeText scaleSm" slot="body">Manage your payment methods.</span></div><div data-interior="box" class="box flex column field scaleSm" style="gap:var(--_size-gap, var(--sp-sm))" data-rac=""><label class="label type typeLabel scaleSm" id="react-aria-_R_2H1_" for="react-aria-_R_2_">Email</label><input type="text" tabindex="0" id="react-aria-_R_2_" aria-labelledby="react-aria-_R_2H1_" aria-describedby="react-aria-_R_2H3_ react-aria-_R_2H4_" class="input box" data-rac="" value=""/><span class="text type typeText scaleSm" id="react-aria-_R_2H3_" slot="description">We&#x27;ll send receipts here.</span></div><div class="box flex" style="align-items:center;gap:var(--sp-sm)"><button class="button primary sm" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_7_">Update payment method</button><button class="button primary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_b_">Contact support</button></div></div>"`;

