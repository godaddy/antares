exports[`@godaddy/antares > #Responsive > renders the container query example 1`] = `
"<style>
        .responsive-container-example-sidebar {
          flex: 1 1 14rem;
        }

        .responsive-container-example-main {
          flex: 3 1 28rem;
        }

        .responsive-domain-card {
          container: domain-card / inline-size;
        }

        .responsive-domain-card-body {
          flex-direction: column;
        }

        @container domain-card (min-width: 28rem) {
          .responsive-domain-card-body {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
          }
        }
      </style><div class="box flex" style="flex-wrap:wrap;gap:var(--sp-md)"><aside aria-label="Sidebar" class="box responsive-container-example-sidebar"><article aria-label="shop.example" class="box responsive-domain-card" style="padding:var(--sp-md)" data-elevation="card"><div class="box flex responsive-domain-card-body" style="gap:var(--sp-sm)"><div class="box flex column" style="gap:var(--sp-xs)"><h3 class="heading type typeHeading scaleMd">shop.example</h3><span class="text type typeText scaleMd">Renews on March 2, 2027</span></div><div class="box flex" style="flex-wrap:wrap;gap:var(--sp-sm)"><button class="button secondary" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_36_">Manage DNS</button><button class="button tertiary" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_56_">Renew</button></div></div></article></aside><main aria-label="Domains" class="box responsive-container-example-main"><article aria-label="example.com" class="box responsive-domain-card" style="padding:var(--sp-md)" data-elevation="card"><div class="box flex responsive-domain-card-body" style="gap:var(--sp-sm)"><div class="box flex column" style="gap:var(--sp-xs)"><h3 class="heading type typeHeading scaleMd">example.com</h3><span class="text type typeText scaleMd">Renews on January 12, 2027</span></div><div class="box flex" style="flex-wrap:wrap;gap:var(--sp-sm)"><button class="button secondary" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_3a_">Manage DNS</button><button class="button tertiary" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_5a_">Renew</button></div></div></article></main></div>"
`;

exports[`@godaddy/antares > #Responsive > renders the form without choosing a viewport on the server 1`] = `
"<style>
        .responsive-form-example {
          grid-template-columns: minmax(0, 1fr);
        }

        .responsive-form-example-field {
          min-inline-size: 0;
          overflow-wrap: anywhere;
        }

        @media (min-width: 64rem) {
          .responsive-form-example {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .responsive-form-example-wide {
            grid-column: 1 / -1;
          }
        }
      </style><form aria-label="Billing details" class="box grid responsive-form-example" style="gap:var(--sp-md)"><div data-interior="box" class="box flex column field scaleMd responsive-form-example-field" style="gap:var(--_size-gap)" data-rac=""><label class="label type typeLabel scaleMd" id="react-aria-_R_6H1_" for="react-aria-_R_6_">Full name</label><input type="text" autoComplete="name" tabindex="0" id="react-aria-_R_6_" aria-labelledby="react-aria-_R_6H1_" aria-describedby="react-aria-_R_6H3_ react-aria-_R_6H4_" class="input box" data-rac="" name="name" value=""/><span class="text type typeText scaleMd" id="react-aria-_R_6H3_" slot="description">Use the name on your payment card.</span></div><div data-interior="box" class="box flex column field scaleMd responsive-form-example-field" style="gap:var(--_size-gap)" data-rac=""><label class="label type typeLabel scaleMd" id="react-aria-_R_aH1_" for="react-aria-_R_a_">Email</label><input type="email" autoComplete="email" tabindex="0" id="react-aria-_R_a_" aria-labelledby="react-aria-_R_aH1_" aria-describedby="react-aria-_R_aH3_ react-aria-_R_aH4_" class="input box" data-rac="" name="email" value=""/></div><div data-interior="box" class="box flex column field scaleMd responsive-form-example-field responsive-form-example-wide" style="gap:var(--_size-gap)" data-rac=""><label class="label type typeLabel scaleMd" id="react-aria-_R_eH1_" for="react-aria-_R_e_">Street address</label><input type="text" autoComplete="street-address" tabindex="0" id="react-aria-_R_e_" aria-labelledby="react-aria-_R_eH1_" aria-describedby="react-aria-_R_eH3_ react-aria-_R_eH4_" class="input box" data-rac="" name="address" value=""/></div><div data-interior="box" class="box flex column field scaleMd responsive-form-example-field" style="gap:var(--_size-gap)" data-rac=""><label class="label type typeLabel scaleMd" id="react-aria-_R_iH1_" for="react-aria-_R_i_">City</label><input type="text" autoComplete="address-level2" tabindex="0" id="react-aria-_R_i_" aria-labelledby="react-aria-_R_iH1_" aria-describedby="react-aria-_R_iH3_ react-aria-_R_iH4_" class="input box" data-rac="" name="city" value=""/></div><div data-interior="box" class="box flex column field scaleMd responsive-form-example-field" style="gap:var(--_size-gap)" data-rac=""><label class="label type typeLabel scaleMd" id="react-aria-_R_mH1_" for="react-aria-_R_m_">Postal code</label><input type="text" autoComplete="postal-code" tabindex="0" id="react-aria-_R_m_" aria-labelledby="react-aria-_R_mH1_" aria-describedby="react-aria-_R_mH3_ react-aria-_R_mH4_" class="input box" data-rac="" name="postalCode" value=""/></div></form>"
`;

