      </style><header class="box responsive-size-example"><div data-align="start" data-legible-lines="" class="box flex column lockup" style="gap:var(--sp-sm)"><span class="part typeDetail followSize text type typeText scaleMd" slot="eyebrow">Dashboard</span><h1 slot="title" class="part followSize heading type typeHeading scaleMd">Welcome back, Ada</h1><span class="part typeBody followSize text type typeText scaleMd" slot="body">Two domains renew this month. Review them to keep your sites online.</span></div></header>"
`;

