exports[`@godaddy/antares > #Structure > renders the composed structural containers 1`] = `"<div class="box flex column" style="padding:var(--sp-md);gap:var(--sp-md);border:1px solid var(--ux-gray-300, #ccc);border-radius:8px"><header class="box flex" style="padding:var(--sp-md);justify-content:space-between;align-items:center;gap:var(--sp-sm)"><span class="text">Delete file?</span><button class="button secondary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_9_"><span class="text">Close</span></button></header><section class="box flex column" style="padding-block:var(--sp-sm);padding-inline:var(--sp-md);flex:1 1 auto;gap:var(--sp-md);min-block-size:0;overflow:auto"><span class="text">This action cannot be undone.</span></section><footer class="box flex" style="padding-block:var(--sp-sm);padding-inline:var(--sp-md);justify-content:space-between;align-items:center;gap:var(--sp-md)"><div role="group" class="box flex" style="padding-block:var(--sp-sm);padding-inline:var(--sp-md);flex-grow:1;flex-wrap:wrap;gap:var(--sp-sm)"><button class="button secondary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_7_"><span class="text">Cancel</span></button><button class="button critical md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_b_"><span class="text">Delete</span></button></div></footer></div>"`;

exports[`@godaddy/antares > #Structure > renders the group example 1`] = `"<div data-interior="box" class="box flex column field" style="gap:var(--sp-sm)" data-rac=""><label class="label" id="react-aria-_R_0H1_" for="react-aria-_R_0_">Name</label><div role="presentation" class="box flex group" style="align-self:stretch;align-items:stretch;flex-wrap:nowrap" data-rac=""><input type="text" placeholder="Enter your name" tabindex="0" id="react-aria-_R_0_" aria-labelledby="react-aria-_R_0H1_" aria-describedby="react-aria-_R_0H3_ react-aria-_R_0H4_" class="input box" style="flex:1" data-rac="" value=""/></div></div>"`;
