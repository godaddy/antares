exports[`@godaddy/antares > #SizeScope > renders BareContentExample 1`] = `"<div class="typeSurface scaleLg"><p>A plain paragraph takes the scope&#x27;s body typography.</p><span class="text type typeText">Your trial ends<!-- --> <span class="typeSurface scaleSm">in 3 days</span>.</span></div>"`;

exports[`@godaddy/antares > #SizeScope > renders DefaultExample 1`] = `"<div class="typeSurface scaleSm"><div class="box flex column" style="align-items:start;gap:var(--sp-md)"><div data-align="start" data-legible-lines="" class="box flex column lockup typeSurface" style="gap:var(--sp-sm)"><h2 slot="title" class="part heading type typeHeading">Billing</h2><span class="part text type typeText" slot="body">Manage your payment methods.</span></div><div data-interior="box" class="box flex column field typeSurface" style="gap:var(--_size-gap, var(--sp-sm))" data-rac=""><label class="label type typeLabel" id="react-aria-_R_2H1_" for="react-aria-_R_2_">Email</label><input type="text" tabindex="0" id="react-aria-_R_2_" aria-labelledby="react-aria-_R_2H1_" aria-describedby="react-aria-_R_2H3_ react-aria-_R_2H4_" class="input box" data-rac="" value=""/><span class="text type typeText" id="react-aria-_R_2H3_" slot="description">We&#x27;ll send receipts here.</span></div><div class="box flex" style="gap:var(--sp-sm)"><button class="button tertiary" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_7_"><span class="text type typeText">Update payment method</span></button><button class="button tertiary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_b_"><span class="text type typeText">Contact support</span></button></div></div></div>"`;

exports[`@godaddy/antares > #SizeScope > renders OverlaysExample 1`] = `"<div class="typeSurface scaleSm"><div class="box flex" style="align-items:end;flex-wrap:wrap;gap:var(--sp-md)"><template><section class="box grid dialog typeSurface scaleSm" data-rac="" aria-labelledby="react-aria-_R_5l_" role="dialog" tabindex="-1"><section class="box flex column content" style="padding-block:var(--sp-xs);padding-inline:0;flex:1 1 auto;gap:var(--_size-padding, var(--sp-md));min-block-size:0;overflow:auto"></section></section></template><div data-interior="box" class="box flex column field select typeSurface" style="gap:var(--_size-gap, var(--sp-sm))" data-rac=""><span class="label type typeLabel" id="react-aria-_R_9H3_">Plan</span><button id="react-aria-_R_9H2_" class="trigger button trigger" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" aria-labelledby="react-aria-_R_9H7_ react-aria-_R_9H3_" aria-describedby="react-aria-_R_9H5_ react-aria-_R_9H6_" aria-haspopup="listbox" aria-expanded="false" slot="trigger"><span id="react-aria-_R_9H7_" class="value" data-rac="" data-placeholder="true">Pick a plan</span><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon" data-override="className" data-loading="true" data-icon="chevron-down" data-slot="content"></svg></button><div style="border:0;clip:rect(0 0 0 0);clip-path:inset(50%);height:1px;margin:-1px;overflow:hidden;padding:0;position:fixed;width:1px;white-space:nowrap;top:0;left:0" aria-hidden="true" data-react-aria-prevent-focus="true" data-a11y-ignore="aria-hidden-focus" data-testid="hidden-select-container"><label><select tabindex="-1"><option value="" label=" " selected=""> </option><option value="basic">Basic</option><option value="pro">Pro</option></select></label></div></div><template><section class="box grid dialog typeSurface scaleLg" data-rac="" aria-labelledby="react-aria-_R_5m_" role="dialog" tabindex="-1"><section class="box flex column content" style="padding-block:var(--sp-xs);padding-inline:0;flex:1 1 auto;gap:var(--_size-padding, var(--sp-md));min-block-size:0;overflow:auto"></section></section></template><div data-interior="box" class="box flex column field select typeSurface scaleLg" style="gap:var(--_size-gap, var(--sp-sm))" data-rac=""><span class="label type typeLabel" id="react-aria-_R_aH3_">Region</span><button id="react-aria-_R_aH2_" class="trigger button trigger" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" aria-labelledby="react-aria-_R_aH7_ react-aria-_R_aH3_" aria-describedby="react-aria-_R_aH5_ react-aria-_R_aH6_" aria-haspopup="listbox" aria-expanded="false" slot="trigger"><span id="react-aria-_R_aH7_" class="value" data-rac="" data-placeholder="true">Pick a region</span><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon" data-override="className" data-loading="true" data-icon="chevron-down" data-slot="content"></svg></button><div style="border:0;clip:rect(0 0 0 0);clip-path:inset(50%);height:1px;margin:-1px;overflow:hidden;padding:0;position:fixed;width:1px;white-space:nowrap;top:0;left:0" aria-hidden="true" data-react-aria-prevent-focus="true" data-a11y-ignore="aria-hidden-focus" data-testid="hidden-select-container"><label><select tabindex="-1"><option value="" label=" " selected=""> </option><option value="us">United States</option><option value="eu">Europe</option></select></label></div></div><button class="button tertiary" data-rac="" type="button" tabindex="0" aria-expanded="false" id="react-aria-_R_3H1_" data-react-aria-pressable="true"><span class="text type typeText">Edit plan</span></button></div></div>"`;

