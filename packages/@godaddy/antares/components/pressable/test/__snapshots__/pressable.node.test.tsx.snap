// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`@godaddy/antares > #Pressable > renders a custom card 1`] = `"<div role="button" aria-label="View account summary" data-react-aria-pressable="true" tabindex="0" class="box pressable" style="padding:var(--sp-md);border-radius:var(--rounding-md)" data-elevation="card"><div class="box flex column" style="gap:var(--sp-xs)"><span class="text">Account summary</span><span class="text">View your account details</span></div></div>"`;

exports[`@godaddy/antares > #Pressable > renders without wrapper 1`] = `"<div class="box flex" style="gap:var(--sp-sm)"><span role="button" aria-label="Account" data-react-aria-pressable="true" tabindex="0" data-emphasis="primary" data-loading-status="idle" data-shape="circle" data-size="md" class="avatar pressable"><span class="fallback text">UT</span></span><span role="button" aria-label="Workspace" data-react-aria-pressable="true" tabindex="0" data-emphasis="primary" data-loading-status="idle" data-shape="square" data-size="md" class="avatar pressable"><span class="fallback text">UT</span></span></div>"`;
