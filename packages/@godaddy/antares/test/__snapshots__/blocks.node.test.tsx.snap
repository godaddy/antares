exports[`@godaddy/antares > #BlocksCatalog > renders the empty catalog state 1`] = `"<main class="box" style="padding-block:var(--sp-2xl);padding-inline:var(--sp-xl)"><section class="box flex column" style="align-items:center;gap:var(--sp-2xl)"><div data-size="xl" data-align="center" data-legible-lines="" class="box flex column lockup" style="gap:var(--sp-sm)"><span class="eyebrow text" slot="eyebrow">Antares blocks</span><h1 slot="title" class="title heading">Build product experiences with Antares.</h1><span class="body text" slot="body">Discover complete UI patterns, inspect how they are built, and use them as a foundation for your product.</span></div><p class="text">No blocks are available yet.</p></section></main>"`;

exports[`@godaddy/antares > #BlocksCatalog > renders the populated catalog structure 1`] = `"<main class="box" style="padding-block:var(--sp-2xl);padding-inline:var(--sp-xl)"><section class="box flex column" style="align-items:center;gap:var(--sp-2xl)"><div data-size="xl" data-align="center" data-legible-lines="" class="box flex column lockup" style="gap:var(--sp-sm)"><span class="eyebrow text" slot="eyebrow">Antares blocks</span><h1 slot="title" class="title heading">Build product experiences with Antares.</h1><span class="body text" slot="body">Discover complete UI patterns, inspect how they are built, and use them as a foundation for your product.</span></div><section class="box grid" style="padding-inline:var(--sp-md);align-self:stretch;grid-template-columns:repeat(auto-fit, minmax(min(100%, 24rem), 1fr));gap:var(--sp-xl)"><article class="box" style="border-radius:var(--rounding-md)" data-elevation="base">Explorer content</article></section></section></main>"`;

exports[`@godaddy/antares > #SignInForm > renders the accessible sign-in composition 1`] = `"<div class="box flex" style="justify-content:center"><div class="box" style="padding:var(--sp-xl);flex:0 1 28rem;border-radius:var(--rounding-md)" data-elevation="card"><form class="box flex column" style="gap:var(--sp-lg)"><h2 class="heading">Sign in to your account</h2><span class="text">Use your email and password to continue.</span><div class="box flex column" style="gap:var(--sp-md)"><div data-interior="box" class="box flex column field" style="gap:var(--sp-sm)" data-rac="" data-required="true"><label class="label" id="react-aria-_R_bH1_" for="react-aria-_R_b_">Email</label><input type="email" required="" autoComplete="email" placeholder="you@example.com" tabindex="0" id="react-aria-_R_b_" aria-labelledby="react-aria-_R_bH1_" aria-describedby="react-aria-_R_bH3_ react-aria-_R_bH4_" class="input box" data-rac="" name="email" value=""/></div><div data-interior="box" class="box flex column field" style="gap:var(--sp-sm)" data-rac="" data-required="true"><label class="label" id="react-aria-_R_jH1_" for="react-aria-_R_j_">Password</label><input type="password" required="" autoComplete="current-password" tabindex="0" id="react-aria-_R_j_" aria-labelledby="react-aria-_R_jH1_" aria-describedby="react-aria-_R_jH3_ react-aria-_R_jH4_" class="input box" data-rac="" name="password" value=""/></div></div><button class="button primary md" data-rac="" type="submit" tabindex="0" data-react-aria-pressable="true" id="react-aria-_R_4_"><span class="text">Sign in</span></button></form></div></div>"`;
