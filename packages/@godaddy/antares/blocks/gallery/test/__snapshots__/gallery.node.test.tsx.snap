exports[`@godaddy/antares > #Gallery > renders an empty gallery on the server 1`] = `"<div dir="ltr" lang="en-US" role="region" aria-label="Add files to gallery" class="box flex dropZone" style="padding:0;justify-content:start;align-items:stretch"><div class="box flex column content" style="padding:var(--sp-lg);gap:var(--sp-lg)"><div class="box flex" style="justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--sp-md)"><div class="box flex" style="align-items:center;flex-wrap:wrap;gap:var(--sp-sm)"><h2 class="heading type typeHeading scaleMd">Gallery</h2><span class="tag" data-emphasis="passive" data-size="sm" data-design="filled">0 images</span></div><div class="box flex" style="align-items:center;flex-wrap:wrap;gap:var(--sp-sm)"><div role="group" aria-label="Add files to gallery" class="box flex" style="align-items:center;flex-wrap:wrap;gap:var(--sp-sm)"><button class="button secondary md" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" aria-label="Add files" aria-describedby="_R_1hb_" id="react-aria-_R_1dhb_"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon" aria-hidden="true" data-override="className" data-loading="true" data-icon="upload" data-slot="content"></svg>Add files</button><input class="" type="file" style="display:none" accept="image/jpeg,image/png,image/gif,image/webp" multiple="" data-rac=""/><span class="text type typeText scaleMd" id="_R_1hb_">or drag them here.</span></div><div data-size="md" dir="ltr" class="box inlineFlex container" data-rac="" aria-label="Layout" role="radiogroup" aria-orientation="horizontal" data-orientation="horizontal"><div class="box flex content" style="padding:var(--sp-xs);gap:var(--sp-xs)"><button class="box flex item" style="align-items:center;gap:var(--sp-xs)" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" role="radio" aria-checked="false"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon" data-override="className" data-loading="true" data-icon="bulleted-list" data-slot="content"></svg>List</button><button class="box flex item" style="align-items:center;gap:var(--sp-xs)" data-rac="" type="button" tabindex="0" data-react-aria-pressable="true" role="radio" aria-checked="true" data-selected="true"><div class="box flex indicator" data-rac=""></div><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon" data-override="className" data-loading="true" data-icon="grid" data-slot="content"></svg>Grid</button></div></div></div></div><div role="region" aria-label="Grid view" class="box"><div role="region" aria-label="Empty gallery" class="box flex column emptyState" style="padding:var(--sp-2xl);justify-content:center;align-items:center;gap:var(--sp-sm)"><div aria-hidden="true" class="box" style="padding:var(--sp-md);border-radius:var(--rounding-full)" data-elevation="card"><svg data-placeholder="true" role="presentation" viewBox="0 0 24 24" focusable="false" fill="currentColor" class="icon" data-override="className" data-loading="true" data-icon="upload" data-slot="content"></svg></div><h3 class="heading type typeHeading scaleMd">Start your gallery</h3><span class="text type typeText scaleMd description">Drop images here or choose Add files above to upload.</span></div></div><span class="text type typeDetail scaleMd notice" role="status" aria-label="Gallery updates" aria-atomic="true"></span></div></div>"`;

