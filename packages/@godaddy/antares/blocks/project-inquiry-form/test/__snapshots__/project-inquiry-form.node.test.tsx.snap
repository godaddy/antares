exports[`@godaddy/antares > #ProjectInquiryForm > renders the accessible inquiry form 1`] = `"<link rel="preload" as="image" href="https://placehold.co/1280x720/eef2f7/667085?text=Project+image"/><div class="box root" style="padding:var(--sp-xl)"><div class="box grid columns" style="grid-template-columns:repeat(auto-fit, minmax(min(100%, 30rem), 1fr));align-items:start;gap:var(--sp-2xl)"><div class="box flex column visualColumn" style="gap:var(--sp-xl)"><img src="https://placehold.co/1280x720/eef2f7/667085?text=Project+image" alt="Project image placeholder" width="1280" height="720" class="box heroImage" style="align-self:start;border-radius:var(--rounding-xl)"/><ul aria-label="Services we can help with" class="box flex column list" style="gap:var(--sp-lg)"><li class="box flex" style="align-items:start;gap:var(--sp-sm)"><svg data-placeholder="true" role="presentation" viewBox="0 0 18 18" focusable="false" fill="currentColor" class="icon" width="18" height="18" aria-hidden="true" data-override="className" data-loading="true" data-icon="checkmark" data-slot="content"></svg><div class="box flex column" style="gap:var(--sp-xs)"><strong class="text type typeText scaleMd">Website Design Services</strong><span class="text type typeDetail scaleMd typeSm">We’ll build your website so you can get back to focusing on your business.</span></div></li><li class="box flex" style="align-items:start;gap:var(--sp-sm)"><svg data-placeholder="true" role="presentation" viewBox="0 0 18 18" focusable="false" fill="currentColor" class="icon" width="18" height="18" aria-hidden="true" data-override="className" data-loading="true" data-icon="checkmark" data-slot="content"></svg><div class="box flex column" style="gap:var(--sp-xs)"><strong class="text type typeText scaleMd">Marketing Services</strong><span class="text type typeDetail scaleMd typeSm">Our team of experts will create and manage your social media presence.</span></div></li><li class="box flex" style="align-items:start;gap:var(--sp-