{
  "name": "@bento/block-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Antares documentation blocks and source explorer",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "lint": "biome check",
    "test": "vitest --run --coverage.enabled=false",
    "test:node": "vitest --run --project=SSR --coverage.enabled=false",
    "test:browser": "vitest --run --project=Browser --coverage.enabled=false",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "dependencies": {
    "estree-util-value-to-estree": "^3.5.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@godaddy/antares": "*",
    "@mdx-js/mdx": "^3.1.1",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/css-modules": "^1.0.5",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "mdast": "^3.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "^10.5.7",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vfile": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  },
  "peerDependencies": {
    "@godaddy/antares": "*",
    "react": "18.x || 19.x",
    "react-dom": "18.x || 19.x"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime.d.mts",
        "default": "./dist/runtime.mjs"
      },
      "require": {
        "types": "./dist/runtime.d.cts",
        "default": "./dist/runtime.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node-entry.d.mts",
        "default": "./dist/node-entry.mjs"
      },
      "require": {
        "types": "./dist/node-entry.d.cts",
        "default": "./dist/node-entry.cjs"
      }
    },
    "./storybook": {
      "import": {
        "types": "./dist/storybook.d.mts",
        "default": "./dist/storybook.mjs"
      },
      "require": {
        "types": "./dist/storybook.d.cts",
        "default": "./dist/storybook.cjs"
      }
    },
    "./storybook-runtime": {
      "import": {
        "types": "./dist/storybook-runtime.d.mts",
        "default": "./dist/storybook-runtime.mjs"
      },
      "require": {
        "types": "./dist/storybook-runtime.d.cts",
        "default": "./dist/storybook-runtime.cjs"
      }
    },
    "./package.json": "./package.json"
  }
}
