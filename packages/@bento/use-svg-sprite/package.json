{
  "name": "@bento/use-svg-sprite",
  "version": "0.1.3",
  "description": "A React hook for managing SVG sprites",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "bundle-size:build": "node ../../../scripts/bundle-analysis.ts --package-from-cwd",
    "bundle-size:check": "node ../../../scripts/bundle-analysis.ts --package-from-cwd --check",
    "dev": "tsdown src/index.tsx --watch",
    "lint": "biome lint",
    "prepublishOnly": "node ../../../scripts/compile-readme.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godaddy/antares.git"
  },
  "keywords": [
    "bento",
    "component",
    "library",
    "react",
    "sprite",
    "svg",
    "vector"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/godaddy/antares/issues"
  },
  "homepage": "https://github.com/godaddy/antares#readme",
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "dependencies": {
    "@bento/box": "^0.2.0"
  },
  "devDependencies": {
    "@bento/environment": "^0.1.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": "18.x || 19.x",
    "react-dom": "18.x || 19.x"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
