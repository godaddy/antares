{
  "name": "@bento/button",
  "version": "0.1.4",
  "description": "Button component built on top of the Pressable primitive",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "bundle-size:build": "node ../../../scripts/bundle-analysis.ts --package-from-cwd",
    "bundle-size:check": "node ../../../scripts/bundle-analysis.ts --package-from-cwd --check",
    "lint": "biome lint",
    "prepublishOnly": "node ../../../scripts/compile-readme.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godaddy/antares.git"
  },
  "keywords": [
    "accessibility",
    "aria",
    "bento",
    "button",
    "component",
    "interactive",
    "library",
    "pressable",
    "react"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/godaddy/antares/issues"
  },
  "homepage": "https://github.com/godaddy/antares#readme",
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "dependencies": {
    "@bento/pressable": "workspace:^0.1.4",
    "@bento/slots": "workspace:^",
    "@bento/use-props": "workspace:^0.2.1",
    "react-aria": "catalog:"
  },
  "devDependencies": {
    "@types/react-dom": "catalog:",
    "tsdown": "catalog:",
    "vitest-browser-react": "catalog:",
    "@types/react": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "18.x || 19.x",
    "react-dom": "18.x || 19.x"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
