#!/bin/sh
set -e

pnpm exec lint-staged

echo "🔍 Validating Antares registry schema..."
pnpm run registry:validate

echo "🔍 Checking package.json formatting..."
pnpm run format:package

# Run dependency checks to prevent circular deps and version mismatches
echo "🔍 Checking dependencies..."
pnpm nx run @godaddy/generate-cdn-url:build
pnpm run deps:check

echo "🔍 Typechecking..."
pnpm run typecheck

echo "🔍 Linting..."
pnpm run lint

echo "🧪 Running tests (no cache)..."
pnpm run scripts:test
pnpm nx run-many -t test --output-style=static --skipNxCache


echo "✅ All pre-commit checks passed!"
