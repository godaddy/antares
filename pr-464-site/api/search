-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/r"},"584":{"id":"/docs/components/drawer-14","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './drawer.stories.tsx';\n\n<Met"},"585":{"id":"/docs/components/drawer-15","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#keyboard","content":"| Key      | Action                                           |\n| -------- | ------------------------------------------------ |\n| `Escape` | Close the top drawer (unless `preventDismissal`) |","table":"table-0"},"586":{"id":"/docs/components/drawer-16","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#keyboard","content":"| Key   | Action                                          |\n| ----- | ----------------------------------------------- |\n| `Tab` | Move focus within the drawer (focus is trapped) |","table":"table-0"},"587":{"id":"/docs/components/drawer-17","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#aria","content":"`role=\"dialog\"` with `aria-modal=\"true\"` on the drawer panel (via RAC Sheet)"},"588":{"id":"/docs/components/drawer-18","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#aria","content":"A `Heading slot=\"title\"` labels the dialog via `aria-labelledby`; otherwise pass `aria-label`"},"589":{"id":"/docs/components/drawer-19","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#best-practices","content":"Provide a `Heading slot=\"title\"` or an `aria-label` so the dialog has an accessible name."},"590":{"id":"/docs/components/drawer-20","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#best-practices","content":"A drawer closes by swipe, Escape, or backdrop press. Use `preventDismissal` only when closing\nneeds an explicit action, and compose a `CloseButton` so there is one."},"591":{"id":"/docs/components/drawer-21","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#best-practices","content":"Nest drawers to go deeper into a flow, not to show unrelated content side by side."},"592":{"id":"/docs/components/drop-zone","page_id":"/docs/components/drop-zone","type":"page","content":"DropZone","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/drop-zone"},"593":{"id":"/docs/components/drop-zone-0","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone","content":"A standalone region that accepts drag-and-drop file interactions, rendering a clearly defined target area where users can drop files."},"594":{"id":"/docs/components/drop-zone-1","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#installation","content":"Installation"},"595":{"id":"/docs/components/drop-zone-2","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#examples","content":"Examples"},"596":{"id":"/docs/components/drop-zone-3","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#blocks","content":"Blocks"},"597":{"id":"/docs/components/drop-zone-4","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#accessibility","content":"Accessibility"},"598":{"id":"/docs/components/drop-zone-5","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#keyboard","content":"Keyboard"},"599":{"id":"/docs/components/drop-zone-6","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#screen-readers","content":"Screen readers"},"600":{"id":"/docs/components/drop-zone-7","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#best-practices","content":"Best Practices"},"601":{"id":"/docs/components/drop-zone-8","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#props","content":"Props"},"602":{"id":"/docs/components/drop-zone-9","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#dropzone","content":"DropZone"},"603":{"id":"/docs/components/drop-zone-10","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n<Meta"},"604":{"id":"/docs/components/drop-zone-11","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n<Meta of={Stories}"},"605":{"id":"/docs/components/drop-zone-12","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n\n\n## Installation\n\n```bash\nnpm install --save @godaddy"},"606":{"id":"/docs/components/drop-zone-13","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"| Key   | Description                  |\n| ----- | ---------------------------- |\n| `Tab` | Moves focus to the drop zone |","table":"table-0"},"607":{"id":"/docs/components/drop-zone-14","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"| Key               | Description                                                      |\n| ----------------- | ---------------------------------------------------------------- |\n| `Enter` / `Space` | Opens the file picker so files can be selected without a pointer |","table":"table-0"},"608":{"id":"/docs/components/drop-zone-15","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"The drop zone renders a visually hidden `<button>` inside the container. Assistive technology discovers and announces this button as an interactive element — activating it opens the native file picker without a pointer."},"609":{"id":"/docs/components/drop-zone-16","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"The button's accessible name is built from two sources, combined in order:"},"610":{"id":"/docs/components/drop-zone-17","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"**`<Text slot=\"label\">`** — any `Text` child with `slot=\"label\"` has its `id` linked to the button via `aria-labelledby`. This is the recommended way to provide a contextual label that is also visible to sighted users."},"611":{"id":"/docs/components/drop-zone-18","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"**`aria-label`** — pass `aria-label` on the `DropZone` component to override or supplement the label (e.g. `aria-label=\"Upload profile photo\"`). When no `Text slot=\"label\"` is present and no `aria-label` is set, the button falls back to the default \"DropZone\" label provided by React Aria."},"612":{"id":"/docs/components/drop-zone-19","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Use the drop zone alongside a button-based file picker — drag-and-drop is a convenience, never the only way to upload."},"613":{"id":"/docs/components/drop-zone-20","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Replace the default text with `children` to communicate the accepted file types and size limits up front."},"614":{"id":"/docs/components/drop-zone-21","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Let the drop zone fill its container; constrain it with the surrounding layout rather than setting a fixed width on the component itself."},"615":{"id":"/docs/components/drop-zone-22","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Reflect upload state (validating, uploading, error) outside the drop zone so the target area stays clear and predictable."},"616":{"id":"/docs/components/field-error","page_id":"/docs/components/field-error","type":"page","content":"FieldError","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/field-error"},"617":{"id":"/docs/components/field-error-0","page_id":"/docs/components/field-error","tags":[],"type":"text","url":"/docs/components/field-error","content":"Validation message for a field. Renders only when the field is invalid."},"618":{"id":"/docs/components/field-error-1","page_id":"/docs/components/field-error","type":"heading","tags":[],"url":"/docs/components/field-error#features","content":"Features"},"619":{"id":"/docs/components/field-error-2","page_id":"/docs/components/field-error","type":"heading","tags"