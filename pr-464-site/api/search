 a portal."},"1370":{"id":"/docs/components/size-provider-8","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Renders no element, so it never affects layout. Only Antares components follow it; plain HTML\nkeeps its own typography, so put copy in `Text`."},"1371":{"id":"/docs/components/size-provider-9","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Without any scope, components use `md`."},"1372":{"id":"/docs/components/size-provider-10","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Adopted so far by Text, Detail, Heading, Label, Button, LinkButton, TextField, NumberField, Select,\nDatePicker, DateRangePicker, Calendar, TextLockup, Modal, Drawer, Popover, and Tooltip. Other\ncomponents keep their own size. Layout spacing props keep their meaning: `gap=\"md\"` is the layout\n`md` gap in any scope."},"1373":{"id":"/docs/components/size-provider-11","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storyboo"},"1374":{"id":"/docs/components/size-provider-12","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories fr"},"1375":{"id":"/docs/components/skeleton","page_id":"/docs/components/skeleton","type":"page","content":"Skeleton","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/skeleton"},"1376":{"id":"/docs/components/skeleton-0","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton","cont