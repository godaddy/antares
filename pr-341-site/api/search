ts"],"tags":[],"url":"/docs/components/carousel"},"87":{"id":"/docs/components/carousel-0","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel","content":"The Carousel component allows users to cycle through a series of content panels (typically images, cards, or text) in a horizontal or vertical layout. It is commonly used for featured content, product showcases, or testimonials."},"88":{"id":"/docs/components/carousel-1","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#installation","content":"Installation"},"89":{"id":"/docs/components/carousel-2","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#examples","content":"Examples"},"90":{"id":"/docs/components/carousel-3","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#default","content":"Default"},"91":{"id":"/docs/components/carousel-4","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#controlled","content":"Controlled"},"92":{"id":"/docs/components/carousel-5","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#external-controls-uncontrolled","content":"External Controls (Uncontrolled)"},"93":{"id":"/docs/components/carousel-6","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#external-controls-controlled","content":"External Controls (Controlled)"},"94":{"id":"/docs/components/carousel-7","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#hide-controls","content":"Hide Controls"},"95":{"id":"/docs/components/carousel-8","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#variable-widths","content":"Variable Widths"},"96":{"id":"/docs/components/carousel-9","page_id":"/docs/components/carousel","t