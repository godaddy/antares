ccordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"Toggle the focused section; focus stays on the trigger"},"62":{"id":"/docs/components/accordion-38","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#aria","content":"Each section's trigger is a native button with `aria-expanded` and `aria-controls` linked to its panel."},"63":{"id":"/docs/components/accordion-39","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#aria","content":"Each panel is labeled by its trigger through `aria-labelledby` automatically."},"64":{"id":"/docs/components/accordion-40","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Group related sections and keep essential information visible outside the accordion."},"65":{"id":"/docs/components/accordion-41","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Use descriptive section titles and heading levels that fit the page hierarchy."},"66":{"id":"/docs/components/accordion-42","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Use multiple expansion when users need to compare information across sections."},"67":{"id":"/docs/components/accordion-43","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Keep item IDs stable when reordering or filtering data."},"68":{"id":"/docs/components/accordion-44","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Manage expansion on Accordion when sections belong to a group."},"69":{"id":"/docs/components/accordion-45","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-pr