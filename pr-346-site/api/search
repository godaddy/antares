t value (clamped to 0–100)"},"387":{"id":"/docs/components/circular-progress-17","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuemin` and `aria-valuemax` define the range (default `0`–`100`)"},"388":{"id":"/docs/components/circular-progress-18","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuetext` and visible value text are omitted while indeterminate; otherwise `aria-valuetext` provides a formatted string (e.g. `\"60%\"`) via `Intl.NumberFormat`; the same string is rendered inside the circle. Override the text with the `aria-valuetext` prop, or control formatting with `formatOptions`"},"389":{"id":"/docs/components/circular-progress-19","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-labelledby` associates the visible label when the `label` prop is provided"},"390":{"id":"/docs/components/circular-progress-20","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-describedby` wires the `helperText` to the progressbar for screen readers"},"391":{"id":"/docs/components/circular-progress-21","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"The decorative SVG and output text are hidden via `aria-hidden=\"true\"`"},"392":{"id":"/docs/components/date-picker","page_id":"/docs/components/date-picker","type":"page","content":"DatePicker","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/date-picker"},"393":{"id":"/docs/components/date-picker-0","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker","content":"Date fields that display the selected value as a label and open a calendar popover to pick a single date (DatePicker) or a range (DateRangePicker)."},"394":{"id":"/docs/components/date-picker-1","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#features","content":"Features"},"395":{"id":"/docs/components/date-picker-2","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#installation","content":"Installation"},"396":{"id":"/docs/components/date-picker-3","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#working-with-dates","content":"Working with dates"},"397":{"id":"/docs/components/date-picker-4","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#examples","content":"Examples"},"398":{"id":"/docs/components/date-picker-5","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#default","content":"Default"},"399":{"id":"/docs/components/date-picker-6","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#range","content":"Range"},"400":{"id":"/docs/components/date-picker-7","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#controlled","content":"Controlled"},"401":{"id":"/docs/components/date-picker-8","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#format-options","content":"Format Options"},"402":{"id":"/docs/components/date-picker-9","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#min--max","content":"Min / Max"},"403":{"id":"/docs/components/date-picker-10","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#with-error","content":"With error"},"404":{"id":"/docs/components/date-picker-11","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#disabled","content":"Disabled"},"405":{"id":"/docs/components/date-picker-12","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#composed","content":"Composed"},"406":{"id":"/docs/components/date-picker-13","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#composed-range","content":"Composed range"},"407":{"id":"/docs/components/date-picker-14","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#sizes","content":"Sizes"},"408":{"id":"/docs/components/date-picker-15","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#props","content":"Props"},"409":{"id":"/docs/components/date-picker-16","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepicker","content":"DatePicker"},"410":{"id":"/docs/components/date-picker-17","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepicker","content":"DateRangePicker"},"411":{"id":"/docs/components/date-picker-18","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepickercalendar","content":"DatePickerCalendar"},"412":{"id":"/docs/components/date-picker-19","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepickercalendar","content":"DateRangePickerCalendar"},"413":{"id":"/docs/components/date-picker-20","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepickervalue","content":"DatePickerValue"},"414":{"id":"/docs/components/date-picker-21","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepickervalue","content":"DateRangePickerValue"},"415":{"id":"/docs/components/date-picker-22","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"**Composable interior**: Compose `Label`, a `Button slot=\"trigger\"`, `DatePickerCalendar`, and optional `Text` / `FieldError`. Nothing is added for you, and what you write keeps the order you wrote it in. `children` also accepts a function for picker state"},"416":{"id":"/docs/components/date-picker-23","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"**Trigger and calendar**: An empty `Button slot=\"trigger\"` renders a calendar icon and the formatted value from the field. `DatePickerCalendar` (and `DateRangePickerCalendar`) is the calendar in the popover it opens: it takes `Calendar` props plus `popoverProps` for the overlay. Write `Popover`, `Content`, and `Calendar` yourself to replace the whole overlay"},"417":{"id":"/docs/components/date-picker-24","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"**Sizes**: Each picker is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets its label, trigger, description, error, and the calendar it opens; without it, the picker follows the surrounding scope"},"418":{"id":"/docs/components/date-picker-25","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"`DatePicker` (single) and `DateRangePicker` (range): a read-only formatted date label; the whole field opens a calendar popover"},"419":{"id":"/docs/components/date-picker-26","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"Built on React Aria - native form integration, validation, focus management, and screen-reader support"},"420":{"id":"/docs/components/date-picker-27","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"Label formatting via `formatOptions` / `placeholder` on the picker itself, or on `DatePickerValue` / `DateRangePickerValue` in a trigger you write"},"421":{"id":"/docs/components/date-picker-28","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"`minValue` / `maxValue` bounds and `isDateUnavailable` per-day disabling"},"422":{"id":"/docs/components/date-picker-29","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#working-with-dates","content":"Values are `CalendarDate` objects. Import the date primitives you need from the `@godaddy/antares/date` subpath:"},"423":{"id":"/docs/components/date-picker-30","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#working-with-dates","content":"Import date helpers from `@godaddy/antares/date` (a re-export of\n`@internationalized/date`).\nWrap the app in `<I18nProvider>` so formatting and the calendar follow the user's locale."},"424":{"id":"/docs/components/date-picker-31","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#default","content":"A single date picker with a `Label`."},"425":{"id":"/docs/components/date-picker-32","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#range","content":"A start/end range picker."},"426":{"id":"/docs/components/date-picker-33","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#controlled","content":"Driving the value with `useState`."},"427":{"id":"/docs/components/date-picker-34","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#format-options","content":"Controlling the trigger's