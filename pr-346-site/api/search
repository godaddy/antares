ntent":"Styling Overrides Not Applying"},"1010":{"id":"/docs/components/radio-21","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#keyboard-navigation-not-working","content":"Keyboard Navigation Not Working"},"1011":{"id":"/docs/components/radio-22","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#best-practices","content":"Best Practices"},"1012":{"id":"/docs/components/radio-23","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#when-to-use-radio-buttons","content":"When to Use Radio Buttons"},"1013":{"id":"/docs/components/radio-24","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#label-guidelines","content":"Label Guidelines"},"1014":{"id":"/docs/components/radio-25","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#validation","content":"Validation"},"1015":{"id":"/docs/components/radio-26","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#props","content":"Props"},"1016":{"id":"/docs/components/radio-27","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#radio","content":"Radio"},"1017":{"id":"/docs/components/radio-28","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#radiogroup","content":"RadioGroup"},"1018":{"id":"/docs/components/radio-29","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#default","content":"A radio group with a default selection."},"1019":{"id":"/docs/components/radio-30","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#controlled","content":"A controlled radio group using `value` and `onChange`."},"1020":{"id":"/docs/components/radio-31","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#horizontal-layout","content":"A radio group arranged horizontally."},"1021":{"id":"/docs/components/radio-32","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#disabled-states","content":"Disabled group and individually disabled radio options."},"1022":{"id":"/docs/components/radio-33","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#required-indicator","content":"A required radio group with a payment method selection."},"1023":{"id":"/docs/components/radio-34","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#description-text","content":"A radio group with helper description text."},"1024":{"id":"/docs/components/radio-35","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#error-state","content":"An invalid required group displaying an error message."},"1025":{"id":"/docs/components/radio-36","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-label","content":"A radio group using `aria-label` instead of a visible label."},"1026":{"id":"/docs/components/radio-37","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#form-submission","content":"A radio group integrated with native form submission."},"1027":{"id":"/docs/components/radio-38","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#customization","content":"`RadioGroup` is composed: write `Label`, a `Group` holding the `Radio` items, `Text slot=\"description\"`, and `FieldError`. The `Group` takes its axis, gap, and presentational role from the group's `orientation`, so a bare `<Group>` is all you need; pass your own `direction`/`gap` to lay the items out differently. Each `Radio` takes label text next to the indicator. `orientation` also sets keyboard-navigation direction and ARIA."},"1028":{"id":"/docs/components/radio-39","page_id":"/docs/com