_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#truncation","content":"Truncation"},"284":{"id":"/docs/components/chip-12","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#empty-state","content":"Empty State"},"285":{"id":"/docs/components/chip-13","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#menu-filter-trigger","content":"Menu filter trigger"},"286":{"id":"/docs/components/chip-14","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#customization","content":"Customization"},"287":{"id":"/docs/components/chip-15","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#content","content":"Content"},"288":{"id":"/docs/components/chip-16","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#selection-and-removal","content":"Selection and removal"},"289":{"id":"/docs/components/chip-17","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#layout-and-sizing","content":"Layout and sizing"},"290":{"id":"/docs/components/chip-18","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#button-composition","content":"Button composition"},"291":{"id":"/docs/components/chip-19","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#accessibility","content":"Accessibility"},"292":{"id":"/docs/components/chip-20","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#best-practices","content":"Best Practices"},"293":{"id":"/docs/components/chip-21","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#troubleshooting","content":"Troubleshooting"},"294":{"id":"/docs/components/chip-22","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"A ChipGroup has no accessible name"},"295":{"id":"/docs/components/chip-23","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"The remove action does not update the UI"},"296":{"id":"/docs/components/chip-24","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"A composed label is not truncating correctly"},"297":{"id":"/docs/components/chip-25","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"The menu trigger does not look like a Chip"},"298":{"id":"/docs/components/chip-26","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#props","content":"Props"},"299":{"id":"/docs/components/chip-27","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chip","content":"Chip"},"300":{"id":"/docs/components/chip-28","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipgroup","content":"ChipGroup"},"301":{"id":"/docs/components/chip-29","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chiplist","content":"ChipList"},"302":{"id":"/docs/components/chip-30","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipbutton","content":"ChipButton"},"303":{"id":"/docs/components/chip-31","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipGroup` + `ChipList` + `Chip` for grouped values, selection, keyboard navigation, and removal"},"304":{"id":"/docs/components/chip-32","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Toggle Chips for selecting multiple peer filters"},"305":{"id":"/docs/components/chip-33","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Removable Chips for user-added filters and input tokens"},"306":{"id":"/docs/components/chip-34","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Shared `sm`, `md`, and `lg` sizes, with optional leading icons"},"307":{"id":"/docs/components/chip-35","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipButton` for menu filters and other actions with a Chip-like appearance"},"308":{"id":"/docs/components/chip-36","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#default","content":"Start with a labeled group of related values. Add selection or removal when\nthe group needs interactive behavior."},"309":{"id":"/docs/components/chip-37","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#toggle-chips","content":"Use Toggle Chips for multiple peer filters. The Chip render prop supplies\nselection state for the checkmark, while `textValue` names composed content."},"310":{"id":"/docs/components/chip-38","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#removable-chips","content":"Use Removable Chips for user-added filters and tokens. `ChipGroup` reports\nremoved keys through `onRemove`; the owner updates its collection. A\nself-closing `Button` in the `remove` slot supplies each remove control."},"311":{"id":"/docs/components/chip-39","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#controlled-selection","content":"Use `selectedKeys` and `onSelectionChange` when another part of the page\nneeds to own the selected filter state."},"312":{"id":"/docs/components/chip-40","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#sizes","content":"Compare the supported `sm`, `md`, and `lg` sizes. Set `size` on `ChipGroup`\nso every Chip inherits one consistent size."},"313":{"id":"/docs/components/chip-41","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#disabled","content":"Disable individual options with `disabledKeys` when some values are unavailable."},"314":{"id":"/docs/components/chip-42","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#truncation","content":"By default, long labels truncate visually when space is constrained, while\nthe complete accessible value remains available."},"315":{"id":"/docs/components/chip-43","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#empty-state","content":"Give an empty collection useful guidance, then let the user add the first\nvalue. Removable items continue to be owned by the collection."},"316":{"id":"/docs/components/chip-44","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#menu-filter-trigger","content":"Use `ChipButton` for Chip presentation without collection semantics.\n`MenuTrigger` continues to own open state, focus, and keyboard behavior."},"317":{"id":"/docs/components/chip-45","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#content","content":"Use a string for a simple label. For icons or other composed content, wrap the\nvisible label in `Text` and provide `textValue` for the accessible name. See\n**Toggle Chips** and **Removable Chips** above."},"318":{"id":"/docs/components/chip-46","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#selection-and-removal","content":"`ChipGroup` owns selection and removal behavior. Use a Chip render prop for\nstate-dependent content, and `Button` with `slot=\"remove\"` together with\n`onRemove` for removable items. See **Toggle Chips** and **Removable Chips**."},"319":{"id":"/docs/components/chip-47","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#layout-and-sizing","content":"Set `size` on `ChipGroup` to keep a collection consistent. `ChipList` wraps by\ndefault and accepts layout props for custom arrangements. See **Sizes**."},"320":{"id":"/docs/components/chip-48","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#button-composition","content":"Use `ChipButton` when Chip presentation is needed without collection semantics.\nCompose it with components such as `MenuTrigger`; those components continue to\nown open state, focus, and keyboard behavior. See **Menu filter trigger**."},"321":{"id":"/docs/components/chip-49","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use `Label` or `aria-label` to name the `ChipGroup`; this names the collection,\nnot its individual Chips."},"322":{"id":"/docs/components/chip-50","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Give each Chip a visible label, `textValue`, or `aria-label`. Use `textValue`\nwhen a Chip contains icons, composed content, or a render prop."},"323":{"id":"/docs/components/chip-51","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use a descriptive group label so removal actions can be announced clearly."},"324":{"id":"/docs/components/chip-52","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Keep the visible label and the accessible value synchronized."},"325":{"id":"/docs/components/chip-53","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"`ChipButton` is a real button and exposes menu state through `MenuTrigger`; provide an accessible name when the visible content is incomplete."},"326":{"id":"/docs/components/chip-54","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep labels concise and let them truncate only when the available width requires it."},"327":{"id":"/docs/components/chip-55","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Prefer groups of three or more related values."},"328":{"id":"/docs/components/chip-56","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep one size per group."},"329":{"id":"/docs/components/chip-57","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Let `ChipList` wrap instead of forcing a single horizontal line."},"330":{"id":"/docs/components/chip-58","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Use removable Chips for user-added filters and tokens."},"331":{"id":"/docs/components/chip-59","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"For menu filters, use `ChipButton` with `MenuTrigger` and provide the chevron explicitly."},"332":{"id":"/docs/components/chip-60","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"Add a visible `Label` to the group or provide `aria-label`. For an individual Chip\nwith composed content, provide a visible label, `textValue`, or `aria-label`."},"333":{"id":"/docs/components/chip-61","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"Add `onRemove` to `ChipGroup` and remove the returned keys from the collection\nowned by your application."},"334":{"id":"/docs/components/chip-62","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"Keep the label in `Text`, preserve `textValue`, and constrain the available width\nof the surrounding layout. Truncation is visual; the complete accessible value\nshould remain available."},"335":{"id":"/docs/components/chip-63","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"Use `ChipButton` inside `MenuTrigger`, include the visible value, and add a\ntrailing chevron to communicate that the control opens a menu."},"336":{"id":"/docs/components/chip-64","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#props","content":"For a menu trigger, the button and menu are composed as siblings inside\n`MenuTrigger`:"},"337":{"id":"/docs/components/circular-progress","page_id":"/docs/components/circular-progress","type":"page","content":"CircularProgress","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/circular-progress"},"338":{"id":"/docs/components/circular-progress-0","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress","content":"A circular progress indicator shows determinate progress of an operation over time"},"339":{"id":"/docs/components/circular-progress-1","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#installation","content":"Installation"},"340":{"id":"/docs/components/circular-progress-2","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#examples","content":"Examples"},"341":{"id":"/docs/components/circular-progress-3","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#default","content":"Default"},"342":{"id":"/docs/components/circular-progress-4","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#sizes","content":"Sizes"},"343":{"id":"/docs/components/circular-progress-5","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#emphasis","content":"Emphasis"},"344":{"id":"/docs/components/circular-progress-6","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#accessibility","content":"Accessibility"},"345":{"id":"/docs/components/circular-progress-7","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#aria-support","content":"ARIA Support"},"346":{"id":"/docs/components/circular-progress-8","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#props","content":"Props"},"347":{"id":"/docs/components/circular-progress-9","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#circularprogress","content":"CircularProgress"},"348":{"id":"/docs/components/circular-progress-10","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#default","content":"A basic determinate progress indicator with a label and helper text."},"349":{"id":"/docs/components/circular-progress-11","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#sizes","content":"Four circle diameters are available: `sm` (64px), `md` (96px), `lg` (128px), and `xl` (160px)."},"350":{"id":"/docs/components/circular-progress-12","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#emphasis","content":"Use the `emphasis` prop to communicate status: `success`, `warning`, or `critical`. When omitted, the default teal fill is used."