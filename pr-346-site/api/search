,"content":"Props"},"379":{"id":"/docs/components/circular-progress-9","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#circularprogress","content":"CircularProgress"},"380":{"id":"/docs/components/circular-progress-10","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#default","content":"A basic determinate progress indicator with a label and helper text."},"381":{"id":"/docs/components/circular-progress-11","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#sizes","content":"Four circle diameters are available: `sm` (64px), `md` (96px), `lg` (128px), and `xl` (160px)."},"382":{"id":"/docs/components/circular-progress-12","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#emphasis","content":"Use the `emphasis` prop to communicate status: `success`, `warning`, or `critical`. When omitted, the default teal fill is used."},"383":{"id":"/docs/components/circular-progress-13","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`role=\"progressbar\"` on the container"},"384":{"id":"/docs/components/circular-progress-14","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuenow` reflects the current value (clamped to 0–100)"},"385":{"id":"/docs/components/circular-progress-15","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuemin` and `aria-valuemax` define the range (default `0`–`100`)"},"386":{"id":"/docs/components/circular-progress-16","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuetext` provides a formatted string (e.g. `\"60%\"`) via `Intl.NumberFormat`; the same string is rendered inside the circle. Override the text with the `aria-valuetext` prop, or control formatting with `formatOptions`"},"387":{"id":"/docs/components/circular-progress-17","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-labelledby` associates the visible label when the `label` prop is provided"},"388":{"id":"/docs/components/circular-progress-18","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-describedby` wires the `helperText` to the progressbar for screen readers"},"389":{"id":"/docs/components/circular-progress-19","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"The decorative SVG and output text are hidden via `aria-hidden=\"true\"`"},"390":{"id":"/docs/components/date-picker","page_id":"/docs/components/date-picker","type":"page","content":"DatePicker","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/date-picker"},"391":{"id":"/docs/components/date-picker-0","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker","content":"Date fields that display the selected value as a label and open a calendar popover to pick a single date (DatePicker) or a range (DateRangePicker)."},"392":{"id":"/docs/components/date-picker-1","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#features","content":"Features"},"393":{"id":"/docs/components/date-picker-2","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#installation","content":"Installation"},"394":{"id":"/docs/components/date-picker-3","pag