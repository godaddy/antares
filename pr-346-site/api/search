abel."},"257":{"id":"/docs/components/checkbox-36","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate","content":"Checkboxes can display an indeterminate state (neither checked nor unchecked), with the use of the `isIndeterminate` prop, commonly used for \"select all\" functionality when some but not all child items are selected."},"258":{"id":"/docs/components/checkbox-37","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#checkbox-group","content":"Group multiple checkboxes together with a shared label."},"259":{"id":"/docs/components/checkbox-38","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#controlled","content":"Manage checkbox group state programmatically with controlled component pattern."},"260":{"id":"/docs/components/checkbox-39","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#horizontal-layout","content":"Display checkboxes in a horizontal row instead of vertical stack."},"261":{"id":"/docs/components/checkbox-40","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#disabled-states","content":"Individual checkboxes within a group can be disabled while others remain interactive."},"262":{"id":"/docs/components/checkbox-41","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#required-indicator","content":"Mark a checkbox group as required with visual indicator and validation."},"263":{"id":"/docs/components/checkbox-42","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#invalid-state","content":"Display error state and error message for validation feedback."},"264":{"id":"/docs/components/checkbox-43","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#customization","content":"`CheckboxGroup` is composed: write `Label`, a `Group` holding the `Checkbox` items, `Text slot=\"description\"`, and `FieldError`. The `Group` takes its axis, gap, and presentational role from the group's `orientation`, so a bare `<Group>` is all you need; pass your own `direction`/`gap` to lay the items out differently. Each `Checkbox` takes label text next to the indicator."},"265":{"id":"/docs/components/checkbox-44","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"Components automatically add data attributes for styling different states:"},"266":{"id":"/docs/components/checkbox-45","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"**CheckboxGroup Container:** `data-invalid`, `data-disabled`, `data-required`, `data-readonly`, `data-orientation`"},"267":{"id":"/docs/components/checkbox-46","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"**Checkbox:** `data-selected`, `data-indeterminate`, `data-hovered`, `data-pressed`, `data-focused`, `data-disabled`"},"268":{"id":"/docs/components/checkbox-47","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#component-customization","content":"Pass `className` or `style` to customize a checkbox field container. Use descendant data-attribute selectors to style the interactive checkbox state:"},"269":{"id":"/docs/components/checkbox-48","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate-state","content":"The `isIndeterminate` prop displays a minus icon to represent a partial selection state. This is useful for \"select all\" checkboxes when only some items in a collection are selected."},"270":{"id":"/docs/components/checkbox-49","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"CheckboxGroup supports validation states and error messages:"},"271":{"id":"/docs/components/checkbox-50","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**isRequired**: Marks the group as required with visual indicator"},"272":{"id":"/docs/components/checkbox-51","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**isInvalid**: Shows error state styling"},"273":{"id":"/docs/components/checkbox-52","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**`FieldError`**: Displays validation error text below the group"},"274":{"id":"/docs/components/checkbox-53","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#orientation","content":"Use `orientation=\"vertical\"` (default) to stack checkboxes, or `orientation=\"horizontal\"` to arrange them in a row."},"275":{"id":"/docs/components/checkbox-54","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Tab**: Moves focus to the next/previous checkbox"},"276":{"id":"/docs/components/checkbox-55","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Space**: Toggles the focused checkbox"},"277":{"id":"/docs/components/checkbox-56","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Shift + Tab**: Moves focus to the previous checkbox"},"278":{"id":"/docs/components/checkbox-57","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-disabled` for disabled checkboxes"},"279":{"id":"/docs/components/checkbox-58","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-required` when selection is required"},"280":{"id":"/docs/components/checkbox-59","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-invalid` for validation errors"},"281":{"id":"/docs/components/checkbox-60","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"Proper labeling with `aria-labelledby` and `aria-describedby`"},"282":{"id":"/docs/components/checkbox-61","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate-state-not-updating","content":"The `isIndeterminate` prop must be explicitly managed - it doesn't automatically reflect parent-child relationships:"},"283":{"id":"/docs/components/checkbox-62","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ For selecting multiple independent options"},"284":{"id":"/docs/components/checkbox-63","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ When users can select zero, one, or many items"},"285":{"id":"/docs/components/checkbox-64","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ For toggling settings or features on/off"},"286":{"id":"/docs/components/checkbox-65","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ When all available options should be visible"},"287":{"id":"/docs/components/checkbox-66","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"❌ For mutually exclusive options (use Radio instead)"},"288":{"id":"/docs/components/checkbox-67","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"❌ For simple on/off toggles without labels (use Toggle/Switch instead)"},"289":{"id":"/docs/components/checkbox-68","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Use clear, concise labels that describe what selecting the option means"},"290":{"id":"/docs/components/checkbox-69","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Keep labels short (1-5 words when possible)"},"291":{"id":"/docs/components/checkbox-70","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Ensure labels are descriptive without being verbose"},"292":{"id":"/docs/components/checkbox-71","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Place the most commonly selected options first in groups"},"293":{"id":"/docs/components/checkbox-72","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#validation","content":"Always provide clear error messages and use appropriate validation states:"},"294":{"id":"/docs/components/checkbox-73","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Limit checkbox groups to 7-10 options for better usability"},"295":{"id":"/docs/components/checkbox-74","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Use logical ordering (alphabetical, frequency of use, or importance)"},"296":{"id":"/docs/components/checkbox-75","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Consider using CheckboxGroup for related options, even if there are only 2-3"},"297":{"id":"/docs/components/checkbox-76","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Provide a group label that clearly describes the choice being made"},"298":{"id":"/docs/components/chip","page_id":"/docs/components/chip","type":"page","content":"Chip","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/chip"},"299":{"id":"/docs/components/chip-0","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip","content":"Grouped pill-shaped items for selecting values and removing user-added filters or tokens."},"300":{"id":"/docs/components/chip-1","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#features","content":"Features"},"301":{"id":"/docs/components/chip-2","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#installation","content":"Installation"},"302":{"id":"/docs/components/chip-3","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#quick-start","content":"Quick start"},"303":{"id":"/docs/components/chip-4","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#examples","content":"Examples"},"304":{"id":"/docs/components/chip-5","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#default","content":"Default"},"305":{"id":"/docs/components/chip-6","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#toggle-chips","content":"Toggle Chips"},"306":{"id":"/docs/components/chip-7","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#removable-chips","content":"Removable Chips"},"307":{"id":"/docs/components/chip-8","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#controlled-selection","content":"Controlled Selection"},"308":{"id":"/docs/components/chip-9","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#sizes","content":"Sizes"},"309":{"id":"/docs/components/chip-10","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#disabled","content":"Disabled"},"310":{"id":"/docs/components/chip-11","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#truncation","content":"Truncation"},"311":{"id":"/docs/components/chip-12","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#empty-state","content":"Empty State"},"312":{"id":"/docs/components/chip-13","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#menu-filter-trigger","content":"Menu filter trigger"},"313":{"id":"/docs/components/chip-14","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#customization","content":"Customization"},"314":{"id":"/docs/components/chip-15","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#content","content":"Content"},"315":{"id":"/docs/components/chip-16","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#selection-and-removal","content":"Selection and removal"},"316":{"id":"/docs/components/chip-17","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#layout-and-sizing","content":"Layout and sizing"},"317":{"id":"/docs/components/chip-18","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#button-composition","content":"Button composition"},"318":{"id":"/docs/components/chip-19","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#accessibility","content":"Accessibility"},"319":{"id":"/docs/components/chip-20","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#best-practices","content":"Best Practices"},"320":{"id":"/docs/components/chip-21","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#troubleshooting","content":"Troubleshooting"},"321":{"id":"/docs/components/chip-22","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"A ChipGroup has no accessible name"},"322":{"id":"/docs/components/chip-23","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"The remove action does not update the UI"},"323":{"id":"/docs/components/chip-24","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"A composed label is not truncating correctly"},"324":{"id":"/docs/components/chip-25","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"The menu trigger does not look like a Chip"},"325":{"id":"/docs/components/chip-26","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#props","content":"Props"},"326":{"id":"/docs/components/chip-27","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chip","content":"Chip"},"327":{"id":"/docs/components/chip-28","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipgroup","content":"ChipGroup"},"328":{"id":"/docs/components/chip-29","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chiplist","content":"ChipList"},"329":{"id":"/docs/components/chip-30","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipbutton","content":"ChipButton"},"330":{"id":"/docs/components/chip-31","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipGroup` + `ChipList` + `Chip` for grouped values, selection, keyboard navigation, and removal"},"331":{"id":"/docs/components/chip-32","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Toggle Chips for selecting multiple peer filters"},"332":{"id":"/docs/components/chip-33","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Removable Chips for user-added filters and input tokens"},"333":{"id":"/docs/components/chip-34","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Shared `sm`, `md`, and `lg` sizes, with optional leading icons"},"334":{"id":"/docs/components/chip-35","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipButton` for menu filters and other actions with a Chip-like appearance"},"335":{"id":"/docs/components/chip-36","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#default","content":"Start with a labeled group of related values. Add selection or removal when\nthe group needs interactive behavior."},"336":{"id":"/docs/components/chip-37","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#toggle-chips","content":"Use Toggle Chips for multiple peer filters. The Chip render prop supplies\nselection state for the checkmark, while `textValue` names composed content."},"337":{"id":"/docs/components/chip-38","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#removable-chips","content":"Use Removable Chips for user-added filters and tokens. `ChipGroup` reports\nremoved keys through `onRemove`; the owner updates its collection. A\nself-closing `Button` in the `remove` slot supplies each remove control."},"338":{"id":"/docs/components/chip-39","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#controlled-selection","content":"Use `selectedKeys` and `onSelectionChange` when another part of the page\nneeds to own the selected filter state."},"339":{"id":"/docs/components/chip-40","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#sizes","content":"Compare the supported `sm`, `md`, and `lg` sizes. Set `size` on `ChipGroup`\nso every Chip inherits one consistent size."},"340":{"id":"/docs/components/chip-41","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#disabled","content":"Disable individual options with `disabledKeys` when some values are unavailable."},"341":{"id":"/docs/components/chip-42","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#truncation","content":"By default, long labels truncate visually when space is constrained, while\nthe complete accessible value remains available."},"342":{"id":"/docs/components/chip-43","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#empty-state","content":"Give an empty collection useful guidance, then let the user add the first\nvalue. Removable items continue to be owned by the collection."},"343":{"id":"/docs/components/chip-44","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#menu-filter-trigger","content":"Use `ChipButton` for Chip presentation without collection semantics.\n`MenuTrigger` continues to own open state, focus, and keyboard behavior."},"344":{"id":"/docs/components/chip-45","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#content","content":"Use a string for a simple label. For icons or other composed content, wrap the\nvisible label in `Text` and provide `textValue` for the accessible name. See\n**Toggle Chips** and **Removable Chips** above."},"345":{"id":"/docs/components/chip-46","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#selection-and-removal","content":"`ChipGroup` owns selection and removal behavior. Use a Chip render prop for\nstate-dependent content, and `Button` with `slot=\"remove\"` together with\n`onRemove` for removable items. See **Toggle Chips** and **Removable Chips**."},"346":{"id":"/docs/components/chip-47","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#layout-and-sizing","content":"Set `size` on `ChipGroup` to keep a collection consistent. `ChipList` wraps by\ndefault and accepts layout props for custom arrangements. See **Sizes**."},"347":{"id":"/docs/components/chip-48","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#button-composition","content":"Use `ChipButton` when Chip presentation is needed without collection semantics.\nCompose it with components such as `MenuTrigger`; those components continue to\nown open state, focus, and keyboard behavior. See **Menu filter trigger**."},"348":{"id":"/docs/components/chip-49","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use `Label` or `aria-label` to name the `ChipGroup`; this names the collection,\nnot its individual Chips."},"349":{"id":"/docs/components/chip-50","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Give each Chip a visible label, `textValue`, or `aria-label`. Use `textValue`\nwhen a Chip contains icons, composed content, or a render prop."},"350":{"id":"/docs/components/chip-51","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use a descriptive group label so removal actions can be announced clearly."},"351":{"id":"/docs/components/chip-52","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Keep the visible label and the accessible value synchronized."},"352":{"id":"/docs/components/chip-53","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"`ChipButton` is a real button and exposes menu state through `MenuTrigger`; provide an accessible name when the visible content is incomplete."},"353":{"id":"/docs/components/chip-54","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep labels concise and let them truncate only when the available width requires it."},"354":{"id":"/docs/components/chip-55","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Prefer groups of three or more related values."},"355":{"id":"/docs/components/chip-56","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep one size per group."},"356":{"id":"/docs/components/chip-57","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Let `ChipList` wrap instead of forcing a single horizontal line."},"357":{"id":"/docs/components/chip-58","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Use removable Chips for user-added filters and tokens."},"358":{"id":"/docs/components/chip-59","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"For menu filters, use `ChipButton` with `MenuTrigger` and provide the chevron explicitly."},"359":{"id":"/docs/components/chip-60","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"Add a visible `Label` to the group or provide `aria-label`. For an individual Chip\nwith composed content, provide a visible label, `textValue`, or `aria-label`."},"360":{"id":"/docs/components/chip-61","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"Add `onRemove` to `ChipGroup` and remove the returned keys from the collection\nowned by your application."},"361":{"id":"/docs/components/chip-62","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"Keep the label in `Text`, preserve `textValue`, and constrain the available width\nof the surrounding layout. Truncation is visual; the complete accessible value\nshould remain available."},"362":{"id":"/docs/components/chip-63","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"Use `ChipButton` inside `MenuTrigger`, include the visible value, and add a\ntrailing chevron to communicate that the control opens a menu."},"363":{"id":"/docs/components/chip-64","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#props","content":"For a menu trigger, the button and menu are composed as siblings inside\n`MenuTrigger`:"},"364":{"id":"/docs/components/circular-progress","page_id":"/docs/components/circular-progress","type":"page","content":"CircularProgress","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/circular-progress"},"365":{"id":"/docs/components/circular-progress-0","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress","content":"A circular progress indicator shows determinate progress of an operation over time"},"366":{"id":"/docs/components/circular-progress-1","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#installation","content":"Installation"},"367":{"id":"/docs/components/circular-progress-2","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#examples","content":"Examples"},"368":{"id":"/docs/components/circular-progress-3","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#default","content":"Default"},"369":{"id":"/docs/components/circular-progress-4","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#sizes","content":"Sizes"},"370":{"id":"/docs/components/circular-progress-5","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#emphasis","content":"Emphasis"},"371":{"id":"/docs/components/circular-progress-6","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#accessibility","content":"Accessibility"},"372":{"id":"/docs/components/circular-progress-7","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#aria-support","content":"ARIA Support"},"373":{"id":"/docs/components/circular-progress-8","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#props","content":"Props"},"374":{"id":"/docs/components/circular-progress-9","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#circularprogress","content":"CircularProgress"},"375":{"id":"/docs/components/circular-progress-10","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#default","content":"A basic determinate progress indicator with a label and helper text."},"376":{"id":"/docs/components/circular-progress-11","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#sizes","content"