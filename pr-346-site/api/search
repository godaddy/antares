s/button","type":"heading","tags":[],"url":"/docs/components/button#closebutton","content":"CloseButton"},"185":{"id":"/docs/components/button-17","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use the `LinkButton` component instead when you need navigation functionality with a button-like appearance."},"186":{"id":"/docs/components/button-18","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use the `CloseButton` preset to dismiss an overlay (such as a `Modal`). It defaults to `slot=\"close\"`, so it picks up the overlay's close behavior with no wiring, and always renders an `x` icon with `aria-label=\"Close\"`. For a labelled dismiss action (e.g. \"Cancel\"), use a raw `<Button slot=\"close\">Cancel</Button>`."},"187":{"id":"/docs/components/button-19","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Inside a field `Group`, `slot=\"control\"` and `slot=\"trigger\"` pick up the matching look, size, and\ndisabled state from context. See TextField for control affixes, and Select or DatePicker for trigger faces."},"188":{"id":"/docs/components/button-20","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#default","content":"The default/tertiary button is the base for all other buttons in the system. It provides no significant visual treatment other than to provide indication for the user to take a common action."},"189":{"id":"/docs/components/button-21","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#primary","content":"The primary button should be used to indicate the most important action for the user to take in their current experience."},"190":{"id":"/docs/components/button-22","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#secondary","content":"The secondary button indicates an action of secondary importance."},"191":{"id":"/docs/components/button-23","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#tertiary","content":"The tertiary button is the default, low-emphasis style used for common, non-critical actions."},"192":{"id":"/docs/components/button-24","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#critical","content":"The critical button signifies to the user a destructive action will take place."},"193":{"id":"/docs/components/button-25","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#disabled","content":"Any button variant can be disabled to prevent interaction, communicated with reduced opacity and a not-allowed cursor."},"194":{"id":"/docs/components/button-26","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#icon","content":"You may provide an optional `Icon` component to the button. If you do not include text, you must provide an aria-label attribute to identify the purpose of the button. This will produce a square button."},"195":{"id":"/docs/components/button-27","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#inline","content":"The inline button sits within a run of text, styled like a link while retaining button semantics."},"196":{"id":"/docs/components/button-28","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#minimal","content":"The minimal button is an icon-only button that's used when space is limited and/or when the action is universally understood."},"197":{"id":"/docs/components/button-29","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#sizes","content":"Buttons come in small and medium sizes to fit different layout densities."},"198":{"id":"/docs/components/carousel","page_id":"/docs/components/carousel","type":"page","con