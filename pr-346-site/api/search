/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#troubleshooting","content":"Troubleshooting"},"1897":{"id":"/docs/components/chart/line-chart-40","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#chart-not-sizing-or-empty","content":"Chart Not Sizing or Empty"},"1898":{"id":"/docs/components/chart/line-chart-41","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#dates-not-displaying-correctly","content":"Dates Not Displaying Correctly"},"1899":{"id":"/docs/components/chart/line-chart-42","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#tooltip-or-crosshair-not-showing","content":"Tooltip or Crosshair Not Showing"},"1900":{"id":"/docs/components/chart/line-chart-43","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#props","content":"Props"},"1901":{"id":"/docs/components/chart/line-chart-44","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#linechart","content":"LineChart"},"1902":{"id":"/docs/components/chart/line-chart-45","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#default","content":"One line, a time-scale X axis, and almost nothing else configured - the everyday starting point. You give the chart a `series` array and it reads `x`/`y` from each point."},"1903":{"id":"/docs/components/chart/line-chart-46","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#multiple-series","content":"Several lines sharing one X axis, with a legend naming each of them. Reach for this when the comparison between series is the story."},"1904":{"id":"/docs/components/chart/line-chart-47","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#gridlines","content":"`xGridlines` and `yGridlines` add faint lines across the plot so it is easier to read a value back off an axis."},"1905":{"id":"/docs/components/chart/line-chart-48","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#titles","content":"`xTitle` and `yTitle` label what each axis actually measures, e.g. \"Month\" and \"Temperature (°F)\"."},"1906":{"id":"/docs/components/chart/line-chart-49","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#labels","content":"`xLabels` and `yLabels` toggle the tick labels on each axis. Turn them off for sparklines or when the surrounding UI already names the values."},"1907":{"id":"/docs/components/chart/line-chart-50","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#ticks","content":"`xTickMarks` and `yTickMarks` draw the short lines at each tick value, which helps tie a label to its exact position on the axis."},"1908":{"id":"/docs/components/chart/line-chart-51","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#baselines","content":"`xBaseline` and `yBaseline` control the main axis lines themselves. Dropping them gives a lighter, more editorial chart."},"1909":{"id":"/docs/components/chart/line-chart-52","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#legend","content":"`legendPosition` puts the legend above or below the plot, or hides it with `null`. Multi-series charts get a bottom legend by default."},"1910":{"id":"/docs/components/chart/line-chart-53","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#axis-and-tooltip-formatting","content":"`xTickFormat` and `yTickFormat` shape the axis labels - dates, currency, units, percentages - and the tooltip follows the same formatting."},"1911":{"id":"/docs/components/chart/line-chart-54","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-accessors","content":"When your data does not use `x`/`y`, point `xAccessor` and `yAccessor` at the fields it does use (here `date` and `value`) instead of reshaping the data first."},"1912":{"id":"/docs/components/chart/line-chart-55","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#missing-values","content":"A `null` Y value breaks the line instead of drawing through the gap, so missing data reads as missing rather than as a straight interpolation."},"1913":{"id":"/docs/components/chart/line-chart-56","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#fixed-domain","content":"`xDomain` and `yDomain` pin the visible range. Use them to keep a fixed scale, or to keep several charts comparable."},"1914":{"id":"/docs/components/chart/line-chart-57","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#nice-values","content":"`xNice` and `yNice` round the domain out to friendlier numbers (e.g. 0.2 to 1.0), so ticks land on values people expect."},"1915":{"id":"/docs/components/chart/line-chart-58","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#zero-included","content":"`xZero` and `yZero` stretch the domain to include zero. Worth doing when the absolute size of the values matters, not just their movement."},"1916":{"id":"/docs/components/chart/line-chart-59","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-ticks","content":"Choose the ticks yourself with `xTickValues`/`yTickValues`, or just ask for roughly how many you want with `xNumTicks`/`yNumTicks`."},"1917":{"id":"/docs/components/chart/line-chart-60","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#band-padding","content":"`xPaddingOuter` and `yPaddingOuter` add breathing room at the ends of a band or point scale so the first and last values are not pinned to the edges."},"1918":{"id":"/docs/components/chart/line-chart-61","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#tooltip-disabled","content":"Turn off the hover affordances entirely with `tooltip={false}`, `showCrosshair={false}`, and `showDataPoints={false}` - useful for a static or print-style chart."},"1919":{"id":"/docs/components/chart/line-chart-62","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#crosshair-only","content":"Keep the vertical crosshair for orientation while hiding the tooltip and the data point glyphs."},"1920":{"id":"/docs/components/chart/line-chart-63","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip-formatting","content":"`tooltipValueFormatter` shapes only the tooltip values, so you can show full currency or units there while the axis stays compact."},"1921":{"id":"/docs/components/chart/line-chart-64","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#fixed-size","content":"Pass `width` and `height` to size the chart explicitly instead of letting it fill its container."},"1922":{"id":"/docs/components/chart/line-chart-65","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#bitcoin-price","content":"A real time series: date formatting on the X axis, currency on the Y axis, gridlines, and a nice-rounded domain."},"1923":{"id":"/docs/components/chart/line-chart-66","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#city-temperature","content":"Several cities over the same period, with a legend and a shared time axis - the multi-series case as it usually looks in a product."},"1924":{"id":"/docs/components/chart/line-chart-67","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#browser-usage","content":"A categorical X axis (band scale) with several series and percentage formatting, for when the X values are names rather than numbers or dates."},"1925":{"id":"/docs/components/chart/line-chart-68","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#rtl","content":"The chart follows the current layout direction, normally detected from the browser or system settings. In right-to-left it mirrors the axes and labels; this example forces RTL so you can see it in a left-to-right page."},"1926":{"id":"/docs/components/chart/line-chart-69","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#color-index","content":"`colorIndex` pins each series to a palette color. Any series can use any index,\nindependently — here two pairs each share an index so an actual line and its\ndashed forecast read as the same color, distinguished only by line style."},"1927":{"id":"/docs/components/chart/line-chart-70","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip","content":"`renderTooltip` lets you render a fully custom tooltip and know which curve is\nhovered. Paired series share a `colorIndex`; hovering either line shows a\ntooltip specific to that line, wrapped in the default styled popover."},"1928":{"id":"/docs/components/chart/line-chart-71","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip-pair-change","content":"`renderTooltip` example combining a pair of series. Each pair shares a `colorIndex`\n(solid actual + dashed forecast); hovering either line shows the percent change of\nthe forecast against the actual for that pair, wrapped in the default styled popover."},"1929":{"id":"/docs/components/chart/line-chart-72","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip-period-comparison","content":"`renderTooltip` example styled as a period-over-period comparison card. Paired series\n(solid current period + dashed previous period) share a `colorIndex`; hovering either\nline shows both dated values and the percent change, wrapped in the default popover."},"1930":{"id":"/docs/components/chart/line-chart-73","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#line-styles","content":"`variant` sets each series' line style — 'solid' (default), 'dashed', or\n'dotted' — useful for distinguishing actuals from forecasts or targets. The\nlegend swatch mirrors each line's style."},"1931":{"id":"/docs/components/chart/line-chart-74","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#data-attributes","content":"The chart root exposes data attributes that reflect prop state for styling:"},"1932":{"id":"/docs/components/chart/line-chart-75","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#data-attributes","content":"**Chart container:** `data-width`, `data-height`, `data-x-labels`, `data-y-labels`, `data-x-labels-vertical`, `data-x-baseline`, `data-y-baseline`, `data-x-tick-marks`, `data-y-tick-marks`"},"1933":{"id":"/docs/components/chart/line-chart-76","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#component-customization","content":"Use the `className` prop on the chart container to add or override styles:"},"1934":{"id":"/docs/components/chart/line-chart-77","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"Provide &#x2A;*`aria-label`** to describe the chart (e.g. \"Monthly sales revenue from January to May 2024\")."},"1935":{"id":"/docs/components/chart/line-chart-78","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"Use &#x2A;*`desc`** for a longer description rendered in the SVG `<desc>` for screen readers."},"1936":{"id":"/docs/components/chart/line-chart-79","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"The component sets ARIA attributes on interactive and structural elements as needed."},"1937":{"id":"/docs/components/chart/line-chart-80","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Use for trends over time or along a continuous scale."},"1938":{"id":"/docs/components/chart/line-chart-81","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Use when comparing a few series (e.g. 2-5 lines); avoid too many overlapping lines."},"1939":{"id":"/docs/components/chart/line-chart-82","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Prefer a single chart with a legend over multiple small charts when comparing the same X range."},"1940":{"id":"/docs/components/chart/line-chart-83","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#chart-not-sizing-or-empty","content":"Ensure the chart has a non-zero size. Place it in a container with explicit dimensions or use `width` and `height`:"},"1941":{"id":"/docs/components/chart/line-chart-84","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#dates-not-displaying-correctly","content":"Use `xType=\"time\"` when the X-axis values are Date objects:"},"1942":{"id":"/docs/components/chart/line-chart-85","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#tooltip-or-crosshair-not-showing","content":"Ensure `tooltip`, `showCrosshair`, or `showDataPoints` are not set to `false`, and that the chart receives pointer events (e.g. no overlay blocking hover)."},"1943":{"id":"/docs/components/layout/box","page_id":"/docs/components/layout/box","type":"page","content":"Box","breadcrumbs":["Docs","Components","Layout"],"tags":[],"url":"/docs/components/layout/box"},"1944":{"id":"/docs/components/layout/box-0","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box","content":"Polymorphic layout component providing consistent spacing, elevation, rounding, and self-alignment"},"1945":{"id":"/docs/components/layout/box-1","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#installation","content":"Installation"},"1946":{"id":"/docs/components/layout/box-2","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#scale-sizes","content":"Scale Sizes"},"1947":{"id":"/docs/components/layout/box-3","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#polymorphic-as-details","content":"Polymorphic `as` details"},"1948":{"id":"/docs/components/layout/box-4","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#examples","content":"Examples"},"1949":{"id":"/docs/components/layout/box-5","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#padding","content":"Padding"},"1950":{"id":"/docs/components/layout/box-6","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#elevation","content":"Elevation"},"1951":{"id":"/docs/components/layout/box-7","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#rounding","content":"Rounding"},"1952":{"id":"/docs/components/layout/box-8","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#polymorphic-as-prop","content":"Polymorphic as Prop"},"1953":{"id":"/docs/components/layout/box-9","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#alignment","content":"Alignment"},"1954":{"id":"/docs/components/layout/box-10","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#rtl-support","content":"RTL Support"},"1955":{"id":"/docs/components/layout/box-11","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#design-tokens","content":"Design Tokens"},"1956":{"id":"/docs/components/layout/box-12","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#props","content":"Props"},"1957":{"id":"/docs/components/layout/box-13","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#box","content":"Box"},"1958":{"id":"/docs/components/layout/box-14","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box","content":"`Box` is a polymorphic layout component that renders as any HTML element or custom component via the `as` prop. It provides consistent spacing, elevation, rounding, and self-alignment within flex or grid containers."},"1959":{"id":"/docs/components/layout/box-15","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box","content":"**Important**: Since `Flex` and `Grid` extend `Box`, prefer them for layouts. Use `Box` only when you need a non-flex, non-grid container."},"1960":{"id":"/docs/components/layout/box-16","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"The spacing props use semantic t-shirt sizes for padding, gap, and other spacing properties:"},"1961":{"id":"/docs/components/layout/box-17","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`xs` - Extra small spacing"},"1962":{"id":"/docs/components/layout/box-18","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`sm` - Small spacing"},"1963":{"id":"/docs/components/layout/box-19","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`md` - Medium spacing"},"1964":{"id":"/docs/components/layout/box-20","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`lg` - Large spacing"},"1965":{"id":"/docs/components/layout/box-21","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`xl` - Extra large spacing"},"1966":{"id":"/docs/components/layout/box-22","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"`2xl` - 2x extra large spacing"},"1967":{"id":"/docs/components/layout/box-23","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#scale-sizes","content":"Custom CSS values are also supported for edge cases."},"1968":{"id":"/docs/components/layout/box-24","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#polymorphic-as-details","content":"**HTML Elements:** When using `as=\"button\"`, TypeScript enforces button-specific props like `type`, `disabled`, and `onClick`."},"1969":{"id":"/docs/components/layout/box-25","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#polymorphic-as-details","content":"**Custom Components:** When using `as={MyComponent}`, Box accepts that component's props. If there's a prop name conflict, Box's props take priority."},"1970":{"id":"/docs/components/layout/box-26","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#polymorphic-as-details","content":"**Typed Refs:** Refs are correctly typed based on the `as` value - `useRef<HTMLButtonElement>` works with `as=\"button\"`."},"1971":{"id":"/docs/components/layout/box-27","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#padding","content":"The padding props support t-shirt sizes and CSS logical properties for RTL support."},"1972":{"id":"/docs/components/layout/box-28","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#elevation","content":"The elevation prop adds visual depth using box-shadow."},"1973":{"id":"/docs/components/layout/box-29","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#rounding","content":"The rounding prop sets border-radius. Use `full` for fully rounded corners."},"1974":{"id":"/docs/components/layout/box-30","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#polymorphic-as-prop","content":"Box is fully polymorphic - the `as` prop allows rendering as any HTML element or custom component while preserving type-safe props."},"1975":{"id":"/docs/components/layout/box-31","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#alignment","content":"Self-alignment props allow Box to position itself within flex or grid containers."},"1976":{"id":"/docs/components/layout/box-32","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#rtl-support","content":"Box uses CSS logical properties (`padding-inline-start`, `padding-block-end`, etc.) which automatically adapt to RTL layouts. No additional configuration is needed."},"1977":{"id":"/docs/components/layout/box-33","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box#design-tokens","content":"All spacing, elevation, and rounding values are derived from the theme. If no theme is provided, default values are used. This ensures consistency across the design system."},"1978":{"id":"/docs/components/layout/flex","page_id":"/docs/components/layout/flex","type":"page","content":"Flex","breadcrumbs":["Docs","Components","Layout"],"tags":[],"url":"/docs/components/layout/flex"},"1979":{"id":"/docs/components/layout/flex-0","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex","content":"One-dimensional layout component for arranging children in rows or columns with alignment and spacing control"},"1980":{"id":"/docs/components/layout/flex-1","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#installation","content":"Installation"},"1981":{"id":"/docs/components/layout/flex-2","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#scale-sizes","content":"Scale Sizes"},"1982":{"id":"/docs/components/layout/flex-3","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#examples","content":"Examples"},"1983":{"id":"/docs/components/layout/flex-4","page_id":"/docs/componen