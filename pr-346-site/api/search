","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#events","content":"You can listen to events like `onChange`, `onPrev`, or `onNext`."},"192":{"id":"/docs/components/carousel-20","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#rtl-direction","content":"The carousel follows the current **layout direction** (LTR or RTL). By default, that direction is detected automatically from the browser or system settings."},"193":{"id":"/docs/components/checkbox","page_id":"/docs/components/checkbox","type":"page","content":"Checkbox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/checkbox"},"194":{"id":"/docs/components/checkbox-0","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox","content":"Accessible checkbox component for multi-select options with support for indeterminate states, validation, keyboard navigation, and flexible group layouts."},"195":{"id":"/docs/components/checkbox-1","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#installation","content":"Installation"},"196":{"id":"/docs/components/checkbox-2","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#examples","content":"Examples"},"197":{"id":"/docs/components/checkbox-3","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#default","content":"Default"},"198":{"id":"/docs/components/checkbox-4","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#indeterminate","content":"Indeterminate"},"199":{"id":"/docs/components/checkbox-5","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkbox-group","content":"Checkbox Group"},"200":{"id":"/docs/components/checkbox-6","page_id":"/docs/components/checkbox","type":"heading","tags":[