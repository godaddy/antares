heckbox#label-guidelines","content":"Use clear, concise labels that describe what selecting the option means"},"273":{"id":"/docs/components/checkbox-69","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Keep labels short (1-5 words when possible)"},"274":{"id":"/docs/components/checkbox-70","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Ensure labels are descriptive without being verbose"},"275":{"id":"/docs/components/checkbox-71","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Place the most commonly selected options first in groups"},"276":{"id":"/docs/components/checkbox-72","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#validation","content":"Always provide clear error messages and use appropriate validation states:"},"277":{"id":"/docs/components/checkbox-73","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Limit checkbox groups to 7-10 options for better usability"},"278":{"id":"/docs/components/checkbox-74","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Use logical ordering (alphabetical, frequency of use, or importance)"},"279":{"id":"/docs/components/checkbox-75","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Consider using CheckboxGroup for related options, even if there are only 2-3"},"280":{"id":"/docs/components/checkbox-76","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Provide a group label that clearly describes the choice being made"},"281":{"id":"/docs/components/carou