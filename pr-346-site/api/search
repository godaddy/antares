,"1468":{"id":"/docs/components/text-14","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#max-lines","content":"Setting the `maxLines` prop limits the number of displayed lines using an ellipsis."},"1469":{"id":"/docs/components/text-15","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#wrap","content":"Setting the `wrap` prop controls text wrapping with values such as `wrap`, `nowrap`, `balance`, `pretty`, or `stable`."},"1470":{"id":"/docs/components/text-field","page_id":"/docs/components/text-field","type":"page","content":"TextField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-field"},"1471":{"id":"/docs/components/text-field-0","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field","content":"TextField is a composed single-line or multiline text input. Use it in forms for short answers (email, search, name) or longer content (comments)."},"1472":{"id":"/docs/components/text-field-1","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#features","content":"Features"},"1473":{"id":"/docs/components/text-field-2","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#installation","content":"Installation"},"1474":{"id":"/docs/components/text-field-3","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#examples","content":"Examples"},"1475":{"id":"/docs/components/text-field-4","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#default","content":"Default"},"1476":{"id":"/docs/components/text-field-5","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#controlled","content":"Controlled"},"1477":{"id":"/docs/components/text-field-6","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#invalid","content":"Invalid"},"1478":{"id":"/docs/components/text-field-7","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#disabled","content":"Disabled"},"1479":{"id":"/docs/components/text-field-8","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#adornments","content":"Adornments"},"1480":{"id":"/docs/components/text-field-9","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#multiline","content":"Multiline"},"1481":{"id":"/docs/components/text-field-10","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#sizes","content":"Sizes"},"1482":{"id":"/docs/components/text-field-11","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#controls-and-icons","content":"Controls and icons"},"1483":{"id":"/docs/components/text-field-12","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#telephone-field","content":"Telephone Field"},"1484":{"id":"/docs/components/text-field-13","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#props","content":"Props"},"1485":{"id":"/docs/components/text-field-14","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#textfield","content":"TextField"},"1486":{"id":"/docs/components/text-field-15","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Composable interior**: Compose `Label`, `Input` or `TextArea`, `Text slot=\"description\"`, and `FieldError`. Omitting `Group` leaves the control as a direct field child with box chrome. Use an explicit `Group` for controls or adornments"},"1487":{"id":"/docs/components/text-field-16","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Adornments**: Fixed text or icons before or after the input (e.g. `$`, `.00`, `px`) are composed inside `Group`, positioned by source order"},"1488":{"id":"/docs/components/text-field-17","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controls**: A `Button slot=\"control\"` beside the input is an interactive affix; it picks up field chrome from context"},"1489":{"id":"/docs/components/text-field-18","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"1490":{"id":"/docs/components/text-field-19","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Multiline**: Compose a `TextArea` instead of an `Input` for multiline entry"},"1491":{"id":"/docs/components/text-field-20","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"1492":{"id":"/docs/components/text-field-21","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#default","content":"Minimal usage: a `Label` and an `Input`."},"1493":{"id":"/docs/components/text-field-22","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#controlled","content":"Use `value` and `onChange` for controlled state."},"1494":{"id":"/docs/components/text-field-23","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#invalid","content":"Use `isInvalid` with a `FieldError` for validation feedback."},"1495":{"id":"/docs/components/text-field-24","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#disabled","content":"Use `isDisabled` to prevent input."},"1496":{"id":"/docs/components/text-field-25","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#adornments","content":"Fixed text before and after the input, such as currency. Leading and trailing content is\ncomposed inside the `Group` and its position comes from source order."},"1497":{"id":"/docs/components/text-field-26","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#multiline","content":"Compose a `TextArea` instead of an `Input` for multiline entry."},"1498":{"id":"/docs/components/text-field-27","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#sizes","content":"Compare the supported `md` and `sm` visual sizes, plain and with an icon plus control button.\nSet `size` on `TextField` so the input and `Button slot=\"control\"` share the same size."},"1499":{"id":"/docs/components/text-field-28","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#controls-and-icons","content":"Put a control or an icon beside the input. A `Button slot=\"control\"` is an\ninteractive affix; static content is wrapped in a `Flex as=\"span\"` to center it and give it a gutter."},"1500":{"id":"/docs/components/text-field-29","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#telephone-field","content":"Compose a telephone number input paired with a country-code select."},"1501":{"id":"/docs/components/text-area","page_id":"/docs/components/text-area","type":"page","content":"TextArea","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-area"},"1502":{"id":"/docs/components/text-area-0","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area","content":"Multiline text control for use inside a field."},"1503":{"id":"/docs/components/text-area-1","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#installation","content":"Installation"},"1504":{"id":"/docs/components/text-area-2","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#examples","content":"Examples"},"1505":{"id":"/docs/components/text-area-3","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#default","content":"Default"},"1506":{"id":"/docs/components/text-area-4","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#props","content":"Props"},"1507":{"id":"/docs/components/text-area-5","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#textarea","content":"TextArea"},"1508":{"id":"/docs/components/text-area-6","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area","content":"`TextArea` is the multiline control inside a field, not a field on its own. Prefer `TextField` as the parent; see that component for fuller examples."},"1509":{"id":"/docs/components/text-area-7","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area#default","content":"TextArea inside TextField."},"1510":{"id":"/docs/components/text-lockup","page_id":"/docs/components/text-lockup","type":"page","content":"TextLockup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-lockup"},"1511":{"id":"/docs/components/text-lockup-0","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup","content":"TextLockup stacks an eyebrow, title, and body text as one coordinated type group across six sizes."},"1512":{"id":"/docs/components/text-lockup-1","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#features","content":"Features"},"1513":{"id":"/docs/components/text-lockup-2","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#installation","content":"Installation"},"1514":{"id":"/docs/components/text-lockup-3","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#examples","content":"Examples"},"1515":{"id":"/docs/components/text-lockup-4","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#default","content":"Default"},"1516":{"id":"/docs/components/text-lockup-5","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#sizes","content":"Sizes"},"1517":{"id":"/docs/components/text-lockup-6","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#tag-eyebrow","content":"Tag Eyebrow"},"1518":{"id":"/docs/components/text-lockup-7","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#alignment","content":"Alignment"},"1519":{"id":"/docs/components/text-lockup-8","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#legible-lines","content":"Legible Lines"},"1520":{"id":"/docs/components/text-lockup-9","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#with-actions","content":"With Actions"},"1521":{"id":"/docs/components/text-lockup-10","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#customization","content":"Customization"},"1522":{"id":"/docs/components/text-lockup-11","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#accessibility","content":"Accessibility"},"1523":{"id":"/docs/components/text-lockup-12","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#best-practices","content":"Best Practices"},"1524":{"id":"/docs/components/text-lockup-13","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#props","content":"Props"},"1525":{"id":"/docs/components/text-lockup-14","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#textlockup","content":"TextLockup"},"1526":{"id":"/docs/components/text-lockup-15","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Six coordinated sizes, from a `2xl` page title down to `xs`"},"1527":{"id":"/docs/components/text-lockup-16","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"An eyebrow that takes plain text or a `Tag`, sized to match the lockup"},"1528":{"id":"/docs/components/text-lockup-17","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Slotted parts, so nested components keep their own type"},"1529":{"id":"/docs/components/text-lockup-18","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Any heading level, chosen independently of the visual size"},"1530":{"id":"/docs/components/text-lockup-19","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Start or center alignment"},"1531":{"id":"/docs/components/text-lockup-20","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"A legible line-length clamp, on by default"},"1532":{"id":"/docs/components/text-lockup-21","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#default","content":"A lockup stacks an optional eyebrow, a title and body text as one coordinated type\ngroup. You supply the parts, so the title can be any heading level and the body any\nnumber of paragraphs; `size` sets the tier for all of them at once."},"1533":{"id":"/docs/components/text-lockup-22","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#sizes","content":"`size` is the tier: the eyebrow reads it on the `detail` ramp, the title on `heading`,\nand the body on `body`. Use `2xl` for a page title, `xl` for a hero, `lg` for a section\ntitle, and `md` (the default) everywhere else."},"1534":{"id":"/docs/components/text-lockup-23","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#tag-eyebrow","content":"The eyebrow takes either plain text or a `Tag`. Both use `slot=\"eyebrow\"`, so the two\nforms swap freely, and the lockup pairs the tag's `size` with its own."},"1535":{"id":"/docs/components/text-lockup-24","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#alignment","content":"`align` centers the parts as well as the text, so a `Tag` eyebrow stays centered too."},"1536":{"id":"/docs/components/text-lockup-25","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#legible-lines","content":"The text parts are constrained to a comfortable line length by default. Set\n`legibleLines={false}` to let them run the full width of their container, which suits a\nlockup already inside a narrow column. Both lockups below share one wide container, so the\nclamp is what makes the first one narrower."},"1537":{"id":"/docs/components/text-lockup-26","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#with-actions","content":"Because you compose the parts, anything else can sit alongside them — a call to action\nhere. Controls keep their own type: the buttons are unaffected by the lockup's `size`."},"1538":{"id":"/docs/components/text-lockup-27","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"`TextLockup` positions and type-sets its parts; you supply them. That means anything else can\nsit alongside them — a call to action, a second paragraph, an image — without the component\ngrowing a prop for it."},"1539":{"id":"/docs/components/text-lockup-28","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**Every part names its role with a slot**: `eyebrow`, `title`, `body`. Anything unslotted is\nleft alone, which is what lets a nested component keep its own internal text. Forget the slot\nand the text simply renders untypeset rather than erroring."},"1540":{"id":"/docs/components/text-lockup-29","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The eyebrow is `slot=\"eyebrow\"`**, on either a `Text` or a `Tag`. The two forms swap\nfreely, and a `Tag` is sized to pair with the lockup."},"1541":{"id":"/docs/components/text-lockup-30","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The title is `<Heading slot=\"title\">`.** Pick the level from the document outline, not the\nvisual size: `size` handles the visuals, so `level={1}` in an `xs` lockup is perfectly valid."},"1542":{"id":"/docs/components/text-lockup-31","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The body is `<Text slot=\"body\">`**, once or as many times as the copy needs."},"1543":{"id":"/docs/components/text-lockup-32","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**An explicit prop on a child always wins** over what the lockup supplies. Pass\n`<Tag slot=\"eyebrow\" size=\"sm\">` to break the pairing, for instance."},"1544":{"id":"/docs/components/text-lockup-33","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**Controls keep their own type.** A `Button` inside a lockup is sized by its own `size` prop,\nnot the lockup's."},"1545":{"id":"/docs/components/text-lockup-34","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**`size` is the tier.** The eyebrow reads it on the `detail` ramp, the title on `heading`, and\nthe body on `body`, so there is no table to memorize."},"1546":{"id":"/docs/components/text-lockup-35","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"Pass `className` to extend the styles, or select on `[data-size]` and `[data-align]`."},"1547":{"id":"/docs/components/text-lockup-36","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"The title carries the heading semantics. Choose `level` so the page outline stays correct\nrather than to achieve a size."},"1548":{"id":"/docs/components/text-lockup-37","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"Slots resolve against the lockup, so `slot=\"title\"` names the lockup's title, not an outer\ncontainer's. Inside a\n`Modal`, `Drawer` or `Popover`, give the dialog its own `<Heading slot=\"title\">` as a direct\nchild for the accessible name, and use the lockup for the body."},"1549":{"id":"/docs/components/text-lockup-38","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"The eyebrow is decorative in most designs. If it carries meaning, make sure the title still\nreads sensibly on its own, since screen reader users often navigate by heading."},"1550":{"id":"/docs/components/text-lockup-39","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Use one `2xl` lockup per page at most — it is the page title."},"1551":{"id":"/docs/components/text-lockup-40","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Keep `legibleLines` on for running prose. Turn it off only when the lockup already sits in a\nnarrow column, where the clamp does nothing but complicate the layout."},"1552":{"id":"/docs/components/text-lockup-41","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Prefer a `Tag` eyebrow for status or category, and plain text for a kicker or section label."},"1553":{"id":"/docs/components/text-lockup-42","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Reach for `MetricsLockup` instead when the emphasis is a single number rather than prose."},"1554":{"id":"/docs/components/toggle-button","page_id":"/docs/components/toggle-button","type":"page","content":"ToggleButton","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/toggle-button"},"1555":{"id":"/docs/components/toggle-button-0","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button","content":"Accessible toggle button component for grouped contextual actions with single or multiple selection, keyboard navigation, and RTL-aware layouts."},"1556":{"id":"/docs/components/toggle-button-1","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/compon