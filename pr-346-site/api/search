:"/docs/components/progress-steps-17","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Horizontal and vertical orientations"},"1009":{"id":"/docs/components/progress-steps-18","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Four completion statuses (`none`, `partial`, `complete`, `error`) with status icons"},"1010":{"id":"/docs/components/progress-steps-19","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Timeline (past / current / future) derived from a single `currentStep` prop"},"1011":{"id":"/docs/components/progress-steps-20","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Auto-generated step numbers (opt out with `hideStepNumbers`)"},"1012":{"id":"/docs/components/progress-steps-21","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Interactive (navigable) and inert (display-only) steps"},"1013":{"id":"/docs/components/progress-steps-22","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Title truncation and RTL support"},"1014":{"id":"/docs/components/progress-steps-23","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Rendered as a `<nav>` landmark with an ordered list for assistive technology"},"1015":{"id":"/docs/components/progress-steps-24","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#default","content":"A horizontal stepper. `currentStep` marks the active step; earlier steps are `past`, later are `future`. Each `status` sets the step's icon, and an `error` step turns its accent bar red."},"1016":{"id":"/docs/components/progress-steps-25","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#not-started","content":"No `currentStep`: the flow hasn't started, so every step is `future` and none is marked current."},"1017":{"id":"/docs/components/progress-steps-26","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#vertical","content":"Vertical orientation: accent bar on the leading edge, steps stacked in a column."},"1018":{"id":"/docs/components/progress-steps-27","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#interactive","content":"Interactive steps: each `onPress` navigates the wizard by updating `currentStep`."},"1019":{"id":"/docs/components/progress-steps-28","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#disabled","content":"A disabled interactive step is muted, not focusable, and cannot be activated."},"1020":{"id":"/docs/components/progress-steps-29","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#hide-step-numbers","content":"Step numbers are shown by default; `hideStepNumbers` omits the \"N. \" prefix."},"1021":{"id":"/docs/components/progress-steps-30","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"Step numbers (`\"N. \"`) are prepended automatically — keep them where possible, as user testing shows people recognize the component better with them. Set `hideStepNumbers` to omit them."},"1022":{"id":"/docs/components/progress-steps-31","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"`orientation` switches between `horizontal` (accent bar on top) and `vertical` (accent bar on the leading edge)."},"1023":{"id":"/docs/components/progress-steps-32","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"`currentStep` is the single source of truth for the timeline. Omit it for a not-yet-started flow where every step is `future`; pass the step count for a fully completed flow where every step is `past`."},"1024":{"id":"/docs/components/progress-steps-33","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"`status` is independent of timeline and only controls the status icon and (for `error`) the accent bar color."},"1025":{"id":"/docs/components/progress-steps-34","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"Pass `className` to the container or an individual step to extend the styles."},"1026":{"id":"/docs/components/progress-steps-35","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"The container renders a `<nav>` landmark; set `aria-label` to name it (defaults to `\"Progress\"`)."},"1027":{"id":"/docs/components/progress-steps-36","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"Steps are an ordered list (`<ol>`/`<li>`) so assistive technology conveys position and count."},"1028":{"id":"/docs/components/progress-steps-37","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"The current step is marked with `aria-current=\"step\"`."},"1029":{"id":"/docs/components/progress-steps-38","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"Interactive steps are real buttons: focusable in the natural **Tab** order and activated with **Enter** or **Space**. Status icons are decorative (`aria-hidden`)."},"1030":{"id":"/docs/components/progress-steps-39","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"Focus is shown with a visible outline; disabled steps use `0.4` opacity and are not focusable."},"1031":{"id":"/docs/components/progress-steps-40","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Drive the timeline from `currentStep` rather than styling individual steps."},"1032":{"id":"/docs/components/progress-steps-41","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Provide `onPress` only for steps a user can actually navigate to; leave it off for display-only steps."},"1033":{"id":"/docs/components/progress-steps-42","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Keep titles short — they truncate with an ellipsis when space is tight."},"1034":{"id":"/docs/components/progress-steps-43","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Always give the container an `aria-label` that describes the flow (e.g. `\"Checkout progress\"`)."},"1035":{"id":"/docs/components/progress-steps-44","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#troubleshooting","content":"**No step is highlighted:** `currentStep` is omitted, negative, or out of range. Set it to the active step's 0-based index."},"1036":{"id":"/docs/components/progress-steps-45","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#troubleshooting","co