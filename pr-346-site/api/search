nents/card","type":"heading","tags":[],"url":"/docs/components/card#examples","content":"Examples"},"193":{"id":"/docs/components/card-3","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#default","content":"Default"},"194":{"id":"/docs/components/card-4","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#text-lockup","content":"Text lockup"},"195":{"id":"/docs/components/card-5","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#corner-actions","content":"Corner actions"},"196":{"id":"/docs/components/card-6","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#link","content":"Link"},"197":{"id":"/docs/components/card-7","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#media","content":"Media"},"198":{"id":"/docs/components/card-8","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#actions","content":"Actions"},"199":{"id":"/docs/components/card-9","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#checkbox","content":"Checkbox"},"200":{"id":"/docs/components/card-10","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#radio","content":"Radio"},"201":{"id":"/docs/components/card-11","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#layout","content":"Layout"},"202":{"id":"/docs/components/card-12","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#customization","content":"Customization"},"203":{"id":"/docs/components/card-13","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#accessibility","content":"Accessibility"},"204":{"id":"/docs/components/card-14","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#props","content":"Props"},"205":{"id":"/docs/components/card-15","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#card","content":"Card"},"206":{"id":"/docs/components/card-16","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#cardselectionindicator","content":"CardSelectionIndicator"},"207":{"id":"/docs/components/card-17","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card","content":"Card is a layout surface. Default padding and gap are `lg`. Direct `CornerActions` sit at the\ntop-end. `href` and `onPress` add a primary action. `selection` adds a checkbox or radio; place\n`CardSelectionIndicator` yourself. Clicking the Card body toggles selection unless the Card also\nhas a primary action."},"208":{"id":"/docs/components/card-18","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#default","content":"A static Card just renders its children."},"209":{"id":"/docs/components/card-19","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#text-lockup","content":"Compose Card with TextLockup for eyebrow, title, and body."},"210":{"id":"/docs/components/card-20","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#corner-actions","content":"Direct CornerActions sit at the top-end of the Card."},"211":{"id":"/docs/components/card-21","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#link","content":"href turns the Card into a native link."},"212":{"id":"/docs/components/card-22","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#media","content":"Use default padding for inset media, or zero Card padding with a padded lockup for full bleed.\nMedia can stand alone, follow the text, or be a custom Box. Clip only the media region."},"213":{"id":"/docs/components/card-23","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#actions","content":"`onPress` is the Card primary. Nested buttons keep their own hits, so Save does not open the\nModal. Compose a Card inside the Modal when the action is a focused form."},"214":{"id":"/docs/components/card-24","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#checkbox","content":"Standalone checkbox Cards own their state. Grouped cards belong in CheckboxGroup.\nIndicator children can render custom content from the current selection state."},"215":{"id":"/docs/components/card-25","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#radio","content":"Radio Cards require a value and live in RadioGroup, which owns selection and arrow-key movement."},"216":{"id":"/docs/components/card-26","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#layout","content":"Use Grid for responsiveness."},"217":{"id":"/docs/components/card-27","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#customization","content":"Pass non-interactive children or a selection-state render function to `CardSelectionIndicator`\nto replace its default circle and icon. See the Checkbox example. Native selection and keyboard\nbehavior are preserved."},"218":{"id":"/docs/components/card-28","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"Name a primary action with `aria-label` or `aria-labelledby`. The stretched control has no visible\nlabel of its own."},"219":{"id":"/docs/components/card-29","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"Name selection separately with `selectionProps` when the Card also has a primary action."},"220":{"id":"/docs/components/card-30","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"On a Card without a primary action or selection, `aria-label`, `aria-labelledby`, and\n`aria-describedby` apply to the surface, for example with `role=\"region\"`."},"221":{"id":"/docs/components/card-31","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"`href` turns the Card into a native link. Modifier-click, middle-click, and \"Open in new tab\" work\non the surface. Body text is not selectable. The link covers the whole Card, so do not put\nCornerActions, buttons, inputs, selection, or other controls in an `href` Card. Clicking body text\non an `onPress` or selection Card activates it; dragging that text selects it."},"222":{"id":"/docs/components/card-32","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"`isDisabled` disables only the primary. `isSelectionDisabled` disables only selection. Radio\nread-only and validation state belong on `RadioGroup`."},"223":{"id":"/docs/components/checkbox","page_id":"/docs/components/checkbox","type":"page","content":"Checkbox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/checkbox"},"224":{"id":"/docs/components/checkbox-0","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox","content":"Accessible checkbox component for multi-select options with support for indeterminate states, validation, keyboard navigation, and flexible group layouts."},"225":{"id":"/docs/components/checkbox-1","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#installation","content":"Installation"},"226":{"id":"/docs/components/checkbox-2","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#examples","content":"Examples"},"227":{"id":"/docs/components/checkbox-3","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/co