` prop controls the main axis orientation."},"2139":{"id":"/docs/components/layout/flex-21","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#alignment","content":"Use `justifyContent` for main-axis distribution and `alignItems` for cross-axis alignment."},"2140":{"id":"/docs/components/layout/flex-22","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#gap","content":"The `gap` prop controls spacing between children. Use `rowGap` and `columnGap` for independent control."},"2141":{"id":"/docs/components/layout/flex-23","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#wrap","content":"The `wrap` prop controls whether items wrap to multiple lines."},"2142":{"id":"/docs/components/layout/flex-24","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#navbar","content":"A common navigation bar pattern using space-between and nested Flex containers."},"2143":{"id":"/docs/components/layout/flex-25","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#sidebar","content":"A sidebar layout demonstrating Flex child props (`flexShrink`, `flexGrow`)."},"2144":{"id":"/docs/components/layout/flex-26","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#rtl-support","content":"Flex uses CSS logical properties which automatically adapt to RTL layouts. The `direction` prop values (`row`, `row-reverse`) respect the document direction."},"2145":{"id":"/docs/components/layout/flex-27","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#design-tokens","content":"All gap and padding values are derived from the theme. If no theme is provided, default values are used. This ensures consistency across the design system."},"2146":{"id":"/docs/components/la