onents/icon-23","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#icon-transformations","content":"Icon Transformations"},"566":{"id":"/docs/components/icon-24","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#rotation","content":"Rotation"},"567":{"id":"/docs/components/icon-25","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#flipping","content":"Flipping"},"568":{"id":"/docs/components/icon-26","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#loading-states","content":"Loading States"},"569":{"id":"/docs/components/icon-27","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#placeholder-content","content":"Placeholder Content"},"570":{"id":"/docs/components/icon-28","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#accessibility","content":"Accessibility"},"571":{"id":"/docs/components/icon-29","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#decorative-icons","content":"Decorative Icons"},"572":{"id":"/docs/components/icon-30","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#semantic-icons","content":"Semantic Icons"},"573":{"id":"/docs/components/icon-31","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#interactive-icons","content":"Interactive Icons"},"574":{"id":"/docs/components/icon-32","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#performance-considerations","content":"Performance Considerations"},"575":{"id":"/docs/components/icon-33","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#default-icon-loading","content":"Default Icon Loading"},"576":{"id":"/docs/components/icon-34","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#sprite-mode-optimization","content":"Sprite Mode Optimization"},"577":{"id":"/docs/components/icon-35","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#recommendations","content":"Recommendations"},"578":{"id":"/docs/components/icon-36","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#troubleshooting","content":"Troubleshooting"},"579":{"id":"/docs/components/icon-37","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#icon-not-loading","content":"Icon Not Loading"},"580":{"id":"/docs/components/icon-38","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#performance-issues","content":"Performance Issues"},"581":{"id":"/docs/components/icon-39","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon","content":"The `Icon` component provides a flexible and performant way to display SVG icons with extensive customization options. Built on top of the Bento Icon system, it features on-demand loading from a CDN, automatic caching, and enhanced props for the Antares design system."},"582":{"id":"/docs/components/icon-40","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**On-demand loading**: Icons are loaded asynchronously from CDN only when needed"},"583":{"id":"/docs/components/icon-41","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Automatic caching**: Once loaded, icons are cached for optimal performance"},"584":{"id":"/docs/components/icon-42","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Flexible sizing**: Support for `width` and `height` props"},"585":{"id":"/docs/components/icon-43","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Color inheritance**: Uses `currentColor` by default for seamless theme integration"},"586":{"id":"/docs/components/icon-44","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Accessibility ready**: Built-in support for screen readers and keyboard navigation"},"587":{"id":"/docs/components/icon-45","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**TypeScript support**: Fully typed with comprehensive prop interfaces"},"588":{"id":"/docs/components/icon-46","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Bento integration**: Extends Bento Icon with additional Antares-specific features"},"589":{"id":"/docs/components/icon-47","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"The component extends `BentoIconProps` and passes through all standard HTML attributes and accessibility props to the underlying Bento Icon component. This includes:"},"590":{"id":"/docs/components/icon-48","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Accessibility**: `aria-label`, `aria-describedby`, `role`, `title`"},"591":{"id":"/docs/components/icon-49","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Events**: `onClick`, `onMouseOver`, `onFocus`, etc."},"592":{"id":"/docs/components/icon-50","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Styling**: `className`, `style`, `data-*` attributes"},"593":{"id":"/docs/components/icon-51","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Transform**: `rotate`, `flip` for icon transformation