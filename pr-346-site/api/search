ble#features","content":"Supports pointer, touch, and keyboard interactions through React Aria."},"965":{"id":"/docs/components/pressable-14","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Preserves the child's layout, shape, and base visual styling while adding state feedback."},"966":{"id":"/docs/components/pressable-15","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#default","content":"Add accessible press behavior to an existing visual component without adding a wrapper element.\nThe surface supports pointer, touch, and keyboard activation."},"967":{"id":"/docs/components/pressable-16","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Pressable` when an existing visual component or layout surface needs press behavior while keeping its own DOM element, layout, and styles. The child must be a single element that forwards its ref and accepts the DOM, ARIA, and event props supplied by React Aria."},"968":{"id":"/docs/components/pressable-17","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Button` when you need a standard button control with button-specific sizing, layout, and visual variants."},"969":{"id":"/docs/components/pressable-18","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Pass `onPress` for the action instead of wiring separate pointer and keyboard handlers:"},"970":{"id":"/docs/components/pressable-19","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"`Pressable` accepts the React Aria press props, including `onPress`, `onPressStart`, `onPressEnd`, `onPressUp`, and `onPressChange`."},"971":{"id":"/docs/components/pressable-20","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Use a semantic interactive element when possible. For a non-semantic child such as `Avatar` or `Box`, provide an appropriate interactive role and an accessible name. Pressable makes the child focusable when the required props are forwarded."},"972":{"id":"/docs/components/pressable-21","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Do not add `role=\"button\"` to a native `<button>` or `<a>` unless you intentionally need to change its semantics. Use a dedicated semantic component such as `Button`, `LinkButton`, `Menu`, or `ToggleButton` when that control's meaning is known."},"973":{"id":"/docs/components/pressable-22","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Prefer a native interactive element or a semantic Antares component when the interaction meaning is known."},"974":{"id":"/docs/components/pressable-23","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Avoid nesting interactive elements inside the child passed to `Pressable`."},"975":{"id":"/docs/components/pressable-24","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"`Pressable` automatically applies React Aria state attributes such as `[data-hovered]`, `[data-pressed]`, `[data-focus-visible]`, and `[data-disabled]` to the child. Ensure the child component styles these states appropriately if it overrides the default `Pressable` styles."},"976":{"id":"/docs/components/pressable-25","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If React Aria warns that the child must be focusable, ensure it is a single element that forwards its ref, `tabIndex`, DOM props, and ARIA attributes."},"977":{"id":"/docs/components/pressable-26","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If `onPress` does not fire, confirm that the child forwards event handlers and is not disabled by another component."},"978":{"id":"/docs/components/progress-bar","page_id":"/docs/components/progress-bar","type":"page","content":"ProgressBar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/progress-bar"},"979":{"id":"/docs/components/progress-bar-0","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar","content":"A progress bar shows determinate progress of an operation over time"},"980":{"id":"/docs/components/progress-bar-1","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#installation","content":"Installation"},"981":{"id":"/docs/components/progress-bar-2","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#examples","content":"Examples"},"982":{"id":"/docs/components/progress-bar-3","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#default","content":"Default"},"983":{"id":"/docs/components/progress-bar-4","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#sizes","content":"Sizes"},"984":{"id":"/docs/components/progress-bar-5","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#statuses","content":"Statuses"},"985":{"id":"/docs/components/progress-bar-6","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#accessibility","content":"Accessibility"},"986":{"id":"/docs/components/progress-bar-7","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#aria-support","content":"ARIA Support"},"987":{"id":"/docs/components/progress-bar-8","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#props","content":"Props"},"988":{"id":"/docs/components/progress-bar-9","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#progressbar","content":"ProgressBar"},"989":{"id":"/docs/components/progress-bar-10","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#default","content":"A determinate progress bar with a label and helper text."},"990":{"id":"/docs/components/progress-bar-11","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#sizes","content":"Three track heights are available: `xs` (6px), `sm` (12px), and `md` (24px)."},"991":{"id":"/docs/components/progress-bar-12","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#statuses","content":"Use the `status` prop to communicate intent: `default`, `success`, `warning`, or `critical`. Pair with `helperText` to provide additional context."},"992":{"id":"/docs/components/progress-bar-13","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#aria-support","content":"`role=\"progressbar\"` on the container"},"993":{"id":"/docs/components/progress-bar-14","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#aria-support","content":"`aria-valuenow` reflects the current value"},"994":{"id":"/docs/components/progress-bar-15","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#aria-support","content":"`aria-valuemin` and `aria-valuemax` define the range (default `0`–`100`)"},"995":{"id":"/docs/components/progress-bar-16","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#aria-support","content":"`aria-valuetext` provides a formatted string (e.g. `\"60%\"`)"},"996":{"id":"/docs/components/progress-bar-17","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#aria-support","content":"`aria-labelledby` associates the visible label when the `label` prop is provided"},"997":{"id":"/docs/components/progress-steps","page_id":"/docs/components/progress-steps","type":"page","content":"ProgressSteps","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/progress-steps"},"998":{"id":"/docs/components/progress-steps-0","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps","content":"A multi-step progress indicator for wizard and onboarding flows."},"999":{"id":"/docs/components/progress-steps-1","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#features","content":"Features"},"1000":{"id":"/docs/components/progress-steps-2","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#installation","content":"Installation"},"1001":{"id":"/docs/components/progress-steps-3","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#examples","content":"Examples"},"1002":{"id":"/docs/components/progress-steps-4","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#default","content":"Default"},"1003":{"id":"/docs/components/progress-steps-5","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#not-started","content":"Not started"},"1004":{"id":"/docs/components/progress-steps-6","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#vertical","content":"Vertical"},"1005":{"id":"/docs/components/progress-steps-7","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#interactive","content":"Interactive"},"1006":{"id":"/docs/components/progress-steps-8","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#disabled","content":"Disabled"},"1007":{"id":"/docs/components/progress-steps-9","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#hide-step-numbers","content":"Hide Step Numbers"},"1008":{"id":"/docs/components/progress-steps-10","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#customization","content":"Customization"},"1009":{"id":"/docs/components/progress-steps-11","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#accessibility","content":"Accessibility"},"1010":{"id":"/docs/components/progress-steps-12","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#best-practices","content":"Best Practices"},"1011":{"id":"/docs/components/progress-steps-13","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#troubleshooting","content":"Troubleshooting"},"1012":{"id":"/docs/components/progress-steps-14","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#props","content":"Props"},"1013":{"id":"/docs/components/progress-steps-15","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#progresssteps","content":"ProgressSteps"},"1014":{"id":"/docs/components/progress-steps-16","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#progressstep","content":"ProgressStep"},"1015":{"id":"/docs/components/progress-steps-17","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Horizontal and vertical orientations"},"1016":{"id":"/docs/components/progress-steps-18","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Four completion statuses (`none`, `partial`, `complete`, `error`) with status icons"},"1017":{"id":"/docs/components/progress-steps-19","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Timeline (past / current / future) derived from a single `currentStep` prop"},"1018":{"id":"/docs/components/progress-steps-20","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Auto-generated step numbers (opt out with `hideStepNumbers`)"},"1019":{"id":"/docs/components/progress-steps-21","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Interactive (navigable) and inert (display-only) steps"},"1020":{"id":"/docs/components/progress-steps-22","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Title truncation and RTL support"},"1021":{"id":"/docs/components/progress-steps-23","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#features","content":"Rendered as a `<nav>` landmark with an ordered list for assistive technology"},"1022":{"id":"/docs/components/progress-steps-24","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#default","content":"A horizontal stepper. `currentStep` marks the active step; earlier steps are `past`, later are `future`. Each `status` sets the step's icon, and an `error` step turns its accent bar red."},"1023":{"id":"/docs/components/progress-steps-25","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#not-started","content":"No `currentStep`: the flow hasn't started, so every step is `future` and none is marked current."},"1024":{"id":"/docs/components/progress-steps-26","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#vertical","content":"Vertical orientation: accent bar on the leading edge, steps stacked in a column."},"1025":{"id":"/docs/components/progress-steps-27","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#interactive","content":"Interactive steps: each `onPress` navigates the wizard by updating `currentStep`."},"1026":{"id":"/docs/components/progress-steps-28","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#disabled","content":"A disabled interactive step is muted, not focusable, and cannot be activated."},"1027":{"id":"/docs/components/progress-steps-29","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#hide-step-numbers","content":"Step numbers are shown by default; `hideStepNumbers` omits the \"N. \" prefix."},"1028":{"id":"/docs/components/progress-steps-30","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"Step numbers (`\"N. \"`) are prepended automatically — keep them where possible, as user testing shows people recognize the component better with them. Set `hideStepNumbers` to omit them."},"1029":{"id":"/docs/components/progress-steps-31","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"`orientation` switches between `horizontal` (accent bar on top) and `vertical` (accent bar on the leading edge)."},"1030":{"id":"/docs/components/progress-steps-32","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"`currentStep` is the single source of truth for the timeline. Omit it for a not-yet-started flow where every step is `future`; pass the step count for a fully completed flow where every step is `past`."},"1031":{"id":"/docs/components/progress-steps-33","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"`status` is independent of timeline and only controls the status icon and (for `error`) the accent bar color."},"1032":{"id":"/docs/components/progress-steps-34","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#customization","content":"Pass `className` to the container or an individual step to extend the styles."},"1033":{"id":"/docs/components/progress-steps-35","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"The container renders a `<nav>` landmark; set `aria-label` to name it (defaults to `\"Progress\"`)."},"1034":{"id":"/docs/components/progress-steps-36","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"Steps are an ordered list (`<ol>`/`<li>`) so assistive technology conveys position and count."},"1035":{"id":"/docs/components/progress-steps-37","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"The current step is marked with `aria-current=\"step\"`."},"1036":{"id":"/docs/components/progress-steps-38","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"Interactive steps are real buttons: focusable in the natural **Tab** order and activated with **Enter** or **Space**. Status icons are decorative (`aria-hidden`)."},"1037":{"id":"/docs/components/progress-steps-39","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#accessibility","content":"Focus is shown with a visible outline; disabled steps use `0.4` opacity and are not focusable."},"1038":{"id":"/docs/components/progress-steps-40","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Drive the timeline from `currentStep` rather than styling individual steps."},"1039":{"id":"/docs/components/progress-steps-41","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Provide `onPress` only for steps a user can actually navigate to; leave it off for display-only steps."},"1040":{"id":"/docs/components/progress-steps-42","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Keep titles short — they truncate with an ellipsis when space is tight."},"1041":{"id":"/docs/components/progress-steps-43","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#best-practices","content":"Always give the container an `aria-label` that describes the flow (e.g. `\"Checkout progress\"`)."},"1042":{"id":"/docs/components/progress-steps-44","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#troubleshooting","content":"**No step is highlighted:** `currentStep` is omitted, negative, or out of range. Set it to the active step's 0-based index."},"1043":{"id":"/docs/components/progress-steps-45","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#troubleshooting","content":"**A step isn't clickable:** it has no `onPress`, so it's inert by design. Add `onPress` to make it interactive."},"1044":{"id":"/docs/components/progress-steps-46","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps#troubleshooting","content":"**Titles overflow:** that's expected — titles truncate. Shorten the title."},"1045":{"id":"/docs/components/radio","page_id":"/docs/components/radio","type":"page","content":"Radio","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/radio"},"1046":{"id":"/docs/components/radio-0","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio","content":"Accessible radio button component for mutually exclusive selections with keyboard navigation, validation states, and flexible layouts."},"1047":{"id":"/docs/components/radio-1","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#installation","content":"Installation"},"1048":{"id":"/docs/components/radio-2","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#examples","content":"Examples"},"1049":{"id":"/docs/components/radio-3","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#default","content":"Default"},"1050":{"id":"/docs/components/radio-4","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#controlled","content":"Controlled"},"1051":{"id":"/docs/components/radio-5","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#horizontal-layout","content":"Horizontal Layout"},"1052":{"id":"/docs/components/radio-6","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#disabled-states","content":"Disabled States"},"1053":{"id":"/docs/components/radio-7","page_id":"/docs/compon