es for styling different states:"},"1501":{"id":"/docs/components/switch-40","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#data-attributes","content":"`data-selected`, `data-hovered`, `data-pressed`, `data-focused`, `data-focus-visible`, `data-disabled`, `data-readonly`, `data-invalid`, `data-required`, `data-size`"},"1502":{"id":"/docs/components/switch-41","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#design-tokens","content":"The track and thumb read from Antares curated tokens, falling back to legacy `--ux-*` custom properties:"},"1503":{"id":"/docs/components/switch-42","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#design-tokens","content":"Element"},"1504":{"id":"/docs/components/switch-43","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#design-tokens","content":"Token"},"1505":{"id":"/docs/components/switch-44","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#design-tokens","content":"Legacy fallback"},"1506":{"id":"/docs/components/switch-45","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#design-tokens","content":"Track (off)"},"1507":{"id":"/docs/components/switch-46","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#design-tokens","content":"—"},"1508":{"id":"/docs/components/switch-47","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#design-tokens","content":"`--ux-1m9ys0v`"},"1509":{"id":"/docs/components/switch-48","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#design-tokens","content":"Track (on)"},"1510":{"id":"/docs/components/switch-49","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#design-tokens","content":"`--color-input