llback"},"76":{"id":"/docs/components/avatar-20","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Primary, subtle, and 15 categorical figure emphases"},"77":{"id":"/docs/components/avatar-21","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Avatar Button and Account Menu compositions built with Pressable"},"78":{"id":"/docs/components/avatar-22","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#default","content":"Use an Avatar with a one- or two-character monogram when no image is available."},"79":{"id":"/docs/components/avatar-23","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#image","content":"Place Image before Text so the monogram is available while the image loads or if it fails."},"80":{"id":"/docs/components/avatar-24","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#image-fallback","content":"Include a Text fallback so an unavailable photo never leaves an empty identity marker."},"81":{"id":"/docs/components/avatar-25","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#shapes-and-sizes","content":"Use circular Avatars for people and square Avatars for organizations, workspaces, and accounts."},"82":{"id":"/docs/components/avatar-26","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#emphasis","content":"Use primary or subtle for standard treatments, and a deterministic figure emphasis to categorize entities in a list."},"83":{"id":"/docs/components/avatar-27","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#avatar-button","content":"Use `Pressable` to add accessible interaction to an Avatar while preserving its shape."},"84":{"id":"/docs/components/avatar-28","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#account-menu","content":"Wrap an Avatar in a Pressable inside MenuTrigger for an account or profile menu."},"85":{"id":"/docs/components/avatar-29","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#customization","content":"Use Image native image props for responsive image sources. Choose a deterministic `figure0` through `figure14` emphasis in lists that categorize multiple entities."},"86":{"id":"/docs/components/avatar-30","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#customization","content":"When an Avatar triggers an action, compose it with `Pressable` so the Avatar keeps its own shape and receives the interaction behavior directly. Use this pattern for an Avatar Button, or place it inside `MenuTrigger` for an Account Menu:"},"87":{"id":"/docs/components/avatar-31","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Give Image meaningful `alt` text when the image conveys an identity."},"88":{"id":"/docs/components/avatar-32","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Text remains available to assistive technology when no image loads."},"89":{"id":"/docs/components/avatar-33","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Use `alt=\"\"` on the Image and `aria-hidden=\"true\"` on the Avatar when the entire avatar is purely decorative."},"90":{"id":"/docs/components/avatar-34","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Give an Avatar Button or Account Menu an accessible name with `aria-label` or `aria-labelledby`."},"91":{"id":"/docs/components/avatar-35","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"When using `Pressable`, provide an interactive role for the non-semantic Avatar child."},"92":{"id":"/docs/components/avatar-36","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use Avatar for informational identity; compose it with `Pressable` for an Avatar Button or Account Menu when it is independently actionable."},"93":{"id":"/docs/components/avatar-37","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use circle for people and square for businesses, workspaces, and accounts."},"94":{"id":"/docs/components/avatar-38","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Keep monograms to one or two uppercase characters."},"95":{"id":"/docs/components/avatar-39","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use the same `figure*` emphasis for the same entity wherever it appears."},"96":{"id":"/docs/components/avatar-40","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"If an image is unavailable because of a bad URL or CORS policy, Text remains visible."},"97":{"id":"/docs/components/avatar-41","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"Long Text content is clipped to the avatar shape; provide a one- or two-character monogram."},"98":{"id":"/docs/components/avatar-42","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"Figure colors repeat after 15 values; assign a deterministic figure emphasis in the consuming application."},"99":{"id":"/docs/components/button","page_id":"/docs/components/button","type":"page","content":"Button","breadcrumbs":["Docs","Com