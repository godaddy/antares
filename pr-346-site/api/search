t":"Examples"},"692":{"id":"/docs/components/label-4","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#default","content":"Default"},"693":{"id":"/docs/components/label-5","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#props","content":"Props"},"694":{"id":"/docs/components/label-6","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#label","content":"Label"},"695":{"id":"/docs/components/label-7","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#features","content":"Associates the visible name with the field control."},"696":{"id":"/docs/components/label-8","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#features","content":"Applies the label treatment, medium weight, at the surrounding\n`SizeProvider` tier. `size` and `emphasis` work as on `Text`."},"697":{"id":"/docs/components/label-9","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#features","content":"Field CSS adds the required asterisk when the field root is `isRequired`. That is not a Label prop."},"698":{"id":"/docs/components/label-10","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#default","content":"Label names a field. The required asterisk comes from Field CSS when the root is `isRequired`."},"699":{"id":"/docs/components/inline-drawer","page_id":"/docs/components/inline-drawer","type":"page","content":"InlineDrawer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/inline-drawer"},"700":{"id":"/docs/components/inline-drawer-0","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer","content":"An in-flow collapsible built on RAC Disclosure. Compose a trigger and content to make an accordion or a sidebar rail."},"701":{"id":"/docs/components/inline