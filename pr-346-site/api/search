s/calendar#accessibility","content":"Arrow keys move by day; PageUp/PageDown by month; Home/End to row edges"},"162":{"id":"/docs/components/calendar-31","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#accessibility","content":"Focus-visible outline; disabled days are not focusable"},"163":{"id":"/docs/components/calendar-32","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#accessibility","content":"Out-of-month days render at reduced opacity and are not selectable"},"164":{"id":"/docs/components/calendar-33","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#best-practices","content":"Always provide an `aria-label` on standalone calendars."},"165":{"id":"/docs/components/calendar-34","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#best-practices","content":"Use `isDateUnavailable` for scattered disabled days; use `minValue` / `maxValue` for contiguous bounds."},"166":{"id":"/docs/components/calendar-35","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#troubleshooting","content":"Dates not formatting per locale? Ensure the app is wrapped in `<I18nProvider locale=\"…\">`."},"167":{"id":"/docs/components/card","page_id":"/docs/components/card","type":"page","content":"Card","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/card"},"168":{"id":"/docs/components/card-0","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card","content":"A padded surface for composing media, content, actions, and selection."},"169":{"id":"/docs/components/card-1","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#features","content":"Features"},"170":{"id":"/docs/components/card-2","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#installation","content":"Installation"},"171":{"id":"/docs/components/card-3","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#examples","content":"Examples"},"172":{"id":"/docs/components/card-4","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#default","content":"Default"},"173":{"id":"/docs/components/card-5","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#media","content":"Media"},"174":{"id":"/docs/components/card-6","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#actions-and-navigation","content":"Actions and navigation"},"175":{"id":"/docs/components/card-7","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#selection","content":"Selection"},"176":{"id":"/docs/components/card-8","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#responsive-layout","content":"Responsive layout"},"177":{"id":"/docs/components/card-9","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#collections","content":"Collections"},"178":{"id":"/docs/components/card-10","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#accessibility","content":"Accessibility"},"179":{"id":"/docs/components/card-11","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#cardselectionindicator","content":"CardSelectionIndicator"},"180":{"id":"/docs/components/card-12","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#best-practices","content":"Best Practices"},"181":{"id":"/docs/components/card-13","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#troubleshooting","content":"Troubleshooting"},"182":{"id":"/docs/components/card-14","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#my-linked-card-contains-a-button-or-another-link","content":"My linked Card contains a button or another link"},"183":{"id":"/docs/components/card-15","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#my-media-has-unexpected-padding","content":"My media has unexpected padding"},"184":{"id":"/docs/components/card-16","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#corner-actions-overlap-long-text","content":"Corner actions overlap long text"},"185":{"id":"/docs/components/card-17","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#props","content":"Props"},"186":{"id":"/docs/components/card-18","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#features","content":"Card is a layout surface. Compose its contents with Antares layout and structure primitives. It\nsupports text-only, media-only, and mixed compositions, while the consumer chooses media order,\nsizing, orientation, and responsive behavior."},"187":{"id":"/docs/components/card-19","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#features","content":"The default Card padding and gap are `lg`. Override them with the normal layout props. Full bleed\nmedia is composed with `padding=\"0\"` and a separately padded content region; Card has no media\nbleed prop."},"188":{"id":"/docs/components/card-20","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#features","content":"Card draws its own background, border, and text color. Setting `elevation` hands that chrome to\n`Box` instead, so a raised or overlay Card looks like every other surface at that elevation."},"189":{"id":"/docs/components/card-21","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#default","content":"A composed static Card surface with heading and description."},"190":{"id":"/docs/components/card-22","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#media","content":"Use default padding for inset media, or zero padding with a padded Content for full bleed.\nMedia can stand alone, follow the text, or be a custom Box. Clip only the media region."},"191":{"id":"/docs/components/card-23","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#actions-and-navigation","content":"Use onPress for an action or href for navigation. Body text stays copyable and inner buttons act independently."},"192":{"id":"/docs/components/card-24","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#selection","content":"Control a standalone checkbox, or let CheckboxGroup and RadioGroup own selection. Add href when\nthe body should navigate and only the corner indicator should select, naming the two controls\napart with selectionProps. Omit isSelected and onSelectionChange for uncontrolled standalone\nselection, optionally setting defaultSelected."},"193":{"id":"/docs/components/card-25","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#responsive-layout","content":"Use a consumer container query to switch between vertical and horizontal layouts. The image\nfills narrow cards and takes 40% of the width when space allows."},"194":{"id":"/docs/components/card-26","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#collections","content":"Let Content grow to align bottom actions across equal-height cards. A wrapping Header reserves\nroom for always-visible CornerActions, while TextLockup coordinates each card's text."},"195":{"id":"/docs/components/card-27","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"Cards are static surfaces by default. `href` adds a primary navigation destination and `onPress`\nadds a primary action. Always provide `aria-label` or `aria-labelledby` for a Card primary action:\nthe internal action control has no visible label of its own and cannot derive its name from\narbitrary Card body content."},"196":{"id":"/docs/components/card-28","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"`Card href` renders a real, named link behind the content. Clicking ordinary body content navigates;\nbuttons, links, menus, editable content, and CornerActions keep their own behavior, including when\nnested inside `Content`. Text remains selectable and copyable. Native link menus and middle-click\nnavigation are available on the Card background; ordinary body text is not itself a native link.\nThe primary link is keyboard accessible without making the Card an interactive ancestor of its controls."},"197":{"id":"/docs/components/card-29","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"Reuse Structure's `Content`, `Header`, `Footer`, and `CornerActions` to compose the interior. Card\nsupplies region defaults through their contexts: no additional region padding, `lg` content gap,\nand visible content overflow. Explicit region props override those defaults. `Content` supports\n`as` when a different element or component is needed.\nUse `selection=\"checkbox\"` or `selection=\"radio\"` for selectable Cards. Place one\n`CardSelectionIndicator` explicitly, usually last in `CornerActions`. Card owns the selection\ncomposition and delegates state, keyboard handling, and native input behavior to React Aria."},"198":{"id":"/docs/components/card-30","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"A Card with both a primary action and selection holds two controls, so name them separately: the\nCard's own `aria-label`/`aria-labelledby` names the primary action, and `selectionProps` carries the\nname for the selection control. Without it both controls answer to the same name."},"199":{"id":"/docs/components/card-31","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"Checkbox Cards work standalone or inside the existing `CheckboxGroup`. Standalone selection uses\n`isSelected`, `defaultSelected`, and `onSelectionChange`; grouped state belongs to the group.\nRadio Cards require a `value` and the existing `RadioGroup`, which owns selection and arrow-key\nnavigation. Use `isSelectionDisabled` to disable selection independently of primary or child\nactions. `isDisabled` disables only the Card's primary action. Set `isReadOnly` on a checkbox Card\nor on its group; radio read-only behavior belongs to `RadioGroup`."},"200":{"id":"/docs/components/card-32","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"The indicator is automatically revealed on hover, focus within the Card, or selection, and remains\navailable on touch devices. Use `visibility=\"always\"` when the selected affordance should stay\nvisible at rest. Hiding its visual does not remove the underlying selection control from keyboard\nor assistive-technology access."},"201":{"id":"/docs/components/card-33","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#cardselectionindicator","content":"Place `CardSelectionIndicator` inside `CornerActions` on a selectable Card. It\nshares the native selection control's state and does not add a second keyboard focus stop."},"202":{"id":"/docs/components/card-34","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#best-practices","content":"Compose media as an ordinary child, an `Image` or a consumer-owned `Box`. Card never reads a slot\nor infers media, so its order, size, and orientation are yours. A `slot` or class on it is your own\nstyling hook, as the responsive example uses `[slot=\"media\"]` in a container query."},"203":{"id":"/docs/components/card-35","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#best-practices","content":"Use `Flex`, `Grid`, `Box`, `Content`, `Header`, `Footer`, `TextLockup`, and `ButtonGroup` to define the interior\nlayout. Keep enough width for long text and reserve CornerActions space explicitly."},"204":{"id":"/docs/components/card-36","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#best-practices","content":"For collections, give cards a shared grid or feed width, let the content region grow, and place\nbottom actions after that growing region to align actions across equal-height cards."},"205":{"id":"/docs/components/card-37","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#best-practices","content":"Use a container query in the surrounding layout when a card should stack at its available width.\nCard does not add automatic breakpoints or reorder children."},"206":{"id":"/docs/components/card-38","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#best-practices","content":"CornerActions is always visible. Use `gap`, wrapping, and explicit flexible text widths to avoid\ncollisions at narrow widths."},"207":{"id":"/docs/components/card-39","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#my-linked-card-contains-a-button-or-another-link","content":"Keep it in the composed body, including inside `Content`. Independent controls do not activate\nthe Card. Do not wrap those controls in your own anchor or button."},"208":{"id":"/docs/components/card-40","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#my-media-has-unexpected-padding","content":"Card defaults to `padding=\"lg\"` and `gap=\"lg\"`. Keep those defaults for inset media, or set\n`padding=\"0\"` and add `Content padding=\"lg\"` around mixed content for a full bleed composition."},"209":{"id":"/docs/components/card-41","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#corner-actions-overlap-long-text","content":"Card does not measure arbitrary children. Compose a `Header` or `Flex` with an explicit flexible\ntext region, `CornerActions`, and wrapping or a minimum text width appropriate for the container."},"210":{"id":"/docs/components/carousel","page_id":"/docs/components/carousel","type":"page","content":"Carousel","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/carousel"},"211":{"id":"/docs/components/carousel-0","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel","content":"The Carousel component allows users to cycle through a series of content panels (typically images, cards, or text) in a horizontal or vertical layout. It is commonly used for featured content, product showcases, or testimonials."},"212":{"id":"/docs/components/carousel-1","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#installation","content":"Installation"},"213":{"id":"/docs/components/carousel-2","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#examples","content":"Examples"},"214":{"id":"/docs/components/carousel-3","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#default","content":"Default"},"215":{"id":"/docs/components/carousel-4","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#controlled","content":"Controlled"},"216":{"id":"/docs/components/carousel-5","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#external-controls-uncontrolled","content":"External Controls (Uncontrolled)"},"217":{"id":"/docs/components/carousel-6","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#external-controls-controlled","content":"External Controls (Controlled)"},"218":{"id":"/docs/components/carousel-7","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#hide-controls","content":"Hide Controls"},"219":{"id":"/docs/components/carousel-8","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#variable-widths","content":"Variable Widths"},"220":{"id":"/docs/components/carousel-9","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#events","content":"Events"},"221":{"id":"/docs/components/carousel-10","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#rtl-direction","content":"RTL Direction"},"222":{"id":"/docs/components/carousel-11","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#props","content":"Props"},"223":{"id":"/docs/components/carousel-12","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#carousel","content":"Carousel"},"224":{"id":"/docs/components/carousel-13","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#default","content":"The default carousel is a carousel that is uncontrolled, it shows the first slide by default. You can also pass the `defaultActiveIndex` prop to the `Carousel` component to set the initial active slide index."},"225":{"id":"/docs/components/carousel-14","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#controlled","content":"The controlled carousel is a carousel that is controlled by the `activeIndex` prop."},"226":{"id":"/docs/components/carousel-15","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#external-controls-uncontrolled","content":"You can control the carousel externally by passing the `ref` prop to the `Carousel` component and using the `emblaApi` to control the carousel imperatively."},"227":{"id":"/docs/components/carousel-16","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#external-controls-controlled","content":"You can control the carousel externally by using the `activeIndex` prop to control the active slide index."},"228":{"id":"/docs/components/carousel-17","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#hide-controls","content":"The hide controls carousel is a carousel that hides the navigation controls."},"229":{"id":"/docs/components/carousel-18","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#variable-widths","content":"It supports multiple slides with different widths."},"230":{"id":"/docs/components/carousel-19","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#events","content":"You can listen to events like `onChange`, `onPrev`, or `onNext`."},"231":{"id":"/docs/components/carousel-20","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#rtl-direction","content":"The carousel follows the current **layout direction** (LTR or RTL). By default, that direction is detected automatically from the browser or system settings."},"232":{"id":"/docs/components/checkbox","page_id":"/docs/components/checkbox","type":"page","content":"Checkbox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/checkbox"},"233":{"id":"/docs/components/checkbox-0","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox","content":"Accessible checkbox component for multi-select options with support for indeterminate states, validation, keyboard navigation, and flexible group layouts."},"234":{"id":"/docs/components/checkbox-1","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#installation","content":"Installation"},"235":{"id":"/docs/components/checkbox-2","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#examples","content":"Examples"},"236":{"id":"/docs/components/checkbox-3","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#default","content":"Default"},"237":{"id":"/docs/components/checkbox-4","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#indeterminate","content":"Indeterminate"},"238":{"id":"/docs/components/checkbox-5","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkbox-group","content":"Checkbox Group"},"239":{"id":"/docs/components/checkbox-6","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#controlled","content":"Controlled"},"240":{"id":"/docs/components/checkbox-7","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#horizontal-layout","content":"Horizontal Layout"},"241":{"id":"/docs/components/checkbox-8","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#disabled-states","content":"Disabled States"},"242":{"id":"/docs/components/checkbox-9","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#required-indicator","content":"Required Indicator"},"243":{"id":"/docs/components/checkbox-10","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#invalid-state","content":"Invalid State"},"244":{"id":"/docs/components/checkbox-11","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#customization","content":"Customization"},"245":{"id":"/docs/components/checkbox-12","page