:"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#props","content":"Props"},"2113":{"id":"/docs/components/layout/flex-15","page_id":"/docs/components/layout/flex","type":"heading","tags":[],"url":"/docs/components/layout/flex#flex","content":"Flex"},"2114":{"id":"/docs/components/layout/flex-16","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex","content":"`Flex` is a one-dimensional layout component for arranging children in rows or columns with alignment and spacing control. It extends `Box`, inheriting all `Box` capabilities (padding, elevation, rounding, self-alignment, and polymorphic `as` prop)."},"2115":{"id":"/docs/components/layout/flex-17","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex","content":"**Recommended default**: Use `Flex` for most layouts. Since it extends `Box`, you get all `Box` capabilities without needing to nest components."},"2116":{"id":"/docs/components/layout/flex-18","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#scale-sizes","content":"We use the same scale sizes as the `Box` component."},"2117":{"id":"/docs/components/layout/flex-19","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#default","content":"Basic horizontal flex layout with gap."},"2118":{"id":"/docs/components/layout/flex-20","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#direction","content":"The `direction` prop controls the main axis orientation."},"2119":{"id":"/docs/components/layout/flex-21","page_id":"/docs/components/layout/flex","tags":[],"type":"text","url":"/docs/components/layout/flex#alignment","content":"Use `justifyContent` for main-axis distribution and `alignItems` for cross-axis alignment."},"2120":{"id":"/docs/components/layout/flex-22","page_id":"