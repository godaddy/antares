s/components/calendar-22","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#working-with-dates","content":"`Calendar` values are `CalendarDate` objects. Import the date primitives you need from the `@godaddy/antares/date` subpath:"},"206":{"id":"/docs/components/calendar-23","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#working-with-dates","content":"`@godaddy/antares/date` re-exports `@internationalized/date`, the package behind these date primitives."},"207":{"id":"/docs/components/calendar-24","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#default","content":"A single-date calendar."},"208":{"id":"/docs/components/calendar-25","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#with-value","content":"A calendar with a pre-selected date."},"209":{"id":"/docs/components/calendar-26","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#range","content":"Selecting a start and end date."},"210":{"id":"/docs/components/calendar-27","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#min--max","content":"Bounding selectable dates."},"211":{"id":"/docs/components/calendar-28","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#unavailable","content":"Disabling scattered individual dates with `isDateUnavailable`."},"212":{"id":"/docs/components/calendar-29","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#disabled","content":"A fully disabled calendar."},"213":{"id":"/docs/components/calendar-30","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#accessibility","content":"Arrow keys move by day; PageUp/PageDown by month; Home/End to row edges"},"214":{"id":"/docs/components/calendar-31","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#accessibility","content":"Focus-visible outline; disabled days are not focusable"},"215":{"id":"/docs/components/calendar-32","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#accessibility","content":"Out-of-month days render at reduced opacity and are not selectable"},"216":{"id":"/docs/components/calendar-33","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#best-practices","content":"Always provide an `aria-label` on standalone calendars."},"217":{"id":"/docs/components/calendar-34","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#best-practices","content":"Use `isDateUnavailable` for scattered disabled days; use `minValue` / `maxValue` for contiguous bounds."},"218":{"id":"/docs/components/calendar-35","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#troubleshooting","content":"Dates not formatting per locale? Ensure the app is wrapped in `<I18nProvider locale=\"…\">`."},"219":{"id":"/docs/components/card","page_id":"/docs/components/card","type":"page","content":"Card","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/card"},"220":{"id":"/docs/components/card-0","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card","content":"A surface that groups related content and actions."},"221":{"id":"/docs/components/card-1","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#installation","content":"Installation"},"222":{"id":"/docs/components/card-2","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#examples","content":"Examples"},"223":{"id":"/docs/components/card-3","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#default","content":"Default"},"224":{"id":"/docs/components/card-4","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#text-lockup","content":"Text lockup"},"225":{"id":"/docs/components/card-5","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#corner-actions","content":"Corner actions"},"226":{"id":"/docs/components/card-6","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#link","content":"Link"},"227":{"id":"/docs/components/card-7","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#grouped-links","content":"Grouped links"},"228":{"id":"/docs/components/card-8","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#media","content":"Media"},"229":{"id":"/docs/components/card-9","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#actions","content":"Actions"},"230":{"id":"/docs/components/card-10","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#multiple-selection","content":"Multiple selection"},"231":{"id":"/docs/components/card-11","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#single-selection","content":"Single selection"},"232":{"id":"/docs/components/card-12","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#disabled","content":"Disabled"},"233":{"id":"/docs/components/card-13","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#layout","content":"Layout"},"234":{"id":"/docs/components/card-14","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#customization","content":"Customization"},"235":{"id":"/docs/components/card-15","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#accessibility","content":"Accessibility"},"236":{"id":"/docs/components/card-16","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#props","content":"Props"},"237":{"id":"/docs/components/card-17","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#card","content":"Card"},"238":{"id":"/docs/components/card-18","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#cardgroup","content":"CardGroup"},"239":{"id":"/docs/components/card-19","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#cardselectionindicator","content":"CardSelectionIndicator"},"240":{"id":"/docs/components/card-20","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card","content":"Card groups related content, like media, text, and actions, on a single surface. On its own, a Card\nis a static surface, or a link when you pass `href`. Put Cards in a `CardGroup` to make them\nselectable or to give them an action: the group owns selection, row actions, focus, and arrow-key\nnavigation."},"241":{"id":"/docs/components/card-21","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#default","content":"A static Card just renders its children."},"242":{"id":"/docs/components/card-22","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#text-lockup","content":"Compose Card with TextLockup for eyebrow, title, and body."},"243":{"id":"/docs/components/card-23","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#corner-actions","content":"Direct CornerActions sit at the top-end of the Card."},"244":{"id":"/docs/components/card-24","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#link","content":"`href` renders the Card itself as a native link, so layered content like an elevated Box stays\nclickable. The link takes its name from its content unless you pass `aria-label`. Do not nest\ncontrols in a link Card."},"245":{"id":"/docs/components/card-25","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#grouped-links","content":"Linked Cards in a CardGroup navigate on a press or Enter. Arrow keys move between rows, and\nnested controls keep their own actions. Disable a Card to prevent its navigation."},"246":{"id":"/docs/components/card-26","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#media","content":"Use default padding for inset media, or zero Card padding with a padded lockup for full bleed.\nMedia can stand alone, follow the text, or be a custom Box. Clip only the media region."},"247":{"id":"/docs/components/card-27","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#actions","content":"Inside a CardGroup, `onAction` runs when the row is pressed or activated with Enter. Nested\nbuttons keep their own presses, so Save does not open the Modal. Compose a Card inside the Modal\nwhen the action is a focused form."},"248":{"id":"/docs/components/card-28","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#multiple-selection","content":"`selectionMode=\"multiple\"` lets each Card toggle on its own. CardSelectionIndicator shows the\nstate, and its children can render custom content from it. Nested buttons keep their own presses."},"249":{"id":"/docs/components/card-29","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#single-selection","content":"`selectionMode=\"single\"` keeps one Card selected at a time. Arrow keys move between Cards, and\nSpace selects the focused one."},"250":{"id":"/docs/components/card-30","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#disabled","content":"`isDisabled` fades the Card. A disabled link Card does not navigate, and a disabled Card in a\nCardGroup cannot be selected, run its action, or take focus. `disabledKeys` on the group does\nthe same by key."},"251":{"id":"/docs/components/card-31","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#layout","content":"Use Grid for responsiveness."},"252":{"id":"/docs/components/card-32","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#customization","content":"`CardSelectionIndicator` only shows a Card's selection state. The `CardGroup` owns selection, so a\nCard stays selectable without an indicator. Pass non-interactive children or a selection-state\nrender function to replace the default circle and icon. See the Multiple selection example."},"253":{"id":"/docs/components/card-33","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#customization","content":"Card link options such as `target`, `rel`, `download`, and `routerOptions` apply to both standalone\nlinks and linked rows in a `CardGroup`. A `CardGroup` ref points to its collection surface."},"254":{"id":"/docs/components/card-34","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#customization","content":"To style a Card by state, target `[data-selected]`, `[data-hovered]`, `[data-pressed]`,\n`[data-focus-visible]`, and `[data-disabled]` from your `className`."},"255":{"id":"/docs/components/card-35","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"A `CardGroup` is a grid: each Card is a row, Tab moves into and out of the group, and arrow keys\nmove between Cards. Name the group with `aria-label` or `aria-labelledby`. Each Card takes its\naccessible name from `textValue`, which also drives typeahead. Plain-text children supply it by\ndefault, so set `textValue` when a Card's content is composed."},"256":{"id":"/docs/components/card-36","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"In a selectable group, Space toggles the focused Card. Without selection, `onAction` runs on Enter\nor a press. Do not combine them: with both, a press runs the action and only Space selects, so\npointer users cannot select."},"257":{"id":"/docs/components/card-37","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"Use Antares controls such as `Button`, `LinkButton`, and `Checkbox` inside a grouped Card. React\nAria keeps their presses independent of row selection and actions. For a custom press target,\nuse `Pressable` and forward its props and ref to the target."},"258":{"id":"/docs/components/card-38","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"Set `keyboardNavigationBehavior=\"tab\"` on `CardGroup` to move through controls within a row with\nTab. Native controls follow React Aria's event propagation rules."},"259":{"id":"/docs/components/card-39","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"A `CardGroup` does not submit form values. Read the selection from `onSelectionChange`."},"260":{"id":"/docs/components/card-40","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"`href` on a standalone Card renders the Card itself as a native link, named by its content unless\nyou pass `aria-label`. A link Card cannot contain controls, so do not put CornerActions, buttons,\nor inputs in it. Inside a `CardGroup`, `href` navigates from the row instead."},"261":{"id":"/docs/components/card-41","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"`isDisabled` fades the Card. On a link Card it stops navigation. In a `CardGroup` it also stops\nselection, the action, and focus, as does listing the Card's `id` in `disabledKeys`."},"262":{"id":"/docs/components/card-42","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"On a static Card, `aria-label`, `aria-labelledby`, and `aria-describedby` apply to the surface,\nfor example with `role=\"region\"`."},"263":{"id":"/docs/components/carousel","page_id":"/docs/components/carousel","type":"page","content":"Carousel","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/carousel"},"264":{"id":"/docs/components/carousel-0","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel","content":"The Carousel component allows users to cycle through a series of content panels (typically images, cards, or text) in a horizontal or vertical layout. It is commonly used for featured content, product showcases, or testimonials."},"265":{"id":"/docs/components/carousel-1","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#installation","content":"Installation"},"266":{"id":"/docs/components/carousel-2","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#examples","content":"Examples"},"267":{"id":"/docs/components/carousel-3","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#default","content":"Default"},"268":{"id":"/docs/components/carousel-4","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#controlled","content":"Controlled"},"269":{"id":"/docs/components/carousel-5","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#external-controls-uncontrolled","content":"External Controls (Uncontrolled)"},"270":{"id":"/docs/components/carousel-6","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#external-controls-controlled","content":"External Controls (Controlled)"},"271":{"id":"/docs/components/carousel-7","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#hide-controls","content":"Hide Controls"},"272":{"id":"/docs/components/carousel-8","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#variable-widths","content":"Variable Widths"},"273":{"id":"/docs/components/carousel-9","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#events","content":"Events"},"274":{"id":"/docs/components/carousel-10","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#rtl-direction","content":"RTL Direction"},"275":{"id":"/docs/components/carousel-11","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#props","content":"Props"},"276":{"id":"/docs/components/carousel-12","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#carousel","content":"Carousel"},"277":{"id":"/docs/components/carousel-13","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#default","content":"The default carousel is a carousel that is uncontrolled, it shows the first slide by default. You can also pass the `defaultActiveIndex` prop to the `Carousel` component to set the initial active slide index."},"278":{"id":"/docs/components/carousel-14","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#controlled","content":"The controlled carousel is a carousel that is controlled by the `activeIndex` prop."},"279":{"id":"/docs/components/carousel-15","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#external-controls-uncontrolled","content":"You can control the carousel externally by passing the `ref` prop to the `Carousel` component and using the `emblaApi` to control the carousel imperatively."},"280":{"id":"/docs/components/carousel-16","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#external-controls-controlled","content":"You can control the carousel externally by using the `activeIndex` prop to control the active slide index."},"281":{"id":"/docs/components/carousel-17","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#hide-controls","content":"The hide controls carousel is a carousel that hides the navigation controls."},"282":{"id":"/docs/components/carousel-18","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#variable-widths","content":"It supports multiple slides with different widths."},"283":{"id":"/docs/components/carousel-19","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#events","content":"You can listen to events like `onChange`, `onPrev`, or `onNext`."},"284":{"id":"/docs/components/carousel-20","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#rtl-direction","content":"The carousel follows the current **layout direction** (LTR or RTL). By default, that direction is detected automatically from the browser or system settings."},"285":{"id":"/docs/components/chip","page_id":"/docs/components/chip","type":"page","content":"Chip","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/chip"},"286":{"id":"/docs/components/chip-0","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip","content":"Grouped pill-shaped items for selecting values and removing user-added filters or tokens."},"287":{"id":"/docs/components/chip-1","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#features","content":"Features"},"288":{"id":"/docs/components/chip-2","page_id":"/docs/components/chip","type":"heading","tags":[],"url"