. To anchor a popover to an element it doesn't wrap, pass `triggerRef` instead."},"930":{"id":"/docs/components/popover-14","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#default","content":"Use it with `<PopoverTrigger>`, which wraps both the popover content and an interactive trigger element (for example, a `Button`)."},"931":{"id":"/docs/components/popover-15","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#custom-anchor","content":"To position a popover relative to a different element than its trigger, use the `triggerRef` and `isOpen` props instead of `<PopoverTrigger>`. `onOpenChange` is called when the user opens or closes the popover."},"932":{"id":"/docs/components/popover-16","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#title-and-close-button","content":"Add a `Heading slot=\"title\"` and a `CloseButton` for a titled, dismissible popover. The heading\nalso gives the dialog its accessible name."},"933":{"id":"/docs/components/popover-17","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Key"},"934":{"id":"/docs/components/popover-18","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Action"},"935":{"id":"/docs/components/popover-19","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"`Enter/Space`"},"936":{"id":"/docs/components/popover-20","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Opens the popover from its trigger"},"937":{"id":"/docs/components/popover-21","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"`Escape`"},"938":{"id":"/docs/components/popover-22","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Closes the popover"},"939":{"id":"/docs/components/popover-23","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#aria","content":"`role=\"dialog\"` is applied automatically by the underlying React Aria `Dialog`"},"940":{"id":"/docs/components/popover-24","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#aria","content":"A `Heading slot=\"title\"` labels the dialog via `aria-labelledby`. Without one, a popover inside\na `PopoverTrigger` falls back to being labelled by its trigger; standing alone with\n`triggerRef` it needs an explicit `aria-label`"},"941":{"id":"/docs/components/popover-25","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#best-practices","content":"Pass an `aria-label` when anchoring with `triggerRef` instead of wrapping a `PopoverTrigger`,\nsince there is no trigger to borrow the name from."},"942":{"id":"/docs/components/popover-26","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#best-practices","content":"Popover width is determined by its content, and it's recommended to keep it under 400px."},"943":{"id":"/docs/components/pressable","page_id":"/docs/components/pressable","type":"page","content":"Pressable","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pressable"},"944":{"id":"/docs/components/pressable-0","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable","content":"A wrapperless interaction primitive that adds accessible press behavior to a single child element."},"945":{"id":"/docs/components/pressable-1","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#features","content":"Features"},"946":{"id":"/docs/components/pressable-2","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#installation","content":"Installation"},"947":{"id":"/docs/components/pressable-3","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#examples","content":"Examples"},"948":{"id":"/docs/components/pressable-4","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#default","content":"Default"},"949":{"id":"/docs/components/pressable-5","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#customization","content":"Customization"},"950":{"id":"/docs/components/pressable-6","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#accessibility","content":"Accessibility"},"951":{"id":"/docs/components/pressable-7","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#best-practices","content":"Best Practices"},"952":{"id":"/docs/components/pressable-8","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#troubleshooting","content":"Troubleshooting"},"953":{"id":"/docs/components/pressable-9","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#props","content":"Props"},"954":{"id":"/docs/components/pressable-10","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#pressable","content":"Pressable"},"955":{"id":"/docs/components/pressable-11","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Adds accessible press behavior to an existing visual component."},"956":{"id":"/docs/components/pressable-12","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Applies interaction states directly to the child without adding a wrapper element."},"957":{"id":"/docs/components/pressable-13","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Supports pointer, touch, and keyboard interactions through React Aria."},"958":{"id":"/docs/components/pressable-14","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Preserves the child's layout, shape, and base visual styling while adding state feedback."},"959":{"id":"/docs/components/pressable-15","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#default","content":"Add accessible press behavior to an existing visual component without adding a wrapper element.\nThe surface supports pointer, touch, and keyboard activation."},"960":{"id":"/docs/components/pressable-16","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Pressable` when an existing visual component or layout surface needs press behavior while keeping its own DOM element, layout, and styles. The child must be a single element that forwards its ref and accepts the DOM, ARIA, and event props supplied by React Aria."},"961":{"id":"/docs/components/pressable-17","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Button` when you need a standard button control with button-specific sizing, layout, and visual variants."},"962":{"id":"/docs/components/pressable-18","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Pass `onPress` for the action instead of wiring separate pointer and keyboard handlers:"},"963":{"id":"/docs/components/pressable-19","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"`Pressable` accepts the React Aria press props, including `onPress`, `onPressStart`, `onPressEnd`, `onPressUp`, and `onPressChange`."},"964":{"id":"/docs/components/pressable-20","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Use a semantic interactive element when possible. For a non-semantic child such as `Avatar` or `Box`, provide an appropriate interactive role and an accessible name. Pressable makes the child focusable when the required props are forwarded."},"965":{"id":"/docs/components/pressable-21","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Do not add `role=\"button\"` to a native `<button>` or `<a>` unless you intentionally need to change its semantics. Use a dedicated semantic component such as `Button`, `LinkButton`, `Menu`, or `ToggleButton` when that control's meaning is known."},"966":{"id":"/docs/components/pressable-22","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Prefer a native interactive element or a semantic Antares component when the interaction meaning is known."},"967":{"id":"/docs/components/pressable-23","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Avoid nesting interactive elements inside the child passed to `Pressable`."},"968":{"id":"/docs/components/pressable-24","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"`Pressable` automatically applies React Aria state attributes such as `[data-hovered]`, `[data-pressed]`, `[data-focus-visible]`, and `[data-disabled]` to the child. Ensure the child component styles these states appropriately if it overrides the default `Pressable` styles."},"969":{"id":"/docs/components/pressable-25","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If React Aria warns that the child must be focusable, ensure it is a single element that forwards its ref, `tabIndex`, DOM props, and ARIA attributes."},"970":{"id":"/docs/components/pressable-26","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If `onPress` does not fire, confirm that the child forwards event handlers and is not disabled by another component."},"971":{"id":"/docs/components/progress-bar","page_id":"/docs/components/progress-bar","type":"page","content":"ProgressBar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/progress-bar"},"972":{"id":"/docs/components/progress-bar-0","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar","content":"A progress bar shows determinate progress of an operation over time"},"973":{"id":"/docs/components/progress-bar-1","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#installation","content":"Installation"},"974":{"id":"/docs/components/progress-bar-2","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#examples","content":"Examples"},"975":{"id":"/docs/components/progress-bar-3","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#default","content":"Default"},"976":{"id":"/docs/components/progress-bar-4","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#sizes","content":"Sizes"},"977":{"id":"/docs/components/progress-bar-5","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#statuses","content":"Statuses"},"978":{"id":"/docs/components/progress-bar-6","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-