rd","type":"heading","tags":[],"url":"/docs/components/card#installation","content":"Installation"},"188":{"id":"/docs/components/card-2","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#examples","content":"Examples"},"189":{"id":"/docs/components/card-3","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#default","content":"Default"},"190":{"id":"/docs/components/card-4","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#text-lockup","content":"Text lockup"},"191":{"id":"/docs/components/card-5","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#corner-actions","content":"Corner actions"},"192":{"id":"/docs/components/card-6","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#link","content":"Link"},"193":{"id":"/docs/components/card-7","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#grouped-links","content":"Grouped links"},"194":{"id":"/docs/components/card-8","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#media","content":"Media"},"195":{"id":"/docs/components/card-9","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#actions","content":"Actions"},"196":{"id":"/docs/components/card-10","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#multiple-selection","content":"Multiple selection"},"197":{"id":"/docs/components/card-11","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#single-selection","content":"Single selection"},"198":{"id":"/docs/components/card-12","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#disabled","content":"Disabled"},"199":{"id":"/docs/components/card-13","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#layout","content":"Layout"},"200":{"id":"/docs/components/card-14","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#customization","content":"Customization"},"201":{"id":"/docs/components/card-15","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#accessibility","content":"Accessibility"},"202":{"id":"/docs/components/card-16","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#props","content":"Props"},"203":{"id":"/docs/components/card-17","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#card","content":"Card"},"204":{"id":"/docs/components/card-18","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#cardgroup","content":"CardGroup"},"205":{"id":"/docs/components/card-19","page_id":"/docs/components/card","type":"heading","tags":[],"url":"/docs/components/card#cardselectionindicator","content":"CardSelectionIndicator"},"206":{"id":"/docs/components/card-20","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card","content":"Card groups related content, like media, text, and actions, on a single surface. On its own, a Card\nis a static surface, or a link when you pass `href`. Put Cards in a `CardGroup` to make them\nselectable or to give them an action: the group owns selection, row actions, focus, and arrow-key\nnavigation."},"207":{"id":"/docs/components/card-21","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#default","content":"A static Card just renders its children."},"208":{"id":"/docs/components/card-22","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#text-lockup","content":"Compose Card with TextLockup for eyebrow, title, and body."},"209":{"id":"/docs/components/card-23","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#corner-actions","content":"Direct CornerActions sit at the top-end of the Card."},"210":{"id":"/docs/components/card-24","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#link","content":"`href` renders the Card itself as a native link, so layered content like an elevated Box stays\nclickable. The link takes its name from its content unless you pass `aria-label`. Do not nest\ncontrols in a link Card."},"211":{"id":"/docs/components/card-25","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#grouped-links","content":"Open a domain's settings by pressing its Card or Enter. Toggle auto-renew or manage DNS without\nopening the Card. Arrow keys move between domains, skipping the domain being transferred."},"212":{"id":"/docs/components/card-26","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#media","content":"Use default padding for inset media, or zero Card padding with a padded lockup for full bleed.\nMedia can stand alone, follow the text, or be a custom Box. Clip only the media region."},"213":{"id":"/docs/components/card-27","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#actions","content":"Inside a CardGroup, `onAction` runs when the row is pressed or activated with Enter. Nested\nbuttons keep their own presses, so Save does not open the Modal. Compose a Card inside the Modal\nwhen the action is a focused form."},"214":{"id":"/docs/components/card-28","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#multiple-selection","content":"`selectionMode=\"multiple\"` lets each Card toggle on its own. CardSelectionIndicator shows the\nstate, and its children can render custom content from it. Nested buttons keep their own presses."},"215":{"id":"/docs/components/card-29","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#single-selection","content":"`selectionMode=\"single\"` keeps one Card selected at a time. Arrow keys move between Cards, and\nSpace selects the focused one."},"216":{"id":"/docs/components/card-30","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#disabled","content":"`isDisabled` fades the Card. A disabled link Card does not navigate, and a disabled Card in a\nCardGroup cannot be selected, run its action, or take focus. `disabledKeys` on the group does\nthe same by key."},"217":{"id":"/docs/components/card-31","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#layout","content":"Use Grid for responsiveness."},"218":{"id":"/docs/components/card-32","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#customization","content":"`CardSelectionIndicator` only shows a Card's selection state. The `CardGroup` owns selection, so a\nCard stays selectable without an indicator. Pass non-interactive children or a selection-state\nrender function to replace the default circle and icon. See the Multiple selection example."},"219":{"id":"/docs/components/card-33","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#customization","content":"Card link options such as `target`, `rel`, `download`, and `routerOptions` apply to both standalone\nlinks and linked rows in a `CardGroup`. A `CardGroup` ref points to its collection surface. Card ids\naccept strings or numbers; numeric keys keep their type in group selection and become strings on\nstandalone DOM elements."},"220":{"id":"/docs/components/card-34","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#customization","content":"To style a Card by state, target `[data-selected]`, `[data-hovered]`, `[data-pressed]`,\n`[data-focus-visible]`, and `[data-disabled]` from your `className`."},"221":{"id":"/docs/components/card-35","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"A `CardGroup` is a grid: each Card is a row, Tab moves into and out of the group, and arrow keys\nmove between Cards. Name the group with `aria-label` or `aria-labelledby`. Each Card takes its\naccessible name from `textValue`, which also drives typeahead. Plain-text children supply it by\ndefault, so set `textValue` when a Card's content is composed."},"222":{"id":"/docs/components/card-36","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"In a selectable group, Space toggles the focused Card. Without selection, `onAction` runs on Enter\nor a press. Do not combine them: with both, a press runs the action and only Space selects, so\npointer users cannot select."},"223":{"id":"/docs/components/card-37","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"Use Antares controls such as `Button`, `LinkButton`, and `Checkbox` inside a grouped Card. React\nAria keeps their presses independent of row selection and actions. For a custom press target,\nuse `Pressable` and forward its props and ref to the target."},"224":{"id":"/docs/components/card-38","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"Set `keyboardNavigationBehavior=\"tab\"` on `CardGroup` to move through controls within a row with\nTab. Native controls follow React Aria's event propagation rules."},"225":{"id":"/docs/components/card-39","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"A `CardGroup` does not submit form values. Read the selection from `onSelectionChange`."},"226":{"id":"/docs/components/card-40","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"`href` on a standalone Card renders the Card itself as a native link, named by its content unless\nyou pass `aria-label`. A link Card cannot contain controls, so do not put CornerActions, buttons,\nor inputs in it. Inside a `CardGroup`, `href` navigates from the row instead."},"227":{"id":"/docs/components/card-41","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"`isDisabled` fades the Card. On a link Card it stops navigation. In a `CardGroup` it also stops\nselection, the action, and focus, as does listing the Card's `id` in `disabledKeys`."},"228":{"id":"/docs/components/card-42","page_id":"/docs/components/card","tags":[],"type":"text","url":"/docs/components/card#accessibility","content":"On a static Card, `aria-label`, `aria-labelledby`, and `aria-describedby` apply to the surface,\nfor example with `role=\"region\"`."},"229":{"id":"/docs/components/button","page_id":"/docs/components/button","type":"page","content":"Button","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/button"},"230":{"id":"/docs/components/button-0","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"The Button component allows users to initiate actions or submit forms with a single click"},"231":{"id":"/docs/components/button-1","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#installation","content":"Installation"},"232":{"id":"/docs/components/button-2","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#examples","content":"Examples"},"233":{"id":"/docs/components/button-3","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#default","content":"Default"},"234":{"id":"/docs/components/button-4","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#primary","content":"Primary"},"235":{"id":"/docs/components/button-5","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#secondary","content":"Secondary"},"236":{"id":"/docs/components/button-6","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#tertiary","content":"Tertiary"},"237":{"id":"/docs/components/button-7","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#critical","content":"Critical"},"238":{"id":"/docs/components/button-8","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#disabled","content":"Disabled"},"239":{"id":"/docs/components/button-9","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#icon","content":"Icon"},"240":{"id":"/docs/components/button-10","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#icons-and-alignment","content":"Icons And Alignment"},"241":{"id":"/docs/components/button-11","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#inline","content":"Inline"},"242":{"id":"/docs/components/button-12","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#minimal","content":"Minimal"},"243":{"id":"/docs/components/button-13","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#sizes","content":"Sizes"},"244":{"id":"/docs/components/button-14","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#props","content":"Props"},"245":{"id":"/docs/components/button-15","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#button","content":"Button"},"246":{"id":"/docs/components/button-16","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#linkbutton","content":"LinkButton"},"247":{"id":"/docs/components/button-17","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#closebutton","content":"CloseButton"},"248":{"id":"/docs/components/button-18","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use the `LinkButton` component instead when you need navigation functionality with a button-like appearance."},"249":{"id":"/docs/components/button-19","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use `target=\"_blank\"` to open a link in a new tab without an icon. `isExternal` adds an icon and defaults\nto `target=\"_blank\"` and `rel=\"noopener noreferrer\"`; explicit `target` and `rel` override those defaults.\nYou can also compose an `Icon` as a child independently of navigation behavior."},"250":{"id":"/docs/components/button-20","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use the `CloseButton` preset to dismiss an overlay (such as a `Modal`). It defaults to `slot=\"close\"`, so it picks up the overlay's close behavior with no wiring, and always renders an `x` icon with `aria-label=\"Close\"`. For a labelled dismiss action (e.g. \"Cancel\"), use a raw `<Button slot=\"close\">Cancel</Button>`."},"251":{"id":"/docs/components/button-21","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Inside a field `Group`, `slot=\"control\"` and `slot=\"trigger\"` pick up the matching look, size, and\ndisabled state from context. See TextField for control affixes, and Select or DatePicker for trigger faces.\nThe `control` and `trigger` variants are field parts: the field sizes them, so use them only inside a field."},"252":{"id":"/docs/components/button-22","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#default","content":"The default/tertiary button is the base for all other buttons in the system. It provides no significant visual treatment other than to provide indication for the user to take a common action."},"253":{"id":"/docs/components/button-23","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#primary","content":"The primary button should be used to indicate the most important action for the user to take in their current experience."},"254":{"id":"/docs/components/button-24","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#secondary","content":"The secondary button indicates an action of secondary importance."},"255":{"id":"/docs/components/button-25","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#tertiary","content":"The tertiary button is the default, low-emphasis style used for common, non-critical actions."},"256":{"id":"/docs/components/button-26","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#critical","content":"The critical button signifies to the user a destructive action will take place."},"257":{"id":"/docs/components/button-27","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#disabled","content":"Any button variant can be disabled to prevent interaction, communicated with reduced opacity and a not-allowed cursor."},"258":{"id":"/docs/components/button-28","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#icon","content":"You may provide an optional `Icon` component to the button. Wrap the text beside an icon in a `Text`. If you do not include text, you must provide an aria-label attribute to identify the purpose of the button. This will produce a square button."},"259":{"id":"/docs/components/button-29","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#icons-and-alignment","content":"Control navigation with `target` and `rel`, and compose icons independently. Stretched inline content follows the browser's default alignment; other variants stay centered."},"260":{"id":"/docs/components/button-30","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#inline","content":"The inline button sits within a run of text, styled like a link while retaining button semantics."},"261":{"id":"/docs/components/button-31","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#minimal","content":"The minimal button is an icon-only button that's used when space is limited and/or when the action is universally understood."},"262":{"id":"/docs/components/button-32","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#sizes","content":"Buttons come in small, medium, and large sizes to fit different layout densities. Without\n`size`, a button follows the surrounding size scope, and uses medium outside any scope. An\nicon-only button is square and as tall as a text button of the same size."},"263":{"id":"/docs/components/carousel","page_id":"/docs/components/carousel","type":"page","content":"Carousel","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/carousel"},"264":{"id":"/docs/components/carousel-0","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel","content":"The Carousel component allows users to cycle through a series of content panels (typically images, cards, or text) in a horizontal or vertical layout. It is commonly used for featured content, product showcases, or testimonials."},"265":{"id":"/docs/components/carousel-1","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#installation","content":"Installation"},"266":{"id":"/docs/components/carousel-2","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#examples","content":"Examples"},"267":{"id":"/docs/components/carousel-3","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#default","content":"Default"},"268":{"id":"/docs/components/carousel-4","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#controlled","content":"Controlled"},"269":{"id":"/docs/components/carousel-5","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#external-controls-uncontrolled","content":"External Controls (Uncontrolled)"},"270":{"id":"/docs/components/carousel-6","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#external-controls-controlled","content":"External Controls (Controlled)"},"271":{"id":"/docs/components/carousel-7","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#hide-controls","content":"Hide Controls"},"272":{"id":"/docs/components/carousel-8","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#variable-widths","content":"Variable Widths"},"273":{"id":"/docs/components/carousel-9","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#events","content":"Events"},"274":{"id":"/docs/components/carousel-10","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#rtl-direction","content":"RTL Direction"},"275":{"id":"/docs/components/carousel-11","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#props","content":"Props"},"276":{"id":"/docs/components/carousel-12","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#carousel","content":"Carousel"},"277":{"id":"/docs/components/carousel-13","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#default","content":"The default carousel is a carousel that is uncontrolled, it shows the first slide by default. You can also pass the `defaultActiveIndex` prop to the `Carousel` component to set the initial active slide index."},"278":{"id":"/docs/components/carousel-14","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#controlled","content":"The controlled carousel is a carousel that is controlled by the `activeIndex` prop."},"279":{"id":"/docs/components/carousel-15","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#external-controls-uncontrolled","content":"You can control the carousel externally by passing the `ref` prop to the `Carousel` component and using the `emblaApi` to control the carousel imperatively."},"280":{"id":"/docs/components/carousel-16","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#external-controls-controlled","content":"You can control the carousel externally by using the `activeIndex` prop to control the active slide index."},"281":{"id":"/docs/components/carousel-17","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#hide-controls","content":"The hide controls carousel is a carousel that hides the navigation controls."},"282":{"id":"/docs/components/carousel-18","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#variable-widths","content":"It supports multiple slides with different widths."},"283":{"id":"/docs/components/carousel-19","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#events","content":"You can listen to events like `onChange`, `onPrev`, or `onNext`."},"284":{"id":"/docs/components/carousel-20","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel#rtl-direction","content":"The carousel follows the current **layout direction** (LTR or RTL). By default, that direction is detected automatically from the browser or system settings."},"285":{"id":"/docs/components/checkbox","page_id":"/docs/components/checkbox","type":"page","content":"Checkbox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/checkbox"},"286":{"id":"/docs/components/checkbox-0","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox","content":"Accessible checkbox component for multi-select options with support for indeterminate states, validation, keyboard navigation, and flexible group layouts."},"287":{"id":"/docs/components/checkbox-1","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#installation","content":"Installation"},"288":{"id":"/docs/components/checkbox-2","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#examples","content":"Examples"},"289":{"id":"/docs/components/checkbox-3","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#default","content":"Default"},"290":{"id":"/docs/components/checkbox-4","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#indeterminate","content":"Indeterminate"},"291":{"id":"/docs/components/checkbox-5","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkbox-group","content":"Checkbox Group"},"292":{"id":"/docs/components/checkbox-6","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#controlled","content":"Controlled"},"293":{"id":"/docs/components/checkbox-7","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#horizontal-layout","content":"Horizontal Layout"},"294":{"id":"/docs/components/checkbox-8","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#disabled-states","content":"Disabled States"},"295":{"id":"/docs/components/checkbox-9","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#required-indicator","content":"Required Indicator"},"296":{"id":"/docs/components/checkbox-10","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#invalid-state","content":"Invalid State"},"297":{"id":"/docs/components/checkbox-11","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#customization","content":"Customization"},"298":{"id":"/docs/components/checkbox-12","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#data-attributes","content":"Data Attributes"},"299":{"id":"/docs/components/checkbox-13","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#component-customization","content":"Component Customization"},"300":{"id":"/docs/components/checkbox-14","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#key-features","content":"Key Features"},"301":{"id":"/docs/components/checkbox-15","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#indeterminate-state","content":"Indeterminate State"},"302":{"id":"/docs/components/checkbox-16","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#group-validation","content":"Group Validation"},"303":{"id":"/docs/components/checkbox-17","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#orientation","content":"Orientation"},"304":{"id":"/docs/components/checkbox-18","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#accessibility","content":"Accessibility"},"305":{"id":"/docs/components/checkbox-19","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#keyboard-navigation","content":"Keyboard Navigation"},"306":{"id":"/docs/components/checkbox-20","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#aria-support","content":"ARIA Support"},"307":{"id":"/docs/components/checkbox-21","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#troubleshooting","content":"Troubleshooting"},"308":{"id":"/docs/components/checkbox-22","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#selection-not-updating","content":"Selection Not Updating"},"309":{"id":"/docs/components/checkbox-23","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#indeterminate-state-not-updating","content":"Indeterminate State Not Updating"},"310":{"id":"/docs/components/checkbox-24","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#styling-overrides-not-applying","content":"Styling Overrides Not Applying"},"311":{"id":"/docs/components/checkbox-25","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#keyboard-navigation-not-working","content":"Keyboard Navigation Not Working"},"312":{"id":"/docs/components/checkbox-26","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#best-practices","content":"Best Practices"},"313":{"id":"/docs/components/checkbox-27","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#when-to-use-checkboxes","content":"When to Use Checkboxes"},"314":{"id":"/docs/components/checkbox-28","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#label-guidelines","content":"Label Guidelines"},"315":{"id":"/docs/components/checkbox-29","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#validation","content":"Validation"},"316":{"id":"/docs/components/checkbox-30","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#group-organization","content":"Group Organization"},"317":{"id":"/docs/components/checkbox-31","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#props","content":"Props"},"318":{"id":"/docs/components/checkbox-32","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkbox","content":"Checkbox"},"319":{"id":"/docs/components/checkbox-33","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkboxgroup","content":"CheckboxGroup"},"320":{"id":"/docs/components/checkbox-34","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkboxindicator","content":"CheckboxIndicator"},"321":{"id":"/docs/components/checkbox-35","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#default","content":"A single checkbox with a label."},"322":{"id":"/docs/components/checkbox-36","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate","content":"Checkboxes can display an indeterminate state (neither checked nor unchecked), with the use of the `isIndeterminate` prop, commonly used for \"select all\" functionality when some but not all child items are selected."},"323":{"id":"/docs/components/checkbox-37","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#checkbox-group","content":"Group multiple checkboxes together with a shared label."},"324":{"id":"/docs/components/checkbox-38","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#controlled","content":"Manage checkbox group state programmatically with controlled component pattern."},"325":{"id":"/docs/components/checkbox-39","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#horizontal-layout","content":"Display checkboxes in a horizontal row instead of vertical stack."},"326":{"id":"/docs/components/checkbox-40","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#disabled-states","content":"Individual checkboxes within a group can be disabled while others remain interactive."},"327":{"id":"/docs/components/checkbox-41","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#required-indicator","content":"Mark a checkbox group as required with visual indicator and validation."},"328":{"id":"/docs/components/checkbox-42","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#invalid-state","content":"Display error state and error message for validation feedback."},"329":{"id":"/docs/components/checkbox-43","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#customization","content":"`CheckboxGroup` is composed: write `Label`, a `Group` holding the `Checkbox` items, `Text slot=\"description\"`, and `FieldError`. The `Group` takes its axis, gap, and presentational role from the group's `orientation`, so a bare `<Group>` is all you need; pass your own `direction`/`gap` to lay the items out differently. Each `Checkbox` takes label text next to the indicator."},"330":{"id":"/docs/components/checkbox-44","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"Components automatically add data attributes for styling different states:"},"331":{"id":"/docs/components/checkbox-45","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"**CheckboxGroup Container:** `data-invalid`, `data-disabled`, `data-required`, `data-readonly`, `data-orientation`"},"332":{"id":"/docs/components/checkbox-46","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"**Checkbox:** `data-selected`, `data-indeterminate`, `data-hovered`, `data-pressed`, `data-focused`, `data-disabled`"},"333":{"id":"/docs/components/checkbox-47","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#component-customization","content":"Pass `className` or `style` to customize a checkbox field container. Use descendant data-attribute selectors to style the interactive checkbox state:"},"334":{"id":"/docs/components/checkbox-48","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate-state","content":"The `isIndeterminate` prop displays a minus icon to represent a partial selection state. This is useful for \"select all\" checkboxes when only some items in a collection are selected."},"335":{"id":"/docs/components/checkbox-49","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"CheckboxGroup supports validation states and error messages:"},"336":{"id":"/docs/components/checkbox-50","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**isRequired**: Marks the group as required with visual indicator"},"337":{"id":"/docs/components/checkbox-51","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**isInvalid**: Shows error state styling"},"338":{"id":"/docs/components/checkbox-52","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**`FieldError`**: Displays validation error text below the group"},"339":{"id":"/docs/components/checkbox-53","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#orientation","content":"Use `orientation=\"vertical\"` (default) to stack checkboxes, or `orientation=\"horizontal\"` to arrange them in a row."},"340":{"id":"/docs/components/checkbox-54","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Tab**: Moves focus to the next/previous checkbox"},"341":{"id":"/docs/components/checkbox-55","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Space**: Toggles the focused checkbox"},"342":{"id":"/docs/components/checkbox-56","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Shift + Tab**: Moves focus to the previous checkbox"},"343":{"id":"/docs/components/checkbox-57","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-disabled` for disabled checkboxes"},"344":{"id":"/docs/components/checkbox-58","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-required` when selection is required"},"345":{"id":"/docs/components/checkbox-59","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-invalid` for validation errors"},"346":{"id":"/docs/components/checkbox-60","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"Proper labeling with `aria-labelledby` and `aria-describedby`"},"347":{"id":"/docs/components/checkbox-61","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate-state-not-updating","content":"The `isIndeterminate` prop must be explicitly managed - it doesn't automatically reflect parent-child relationships:"},"348":{"id":"/docs/components/checkbox-62","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ For selecting multiple independent options"},"349":{"id":"/docs/components/checkbox-63","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ When users can select zero, one, or many items"},"350":{"id":"/docs/components/checkbox-64","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ For toggling settings or features on/off"},"351":{"id":"/docs/components/checkbox-65","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ When all available options should be visible"},"352":{"id":"/docs/components/checkbox-66","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"❌ For mutually exclusive options (use Radio instead)"},"353":{"id":"/docs/components/checkbox-67","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"❌ For simple on/off toggles without labels (use Toggle/Switch instead)"},"354":{"id":"/docs/components/checkbox-68","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Use clear, concise labels that describe what selecting the option means"},"355":{"id":"/docs/components/checkbox-69","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Keep labels short (1-5 words when possible)"},"356":{"id":"/docs/components/checkbox-70","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Ensure labels are descriptive without being verbose"},"357":{"id":"/docs/components/checkbox-71","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Place the most commonly selected options first in groups"},"358":{"id":"/docs/components/checkbox-72","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#validation","content":"Always provide clear error messages and use appropriate validation states:"},"359":{"id":"/docs/components/checkbox-73","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Limit checkbox groups to 7-10 options for better usability"},"360":{"id":"/docs/components/checkbox-74","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Use logical ordering (alphabetical, frequency of use, or importance)"},"361":{"id":"/docs/components/checkbox-75","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Consider using CheckboxGroup for related options, even if there are only 2-3"},"362":{"id":"/docs/components/checkbox-76","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Provide a group label that clearly describes the choice being made"},"363":{"id":"/docs/components/chip","page_id":"/docs/components/chip","type":"page","content":"Chip","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/chip"},"364":{"id":"/docs/components/chip-0","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip","content":"Grouped pill-shaped items for selecting values and removing user-added filters or tokens."},"365":{"id":"/docs/components/chip-1","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#features","content":"Features"},"366"