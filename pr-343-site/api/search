ules`."},"17":{"id":"/docs-15","page_id":"/docs","tags":[],"type":"text","url":"/docs#nextjs","content":"Add `@godaddy/antares` to `transpilePackages` so Next.js processes the package through its own CSS pipeline instead of treating it as a pre-built external:"},"18":{"id":"/docs-16","page_id":"/docs","tags":[],"type":"text","url":"/docs#nextjs","content":"Without this, Next.js will throw:"},"19":{"id":"/docs-17","page_id":"/docs","tags":[],"type":"text","url":"/docs#remix","content":"Remix with Vite handles CSS imports from `node_modules` in the client bundle automatically. However, during SSR, Vite treats `node_modules` as externals by default, which bypasses CSS processing. Add `@godaddy/antares` to `ssr.noExternal` to fix this:"},"20":{"id":"/docs-18","page_id":"/docs","tags":[],"type":"text","url":"/docs#vite","content":"Vite processes CSS imports from `node_modules` out of the box. No additional configuration is needed for client-side SPAs."},"21":{"id":"/docs-19","page_id":"/docs","tags":[],"type":"text","url":"/docs#vite","content":"If you are using Vite with SSR (e.g., custom SSR setup, not Remix), add `@godaddy/antares` to `ssr.noExternal` as shown in the Remix section."},"22":{"id":"/docs-20","page_id":"/docs","tags":[],"type":"text","url":"/docs#other-bundlers","content":"Any bundler that supports CSS imports will work with Antares. If your bundler does not process CSS imports from `node_modules` by default, ensure it is configured to do so. For example, with raw webpack you may need `css-loader` configured to handle `.css` files from `node_modules`."},"23":{"id":"/docs/components/alert","page_id":"/docs/components/alert","type":"page","content":"Alert","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/alert"},"24":{"id":"/docs/components/alert-0","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert","content":"In-page alerts are non-intrusive notifications within a webpage, providing users with timely information or feedback without disrupting their experience."},"25":{"id":"/docs/components/alert-1","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#installation","content":"Installation"},"26":{"id":"/docs/components/alert-2","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#examples","content":"Examples"},"27":{"id":"/docs/components/alert-3","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#default","content":"Default"},"28":{"id":"/docs/components/alert-4","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#emphasis-variants","content":"Emphasis Variants"},"29":{"id":"/docs/components/alert-5","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#dismissible","content":"Dismissible"},"30":{"id":"/docs/components/alert-6","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#with-action","content":"With Action"},"31":{"id":"/docs/components/alert-7","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#accessibility","content":"Accessibility"},"32":{"id":"/docs/components/alert-8","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#keyboard","content":"Keyboard"},"33":{"id":"/docs/components/alert-9","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#screen-readers","content":"Screen readers"},"34":{"id":"/docs/components/alert-10","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#dismiss-button-label","content":"Dismiss button label"},"35":{"id":"/docs/components/alert-11","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#best-practices","content":"Best Practices"},"36":{"id":"/docs/components/alert-12","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#props","content":"Props"},"37":{"id":"/docs/components/alert-13","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#alert","content":"Alert"},"38":{"id":"/docs/components/alert-14","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#default","content":"A minimal alert with a title and body text."},"39":{"id":"/docs/components/alert-15","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#emphasis-variants","content":"All 7 emphasis categories. Each variant carries a distinct visual accent and semantic icon so the type of message is never communicated by color alone."},"40":{"id":"/docs/components/alert-16","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#dismissible","content":"When an `onClose` callback is provided, a dismiss button is rendered. The component does not manage its own visibility — the parent is responsible for unmounting or hiding the alert when `onClose` fires."},"41":{"id":"/docs/components/alert-17","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#with-action","content":"Pass a `Button` to the `actions` slot to give the user a clear path to resolve the alert."},"42":{"id":"/docs/components/alert-18","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Key"},"43":{"id":"/docs/components/alert-19","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Description"},"44":{"id":"/docs/components/alert-20","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"`Tab`"},"45":{"id":"/docs/components/alert-21","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Moves focus to the dismiss button or action button"},"46":{"id":"/docs/components/alert-22","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"`Space` / `Enter`"},"47":{"id":"/docs/components/alert-23","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#keyboard","content":"Activates the focused button"},"48":{"id":"/docs/components/alert-24","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#screen-readers","content":"The alert container uses `role=\"alert\"`, which creates an ARIA live region. When an alert is rendered or its content changes, screen readers announce the message automatically — the user does not need to navigate to the alert to hear it."},"49":{"id":"/docs/components/alert-25","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#dismiss-button-label","content":"The dismiss button defaults to `aria-label=\"Close\"`. Override it via `ariaLabels={{ close: '...' }}` to provide more specific context for screen readers (e.g. `\"Dismiss payment warning\"`). This is especially useful when multiple alerts are visible at the same time."},"50":{"id":"/docs/components/alert-26","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Write alert content from the user's perspective: describe what happened and what they can do next, not the underlying technical error."},"51":{"id":"/docs/components/alert-27","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Use `critical` only when the user truly cannot continue without resolving the issue. Overusing it reduces its impact."},"52":{"id":"/docs/components/alert-28","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Always provide a `title` when the alert includes a dismiss button — it improves the reading experience for screen reader users."},"53":{"id":"/docs/components/alert-29","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"When using `actions`, prefer `secondary` or `tertiary` Button variants. Avoid placing a primary action inside an alert."},"54":{"id":"/docs/components/alert-30","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#best-practices","content":"Do not stack multiple alerts of the same emphasis; consolidate the message into a single alert."},"55":{"id":"/docs/components/avatar","page_id":"/docs/components/avatar","type":"page","content":"Avatar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/avatar"},"56":{"id":"/docs/components/avatar-0","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar","content":"A visual representation of a user or entity, shown as a photo or a monogram of their initials."},"57":{"id":"/docs/components/avatar-1","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#features","content":"Features"},"58":{"id":"/docs/components/avatar-2","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#installation","content":"Installation"},"59":{"id":"/docs/components/avatar-3","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#examples","content":"Examples"},"60":{"id":"/docs/components/avatar-4","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#default","content":"Default"},"61":{"id":"/docs/components/avatar-5","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#image","content":"Image"},"62":{"id":"/docs/components/avatar-6","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#image-fallback","content":"Image Fallback"},"63":{"id":"/docs/components/avatar-7","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#shapes-and-sizes","content":"Shapes and sizes"},"64":{"id":"/docs/components/avatar-8","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#emphasis","content":"Emphasis"},"65":{"id":"/docs/components/avatar-9","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#avatar-button","content":"Avatar Button"},"66":{"id":"/docs/components/avatar-10","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#account-menu","content":"Account Menu"},"67":{"id":"/docs/components/avatar-11","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#customization","content":"Customization"},"68":{"id":"/docs/components/avatar-12","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#accessibility","content":"Accessibility"},"69":{"id":"/docs/components/avatar-13","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#best-practices","content":"Best Practices"},"70":{"id":"/docs/components/avatar-14","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#troubleshooting","content":"Troubleshooting"},"71":{"id":"/docs/components/avatar-15","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#props","content":"Props"},"72":{"id":"/docs/components/avatar-16","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#avatar","content":"Avatar"},"73":{"id":"/docs/components/avatar-17","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Composable `Avatar`, `Image`, and `Text` parts"},"74":{"id":"/docs/components/avatar-18","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Circle and rounded-square shapes at four named sizes"},"75":{"id":"/docs/components/avatar-19","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Automatic image loading with a Text monogram fallback"},"76":{"id":"/docs/components/avatar-20","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Primary, subtle, and 15 categorical figure emphases"},"77":{"id":"/docs/components/avatar-21","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Avatar Button and Account Menu compositions built with Pressable"},"78":{"id":"/docs/components/avatar-22","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#default","content":"Use an Avatar with a one- or two-character monogram when no image is available."},"79":{"id":"/docs/components/avatar-23","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#image","content":"Place Image before Text so the monogram is available while the image loads or if it fails."},"80":{"id":"/docs/components/avatar-24","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#image-fallback","content":"Include a Text fallback so an unavailable photo never leaves an empty identity marker."},"81":{"id":"/docs/components/avatar-25","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#shapes-and-sizes","content":"Use circular Avatars for people and square Avatars for organizations, workspaces, and accounts."},"82":{"id":"/docs/components/avatar-26","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#emphasis","content":"Use primary or subtle for standard treatments, and a deterministic figure emphasis to categorize entities in a list."},"83":{"id":"/docs/components/avatar-27","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#avatar-button","content":"Use `Pressable` to add accessible interaction to an Avatar while preserving its shape."},"84":{"id":"/docs/components/avatar-28","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#account-menu","content":"Wrap an Avatar in a Pressable inside MenuTrigger for an account or profile menu."},"85":{"id":"/docs/components/avatar-29","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#customization","content":"Use Image native image props for responsive image sources. Choose a deterministic `figure0` through `figure14` emphasis in lists that categorize multiple entities."},"86":{"id":"/docs/components/avatar-30","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#customization","content":"When an Avatar triggers an action, compose it with `Pressable` so the Avatar keeps its own shape and receives the interaction behavior directly. Use this pattern for an Avatar Button, or place it inside `MenuTrigger` for an Account Menu:"},"87":{"id":"/docs/components/avatar-31","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Give Image meaningful `alt` text when the image conveys an identity."},"88":{"id":"/docs/components/avatar-32","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Text remains available to assistive technology when no image loads."},"89":{"id":"/docs/components/avatar-33","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Use `alt=\"\"` on the Image and `aria-hidden=\"true\"` on the Avatar when the entire avatar is purely decorative."},"90":{"id":"/docs/components/avatar-34","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Give an Avatar Button or Account Menu an accessible name with `aria-label` or `aria-labelledby`."},"91":{"id":"/docs/components/avatar-35","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"When using `Pressable`, provide an interactive role for the non-semantic Avatar child."},"92":{"id":"/docs/components/avatar-36","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use Avatar for informational identity; compose it with `Pressable` for an Avatar Button or Account Menu when it is independently actionable."},"93":{"id":"/docs/components/avatar-37","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use circle for people and square for businesses, workspaces, and accounts."},"94":{"id":"/docs/components/avatar-38","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Keep monograms to one or two uppercase characters."},"95":{"id":"/docs/components/avatar-39","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use the same `figure*` emphasis for the same entity wherever it appears."},"96":{"id":"/docs/components/avatar-40","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"If an image is unavailable because of a bad URL or CORS policy, Text remains visible."},"97":{"id":"/docs/components/avatar-41","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"Long Text content is clipped to the avatar shape; provide a one- or two-character monogram."},"98":{"id":"/docs/components/avatar-42","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"Figure colors repeat after 15 values; assign a deterministic figure emphasis in the consuming application."},"99":{"id":"/docs/components/button","page_id":"/docs/components/button","type":"page","content":"Button","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/button"},"100":{"id":"/docs/components/button-0","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"The Button component allows users to initiate actions or submit forms with a single click"},"101":{"id":"/docs/components/button-1","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#installation","content":"Installation"},"102":{"id":"/docs/components/button-2","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#examples","content":"Examples"},"103":{"id":"/docs/components/button-3","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#default","content":"Default"},"104":{"id":"/docs/components/button-4","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#primary","content":"Primary"},"105":{"id":"/docs/components/button-5","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#secondary","content":"Secondary"},"106":{"id":"/docs/components/button-6","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#tertiary","content":"Tertiary"},"107":{"id":"/docs/components/button-7","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#critical","content":"Critical"},"108":{"id":"/docs/components/button-8","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#disabled","content":"Disabled"},"109":{"id":"/docs/components/button-9","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#icon","content":"Icon"},"110":{"id":"/docs/components/button-10","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#inline","content":"Inline"},"111":{"id":"/docs/components/button-11","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#minimal","content":"Minimal"},"112":{"id":"/docs/components/button-12","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#sizes","content":"Sizes"},"113":{"id":"/docs/components/button-13","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#props","content":"Props"},"114":{"id":"/docs/components/button-14","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#button","content":"Button"},"115":{"id":"/docs/components/button-15","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#linkbutton","content":"LinkButton"},"116":{"id":"/docs/components/button-16","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#closebutton","content":"CloseButton"},"117":{"id":"/docs/components/button-17","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use the `LinkButton` component instead when you need navigation functionality with a button-like appearance."},"118":{"id":"/docs/components/button-18","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use the `CloseButton` preset to dismiss an overlay (such as a `Modal`). It defaults to `slot=\"close\"`, so it picks up the overlay's close behavior with no wiring, and always renders an `x` icon with `aria-label=\"Close\"`. For a labelled dismiss action (e.g. \"Cancel\"), use a raw `<Button slot=\"close\">Cancel</Button>`."},"119":{"id":"/docs/components/button-19","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Inside a field `Group`, `slot=\"control\"` and `slot=\"trigger\"` pick up the matching look, size, and\ndisabled state from context. See TextField for control affixes, and Select or DatePicker for trigger faces.\nThe `control` and `trigger` variants are field parts: the field sizes them, so use them only inside a field."},"120":{"id":"/docs/components/button-20","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#default","content":"The default/tertiary button is the base for all other buttons in the system. It provides no significant visual treatment other than to provide indication for the user to take a common action."},"121":{"id":"/docs/components/button-21","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#primary","content":"The primary button should be used to indicate the most important action for the user to take in their current experience."},"122":{"id":"/docs/components/button-22","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#secondary","content":"The secondary button indicates an action of secondary importance."},"123":{"id":"/docs/components/button-23","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#tertiary","content":"The tertiary button is the default, low-emphasis style used for common, non-critical actions."},"124":{"id":"/docs/components/button-24","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#critical","content":"The critical button signifies to the user a destructive action will take place."},"125":{"id":"/docs/components/button-25","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#disabled","content":"Any button variant can be disabled to prevent interaction, communicated with reduced opacity and a not-allowed cursor."},"126":{"id":"/docs/components/button-26","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#icon","content":"You may provide an optional `Icon` component to the button. Wrap the text beside an icon in a `Text`. If you do not include text, you must provide an aria-label attribute to identify the purpose of the button. This will produce a square button."},"127":{"id":"/docs/components/button-27","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#inline","content":"The inline button sits within a run of text, styled like a link while retaining button semantics."},"128":{"id":"/docs/components/button-28","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#minimal","content":"The minimal button is an icon-only button that's used when space is limited and/or when the action is universally understood."},"129":{"id":"/docs/components/button-29","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#sizes","content":"Buttons come in small, medium, and large sizes to fit different layout densities. Without\n`size`, a button follows the surrounding size scope, and uses medium outside any scope. An\nicon-only button is square and as tall as a text button of the same size."},"130":{"id":"/docs/components/calendar","page_id":"/docs/components/calendar","type":"page","content":"Calendar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/calendar"},"131":{"id":"/docs/components/calendar-0","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar","content":"Accessible calendar grids for selecting a single date (Calendar) or a date range (RangeCalendar), built on React Aria."},"132":{"id":"/docs/components/calendar-1","page_id":"/docs/components/calendar","type":"heading","tag