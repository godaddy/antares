x#features","content":"**Composes into other components**: `Select` uses `ListBox` internally; reach for `ListBox` directly when you need an inline list rather than a popover dropdown."},"591":{"id":"/docs/components/listbox-12","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**React Aria integration**: Built on React Aria ListBox for accessibility, keyboard navigation, and typeahead."},"592":{"id":"/docs/components/listbox-13","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"`ListBox` requires either `aria-label` or `aria-labelledby`. For a labeled, popover-style picker, prefer `Select`."},"593":{"id":"/docs/components/listbox-14","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#default","content":"Single selection with static children. Use `aria-label` to give the listbox an accessible name."},"594":{"id":"/docs/components/listbox-15","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-controlled","content":"Use `selectedKeys` and `onSelectionChange` for controlled state."},"595":{"id":"/docs/components/listbox-16","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-multiple","content":"Set `selectionMode=\"multiple\"` to allow multiple values. `selectedKeys` is a `Set<Key>` (or the literal `'all'`)."},"596":{"id":"/docs/components/listbox-17","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#props","content":"The ListBox component accepts the following props:"},"597":{"id":"/docs/components/menu","page_id":"/docs/components/menu","type":"page","content":"Menu","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/menu"},"598":{"id":"/docs/components/menu-0","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"Accessible dropdown menu with grouping, multi-select checkbox items, leading icons, and submenus."},"599":{"id":"/docs/components/menu-1","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#features","content":"Features"},"600":{"id":"/docs/components/menu-2","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#installation","content":"Installation"},"601":{"id":"/docs/components/menu-3","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#examples","content":"Examples"},"602":{"id":"/docs/components/menu-4","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#default","content":"Default"},"603":{"id":"/docs/components/menu-5","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#controlled","content":"Controlled"},"604":{"id":"/docs/components/menu-6","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#bottom-sheet","content":"Bottom Sheet"},"605":{"id":"/docs/components/menu-7","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#groups","content":"Groups"},"606":{"id":"/docs/components/menu-8","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#multiple-selection","content":"Multiple Selection"},"607":{"id":"/docs/components/menu-9","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#rich-content-from-an-item","content":"Rich Content From an Item"},"608":{"id":"/docs/components/menu-10","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#single-selection","content":"Single Selection"},"609":{"id":"/docs/components/menu-11","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#sizes","content":"Sizes"},"610":{"id":"/docs/components/menu-12","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenu","content":"Submenu"},"611":{"id":"/docs/components/menu-13","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#accessibility","content":"Accessibility"},"612":{"id":"/docs/components/menu-14","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#best-practices","content":"Best Practices"},"613":{"id":"/docs/components/menu-15","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#props","content":"Props"},"614":{"id":"/docs/components/menu-16","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menu","content":"Menu"},"615":{"id":"/docs/components/menu-17","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menutrigger","content":"MenuTrigger"},"616":{"id":"/docs/components/menu-18","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menugroup","content":"MenuGroup"},"617":{"id":"/docs/components/menu-19","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menuitem","content":"MenuItem"},"618":{"id":"/docs/components/menu-20","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenutrigger","content":"SubmenuTrigger"},"619":{"id":"/docs/components/menu-21","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"An accessible dropdown menu built on React Aria. It supports grouping with optional\ntitles, multi-select checkbox items, leading icons, submenus, and two sizes. It\nreuses Antares' `Popover` for the overlay and `Checkbox` indicator for selection."},"620":{"id":"/docs/components/menu-22","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Grouping with an optional title via `MenuGroup`, plus `MenuSeparator` dividers"},"621":{"id":"/docs/components/menu-23","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Multi-select groups: set `selectionMode=\"multiple\"` on a `MenuGroup` to render\nits items as checkboxes, while other groups stay plain action items"},"622":{"id":"/docs/components/menu-24","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Optional leading `icon` per item; links (`href`) and disabled items"},"623":{"id":"/docs/components/menu-25","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Submenus via `SubmenuTrigger`"},"624":{"id":"/docs/components/menu-26","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Two sizes (`sm`, `md`); set `size` explicitly on each submenu `Menu`"},"625":{"id":"/docs/components/menu-27","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Usable anchored to a trigger or standalone (e.g. inside a bottom-sheet `Drawer`)"},"626":{"id":"/docs/components/menu-28","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#default","content":"A trigger with plain action items."},"627":{"id":"/docs/components/menu-29","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#controlled","content":"`MenuTrigger` exposes its open state via `isOpen`/`onOpenChange`,\nwhich can be used to drive the rotation of a chevron icon."},"628":{"id":"/docs/components/menu-30","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#bottom-sheet","content":"On small screens a menu often reads better as a bottom sheet than an anchored\npopover. Since `Menu` works standalone, drop it into a bottom `Drawer`."},"629":{"id":"/docs/components/menu-31","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#groups","content":"Labeled groups separated by dividers, a multi-select checkbox group mixed with\nplain action groups, leading icons, a disabled item, and a link."},"630":{"id":"/docs/components/menu-32","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#multiple-selection","content":"A `MenuGroup` with `selectionMode=\"multiple\"` renders its items as checkboxes.\nDrive the checked items with `selectedKeys` + `onSelectionChange` or\nseed them uncontrolled with `defaultSelectedKeys`. Keys correspond to each\n`MenuItem`'s `id`."},"631":{"id":"/docs/components/menu-33","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#rich-content-from-an-item","content":"A `Menu` is a collection, so it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger` children. Rich content inside a `Menu`\nor submenu is not supported. To show a `Calendar`, let the item close the\nmenu from `onAction` and open a separate `Popover` anchored to the trigger\nwith `triggerRef`."},"632":{"id":"/docs/components/menu-34","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#single-selection","content":"A `MenuGroup` with `selectionMode=\"single\"` lets one item be selected at a time.\nDrive it with `selectedKeys` + `onSelectionChange` or seed it uncontrolled with\n`defaultSelectedKeys`. Keys correspond to each `MenuItem`'s `id`."},"633":{"id":"/docs/components/menu-35","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#sizes","content":"`size` controls item density. Shown here as two standalone menus so both\nsizes are visible at once; in practice you set `size` on the `Menu` inside a\n`MenuTrigger`."},"634":{"id":"/docs/components/menu-36","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#submenu","content":"Nested menus via `SubmenuTrigger`."},"635":{"id":"/docs/components/menu-37","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Space/Enter**: activate an item; **Escape**: close"},"636":{"id":"/docs/components/menu-38","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Up/Down**: move between items; **Home/End**: first/last"},"637":{"id":"/docs/components/menu-39","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Right/Left**: open/close a submenu"},"638":{"id":"/docs/components/menu-40","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Type to select**: jump to a matching item (string labels are used as `textValue`)"},"639":{"id":"/docs/components/menu-41","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"Multi-select items use RAC's `menuitemcheckbox` role; the checkbox indicator is\ndecorative (`aria-hidden`) and the item owns interaction"},"640":{"id":"/docs/components/menu-42","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Give each selectable `MenuItem` a stable `id`, and provide the `Menu` an\n`aria-label` when there is no visible label."},"641":{"id":"/docs/components/menu-43","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Use a leading `icon` for recognition, not as the only label - keep a text label."},"642":{"id":"/docs/components/menu-44","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Reserve checkbox groups for multi-select; use plain groups for one-shot actions."},"643":{"id":"/docs/components/menu-45","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"A `Menu` is a collection: it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger`. For rich content (a `Calendar`, a form),\nclose the menu from `onAction` and open a separate `Popover` anchored with\n`triggerRef` instead of putting it in a submenu."},"644":{"id":"/docs/components/metrics-lockup","page_id":"/docs/components/metrics-lockup","type":"page","content":"MetricsLockup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/metrics-lockup"},"645":{"id":"/docs/components/metrics-lockup-0","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"The MetricsLockup component displays a single metric with an optional title, info tooltip, trend indicator, and description."},"646":{"id":"/docs/components/metrics-lockup-1","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#installation","content":"Installation"},"647":{"id":"/docs/components/metrics-lockup-2","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#examples","content":"Examples"},"648":{"id":"/docs/components/metrics-lockup-3","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#default","content":"Default"},"649":{"id":"/docs/components/metrics-lockup-4","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#with-trend","content":"With Trend"},"650":{"id":"/docs/components/metrics-lockup-5","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#compact","content":"Compact"},"651":{"id":"/docs/components/metrics-lockup-6","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#accessibility","content":"Accessibility"},"652":{"id":"/docs/components/metrics-lockup-7","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#keyboard","content":"Keyboard"},"653":{"id":"/docs/components/metrics-lockup-8","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#aria","content":"ARIA"},"654":{"id":"/docs/components/metrics-lockup-9","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#best-practices","content":"Best Practices"},"655":{"id":"/docs/components/metrics-lockup-10","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#props","content":"Props"},"656":{"id":"/docs/components/metrics-lockup-11","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"MetricsLockup displays a metric value prominently, with an optional title and tooltip for context, an optional trend icon to show direction of change, and a description label below the value."},"657":{"id":"/docs/components/metrics-lockup-12","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#default","content":"A metric with a title, info tooltip, value, and description."},"658":{"id":"/docs/components/metrics-lockup-13","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#with-trend","content":"Use the `trend` prop to show a directional icon next to the description. Accepts `'positive'`, `'negative'`, or `'neutral'`."},"659":{"id":"/docs/components/metrics-lockup-14","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#compact","content":"Use the `compact` prop to render the metric value and description inline rather than stacked."},"660":{"id":"/docs/components/metrics-lockup-15","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Key"},"661":{"id":"/docs/components/metrics-lockup-16","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Description"},"662":{"id":"/docs/components/metrics-lockup-17","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Tab"},"663":{"id":"/docs/components/metrics-lockup-18","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Moves focus to the info trigger button and shows the tooltip"},"664":{"id":"/docs/components/metrics-lockup-19","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Escape"},"665":{"id":"/docs/components/metrics-lockup-20","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Closes the tooltip"},"666":{"id":"/docs/components/metrics-lockup-21","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger button uses `aria-label=\"More information\"` to describe its purpose."},"667":{"id":"/docs/components/metrics-lockup-22","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The tooltip uses `role=\"tooltip\"` and is associated with the info trigger via `aria-describedby`."},"668":{"id":"/docs/components/metrics-lockup-23","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger has a minimum touch target of 44×44px, achieved via a CSS pseudo-element, to meet WCAG 2.5.5."},"669":{"id":"/docs/components/metrics-lockup-24","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"Keep tooltip content concise and informative."},"670":{"id":"/docs/components/metrics-lockup-25","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"The `data` prop accepts strings or numbers — format currency and percentages before passing them in."},"671":{"id":"/docs/components/metrics-lockup-26","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`titleInfo` requires `title` to be set — the info icon is contextually tied to the title label. If `title` is absent, `titleInfo` has no effect."},"672":{"id":"/docs/components/metrics-lockup-27","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`trend` is intended to accompany `description` to provide temporal context (e.g. \"↑ +3% vs. last month\"). A trend icon alone, with no description, leaves the direction unanchored (\"up since *when*?\"). If `description` is not provided, `trend` has no effect."},"673":{"id":"/docs/components/modal","page_id":"/docs/components/modal","type":"page","content":"Modal","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/modal"},"674":{"id":"/docs/components/modal-0","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"The Modal component presents a dialog window over the page that focuses the user's attention on a single task or piece of information."},"675":{"id":"/docs/components/modal-1","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#installation","content":"Installation"},"676":{"id":"/docs/components/modal-2","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/doc