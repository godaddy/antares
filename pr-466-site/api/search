 Not Updating"},"488":{"id":"/docs/components/collapsible-11","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#trigger-not-expanding-the-panel","content":"Trigger Not Expanding the Panel"},"489":{"id":"/docs/components/collapsible-12","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#input-values-persist-after-closing","content":"Input Values Persist After Closing"},"490":{"id":"/docs/components/collapsible-13","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#props","content":"Props"},"491":{"id":"/docs/components/collapsible-14","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#collapsible","content":"Collapsible"},"492":{"id":"/docs/components/collapsible-15","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#collapsiblepanel","content":"CollapsiblePanel"},"493":{"id":"/docs/components/collapsible-16","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Independent sections with controlled or uncontrolled expansion."},"494":{"id":"/docs/components/collapsible-17","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Composed headings, optional status icons, and flexible panel content."},"495":{"id":"/docs/components/collapsible-18","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Persistent panel content when collapsed."},"496":{"id":"/docs/components/collapsible-19","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Accessible keyboard interaction and button-to-panel relationships powered by React Aria Components."},"497":{"id":"/docs/components/collapsible-20","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#examples","content":"import { ArgTypes, Meta } from '@storybook/add"},"498":{"id":"/docs/components/collapsible-21","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/bloc"},"499":{"id":"/docs/components/collapsible-22","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { E"},"500":{"id":"/docs/components/collapsible-23","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Ex"},"501":{"id":"/docs/components/collapsible-24","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Place a `Heading` containing `Button slot=\"trigger\"` inside Collapsible, followed by CollapsiblePanel.\nAdd an `Icon slot=\"indicator\"` inside the button for the expansion indicator. The panel accepts text,\nlinks, forms, and other components."},"502":{"id":"/docs/components/collapsible-25","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"CollapsiblePanel provides the content spacing automatically. Use `contentProps` to customize its\ninner container with Box spacing props, a class name, or styles:"},"503":{"id":"/docs/components/collapsible-26","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `contentProps={{ padding: '0' }}` for content without padding. Props supplied directly to\nCollapsiblePanel, including `className`, `style`, and `ref`, apply to the outer panel."},"504":{"id":"/docs/components/collapsible-27","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `defaultExpanded` for initial expansion, or `isExpanded` with `onExpandedChange` for controlled\nstate. The callback receives a boolean. Use the Accordion component to coordinate several sections;\nin that composition, manage expansion through the group."},"505":{"id":"/docs/components/collapsible-28","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `className` and `style` to customize each component. Button supports string or state-based\n`className` values. Components expose these data attributes for state-based styling:"},"506":{"id":"/docs/components/collapsible-29","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"`Collapsible`: `data-expanded`, `data-disabled`, and `data-focus-visible-within`."},"507":{"id":"/docs/components/collapsible-30","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Trigger `Button`: `data-hovered`, `data-pressed`, `data-focus-visible`, and `data-disabled`."},"508":{"id":"/docs/components/collapsible-31","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"`CollapsiblePanel`: `data-focus-visible-within`."},"509":{"id":"/docs/components/collapsible-32","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"| Key                   | Action                                                              |\n| --------------------- | ------------------------------------------------------------------- |\n| `Tab` / `Shift + Tab` | Move between the enabled trigger and controls in the expanded panel |","table":"table-0"},"510":{"id":"/docs/components/collapsible-33","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"| Key               | Action                                         |\n| ----------------- | ---------------------------------------------- |\n| `Enter` / `Space` | Toggle the section; focus stays on the trigger |","table":"table-0"},"511":{"id":"/docs/components/collapsible-34","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`Button slot=\"trigger\"` renders a native button with `aria-expanded` for its open state and\n`aria-controls` linked to the panel automatically."},"512":{"id":"/docs/components/collapsible-35","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`CollapsiblePanel` is labeled by its trigger through `aria-labelledby` automatically."},"513":{"id":"/docs/components/collapsible-36","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`CollapsiblePanel` uses `role=\"group\"` by default. Keep it when the panel's content does not need\na navigation landmark; there is no need to set it explicitly."},"514":{"id":"/docs/components/collapsible-37","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"Set `role=\"region\"` on `CollapsiblePanel` when its content warrants a named landmark\nfor direct screen-reader navigation."},"515":{"id":"/docs/components/collapsible-38","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"Collapsed content stays mounted but is excluded from keyboard and screen-reader navigation."},"516":{"id":"/docs/components/collapsible-39","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`Icon slot=\"indicator\"` is decorative and receives `aria-hidden=\"true\"` automatically."},"517":{"id":"/docs/components/collapsible-40","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Use descriptive section titles and keep essential information visible."},"518":{"id":"/docs/components/collapsible-41","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Choose heading levels that fit the page hierarchy and avoid deeply nested sections."},"519":{"id":"/docs/components/collapsible-42","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Include text for status icons so their meaning is available to screen readers."},"520":{"id":"/docs/components/collapsible-43","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Put links, forms, and actions inside the panel."},"521":{"id":"/docs/components/collapsible-44","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Open the panel before moving focus to an input that needs attention."},"522":{"id":"/docs/components/collapsible-45","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#controlled-state-not-updating","content":"Update `isExpanded` from `onExpandedChange`. Changing `defaultExpanded` after mounting does not\ncontrol expansion. Inside Accordion, update the group's `expandedKeys` instead."},"523":{"id":"/docs/components/collapsible-46","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#trigger-not-expanding-the-panel","content":"Place `Button slot=\"trigger\"` inside the