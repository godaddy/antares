ocs/components/menu-13","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#separator","content":"Separator"},"938":{"id":"/docs/components/menu-14","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenutrigger","content":"SubmenuTrigger"},"939":{"id":"/docs/components/menu-15","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"`MenuTrigger` wraps a trigger element and a `Popover` containing `Menu`. The menu is fully keyboard-navigable, supports typeahead search, and handles open/close state automatically. The trigger applies `hideArrow` and card styling to all popovers, including nested submenus."},"940":{"id":"/docs/components/menu-16","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Trigger and popover**: `MenuTrigger` wraps any trigger and opens a `Popover` with automatic card styling and hidden arrow. Use for desktop; use `Drawer` for mobile."},"941":{"id":"/docs/components/menu-17","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Menu title and groups**: Place an optional `Heading` as a sibling to `Menu` (not `slot=\"title\"`). Use `MenuGroup` + `Header` + `Heading` for section labels; group headings are presentational."},"942":{"id":"/docs/components/menu-18","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Composable rows**: Each `MenuItem` renders a string label or composed content (icons, checkboxes). Use render props (`isSelected`, `selectionMode`) and pass `textValue` for typeahead."},"943":{"id":"/docs/components/menu-19","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Single or multiple selection**: Set `selectionMode=\"single\"` or `\"multiple\"` on `Menu` or per-`MenuGroup`. Use controlled state or `defaultSelectedKeys` for uncontrolled menus."},"944":{"id":"/docs/components/menu-20","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Separators and submenus**: `Separator` divides items. `SubmenuTrigger` nests a `Popover` + `Menu` for hierarchies."},"945":{"id":"/docs/components/menu-21","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Popover or drawer**: Open from `MenuTrigger` for positioned overlays, or place `Menu` in a `Drawer` for full-screen/mobile."},"946":{"id":"/docs/components/menu-22","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#examples","content":"import { ArgTypes, Meta } from"},"947":{"id":"/docs/components/menu-23","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from"},"948":{"id":"/docs/components/menu-24","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories fr"},"949":{"id":"/docs/components/menu-25","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from '"},"950":{"id":"/docs/components/menu-26","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key               | Action                     |\n| ----------------- | -------------------------- |\n| `Enter` / `Space` | Activates the focused item |","table":"table-0"},"951":{"id":"/docs/components/menu-27","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key                 | Action                    |\n| ------------------- | ------------------------- |\n| `Arrow Up` / `Down` | Moves focus between items |","table":"table-0"},"952":{"id":"/docs/components/menu-28","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key            | Action                          |\n| -------------- | ------------------------------- |\n| `Home` / `End` | Jumps to the first or last item |","table":"table-0"},"953":{"id":"/docs/components/menu-29","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key           | Action                         |\n| ------------- | ------------------------------ |\n| `Arrow Right` | Opens the submenu (if present) |","table":"table-0"},"954":{"id":"/docs/components/menu-30","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key          | Action                               |\n| ------------ | ------------------------------------ |\n| `Arrow Left` | Closes the submenu and returns focus |","table":"table-0"},"955":{"id":"/docs/components/menu-31","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key      | Action                       |\n| -------- | ---------------------------- |\n| `Escape` | Closes the menu (or submenu) |","table":"table-0"},"956":{"id":"/docs/components/menu-32","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key                 | Action                                      |\n| ------------------- | ------------------------------------------- |\n| Typeahead (letters) | Jumps to the item matching the typed letter |","table":"table-0"},"957":{"id":"/docs/components/menu-33","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#aria","content":"**Menu accessible name**: Set `aria-label` on the `<Menu>` to name the list (e.g., \"Actions\", \"Share with\"). This is separate from any `Heading` title in the popover."},"958":{"id":"/docs/components/menu-34","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#aria","content":"**Roles**: Single-select items use `menuitemradio`; multiple-select use `menuitemcheckbox`. Unselectable items use `menuitem`."},"959":{"id":"/docs/components/menu-35","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#aria","content":"**Selection indicators are decorative**: A checkbox, radio check, or chevron-right icon is purely visual. The item owns the `aria-checked` state."},"960":{"id":"/docs/components/menu-36","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#aria","content":"**Group headings**: The group `Heading` receives `role=\"presentation\"` automatically and acts as a label for the group, not a real heading level."},"961":{"id":"/docs/components/menu-37","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Title placement**: Place an optional `Heading` as a sibling to `Menu`, not wrapped inside (do not use `slot=\"title\"`; see \"Title and groups\" example)."},"962":{"id":"/docs/components/menu-38","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Menu name**: Set `aria-label` on `<Menu>` to name the list (\"Actions\", \"Share with\", \"Theme\")."},"963":{"id":"/docs/components/menu-39","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Stable IDs**: Give each `MenuItem` a unique `id` for React tracking across re-renders."},"964":{"id":"/docs/components/menu-40","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Typeahead**: For composed labels (icons, checkboxes), provide `textValue` to `MenuItem` for typeahead search."},"965":{"id":"/docs/components/menu-41","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Selection modes**: Set `selectionMode` on `Menu` (all items) or per-`MenuGroup` (only group). Use controlled state for tracking."},"966":{"id":"/docs/components/menu-42","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Submenus**: Use `SubmenuTrigger` with `chevron-right` icon. Keyboard navigation is automatic."},"967":{"id":"/docs/components/menu-43","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Mobile**: Replace `MenuTrigger` + `Popover` with `Drawer` on narrow viewports; reuse the same `Menu`."},"968":{"id":"/docs/components/menu-44","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Avoid complex content**: Forms, date pickers, and multi-line content belong in a separate overlay, not in menu items."},"969":{"id":"/docs/components/metrics-lockup","page_id":"/docs/components/metrics-lockup","type":"page","content":"MetricsLockup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/metrics-lockup"},"970":{"id":"/docs/components/metrics-lockup-0","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"The MetricsLockup component displays a single metric with an optional title, info tooltip, trend indicator, and description."},"971":{"id":"/docs/components/metrics-lockup-1","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#installation","content":"Installation"},"972":{"id":"/docs/components/metrics-lockup-2","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#examples","content":"Examples"},"973":{"id":"/docs/components/metrics-lockup-3","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#accessibility","content":"Accessibility"},"974":{"id":"/docs/components/metrics-lockup-4","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#keyboard","content":"Keyboard"},"975":{"id":"/docs/components/metrics-lockup-5","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#aria","content":"ARIA"},"976":{"id":"/docs/components/metrics-lockup-6","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#best-practices","content":"Best Practices"},"977":{"id":"/docs/components/metrics-lockup-7","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#props","content":"Props"},"978":{"id":"/docs/components/metrics-lockup-8","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#metricslockup","content":"MetricsLockup"},"979":{"id":"/docs/components/metrics-lockup-9","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"MetricsLockup displays a metric value prominently, with an optional title and tooltip for context, an optional trend icon to show direction of change, and a description label below the value."},"980":{"id":"/docs/components/metrics-lockup-10","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/b"},"981":{"id":"/docs/components/metrics-lockup-11","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers"},"982":{"id":"/docs/components/metrics-lockup-12","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"| Key | Description                                                  |\n| --- | ------------------------------------------------------------ |\n| Tab | Moves focus to the info trigger button and shows the tooltip |","table":"table-0"},"983":{"id":"/docs/components/metrics-lockup-13","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"| Key    | Description        |\n| ------ | ------------------ |\n| Escape | Closes the tooltip |","table":"table-0"},"984":{"id":"/docs/components/metrics-lockup-14","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger button uses `aria-label=\"More information\"` to describe its purpose."},"985":{"id":"/docs/components/metrics-lockup-15","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The tooltip uses `role=\"tooltip\"` and is associated with the info trigger via `aria-describedby`."},"986":{"id":"/docs/components/metrics-lockup-16","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger has a minimum touch target of 44×44px, achieved via a CSS pseudo-element, to meet WCAG 2.5.5."},"987":{"id":"/docs/components/metrics-lockup-17","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"Keep tooltip content concise and informative."},"988":{"id":"/docs/components/metrics-lockup-18","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"The `data` prop accepts strings or numbers — format currency and percentages before passing them in."},"989":{"id":"/docs/components/metrics-lockup-19","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`titleInfo` requires `title` to be set — the info icon is contextually tied to the title label. If `title` is absent, `titleInfo` has no effect."},"990":{"id":"/docs/components/metrics-lockup-20","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`trend` is intended to accompany `description` to provide temporal context (e.g. \"↑ +3% vs. last month\"). A trend icon alone, with no description, leaves the direction unanchored (\"up since *when*?\"). If `description` is not provided, `trend` has no effect."},"991":{"id":"/docs/components/modal","page_id":"/docs/components/modal","type":"page","content":"Modal","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/modal"},"992":{"id":"/docs/components/modal-0","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"The Modal component presents a dialog window over the page that focuses the user's attention on a single task or piece of information."},"993":{"id":"/docs/components/modal-1","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#installation","content":"Installation"},"994":{"id":"/docs/components/modal-2","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#examples","content":"Examples"},"995":{"id":"/docs/components/modal-3","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#accessibility","content":"Accessibility"},"996":{"id":"/docs/components/modal-4","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#keyboard-interaction","content":"Keyboard interaction"},"997":{"id":"/docs/components/modal-5","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#aria","content":"ARIA"},"998":{"id":"/docs/components/modal-6","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#best-practices","content":"Best Practices"},"999":{"id":"/docs/components/modal-7","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#props","content":"Props"},"1000":{"id":"/docs/components/modal-8","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#modal","content":"Modal"},"1001":{"id":"/docs/components/modal-9","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#modaltrigger","content":"ModalTrigger"},"1002":{"id":"/docs/components/modal-10","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"`ModalTrigger` wraps a trigger button and a `<Modal>`, handling open state automatically. Based on RAC `DialogTrigger`."},"1003":{"id":"/docs/components/modal-11","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"The modal is a `SizeProvider`. It opens at the size of the scope around its trigger, even though it renders in a portal, and `size` overrides that."},"1004":{"id":"/docs/components/modal-12","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from"},"1005":{"id":"/docs/components/modal-13","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './m"},"1006":{"id":"/docs/components/modal-14","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"| Key   | Action                                                     |\n| ----- | ---------------------------------------------------------- |\n| `Tab` | Moves focus to the next focusable element inside the modal |","table":"table-0"},"1007":{"id":"/docs/components/modal-15","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"| Key      | Action                                                |\n| -------- | ----------------------------------------------------- |\n| `Escape` | Closes the modal (unless `isKeyboardDismissDisabled`) |","table":"table-0"},"1008":{"id":"/docs/components/modal-16","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#aria","content":"`role=\"dialog\"` is applied automatically by the underlying React Aria `Dialog`"},"1009":{"id":"/docs/components/modal-17","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#aria","content":"Focus is trapped within the modal while open and returned to the trigger on close"},"1010":{"id":"/docs/components/modal-18","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#best-practices","content":"Always include a `Heading slot=\"title\"` so the dialog has an accessible name; otherwise pass `aria-label`/`aria-labelledby` on `<Modal>`"},"1011":{"id":"/docs/components/modal-19","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#best-practices","content":"Pair every action button with `slot=\"close\"` when it should dismiss the modal"},"1012":{"id":"/docs/components/modal-20","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#best-practices","content":"Set `isDismissable={false}` to prevent outside-click dismissal for required confirmations; to also block `Escape`, pass `isKeyboardDismissDisabled`"},"1013":{"id":"/docs/components/number-field","page_id":"/docs/components/number-field","type":"page","content":"NumberField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/number-field"},"1014":{"id":"/docs/components/number-field-0","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field","content":"NumberField is a composed numeric input with min/max/step and optional increment/decrement stepper buttons. Use it in forms for quantities, amounts, or percentages."},"1015":{"id":"/docs/components/number-field-1","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#features","content":"Features"},"1016":{"id":"/docs/components/number-field-2","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#installation","content":"Installation"},"1017":{"id":"/docs/components/number-field-3","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#examples","content":"Examples"},"1018":{"id":"/docs/components/number-field-4","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#props","content":"Props"},"1019":{"id":"/docs/components/number-field-5","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#numberfield","content":"NumberField"},"1020":{"id":"/docs/components/number-field-6","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Composable interior**: Compose `Label`, the control, `Text slot=\"description\"`, and `FieldError`. Nothing is added for you, and what you write keeps the order you wrote it in"},"1021":{"id":"/docs/components/number-field-7","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Steppers**: A stepper is a `Group` holding `Button slot=\"decrement\"`, an `Input`, and `Button slot=\"increment\"`. Left empty, each button takes its icon and `variant=\"control\"` from the field, so no icon imports are needed. Compose a bare `Input` instead for a plain numeric input"},"1022":{"id":"/docs/components/number-field-8","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Sizes**: The field is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets its label, input, steppers, description, and error; without it, the field follows the surrounding scope"},"1023":{"id":"/docs/components/number-field-9","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Value scale**: `minValue`, `maxValue`, `step`, and `formatOptions` configure the numeric behavior"},"1024":{"id":"/docs/components/number-field-10","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"1025":{"id":"/docs/components/number-field-11","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"1026":{"id":"/docs/components/number-field-12","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-