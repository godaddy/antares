 prefer `Select`."},"926":{"id":"/docs/components/listbox-13","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@"},"927":{"id":"/docs/components/listbox-14","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-ad"},"928":{"id":"/docs/components/menu","page_id":"/docs/components/menu","type":"page","content":"Menu","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/menu"},"929":{"id":"/docs/components/menu-0","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"Menu lists actions or options opened from a trigger or placed in a drawer. Supports composable rows, selection modes, and nested submenus."},"930":{"id":"/docs/components/menu-1","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#features","content":"Features"},"931":{"id":"/docs/components/menu-2","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#installation","content":"Installation"},"932":{"id":"/docs/components/menu-3","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#examples","content":"Examples"},"933":{"id":"/docs/components/menu-4","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#accessibility","content":"Accessibility"},"934":{"id":"/docs/components/menu-5","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#keyboard","content":"Keyboard"},"935":{"id":"/docs/components/menu-6","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#aria","content":"ARIA"},"936":{"id":"/docs/components/menu-7","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#best-practices","content":"Best Practices"},"937":{"id":"/docs/components/menu-8","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#props","content":"Props"},"938":{"id":"/docs/components/menu-9","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menu","content":"Menu"},"939":{"id":"/docs/components/menu-10","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menutrigger","content":"MenuTrigger"},"940":{"id":"/docs/components/menu-11","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menugroup","content":"MenuGroup"},"941":{"id":"/docs/components/menu-12","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menuitem","content":"MenuItem"},"942":{"id":"/docs/components/menu-13","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#separator","content":"Separator"},"943":{"id":"/docs/components/menu-14","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenutrigger","content":"SubmenuTrigger"},"944":{"id":"/docs/components/menu-15","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"`MenuTrigger` wraps a trigger element and a `Popover` containing `Menu`. The menu is fully keyboard-navigable, supports typeahead search, and handles open/close state automatically. The trigger applies `hideArrow` and card styling to all popovers, including nested submenus."},"945":{"id":"/docs/components/menu-16","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Trigger and popover**: `MenuTrigger` wraps any trigger and opens a `Popover` with automatic card styling and hidden arrow. Use for desktop; use `Drawer` for mobile."},"946":{"id":"/docs/components/menu-17","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Menu title and groups**: Place an optional `Heading` as a sibling to `Menu` (not `slot=\"title\"`). Use `MenuGroup` + `Header` + `Heading` for section labels; group headings are presentational."},"947":{"id":"/docs/components/menu-18","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Composable rows**: Each `MenuItem` renders a string label or composed content (icons, checkboxes). Use render props (`isSelected`, `selectionMode`) and pass `textValue` for typeahead."},"948":{"id":"/docs/components/menu-19","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Single or multiple selection**: Set `selectionMode=\"single\"` or `\"multiple\"` on `Menu` or per-`MenuGroup`. Use controlled state or `defaultSelectedKeys` for uncontrolled menus."},"949":{"id":"/docs/components/menu-20","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Separators and submenus**: `Separator` divides items. `SubmenuTrigger` nests a `Popover` + `Menu` for hierarchies."},"950":{"id":"/docs/components/menu-21","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"**Popover or drawer**: Open from `MenuTrigger` for positioned overlays, or place `Menu` in a `Drawer` for full-screen/mobile."},"951":{"id":"/docs/components/menu-22","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#examples","content":"import { ArgTypes, Meta } from"},"952":{"id":"/docs/components/menu-23","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from"},"953":{"id":"/docs/components/menu-24","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories fr"},"954":{"id":"/docs/components/menu-25","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from '"},"955":{"id":"/docs/components/menu-26","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key               | Action                     |\n| ----------------- | -------------------------- |\n| `Enter` / `Space` | Activates the focused item |","table":"table-0"},"956":{"id":"/docs/components/menu-27","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key                 | Action                    |\n| ------------------- | ------------------------- |\n| `Arrow Up` / `Down` | Moves focus between items |","table":"table-0"},"957":{"id":"/docs/components/menu-28","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key            | Action                          |\n| -------------- | ------------------------------- |\n| `Home` / `End` | Jumps to the first or last item |","table":"table-0"},"958":{"id":"/docs/components/menu-29","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key           | Action                         |\n| ------------- | ------------------------------ |\n| `Arrow Right` | Opens the submenu (if present) |","table":"table-0"},"959":{"id":"/docs/components/menu-30","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key          | Action                               |\n| ------------ | ------------------------------------ |\n| `Arrow Left` | Closes the submenu and returns focus |","table":"table-0"},"960":{"id":"/docs/components/menu-31","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key      | Action                       |\n| -------- | ---------------------------- |\n| `Escape` | Closes the menu (or submenu) |","table":"table-0"},"961":{"id":"/docs/components/menu-32","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#keyboard","content":"| Key                 | Action                                      |\n| ------------------- | ------------------------------------------- |\n| Typeahead (letters) | Jumps to the item matching the typed letter |","table":"table-0"},"962":{"id":"/docs/components/menu-33","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#aria","content":"**Menu accessible name**: Set `aria-label` on the `<Menu>` to name the list (e.g., \"Actions\", \"Share with\"). This is separate from any `Heading` title in the popover."},"963":{"id":"/docs/components/menu-34","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#aria","content":"**Roles**: Single-select items use `menuitemradio`; multiple-select use `menuitemcheckbox`. Unselectable items use `menuitem`."},"964":{"id":"/docs/components/menu-35","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#aria","content":"**Selection indicators are decorative**: A checkbox, radio check, or chevron-right icon is purely visual. The item owns the `aria-checked` state."},"965":{"id":"/docs/components/menu-36","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#aria","content":"**Group headings**: The group `Heading` receives `role=\"presentation\"` automatically and acts as a label for the group, not a real heading level."},"966":{"id":"/docs/components/menu-37","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Title placement**: Place an optional `Heading` as a sibling to `Menu`, not wrapped inside (do not use `slot=\"title\"`; see \"Title and groups\" example)."},"967":{"id":"/docs/components/menu-38","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Menu name**: Set `aria-label` on `<Menu>` to name the list (\"Actions\", \"Share with\", \"Theme\")."},"968":{"id":"/docs/components/menu-39","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Stable IDs**: Give each `MenuItem` a unique `id` for React tracking across re-renders."},"969":{"id":"/docs/components/menu-40","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Typeahead**: For composed labels (icons, checkboxes), provide `textValue` to `MenuItem` for typeahead search."},"970":{"id":"/docs/components/menu-41","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Selection modes**: Set `selectionMode` on `Menu` (all items) or per-`MenuGroup` (only group). Use controlled state for tracking."},"971":{"id":"/docs/components/menu-42","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Submenus**: Use `SubmenuTrigger` with `chevron-right` icon. Keyboard navigation is automatic."},"972":{"id":"/docs/components/menu-43","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Mobile**: Replace `MenuTrigger` + `Popover` with `Drawer` on narrow viewports; reuse the same `Menu`."},"973":{"id":"/docs/components/menu-44","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"**Avoid complex content**: Forms, date pickers, and multi-line content belong in a separate overlay, not in menu items."},"974":{"id":"/docs/components/metrics-lockup","page_id":"/docs/components/metrics-lockup","type":"page","content":"MetricsLockup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/metrics-lockup"},"975":{"id":"/docs/components/metrics-lockup-0","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"The MetricsLockup component displays a single metric with an optional title, info tooltip, trend indicator, and description."},"976":{"id":"/docs/components/metrics-lockup-1","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#installation","content":"Installation"},"977":{"id":"/docs/components/metrics-lockup-2","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#examples","content":"Examples"},"978":{"id":"/docs/components/metrics-lockup-3","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#accessibility","content":"Accessibility"},"979":{"id":"/docs/components/metrics-lockup-4","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#keyboard","content":"Keyboard"},"980":{"id":"/docs/components/metrics-lockup-5","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#aria","content":"ARIA"},"981":{"id":"/docs/components/metrics-lockup-6","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#best-practices","content":"Best Practices"},"982":{"id":"/docs/components/metrics-lockup-7","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#props","content":"Props"},"983":{"id":"/docs/components/metrics-lockup-8","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#metricslockup","content":"MetricsLockup"},"984":{"id":"/docs/components/metrics-lockup-9","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"MetricsLockup displays a metric value prominently, with an optional title and tooltip for context, an optional trend icon to show direction of change, and a description label below the value."},"985":{"id":"/docs/components/metrics-lockup-10","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/b"},"986":{"id":"/docs/components/metrics-lockup-11","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers"},"987":{"id":"/docs/components/metrics-lockup-12","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"| Key | Description                                                  |\n| --- | ------------------------------------------------------------ |\n| Tab | Moves focus to the info trigger button and shows the tooltip |","table":"table-0"},"988":{"id":"/docs/components/metrics-lockup-13","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"| Key    | Description        |\n| ------ | ------------------ |\n| Escape | Closes the tooltip |","table":"table-0"},"989":{"id":"/docs/components/metrics-lockup-14","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger button uses `aria-label=\"More information\"` to describe its purpose."},"990":{"id":"/docs/components/metrics-lockup-15","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The tooltip uses `role=\"tooltip\"` and is associated with the info trigger via `aria-describedby`."},"991":{"id":"/docs/components/metrics-lockup-16","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger has a minimum touch target of 44×44px, achieved via a CSS pseudo-element, to meet WCAG 2.5.5."},"992":{"id":"/docs/components/metrics-lockup-17","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"Keep tooltip content concise and informative."},"993":{"id":"/docs/components/metrics-lockup-18","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"The `data` prop accepts strings or numbers — format currency and percentages before passing them in."},"994":{"id":"/docs/components/metrics-lockup-19","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`titleInfo` requires `title` to be set — the info icon is contextually tied to the title label. If `title` is absent, `titleInfo` has no effect."},"995":{"id":"/docs/components/metrics-lockup-20","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`trend` is intended to accompany `description` to provide temporal context (e.g. \"↑ +3% vs. last month\"). A trend icon alone, with no description, leaves the direction unanchored (\"up since *when*?\"). If `description` is not provided, `trend` has no effect."},"