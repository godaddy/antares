":{"id":"/docs/components/collapsible-34","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Trigger `Button`: `data-hovered`, `data-pressed`, `data-focus-visible`, and `data-disabled`."},"441":{"id":"/docs/components/collapsible-35","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"`CollapsiblePanel`: `data-focus-visible-within`."},"442":{"id":"/docs/components/collapsible-36","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"Key"},"443":{"id":"/docs/components/collapsible-37","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"Action"},"444":{"id":"/docs/components/collapsible-38","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"`Tab` / `Shift + Tab`"},"445":{"id":"/docs/components/collapsible-39","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"Move between the enabled trigger and controls in the expanded panel"},"446":{"id":"/docs/components/collapsible-40","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"`Enter` / `Space`"},"447":{"id":"/docs/components/collapsible-41","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"Toggle the section; focus stays on the trigger"},"448":{"id":"/docs/components/collapsible-42","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`Button slot=\"trigger\"` renders a native button with `aria-expanded` for its open state and\n`aria-controls` linked to the panel automatically."},"449":{"id":"/docs/components/collapsible-43","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`CollapsiblePanel` is labeled by its trigger through `aria-labelledby` automatically."},"450":{"id":"/docs/components/collapsible-44","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`CollapsiblePanel` uses `role=\"group\"` by default. Keep it when the panel's content does not need\na navigation landmark; there is no need to set it explicitly."},"451":{"id":"/docs/components/collapsible-45","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"Set `role=\"region\"` on `CollapsiblePanel` when its content warrants a named landmark\nfor direct screen-reader navigation."},"452":{"id":"/docs/components/collapsible-46","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"Collapsed content stays mounted but is excluded from keyboard and screen-reader navigation."},"453":{"id":"/docs/components/collapsible-47","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`Icon slot=\"indicator\"` is decorative and receives `aria-hidden=\"true\"` automatically."},"454":{"id":"/docs/components/collapsible-48","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Use descriptive section titles and keep essential information visible."},"455":{"id":"/docs/components/collapsible-49","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Choose heading levels that fit the page hierarchy and avoid deeply nested sections."},"456":{"id":"/docs/components/collapsible-50","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Include text for status icons so their meaning is available to screen readers."},"457":{"id":"/docs/components/collapsible-51","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Put links, forms, and actions inside the panel."},"458":{"id":"/docs/components/collapsible-52","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Open the panel before moving focus to an input that needs attention."},"459":{"id":"/docs/components/collapsible-53","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#controlled-state-not-updating","content":"Update `isExpanded` from `onExpandedChange`. Changing `defaultExpanded` after mounting does not\ncontrol expansion. Inside Accordion, update the group's `expandedKeys` instead."},"460":{"id":"/docs/components/collapsible-54","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#trigger-not-expanding-the-panel","content":"Place `Button slot=\"trigger\"` inside the section's Heading. A Button without that slot acts\nindependently and does not toggle the section."},"461":{"id":"/docs/components/collapsible-55","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#input-values-persist-after-closing","content":"Panel content stays mounted when collapsed. Reset form state explicitly when the application requires it."},"462":{"id":"/docs/components/drawer","page_id":"/docs/components/drawer","type":"page","content":"Drawer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/drawer"},"463":{"id":"/docs/components/drawer-0","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer","content":"An overlay panel that slides in from a screen edge, supporting