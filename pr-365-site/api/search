s/chip-17","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#layout-and-sizing","content":"Layout and sizing"},"358":{"id":"/docs/components/chip-18","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#button-composition","content":"Button composition"},"359":{"id":"/docs/components/chip-19","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#accessibility","content":"Accessibility"},"360":{"id":"/docs/components/chip-20","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#best-practices","content":"Best Practices"},"361":{"id":"/docs/components/chip-21","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#troubleshooting","content":"Troubleshooting"},"362":{"id":"/docs/components/chip-22","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"A ChipGroup has no accessible name"},"363":{"id":"/docs/components/chip-23","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"The remove action does not update the UI"},"364":{"id":"/docs/components/chip-24","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"A composed label is not truncating correctly"},"365":{"id":"/docs/components/chip-25","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"The menu trigger does not look like a Chip"},"366":{"id":"/docs/components/chip-26","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#props","content":"Props"},"367":{"id":"/docs/components/chip-27","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chip","content":"Chip"},"368":{"id":"/docs/components/chip-28","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipgroup","content":"ChipGroup"},"369":{"id":"/docs/components/chip-29","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chiplist","content":"ChipList"},"370":{"id":"/docs/components/chip-30","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipbutton","content":"ChipButton"},"371":{"id":"/docs/components/chip-31","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipGroup` + `ChipList` + `Chip` for grouped values, selection, keyboard navigation, and removal"},"372":{"id":"/docs/components/chip-32","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Toggle Chips for selecting multiple peer filters"},"373":{"id":"/docs/components/chip-33","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Removable Chips for user-added filters and input tokens"},"374":{"id":"/docs/components/chip-34","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Shared `sm`, `md`, and `lg` sizes, with optional leading icons"},"375":{"id":"/docs/components/chip-35","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipButton` for menu filters and other actions with a Chip-like appearance"},"376":{"id":"/docs/components/chip-36","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#default","content":"Start with a labeled group of related values. Add selection or removal when\nthe group needs interactive behavior."},"377":{"id":"/docs/components/chip-37","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#toggle-chips","content":"Use Toggle Chips for multiple peer filters. The Chip render prop supplies\nselection state for the checkmark, while `textValue` names composed content."},"378":{"id":"/docs/components/chip-38","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#removable-chips","content":"Use Removable Chips for user-added filters and tokens. `ChipGroup` reports\nremoved keys through `onRemove`; the owner updates its collection. A\nself-closing `Button` in the `remove` slot supplies each remove control."},"379":{"id":"/docs/components/chip-39","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#controlled-selection","content":"Use `selectedKeys` and `onSelectionChange` when another part of the page\nneeds to own the selected filter state."},"380":{"id":"/docs/components/chip-40","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#sizes","content":"Compare the supported `sm`, `md`, and `lg` sizes. Set `size` on `ChipGroup`\nso every Chip inherits one consistent size."},"381":{"id":"/docs/components/chip-41","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#disabled","content":"Disable individual options with `disabledKeys` when some values are unavailable."},"382":{"id":"/docs/components/chip-42","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#truncation","content":"By default, long labels truncate visually when space is constrained, while\nthe complete accessible value remains available."},"383":{"id":"/docs/components/chip-43","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#empty-state","content":"Give an empty collection useful guidance, then let the user add the first\nvalue. Removable items continue to be owned by the collection."},"384":{"id":"/docs/components/chip-44","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#menu-filter-trigger","content":"Use `ChipButton` for Chip presentation without collection semantics.\n`MenuTrigger` continues to own open state, focus, and keyboard behavior."},"385":{"id":"/docs/components/chip-45","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#content","content":"Use a string for a simple label. For icons or other composed content, wrap the\nvisible label in `Text` and provide `textValue` for the accessible name. See\n**Toggle Chips** and **Removable Chips** above."},"386":{"id":"/docs/components/chip-46","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#selection-and-removal","content":"`ChipGroup` owns selection and removal behavior. Use a Chip render prop for\nstate-dependent content, and `Button` with `slot=\"remove\"` together with\n`onRemove` for removable items. See **Toggle Chips** and **Removable Chips**."},"387":{"id":"/docs/components/chip-47","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#layout-and-sizing","content":"Set `size` on `ChipGroup` to keep a collection consistent. `ChipList` wraps by\ndefault and accepts layout props for custom arrangements. See **Sizes**."},"388":{"id":"/docs/components/chip-48","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#button-composition","content":"Use `ChipButton` when Chip presentation is needed without collection semantics.\nCompose it with components such as `MenuTrigger`; those components continue to\nown open state, focus, and keyboard behavior. See **Menu filter trigger**."},"389":{"id":"/docs/components/chip-49","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use `Label` or `aria-label` to name the `ChipGroup`; this names the collection,\nnot its individual Chips."},"390":{"id":"/docs/components/chip-50","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Give each Chip a visible label, `textValue`, or `aria-label`. Use `textValue`\nwhen a Chip contains icons, composed content, or a render prop."},"391":{"id":"/docs/components/chip-51","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use a descriptive group label so removal actions can be announced clearly."},"392":{"id":"/docs/components/chip-52","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Keep the visible label and the accessible value synchronized."},"393":{"id":"/docs/components/chip-53","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"`ChipButton` is a real button and exposes menu state through `MenuTrigger`; provide an accessible name when the visible content is incomplete."},"394":{"id":"/docs/components/chip-54","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep labels concise and let them truncate only when the available width requires it."},"395":{"id":"/docs/components/chip-55","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Prefer groups of three or more related values."},"396":{"id":"/docs/components/chip-56","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep one size per group."},"397":{"id":"/docs/components/chip-57","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Let `ChipList` wrap instead of forcing a single horizontal line."},"398":{"id":"/docs/components/chip-58","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Use removable Chips for user-added filters and tokens."},"399":{"id":"/docs/components/chip-59","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"For menu filters, use `ChipButton` with `MenuTrigger` and provide the chevron explicitly."},"400":{"id":"/docs/components/chip-60","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"Add a visible `Label` to the group or provide `aria-label`. For an individual Chip\nwith composed content, provide a visible label, `textValue`, or `aria-label`."},"401":{"id":"/docs/components/chip-61","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"Add `onRemove` to `ChipGroup` and remove the returned keys from the collection\nowned by your application."},"402":{"id":"/docs/components/chip-62","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"Keep the label in `Text`, preserve `textValue`, and constrain the available width\nof the surrounding layout. Truncation is visual; the complete accessible value\nshould remain available."},"403":{"id":"/docs/components/chip-63","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"Use `ChipButton` inside `MenuTrigger`, include the visible value, and add a\ntrailing chevron to communicate that the control opens a menu."},"404":{"id":"/docs/components/chip-64","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#props","content":"For a menu trigger, the button and menu are composed as siblings inside\n`MenuTrigger`:"},"405":{"id":"/docs/components/collapsible","page_id":"/docs/components/collapsible","type":"page","content":"Collapsible","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/collapsible"},"406":{"id":"/docs/components/collapsible-0","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible","content":"Collapsible reveals or hides a section of content beneath a heading."},"407":{"id":"/docs/components/collapsible-1","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#features","content":"Features"},"408":{"id":"/docs/components/collapsible-2","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#installation","content":"Installation"},"409":{"id":"/docs/components/collapsible-3","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#examples","content":"Examples"},"410":{"id":"/docs/components/collapsible-4","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#default","content":"Default"},"411":{"id":"/docs/components/collapsible-5","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#controlled","content":"Controlled"},"412":{"id":"/docs/components/collapsible-6","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#with-status","content":"With Status"},"413":{"id":"/docs/components/collapsible-7","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#disabled","content":"Disabled"},"414":{"id":"/docs/components/collapsible-8","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#customization","content":"Customization"},"415":{"id":"/docs/components/collapsible-9","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#accessibility","content":"Accessibility"},"416":{"id":"/docs/components/collapsible-10","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#keyboard","content":"Keyboard"},"417":{"id":"/docs/components/collapsible-11","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#aria","content":"ARIA"},"418":{"id":"/docs/components/collapsible-12","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#best-practices","content":"Best Practices"},"419":{"id":"/docs/components/collapsible-13","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#troubleshooting","content":"Troubleshooting"},"420":{"id":"/docs/components/collapsible-14","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#controlled-state-not-updating","content":"Controlled State Not Updating"},"421":{"id":"/docs/components/collapsible-15","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#trigger-not-expanding-the-panel","content":"Trigger Not Expanding the Panel"},"422":{"id":"/docs/components/collapsible-16","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#input-values-persist-after-closing","content":"Input Values Persist After Closing"},"423":{"id":"/docs/components/collapsible-17","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#props","content":"Props"},"424":{"id":"/docs/components/collapsible-18","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#collapsible","content":"Collapsible"},"425":{"id":"/docs/components/collapsible-19","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#collapsiblepanel","content":"CollapsiblePanel"},"426":{"id":"/docs/components/collapsible-20","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Independent sections with controlled or uncontrolled expansion."},"427":{"id":"/docs/components/collapsible-21","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Composed headings, optional status icons, and flexible panel content."},"428":{"id":"/docs/components/collapsible-22","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Persistent panel content when collapsed."},"429":{"id":"/docs/components/collapsible-23","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Accessible keyboard interaction and button-to-panel relationships powered by React Aria Components."},"430":{"id":"/docs/components/collapsible-24","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#default","content":"Reveal optional details without an Accordion group."},"431":{"id":"/docs/components/collapsible-25","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#controlled","content":"Control a section from application state or an external action."},"432":{"id":"/docs/components/collapsible-26","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#with-status","content":"Pair a status icon with text so completion is understandable without the icon."},"433":{"id":"/docs/components/collapsible-27","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#disabled","content":"Keep unavailable details disabled, including when their content starts visible."},"434":{"id":"/docs/components/collapsible-28","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","conte