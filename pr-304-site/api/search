ip","tags":[],"type":"text","url":"/docs/components/tooltip#custom-anchor","content":"To position a tooltip relative to a different focusable element, use the \\`triggerRef\\` prop. \\`TooltipTrigger\\` still handles showing and hiding on hover and focus."},"1286":{"id":"/docs/components/tooltip-13","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Key"},"1287":{"id":"/docs/components/tooltip-14","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Description"},"1288":{"id":"/docs/components/tooltip-15","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Tab"},"1289":{"id":"/docs/components/tooltip-16","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Moves focus to the focusable element and shows the tooltip"},"1290":{"id":"/docs/components/tooltip-17","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Escape"},"1291":{"id":"/docs/components/tooltip-18","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Closes the tooltip"},"1292":{"id":"/docs/components/tooltip-19","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#aria","content":"The tooltip uses `role=\"tooltip\"` and is associated with its focusable element via `aria-describedby`."},"1293":{"id":"/docs/components/tooltip-20","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Keep tooltip content short and informative."},"1294":{"id":"/docs/components/tooltip-21","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Tooltips are not shown on touch screen interactions