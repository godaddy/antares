"/docs/components/radio#when-to-use-radio-buttons","content":"✅ When the decision is important and deserves space"},"1360":{"id":"/docs/components/radio-56","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ For more than 7 options (use Select instead)"},"1361":{"id":"/docs/components/radio-57","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ For binary yes/no choices (use Checkbox or Toggle instead)"},"1362":{"id":"/docs/components/radio-58","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ When space is limited (use Select dropdown)"},"1363":{"id":"/docs/components/radio-59","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Use clear, concise labels"},"1364":{"id":"/docs/components/radio-60","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Keep labels short (1-3 words when possible)"},"1365":{"id":"/docs/components/radio-61","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Place the most common option first"},"1366":{"id":"/docs/components/radio-62","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Ensure labels are descriptive without being verbose"},"1367":{"id":"/docs/components/radio-63","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#validation","content":"Always provide clear error messages:"},"1368":{"id":"/docs/components/size-provider","page_id":"/docs/components/size-provider","type":"page","content":"SizeProvider","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/size-provider"},"1369":{"id":"/docs/components/size-provider-0","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider","content":"Sizes a section, so the text, controls, and default spacing inside it follow one size."},"1370":{"id":"/docs/components/size-provider-1","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#features","content":"Features"},"1371":{"id":"/docs/components/size-provider-2","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#examples","content":"Examples"},"1372":{"id":"/docs/components/size-provider-3","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#default","content":"Default"},"1373":{"id":"/docs/components/size-provider-4","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#sizes","content":"Sizes"},"1374":{"id":"/docs/components/size-provider-5","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#form","content":"Form"},"1375":{"id":"/docs/components/size-provider-6","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#nested-scopes","content":"Nested Scopes"},"1376":{"id":"/docs/components/size-provider-7","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#explicit-size","content":"Explicit Size"},"1377":{"id":"/docs/components/size-provider-8","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#overlays","content":"Overlays"},"1378":{"id":"/docs/components/size-provider-9","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#plain-html","content":"Plain Html"},"1379":{"id":"/docs/components/size-provider-10","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#props","content":"Props"},"1380":{"id":"/docs/components/size-provider-11","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"`sm`, `md`, or `lg` for the adopted components inside (listed below): their text, controls, and\ndefault spacing."},"1381":{"id":"/docs/components/size-provider-12","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"The nearest scope wins, and nested scopes replace the size rather than compounding it."},"1382":{"id":"/docs/components/size-provider-13","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"A component's own `size` prop wins for that component only."},"1383":{"id":"/docs/components/size-provider-14","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Overlays opened inside, such as Modal and Select options, open at the scope's size even though\nthey render in a portal."},"1384":{"id":"/docs/components/size-provider-15","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Renders no element, so it never affects layout. Only Antares components follow it; plain HTML\nkeeps its own typography, so put copy in `Text`."},"1385":{"id":"/docs/components/size-provider-16","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Without any scope, components use `md`."},"1386":{"id":"/docs/components/size-provider-17","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Adopted so far by Text, Detail, Heading, Label, Button, LinkButton, TextField, NumberField, Select,\nDatePicker, DateRangePicker, Calendar, TextLockup, Modal, Drawer, Popover, and Tooltip. Other\ncomponents keep their own size. Layout spacing props keep their meaning: `gap=\"md\"` is the layout\n`md` gap in any scope."},"1387":{"id":"/docs/components/size-provider-18","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#default","content":"A scope sizes everything inside it: text, controls, and default spacing. A component's own\n`size` still wins."},"1388":{"id":"/docs/components/size-provider-19","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#sizes","content":"The same section at each size. Without a scope, components use `md`."},"1389":{"id":"/docs/components/size-provider-20","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#form","content":"Wrap a whole form to size it at once. Fields, their labels and descriptions, choices, and\nbuttons all follow the scope, so they stay aligned with each other."},"1390":{"id":"/docs/components/size-provider-21","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#nested-scopes","content":"The nearest scope wins. An inner scope replaces the outer size rather than scaling it, so an\n`sm` section inside an `lg` page matches `sm` anywhere else."},"1391":{"id":"/docs/components/size-provider-22","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#explicit-size","content":"A component's own `size` wins for that component and every part inside it, such as a field's\nlabel and description. Its siblings keep following the scope."},"1392":{"id":"/docs/components/size-provider-23","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#overlays","content":"Overlays open at the size of the scope around their trigger, even though they render in a\nportal. An explicit `size` on the owner sizes its overlay too."},"1393":{"id":"/docs/components/size-provider-24","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#plain-html","content":"A scope sizes Antares components only. Plain HTML keeps its own typography, so put copy in\n`Text` to follow the scope."},"1394":{"id":"/docs/components/structure","page_id":"/docs/components/structure","type":"page","content":"Structure primitives","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/structure"},"1395":{"id":"/docs/components/structure-0","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"Generic structural containers for composing a component's interior."},"1396":{"id":"/docs/components/structure-1","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#hybrid-styling","content":"Hybrid styling"},"1397":{"id":"/docs/components/structure-2","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#examples","content":"Examples"},"1398":{"id":"/docs/components/structure-3","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#default","content":"Default"},"1399":{"id":"/docs/components/structure-4","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#group","content":"Group"},"1400":{"id":"/docs/components/structure-5","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#props","content":"Props"},"1401":{"id":"/docs/components/structure-6","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#content","content":"Content"},"1402":{"id":"/docs/components/structure-7","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#header","content":"Header"},"1403":{"id":"/docs/components/structure-8","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#footer","content":"Footer"},"1404":{"id":"/docs/components/structure-9","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#buttongroup","content":"ButtonGroup"},"1405":{"id":"/docs/components/structure-10","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#group-1","content":"Group"},"1406":{"id":"/docs/components/structure-11","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**Shared structural containers.** These generic, layout-only components are the building blocks for composing a component's interior (a `Modal`, a card, a panel). They are semantic containers built on `Flex`, so they accept the same layout props (`direction`, `gap`, `alignItems`, `justifyContent`, `padding`, ...)."},"1407":{"id":"/docs/components/structure-12","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Content`** — the primary body region (a `<section>`, a column that grows to fill)."},"1408":{"id":"/docs/components/structure-13","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Header`** — the top region: title area and optional trailing close (a `<header>` row that spaces its contents apart)."},"1409":{"id":"/docs/components/structure-14","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Footer`** — the bottom region: secondary content and/or actions (a `<footer>` row that spaces its contents apart)."},"1410":{"id":"/docs/components/structure-15","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`ButtonGroup`** - a cluster of related actions (a wrapping row with `role=\"group\"`). Overlay parents like `Modal` adopt it with end alignment and padding."},"1411":{"id":"/docs/components/structure-16","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Group`** — semantic grouping container for field item controls. A parent field injects the box chrome."},"1412":{"id":"/docs/components/structure-17","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"Each container works in two modes:"},"1413":{"id":"/docs/components/structure-18","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"**Standalone** - with no parent context it renders with its own structural defaults and looks the same everywhere."},"1414":{"id":"/docs/components/structure-19","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"**Adopted** - inside a parent that provides its context (e.g. `Modal`), it picks up that parent's styling and spacing automatically. Consumer props still win over the adopted defaults."},"1415":{"id":"/docs/components/structure-20","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#default","content":"The shared structural containers composed together into a card-like layout. Each is a\nplain semantic region here; inside a parent that provides their contexts (e.g. `Modal`)\nthey adopt that parent's spacing automatically."},"1416":{"id":"/docs/components/structure-21","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#group","content":"Group is the bordered field box. Size and invalid/disabled chrome apply here."},"1417":{"id":"/docs/components/switch","page_id":"/docs/components/switch","type":