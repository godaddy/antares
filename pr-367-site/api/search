d Pagination keeps the current page in consumer state."},"1040":{"id":"/docs/components/pagination-23","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#page-count-known","content":"Page navigation with a known page count and a consumer-owned page-size Select."},"1041":{"id":"/docs/components/pagination-24","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#page-count-unknown","content":"Page Count Unknown: the consumer controls the next boundary."},"1042":{"id":"/docs/components/pagination-25","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#minimal","content":"Minimal previous/next pagination."},"1043":{"id":"/docs/components/pagination-26","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#pagination-dots","content":"Opt-in visual PaginationDots between previous and next controls."},"1044":{"id":"/docs/components/pagination-27","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#customization","content":"Pagination is composed: pass only the regions your layout needs. Previous and\nnext `Button`s and the page `Input` receive navigation defaults from\nPagination, while explicit child props—including disabled-state props—and\n`className` values remain available for local customization. Separator, page count,\n`Select` and\n`PaginationDots` are consumer-owned."},"1045":{"id":"/docs/components/pagination-28","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#customization","content":"Use `className` to extend styling without replacing the interaction behavior\nprovided by Antares."},"1046":{"id":"/docs/components/pagination-29","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#accessibility","content":"Pagination does not add translated labels. Provide accessible names for the\nnavigation region, previous/next buttons and page input."},"1047":{"id":"/docs/components/pagination-30","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#accessibility","content":"`PaginationDots` is decorative and does not replace interactive page\ncontrols."},"1048":{"id":"/docs/components/pagination-31","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#accessibility","content":"For interactive page links, compose explicit `Button` or `LinkButton` children and\nprovide the active state with `aria-current=\"page\"`."},"1049":{"id":"/docs/components/pagination-32","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Pass `pageCount` when the backend exposes a known number of pages."},"1050":{"id":"/docs/components/pagination-33","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Omit `pageCount` for cursor-based data and disable the composed next button\nwhen the backend reports that there is no next page."},"1051":{"id":"/docs/components/pagination-34","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Keep total items, page size and result ranges in the consuming data layer."},"1052":{"id":"/docs/components/pagination-35","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Compose exactly one page `Input`; use a separate component for advanced range\nnavigation."},"1053":{"id":"/docs/components/pressable","page_id":"/docs/components/pressable","type":"page","content":"Pressable","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pressable"},"1054":{"id":"/docs/components/pressable-0","page_id":"/docs/components/p