,"406":{"id":"/docs/components/collapsible-23","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Accessible keyboard interaction and button-to-panel relationships powered by React Aria Components."},"407":{"id":"/docs/components/collapsible-24","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#default","content":"Reveal optional details without an Accordion group."},"408":{"id":"/docs/components/collapsible-25","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#controlled","content":"Control a section from application state or an external action."},"409":{"id":"/docs/components/collapsible-26","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#with-status","content":"Pair a status icon with text so completion is understandable without the icon."},"410":{"id":"/docs/components/collapsible-27","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#disabled","content":"Keep unavailable details disabled, including when their content starts visible."},"411":{"id":"/docs/components/collapsible-28","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Place a `Heading` containing `Button slot=\"trigger\"` inside Collapsible, followed by CollapsiblePanel.\nAdd an `Icon slot=\"indicator\"` inside the button for the expansion indicator. The panel accepts text,\nlinks, forms, and other components."},"412":{"id":"/docs/components/collapsible-29","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"CollapsiblePanel provides the content spacing automatically. Use `contentProps` to customize its\ninner container with Box spacing props, a class name, or styles:"},"413":{"id":"/docs/components/collapsible-30","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `contentProps={{ padding: '0' }}` for content without padding. Props supplied directly to\nCollapsiblePanel, including `className`, `style`, and `ref`, apply to the outer panel."},"414":{"id":"/docs/components/collapsible-31","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `defaultExpanded` for initial expansion, or `isExpanded` with `onExpandedChange` for controlled\nstate. The callback receives a boolean. Use the Accordion component to coordinate several sections;\nin that composition, manage expansion through the group."},"415":{"id":"/docs/components/collapsible-32","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `className` and `style` to customize each component. Button supports string or state-based\n`className` values. Components expose these data attributes for state-based styling:"},"416":{"id":"/docs/components/collapsible-33","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"`Collapsible`: `data-expanded`, `data-disabled`, and `data-focus-visible-within`."},"417":{"id":"/docs/components/collapsible-34","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Trigger `Button`: `data-hovered`, `data-pressed`, `data-focus-visible`, and `data-disabled`."},"418":{"id":"/docs/components/collapsible-35","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"`CollapsiblePanel`: `data-focus-visible-within`."},"419":{"id":"/docs/components/collapsible-36","page_id":"/docs/components/collapsible","tags":[],"type":"text","ur