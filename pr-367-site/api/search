components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#when-to-use-a-segmented-controller","content":"When to Use a Segmented Controller"},"1302":{"id":"/docs/components/segmented-controller-18","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#when-not-to-use","content":"When Not to Use"},"1303":{"id":"/docs/components/segmented-controller-19","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#props","content":"Props"},"1304":{"id":"/docs/components/segmented-controller-20","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#segmentedcontroller","content":"SegmentedController"},"1305":{"id":"/docs/components/segmented-controller-21","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#segmentedcontrolleritem","content":"SegmentedControllerItem"},"1306":{"id":"/docs/components/segmented-controller-22","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#default","content":"An uncontrolled segmented controller with a default selection. The component manages its own state internally via `defaultValue`."},"1307":{"id":"/docs/components/segmented-controller-23","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#controlled","content":"Use `value` and `onSelectionChange` to fully control the selected segment from parent state."},"1308":{"id":"/docs/components/segmented-controller-24","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#sizes","content":"Three sizes are available: `sm`, `md` (default), and `lg`."},"1309":{"id":"/docs/components/segmented-controller-25","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#icon--text","content":"Segments can include an `Icon` alongside text for added visual context."},"1310":{"id":"/docs/components/segmented-controller-26","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#icon-only","content":"For compact layouts, segments can contain only icons. Provide an `aria-label` on each item so screen readers can identify the action."},"1311":{"id":"/docs/components/segmented-controller-27","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#overflow","content":"When the number of options exceeds the width of the container, the component automatically shows scroll buttons to let users navigate. Users can also scroll horizontally to navigate the options."},"1312":{"id":"/docs/components/segmented-controller-28","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#rtl-direction","content":"The segmented controller follows the current layout direction (LTR or RTL), detected automatically from the browser or system settings."},"1313":{"id":"/docs/components/segmented-controller-29","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#disabled-states","content":"Disable the entire group with `isDisabled` on the container, or disable individual segments with `isDisabled` on specific items."},"1314":{"id":"/docs/components/segmented-controller-30","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#data-attributes","content":"Components automatically add data attributes for styling different states:"},"1315":{"id":"/docs/components/segmented-controller-31","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#data-attributes","content":"**SegmentedController Container:** `data-disabled`"},"1316":{"id":"/docs/components/segmented-controller-32","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#data-attributes","content":"**SegmentedControllerItem:** `data-selected`, `data-hovered`, `data-pressed`, `data-focus-visible`, `data-disabled`"},"1317":{"id":"/docs/components/segmented-controller-33","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#keyboard-navigation","content":"**Tab**: Moves focus to/from the segmented controller"},"1318":{"id":"/docs/components/segmented-controller-34","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#keyboard-navigation","content":"**Arrow Left/Right**: Move to next/previous segment"},"1319":{"id":"/docs/components/segmented-controller-35","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#keyboard-navigation","content":"**Space/Enter**: Select the focused segment"},"1320":{"id":"/docs/components/segmented-controller-36","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#aria-support","content":"`role=\"radiogroup\"` on the container"},"1321":{"id":"/docs/components/segmented-controller-37","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#aria-support","content":"`role=\"radio\"` on each segment"},"1322":{"id":"/docs/components/segmented-controller-38","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#aria-support","content":"`aria-checked` indicates selection state"},"1323":{"id":"/docs/components/segmented-controller-39","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#aria-support","content":"`aria-disabled` for disabled segments"},"1324":{"id":"/docs/components/segmented-controller-40","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#aria-support","content":"`aria-label` required on the container for screen readers"},"1325":{"id":"/docs/components/segmented-controller-41","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#when-to-use-a-segmented-controller","content":"When switching between 2-5 related views within the same context"},"1326":{"id":"/docs/components/segmented-controller-42","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#when-to-use-a-segmented-controller","content":"When all options should be visible at once"},"1327":{"id":"/docs/components/segmented-controller-43","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#when-to-use-a-segmented-controller","content":"When the selection immediately changes the displayed content"},"1328":{"id":"/docs/components/segmented-controller-44","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#when-not-to-use","content":"For more than 5 options (use Tabs or Select instead)"},"1329":{"id":"/docs/components/segmented-controller-45","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#when-not-to-use","content":"For form input (use RadioGroup instead)"},"1330":{"id":"/docs/components/select","page_id":"/docs/components/select","type":"page","content":"Select","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/select"},"1331":{"id":"/docs/components/select-0","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select","content":"Select is a dropdown for picking one or more values from a list of options. It renders a labeled trigger and a popover listbox, supports single and multiple selection, and submits naturally inside a form."},"1332":{"id":"/docs/components/select-1","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#features","content":"Features"},"1333":{"id":"/docs/components/select-2","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#installation","content":"Installation"},"1334":{"id":"/docs/components/select-3","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#examples","content":"Examples"},"1335":{"id":"/docs/components/select-4","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#default","content":"Default"},"1336":{"id":"/docs/components/select-5","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#controlled","content":"Controlled"},"1337":{"id":"/docs/components/select-6","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#multiple","content":"Multiple"},"1338":{"id":"/docs/components/select-7","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#invalid","content":"Invalid"},"1339":{"id":"/docs/components/select-8","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#disabled","content":"Disabled"},"1340":{"id":"/docs/components/select-9","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#form","content":"Form"},"1341":{"id":"/docs/components/select-10","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#sizes","content":"Sizes"},"1342":{"id":"/docs/components/select-11","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#composed","content":"Composed"},"1343":{"id":"/docs/components/select-12","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#props","content":"Props"},"1344":{"id":"/docs/components/select-13","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#select","content":"Select"},"1345":{"id":"/docs/components/select-14","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#selectoptions","content":"SelectOptions"},"1346":{"id":"/docs/components/select-15","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#selectvalue","content":"SelectValue"},"1347":{"id":"/docs/components/select-16","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#selectitem","content":"SelectItem"},"1348":{"id":"/docs/components/select-17","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Composable interior**: Compose `Label`, a `Button slot=\"trigger\"`, `SelectOptions`, and optional `Text` / `FieldError`. Nothing is added for you, and what you write keeps the order you wrote it in"},"1349":{"id":"/docs/components/select-18","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Trigger and options**: An empty `Button slot=\"trigger\"` renders the selected value and a chevron from the field. `SelectOptions` is the list in the popover the Select opens: it takes `ListBox` props (including `items` with a render function for a dynamic collection) plus `popoverProps` for the overlay. Write `Popover`, `Content`, and `ListBox` yourself to replace the whole overlay"},"1350":{"id":"/docs/components/select-19","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Composed in another field**: Use `variant=\"control\"` to sit inside another field's `Group`, as a country-code select beside a phone `Input`"},"1351":{"id":"/docs/components/select-20","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Single or multiple selection**: Set `selectionMode=\"multiple\"` to allow multiple values"},"1352":{"id":"/docs/components/select-21","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"1353":{"id":"/docs/components/select-22","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"1354":{"id":"/docs/components/select-23","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Sizes**: The field is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets the label, trigger, and options, which open at the same size even though they render in a portal. Without it, the Select follows the surrounding scope"},"1355":{"id":"/docs/components/select-24","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Form integration**: Set `name` and the value submits as part of a native `<form>` (multiple values submit as repeated entries)"},"1356":{"id":"/docs/components/select-25","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**React Aria integration**: Built on React Aria Select for accessibility, keyboard navigation, and typeahead"},"1357":{"id":"/docs/components/select-26","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#default","content":"Minimal usage with a `Label`, items, and a placeholder."},"1358":{"id":"/docs/components/select-27","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#controlled","content":"Use `value` and `onChange` for controlled state."},"1359":{"id":"/docs/components/select-28","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#multiple","content":"Set `selectionMode=\"multiple\"` to allow multiple values. `value` is an array of keys."},"1360":{"id":"/docs/components/select-29","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#invalid","content":"Use `isInvalid` with a `FieldError` for validation feedback."},"1361":{"id":"/docs/components/select-30","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#disabled","content":"Use `isDisabled` to prevent interaction."},"1362":{"id":"/docs/components/select-31","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#form","content":"Set `name` to submit the value with a native `<form>`. Multiple-mode values submit as repeated entries with the same `name`."},"1363":{"id":"/docs/components/select-32","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#sizes","content":"Compare the supported `md` and `sm` visual sizes."},"1364":{"id":"/docs/components/select-33","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#composed","content":"Write the trigger and the overlay yourself instead of composing `SelectOptions`, for full control\nover the popover and the list."},"1365":{"id":"/docs/components/size-provider","page_id":"/docs/components/size-provider","type":"page","content":"SizeProvider","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/size-provider"},"1366":{"id":"/docs/components/size-provider-0","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider","content":"Sizes a section, so the text, controls, and default spacing inside it follow one size."},"1367":{"id":"/docs/components/size-provider-1","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#features","content":"Features"},"1368":{"id":"/docs/components/size-provider-2","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#examples","content":"Examples"},"1369":{"id":"/docs/components/size-provider-3","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#default","content":"Default"},"1370":{"id":"/docs/components/size-provider-4","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#sizes","content":"Sizes"},"1371":{"id":"/docs/components/size-provider-5","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#form","content":"Form"},"1372":{"id":"/docs/components/size-provider-6","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#nested-scopes","content":"Nested Scopes"},"1373":{"id":"/docs/components/size-provider-7","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#explicit-size","content":"Explicit Size"},"1374":{"id":"/docs/components/size-provider-8","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#overlays","content":"Overlays"},"1375":{"id":"/docs/components/size-provider-9","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#plain-html","content":"Plain Html"},"1376":{"id":"/docs/components/size-provider-10","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#props","content":"Props"},"1377":{"id":"/docs/components/size-provider-11","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"`sm`, `md`, or `lg` for the adopted components inside (listed below): their text, controls, and\ndefault spacing."},"1378":{"id":"/docs/components/size-provider-12","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"The nearest scope wins, and nested scopes replace the size rather than compounding it."},"1379":{"id":"/docs/components/size-provider-13","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"A component's own `size` prop wins for that component only."},"1380":{"id":"/docs/components/size-provider-14","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Overlays opened inside, such as Modal and Select options, open at the scope's size even though\nthey render in a portal."},"1381":{"id":"/docs/components/size-provider-15","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Renders no element, so it never affects layout. Only Antares components follow it; plain HTML\nkeeps its own typography, so put copy in `Text`."},"1382":{"id":"/docs/components/size-provider-16","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Without any scope, components use `md`."},"1383":{"id":"/docs/components/size-provider-17","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Adopted so far by Text, Detail, Heading, Label, Button, LinkButton, TextField, NumberField, Select,\nDatePicker, DateRangePicker, Calendar, TextLockup, Modal, Drawer, Popover, and Tooltip. Other\ncomponents keep their own size. Layout spacing props keep their meaning: `gap=\"md\"` is the layout\n`md` gap in any scope."},"1384":{"id":"/docs/components/size-provider-18","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#default","content":"A scope sizes everything inside it: text, controls, and default spacing. A component's own\n`size` still wins."},"1385":{"id":"/docs/components/size-provider-19","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#sizes","content":"The same section at each size. Without a scope, components use `md`."},"1386":{"id":"/docs/components/size-provider-20","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#form","content":"Wrap a whole form to size it at once. Fields, their labels and descriptions, choices, and\nbuttons all follow the scope, so they stay aligned with each other."},"1387":{"id":"/docs/components/size-provider-21","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#nested-scopes","content":"The nearest scope wins. An inner scope replaces the outer size rather than scaling it, so an\n`sm` section inside an `lg` page matches `sm` anywhere else."},"1388":{"id":"/docs/components/size-provider-22","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#explicit-size","content":"A component's own `size` wins for that component and every part inside it, such as a field's\nlabel and description. Its siblings keep following the scope."},"1389":{"id":"/docs/components/size-provider-23","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#overlays","content":"Overlays open at the size of the scope around their trigger, even though they render in a\nportal. An explicit `size` on the owner sizes its overlay too."},"1390":{"id":"/docs/components/size-provider-24","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#plain-html","content":"A scope sizes Antares components only. Plain HTML keeps its own typography, so put copy in\n`Text` to follow the scope."},"1391":{"id":"/docs/components/structure","page_id":"/docs/components/structure","type":"page","content":"Structure primitives","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/structure"},"1392":{"id":"/docs/components/structure-0","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"Generic structural containers for composing a component's interior."},"1393":{"id":"/docs/components/structure-1","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#hybrid-styling","content":"Hybrid styling"},"1394":{"id":"/docs/components/structure-2","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#examples","content":"Examples"},"1395":{"id":"/docs/components/structure-3","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#default","content":"Default"},"1396":{"id":"/docs/components/structure-4","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#group","content":"Group"},"1397":{"id":"/docs/components/structure-5","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#props","content":"Props"},"1398":{"id":"/docs/components/structure-6","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#content","content":"Content"},"1399":{"id":"/docs/components/structure-7","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#header","content":"Header"},"1400":{"id":"/docs/components/structure-8","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#footer","content":"Footer"},"1401":{"id":"/docs/components/structure-9","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#buttongroup","content":"ButtonGroup"},"1402":{"id":"/docs/components/structure-10","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#group-1","content":"Group"},"1403":{"id":"/docs/components/structure-11","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**Shared structural containers.** These generic, layout-only components are the building blocks for composing a component's interior (a `Modal`, a card, a panel). They are semantic containers built on `Flex`, so they accept the same layout props (`direction`, `gap`, `alignItems`, `justifyContent`, `padding`, ...)."},"1404":{"id":"/docs/components/structure-12","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Content`** — the primary body region (a `<section>`, a column that grows to fill)."},"1405":{"id":"/docs/components/structure-13","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Header`** — the top region: title area and optional trailing close (a `<header>` row that spaces its contents apart)."},"1406":{"id":"/docs/components/structure-14","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Footer`** — the bottom region: secondary content and/or actions (a `<footer>` row that spaces its contents apart)."},"1407":{"id":"/docs/components/structure-15","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`ButtonGroup`** - a cluster of related actions (a wrapping row with `role=\"group\"`). Overlay parents like `Modal` adopt it with end alignment and padding."},"1408":{"id":"/docs/components/structure-16","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Group`** — semantic grouping container for field item controls. A parent field injects the box chrome."},"1409":{"id":"/docs/components/structure-17","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"Each container works in two modes:"},"1410":{"id":"/docs/components/structure-18","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"**Standalone** - with no parent context it renders with its own structural defaults and looks the same everywhere."},"1411":{"id":"/docs/components/structure-19","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"**Adopted** - inside a parent that provides its context (e.g. `Modal`), it picks up that parent's styling and spacing automatically. Consumer props still win over the adopted defaults."},"1412":{"id":"/docs/components/structure-20","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#default","content":"The shared structural containers composed together into a card-like layout. Each is a\nplain semantic region here; inside a parent that provides their contexts (e.g. `Modal`)\nthey adopt that parent's spacing automatically."},"1413":{"id":"/docs/components/structure-21","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#group","content":"Group is the bordered field box. Size and invalid/disabled chrome apply here."},"1414":{"id":"/docs/components/switch","page_id":"/docs/components/switch","type":"page","content":"Switch","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/switch"},"1415":{"id":"/docs/components/switch-0","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch","content":"A binary toggle control that switches a setting between on and off states, communicated via the WAI-ARIA switch role."},"1416":{"id":"/docs/components/switch-1","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#features","content":"Features"},"1417":{"id":"/docs/components/switch-2","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#installation","content":"Installation"},"1418":{"id":"/docs/components/switch-3","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#examples","content":"Examples"},"1419":{"id":"/docs/components/switch-4","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#default","content":"Default"},"1420":{"id":"/docs/components/switch-5","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#switch-selected","content":"Switch Selected"},"1421":{"id":"/docs/components/switch-6","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#switch-sizes","content":"Switch Sizes"},"1422":{"id":"/docs/components/switch-7","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#switch-label-position","content":"Switch Label Position"},"1423":{"id":"/docs/components/switch-8","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#no-label","content":"No Label"},"1424":{"id":"/docs/components/switch-9","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#switch-disabled","content":"Switch Disabled"},"1425":{"id":"/docs/com