ents. You can also use render props in `className` to style based on state (e.g., `className={({ isSelected }) => isSelected ? 'active' : ''}`)."},"1531":{"id":"/docs/components/tabs-38","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"Use `TabList`'s `containerProps` to customize the outer tab list shell, such as increasing its width."},"1532":{"id":"/docs/components/tabs-39","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Use Tabs for peer panels on the same page and URL."},"1533":{"id":"/docs/components/tabs-40","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Keep the number of tabs small enough for users to understand the available sections."},"1534":{"id":"/docs/components/tabs-41","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not use Tabs for primary application navigation or route changes."},"1535":{"id":"/docs/components/tabs-42","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not render a standalone `Tab`; compose it inside `Tabs` and `TabList`."},"1536":{"id":"/docs/components/tag","page_id":"/docs/components/tag","type":"page","content":"Tag","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tag"},"1537":{"id":"/docs/components/tag-0","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag","content":"Non-interactive labels that highlight statuses and categories."},"1538":{"id":"/docs/components/tag-1","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#installation","content":"Installation"},"1539":{"id":"/docs/components/tag-2","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#examples","content":"Examp