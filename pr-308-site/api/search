ocs/components/modal-14","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#default","content":"The default modal exposes a `title`, `description`, and `children` content area. Open and close state is managed automatically by `ModalTrigger`."},"689":{"id":"/docs/components/modal-15","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#controlled","content":"Pass `isOpen` and `onOpenChange` to `ModalTrigger` to control the open state externally."},"690":{"id":"/docs/components/modal-16","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#with-actions","content":"Render footer buttons via the `actions` prop. Use `slot=\"close\"` on a button to close the modal automatically when pressed."},"691":{"id":"/docs/components/modal-17","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#alignment","content":"Use `centered` to center the title and description, and `actionProps` to control the alignment and direction of the action buttons."},"692":{"id":"/docs/components/modal-18","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#with-media","content":"Pass a `media` element to display imagery alongside the content. Configure its layout with `mediaVariant` (`full` or `inset`), `mediaDirection` (`column` or `row`), and `mediaPosition` (`start` or `end`)."},"693":{"id":"/docs/components/modal-19","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Key"},"694":{"id":"/docs/components/modal-20","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Action"},"695":{"id":"/docs/components/modal-21","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"`Tab`"},"696":{"id":"/docs/components/modal-22",