umber-field#best-practices","content":"Remember valid steps start from &#x2A;*`minValue`**."},"795":{"id":"/docs/components/number-field-34","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#best-practices","content":"Use &#x2A;*`isDisabled`*&#x2A; when the value cannot be changed; use &#x2A;*`isReadOnly`** when the value should be visible but not editable. Do not use them interchangeably."},"796":{"id":"/docs/components/number-field-35","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#best-practices","content":"For currency or units, ensure &#x2A;*`formatOptions`** (and locale) match what users are allowed to type."},"797":{"id":"/docs/components/number-field-36","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#props","content":"The `NumberField` component accepts the following props:"},"798":{"id":"/docs/components/pagination","page_id":"/docs/components/pagination","type":"page","content":"Pagination","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pagination"},"799":{"id":"/docs/components/pagination-0","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination","content":"A pagination component with prev/next buttons and dot indicators, configurable page limits, and optional visibility of controls and dots"},"800":{"id":"/docs/components/pagination-1","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#installation","content":"Installation"},"801":{"id":"/docs/components/pagination-2","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#examples","content":"Examples"},"802":{"id":"/docs/components/pagination-3","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#default","content":"Default"},"803":{"id":"/docs/components/pagination-4","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#controlled","content":"Controlled"},"804":{"id":"/docs/components/pagination-5","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#default-active","content":"Default Active"},"805":{"id":"/docs/components/pagination-6","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#with-limit","content":"With Limit"},"806":{"id":"/docs/components/pagination-7","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#onchange-event","content":"onChange Event"},"807":{"id":"/docs/components/pagination-8","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#props","content":"Props"},"808":{"id":"/docs/components/pagination-9","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#default","content":"The default pagination is uncontrolled. It renders prev/next buttons and one dot per page. The `total` prop sets the number of items."},"809":{"id":"/docs/components/pagination-10","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#controlled","content":"Pass `activeIndex` and `onChange` to control the active page externally."},"810":{"id":"/docs/components/pagination-11","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#default-active","content":"Use `defaultActiveIndex` to set the starting page in uncontrolled mode."},"811":{"id":"/docs/components/pagination-12","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#with-limit","content":"Limit the number of items shown per page. When `limit` is greater than 1, the number of pages (dots) is derived from `Math.ceil(total / limit)`. For example, 10 items with a limit of 3 produces 4 pages (dots)."},"812":{"id":"/docs/components/pagination-13","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#onchange-event","content":"The `onChange` callback fires with the new page index whenever the user navigates."},"813":{"id":"/docs/components/popover","page_id":"/docs/components/popover","type":"page","content":"Popover","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/popover"},"814":{"id":"/docs/components/popover-0","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover","content":"The Popover component is an overlay element positioned relative to a trigger element."},"815":{"id":"/docs/components/popover-1","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#installation","content":"Installation"},"816":{"id":"/docs/components/popover-2","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#examples","content":"Examples"},"817":{"id":"/docs/components/popover-3","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#default","content":"Default"},"818":{"id":"/docs/components/popover-4","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#custom-anchor","content":"Custom Anchor"},"819":{"id":"/docs/components/popover-5","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#title-and-close-button","content":"Title and Close Button"},"820":{"id":"/docs/components/popover-6","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#accessibility","content":"Accessibility"},"821":{"id":"/docs/components/popover-7","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#keyboard","content":"Keyboard"},"822":{"id":"/docs/components/popover-8","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#aria","content":"ARIA"},"823":{"id":"/docs/components/popover-9","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#best-practices","content":"Best Practices"},"824":{"id":"/docs/components/popover-10","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#props","content":"Props"},"825":{"id":"/docs/components/popover-11","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover","content":"`PopoverTrigger` wraps a trigger button and a `<Popover>`, handling open state and positioning automatically.\nBased on RAC `DialogTrigger`. To anchor a popover to an element it doesn't wrap, pass `triggerRef` instead."},"826":{"id":"/docs/components/popover-12","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#default","content":"Use it with `<PopoverTrigger>`, which wraps both the popover content and an interactive trigger element (for example, a `Button`)."},"827":{"id":"/docs/components/popover-13","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#custom-anchor","content":"To position a popover relative to a different element than its trigger, use the `triggerRef` and `isOpen` props instead of `<PopoverTrigger>`. `onOpenChange` is called when the user opens or closes the popover."},"828":{"id":"/docs/components/popover-14","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#title-and-close-button","content":"Add a `Heading slot=\"title\"` and a `CloseButton` for a titled, dismissible popover. The heading\nalso gives the dialog its accessible name."},"829":{"id":"/docs/components/popover-15","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Key"},"830":{"id":"/docs/components/popover-16","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Action"},"831":{"id":"/docs/components/popover-17","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"`Enter/Space`"},"832":{"id":"/docs/components/popover-18","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Opens the popover from its trigger"},"833":{"id":"/docs/components/popover-19","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"`Escape`"},"834":{"id":"/docs/components/popover-20","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Closes the popover"},"835":{"id":"/docs/components/popover-21","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#aria","content":"`role=\"dialog\"` is applied automatically by the underlying React Aria `Dialog`"},"836":{"id":"/docs/components/popover-22","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#aria","content":"A `Heading slot=\"title\"` labels the dialog via `aria-labelledby`. Without one, a popover inside\na `PopoverTrigger` falls back to being labelled by its trigger; standing alone with\n`triggerRef` it needs an explicit `aria-label`"},"837":{"id":"/docs/components/popover-23","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#best-practices","content":"Pass an `aria-label` when anchoring with `triggerRef` instead of wrapping a `PopoverTrigger`,\nsince there is no trigger to borrow the name from."},"838":{"id":"/docs/components/popover-24","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#best-practices","content":"Popover width is determined by its content, and it's recommended to keep it under 400px."},"839":{"id":"/docs/components/popover-25","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#props","content":"The `Popover` component accepts the following props:"},"840":{"id":"/docs/components/popover-26","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#props","content":"The `PopoverTrigger` component accepts the following props:"},"841":{"id":"/docs/components/pressable","page_id":"/docs/components/pressable","type":"page","content":"Pressable","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pressable"},"842":{"id":"/docs/components/pressable-0","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable","content":"A wrapperless interaction primitive that adds accessible press behavior to a single child element."},"843":{"id":"/docs/components/pressable-1","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#features","content":"Features"},"844":{"id":"/docs/components/pressable-2","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#installation","content":"Installation"},"845":{"id":"/docs/components/pressable-3","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#examples","content":"Examples"},"846":{"id":"/docs/components/pressable-4","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#default","content":"Default"},"847":{"id":"/docs/components/pressable-5","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#customization","content":"Customization"},"848":{"id":"/docs/components/pressable-6","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#accessibility","content":"Accessibility"},"849":{"id":"/docs/components/pressable-7","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#best-practices","content":"Best Practices"},"850":{"id":"/docs/components/pressable-8","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#troubleshooting","content":"Troubleshooting"},"851":{"id":"/docs/components/pressable-9","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#props","content":"Props"},"852":{"id":"/docs/components/pressable-10","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Adds accessible press behavior to an existing visual component."},"853":{"id":"/docs/components/pressable-11","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Applies interaction states directly to the child without adding a wrapper element."},"854":{"id":"/docs/components/pressable-12","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Supports pointer, touch, and keyboard interactions through React Aria."},"855":{"id":"/docs/components/pressable-13","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Preserves the child's layout, shape, and base visual styling while adding state feedback."},"856":{"id":"/docs/components/pressable-14","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#default","content":"Add accessible press behavior to an existing visual component without adding a wrapper element.\nThe surface supports pointer, touch, and keyboard activation."},"857":{"id":"/docs/components/pressable-15","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Pressable` when an existing visual component or layout surface needs press behavior while keeping its own DOM element, layout, and styles. The child must be a single element that forwards its ref and accepts the DOM, ARIA, and event props supplied by React Aria."},"858":{"id":"/docs/components/pressable-16","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Button` when you need a standard button control with button-specific sizing, layout, and visual variants."},"859":{"id":"/docs/components/pressable-17","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Pass `onPress` for the action instead of wiring separate pointer and keyboard handlers:"},"860":{"id":"/docs/components/pressable-18","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"`Pressable` accepts the React Aria press props, including `onPress`, `onPressStart`, `onPressEnd`, `onPressUp`, and `onPressChange`."},"861":{"id":"/docs/components/pressable-19","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Use a semantic interactive element when possible. For a non-semantic child such as `Avatar` or `Box`, provide an appropriate interactive role and an accessible name. Pressable makes the child focusable when the required props are forwarded."},"862":{"id":"/docs/components/pressable-20","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Do not add `role=\"button\"` to a native `<button>` or `<a>` unless you intentionally need to change its semantics. Use a dedicated semantic component such as `Button`, `LinkButton`, `Menu`, or `ToggleButton` when that control's meaning is known."},"863":{"id":"/docs/components/pressable-21","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Prefer a native interactive element or a semantic Antares component when the interaction meaning is known."},"864":{"id":"/docs/components/pressable-22","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Avoid nesting interactive elements inside the child passed to `Pressable`."},"865":{"id":"/docs/components/pressable-23","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"`Pressable` automatically applies React Aria state attributes such as `[data-hovered]`, `[data-pressed]`, `[data-focus-visible]`, and `[data-disabled]` to the child. Ensure the child component styles these states appropriately if it overrides the default `Pressable` styles."},"866":{"id":"/docs/components/pressable-24","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If React Aria warns that the child must be focusable, ensure it is a single element that forwards its ref, `tabIndex`, DOM props, and ARIA attributes."},"867":{"id":"/docs/components/pressable-25","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If `onPress` does not fire, confirm that the child forwards event handlers and is not disabled by another component."},"868":{"id":"/docs/components/progress-bar","page_id":"/docs/components/progress-bar","type":"page","content":"ProgressBar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/progress-bar"},"869":{"id":"/docs/components/progress-bar-0","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar","content":"A progress bar shows determinate progress of an operation over time"},"870":{"id":"/docs/components/progres