g props:"},"997":{"id":"/docs/components/radio-62","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#props","content":"The `RadioGroup` component has the following props:"},"998":{"id":"/docs/components/range-field","page_id":"/docs/components/range-field","type":"page","content":"RangeField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/range-field"},"999":{"id":"/docs/components/range-field-0","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field","content":"RangeField lets users select one numeric value or a related set of values on a bounded scale."},"1000":{"id":"/docs/components/range-field-1","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#features","content":"Features"},"1001":{"id":"/docs/components/range-field-2","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#installation","content":"Installation"},"1002":{"id":"/docs/components/range-field-3","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#examples","content":"Examples"},"1003":{"id":"/docs/components/range-field-4","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#default","content":"Default"},"1004":{"id":"/docs/components/range-field-5","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#controlled","content":"Controlled"},"1005":{"id":"/docs/components/range-field-6","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#disabled","content":"Disabled"},"1006":{"id":"/docs/components/range-field-7","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#labels","content":"Labels"},"1007":{"id":"/docs/components/range-field-8","pa