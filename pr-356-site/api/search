ia","content":"ARIA"},"1600":{"id":"/docs/components/tooltip-10","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#best-practices","content":"Best Practices"},"1601":{"id":"/docs/components/tooltip-11","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#props","content":"Props"},"1602":{"id":"/docs/components/tooltip-12","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#tooltip","content":"Tooltip"},"1603":{"id":"/docs/components/tooltip-13","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#tooltiptrigger","content":"TooltipTrigger"},"1604":{"id":"/docs/components/tooltip-14","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip","content":"Tooltips appear after a short delay when hovering, and immediately when the element receives focus.\nOnce a tooltip has been shown, subsequent tooltips appear without delay."},"1605":{"id":"/docs/components/tooltip-15","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip","content":"`TooltipTrigger` wraps a focusable element and a `<Tooltip>`, handling hover/focus state and positioning automatically."},"1606":{"id":"/docs/components/tooltip-16","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#features","content":"`overlay` elevation panel positioned relative to its trigger, with an optional arrow"},"1607":{"id":"/docs/components/tooltip-17","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#features","content":"Flips and shifts to stay in the viewport"},"1608":{"id":"/docs/components/tooltip-18","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#features","content":"Configurable open and close delays"},"1609":{"id":"/docs/components/tooltip-19","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#default","content":"Use it with `TooltipTrigger`, which wraps both the tooltip content and a focusable element such as a `Button`. The tooltip appears on hover and focus."},"1610":{"id":"/docs/components/tooltip-20","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#custom-anchor","content":"To position a tooltip relative to a different focusable element, use the `triggerRef` prop. `TooltipTrigger` still handles showing and hiding on hover and focus."},"1611":{"id":"/docs/components/tooltip-21","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#customization","content":"`className` and `style` apply to the tooltip panel."},"1612":{"id":"/docs/components/tooltip-22","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Key"},"1613":{"id":"/docs/components/tooltip-23","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Action"},"1614":{"id":"/docs/components/tooltip-24","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"`Tab`"},"1615":{"id":"/docs/components/tooltip-25","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Moves focus to the focusable element and shows the tooltip"},"1616":{"id":"/docs/components/tooltip-26","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"`Escape`"},"1617":{"id":"/docs/components/tooltip-27","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Closes the tooltip"},"1618":{"id":"/docs/components/tooltip-28","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#aria","content":"The tooltip uses `role=\"tooltip\"` and is associated with its focusable element via `aria-describedby`"},"1619":{"id":"/docs/components/tooltip-29","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Keep tooltip content short and informative."},"1620":{"id":"/docs/components/tooltip-30","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Tooltips are not shown on touch screen interactions. Ensure your UI is usable without tooltips."},"1621":{"id":"/docs/components/tooltip-31","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Do not place interactive content inside tooltips. Use a `Popover` instead."},"1622":{"id":"/docs/components/chart/bar-chart","page_id":"/docs/components/chart/bar-chart","type":"page","content":"Bar Chart","breadcrumbs":["Docs","Components","Chart"],"tags":[],"url":"/docs/components/chart/bar-chart"},"1623":{"id":"/docs/components/chart/bar-chart-0","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart","content":"A flexible, accessible, and design-aligned data visualization solution for displaying single or multi-series bar charts."},"1624":{"id":"/docs/components/chart/bar-chart-1","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#features","content":"Features"},"1625":{"id":"/docs/components/chart/bar-chart-2","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#installation","content":"Installation"},"1626":{"id":"/docs/components/chart/bar-chart-3","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#examples","content":"Examples"},"1627":{"id":"/docs/components/chart/bar-chart-4","page_id"