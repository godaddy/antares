,"content":"Best Practices"},"982":{"id":"/docs/components/radio-23","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#when-to-use-radio-buttons","content":"When to Use Radio Buttons"},"983":{"id":"/docs/components/radio-24","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#label-guidelines","content":"Label Guidelines"},"984":{"id":"/docs/components/radio-25","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#validation","content":"Validation"},"985":{"id":"/docs/components/radio-26","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#props","content":"Props"},"986":{"id":"/docs/components/radio-27","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#radio","content":"Radio"},"987":{"id":"/docs/components/radio-28","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#radiogroup","content":"RadioGroup"},"988":{"id":"/docs/components/radio-29","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#default","content":"A radio group with a default selection."},"989":{"id":"/docs/components/radio-30","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#controlled","content":"A controlled radio group using `value` and `onChange`."},"990":{"id":"/docs/components/radio-31","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#horizontal-layout","content":"A radio group arranged horizontally."},"991":{"id":"/docs/components/radio-32","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#disabled-states","content":"Disabled group and individually disabled radio options."},"992":{"id":"/docs/components/radio-33","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio