/components/radio-35","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#error-state","content":"An invalid required group displaying an error message."},"1189":{"id":"/docs/components/radio-36","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-label","content":"A radio group using `aria-label` instead of a visible label."},"1190":{"id":"/docs/components/radio-37","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#form-submission","content":"A radio group integrated with native form submission."},"1191":{"id":"/docs/components/radio-38","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#customization","content":"`RadioGroup` is composed: write `Label`, a `Group` holding the `Radio` items, `Text slot=\"description\"`, and `FieldError`. The `Group` takes its axis, gap, and presentational role from the group's `orientation`, so a bare `<Group>` is all you need; pass your own `direction`/`gap` to lay the items out differently. Each `Radio` takes label text next to the indicator. `orientation` also sets keyboard-navigation direction and ARIA."},"1192":{"id":"/docs/components/radio-39","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#data-attributes","content":"Components automatically add data attributes for styling different states:"},"1193":{"id":"/docs/components/radio-40","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#data-attributes","content":"**RadioGroup Container:** `data-invalid`, `data-disabled`, `data-required`, `data-readonly`, `data-orientation`"},"1194":{"id":"/docs/components/radio-41","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#data-attributes","content":"**Radio Button:** `data-selected`, `data-hovered`, `data-pressed`, `data-focused`, `data-disabled`"},"1195":{"id":"/docs/components/radio-42","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#component-customization","content":"Pass `className` or `style` to customize a radio field container. Use descendant data-attribute selectors to style the interactive radio state:"},"1196":{"id":"/docs/components/radio-43","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Tab**: Moves focus to/from the radio group"},"1197":{"id":"/docs/components/radio-44","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Arrow Down/Right**: Move to next radio button"},"1198":{"id":"/docs/components/radio-45","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Arrow Up/Left**: Move to previous radio button"},"1199":{"id":"/docs/components/radio-46","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Space**: Select the focused radio button"},"1200":{"id":"/docs/components/radio-47","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`role=\"radiogroup\"` on the container"},"1201":{"id":"/docs/components/radio-48","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`role=\"radio\"` on each option"},"1202":{"id":"/docs/components/radio-49","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`aria-checked` indicates selection state"},"1203":{"id":"/docs/components/radio-50","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`aria-disabled` for disabled options"},"1204":{"id":"/docs/components/radio-51","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`aria-required` when selection is required"},"1205":{"id":"/docs/components/radio-52","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`aria-invalid` for validation errors"},"1206":{"id":"/docs/components/radio-53","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"✅ When there are 2-7 mutually exclusive options"},"1207":{"id":"/docs/components/radio-54","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"✅ When all options should be visible at once"},"1208":{"id":"/docs/components/radio-55","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"✅ When the decision is important and deserves space"},"1209":{"id":"/docs/components/radio-56","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ For more than 7 options (use Select instead)"},"1210":{"id":"/docs/components/radio-57","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ For binary yes/no choices (use Checkbox or Toggle instead)"},"1211":{"id":"/docs/components/radio-58","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ When space is limited (use Select dropdown)"},"1212":{"id":"/docs/components/radio-59","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Use clear, concise labels"},"1213":{"id":"/docs/components/radio-60","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Keep labels short (1-3 words when possible)"},"1214":{"id":"/docs/components/radio-61","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Place the most common option first"},"1215":{"id":"/docs/components/radio-62","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Ensure labels are descriptive without being verbose"},"1216":{"id":"/docs/components/radio-63","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#validation","content":"Always provide clear error messages:"},"1217":{"id":"/docs/components/range-field","page_id":"/docs/components/range-field","type":"page","content":"RangeField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/range-field"},"1218":{"id":"/docs/components/range-field-0","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field","content":"RangeField lets users select one numeric value or a related set of values on a bounded scale."},"1219":{"id":"/docs/components/range-field-1","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#features","content":"Features"},"1220":{"id":"/docs/components/range-field-2","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#installation","content":"Installation"},"1221":{"id":"/docs/components/range-field-3","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#examples","content":"Examples"},"1222":{"id":"/docs/components/range-field-4","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#default","content":"Default"},"1223":{"id":"/docs/components/range-field-5","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#controlled","content":"Controlled"},"1224":{"id":"/docs/components/range-field-6","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#disabled","content":"Disabled"},"1225":{"id":"/docs/components/range-field-7","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#labels","content":"Labels"},"1226":{"id":"/docs/components/range-field-8","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#value-display","content":"Value Display"},"1227":{"id":"/docs/components/range-field-9","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#markers","content":"Markers"},"1228":{"id":"/docs/components/range-field-10","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#range","content":"Range"},"1229":{"id":"/docs/components/range-field-11","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#accessibility","content":"Accessibility"},"1230":{"id":"/docs/components/range-field-12","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#accessible-names","content":"Accessible names"},"1231":{"id":"/docs/components/range-field-13","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#keyboard-interaction","content":"Keyboard interaction"},"1232":{"id":"/docs/components/range-field-14","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#best-practices","content":"Best Practices"},"1233":{"id":"/docs/components/range-field-15","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#props","content":"Props"},"1234":{"id":"/docs/components/range-field-16","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#rangefield","content":"RangeField"},"1235":{"id":"/docs/components/range-field-17","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#troubleshooting","content":"Troubleshooting"},"1236":{"id":"/docs/components/range-field-18","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#a-thumb-is-missing-a-label-or-form-value","content":"A thumb is missing a label or form value"},"1237":{"id":"/docs/components/range-field-19","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#typescript-reports-the-wrong-callback-value-type","content":"TypeScript reports the wrong callback value type"},"1238":{"id":"/docs/components/range-field-20","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-controlled-thumbs-do-not-move","content":"The controlled thumbs do not move"},"1239":{"id":"/docs/components/range-field-21","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#values-snap-unexpectedly","content":"Values snap unexpectedly"},"1240":{"id":"/docs/components/range-field-22","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-final-marker-is-missing","content":"The final marker is missing"},"1241":{"id":"/docs/components/range-field-23","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#markers-are-crowded-or-rendering-is-slow","content":"Markers are crowded or rendering is slow"},"1242":{"id":"/docs/components/range-field-24","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-value-or-endpoint-labels-are-blank","content":"The value or endpoint labels are blank"},"1243":{"id":"/docs/components/range-field-25","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#negative-values-do-not-behave-as-expected","content":"Negative values do not behave as expected"},"1244":{"id":"/docs/components/range-field-26","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-range-configuration-is-invalid","content":"The range configuration is invalid"},"1245":{"id":"/docs/components/range-field-27","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Select one value or render one thumb for each value in an array"},"1246":{"id":"/docs/components/range-field-28","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Supports controlled and uncontrolled values with typed change callbacks"},"1247":{"id":"/docs/components/range-field-29","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Provides localized value output, endpoint labels, descriptions, and markers"},"1248":{"id":"/docs/components/range-field-30","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Integrates with native forms, keyboard, pointer, and touch interaction through React Aria"},"1249":{"id":"/docs/components/range-field-31","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#default","content":"Minimal usage with a single value and min/max bounds."},"1250":{"id":"/docs/components/range-field-32","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#controlled","content":"Use `onChange` for immediate updates and `onChangeEnd` for work that should run after interaction finishes."},"1251":{"id":"/docs/components/range-field-33","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#disabled","content":"Use `isDisabled` when the value is visible but unavailable for interaction."},"1252":{"id":"/docs/components/range-field-34","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#labels","content":"Combine an input label, value label, range labels, and helper text when users need additional context."},"1253":{"id":"/docs/components/range-field-35","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#value-display","content":"Use `valueLabel` to show formatted values, static context, or output derived from the current slider state."},"1254":{"id":"/docs/components/range-field-36","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#markers","content":"Use `markers` to expose a manageable set of discrete steps for a single value."},"1255":{"id":"/docs/components/range-field-37","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#range","content":"Pass a `number[]` to render a range with two thumbs and step markers."},"1256":{"id":"/docs/components/range-field-38","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"For a single value, prefer a visible `label`; use `aria-label` only when equivalent visible context already exists."},"1257":{"id":"/docs/components/range-field-39","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"For an array, provide one descriptive `thumbLabels` entry for every value. Entries are matched by index, so keep them aligned when values are added, removed, or reordered. Describe each thumb's purpose, such as `Lower warning threshold`, rather than its current number."},"1258":{"id":"/docs/components/range-field-40","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"`thumbNames` configures native form field names and does not provide accessible labels. Likewise, `valueLabel`, `minLabel`, and `maxLabel` are visual context rather than substitutes for accessible naming."},"1259":{"id":"/docs/components/range-field-41","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Each thumb follows the React Aria slider keyboard model:"},"1260":{"id":"/docs/components/range-field-42","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Tab and Shift+Tab move among thumbs and surrounding controls."},"1261":{"id":"/docs/components/range-field-43","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Arrow Right and Arrow Up increase the focused value by `step`."},"1262":{"id":"/docs/components/range-field-44","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Arrow Left and Arrow Down decrease the focused value by `step`."},"1263":{"id":"/docs/components/range-field-45","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Home and End move the focused thumb to its permitted bounds."},"1264":{"id":"/docs/components/range-field-46","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Page Up and Page Down make larger changes."},"1265":{"id":"/docs/components/range-field-47","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Directional behavior follows the user's locale where appropriate. Pointer, touch, and keyboard interaction all use the same scale and constraints."},"1266":{"id":"/docs/components/range-field-48","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Markers are decorative and hidden from the accessibility tree. Ensure the field label, thumb labels, bounds, step, and formatted values communicate all required information without relying on marker appearance."},"1267":{"id":"/docs/components/range-field-49","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use an array only when every entry has a clear, independently adjustable meaning."},"1268":{"id":"/docs/components/range-field-50","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Keep `value`, `thumbLabels`, and `thumbNames` aligned by index."},"1269":{"id":"/docs/components/range-field-51","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use thumb labels that explain purpose instead of repeating the current number."},"1270":{"id":"/docs/components/range-field-52","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Keep array values in a stable semantic order. If crossing or reordering thumbs would make their meaning ambiguous, enforce the appropriate ordering in product state."},"1271":{"id":"/docs/components/range-field-53","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Avoid large value arrays. Every entry creates another focusable control, which increases keyboard effort and cognitive load."},"1272":{"id":"/docs/components/range-field-54","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Set meaningful `minValue`, `maxValue`, and `step` values. The scale should match the precision users actually need."},"1273":{"id":"/docs/components/range-field-55","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use markers only when there are few enough steps to scan. Tiny steps across a large range can create an excessive number of DOM elements."},"1274":{"id":"/docs/components/range-field-56","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `formatOptions` for currency, percentages, measurements, and other locale-sensitive units so values display and announce their meaning."},"1275":{"id":"/docs/components/range-field-57","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `description` for persistent guidance and `isRequired` when a value is required."},"1276":{"id":"/docs/components/range-field-58","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `isDisabled` when the value should remain visible but unavailable for interaction."},"1277":{"id":"/docs/components/range-field-59","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `onChange` for lightweight immediate feedback and `onChangeEnd` for expensive requests, filtering, or calculations."},"1278":{"id":"/docs/components/range-field-60","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use a text-entry control when exact numeric input is essential. A track is best for exploring or adjusting values within known bounds."},"1279":{"id":"/docs/components/range-field-61","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#a-thumb-is-missing-a-label-or-form-value","content":"Check the same index in `thumbLabels` and `thumbNames`. Each array entry renders a thumb, and its accessible label and form name are read from the corresponding positions. A form name does not replace an accessible label."},"1280":{"id":"/docs/components/range-field-62","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#typescript-reports-the-wrong-callback-value-type","content":"Keep the controlled or default value and callback signatures consistent. When inference is unavailable, provide the generic explicitly: `<RangeField<number>>` for a scalar or `<RangeField<number[]>>` for an array."},"1281":{"id":"/docs/components/range-field-63","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-controlled-thumbs-do-not-move","content":"The `value` prop is the source of truth. Update the scalar or array in `onChange` without changing its intended shape. For arrays, return a new array so application state observes the update."},"1282":{"id":"/docs/components/range-field-64","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#values-snap-unexpectedly","content":"Verify that `step` represents the intended interval from `minValue`. Every thumb snaps to valid positions on the same configured scale."},"1283":{"id":"/docs/components/range-field-65","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-final-marker-is-missing","content":"Markers begin at `minValue` and appear at complete step positions. `maxValue` receives a marker only when the range is evenly divisible by `step`."},"1284":{"id":"/docs/components/range-field-66","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#markers-are-crowded-or-rendering-is-slow","content":"Increase `step` or omit `markers`. Large ranges with small steps can produce many decorative elements even when users cannot distinguish them visually."},"1285":{"id":"/docs/components/range-field-67","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-value-or-endpoint-labels-are-blank","content":"Enable automatic current-value output with `valueLabel={true}` or provide custom content. `minLabel` and `maxLabel` display only explicitly supplied content; neither defaults to a numeric bound or receives `formatOptions`."},"1286":{"id":"/docs/components/range-field-68","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#negative-values-do-not-behave-as-expected","content":"Negative values are supported. Set a negative `minValue` and ensure every scalar or array value remains within the configured bounds."},"1287":{"id":"/docs/components/range-field-69","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-range-configuration-is-invalid","content":"Provide finite bounds where `minValue` is less than `maxValue`, a finite `step` greater than zero, and finite values inside the configured range."},"1288":{"id":"/docs/components/select","page_id":"/docs/components/select","type":"page","content":"Select","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/select"},"1289":{"id":"/docs/components/select-0","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select","content":"Select is a dropdown for picking one or more values from a list of options. It renders a labeled trigger and a popover listbox, supports single and multiple selection, and submits naturally inside a form."},"1290":{"id":"/docs/components/select-1","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#features","content":"Features"},"1291":{"id":"/docs/components/select-2","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#installation","content":"Installation"},"1292":{"id":"/docs/components/select-3","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#examples","content":"Examples"},"1293":{"id":"/docs/components/select-4","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#default","content":"Default"},"1294":{"id":"/docs/components/select-5","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#controlled","content":"Controlled"},"1295":{"id":"/docs/components/select-6","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#multiple","content":"Multiple"},"1296":{"id":"/docs/components/select-7","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#invalid","content":"Invalid"},"1297":{"id":"/docs/components/select-8","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#disabled","content":"Disabled"},"1298":{"id":"/docs/components/select-9","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#form","content":"Form"},"1299":{"id":"/docs/components/select-10","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#sizes","content":"Sizes"},"1300":{"id":"/docs/components/select-11","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#composed","content":"Composed"},"1301":{"id":"/docs/components/select-12","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#props","content":"Props"},"1302":{"id":"/docs/components/select-13","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#select","content":"Select"},"1303":{"id":"/docs/components/select-14","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#selectoptions","content":"SelectOptions"},"1304":{"id":"/docs/components/select-15","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#selectvalue","content":"SelectValue"},"1305":{"id":"/docs/components/select-16","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#selectitem","content":"SelectItem"},"1306":{"id":"/docs/components/select-17","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Composable interior**: Compose `Label`, a `Button slot=\"trigger\"`, `SelectOptions`, and optional `Text` / `FieldError`. Nothing is added for you, and what you write keeps the order you wrote it in"},"1307":{"id":"/docs/components/select-18","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Trigger and options**: An empty `Button slot=\"trigger\"` renders the selected value and a chevron from the field. `SelectOptions` is the list in the popover the Select opens: it takes `ListBox` props (including `items` with a render function for a dynamic collection) plus `popoverProps` for the overlay. Write `Popover`, `Content`, and `ListBox` yourself to replace the whole overlay"},"1308":{"id":"/docs/components/select-19","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Composed in another field**: Use `variant=\"control\"` to sit inside another field's `Group`, as a country-code select beside a phone `Input`"},"1309":{"id":"/docs/components/select-20","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Single or multiple selection**: Set `selectionMode=\"multiple\"` to allow multiple values"},"1310":{"id":"/docs/components/select-21","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"1311":{"id":"/docs/components/select-22","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"1312":{"id":"/docs/components/select-23","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Sizes**: The field is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets the label, trigger, and options, which open at the same size even though they render in a portal. Without it, the Select follows the surrounding scope"},"1313":{"id":"/docs/components/select-24","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Form integration**: Set `name` and the value submits as part of a native `<form>` (multiple values submit as repeated entries)"},"1314":{"id":"/docs/components/select-25","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**React Aria integration**: Built on React Aria Select for accessibility, keyboard navigation, and typeahead"},"1315":{"id":"/docs/components/select-26","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#default","content":"Minimal usage with a `Label`, items, and a placeholder."},"1316":{"id":"/docs/components/select-27","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#controlled","content":"Use `value` and `onChange` for controlled state."},"1317":{"id":"/docs/components/select-28","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#multiple","content":"Set `selectionMode=\"multiple\"` to allow multiple values. `value` is an array of keys."},"1318":{"id":"/docs/components/select-29","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#invalid","content":"Use `isInvalid` with a `FieldError` for validation feedback."},"1319":{"id":"/docs/components/select-30","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#disabled","content":"Use `isDisabled` to prevent interaction."},"1320":{"id":"/docs/components/select-31","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#form","content":"Set `name` to submit the value with a native `<form>`. Multiple-mode values submit as repeated entries with the same `name`."},"1321":{"id":"/docs/components/select-32","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#sizes","content":"Compare the supported `md` and `sm` visual sizes."},"1322":{"id":"/docs/components/select-33","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#composed","content":"Write the trigger and the overlay yourself instead of composing `SelectOptions`, for full control\nover the popover and the list."},"1323":{"id":"/docs/components/size-provider","page_id":"/docs/components/size-provider","type":"page","content":"SizeProvider","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/size-provider"},"1324":{"id":"/docs/components/size-provider-0","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider","content":"Sizes a section, so the text, controls, and default spacing inside it follow one size."},"1325":{"id":"/docs/components/size-provider-1","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#features","content":"Features"},"1326":{"id":"/docs/components/size-provider-2","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#examples","content":"Examples"},"1327":{"id":"/docs/components/size-provider-3","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#default","content":"Default"},"1328":{"id":"/docs/components/size-provider-4","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#sizes","content":"Sizes"},"1329":{"id":"/docs/components/size-provider-5","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#form","content":"Form"},"1330":{"id":"/docs/components/size-provider-6","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#nested-scopes","content":"Nested Scopes"},"1331":{"id":"/docs/components/size-provider-7","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#explicit-size","content":"Explicit Size"},"1332":{"id":"/docs/components/size-provider-8","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#overlays","content":"Overlays"},"1333":{"id":"/docs/components/size-provider-9","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#plain-html","content":"Plain Html"},"1334":{"id":"/docs/components/size-provider-10","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#props","content":"Props"},"1335":{"id":"/docs/components/size-provider-11","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"`sm`, `md`, or `lg` for the adopted components inside (listed below): their text, controls, and\ndefault spacing."},"1336":{"id":"/docs/components/size-provider-12","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"The nearest scope wins, and nested scopes replace the size rather than compounding it."},"1337":{"id":"/docs/components/size-provider-13","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"A component's own `size` prop wins for that component only."},"1338":{"id":"/docs/components/size-provider-14","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Overlays opened inside, such as Modal and Select options, open at the scope's size even though\nthey render in a portal."},"1339":{"id":"/docs/components/size-provider-15","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Renders no element, so it never affects layout. Only Antares components follow it; plain HTML\nkeeps its own typography, so put copy in `Text`."},"1340":{"id":"/docs/components/size-provider-16","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Without any scope, components use `md`."},"1341":{"id":"/docs/components/size-provider-17","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Adopted so far by Text, Detail, Heading, Label, Button, LinkButton, TextField, NumberField, Select,\nDatePicker, DateRangePicker, Calendar, TextLockup, Modal, Drawer, Popover, and Tooltip. Other\ncomponents keep their own size. Layout spacing props keep their meaning: `gap=\"md\"` is the layout\n`md` gap in any scope."},"1342":{"id":"/docs/components/size-provider-18","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#default","content":"A scope sizes everything inside it: text, controls, and default spacing. A component's own\n`size` still wins."},"1343":{"id":"/docs/components/size-provider-19","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#sizes","content":"The same section at each size. Without a scope, components use `md`."},"1344":{"id":"/docs/components/size-provider-20","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#form","content":"Wrap a whole form to size it at once. Fields, their labels and descriptions, choices, and\nbuttons all follow the scope, so they stay aligned with each other."},"1345":{"id":"/docs/components/size-provider-21","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#nested-scopes","content":"The nearest scope wins. An inner scope replaces the outer size rather than scaling it, so an\n`sm` section inside an `lg` page matches `sm` anywhere else."},"1346":{"id":"/docs/components/size-provider-22","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#explicit-size","content":"A component's own `size` wins for that component and every part inside it, such as a field's\nlabel and description. Its siblings keep following the scope."},"1347":{"id":"/docs/components/size-provider-23","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#overlays","content":"Overlays open at the size of the scope around their trigger, even though they render in a\nportal. An explicit `size` on the owner sizes its overlay too."},"1348":{"id":"/docs/components/size-provider-24","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#plain-html","content":"A scope sizes Antares components only. Plain HTML keeps its own typography, so put copy in\n`Text` to follow the scope."},"1349":{"id":"/docs/components/structure","page_id":"/docs/components/structure","type":"page","content":"Structure primitives","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/structure"},"1350":{"id":"/docs/components/structure-0","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"Generic structural containers for composing a component's interior."},"1351":{"id":"/docs/components/structure-1","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#hybrid-styling","content":"Hybrid styling"},"1352":{"id":"/docs/components/structure-2","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#examples","content":"Examples"},"1353":{"id":"/docs/components/structure-3","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#default","content":"Default"},"1354":{"id":"/docs/components/structure-4","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#group","content":"Group"},"1355":{"id":"/docs/components/structure-5","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#props","content":"Props"},"1356":{"id":"/docs/components/structure-6","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#content","content":"Content"},"1357":{"id":"/docs/components/structure-7","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#header","content":"Header"},"1358":{"id":"/docs/components/structure-8","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#footer","content":"Footer"},"1359":{"id":"/docs/components/structure-9","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#buttongroup","content":"ButtonGroup"},"1360":{"id":"/docs/components/structure-10","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#group-1","content":"Group"},"1361":{"id":"/docs/components/structure-11","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**Shared structural containers.** These generic, layout-only components are the building blocks for composing a component's interior (a `Modal`, a card, a panel). They are semantic containers built on `Flex`, so they accept the same layout props (`direction`, `gap`, `alignItems`, `justifyContent`, `padding`, ...)."},"1362":{"id":"/docs/components/structure-12","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Content`** — the primary body region (a `<section>`, a column that grows to fill)."},"1363":{"id":"/docs/components/structure-13","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Header`** — the top region: title area and optional trailing close (a `<header>` row that spaces its contents apart)."},"1364":{"id":"/docs/components/structure-14","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Footer`** — the bottom region: secondary content and/or actions (a `<footer>` row that spaces its contents apart)."},"1365":{"id":"/docs/components/structure-15","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`ButtonGroup`** - a cluster of related actions (a wrapping row with `role=\"group\"`). Overlay parents like `Modal` adopt it with end alignment and padding."},"1366":{"id":"/docs/components/structure-16","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Group`** — semantic grouping container for field item controls. A parent field injects the box chrome."},"1367":{"id":"/docs/components/structure-17","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"Each container works in two modes:"},"1368":{"id":"/docs/components/structure-18","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"**Standalone** - with no parent context it renders with its own structural defaults and looks the same everywhere."},"1369":{"id":"/docs/components/structure-19","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"**Adopted** - inside a parent that provides its context (e.g. `Modal`), it picks up that parent's styling and spacing automatically. Consumer props still win over the adopted defaults."},"1370":{"id":"/docs/components/structure-20","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#default","content":"The shared structural containers composed together into a card-like layout. Each is a\nplain semantic region here; inside a parent that provides their contexts (e.g. `Modal`)\nthey adopt that parent's spacing automatically."},"1371":{"id":"/docs/components/structure-21","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#group","content":"Group is the bordered field box. Size and invalid/disabled chrome apply here."},"1372":{"id":"/docs/components/switch","page_id":"/docs/components/switch","type":"page","content":"Switch","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/switch"},"1373":{"id":"/docs/components/switch-0","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch","content":"A binary toggle control that switches a setting between on and off states, communicated via the WAI-ARIA switch role."},"1374":{"id":"/docs/components/switch-1","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#features","content":"Features"},"1375":{"id":"/docs/components/switch-2","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#installation","content":"Installation"},"1376":{"id":"/docs/components/switch-3","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#examples","content":"Examples"},"1377":{"id":"/docs/components/switch-4","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#default","content":"Default"},"1378":{"id":"/docs/components/switch-5","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#switch-selected","content":"Switch Selected"},"1379":{"id":"/docs/components/switch-6","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#switch-sizes","content":"Switch Sizes"},"1380":{"id":"/docs/components/switch-7","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#switch-label-position","content":"Switch Label Position"},"1381":{"id":"/docs/components/switch-8","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#no-label","content":"No Label"},"1382":{"id":"/docs/components/switch-9","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#switch-disabled","content":"Switch Disabled"},"1383":{"id":"/docs/components/switch-10","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#switch-controlled","content":"Switch Controlled"},"1384":{"id":"/docs/components/switch-11","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#customization","content":"Customization"},"1385":{"id":"/docs/components/switch-12","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#data-attributes","content":"Data Attributes"},"1386":{"id":"/docs/components/switch-13","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#design-tokens","content":"Design Tokens"},"1387":{"id":"/docs/components/switch-14","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#component-customization","content":"Component Customization"},"1388":{"id":"/docs/components/switch-15","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#accessibility","content":"Accessibility"},"1389":{"id":"/docs/components/switch-16","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#best-practices","content":"Best Practices"},"1390":{"id":"/docs/components/switch-17","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#when-to-use-switch","content":"When to Use Switch"},"1391":{"id":"/docs/components/switch-18","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#labeling","content":"Labeling"},"1392":{"id":"/docs/components/switch-19","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#troubleshooting","content":"Troubleshooting"},"1393":{"id":"/docs/components/switch-20","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#controlled-state-not-updating","content":"Controlled State Not Updating"},"1394":{"id":"/docs/components/switch-21","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#missing-accessible-name","content":"Missing Accessible Name"},"1395":{"id":"/docs/components/switch-22","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#props","content":"Props"},"1396":{"id":"/docs/components/switch-23","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#switch","content