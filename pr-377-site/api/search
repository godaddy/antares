"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#accessibility","content":"Displays a visible focus ring (`outline: 2px solid Highlight`) for keyboard focus"},"1570":{"id":"/docs/components/switch-68","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#accessibility","content":"Disabled switches render at `40%` opacity and are excluded from tab order"},"1571":{"id":"/docs/components/switch-69","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#accessibility","content":"When `children` is omitted, provide `aria-label` or `aria-labelledby` so the switch has an accessible name"},"1572":{"id":"/docs/components/switch-70","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#when-to-use-switch","content":"✅ For settings that take effect immediately, without a form submission"},"1573":{"id":"/docs/components/switch-71","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#when-to-use-switch","content":"✅ For binary on/off preferences (e.g. Wi-Fi, notifications, dark mode)"},"1574":{"id":"/docs/components/switch-72","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#when-to-use-switch","content":"❌ For selections that require a \"Save\" or \"Submit\" action (use `Checkbox` instead)"},"1575":{"id":"/docs/components/switch-73","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#when-to-use-switch","content":"❌ For choosing one of several mutually exclusive options (use `Radio` or `SegmentedController` instead)"},"1576":{"id":"/docs/components/switch-74","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#labeling","content":"Prefer a visible label that names the setting being toggled (e.g. \"Wi-Fi\", not \"On/Off\")"},"1577":{"id":"/docs/components/switch-75","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#labeling","content":"If the label is omitted, always provide `aria-label`"},"1578":{"id":"/docs/components/switch-76","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#labeling","content":"Keep labels short and describe the setting, not its current state"},"1579":{"id":"/docs/components/tabs","page_id":"/docs/components/tabs","type":"page","content":"Tabs","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tabs"},"1580":{"id":"/docs/components/tabs-0","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs","content":"Tabs organize peer sections of content and let users switch between them without leaving the page."},"1581":{"id":"/docs/components/tabs-1","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#features","content":"Features"},"1582":{"id":"/docs/components/tabs-2","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#installation","content":"Installation"},"1583":{"id":"/docs/components/tabs-3","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#examples","content":"Examples"},"1584":{"id":"/docs/components/tabs-4","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#default","content":"Default"},"1585":{"id":"/docs/components/tabs-5","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#controlled","content":"Controlled"},"1586":{"id":"/docs/components/tabs-6","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#disabled","content":"Disabled"},"1587":{"id":"/docs/components/tabs-7","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#manilla","content":"Manilla"},"1588":{"id":"/docs/components/tabs-8","page_id":"/docs/components/tabs","ty