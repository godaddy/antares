ary."},"1014":{"id":"/docs/components/pagination-25","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#minimal","content":"Minimal previous/next pagination."},"1015":{"id":"/docs/components/pagination-26","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#pagination-dots","content":"Opt-in visual PaginationDots between previous and next controls."},"1016":{"id":"/docs/components/pagination-27","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#customization","content":"Pagination is composed: pass only the regions your layout needs. Previous and\nnext `Button`s and the page `Input` receive navigation defaults from\nPagination, while explicit child props—including disabled-state props—and\n`className` values remain available for local customization. Separator, page count,\n`Select` and\n`PaginationDots` are consumer-owned."},"1017":{"id":"/docs/components/pagination-28","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#customization","content":"Use `className` to extend styling without replacing the interaction behavior\nprovided by Antares."},"1018":{"id":"/docs/components/pagination-29","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#accessibility","content":"Pagination does not add translated labels. Provide accessible names for the\nnavigation region, previous/next buttons and page input."},"1019":{"id":"/docs/components/pagination-30","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#accessibility","content":"`PaginationDots` is decorative and does not replace interactive page\ncontrols."},"1020":{"id":"/docs/components/pagination-31","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#accessibility","content":"For interactive page links, compose explicit `Button` or `LinkButton` children and\nprovide the active state with `aria-current=\"page\"`."},"1021":{"id":"/docs/components/pagination-32","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Pass `pageCount` when the backend exposes a known number of pages."},"1022":{"id":"/docs/components/pagination-33","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Omit `pageCount` for cursor-based data and disable the composed next button\nwhen the backend reports that there is no next page."},"1023":{"id":"/docs/components/pagination-34","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Keep total items, page size and result ranges in the consuming data layer."},"1024":{"id":"/docs/components/pagination-35","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Compose exactly one page `Input`; use a separate component for advanced range\nnavigation."},"1025":{"id":"/docs/components/popover","page_id":"/docs/components/popover","type":"page","content":"Popover","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/popover"},"1026":{"id":"/docs/components/popover-0","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover","content":"The Popover component is an overlay element positioned relative to a trigger element."},"1027":{"id":"/docs/components/popover-1","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#installation","content":"Installation"},"1028":{"id":"/docs/components/popover-2","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#examples","content":"Examples"},"1029":{"id":"/docs/components/popover-3","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#default","content":"Default"},"1030":{"id":"/docs/components/popover-4","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#custom-anchor","content":"Custom Anchor"},"1031":{"id":"/docs/components/popover-5","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#title-and-close-button","content":"Title and Close Button"},"1032":{"id":"/docs/components/popover-6","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#accessibility","content":"Accessibility"},"1033":{"id":"/docs/components/popover-7","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#keyboard","content":"Keyboard"},"1034":{"id":"/docs/components/popover-8","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#aria","content":"ARIA"},"1035":{"id":"/docs/components/popover-9","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#best-practices","content":"Best Practices"},"1036":{"id":"/docs/components/popover-10","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#props","content":"Props"},"1037":{"id":"/docs/components/popover-11","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#popover","content":"Popover"},"1038":{"id":"/docs/components/popover-12","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#popovertrigger","content":"PopoverTrigger"},"1039":{"id":"/docs/components/popover-13","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover","content":"`PopoverTrigger` wraps a trigger button and a `<Popover>`, handling open state and positioning automatically.\nBased on RAC `DialogTrigger`. To anchor a popover to an element it doesn't wrap, pass `triggerRef` instead."},"1040":{"id":"/docs/components/popover-14","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#default","content":"Use it with `<PopoverTrigger>`, which wraps both the popover content and an interactive trigger element (for example, a `Button`)."},"1041":{"id":"/docs/components/popover-15","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#custom-anchor","content":"To position a popover relative to a different element than its trigger, use the `triggerRef` and `isOpen` props instead of `<PopoverTrigger>`. `onOpenChange` is called when the user opens or closes the popover."},"1042":{"id":"/docs/components/popover-16","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#title-and-close-button","content":"Add a `Heading slot=\"title\"` and a `CloseButton` for a titled, dismissible popover. The heading\nalso gives the dialog its accessible name."},"1043":{"id":"/docs/components/popover-17","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Key"},"1044":{"id":"/docs/components/popover-18","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Action"},"1045":{"id":"/docs/components/popover-19","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"`Enter/Space`"},"1046":{"id":"/docs/components/popover-20","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Opens the popover from its trigger"},"1047":{"id":"/docs/components/popover-21","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"`Escape`"},"1048":{"id":"/docs/components/popover-22","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#keyboard","content":"Closes the popover"},"1049":{"id":"/docs/components/popover-23","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#aria","content":"`role=\"dialog\"` is applied automatically by the underlying React Aria `Dialog`"},"1050":{"id":"/docs/components/popover-24","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#aria","content":"A `Heading slot=\"title\"` labels the dialog via `aria-labelledby`. Without one, a popover inside\na `PopoverTrigger` falls back to being labelled by its trigger; standing alone with\n`triggerRef` it needs an explicit `aria-label`"},"1051":{"id":"/docs/components/popover-25","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#best-practices","content":"Pass an `aria-label` when anchoring with `triggerRef` instead of wrapping a `PopoverTrigger`,\nsince there is no trigger to borrow the name from."},"1052":{"id":"/docs/components/popover-26","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#best-practices","content":"Popover width is determined by its content, and it's recommended to keep it under 400px."},"1053":{"id":"/docs/components/pressable","page_id":"/docs/components/pressable","type":"page","content":"Pressable","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pressable"},"1054":{"id":"/docs/components/pressable-0","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable","content":"A wrapperless interaction primitive that adds accessible press behavior to a single child element."},"1055":{"id":"/docs/components/pressable-1","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#features","content":"Features"},"1056":{"id":"/docs/components/pressable-2","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#installation","content":"Installation"},"1057":{"id":"/docs/components/pressable-3","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#examples","content":"Examples"},"1058":{"id":"/docs/components/pressable-4","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#default","content":"Default"},"1059":{"id":"/docs/components/pressable-5","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#customization","content":"Customization"},"1060":{"id":"/docs/components/pressable-6","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#accessibility","content":"Accessibility"},"1061":{"id":"/docs/components/pressable-7","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#best-practices","content":"Best Practices"},"1062":{"id":"/docs/components/pressable-8","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#troubleshooting","content":"Troubleshooting"},"1063":{"id":"/docs/components/pressable-9","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#props","content":"Props"},"1064":{"id":"/docs/components/pressable-10","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#pressable","content":"Pressable"},"1065":{"id":"/docs/components/pressable-11","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Adds accessible press behavior to an existing visual component."},"1066":{"id":"/docs/components/pressable-12","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Applies interaction states directly to the child without adding a wrapper element."},"1067":{"id":"/docs/components/pressable-13","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Supports pointer, touch, and keyboard interactions through React Aria."},"1068":{"id":"/docs/components/pressable-14","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#features","content":"Preserves the child's layout, shape, and base visual styling while adding state feedback."},"1069":{"id":"/docs/components/pressable-15","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#default","content":"Add accessible press behavior to an existing visual component without adding a wrapper element.\nThe surface supports pointer, touch, and keyboard activation."},"1070":{"id":"/docs/components/pressable-16","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Pressable` when an existing visual component or layout surface needs press behavior while keeping its own DOM element, layout, and styles. The child must be a single element that forwards its ref and accepts the DOM, ARIA, and event props supplied by React Aria."},"1071":{"id":"/docs/components/pressable-17","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Use `Button` when you need a standard button control with button-specific sizing, layout, and visual variants."},"1072":{"id":"/docs/components/pressable-18","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#customization","content":"Pass `onPress` for the action instead of wiring separate pointer and keyboard handlers:"},"1073":{"id":"/docs/components/pressable-19","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"`Pressable` accepts the React Aria press props, including `onPress`, `onPressStart`, `onPressEnd`, `onPressUp`, and `onPressChange`."},"1074":{"id":"/docs/components/pressable-20","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Use a semantic interactive element when possible. For a non-semantic child such as `Avatar` or `Box`, provide an appropriate interactive role and an accessible name. Pressable makes the child focusable when the required props are forwarded."},"1075":{"id":"/docs/components/pressable-21","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#accessibility","content":"Do not add `role=\"button\"` to a native `<button>` or `<a>` unless you intentionally need to change its semantics. Use a dedicated semantic component such as `Button`, `LinkButton`, `Menu`, or `ToggleButton` when that control's meaning is known."},"1076":{"id":"/docs/components/pressable-22","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Prefer a native interactive element or a semantic Antares component when the interaction meaning is known."},"1077":{"id":"/docs/components/pressable-23","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"Avoid nesting interactive elements inside the child passed to `Pressable`."},"1078":{"id":"/docs/components/pressable-24","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#best-practices","content":"`Pressable` automatically applies React Aria state attributes such as `[data-hovered]`, `[data-pressed]`, `[data-focus-visible]`, and `[data-disabled]` to the child. Ensure the child component styles these states appropriately if it overrides the default `Pressable` styles."},"1079":{"id":"/docs/components/pressable-25","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If React Aria warns that the child must be focusable, ensure it is a single element that forwards its ref, `tabIndex`, DOM props, and ARIA attributes."},"1080":{"id":"/docs/components/pressable-26","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#troubleshooting","content":"If `onPress` does not fire, confirm that the child forwards event handlers and is not disabled by another component."},"1081":{"id":"/docs/components/progress-bar","page_id":"/docs/components/progress-bar","type":"page","content":"ProgressBar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/progress-bar"},"1082":{"id":"/docs/components/progress-bar-0","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar","content":"Composable determinate or indeterminate progress with optional label, value, and description"},"1083":{"id":"/docs/components/progress-bar-1","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#installation","content":"Installation"},"1084":{"id":"/docs/components/progress-bar-2","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#examples","content":"Examples"},"1085":{"id":"/docs/components/progress-bar-3","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#default","content":"Default"},"1086":{"id":"/docs/components/progress-bar-4","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#sizes","content":"Sizes"},"1087":{"id":"/docs/components/progress-bar-5","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#statuses","content":"Statuses"},"1088":{"id":"/docs/components/progress-bar-6","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#indeterminate","content":"Indeterminate"},"1089":{"id":"/docs/components/progress-bar-7","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#without-value-label","content":"Without Value Label"},"1090":{"id":"/docs/components/progress-bar-8","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#without-label","content":"Without Label"},"1091":{"id":"/docs/components/progress-bar-9","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#value-display","content":"Value Display"},"1092":{"id":"/docs/components/progress-bar-10","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#customization","content":"Customization"},"1093":{"id":"/docs/components/progress-bar-11","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#accessibility","content":"Accessibility"},"1094":{"id":"/docs/components/progress-bar-12","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#props","content":"Props"},"1095":{"id":"/docs/components/progress-bar-13","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#progressbar","content":"ProgressBar"},"1096":{"id":"/docs/components/progress-bar-14","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#progressbartrack","content":"ProgressBarTrack"},"1097":{"id":"/docs/components/progress-bar-15","page_id":"/docs/components/progress-bar","type":"heading","tags":[],"url":"/docs/components/progress-bar#progressbarvalue","content":"ProgressBarValue"},"1098":{"id":"/docs/components/progress-bar-16","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#default","content":"Compose a label, formatted value, track, and description."},"1099":{"id":"/docs/components/progress-bar-17","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#sizes","content":"Three track heights are available: `xs` (6px), `sm` (12px), and `md` (24px)."},"1100":{"id":"/docs/components/progress-bar-18","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#statuses","content":"Use `status` to communicate intent and a description for additional context."},"1101":{"id":"/docs/components/progress-bar-19","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#indeterminate","content":"Use indeterminate progress while the total is unknown. Value output is hidden automatically."},"1102":{"id":"/docs/components/progress-bar-20","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#without-value-label","content":"Omit ProgressBarValue to hide visible value output. Accessible progress is preserved."},"1103":{"id":"/docs/components/progress-bar-21","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#without-label","content":"Compose only the track for progress in a table or fixed position. Supply an accessible name.\nAdd ProgressBarValue when a visible value is useful."},"1104":{"id":"/docs/components/progress-bar-22","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#value-display","content":"ProgressBarValue shows the formatted value by default and accepts static or state-based content.\nStatic content does not change the accessible value; set the root's valueLabel when needed."},"1105":{"id":"/docs/components/progress-bar-23","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#customization","content":"Compose only the parts you need:"},"1106":{"id":"/docs/components/progress-bar-24","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#customization","content":"`Label` provides a visible, associated name."},"1107":{"id":"/docs/components/progress-bar-25","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#customization","content":"`ProgressBarValue` shows the formatted value by default. Its children accept static content or a render function receiving `percentage`, `valueText`, and `isIndeterminate`."},"1108":{"id":"/docs/components/progress-bar-26","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#customization","content":"`ProgressBarTrack` renders the fill and inherits the root's size and status."},"1109":{"id":"/docs/components/progress-bar-27","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#customization","content":"`Text slot=\"description\"` provides helper text with an automatic accessible association."},"1110":{"id":"/docs/components/progress-bar-28","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#customization","content":"Omitting `ProgressBarValue` hides visible value output while preserving accessible progress. Omit both label and value for a compact track-only layout. Parts use named grid areas, so direct children and fragments can be written in any order. Use `display: contents` on a wrapper when its parts should participate in the root's grid, or override the root's Grid layout props for custom placement."},"1111":{"id":"/docs/components/progress-bar-29","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#customization","content":"Custom visual value content does not change `aria-valuetext`. The root's `valueLabel` accepts a string for accessible value text and the default output of `ProgressBarValue`; it does not add a visible value by itself."},"1112":{"id":"/docs/components/progress-bar-30","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#accessibility","content":"The root has `role=\"progressbar\"` and a range defined by `minValue` and `maxValue`, defaulting to 0 and 100."},"1113":{"id":"/docs/components/progress-bar-31","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#accessibility","content":"`Label` supplies the accessible name. When omitted, provide `aria-label` or `aria-labelledby`."},"1114":{"id":"/docs/components/progress-bar-32","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#accessibility","content":"Determinate progress exposes `aria-valuenow` and formatted `aria-valuetext`, even without `ProgressBarValue`."},"1115":{"id":"/docs/components/progress-bar-33","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#accessibility","content":"Indeterminate progress omits `aria-valuenow`, `aria-valuetext`, and visible value output."},"1116":{"id":"/docs/components/progress-bar-34","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#accessibility","content":"Mounted descriptions are associated automatically, including custom IDs. External `aria-describedby` references are preserved."},"1117":{"id":"/docs/components/progress-bar-35","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#accessibility","content":"Description association is established on mounting. Server-rendered descriptions are associated when the component hydrates."},"1118":{"id":"/docs/components/progress-bar-36","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#accessibility","content":"Reduced motion stops the indeterminate sweep while retaining a visible indicator. RTL and forced colors are supported."},"1119":{"id":"/docs/components/progress-steps","page_id":"/docs/components/progress-steps","type":"page","content":"ProgressSteps","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/progress-steps"},"1120":{"id":"/docs/components/progress-steps-0","page_id":"/docs/components/progress-steps","tags":[],"type":"text","url":"/docs/components/progress-steps","content":"A multi-step progress indicator for wizard and onboarding flows."},"1121":{"id":"/docs/components/progress-steps-1","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#features","content":"Features"},"1122":{"id":"/docs/components/progress-steps-2","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#installation","content":"Installation"},"1123":{"id":"/docs/components/progress-steps-3","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#examples","content":"Examples"},"1124":{"id":"/docs/components/progress-steps-4","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#default","content":"Default"},"1125":{"id":"/docs/components/progress-steps-5","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#not-started","content":"Not started"},"1126":{"id":"/docs/components/progress-steps-6","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#vertical","content":"Vertical"},"1127":{"id":"/docs/components/progress-steps-7","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#interactive","content":"Interactive"},"1128":{"id":"/docs/c