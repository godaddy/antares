on#accessibility","content":"Pagination does not add translated labels. Provide accessible names for the\nnavigation region, previous/next buttons and page input."},"1027":{"id":"/docs/components/pagination-30","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#accessibility","content":"`PaginationDots` is decorative and does not replace interactive page\ncontrols."},"1028":{"id":"/docs/components/pagination-31","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#accessibility","content":"For interactive page links, compose explicit `Button` or `LinkButton` children and\nprovide the active state with `aria-current=\"page\"`."},"1029":{"id":"/docs/components/pagination-32","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Pass `pageCount` when the backend exposes a known number of pages."},"1030":{"id":"/docs/components/pagination-33","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Omit `pageCount` for cursor-based data and disable the composed next button\nwhen the backend reports that there is no next page."},"1031":{"id":"/docs/components/pagination-34","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Keep total items, page size and result ranges in the consuming data layer."},"1032":{"id":"/docs/components/pagination-35","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#best-practices","content":"Compose exactly one page `Input`; use a separate component for advanced range\nnavigation."},"1033":{"id":"/docs/components/number-field","page_id":"/docs/components/number-field","type":"page","content":"NumberField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/number-field"},"