omponents/checkbox-34","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkboxindicator","content":"CheckboxIndicator"},"277":{"id":"/docs/components/checkbox-35","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#default","content":"A single checkbox with a label."},"278":{"id":"/docs/components/checkbox-36","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate","content":"Checkboxes can display an indeterminate state (neither checked nor unchecked), with the use of the `isIndeterminate` prop, commonly used for \"select all\" functionality when some but not all child items are selected."},"279":{"id":"/docs/components/checkbox-37","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#checkbox-group","content":"Group multiple checkboxes together with a shared label."},"280":{"id":"/docs/components/checkbox-38","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#controlled","content":"Manage checkbox group state programmatically with controlled component pattern."},"281":{"id":"/docs/components/checkbox-39","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#horizontal-layout","content":"Display checkboxes in a horizontal row instead of vertical stack."},"282":{"id":"/docs/components/checkbox-40","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#disabled-states","content":"Individual checkboxes within a group can be disabled while others remain interactive."},"283":{"id":"/docs/components/checkbox-41","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#required-indicator","content":"Mark a checkbox group as required with visual indicator and validation."},"284":{"id":"/docs/components/checkbox-42","page_id":"