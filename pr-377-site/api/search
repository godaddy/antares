ents/radio-20","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#styling-overrides-not-applying","content":"Styling Overrides Not Applying"},"1170":{"id":"/docs/components/radio-21","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#keyboard-navigation-not-working","content":"Keyboard Navigation Not Working"},"1171":{"id":"/docs/components/radio-22","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#best-practices","content":"Best Practices"},"1172":{"id":"/docs/components/radio-23","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#when-to-use-radio-buttons","content":"When to Use Radio Buttons"},"1173":{"id":"/docs/components/radio-24","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#label-guidelines","content":"Label Guidelines"},"1174":{"id":"/docs/components/radio-25","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#validation","content":"Validation"},"1175":{"id":"/docs/components/radio-26","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#props","content":"Props"},"1176":{"id":"/docs/components/radio-27","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#radio","content":"Radio"},"1177":{"id":"/docs/components/radio-28","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#radiogroup","content":"RadioGroup"},"1178":{"id":"/docs/components/radio-29","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#default","content":"A radio group with a default selection."},"1179":{"id":"/docs/components/radio-30","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#controlled","content":"A controlled radio group using `value` and `onChange`."},"1180":{"id":"/docs/components/radio-31","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#horizontal-layout","content":"A radio group arranged horizontally."},"1181":{"id":"/docs/components/radio-32","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#disabled-states","content":"Disabled group and individually disabled radio options."},"1182":{"id":"/docs/components/radio-33","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#required-indicator","content":"A required radio group with a payment method selection."},"1183":{"id":"/docs/components/radio-34","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#description-text","content":"A radio group with helper description text."},"1184":{"id":"/docs/components/radio-35","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#error-state","content":"An invalid required group displaying an error message."},"1185":{"id":"/docs/components/radio-36","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-label","content":"A radio group using `aria-label` instead of a visible label."},"1186":{"id":"/docs/components/radio-37","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#form-submission","content":"A radio group integrated with native form submission."},"1187":{"id":"/docs/components/radio-38","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#customization","content":"`RadioGroup` is composed: write `Label`, a `Group` holding the `Radio` items, `Text slot=\"description\"`, and `FieldError`. The `Group` takes its axis, gap, and presentational role from the group's `orientation`, so a bare `<Group>` is all you need; pass your own `direction`/`gap` to lay the items out differently. Each `Radio` takes label text next to the indicator. `orientation` also sets keyboard-navigation direction and ARIA."},"1188":{"id":"/docs/components/radio-39","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#data-attributes","content":"Components automatically add data attributes for styling different states:"},"1189":{"id":"/docs/components/radio-40","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#data-attributes","content":"**RadioGroup Container:** `data-invalid`, `data-disabled`, `data-required`, `data-readonly`, `data-orientation`"},"1190":{"id":"/docs/components/radio-41","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#data-attributes","content":"**Radio Button:** `data-selected`, `data-hovered`, `data-pressed`, `data-focused`, `data-disabled`"},"1191":{"id":"/docs/components/radio-42","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#component-customization","content":"Pass `className` or `style` to customize a radio field container. Use descendant data-attribute selectors to style the interactive radio state:"},"1192":{"id":"/docs/components/radio-43","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Tab**: Moves focus to/from the radio group"},"1193":{"id":"/docs/components/radio-44","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Arrow Down/Right**: Move to next radio button"},"1194":{"id":"/docs/components/radio-45","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Arrow Up/Left**: Move to previous radio button"},"1195":{"id":"/docs/components/radio-46","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Space**: Select the focused radio button"},