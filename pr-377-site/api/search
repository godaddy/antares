d":"/docs/components/checkbox-67","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"❌ For simple on/off toggles without labels (use Toggle/Switch instead)"},"310":{"id":"/docs/components/checkbox-68","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Use clear, concise labels that describe what selecting the option means"},"311":{"id":"/docs/components/checkbox-69","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Keep labels short (1-5 words when possible)"},"312":{"id":"/docs/components/checkbox-70","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Ensure labels are descriptive without being verbose"},"313":{"id":"/docs/components/checkbox-71","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Place the most commonly selected options first in groups"},"314":{"id":"/docs/components/checkbox-72","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#validation","content":"Always provide clear error messages and use appropriate validation states:"},"315":{"id":"/docs/components/checkbox-73","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Limit checkbox groups to 7-10 options for better usability"},"316":{"id":"/docs/components/checkbox-74","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Use logical ordering (alphabetical, frequency of use, or importance)"},"317":{"id":"/docs/components/checkbox-75","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Consider using CheckboxGroup for related options, even if there are only 2-3"},"318":{"id":"/docs/components/checkbox-76","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Provide a group label that clearly describes the choice being made"},"319":{"id":"/docs/components/chip","page_id":"/docs/components/chip","type":"page","content":"Chip","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/chip"},"320":{"id":"/docs/components/chip-0","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip","content":"Grouped pill-shaped items for selecting values and removing user-added filters or tokens."},"321":{"id":"/docs/components/chip-1","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#features","content":"Features"},"322":{"id":"/docs/components/chip-2","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#installation","content":"Installation"},"323":{"id":"/docs/components/chip-3","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#quick-start","content":"Quick start"},"324":{"id":"/docs/components/chip-4","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#examples","content":"Examples"},"325":{"id":"/docs/components/chip-5","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#default","content":"Default"},"326":{"id":"/docs/components/chip-6","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#toggle-chips","content":"Toggle Chips"},"327":{"id":"/docs/components/chip-7","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#removable-chips","content":"Removable Chips"},"328":{"id":"/docs/components/chip-8","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#controlled-selection","content":"Controlled Selection"},"329":{"id":"/docs/components/chip-9","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#sizes","content":"Sizes"},"330":{"id":"/docs/components/chip-10","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#disabled","content":"Disabled"},"331":{"id":"/docs/components/chip-11","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#truncation","content":"Truncation"},"332":{"id":"/docs/components/chip-12","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#empty-state","content":"Empty State"},"333":{"id":"/docs/components/chip-13","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#menu-filter-trigger","content":"Menu filter trigger"},"334":{"id":"/docs/components/chip-14","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#customization","content":"Customization"},"335":{"id":"/docs/components/chip-15","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#content","content":"Content"},"336":{"id":"/docs/components/chip-16","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#selection-and-removal","content":"Selection and removal"},"337":{"id":"/docs/components/chip-17","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#layout-and-sizing","content":"Layout and sizing"},"338":{"id":"/docs/components/chip-18","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#button-composition","content":"Button composition"},"339":{"id":"/docs/components/chip-19","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#accessibility","content":"Accessibility"},"340":{"id":"/docs/components/chip-20","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#best-practices","content":"Best Practices"},"341":{"id":"/docs/components/chip-21","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#troubleshooting","content":"Troubleshooting"},"342":{"id":"/docs/components/chip-22","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"A ChipGroup has no accessible name"},"343":{"id":"/docs/components/chip-23","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"The remove action does not update the UI"},"344":{"id":"/docs/components/chip-24","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"A composed label is not truncating correctly"},"345":{"id":"/docs/components/chip-25","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"The menu trigger does not look like a Chip"},"346":{"id":"/docs/components/chip-26","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#props","content":"Props"},"347":{"id":"/docs/components/chip-27","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chip","content":"Chip"},"348":{"id":"/docs/components/chip-28","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipgroup","content":"ChipGroup"},"349":{"id":"/docs/components/chip-29","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chiplist","content":"ChipList"},"350":{"id":"/docs/components/chip-30","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipbutton","content":"ChipButton"},"351":{"id":"/docs/components/chip-31","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipGroup` + `ChipList` + `Chip` for grouped values, selection, keyboard navigation, and removal"},"352":{"id":"/docs/components/chip-32","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Toggle Chips for selecting multiple peer filters"},"353":{"id":"/docs/components/chip-33","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Removable Chips for user-added filters and input tokens"},"354":{"id":"/docs/components/chip-34","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Shared `sm`, `md`, and `lg` sizes, with optional leading icons"},"355":{"id":"/docs/components/chip-35","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipButton` for menu filters and other actions with a Chip-like appearance"},"356":{"id":"/docs/components/chip-36","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#default","content":"Start with a labeled group of related values. Add selection or removal when\nthe group needs interactive behavior."},"357":{"id":"/docs/components/chip-37","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#toggle-chips","content":"Use Toggle Chips for multiple peer filters. The Chip render prop supplies\nselection state for the checkmark, while `textValue` names composed content."},"358":{"id":"/docs/components/chip-38","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#removable-chips","content":"Use Removable Chips for user-added filters and tokens. `ChipGroup` reports\nremoved keys through `onRemove`; the owner updates its collection. A\nself-closing `Button` in the `remove` slot supplies each remove control."},"359":{"id":"/docs/components/chip-39","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#controlled-selection","content":"Use `selectedKeys` and `onSelectionChange` when another part of the page\nneeds to own the selected filter state."},"360":{"id":"/docs/components/chip-40","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#sizes","content":"Compare the supported `sm`, `md`, and `lg` sizes. Set `size` on `ChipGroup`\nso every Chip inherits one consistent size."},"361":{"id":"/docs/components/chip-41","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#disabled","content":"Disable individual options with `disabledKeys` when some values are unavailable."},"362":{"id":"/docs/components/chip-42","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#truncation","content":"By default, long labels truncate visually when space is constrained, while\nthe complete accessible value remains available."},"363":{"id":"/docs/components/chip-43","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#empty-state","content":"Give an empty collection useful guidance, then let the user add the first\nvalue. Removable items continue to be owned by the collection."},"364":{"id":"/docs/components/chip-44","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#menu-filter-trigger","content":"Use `ChipButton` for Chip presentation without collection semantics.\n`MenuTrigger` continues to own open state, focus, and keyboard behavior."},"365":{"id":"/docs/components/chip-45","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#content","content":"Use a string for a simple label. For icons or other composed content, wrap the\nvisible label in `Text` and provide `textValue` for the accessible name. See\n**Toggle Chips** and **Removable Chips** above."},"366":{"id":"/docs/components/chip-46","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#selection-and-removal","content":"`ChipGroup` owns selection and removal behavior. Use a Chip render prop for\nstate-dependent content, and `Button` with `slot=\"remove\"` together with\n`onRemove` for removable items. See **Toggle Chips** and **Removable Chips**."},"367":{"id":"/docs/components/chip-47","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#layout-and-sizing","content":"Set `size` on `ChipGroup` to keep a collection consistent. `ChipList` wraps by\ndefault and accepts layout props for custom arrangements. See **Sizes**."},"368":{"id":"/docs/components/chip-48","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#button-composition","content":"Use `ChipButton` when Chip presentation is needed without collection semantics.\nCompose it with components such as `MenuTrigger`; those components continue to\nown open state, focus, and keyboard behavior. See **Menu filter trigger**."},"369":{"id":"/docs/components/chip-49","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use `Label` or `aria-label` to name the `ChipGroup`; this names the collection,\nnot its individual Chips."},"370":{"id":"/docs/components/chip-50","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Give each Chip a visible label, `textValue`, or `aria-label`. Use `textValue`\nwhen a Chip contains icons, composed content, or a render prop."},"371":{"id":"/docs/components/chip-51","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use a descriptive group label so removal actions can be announced clearly."},"372":{"id":"/docs/components/chip-52","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Keep the visible label and the accessible value synchronized."},"373":{"id":"/docs/components/chip-53","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"`ChipButton` is a real button and exposes menu state through `MenuTrigger`; provide an accessible name when the visible content is incomplete."},"374":{"id":"/docs/components/chip-54","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep labels concise and let them truncate only when the available width requires it."},"375":{"id":"/docs/components/chip-55","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Prefer groups of three or more related values."},"376":{"id":"/docs/components/chip-56","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep one size per group."},"377":{"id":"/docs/components/chip-57","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Let `ChipList` wrap instead of forcing a single horizontal line."},"378":{"id":"/docs/components/chip-58","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Use removable Chips for user-added filters and tokens."},"379":{"id":"/docs/components/chip-59","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"For menu filters, use `ChipButton` with `MenuTrigger` and provide the chevron explicitly."},"380":{"id":"/docs/components/chip-60","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"Add a visible `Label` to the group or provide `aria-label`. For an individual Chip\nwith composed content, provide a visible label, `textValue`, or `aria-label`."},"381":{"id":"/docs/components/chip-61","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"Add `onRemove` to `ChipGroup` and remove the returned keys from the collection\nowned by your application."},"382":{"id":"/docs/components/chip-62","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"Keep the label in `Text`, preserve `textValue`, and constrain the available width\nof the surrounding layout. Truncation is visual; the complete accessible value\nshould remain available."},"383":{"id":"/docs/components/chip-63","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"Use `ChipButton` inside `MenuTrigger`, include the visible value, and add a\ntrailing chevron to communicate that the control opens a menu."},"384":{"id":"/docs/components/chip-64","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#props","content":"For a menu trigger, the button and menu are composed as siblings inside\n`MenuTrigger`:"},"385":{"id":"/docs/components/circular-progress","page_id":"/docs/components/circular-progress","type":"page","content":"CircularProgress","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/circular-progress"},"386":{"id":"/docs/components/circular-progress-0","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress","content":"A circular progress indicator shows determinate or indeterminate progress of an operation over time"},"387":{"id":"/docs/components/circular-progress-1","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#installation","content":"Installation"},"388":{"id":"/docs/components/circular-progress-2","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#examples","content":"Examples"},"389":{"id":"/docs/components/circular-progress-3","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#default","content":"Default"},"390":{"id":"/docs/components/circular-progress-4","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#sizes","content":"Sizes"},"391":{"id":"/docs/components/circular-progress-5","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#emphasis","content":"Emphasis"},"392":{"id":"/docs/components/circular-progress-6","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#indeterminate","content":"Indeterminate"},"393":{"id":"/docs/components/circular-progress-7","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#accessibility","content":"Accessibility"},"394":{"id":"/docs/components/circular-progress-8","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#aria-support","content":"ARIA Support"},"395":{"id":"/docs/components/circular-progress-9","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#props","content":"Props"},"396":{"id":"/docs/components/circular-progress-10","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#circularprogress","content":"CircularProgress"},"397":{"id":"/docs/components/circular-progress-11","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#default","content":"A basic determinate progress indicator with a label and helper text."},"398":{"id":"/docs/components/circular-progress-12","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#sizes","content":"Four circle diameters are available: `sm` (64px), `md` (96px), `lg` (128px), and `xl` (160px)."},"399":{"id":"/docs/components/circular-progress-13","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#emphasis","content":"Use the `emphasis` prop to communicate status: `success`, `warning`, or `critical`. When omitted, the default teal fill is used."},"400":{"id":"/docs/components/circular-progress-14","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#indeterminate","content":"Use indeterminate progress while preparing an upload whose total size is unknown.\nOnce the total is known, set `isIndeterminate` to false and supply a measured value."},"401":{"id":"/docs/components/circular-progress-15","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`role=\"progressbar\"` on the container"},"402":{"id":"/docs/components/circular-progress-16","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuenow` is omitted while indeterminate; otherwise it reflects the current value (clamped to 0–100)"},"403":{"id":"/docs/components/circular-progress-17","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuemin` and `aria-valuemax` define the range (default `0`–`100`)"},"404":{"id":"/docs/components/circular-progress-18","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support"