/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#blocks","content":"Blocks"},"1878":{"id":"/docs/components/text-field-14","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#props","content":"Props"},"1879":{"id":"/docs/components/text-field-15","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#textfield","content":"TextField"},"1880":{"id":"/docs/components/text-field-16","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Composable interior**: Compose `Label`, `Input` or `TextArea`, `Text slot=\"description\"`, and `FieldError`. Omitting `Group` leaves the control as a direct field child with box chrome. Use an explicit `Group` for controls or adornments"},"1881":{"id":"/docs/components/text-field-17","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Adornments**: Fixed text or icons before or after the input (e.g. `$`, `.00`, `px`) are composed inside `Group`, positioned by source order"},"1882":{"id":"/docs/components/text-field-18","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controls**: A `Button slot=\"control\"` beside the input is an interactive affix; it picks up field chrome from context"},"1883":{"id":"/docs/components/text-field-19","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"1884":{"id":"/docs/components/text-field-20","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Multiline**: Compose a `TextArea` instead of an `Input` for multiline entry"},"1885":{"id":"/docs/components/text-field-21","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"1886":{"id":"/docs/components/text-field-22","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Sizes**: The field is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets its label, input, description, error, and composed controls; without it, the field follows the surrounding scope. An explicit `size` on a part still wins for that part"},"1887":{"id":"/docs/components/text-field-23","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#default","content":"Minimal usage: a `Label` and an `Input`."},"1888":{"id":"/docs/components/text-field-24","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#controlled","content":"Use `value` and `onChange` for controlled state."},"1889":{"id":"/docs/components/text-field-25","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#invalid","content":"Use `isInvalid` with a `FieldError` for validation feedback."},"1890":{"id":"/docs/components/text-field-26","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#disabled","content":"Use `isDisabled` to prevent input."},"1891":{"id":"/docs/components/text-field-27","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#adornments","content":"Fixed text before and after the input, such as currency. Leading and trailing content is\ncomposed inside the `Group` and its position comes from source order."},"1892":{"id":"/docs/components/text-field-28","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#multiline","content":"Compose a `TextArea` instead of an `Input` for multiline entry."},"1893":{"id":"/docs/components/text-field-29","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#sizes","content":"`size` sets the label, input, description, and any control composed inside. Without it, the\nfield follows the surrounding size scope."},"1894":{"id":"/docs/components/text-field-30","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#controls-and-icons","content":"Put a control or an icon beside the input. A `Button slot=\"control\"` is an\ninteractive affix; static content is wrapped in a `Flex as=\"span\"` to center it and give it a gutter."},"1895":{"id":"/docs/components/text-field-31","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#telephone-field","content":"Compose a telephone number input paired with a country-code select."},"1896":{"id":"/docs/components/text-field-32","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#blocks","content":"sign-in-form"},"1897":{"id":"/docs/components/chart/bar-chart","page_id":"/docs/components/chart/bar-chart","type":"page","content":"Bar Chart","breadcrumbs":["Docs","Components","Chart"],"tags":[],"url":"/docs/components/chart/bar-chart"},"1898":{"id":"/docs/components/chart/bar-chart-0","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart","content":"A flexible, accessible, and design-aligned data visualization solution for displaying single or multi-series bar charts."},"1899":{"id":"/docs/components/chart/bar-chart-1","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#features","content":"Features"},"1900":{"id":"/docs/components/chart/bar-chart-2","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#installation","content":"Installation"},"1901":{"id":"/docs/components/chart/bar-chart-3","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#examples","content":"Examples"},"1902":{"id":"/docs/components/chart/bar-chart-4","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#default","content":"Default"},"1903":{"id":"/docs/components/chart/bar-chart-5","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#multi-series","content":"Multi-series"},"1904":{"id":"/docs/components/chart/bar-chart-6","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#horizontal-single-series","content":"Horizontal single series"},"1905":{"id":"/docs/components/chart/bar-chart-7","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#horizontal-multi-series","content":"Horizontal multi-series"},"1906":{"id":"/docs/components/chart/bar-chart-8","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#custom-domain","content":"Custom domain"},"1907":{"id":"/docs/components/chart/bar-chart-9","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#formatted-tick-marks","content":"Formatted tick marks"},"1908":{"id":"/docs/components/chart/bar-chart-10","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#rtl-multi-series","content":"RTL multi-series"},"1909":{"id":"/docs/components/chart/bar-chart-11","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#rtl-horizontal-multi-series","content":"RTL horizontal multi-ser