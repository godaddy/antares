r support"},"382":{"id":"/docs/components/date-picker-27","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"Label formatting via `formatOptions` / `placeholder` on the picker itself, or on `DatePickerValue` / `DateRangePickerValue` in a trigger you write"},"383":{"id":"/docs/components/date-picker-28","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"`minValue` / `maxValue` bounds and `isDateUnavailable` per-day disabling"},"384":{"id":"/docs/components/date-picker-29","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#working-with-dates","content":"Values are `CalendarDate` objects. Import the date primitives you need from the `@godaddy/antares/date` subpath:"},"385":{"id":"/docs/components/date-picker-30","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#working-with-dates","content":"Import date helpers from `@godaddy/antares/date` (a re-export of\n`@internationalized/date`).\nWrap the app in `<I18nProvider>` so formatting and the calendar follow the user's locale."},"386":{"id":"/docs/components/date-picker-31","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#default","content":"A single date picker with a `Label`."},"387":{"id":"/docs/components/date-picker-32","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#range","content":"A start/end range picker."},"388":{"id":"/docs/components/date-picker-33","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#controlled","content":"Driving the value with `useState`."},"389":{"id":"/docs/components/date-picker-34","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#format-options","content":"Controlling the trigger's label format via `formatOptions`."},"390":{"id":"/docs/components/date-picker-35","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#min--max","content":"Bounding selectable dates with `minValue` / `maxValue`."},"391":{"id":"/docs/components/date-picker-36","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#with-error","content":"An invalid picker showing a validation message via `isInvalid` and a `FieldError`."},"392":{"id":"/docs/components/date-picker-37","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#disabled","content":"A disabled picker via `isDisabled`."},"393":{"id":"/docs/components/date-picker-38","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#composed","content":"Write the trigger and the overlay yourself instead of composing `DatePickerCalendar`, for full\ncontrol over the popover and the calendar."},"394":{"id":"/docs/components/date-picker-39","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#composed-range","content":"Write a DateRangePicker's trigger and overlay from lower-level pieces the same way."},"395":{"id":"/docs/components/date-picker-40","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#sizes","content":"`size` sets the label, trigger, and calendar. Without it, the picker follows the surrounding\nsize scope."},"396":{"id":"/docs/components/drawer","page_id":"/docs/components/drawer","type":"page","content":"Drawer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/drawer"},"397":{"id":"/docs/components/drawer-0","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer","content":"An overlay panel that slides in from a screen edge, supporting sidebar