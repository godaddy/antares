nents/toggle-button-6","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#disabled-states","content":"Disabled States"},"1486":{"id":"/docs/components/toggle-button-7","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#sizes","content":"Sizes"},"1487":{"id":"/docs/components/toggle-button-8","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#icon--text","content":"Icon + Text"},"1488":{"id":"/docs/components/toggle-button-9","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#icon-only","content":"Icon Only"},"1489":{"id":"/docs/components/toggle-button-10","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#with-dropdown","content":"With Dropdown"},"1490":{"id":"/docs/components/toggle-button-11","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#rtl-direction","content":"RTL Direction"},"1491":{"id":"/docs/components/toggle-button-12","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#customization","content":"Customization"},"1492":{"id":"/docs/components/toggle-button-13","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#data-attributes","content":"Data Attributes"},"1493":{"id":"/docs/components/toggle-button-14","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#component-customization","content":"Component Customization"},"1494":{"id":"/docs/components/toggle-button-15","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#accessibility","content":"Accessibility"},"1495":{"id":"/docs/components/toggle-bu