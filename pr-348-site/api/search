omposition"},"287":{"id":"/docs/components/chip-19","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#accessibility","content":"Accessibility"},"288":{"id":"/docs/components/chip-20","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#best-practices","content":"Best Practices"},"289":{"id":"/docs/components/chip-21","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#troubleshooting","content":"Troubleshooting"},"290":{"id":"/docs/components/chip-22","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"A ChipGroup has no accessible name"},"291":{"id":"/docs/components/chip-23","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"The remove action does not update the UI"},"292":{"id":"/docs/components/chip-24","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"A composed label is not truncating correctly"},"293":{"id":"/docs/components/chip-25","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"The menu trigger does not look like a Chip"},"294":{"id":"/docs/components/chip-26","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#props","content":"Props"},"295":{"id":"/docs/components/chip-27","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chip","content":"Chip"},"296":{"id":"/docs/components/chip-28","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipgroup","content":"ChipGroup"},"297":{"id":"/docs/components/chip-29","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chiplist","content":"ChipList"},"298":{"id":"/docs/components/chip-30","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipbutton","content":"ChipButton"},"299":{"id":"/docs/components/chip-31","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipGroup` + `ChipList` + `Chip` for grouped values, selection, keyboard navigation, and removal"},"300":{"id":"/docs/components/chip-32","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Toggle Chips for selecting multiple peer filters"},"301":{"id":"/docs/components/chip-33","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Removable Chips for user-added filters and input tokens"},"302":{"id":"/docs/components/chip-34","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Shared `sm`, `md`, and `lg` sizes, with optional leading icons"},"303":{"id":"/docs/components/chip-35","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipButton` for menu filters and other actions with a Chip-like appearance"},"304":{"id":"/docs/components/chip-36","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#default","content":"Start with a labeled group of related values. Add selection or removal when\nthe group needs interactive behavior."},"305":{"id":"/docs/components/chip-37","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#toggle-chips","content":"Use Toggle Chips for multiple peer filters. The Chip render prop supplies\nselection state for the checkmark, while `textValue` names composed content."},"306":{"id":"/docs/components/chip-38","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#removable-chips","content":"Use Removable Chips for user-added filters and tokens. `ChipGroup` reports\nremoved keys through `onRemove`; the owner updates its collection. A\nself-closing `Button` in the `remove` slot supplies each remove control."},"307":{"id":"/docs/components/chip-39","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#controlled-selection","content":"Use `selectedKeys` and `onSelectionChange` when another part of the page\nneeds to own the selected filter state."},"308":{"id":"/docs/components/chip-40","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#sizes","content":"Compare the supported `sm`, `md`, and `lg` sizes. Set `size` on `ChipGroup`\nso every Chip inherits one consistent size."},"309":{"id":"/docs/components/chip-41","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#disabled","content":"Disable individual options with `disabledKeys` when some values are unavailable."},"310":{"id":"/docs/components/chip-42","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#truncation","content":"By default, long labels truncate visually when space is constrained, while\nthe complete accessible value remains available."},"311":{"id":"/docs/components/chip-43","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#empty-state","content":"Give an empty collection useful guidance, then let the user add the first\nvalue. Removable items continue to be owned by the collection."},"312":{"id":"/docs/components/chip-44","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#menu-filter-trigger","content":"Use `ChipButton` for Chip presentation without collection semantics.\n`MenuTrigger` continues to own open state, focus, and keyboard behavior."},"313":{"id":"/docs/components/chip-45","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#content","content":"Use a string for a simple label. For icons or other composed content, wrap the\nvisible label in `Text` and provide `textValue` for the accessible name. See\n**Toggle Chips** and **Removable Chips** above."},"314":{"id":"/docs/components/chip-46","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#selection-and-removal","content":"`ChipGroup` owns selection and removal behavior. Use a Chip render prop for\nstate-dependent content, and `Button` with `slot=\"remove\"` together with\n`onRemove` for removable items. See **Toggle Chips** and **Removable Chips**."},"315":{"id":"/docs/components/chip-47","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#layout-and-sizing","content":"Set `size` on `ChipGroup` to keep a collection consistent. `ChipList` wraps by\ndefault and accepts layout props for custom arrangements. See **Sizes**."},"316":{"id":"/docs/components/chip-48","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#button-composition","content":"Use `ChipButton` when Chip presentation is needed without collection semantics.\nCompose it with components such as `MenuTrigger`; those components continue to\nown open state, focus, and keyboard behavior. See **Menu filter trigger**."},"317":{"id":"/docs/components/chip-49","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use `Label` or `aria-label` to name the `ChipGroup`; this names the collection,\nnot its individual Chips."},"318":{"id":"/docs/components/chip-50","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Give each Chip a visible label, `textValue`, or `aria-label`. Use `textValue`\nwhen a Chip contains icons, composed content, or a render prop."},"319":{"id":"/docs/components/chip-51","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use a descriptive group label so removal actions can be announced clearly."},"320":{"id":"/docs/components/chip-52","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Keep the visible label and the accessible value synchronized."},"321":{"id":"/docs/components/chip-53","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"`ChipButton` is a real button and exposes menu state through `MenuTrigger`; provide an accessible name when the visible content is incomplete."},"322":{"id":"/docs/components/chip-54","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep labels concise and let them truncate only when the available width requires it."},"323":{"id":"/docs/components/chip-55","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Prefer groups of three or more related values."},"324":{"id":"/docs/components/chip-56","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep one size per group."},"325":{"id":"/docs/components/chip-57","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Let `ChipList` wrap instead of forcing a single horizontal line."},"326":{"id":"/docs/components/chip-58","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Use removable Chips for user-added filters and tokens."},"327":{"id":"/docs/components/chip-59","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"For menu filters, use `ChipButton` with `MenuTrigger` and provide the chevron explicitly."},"328":{"id":"/docs/components/chip-60","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"Add a visible `Label` to the group or provide `aria-label`. For an individual Chip\nwith composed content, provide a visible label, `textValue`, or `aria-label`."},"329":{"id":"/docs/components/chip-61","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"Add `onRemove` to `ChipGroup` and remove the returned keys from the collection\nowned by your application."},"330":{"id":"/docs/components/chip-62","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"Keep the label in `Text`, preserve `textValue`, and constrain the available width\nof the surrounding layout. Truncation is visual; the complete accessible value\nshould remain available."},"331":{"id":"/docs/components/chip-63","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"Use `ChipButton` inside `MenuTrigger`, include the visible value, and add a\ntrailing chevron to communicate that the control opens a menu."},"332":{"id":"/docs/components/chip-64","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#props","content":"For a menu trigger, the button and menu are composed as siblings inside\n`MenuTrigger`:"},"333":{"id":"/docs/components/circular-progress","page_id":"/docs/components/circular-progress","type":"page","content":"CircularProgress","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/circular-progress"},"334":{"id":"/docs/components/circular-progress-0","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress","content":"A circular progress indicator shows determinate progress of an operation over time"},"335":{"id":"/docs/components/circular-progress-1","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#installation","content":"Installation"},"336":{"id":"/docs/components/circular-progress-2","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#examples","content":"Examples"},"337":{"id":"/docs/components/circular-progress-3","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#default","content":"Default"},"338":{"id":"/docs/components/circular-progress-4","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#sizes","content":"Sizes"},"339":{"id":"/docs/components/circular-progress-5","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#emphasis","content":"Emphasis"},"340":{"id":"/docs/components/circular-progress-6","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#accessibility","content":"Accessibility"},"341":{"id":"/docs/components/circular-progress-7","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#aria-support","content":"ARIA Support"},"342":{"id":"/docs/components/circular-progress-8","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#props","content":"Props"},"343":{"id":"/docs/components/circular-progress-9","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#circularprogress","content":"CircularProgress"},"344":{"id":"/docs/components/circular-progress-10","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#default","content":"A basic determinate progress indicator with a label and helper text."},"345":{"id":"/docs/components/circular-progress-11","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#sizes","content":"Four circle diameters are available: `sm` (64px), `md` (96px), `lg` (128px), and `xl` (160px)."},"346":{"id":"/docs/components/circular-progress-12","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#emphasis","content":"Use the `emphasis` prop to communicate status: `success`, `warning`, or `critical`. When omitted, the default teal fill is used."},"347":{"id":"/docs/components/circular-progress-13","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`role=\"progressbar\"` on the container"},"348":{"id":"/docs/components/circular-progress-14","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuenow` reflects the current value (clamped to 0–100)"},"349":{"id":"/docs/components/circular-progress-15","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuemin` and `aria-valuemax` define the range (default `0`–`100`)"},"350":{"id":"/docs/components/circular-progress-16","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuetext` provides a formatted string (e.g. `\"60%\"`) via `Intl.NumberFormat`; the same string is rendered inside the circle. Override the text with the `aria-valuetext` prop, or control formatting with `formatOptions`"},"351":{"id":"/docs/components/circular-progress-17","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-labelledby` associates the visible label when the `label` prop is provided"},"352":{"id":"/docs/components/circular-progress-18","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-describedby` wires the `helperText` to the progressbar for screen readers"},"353":{"id":"/docs/components/circular-progress-19","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"The decorative SVG and output text are hidden via `aria-hidden=\"true\"`"},"354":{"id":"/docs/components/date-picker","page_id":"/docs/components/date-picker","type":"page","content":"DatePicker","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/date-picker"},"355":{"id":"/docs/components/date-picker-0","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker","content":"Date fields that display the selected value as a label and open a calendar popover to pick a single date (DatePicker) or a range (DateRangePicker)."},"356":{"id":"/docs/components/date-picker-1","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#features","content":"Features"},"357":{"id":"/docs/components/date-picker-2","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#installation","content":"Installation"},"358":{"id":"/docs/components/date-picker-3","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#working-with-dates","content":"Working with dates"},"359":{"id":"/docs/components/date-picker-4","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#examples","content":"Examples"},"360":{"id":"/docs/components/date-picker-5","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#default","content":"Default"},"361":{"id":"/docs/components/date-picker-6","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#range","content":"Range"},"362":{"id":"/docs/components/date-picker-7","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#controlled","content":"Controlled"},"363":{"id":"/docs/components/date-picker-8","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#format-options","content":"Format Options"},"364":{"id":"/docs/components/date-picker-9","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#min--max","content":"Min / Max"},"365":{"id":"/docs/components/date-picker-10","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#with-error","content":"With error"},"366":{"id":"/docs/components/date-picker-11","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#disabled","content":"Disabled"},"367":{"id":"/docs/components/date-picker-12","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#composed","content":"Composed"},"368":{"id":"/docs/components/date-picker-13","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#composed-range","content":"Composed range"},"369":{"id":"/docs/components/date-picker-14","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#sizes","content":"Sizes"},"370":{"id":"/docs/components/date-picker-15","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#props","content":"Props"},"371":{"id":"/docs/components/date-picker-16","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepicker","content":"DatePicker"},"372":{"id":"/docs/components/date-picker-17","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepicker","content":"DateRangePicker"},"373":{"id":"/docs/components/date-picker-18","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepickercalendar","content":"DatePickerCalendar"},"374":{"id":"/docs/components/date-picker-19","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepickercalendar","content":"DateRangePickerCalendar"},"375":{"id":"/docs/components/date-picker-20","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepickervalue","content":"DatePickerValue"},"376":{"id":"/docs/components/date-picker-21","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepickervalue","content":"DateRangePickerValue"},"377":{"id":"/docs/components/date-picker-22","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"**Composable interior**: Compose `Label`, a `Button slot=\"trigger\"`, `DatePickerCalendar`, and optional `Text` / `FieldError`. Nothing is added for you, and what you write keeps the order you wrote it in. `children` also accepts a function for picker state"},"378":{"id":"/docs/components/date-picker-23","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"**Trigger and calendar**: An empty `Button slot=\"trigger\"` renders a calendar icon and the formatted value from the field. `DatePickerCalendar` (and `DateRangePickerCalendar`) is the calendar in the popover it opens: it takes `Calendar` props plus `popoverProps` for the overlay. Write `Popover`, `Content`, and `Calendar` yourself to replace the whole overlay"},"379":{"id":"/docs/components/date-picker-24","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"**Sizes**: Each picker is a size scope. `size` (`sm`, `md`, `lg`) sets its label, trigger, description, error, and the calendar it opens; without it, the picker follows the surrounding scope"},"380":{"id":"/docs/components/date-picker-25","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"`DatePicker` (single) and `DateRangePicker` (range): a read-only formatted date label; the whole field opens a calendar popover"},"381":{"id":"/docs/components/date-picker-26","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"Built on React Aria - native form integration, validation, focus management, and screen-reader support"},"382":{"id":"/docs/components/date-picker-27","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"Label formatting via `formatOptions` / `placeholder` on the picker itself, or on `DatePickerValue` / `DateRangePickerValue` in a trigger you write"},"383":{"id":"/docs/components/date-picker-28","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"`minValue` / `maxValue` bounds and `isDateUnavailable` per-day disabling"},"384":{"id":"/docs/components/date-picker-29","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#working-with-dates","content":"Values are `CalendarDate` objects. Import the date primitives you need from the `@godaddy/antares/date` subpath:"},"385":{"id":"/docs/components/date-picker-30","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#working-with-dates","content":"Import date helpers from `@godaddy/antares/date` (a re-export of\n`@internationalized/date`).\nWrap the app in `<I18nProvider>` so formatting and the calendar follow the user's locale."},"386":{"id":"/docs/components/date-picker-31","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#default","content":"A single date picker with a `Label`."},"387":{"id":"/docs/components/date-picker-32","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#range","content":"A start/end range picker."},"388":{"id":"/docs/components/date-picker-33","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#controlled","content":"Driving the value with `useState`."},"389":{"id":"/docs/components/date-picker-34","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#format-options","content":"Controlling the trigger's label format via `formatOptions`."},"390":{"id":"/docs/components/date-picker-35","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#min--max","content":"Bounding selectable dates with `minValue` / `maxValue`."},"391":{"id":"/docs/components/date-picker-36","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#with-error","content":"An invalid picker showing a validation message via `isInvalid` and a `FieldError`."},"392":{"id":"/docs/components/date-picker-37","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#disabled","content":"A disabled picker via `isDisabled`."},"393":{"id":"/docs/components/date-picker-38","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#composed","content":"Write the trigger and the overlay yourself instead of composing `DatePickerCalendar`, for full\ncontrol over the popover and the calendar."},"394":{"id":"/docs/components/date-picker-39","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#composed-range","content":"Write a DateRangePicker's trigger and overlay from lower-level pieces the same way."},"395":{"id":"/docs/components/date-picker-40","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#sizes","content":"`size` sets the label, trigger, and calendar. Without it, the picker follows the surrounding\nsize scope."},"396":{"id":"/docs/components/drawer","page_id":"/docs/components/drawer","type":"page","content":"Drawer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/drawer"},"397":{"id":"/docs/components/drawer-0","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer","content":"An overlay panel that slides in from a screen edge, supporting sidebar navigation and bottom sheets."},"398":{"id":"/docs/components/drawer-1","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#installation","content":"Installation"},"399":{"id":"/docs/components/drawer-2","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#examples","content":"Examples"},"400":{"id":"/docs/components/drawer-3","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#default","content":"Default"},"401":{"id":"/docs/components/drawer-4","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#bottom-sheet","content":"Bottom Sheet"},"402":{"id":"/docs/components/drawer-5","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#placements","content":"Placements"},"403":{"id":"/docs/components/drawer-6","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/c