res","content":"Controlled and uncontrolled selection."},"1378":{"id":"/docs/components/tabs-22","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Automatic horizontal overflow controls that move one tab at a time."},"1379":{"id":"/docs/components/tabs-23","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Localized labels for the automatic overflow controls."},"1380":{"id":"/docs/components/tabs-24","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#default","content":"Switch between peer sections of content on the same page."},"1381":{"id":"/docs/components/tabs-25","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#controlled","content":"Control the selected panel from application state."},"1382":{"id":"/docs/components/tabs-26","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#disabled","content":"Disable a section while keeping the remaining sections available."},"1383":{"id":"/docs/components/tabs-27","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#manilla","content":"Use the folder-style Manilla treatment for document-oriented sections."},"1384":{"id":"/docs/components/tabs-28","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#overflow","content":"When the tab strip is narrower than its content, the group adds controls that move one tab at a time."},"1385":{"id":"/docs/components/tabs-29","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#rtl","content":"Overflow controls follow the logical reading direction."},"1386":{"id":"/docs/components/tabs-30","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"Tabs require an accessible label on `TabList`. Use the keyboard to move between tabs with the arrow keys. Disabled tabs are skipped. Use `keyboardActivation=\"manual\"` when focus should move independently of selection."},"1387":{"id":"/docs/components/tabs-31","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"`overflowLabels` is optional and defaults to \"Previous tabs\" and \"Next tabs\". Provide localized labels when needed; they should describe the logical direction rather than physical directions like \"left\" or \"right\", as the component automatically handles RTL layouts."},"1388":{"id":"/docs/components/tabs-32","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"`TabList` must be rendered inside `Tabs` and must provide `aria-label` or `aria-labelledby`. Give each `Tab` and its corresponding `TabPanel` the same `id`; React Aria uses that key to build their accessible relationship."},"1389":{"id":"/docs/components/tabs-33","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"The component exposes state through data attributes:"},"1390":{"id":"/docs/components/tabs-34","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`Tabs`: `data-design=\"underline\"` or `data-design=\"manilla\"`."},"1391":{"id":"/docs/components/tabs-35","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`Tab`: `data-selected`, `data-hovered`, `data-pressed`, `data-focus-visible`, and `data-disabled`."},"1392":{"id":"/docs/components/tabs-36","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`TabPanel`: `data-inert` when a force-mounted inactive panel is not interactive."},"1393":{"id":"/docs/components/tabs-37","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"Use these attributes to extend styling without replacing the accessibility behavior supplied by React Aria Components. You can also use render props in `className` to style based on state (e.g., `className={({ isSelected }) => isSelected ? 'active' : ''}`)."},"1394":{"id":"/docs/components/tabs-38","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"Use `TabList`'s `containerProps` to customize the outer tab list shell, such as increasing its width."},"1395":{"id":"/docs/components/tabs-39","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Use Tabs for peer panels on the same page and URL."},"1396":{"id":"/docs/components/tabs-40","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Keep the number of tabs small enough for users to understand the available sections."},"1397":{"id":"/docs/components/tabs-41","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not use Tabs for primary application navigation or route changes."},"1398":{"id":"/docs/components/tabs-42","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not render a standalone `Tab`; compose it inside `Tabs` and `TabList`."},"1399":{"id":"/docs/components/tag","page_id":"/docs/components/tag","type":"page","content":"Tag","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tag"},"1400":{"id":"/docs/components/tag-0","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag","content":"Non-interactive labels that highlight statuses and categories."},"1401":{"id":"/docs/components/tag-1","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#installation","content":"Installation"},"1402":{"id":"/docs/components/tag-2","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#examples","content":"Examples"},"1403":{"id":"/docs/components/tag-3","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#default","content":"Default"},"1404":{"id":"/docs/components/tag-4","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#emphasis","content":"Emphasis"},"1405":{"id":"/docs/components/tag-5","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#sizes","content":"Sizes"},"1406":{"id":"/docs/components/tag-6","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#inline","content":"Inline"},"1407":{"id":"/docs/components/tag-7","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#high-contrast","content":"High Contrast"},"1408":{"id":"/docs/components/tag-8","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#with-icon","content":"With Icon"},"1409":{"id":"/docs/components/tag-9","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#indicator","content":"Indicator"},"1410":{"id":"/docs/components/tag-10","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#accessibility","content":"Accessibility"},"1411":{"id":"/docs/components/tag-11","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#screen-readers","content":"Screen readers"},"1412":{"id":"/docs/components/tag-12","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#decorative-icons","content":"Decorative icons"},"1413":{"id":"/docs/components/tag-13","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#indicator-dot","content":"Indicator dot"},"1414":{"id":"/docs/components/tag-14","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#best-practices","content":"Best Practices"},"1415":{"id":"/docs/components/tag-15","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#when-to-use","content":"When to Use"},"1416":{"id":"/docs/components/tag-16","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#when-not-to-use","content":"When Not to Use"},"1417":{"id":"/docs/components/tag-17","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#props","content":"Props"},"1418":{"id":"/docs/components/tag-18","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#tag","content":"Tag"},"1419":{"id":"/docs/components/tag-19","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#default","content":"A minimal tag with the default emphasis and size."},"1420":{"id":"/docs/components/tag-20","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#emphasis","content":"Nine emphasis options are available. Choose the one that fits the visual tone of your context."},"1421":{"id":"/docs/components/tag-21","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#sizes","content":"Choose a size that fits the surrounding content. Smaller tags work well in compact layouts like tables; larger tags suit headings or hero sections."},"1422":{"id":"/docs/components/tag-22","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#inline","content":"Use `design=\"inline\"` to embed a tag within a sentence. The background and border are removed so the tag blends into the text flow."},"1423":{"id":"/docs/components/tag-23","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#high-contrast","content":"A bolder color treatment for when tags need to stand out more - for example, on colored backgrounds."},"1424":{"id":"/docs/components/tag-24","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#with-icon","content":"Icons reinforce the tag's meaning at a glance. Add an `Icon` as a child - it inherits the tag's color and scales with its size."},"1425":{"id":"/docs/components/tag-25","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#indicator","content":"A minimal style that pairs a small colored dot with a neutral background. Well suited for dense layouts like tables or dashboards where multiple tags in close proximity would otherwise compete for attention."},"1426":{"id":"/docs/components/tag-26","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#screen-readers","content":"Tags are `<span>` elements with no special ARIA role. Screen readers announce the tag's text as part of normal page content — no extra markup is needed."},"1427":{"id":"/docs/components/tag-27","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#decorative-icons","content":"Icons passed as children must include `aria-hidden=\"true\"` so they are skipped by screen readers. The text label is the sole carrier of meaning."},"1428":{"id":"/docs/components/tag-28","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#indicator-dot","content":"The colored dot is decorative and invisible to screen readers. The text label must convey the status on its own — never rely on the dot alone to communicate meaning."},"1429":{"id":"/docs/components/tag-29","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Use the indicator style in dense layouts like tables and dashboards. Use the filled style when the tag is a prominent, standalone element on a card or hero section."},"1430":{"id":"/docs/components/tag-30","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Default to the small size in compact layouts like tables and lists. Use medium or large only when the tag needs to stand out as a primary piece of information."},"1431":{"id":"/docs/components/tag-31","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Use the inline design only within running prose. In grouped or standalone contexts, the filled style provides better visual separation."},"1432":{"id":"/docs/components/tag-32","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Do not stack multiple tags of different emphasis on the same item. Choose the most important one — too many competing labels lose their meaning."},"1433":{"id":"/docs/components/tag-33","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Showing the status of an item on a card, table row, or list entry (e.g. \"Active\", \"Expired\", \"Pending\")"},"1434":{"id":"/docs/components/tag-34","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Categorizing or grouping content so users can scan and filter quickly (e.g. \"New\", \"Sale\", \"Beta\")"},"1435":{"id":"/docs/components/tag-35","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Surfacing metadata about an item (e.g. \"Pro\", \"Free trial\", \"Internal\")"},"1436":{"id":"/docs/components/tag-36","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Communicating priority or category in project management and collaboration tools (e.g. \"High priority\", \"In review\")"},"1437":{"id":"/docs/components/tag-37","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-not-to-use","content":"If users need to click or dismiss it — use a **Button** instead."},"1438":{"id":"/docs/components/tag-38","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-not-to-use","content":"If the label is part of a sentence with no visual distinction — just use text."},"1439":{"id":"/docs/components/text","page_id":"/docs/components/text","type":"page","content":"Text","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text"},"1440":{"id":"/docs/components/text-0","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text","content":"Body copy and supporting detail, with size, emphasis, alignment, and truncation options"},"1441":{"id":"/docs/components/text-1","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#features","content":"Features"},"1442":{"id":"/docs/components/text-2","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#installation","content":"Installation"},"1443":{"id":"/docs/components/text-3","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#examples","content":"Examples"},"1444":{"id":"/docs/components/text-4","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#default","content":"Default"},"1445":{"id":"/docs/components/text-5","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#as","content":"As"},"1446":{"id":"/docs/components/text-6","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#align","content":"Align"},"1447":{"id":"/docs/components/text-7","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#max-lines","content":"Max Lines"},"1448":{"id":"/docs/components/text-8","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#wrap","content":"Wrap"},"1449":{"id":"/docs/components/text-9","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#sizes","content":"Sizes"},"1450":{"id":"/docs/components/text-10","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#emphasis","content":"Emphasis"},"1451":{"id":"/docs/components/text-11","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#detail","content":"Detail"},"1452":{"id":"/docs/components/text-12","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#props","content":"Props"},"1453":{"id":"/docs/components/text-13","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#text","content":"Text"},"1454":{"id":"/docs/components/text-14","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#detail-1","content":"Detail"},"1455":{"id":"/docs/components/text-15","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text","content":"`Text` is body copy and `Detail` is supporting copy: captions, metadata, and hints."},"1456":{"id":"/docs/components/text-16","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"Without `size`, `Text` inherits every font property from what surrounds it: a\nSizeScope, a control, or a named part. So\n`<Button><Text>Save</Text></Button>` looks exactly like `<Button>Save</Button>`."},"1457":{"id":"/docs/components/text-17","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`Detail` applies the detail role at the size scope's tier."},"1458":{"id":"/docs/components/text-18","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`size` picks a step on the component's own ramp (`xs` to `2xl`) and changes only the font size."},"1459":{"id":"/docs/components/text-19","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`emphasis` picks a feedback color and changes only the color."},"1460":{"id":"/docs/components/text-20","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"For semantic emphasis, render `as=\"strong\"` or `as=\"em\"`."},"1461":{"id":"/docs/components/text-21","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#default","content":"Basic text content."},"1462":{"id":"/docs/components/text-22","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#as","content":"Setting the `as` prop allows you to change the HTML tag of the `Text` component."},"1463":{"id":"/docs/components/text-23","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#align","content":"Setting the `align` prop allows you to change the alignment of the text. Choose from `start`, `center`, `end`, or `justify`; the logical keywords support RTL languages."},"1464":{"id":"/docs/components/text-24","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#max-lines","content":"Setting the `maxLines` prop limits the number of displayed lines using an ellipsis."},"1465":{"id":"/docs/components/text-25","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#wrap","content":"Setting the `wrap` prop controls text wrapping with values such as `wrap`, `nowrap`, `balance`, `pretty`, or `stable`."},"1466":{"id":"/docs/components/text-26","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#sizes","content":"Without `size`, text inherits the typography around it. `size` picks a step on the body ramp\nand changes only the font size."},"1467":{"id":"/docs/components/text-27","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#emphasis","content":"`emphasis` selects a feedback color and changes nothing else. Without it, text inherits the\nsurrounding color."},"1468":{"id":"/docs/components/text-28","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#detail","content":"`Detail` is supporting copy, such as captions and metadata, on the detail ramp. It keeps the\nsurrounding color; add `emphasis=\"passive\"` to mute it."},"1469":{"id":"/docs/components/text-area","page_id":"/docs/components/text-area","type":"page","content":"TextArea","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-area"},"1470":{"id":"/docs/components/text-area-0","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area","content":"Multiline text control for use inside a field."},"1471":{"id":"/docs/components/text-area-1","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#installation","content":"Installation"},"1472":{"id":"/docs/components/text-area-2","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#examples","content":"Examples"},"1473":{"id":"/docs/components/text-area-3","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#default","content":"Default"},"1474":{"id":"/docs/components/text-area-4","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#props","content":"Props"},"1475":{"id":"/docs/components/text-area-5","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#textarea","content":"TextArea"},"1476":{"id":"/docs/components/text-area-6","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area","content":"`TextArea` is the multiline control inside a field, not a field on its own. Prefer `TextField` as the parent; see that component for fuller examples."},"1477":{"id":"/docs/components/text-area-7","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area#default","content":"TextArea inside TextField."},"1478":{"id":"/docs/components/text-field","page_id":"/docs/components/text-field","type":"page","content":"TextField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-field"},"1479":{"id":"/docs/components/text-field-0","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field","content":"TextField is a composed single-line or multiline text input. Use it in forms for short answers (email, search, name) or longer content (comments)."},"1480":{"id":"/docs/components/text-field-1","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#features","content":"Features"},"1481":{"id":"/docs/components/text-field-2","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#installation","content":"Installation"},"1482":{"id":"/docs/components/text-field-3","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#examples","content":"Examples"},"1483":{"id":"/docs/components/text-field-4","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#default","content":"Default"},"1484":{"id":"/docs/components/text-field-5","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#controlled","content":"Controlled"},"1485":{"id":"/docs/components/text-field-6","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#invalid","content":"Invalid"},"1486":{"id":"/docs/components/text-field-7","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#disabled","content":"Disabled"},"1487":{"id":"/docs/components/text-field-8","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#adornments","content":"Adornments"},"1488":{"id":"/docs/components/text-field-9","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#multiline","content":"Multiline"},"1489":{"id":"/docs/components/text-field-10","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#sizes","content":"Sizes"},"1490":{"id":"/docs/components/text-field-11","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#controls-and-icons","content":"Controls and icons"},"1491":{"id":"/docs/components/text-field-12","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#telephone-field","content":"Telephone Field"},"1492":{"id":"/docs/components/text-field-13","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#props","content":"Props"},"1493":{"id":"/docs/components/text-field-14","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#textfield","content":"TextField"},"1494":{"id":"/docs/components/text-field-15","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Composable interior**: Compose `Label`, `Input` or `TextArea`, `Text slot=\"description\"`, and `FieldError`. Omitting `Group` leaves the control as a direct field child with box chrome. Use an explicit `Group` for controls or adornments"},"1495":{"id":"/docs/components/text-field-16","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Adornments**: Fixed text or icons before or after the input (e.g. `$`, `.00`, `px`) are composed inside `Group`, positioned by source order"},"1496":{"id":"/docs/components/text-field-17","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controls**: A `Button slot=\"control\"` beside the input is an interactive affix; it picks up field chrome from context"},"1497":{"id":"/docs/components/text-field-18","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"1498":{"id":"/docs/components/text-field-19","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Multiline**: Compose a `TextArea` instead of an `Input` for multiline entry"},"1499":{"id":"/docs/components/text-field-20","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"1500":{"id":"/docs/components/text-field-21","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Sizes**: The field is a size scope. `size` (`sm`, `md`, `lg`) sets its label, input, description, error, and composed controls; without it, the field follows the surrounding scope. An explicit `size` on a part still wins for that part"},"1501":{"id":"/docs/components/text-field-22","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#default","content":"Minimal usage: a `Label` and an `Input`."},"1502":{"id":"/docs/components/text-field-23","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#controlled","content":"Use `value` and `onChange` for controlled state."},"1503":{"id":"/docs/components/text-field-24","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#invalid","content":"Use `isInvalid` with a `FieldError` for validation feedback."},"1504":{"id":"/docs/components/text-field-25","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#disabled","content":"Use `isDisabled` to prevent input."},"1505":{"id":"/docs/components/text-field-26","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#adornments","content":"Fixed text before and after the input, such as currency. Leading and trailing content is\ncomposed inside the `Group` and its position comes from source order."},"1506":{"id":"/docs/components/text-field-27","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#multiline","content":"Compose a `TextArea` instead of an `Input` for multiline entry."},"1507":{"id":"/docs/components/text-field-28","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#sizes","content":"`size` sets the label, input, description, and any control composed inside. Without it, the\nfield follows the surrounding size scope."},"1508":{"id":"/docs/components/text-field-29","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#controls-and-icons","content":"Put a control or an icon beside the input. A `Button slot=\"control\"` is an\ninteractive affix; static content is wrapped in a `Flex as=\"span\"` to center it and give it a gutter."},"1509":{"id":"/docs/components/text-field-30","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#telephone-field","content":"Compose a telephone number input paired with a country-code select."},"1510":{"id":"/docs/components/text-lockup","page_id":"/docs/components/text-lockup","type":"page","content":"TextLockup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-lockup"},"1511":{"id":"/docs/components/text-lockup-0","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup","content":"TextLockup stacks an eyebrow, title, and body text as one coordinated type group across six sizes."},"1512":{"id":"/docs/components/text-lockup-1","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#features","content":"Features"},"1513":{"id":"/docs/components/text-lockup-2","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#installation","content":"Installation"},"1514":{"id":"/docs/components/text-lockup-3","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#examples","content":"Examples"},"1515":{"id":"/docs/components/text-lockup-4","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#default","content":"Default"},"1516":{"id":"/docs/components/text-lockup-5","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#sizes","content":"Sizes"},"1517":{"id":"/docs/components/text-lockup-6","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#tag-eyebrow","content":"Tag Eyebrow"},"1518":{"id":"/docs/components/text-lockup-7","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#alignment","content":"Alignment"},"1519":{"id":"/docs/components/text-lockup-8","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#legible-lines","content":"Legible Lines"},"1520":{"id":"/docs/components/text-lockup-9","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#with-actions","content":"With Actions"},"1521":{"id":"/docs/components/text-lockup-10","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#customization","content":"Customization"},"1522":{"id":"/docs/components/text-lockup-11","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#accessibility","content":"Accessibility"},"1523":{"id":"/docs/components/text-lockup-12","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#best-practices","content":"Best Practices"},"1524":{"id":"/docs/components/text-lockup-13","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#props","content":"Props"},"1525":{"id":"/docs/components/text-lockup-14","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#textlockup","content":"TextLockup"},"1526":{"id":"/docs/components/text-lockup-15","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Six coordinated sizes, from a `2xl` page title down to `xs`"},"1527":{"id":"/docs/components/text-lockup-16","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"An eyebrow that takes plain text or a `Tag`, sized to match the lockup"},"1528":{"id":"/docs/components/text-lockup-17","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Slotted parts, so nested components keep their own type"},"1529":{"id":"/docs/components/text-lockup-18","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Any heading level, chosen independently of the visual size"},"1530":{"id":"/docs/components/text-lockup-19","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Start or center alignment"},"1531":{"id":"/docs/components/text-lockup-20","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"A legible line-length clamp, on by default"},"1532":{"id":"/docs/components/text-lockup-21","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#default","content":"A lockup stacks an optional eyebrow, a title and body text as one coordinated type\ngroup. You supply the parts, so the title can be any heading level and the body any\nnumber of paragraphs; `size` sets the tier for all of them at once."},"1533":{"id":"/docs/components/text-lockup-22","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#sizes","content":"`size` sets every part, each on its own role ramp. Without it, the lockup follows the size\nscope."},"1534":{"id":"/docs/components/text-lockup-23","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#tag-eyebrow","content":"The eyebrow takes either plain text or a `Tag`. Both use `slot=\"eyebrow\"`, so the two\nforms swap freely, and the lockup pairs the tag's `size` with its own."},"1535":{"id":"/docs/components/text-lockup-24","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#alignment","content":"`align` centers the parts as well as the text, so a `Tag` eyebrow stays centered too."},"1536":{"id":"/docs/components/text-lockup-25","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#legible-lines","content":"The text parts are constrained to a comfortable line length by default. Set\n`legibleLines={false}` to let them run the full width of their container, which suits a\nlockup already inside a narrow column. Both lockups below share one wide container, so the\nclamp is what makes the first one narrower."},"1537":{"id":"/docs/components/text-lockup-26","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#with-actions","content":"Because you compose the parts, anything else can sit alongside them — a call to action\nhere. Controls keep their own type: the buttons are unaffected by the lockup's `size`."},"1538":{"id":"/docs/components/text-lockup-27","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"`TextLockup` positions and type-sets its parts; you supply them. That means anything else can\nsit alongside them — a call to action, a second paragraph, an image — without the component\ngrowing a prop for it."},"1539":{"id":"/docs/components/text-lockup-28","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**Every part names its role with a slot**: `eyebrow`, `title`, `body`. Unslotted text follows\nthe lockup's tier too: a bare `Heading` takes the title tier and a bare `Text` the body tier."},"1540":{"id":"/docs/components/text-lockup-29","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The eyebrow is `slot=\"eyebrow\"`**, on either a `Text` or a `Tag`. The two forms swap\nfreely, and a `Tag` is sized to pair with the lockup."},"1541":{"id":"/docs/components/text-lockup-30","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The title is `<Heading slot=\"title\">`.** Pick the level from the document outline, not the\nvisual size: `size` handles the visuals, so `level={1}` in an `xs` lockup is perfectly valid."},"1542":{"id":"/docs/components/text-lockup-31","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The body is `<Text slot=\"body\">`**, once or as many times as the copy needs."},"1543":{"id":"/docs/components/text-lockup-32","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**An explicit prop on a child always wins** over what the lockup supplies. Pass\n`<Tag slot=\"eyebrow\" size=\"sm\">` to break the pairing, for instance."},"1544":{"id":"/docs/components/text-lockup-33","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**Controls keep the scale size.** A `Button` inside a lockup follows the surrounding\nsize scope or its own `size` prop, never the lockup's tier."},"1545":{"id":"/docs/components/text-lockup-34","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**`size` is the tier.** The eyebrow reads it on the `detail` ramp, the title on `heading`, and\nthe body on `body`, so there is no table to memorize. Without `size`, the lockup follows the\nsurrounding size scope. A tier is the same at every container width."},"1546":{"id":"/docs/components/text-lockup-35","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"Pass `className` to extend the styles, or select on `[data-size]` and `[data-align]`."},"1547":{"id":"/docs/components/text-lockup-36","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"The title carries the heading semantics. Choose `level` so the page outline stays correct\nrather than to achieve a size."},"1548":{"id":"/docs/components/text-lockup-37","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"Slots resolve against the lockup, so `slot=\"title\"` names the lockup's title, not an outer\ncontainer's. Inside a\n`Modal`, `Drawer` or `Popover`, give the dialog its own `<Heading slot=\"title\">` as a direct\nchild for the accessible name, and use the lockup for the body."},"1549":{"id":"/docs/components/text-lockup-38","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"The eyebrow is decorative in most designs. If it carries meaning, make sure the title still\nreads sensibly on its own, since screen reader users often navigate by heading."},"1550":{"id":"/docs/components/text-lockup-39","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Use one `2xl` lockup per page at most — it is the page title."},"1551":{"id":"/docs/components/text-lockup-40","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Keep `legibleLines` on for running prose. Turn it off only when the lockup already sits in a\nnarrow column, where the clamp does nothing but complicate the layout."},"1552":{"id":"/docs/components/text-lockup-41","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Prefer a `Tag` eyebrow for status or category, and plain text for a kicker or section label."},"1553":{"id":"/docs/components/text-lockup-42","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Reach for `MetricsLockup` instead when the emphasis is a single number rather than prose."},"1554":{"id":"/docs/components/toggle-button","page_id":"/docs/components/toggle-button","type":"page","content":"ToggleButton","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/toggle-button"},"1555":{"id":"/docs/components/toggle-button-0","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button","content":"Accessible toggle button component for grouped contextual actions with single or multiple selection, keyboard navigation, and RTL-aware layouts."},"1556":{"id":"/docs/components/toggle-button-1","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#installation","content":"Installation"},"1557":{"id":"/docs/components/toggle-button-2","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#examples","content":"Examples"},"1558":{"id":"/docs/components/toggle-button-3","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#default","content":"Default"},"1559":{"id":"/docs/components/toggle-button-4","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#multiple-selection","content":"Multiple Selection"},"1560":{"id":"/docs/components/toggle-button-5","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#controlled","content":"Controlled"},"1561":{"id":"/docs/components/toggle-button-6","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#disabled-states","content":"Disabled States"},"1562":{"id":"/docs/components/toggle-button-7","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#sizes","content":"Sizes"},"1563":{"id":"/docs/components/toggle-button-8","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#icon--text","content":"Icon + Text"},"1564":{"id":"/docs/components/toggle-button-9","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#icon-only","content":"Icon Only"},"1565":{"id":"/docs/components/toggle-button-10","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#with-dropdown","content":"With Dropdown"},"1566":{