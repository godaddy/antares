components/button#linkbutton","content":"LinkButton"},"116":{"id":"/docs/components/button-16","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#closebutton","content":"CloseButton"},"117":{"id":"/docs/components/button-17","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use the `LinkButton` component instead when you need navigation functionality with a button-like appearance."},"118":{"id":"/docs/components/button-18","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use the `CloseButton` preset to dismiss an overlay (such as a `Modal`). It defaults to `slot=\"close\"`, so it picks up the overlay's close behavior with no wiring, and always renders an `x` icon with `aria-label=\"Close\"`. For a labelled dismiss action (e.g. \"Cancel\"), use a raw `<Button slot=\"close\">Cancel</Button>`."},"119":{"id":"/docs/components/button-19","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Inside a field `Group`, `slot=\"control\"` and `slot=\"trigger\"` pick up the matching look, size, and\ndisabled state from context. See TextField for control affixes, and Select or DatePicker for trigger faces.\nThe `control` and `trigger` variants are field parts: the field sizes them, so use them only inside a field."},"120":{"id":"/docs/components/button-20","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#default","content":"The default/tertiary button is the base for all other buttons in the system. It provides no significant visual treatment other than to provide indication for the user to take a common action."},"121":{"id":"/docs/components/button-21","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#primary","content":"The primary button should be used to indicate the most important action for the user to take in their current experience."},"122":{"id":"/docs/components/button-22","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#secondary","content":"The secondary button indicates an action of secondary importance."},"123":{"id":"/docs/components/button-23","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#tertiary","content":"The tertiary button is the default, low-emphasis style used for common, non-critical actions."},"124":{"id":"/docs/components/button-24","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#critical","content":"The critical button signifies to the user a destructive action will take place."},"125":{"id":"/docs/components/button-25","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#disabled","content":"Any button variant can be disabled to prevent interaction, communicated with reduced opacity and a not-allowed cursor."},"126":{"id":"/docs/components/button-26","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#icon","content":"You may provide an optional `Icon` component to the button. Wrap the text beside an icon in a `Text`. If you do not include text, you must provide an aria-label attribute to identify the purpose of the button. This will produce a square button."},"127":{"id":"/docs/components/button-27","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#inline","content":"The inline button sits within a run of text, styled like a link while retaining button semantics."},"128":{"id":"/docs/components/button-28","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#minimal","content":"The minimal button is an icon-only button that's used when space is limited and/or when the action is universally understood."},"129":{"id":"/docs/components/button-29","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#sizes","content":"Buttons come in small, medium, and large sizes to fit different layout densities. Without\n`size`, a button follows the surrounding size scope, and uses medium outside any scope. An\nicon-only button is square and as tall as a text button of the same size."},"130":{"id":"/docs/components/calendar","page_id":"/docs/components/calendar","type":"page","content":"Calendar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/calendar"},"131":{"id":"/docs/components/calendar-0","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar","content":"Accessible calendar grids for selecting a single date (Calendar) or a date range (RangeCalendar), built on React Aria."},"132":{"id":"/docs/components/calendar-1","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#features","content":"Features"},"133":{"id":"/docs/components/calendar-2","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#installation","content":"Installation"},"134":{"id":"/docs/components/calendar-3","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#working-with-dates","content":"Working with dates"},"135":{"id":"/docs/components/calendar-4","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#examples","content":"Examples"},"136":{"id":"/docs/components/calendar-5","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#default","content":"Default"},"137":{"id":"/docs/components/calendar-6","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#with-value","content":"With value"},"138":{"id":"/docs/components/calendar-7","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"