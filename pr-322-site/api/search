","content":"Adding Icons Synchronously"},"497":{"id":"/docs/components/icon-13","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#adding-icons-asynchronously","content":"Adding Icons Asynchronously"},"498":{"id":"/docs/components/icon-14","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#custom-icon-apis","content":"Custom Icon APIs"},"499":{"id":"/docs/components/icon-15","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#notes","content":"Notes"},"500":{"id":"/docs/components/icon-16","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#styling","content":"Styling"},"501":{"id":"/docs/components/icon-17","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#css-classes","content":"CSS Classes"},"502":{"id":"/docs/components/icon-18","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#data-attributes","content":"Data Attributes"},"503":{"id":"/docs/components/icon-19","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#color-customization","content":"Color Customization"},"504":{"id":"/docs/components/icon-20","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#inherit-from-parent-default","content":"Inherit from Parent (Default)"},"505":{"id":"/docs/components/icon-21","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#explicit-colors","content":"Explicit Colors"},"506":{"id":"/docs/components/icon-22","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#icon-transformations","content":"Icon Transformations"},"507":{"id":"/docs/components/icon-23","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#rotation","content":"Rotation"},"508":{"id":"/docs/components/icon-24","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#flipping","content":"Flipping"},"509":{"id":"/docs/components/icon-25","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#loading-states","content":"Loading States"},"510":{"id":"/docs/components/icon-26","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#placeholder-content","content":"Placeholder Content"},"511":{"id":"/docs/components/icon-27","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#accessibility","content":"Accessibility"},"512":{"id":"/docs/components/icon-28","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#decorative-icons","content":"Decorative Icons"},"513":{"id":"/docs/components/icon-29","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#semantic-icons","content":"Semantic Icons"},"514":{"id":"/docs/components/icon-30","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#interactive-icons","content":"Interactive Icons"},"515":{"id":"/docs/components/icon-31","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#performance-considerations","content":"Performance Considerations"},"516":{"id":"/docs/components/icon-32","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#default-icon-loading","content":"Default Icon Loading"},"517":{"id":"/docs/components/icon-33","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#sprite-mode-optimization","content":"Sprite Mode Optimization"},"518":{"id":"/docs/components/icon-34","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#recommendations","content":"Recommendations"},"519":{"id":"/docs/components/icon-35","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#troubleshooting","content":"Troubleshooting"},"520":{"id":"/docs/components/icon-36","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#icon-not-loading","content":"Icon Not Loading"},"521":{"id":"/docs/components/icon-37","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#performance-issues","content":"Performance Issues"},"522":{"id":"/docs/components/icon-38","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon","content":"The `Icon` component provides a flexible and performant way to display SVG icons with extensive customization options. Built on top of the Bento Icon system, it features on-demand loading from a CDN, automatic caching, and enhanced props for the Antares design system."},"523":{"id":"/docs/components/icon-39","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**On-demand loading**: Icons are loaded asynchronously from CDN only when needed"},"524":{"id":"/docs/components/icon-40","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Automatic caching**: Once loaded, icons are cached for optimal performance"},"525":{"id":"/docs/components/icon-41","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Flexible sizing**: Support for `width` and `height` props"},"526":{"id":"/docs/components/icon-42","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Color inheritance**: Uses `currentColor` by default for seamless theme integration"},"527":{"id":"/docs/components/icon-43","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Accessibility ready**: Built-in support for screen readers and keyboard navigation"},"528":{"id":"/docs/components/icon-44","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**TypeScript support**: Fully typed with comprehensive prop interfaces"},"529":{"id":"/docs/components/icon-45","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Bento integration**: Extends Bento Icon with additional Antares-specific features"},"530":{"id":"/docs/components/icon-46","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#props","content":"The `Icon` component accepts the following props:"},"531":{"id":"/docs/components/icon-47","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"The component extends `BentoIconProps` and passes through all standard HTML attributes and accessibility props to the underlying Bento Icon component. This includes:"},"532":{"id":"/docs/components/icon-48","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Accessibility**: `aria-label`, `aria-describedby`, `role`, `title`"},"533":{"id":"/docs/components/icon-49","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Events**: `onClick`, `onMouseOver`, `onFocus`, etc."},"534":{"id":"/docs/components/icon-50","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Styling**: `className`, `style`, `data-*` attributes"},"535":{"id":"/docs/components/icon-51","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Transform**: `rotate`, `flip` for icon transformations"},"536":{"id":"/docs/components/icon-52","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#size-variants","content":"Specify explicit width and height values:"},"537":{"id":"/docs/components/icon-53","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#size-variants","content":"You can use different values for width and height:"},"538":{"id":"/docs/components/icon-54","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#slots","content":"The Icon component uses Bento's slot system with the following component hierarchy and available slot override points:"},"539":{"id":"/docs/components/icon-55","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#available-slot-overrides","content":"**`icon`**: Overrides the entire BentoIcon component - affects icon loading, caching, sprite/SVG mode switching, data attributes, and the overall icon wrapper"},"540":{"id":"/docs/components/icon-56","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#available-slot-overrides","content":"**`icon.content`**: Overrides the BentoIllustration component - affects SVG transformations (rotate, flip), accessibility attributes (`role`, `focusable`, `aria-labelledby`), viewBox calculations, and final SVG element rendering"},"541":{"id":"/docs/components/icon-57","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#available-slot-overrides","content":"For complete slot override patterns and examples, see the `@bento/slots` package documentation."},"542":{"id":"/docs/components/icon-58","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icons","content":"While the Icon component loads design system approved icons from the CDN by default, teams can introduce custom icons using the underlying Bento Icon system."},"543":{"id":"/docs/components/icon-59","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#adding-icons-synchronously","content":"Use the `set` method to add custom icons that are available immediately:"},"544":{"id":"/docs/components/icon-60","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#adding-icons-asynchronously","content":"Use the `ondemand` method to load custom icons from your own sources:"},"545":{"id":"/docs/components/icon-61","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"The following methods are exported from `@godaddy/antares` for custom icon management:"},"546":{"id":"/docs/components/icon-62","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"**`set(icons)`**: Synchronously add icons to the store"},"547":{"id":"/docs/components/icon-63","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"**`ondemand(loader)`**: Register an asynchronous icon loader (returns unregister function)"},"548":{"id":"/docs/components/icon-64","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"**`parser(svgString)`**: Parse SVG strings into React elements"},"549":{"id":"/docs/components/icon-65","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"These are re-exports of the underlying Bento Icon system methods. For complete API documentation, advanced usage patterns, and implementation details, see the `@bento/icon` and `@bento/svg-parser` package documentation."},"550":{"id":"/docs/components/icon-66","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Custom icons integrate seamlessly with all Icon component features (transformations, accessibility, sprite mode, etc.)"},"551":{"id":"/docs/components/icon-67","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Multiple `ondemand` loaders can be registered and will be called in order until one returns content"},"552":{"id":"/docs/components/icon-68","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Use the `parser` function to convert SVG strings to React elements"},"553":{"id":"/docs/components/icon-69","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Custom icons are cached automatically just like CDN icons"},"554":{"id":"/docs/components/icon-70","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#css-classes","content":"The component accepts standard `className` and `style` props:"},"555":{"id":"/docs/components/icon-71","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#css-classes","content":"**Important**: When you supply a `className`, you make a commitment to take over all styling of the component as it will remove the standard class names. Use data attributes for targeted styling instead."},"556":{"id":"/docs/components/icon-72","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"The component automatically adds data attributes for styling hooks:"},"557":{"id":"/docs/components/icon-73","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-icon`: The icon name (always present)"},"558":{"id":"/docs/components/icon-74","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-color`: Applied when color prop is set"},"559":{"id":"/docs/components/icon-75","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-loading`: Applied during icon loading from CDN"},"560":{"id":"/docs/components/icon-76","page_id":"/docs/components/icon","tag