","content":"Provide concise, meaningful `alt` text when the image conveys information."},"596":{"id":"/docs/components/image-12","page_id":"/docs/components/image","tags":[],"type":"text","url":"/docs/components/image#accessibility","content":"Use `alt=\"\"` for decorative images or images already described by adjacent text."},"597":{"id":"/docs/components/image-13","page_id":"/docs/components/image","tags":[],"type":"text","url":"/docs/components/image#accessibility","content":"Set `width` and `height` when known to reserve space and reduce layout shift."},"598":{"id":"/docs/components/inline-drawer","page_id":"/docs/components/inline-drawer","type":"page","content":"InlineDrawer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/inline-drawer"},"599":{"id":"/docs/components/inline-drawer-0","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer","content":"An in-flow collapsible built on RAC Disclosure. Compose a trigger and content to make an accordion or a sidebar rail."},"600":{"id":"/docs/components/inline-drawer-1","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#features","content":"Features"},"601":{"id":"/docs/components/inline-drawer-2","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#installation","content":"Installation"},"602":{"id":"/docs/components/inline-drawer-3","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#examples","content":"Examples"},"603":{"id":"/docs/components/inline-drawer-4","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#default","content":"Default"},"604":{"id":"/docs/components/inline-drawer-5","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#controlled","content":"Controlled"},"605":{"id":"/docs/components/inline-drawer-6","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#sidebar-nav","content":"Sidebar Nav"},"606":{"id":"/docs/components/inline-drawer-7","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#accessibility","content":"Accessibility"},"607":{"id":"/docs/components/inline-drawer-8","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#keyboard","content":"Keyboard"},"608":{"id":"/docs/components/inline-drawer-9","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#aria","content":"ARIA"},"609":{"id":"/docs/components/inline-drawer-10","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#best-practices","content":"Best Practices"},"610":{"id":"/docs/components/inline-drawer-11","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#props","content":"Props"},"611":{"id":"/docs/components/inline-drawer-12","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer","content":"`InlineDrawerPanel` is the collapsible content for the accordion pattern — a thin wrapper over RAC `DisclosurePanel` that hides when collapsed. The trigger is any component you slot in with `slot=\"trigger\"` — there's no dedicated trigger component."},"612":{"id":"/docs/components/inline-drawer-13","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"In-flow collapsible built on RAC Disclosure — bring your own trigger via `slot=\"trigger\"`"},"613":{"id":"/docs/components/inline-drawer-14","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Animated by default; `animate={false}` disables the transition"},"614":{"id":"/docs/components/inline-drawer-15","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"`placement` selects the collapse axis (`left`/`right` → width, `top`/`bottom` → height)"},"615":{"id":"/docs/components/inline-drawer-16","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Controlled and uncontrolled modes (`isExpanded` / `defaultExpanded` / `onExpandedChange`)"},"616":{"id":"/docs/components/inline-drawer-17","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Accordion collapse uses the browser's `hidden=\"until-found\"` for find-in-page"},"617":{"id":"/docs/components/inline-drawer-18","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"`prefers-reduced-motion` support"},"618":{"id":"/docs/components/inline-drawer-19","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#default","content":"Put a `<Button slot=\"trigger\">` and an `<InlineDrawerPanel>` inside `InlineDrawer`. The panel hides when collapsed and animates open."},"619":{"id":"/docs/components/inline-drawer-20","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#controlled","content":"Use `isExpanded` and `onExpandedChange` to drive state externally."},"620":{"id":"/docs/components/inline-drawer-21","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#sidebar-nav","content":"A rail whose content stays visible when collapsed is a composition, not a mode: drive `isExpanded` yourself, render always-visible children (no `InlineDrawerPanel`), and let `minSize`/`maxSize` size the rail. Use numeric (px) sizes so the width animates; intrinsic keywords like `min-content`/`max-content` fit the content exactly but don't animate."},"621":{"id":"/docs/components/inline-drawer-22","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Key"},"622":{"id":"/docs/components/inline-drawer-23","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Action"},"623":{"id":"/docs/components/inline-drawer-24","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"`Enter` / `Space`"},"624":{"id":"/docs/components/inline-drawer-25","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Toggle via the slotted trigger"},"625":{"id":"/docs/components/inline-drawer-26","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"`Tab`"},"626":{"id":"/docs/components/inline-drawer-27","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Move focus through the content"},"627":{"id":"/docs/components/inline-drawer-28","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#aria","content":"A `<Button slot=\"trigger\">` gets `aria-expanded` + `aria-controls` wired to the `InlineDrawerPanel` automatically (via RAC Disclosure)."},"628":{"id":"/docs/components/inline-drawer-29","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#aria","content":"For the sidebar rail, the toggle is your own control (e.g. a `ToggleButton`) — give icon-only buttons an `aria-label`, and the content stays in the DOM and accessible since nothing is hidden."},"629":{"id":"/docs/components/inline-drawer-30","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"Accordion → `Button slot=\"trigger\"` + `InlineDrawerPanel`. Sidebar rail → controlled state + always-visible children."},"630":{"id":"/docs/components/inline-drawer-31","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"For the rail, use numeric (px) `minSize`/`maxSize` so the width animates; `min-content`/`max-content` fit the content exactly but won't animate."},"631":{"id":"/docs/components/inline-drawer-32","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"`placement` does not flip in RTL; the side is decided by document/flex order."},"632":{"id":"/docs/components/inline-drawer-33","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"Don't nest InlineDrawers."},"633":{"id":"/docs/components/inline-drawer-34","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#props","content":"The `InlineDrawerPanel` component accepts the following props:"},"634":{"id":"/docs/components/listbox","page_id":"/docs/components/listbox","type":"page","content":"ListBox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/listbox"},"635":{"id":"/docs/components/listbox-0","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox","content":"ListBox is a selectable collection of items rendered inline. Use it for non-popover pickers, inline lists, or as a building block for higher-level components like Select."},"636":{"id":"/docs/components/listbox-1","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#features","content":"Features"},"637":{"id":"/docs/components/listbox-2","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#installation","content":"Installation"},"638":{"id":"/docs/components/listbox-3","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#examples","content":"Examples"},"639":{"id":"/docs/components/listbox-4","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#default","content":"Default"},"640":{"id":"/docs/components/listbox-5","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#list-box-controlled","content":"List Box Controlled"},"641":{"id":"/docs/components/listbox-6","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#list-box-multiple","content":"List Box Multiple"},"642":{"id":"/docs/components/listbox-7","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#props","content":"Props"},"643":{"id":"/docs/components/listbox-8","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Single or multiple selection**: Set `selectionMode=\"single\"` or `\"multiple\"`."},"644":{"id":"/docs/components/listbox-9","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Controlled or uncontrolled**: Use `selectedKeys` and `onSelectionChange` for controlled state, or `defaultSelectedKeys` for uncontrolled."},"645":{"id":"/docs/components/listbox-10","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Layout primitive**: `ListBox` and `ListBoxItem` accept layout props (`gap`, `padding`, etc.) — they extend `FlexOwnProps`."},"646":{"id":"/docs/components/listbox-11","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Composes into other components**: `Select` uses `ListBox` internally; reach for `ListBox` directly when you need an inline list rather than a popover dropdown."},"647":{"id":"/docs/components/listbox-12","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**React Aria integration**: Built on React Aria ListBox for accessibility, keyboard navigation, and typeahead."},"648":{"id":"/docs/components/listbox-13","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"`ListBox` requires either `aria-label` or `aria-labelledby`. For a labeled, popover-style picker, prefer `Select`."},"649":{"id":"/docs/components/listbox-14","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#default","content":"Single selection with static children. Use `aria-label` to give the listbox an accessible name."},"650":{"id":"/docs/components/listbox-15","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-controlled","content":"Use `selectedKeys` and `onSelectionChange` for controlled state."},"651":{"id":"/docs/components/listbox-16","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-multiple","content":"Set `selectionMode=\"multiple\"` to allow multiple values. `selectedKeys` is a `Set<Key>` (or the literal `'all'`)."},"652":{"id":"/docs/components/listbox-17","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#props","content":"The ListBox component accepts the following props:"},"653":{"id":"/docs/components/menu","page_id":"/docs/components/menu","type":"page","content":"Menu","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/menu"},"654":{"id":"/docs/components/menu-0","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"Accessible dropdown menu with grouping, multi-select checkbox items, leading icons, and submenus."},"655":{"id":"/docs/components/menu-1","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#features","content":"Features"},"656":{"id":"/docs/components/menu-2","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#installation","content":"Installation"},"657":{"id":"/docs/components/menu-3","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#examples","content":"Examples"},"658":{"id":"/docs/components/menu-4","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#default","content":"Default"},"659":{"id":"/docs/components/menu-5","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#controlled","content":"Controlled"},"660":{"id":"/docs/components/menu-6","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#bottom-sheet","content":"Bottom Sheet"},"661":{"id":"/docs/components/menu-7","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#groups","content":"Groups"},"662":{"id":"/docs/components/menu-8","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#multiple-selection","content":"Multiple Selection"},"663":{"id":"/docs/components/menu-9","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#rich-content-from-an-item","content":"Rich Content From an Item"},"664":{"id":"/docs/components/menu-10","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#single-selection","content":"Single Selection"},"665":{"id":"/docs/components/menu-11","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#sizes","content":"Sizes"},"666":{"id":"/docs/components/menu-12","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenu","content":"Submenu"},"667":{"id":"/docs/components/menu-13","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#accessibility","content":"Accessibility"},"668":{"id":"/docs/components/menu-14","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#best-practices","content":"Best Practices"},"669":{"id":"/docs/components/menu-15","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#props","content":"Props"},"670":{"id":"/docs/components/menu-16","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menu","content":"Menu"},"671":{"id":"/docs/components/menu-17","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menutrigger","content":"MenuTrigger"},"672":{"id":"/docs/components/menu-18","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menugroup","content":"MenuGroup"},"673":{"id":"/docs/components/menu-19","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menuitem","content":"MenuItem"},"674":{"id":"/docs/components/menu-20","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenutrigger","content":"SubmenuTrigger"},"675":{"id":"/docs/components/menu-21","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"An accessible dropdown menu built on React Aria. It supports grouping with optional\ntitles, multi-select checkbox items, leading icons, submenus, and two sizes. It\nreuses Antares' `Popover` for the overlay and `Checkbox` indicator for selection."},"676":{"id":"/docs/components/menu-22","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Grouping with an optional title via `MenuGroup`, plus `MenuSeparator` dividers"},"677":{"id":"/docs/components/menu-23","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Multi-select groups: set `selectionMode=\"multiple\"` on a `MenuGroup` to render\nits items as checkboxes, while other groups stay plain action items"},"678":{"id":"/docs/components/menu-24","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Optional leading `icon` per item; links (`href`) and disabled items"},"679":{"id":"/docs/components/menu-25","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Submenus via `SubmenuTrigger`"},"680":{"id":"/docs/components/menu-26","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Two sizes (`sm`, `md`); set `size` explicitly on each submenu `Menu`"},"681":{"id":"/docs/components/menu-27","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Usable anchored to a trigger or standalone (e.g. inside a bottom-sheet `Drawer`)"},"682":{"id":"/docs/components/menu-28","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#default","content":"A trigger with plain action items."},"683":{"id":"/docs/components/menu-29","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#controlled","content":"`MenuTrigger` exposes its open state via `isOpen`/`onOpenChange`,\nwhich can be used to drive the rotation of a chevron icon."},"684":{"id":"/docs/components/menu-30","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#bottom-sheet","content":"On small screens a menu often reads better as a bottom sheet than an anchored\npopover. Since `Menu` works standalone, drop it into a bottom `Drawer`."},"685":{"id":"/docs/components/menu-31","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#groups","content":"Labeled groups separated by dividers, a multi-select checkbox group mixed with\nplain action groups, leading icons, a disabled item, and a link."},"686":{"id":"/docs/components/menu-32","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#multiple-selection","content":"A `MenuGroup` with `selectionMode=\"multiple\"` renders its items as checkboxes.\nDrive the checked items with `selectedKeys` + `onSelectionChange` or\nseed them uncontrolled with `defaultSelectedKeys`. Keys correspond to each\n`MenuItem`'s `id`."},"687":{"id":"/docs/components/menu-33","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#rich-content-from-an-item","content":"A `Menu` is a collection, so it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger` children. Rich content inside a `Menu`\nor submenu is not supported. To show a `Calendar`, let the item close the\nmenu from `onAction` and open a separate `Popover` anchored to the trigger\nwith `triggerRef`."},"688":{"id":"/docs/components/menu-34","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#single-selection","content":"A `MenuGroup` with `selectionMode=\"single\"` lets one item be selected at a time.\nDrive it with `selectedKeys` + `onSelectionChange` or seed it uncontrolled with\n`defaultSelectedKeys`. Keys correspond to each `MenuItem`'s `id`."},"689":{"id":"/docs/components/menu-35","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#sizes","content":"`size` controls item density. Shown here as two standalone menus so both\nsizes are visible at once; in practice you set `size` on the `Menu` inside a\n`MenuTrigger`."},"690":{"id":"/docs/components/menu-36","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#submenu","content":"Nested menus via `SubmenuTrigger`."},"691":{"id":"/docs/components/menu-37","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Space/Enter**: activate an item; **Escape**: close"},"692":{"id":"/docs/components/menu-38","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Up/Down**: move between items; **Home/End**: first/last"},"693":{"id":"/docs/components/menu-39","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Right/Left**: open/close a submenu"},"694":{"id":"/docs/components/menu-40","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Type to select**: jump to a matching item (string labels are used as `textValue`)"},"695":{"id":"/docs/components/menu-41","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"Multi-select items use RAC's `menuitemcheckbox` role; the checkbox indicator is\ndecorative (`aria-hidden`) and the item owns interaction"},"696":{"id":"/docs/components/menu-42","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Give each selectable `MenuItem` a stable `id`, and provide the `Menu` an\n`aria-label` when there is no visible label."},"697":{"id":"/docs/components/menu-43","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Use a leading `icon` for recognition, not as the only label - keep a text label."},"698":{"id":"/docs/components/menu-44","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Reserve checkbox groups for multi-select; use plain groups for one-shot actions."},"699":{"id":"/docs/components/menu-45","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"A `Menu` is a collection: it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger`. For rich content (a `Calendar`, a form),\nclose the menu from `onAction` and open a separate `Popover` anchored with\n`triggerRef` instead of putting it in a submenu."},"700":{"id":"/docs/components/metrics-lockup","page_id":"/docs/components/metrics-lockup","type":"page","content":"MetricsLockup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/metrics-lockup"},"701":{"id":"/docs/components/metrics-lockup-0","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"The MetricsLockup component displays a single metric with an optional title, info tooltip, trend indicator, and description."},"702":{"id":"/docs/components/metrics-lockup-1","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#installation","content":"Installation"},"703":{"id":"/docs/components/metrics-lockup-2","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#examples","content":"Examples"},"704":{"id":"/docs/components/metrics-lockup-3","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#default","content":"Default"},"705":{"id":"/docs/components/metrics-lockup-4","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#with-trend","content":"With Trend"},"706":{"id":"/docs/components/metrics-lockup-5","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#compact","content":"Compact"},"707":{"id":"/docs/components/metrics-lockup-6","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#accessibility","content":"Accessibility"},"708":{"id":"/docs/components/metrics-lockup-7","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#keyboard","content":"Keyboard"},"709":{"id":"/docs/components/metrics-lockup-8","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#aria","content":"ARIA"},"710":{"id":"/docs/components/metrics-lockup-9","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#best-practices","content":"Best Practices"},"711":{"id":"/docs/components/metrics-lockup-10","page_id":"/docs/components/metrics-lockup","type":"heading","tags":[],"url":"/docs/components/metrics-lockup#props","content":"Props"},"712":{"id":"/docs/components/metrics-lockup-11","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup","content":"MetricsLockup displays a metric value prominently, with an optional title and tooltip for context, an optional trend icon to show direction of change, and a description label below the value."},"713":{"id":"/docs/components/metrics-lockup-12","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#default","content":"A metric with a title, info tooltip, value, and description."},"714":{"id":"/docs/components/metrics-lockup-13","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#with-trend","content":"Use the `trend` prop to show a directional icon next to the description. Accepts `'positive'`, `'negative'`, or `'neutral'`."},"715":{"id":"/docs/components/metrics-lockup-14","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#compact","content":"Use the `compact` prop to render the metric value and description inline rather than stacked."},"716":{"id":"/docs/components/metrics-lockup-15","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Key"},"717":{"id":"/docs/components/metrics-lockup-16","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Description"},"718":{"id":"/docs/components/metrics-lockup-17","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Tab"},"719":{"id":"/docs/components/metrics-lockup-18","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Moves focus to the info trigger button and shows the tooltip"},"720":{"id":"/docs/components/metrics-lockup-19","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Escape"},"721":{"id":"/docs/components/metrics-lockup-20","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#keyboard","content":"Closes the tooltip"},"722":{"id":"/docs/components/metrics-lockup-21","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger button uses `aria-label=\"More information\"` to describe its purpose."},"723":{"id":"/docs/components/metrics-lockup-22","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The tooltip uses `role=\"tooltip\"` and is associated with the info trigger via `aria-describedby`."},"724":{"id":"/docs/components/metrics-lockup-23","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#aria","content":"The info trigger has a minimum touch target of 44×44px, achieved via a CSS pseudo-element, to meet WCAG 2.5.5."},"725":{"id":"/docs/components/metrics-lockup-24","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"Keep tooltip content concise and informative."},"726":{"id":"/docs/components/metrics-lockup-25","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"The `data` prop accepts strings or numbers — format currency and percentages before passing them in."},"727":{"id":"/docs/components/metrics-lockup-26","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`titleInfo` requires `title` to be set — the info icon is contextually tied to the title label. If `title` is absent, `titleInfo` has no effect."},"728":{"id":"/docs/components/metrics-lockup-27","page_id":"/docs/components/metrics-lockup","tags":[],"type":"text","url":"/docs/components/metrics-lockup#best-practices","content":"`trend` is intended to accompany `description` to provide temporal context (e.g. \"↑ +3% vs. last month\"). A trend icon alone, with no description, leaves the direction unanchored (\"up since *when*?\"). If `description` is not provided, `trend` has no effect."},"729":{"id":"/docs/components/number-field","page_id":"/docs/components/number-field","type":"page","content":"NumberField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/number-field"},"730":{"id":"/docs/components/number-field-0","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field","content":"NumberField is a numeric input with optional label, description, error message, min/max/step, and increment/decrement stepper buttons. Use it in forms for quantities, amounts, or percentages."},"731":{"id":"/docs/components/number-field-1","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#installation","content":"Installation"},"732":{"id":"/docs/components/number-field-2","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#examples","content":"Examples"},"733":{"id":"/docs/components/number-field-3","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#default","content":"Default"},"734":{"id":"/docs/components/number-field-4","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-controlled","content":"Number Field Controlled"},"735":{"id":"/docs/components/number-field-5","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-invalid","content":"Number Field Invalid"},"736":{"id":"/docs/components/number-field-6","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-disabled","content":"Number Field Disabled"},"737":{"id":"/docs/components/number-field-7","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-hide-stepper","content":"Number Field Hide Stepper"},"738":{"id":"/docs/components/number-field-8","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-value-scale","content":"Number Field Value Scale"},"739":{"id":"/docs/components/number-field-9","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#format-options-numbering-system","content":"Format options (numbering system)"},"740":{"id":"/docs/components/number-field-10","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#number-field-sizes","content":"Number Field Sizes"},"741":{"id":"/docs/components/number-field-11","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#accessibility","content":"Accessibility"},"742":{"id":"/docs/components/number-field-12","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#keyboard","content":"Keyboard"},"743":{"id":"/docs/components/number-field-13","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#aria-and-labeling","content":"ARIA and labeling"},"744":{"id":"/docs/components/number-field-14","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#best-practices","content":"Best practices"},"745":{"id":"/docs/components/number-field-15","page_id":"/docs/components/number-field","type":"heading","tags":[],"url":"/docs/components/number-field#props","content":"Props"},"746":{"id":"/docs/components/number-field-16","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#default","content":"Minimal usage with label, placeholder, and min/max."},"747":{"id":"/docs/components/number-field-17","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-controlled","content":"Use `value` and `onChange` for controlled state."},"748":{"id":"/docs/components/number-field-18","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-invalid","content":"Use `isInvalid` with `errorMessage` for validation feedback."},"749":{"id":"/docs/components/number-field-19","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-disabled","content":"Use `isDisabled` to prevent input."},"750":{"id":"/docs/components/number-field-20","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-hide-stepper","content":"Use `hideStepper` to show only the input without +/- buttons."},"751":{"id":"/docs/components/number-field-21","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-value-scale","content":"Use `minValue`, `maxValue`, and `step` to set the allowed values. Steps are calculated from the minimum value."},"752":{"id":"/docs/components/number-field-22","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#format-options-numbering-system","content":"By default, NumberField displays the value using the numbering system for the user's locale. Use the `formatOptions` prop to override the numbering system by setting the Unicode numbering system locale extension."},"753":{"id":"/docs/components/number-field-23","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#number-field-sizes","content":"Compare the supported `md` and `sm` visual sizes."},"754":{"id":"/docs/components/number-field-24","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#keyboard","content":"When focus is in the input (and the field is not read-only), keyboard behavior follows common spinbutton-style conventions:"},"755":{"id":"/docs/components/number-field-25","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#keyboard","content":"**Arrow Up** / **Arrow Down** (or **Up** / **Down**): increase or decrease by `step`"},"756":{"id":"/docs/components/number-field-26","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#keyboard","content":"**Page Up** / **Page Down**: larger increase or decrease when supported"},"757":{"id":"/docs/components/number-field-27","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#keyboard","content":"**Home** / **End**: jump to `minValue` or `maxValue` when those props are set"},"758":{"id":"/docs/components/number-field-28","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#keyboard","content":"Stepper buttons are real buttons and follow standard button keyboard activation. Use &#x2A;*`incrementAriaLabel`*&#x2A; and &#x2A;*`decrementAriaLabel`** when the default labels are not enough in your locale or UI."},"759":{"id":"/docs/components/number-field-29","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#aria-and-labeling","content":"The input is associated with the visible label and optional description and error content for assistive technologies."},"760":{"id":"/docs/components/number-field-30","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#aria-and-labeling","content":"Invalid and required states are exposed to assistive technologies when you use `isInvalid`, `errorMessage`, and `isRequired`."},"761":{"id":"/docs/components/number-field-31","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#aria-and-labeling","content":"Set &#x2A;*`isWheelDisabled`** if the value should not change when the user scrolls with a pointer wheel while the field is focused."},"762":{"id":"/docs/components/number-field-32","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#best-practices","content":"Pair &#x2A;*`isInvalid`*&#x2A; with &#x2A;*`errorMessage`** so users get both visual and programmatic feedback."},"763":{"id":"/docs/components/number-field-33","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#best-practices","content":"Remember valid steps start from &#x2A;*`minValue`**."},"764":{"id":"/docs/components/number-field-34","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#best-practices","content":"Use &#x2A;*`isDisabled`*&#x2A; when the value cannot be changed; use &#x2A;*`isReadOnly`** when the value should be visible but not editable. Do not use them interchangeably."},"765":{"id":"/docs/components/number-field-35","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#best-practices","content":"For currency or units, ensure &#x2A;*`formatOptions`** (and locale) match what users are allowed to type."},"766":{"id":"/docs/components/number-field-36","page_id":"/docs/components/number-field","tags":[],"type":"text","url":"/docs/components/number-field#props","content":"The `NumberField` component accepts the following props:"},"767":{"id":"/docs/components/modal","page_id":"/docs/components/modal","type":"page","content":"Modal","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/modal"},"768":{"id":"/docs/components/modal-0","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"The Modal component presents a dialog window over the page that focuses the user's attention on a single task or piece of information."},"769":{"id":"/docs/components/modal-1","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#installation","content":"Installation"},"770":{"id":"/docs/components/modal-2","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#examples","content":"Examples"},"771":{"id":"/docs/components/modal-3","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#default","content":"Default"},"772":{"id":"/docs/components/modal-4","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#controlled","content":"Controlled"},"773":{"id":"/docs/components/modal-5","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#scrollable","content":"Scrollable"},"