omponents/progress-steps-4","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#default","content":"Default"},"938":{"id":"/docs/components/progress-steps-5","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#not-started","content":"Not started"},"939":{"id":"/docs/components/progress-steps-6","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#vertical","content":"Vertical"},"940":{"id":"/docs/components/progress-steps-7","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#interactive","content":"Interactive"},"941":{"id":"/docs/components/progress-steps-8","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#disabled","content":"Disabled"},"942":{"id":"/docs/components/progress-steps-9","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#hide-step-numbers","content":"Hide Step Numbers"},"943":{"id":"/docs/components/progress-steps-10","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#customization","content":"Customization"},"944":{"id":"/docs/components/progress-steps-11","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#accessibility","content":"Accessibility"},"945":{"id":"/docs/components/progress-steps-12","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#best-practices","content":"Best Practices"},"946":{"id":"/docs/components/progress-steps-13","page_id":"/docs/components/progress-steps","type":"heading","tags":[],"url":"/docs/components/progress-steps#troubleshooting","content":"Troubleshooting"},"947":{"id":"/docs/components/progress-ste