/date` (a re-export of\n`@internationalized/date`).\nWrap the app in `<I18nProvider>` so formatting and the calendar follow the user's locale."},"374":{"id":"/docs/components/date-picker-23","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#default","content":"A single date picker with a `Label`."},"375":{"id":"/docs/components/date-picker-24","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#range","content":"A start/end range picker."},"376":{"id":"/docs/components/date-picker-25","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#controlled","content":"Driving the value with `useState`."},"377":{"id":"/docs/components/date-picker-26","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#format-options","content":"Controlling the trigger's label format via `formatOptions`."},"378":{"id":"/docs/components/date-picker-27","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#min--max","content":"Bounding selectable dates with `minValue` / `maxValue`."},"379":{"id":"/docs/components/date-picker-28","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#with-error","content":"An invalid picker showing a validation message via `isInvalid` and a `FieldError`."},"380":{"id":"/docs/components/date-picker-29","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#disabled","content":"A disabled picker via `isDisabled`."},"381":{"id":"/docs/components/date-picker-30","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#composed","content":"Write the trigger and the overlay yourself instead of composing `DatePickerCalendar`, for full\ncontrol over the popover and the calendar."},"382":{"id":"/doc