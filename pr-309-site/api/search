","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Description"},"1342":{"id":"/docs/components/tooltip-15","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Tab"},"1343":{"id":"/docs/components/tooltip-16","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Moves focus to the focusable element and shows the tooltip"},"1344":{"id":"/docs/components/tooltip-17","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Escape"},"1345":{"id":"/docs/components/tooltip-18","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Closes the tooltip"},"1346":{"id":"/docs/components/tooltip-19","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#aria","content":"The tooltip uses `role=\"tooltip\"` and is associated with its focusable element via `aria-describedby`."},"1347":{"id":"/docs/components/tooltip-20","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Keep tooltip content short and informative."},"1348":{"id":"/docs/components/tooltip-21","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Tooltips are not shown on touch screen interactions. Ensure your UI is usable without tooltips."},"1349":{"id":"/docs/components/tooltip-22","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Do not place interactive content inside tooltips. Use a `Popover` instead."},"1350":{"id":"/docs/components/chart/bar-chart","page_id":"/docs/components/chart/bar-chart","type":"page","content":"Bar Chart","breadcrumbs":["Docs","Components","Chart"],"tags":[],"url":"/docs/components/chart