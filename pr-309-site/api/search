86":{"id":"/docs/components/chart/line-chart-25","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#browser-usage","content":"Browser usage"},"1487":{"id":"/docs/components/chart/line-chart-26","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#rtl","content":"RTL"},"1488":{"id":"/docs/components/chart/line-chart-27","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#customization","content":"Customization"},"1489":{"id":"/docs/components/chart/line-chart-28","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#data-attributes","content":"Data Attributes"},"1490":{"id":"/docs/components/chart/line-chart-29","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#component-customization","content":"Component Customization"},"1491":{"id":"/docs/components/chart/line-chart-30","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#accessibility","content":"Accessibility"},"1492":{"id":"/docs/components/chart/line-chart-31","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#aria-support","content":"ARIA Support"},"1493":{"id":"/docs/components/chart/line-chart-32","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#best-practices","content":"Best Practices"},"1494":{"id":"/docs/components/chart/line-chart-33","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"When to Use LineChart"},"1495":{"id":"/docs/components/chart/line-chart-34","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#troubleshooting","content":"Troubleshooting"},"1496":{"id":"/docs/components/chart/line-chart-35","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#chart-not-sizing-or-empty","content":"Chart Not Sizing or Empty"},"1497":{"id":"/docs/components/chart/line-chart-36","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#dates-not-displaying-correctly","content":"Dates Not Displaying Correctly"},"1498":{"id":"/docs/components/chart/line-chart-37","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#tooltip-or-crosshair-not-showing","content":"Tooltip or Crosshair Not Showing"},"1499":{"id":"/docs/components/chart/line-chart-38","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#props","content":"Props"},"1500":{"id":"/docs/components/chart/line-chart-39","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#default","content":"One line, a time-scale X axis, and almost nothing else configured - the everyday starting point. You give the chart a \\`series\\` array and it reads \\`x\\`/\\`y\\` from each point."},"1501":{"id":"/docs/components/chart/line-chart-40","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#multiple-series","content":"Several lines sharing one X axis, with a legend naming each of them. Reach for this when the comparison between series is the story."},"1502":{"id":"/docs/components/chart/line-chart-41","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#gridlines","content":"\\`xGridlines\\` and \\`yGridlines\\` add faint lines across the plot so it is easier to read a value back off an axis."},"1503":{"id":"/docs/components/chart/line-chart-42","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#titles","content":"\\`xTitle\\` and \\`yTitle\\` label what each axis actually measures, e.g. \"Month\" and \"Temperature (°F)\"."},"1504":{"id":"/docs/components/chart/line-chart-43","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#labels","content":"\\`xLabels\\` and \\`yLabels\\` toggle the tick labels on each axis. Turn them off for sparklines or when the surrounding UI already names the values."},"1505":{"id":"/docs/components/chart/line-chart-44","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#ticks","content":"\\`xTickMarks\\` and \\`yTickMarks\\` draw the short lines at each tick value, which helps tie a label to its exact position on the axis."},"1506":{"id":"/docs/components/chart/line-chart-45","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#baselines","content":"\\`xBaseline\\` and \\`yBaseline\\` control the main axis lines themselves. Dropping them gives a lighter, more editorial chart."},"1507":{"id":"/docs/components/chart/line-chart-46","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#legend","content":"\\`legendPosition\\` puts the legend above or below the plot, or hides it with \\`null\\`. Multi-series charts get a bottom legend by default."},"1508":{"id":"/docs/components/chart/line-chart-47","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#axis-and-tooltip-formatting","content":"\\`xTickFormat\\` and \\`yTickFormat\\` shape the axis labels - dates, currency, units, percentages - and the tooltip follows the same formatting."},"1509":{"id":"/docs/components/chart/line-chart-48","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-accessors","content":"When your data does not use \\`x\\`/\\`y\\`, point \\`xAccessor\\` and \\`yAccessor\\` at the fields it does use (here \\`date\\` and \\`value\\`) instead of reshaping the data first."},"1510":{"id":"/docs/components/chart/line-chart-49","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#missing-values","content":"A \\`null\\` Y value breaks the line instead of drawing through the gap, so missing data reads as missing rather than as a straight interpolation."},"1511":{"id":"/docs/components/chart/line-chart-50","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#fixed-domain","content":"\\`xDomain\\` and \\`yDomain\\` pin the visible range. Use them to keep a fixed scale, or to keep several charts comparable."},"1512":{"id":"/docs/components/chart/line-chart-51","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#nice-values","content":"\\`xNice\\` and \\`yNice\\` round the domain out to friendlier numbers (e.g. 0.2 to 1.0), so ticks land on values people expect."},"1513":{"id":"/docs/components/chart/line-chart-52","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#zero-included","content":"\\`xZero\\` and \\`yZero\\` stretch the domain to include zero. Worth doing when the absolute size of the values matters, not just their movement."},"1514":{"id":"/docs/components/chart/line-chart-53","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-ticks","content":"Choose the ticks yourself with \\`xTickValues\\`/\\`yTickValues\\`, or just ask for roughly how many you want with \\`xNumTicks\\`/\\`yNumTicks\\`."},"1515":{"id":"/docs/components/chart/line-chart-54","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#band-padding","content":"\\`xPaddingOuter\\` and \\`yPaddingOuter\\` add breathing room at the ends of a band or point scale so the first and last values are not pinned to the edges."},"1516":{"id":"/docs/components/chart/line-chart-55","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#tooltip-disabled","content":"Turn off the hover affordances entirely with \\`tooltip=\\{false}\\`, \\`showCrosshair=\\{false}\\`, and \\`showDataPoints=\\{false}\\` - useful for a static or print-style chart."},"1517":{"id":"/docs/components/chart/line-chart-56","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#crosshair-only","content":"Keep the vertical crosshair for orientation while hiding the tooltip and the data point glyphs."},"1518":{"id":"/docs/components/chart/line-chart-57","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip-formatting","content":"\\`tooltipValueFormatter\\` shapes only the tooltip values, so you can show full currency or units there while the axis stays compact."},"1519":{"id":"/docs/components/chart/line-chart-58","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#fixed-size","content":"Pass \\`width\\` and \\`height\\` to size the chart explicitly instead of letting it fill its container."},"1520":{"id":"/docs/components/chart/line-chart-59","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#bitcoin-price","content":"A real time series: date formatting on the X axis, currency on the Y axis, gridlines, and a nice-rounded domain."},"1521":{"id":"/docs/components/chart/line-chart-60","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#city-temperature","content":"Several cities over the same period, with a legend and a shared time axis - the multi-series case as it usually looks in a product."},"1522":{"id":"/docs/components/chart/line-chart-61","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#browser-usage","content":"A categorical X axis (band scale) with several series and percentage formatting, for when the X values are names rather than numbers or dates."},"1523":{"id":"/docs/components/chart/line-chart-62","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#rtl","content":"The chart follows the current layout direction, normally detected from the browser or system settings. In right-to-left it mirrors the axes and labels; this example forces RTL so you can see it in a left-to-right page."},"1524":{"id":"/docs/components/chart/line-chart-63","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#data-attributes","content":"The chart root exposes data attributes that reflect prop state for styling:"},"1525":{"id":"/docs/components/chart/line-chart-64","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#data-attributes","content":"**Chart container:** `data-width`, `data-height`, `data-x-labels`, `data-y-labels`, `data-x-labels-vertical`, `data-x-baseline`, `data-y-baseline`, `data-x-tick-marks`, `data-y-tick-marks`"},"1526":{"id":"/docs/components/chart/line-chart-65","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#component-customization","content":"Use the `className` prop on the chart container to add or override styles:"},"1527":{"id":"/docs/components/chart/line-chart-66","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"Provide &#x2A;*`aria-label`** to describe the chart (e.g. \"Monthly sales revenue from January to May 2024\")."},"1528":{"id":"/docs/components/chart/line-chart-67","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"Use &#x2A;*`desc`** for a longer description rendered in the SVG `<desc>` for screen readers."},"1529":{"id":"/docs/components/chart/line-chart-68","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"The component sets ARIA attributes on interactive and structural elements as needed."},"1530":{"id":"/docs/components/chart/line-chart-69","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Use for trends over time or along a continuous scale."},"1531":{"id":"/docs/components/chart/line-chart-70","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Use when comparing a few series (e.g. 2-5 lines); avoid too many overlapping lines."},"1532":{"id":"/docs/components/chart/line-chart-71","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Prefer a single chart with a legend over multiple small charts when comparing the same X range."},"1533":{"id":"/docs/components/chart/line-chart-72","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#chart-not-sizing-or-empty","content":"Ensure the chart has a non-zero size. Place it in a container with explicit dimensions or use `width` and `height`:"},"1534":{"id":"/docs/components/chart/line-chart-73","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#dates-not-displaying-correctly","content":"Use `xType=\"time\"` when the X-axis values are Date objects:"},"1535":{"id":"/docs/components/chart/line-chart-74","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#tooltip-or-crosshair-not-showing","content":"Ensure `tooltip`, `showCrosshair`, or `showDataPoints` are not set to `false`, and that the chart receives pointer events (e.g. no overlay blocking hover)."},"1536":{"id":"/docs/components/layout/box","page_id":"/docs/components/layout/box","type":"page","content":"Box","breadcrumbs":["Docs","Components","Layout"],"tags":[],"url":"/docs/components/layout/box"},"1537":{"id":"/docs/components/layout/box-0","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box","content":"Polymorphic layout component providing consistent spacing, elevation, rounding, and self-alignment"},"1538":{"id":"/docs/components/layout/box-1","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#installation","content":"Installation"},"1539":{"id":"/docs/components/layout/box-2","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#scale-sizes","content":"Scale Sizes"},"1540":{"id":"/docs/components/layout/box-3","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#polymorphic-as-details","content":"Polymorphic `as` details"},"1541":{"id":"/docs/components/layout/box-4","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#examples","content":"Examples"},"1542":{"id":"/docs/components/layout/box-5","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#padding","content":"Padding"},"1543":{"id":"/docs/components/layout