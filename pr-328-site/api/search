ructure#hybrid-styling","content":"Hybrid styling"},"1195":{"id":"/docs/components/structure-2","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#examples","content":"Examples"},"1196":{"id":"/docs/components/structure-3","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#default","content":"Default"},"1197":{"id":"/docs/components/structure-4","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#props","content":"Props"},"1198":{"id":"/docs/components/structure-5","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#content","content":"Content"},"1199":{"id":"/docs/components/structure-6","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#header","content":"Header"},"1200":{"id":"/docs/components/structure-7","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#footer","content":"Footer"},"1201":{"id":"/docs/components/structure-8","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#buttongroup","content":"ButtonGroup"},"1202":{"id":"/docs/components/structure-9","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**Shared structural containers.** These generic, layout-only components are the building blocks for composing a component's interior (a `Modal`, a card, a panel). They are semantic containers built on `Flex`, so they accept the same layout props (`direction`, `gap`, `alignItems`, `justifyContent`, `padding`, ...)."},"1203":{"id":"/docs/components/structure-10","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Content`** — the primary body region (a `<section>`, a column that grows to fill)."},"1204":{"id":"/