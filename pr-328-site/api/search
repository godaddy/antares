ss#aria-support","content":"`aria-valuetext` provides a formatted string (e.g. `\"60%\"`) via `Intl.NumberFormat`; the same string is rendered inside the circle. Override the text with the `aria-valuetext` prop, or control formatting with `formatOptions`"},"333":{"id":"/docs/components/circular-progress-16","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-labelledby` associates the visible label when the `label` prop is provided"},"334":{"id":"/docs/components/circular-progress-17","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-describedby` wires the `helperText` to the progressbar for screen readers"},"335":{"id":"/docs/components/circular-progress-18","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"The decorative SVG and output text are hidden via `aria-hidden=\"true\"`"},"336":{"id":"/docs/components/date-picker","page_id":"/docs/components/date-picker","type":"page","content":"DatePicker","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/date-picker"},"337":{"id":"/docs/components/date-picker-0","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker","content":"Date fields that display the selected value as a label and open a calendar popover to pick a single date (DatePicker) or a range (DateRangePicker)."},"338":{"id":"/docs/components/date-picker-1","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#features","content":"Features"},"339":{"id":"/docs/components/date-picker-2","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#installation","content":"Installation"},"340":{"id":"/docs/components/date-picker-3","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#working-with-dates","content":"Working with dates"},"341":{"id":"/docs/components/date-picker-4","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#examples","content":"Examples"},"342":{"id":"/docs/components/date-picker-5","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#default","content":"Default"},"343":{"id":"/docs/components/date-picker-6","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#range","content":"Range"},"344":{"id":"/docs/components/date-picker-7","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#controlled","content":"Controlled"},"345":{"id":"/docs/components/date-picker-8","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#custom-format","content":"Custom format"},"346":{"id":"/docs/components/date-picker-9","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#min--max","content":"Min / Max"},"347":{"id":"/docs/components/date-picker-10","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#error","content":"Error"},"348":{"id":"/docs/components/date-picker-11","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#disabled","content":"Disabled"},"349":{"id":"/docs/components/date-picker-12","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#customization","content":"Customization"},"350":{"id":"/docs/components/date-picker-13","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#accessibility","content":"Accessibility"},"351":{"id":"/