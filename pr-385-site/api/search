:"/docs/components/radio-22","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-do"},"1161":{"id":"/docs/components/radio-23","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/bl"},"1162":{"id":"/docs/components/radio-24","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#customization","content":"`RadioGroup` is composed: write `Label`, a `Group` holding the `Radio` items, `Text slot=\"description\"`, and `FieldError`. The `Group` takes its axis, gap, and presentational role from the group's `orientation`, so a bare `<Group>` is all you need; pass your own `direction`/`gap` to lay the items out differently. Each `Radio` takes label text next to the indicator. `orientation` also sets keyboard-navigation direction and ARIA."},"1163":{"id":"/docs/components/radio-25","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#data-attributes","content":"Components automatically add data attributes for styling different states:"},"1164":{"id":"/docs/components/radio-26","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#data-attributes","content":"**RadioGroup Container:** `data-invalid`, `data-disabled`, `data-required`, `data-readonly`, `data-orientation`"},"1165":{"id":"/docs/components/radio-27","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#data-attributes","content":"**Radio Button:** `data-selected`, `data-hovered`, `data-pressed`, `data-focused`, `data-disabled`"},"1166":{"id":"/docs/components/radio-28","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#component-customization","content":"Pass `className` or `style` to customize a radio field container. Use descendant data-attribute selectors to style the interactive radio state:"},"1167":{"id":"/docs/components/radio-29","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Tab**: Moves focus to/from the radio group"},"1168":{"id":"/docs/components/radio-30","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Arrow Down/Right**: Move to next radio button"},"1169":{"id":"/docs/components/radio-31","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Arrow Up/Left**: Move to previous radio button"},"1170":{"id":"/docs/components/radio-32","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#keyboard-navigation","content":"**Space**: Select the focused radio button"},"1171":{"id":"/docs/components/radio-33","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`role=\"radiogroup\"` on the container"},"1172":{"id":"/docs/components/radio-34","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`role=\"radio\"` on each option"},"1173":{"id":"/docs/components/radio-35","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`aria-checked` indicates selection state"},"1174":{"id":"/docs/components/radio-36","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`aria-disabled` for disabled options"},"1175":{"id":"/docs/components/radio-37","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`aria-required` when selection is required"},"1176":{"id":"/docs/components/radio-38","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/d