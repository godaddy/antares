s, Meta } from '@storybook/addon-docs/blocks';\nimport { Exam"},"44":{"id":"/docs/components/accordion-20","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Compose related `Collapsible` sections inside Accordion. Give each section a stable, unique `id`.\nSee the Collapsible component documentation for more information about section anatomy, panel content, and trigger styling."},"45":{"id":"/docs/components/accordion-21","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Use `defaultExpandedKeys` for initial expansion, or `expandedKeys` with `onExpandedChange` for\ncontrolled state. Keys must match the section IDs; the callback receives a `Set` of expanded keys.\nBy default, only one section can stay open. Set `allowsMultipleExpanded` to keep several open.\nBoth behaviors are shown in the examples."},"46":{"id":"/docs/components/accordion-22","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Use `className` and `style` to customize the group container. `data-disabled` reflects the group's\ndisabled state. Customize individual headings, triggers, and panels on the composed Collapsible sections."},"47":{"id":"/docs/components/accordion-23","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"| Key                   | Action                                                        |\n| --------------------- | ------------------------------------------------------------- |\n| `Tab` / `Shift + Tab` | Move between enabled triggers and controls in expanded panels |","table":"table-0"},"48":{"id":"/docs/components/accordion-24","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"| Key               | Action                           