ents/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"A ChipGroup has no accessible name"},"383":{"id":"/docs/components/chip-23","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"The remove action does not update the UI"},"384":{"id":"/docs/components/chip-24","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"A composed label is not truncating correctly"},"385":{"id":"/docs/components/chip-25","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"The menu trigger does not look like a Chip"},"386":{"id":"/docs/components/chip-26","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#props","content":"Props"},"387":{"id":"/docs/components/chip-27","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chip","content":"Chip"},"388":{"id":"/docs/components/chip-28","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipgroup","content":"ChipGroup"},"389":{"id":"/docs/components/chip-29","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chiplist","content":"ChipList"},"390":{"id":"/docs/components/chip-30","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipbutton","content":"ChipButton"},"391":{"id":"/docs/components/chip-31","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipGroup` + `ChipList` + `Chip` for grouped values, selection, keyboard navigation, and removal"},"392":{"id":"/docs/components/chip-32","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Toggle Chips for selecting multiple peer filters"},"393":{"id":"/docs/components/chip-33","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Removable Chips for user-added filters and input tokens"},"394":{"id":"/docs/components/chip-34","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Shared `sm`, `md`, and `lg` sizes, with optional leading icons"},"395":{"id":"/docs/components/chip-35","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipButton` for menu filters and other actions with a Chip-like appearance"},"396":{"id":"/docs/components/chip-36","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#default","content":"Start with a labeled group of related values. Add selection or removal when\nthe group needs interactive behavior."},"397":{"id":"/docs/components/chip-37","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#toggle-chips","content":"Use Toggle Chips for multiple peer filters. The Chip render prop supplies\nselection state for the checkmark, while `textValue` names composed content."},"398":{"id":"/docs/components/chip-38","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#removable-chips","content":"Use Removable Chips for user-added filters and tokens. `ChipGroup` reports\nremoved keys through `onRemove`; the owner updates its collection. A\nself-closing `Button` in the `remove` slot supplies each remove control."},"399":{"id":"/docs/components/chip-39","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#controlled-selection","content":"Use `selectedKeys` and `onSelectionChange` when another part of the page\nneeds to own the selected filter state."},"400":{"id":"/docs/components/chip-40","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#sizes","content":"Compare the supported `sm`, `md`, and `lg` sizes. Set `size` on `ChipGroup`\nso every Chip inherits one consistent size."},"401":{"id":"/docs/components/chip-41","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#disabled","content":"Disable individual options with `disabledKeys` when some values are unavailable."},"402":{"id":"/docs/components/chip-42","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#truncation","content":"By default, long labels truncate visually when space is constrained, while\nthe complete accessible value remains available."},"403":{"id":"/docs/components/chip-43","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#empty-state","content":"Give an empty collection useful guidance, then let the user add the first\nvalue. Removable items continue to be owned by the collection."},"404":{"id":"/docs/components/chip-44","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#menu-filter-trigger","content":"Use `ChipButton` for Chip presentation without collection semantics.\n`MenuTrigger` continues to own open state, focus, and keyboard behavior."},"405":{"id":"/docs/components/chip-45","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#content","content":"Use a string for a simple label. For icons or other composed content, wrap the\nvisible label in `Text` and provide `textValue` for the accessible name. See\n**Toggle Chips** and **Removable Chips** above."},"406":{"id":"/docs/components/chip-46","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#selection-and-removal","content":"`ChipGroup` owns selection and removal behavior. Use a Chip render prop for\nstate-dependent content, and `Button` with `slot=\"remove\"` together with\n`onRemove` for removable items. See **Toggle Chips** and **Removable Chips**."},"407":{"id":"/docs/components/chip-47","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#layout-and-sizing","content":"Set `size` on `ChipGroup` to keep a collection consistent. `ChipList` wraps by\ndefault and accepts layout props for custom arrangements. See **Sizes**."},"408":{"id":"/docs/components/chip-48","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#button-composition","content":"Use `ChipButton` when Chip presentation is needed without collection semantics.\nCompose it with components such as `MenuTrigger`; those components continue to\nown open state, focus, and keyboard behavior. See **Menu filter trigger**."},"409":{"id":"/docs/components/chip-49","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use `Label` or `aria-label` to name the `ChipGroup`; this names the collection,\nnot its individual Chips."},"410":{"id":"/docs/components/chip-50","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Give each Chip a visible label, `textValue`, or `aria-label`. Use `textValue`\nwhen a Chip contains icons, composed content, or a render prop."},"411":{"id":"/docs/components/chip-51","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use a descriptive group label so removal actions can be announced clearly."},"412":{"id":"/docs/components/chip-52","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Keep the visible label and the accessible value synchronized."},"413":{"id":"/docs/components/chip-53","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"`ChipButton` is a real button and exposes menu state through `MenuTrigger`; provide an accessible name when the visible content is incomplete."},"414":{"id":"/docs/components/chip-54","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep labels concise and let them truncate only when the available width requires it."},"415":{"id":"/docs/components/chip-55","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Prefer groups of three or more related values."},"416":{"id":"/docs/components/chip-56","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep one size per group."},"417":{"id":"/docs/components/chip-57","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Let `ChipList` wrap instead of forcing a single horizontal line."},"418":{"id":"/docs/components/chip-58","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Use removable Chips for user-added filters and tokens."},"419":{"id":"/docs/components/chip-59","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"For menu filters, use `ChipButton` with `MenuTrigger` and provide the chevron explicitly."},"420":{"id":"/docs/components/chip-60","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"Add a visible `Label` to the group or provide `aria-label`. For an individual Chip\nwith composed content, provide a visible label, `textValue`, or `aria-label`."},"421":{"id":"/docs/components/chip-61","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"Add `onRemove` to `ChipGroup` and remove the returned keys from the collection\nowned by your application."},"422":{"id":"/docs/components/chip-62","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"Keep the label in `Text`, preserve `textValue`, and constrain the available width\nof the surrounding layout. Truncation is visual; the complete accessible value\nshould remain available."},"423":{"id":"/docs/components/chip-63","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"Use `ChipButton` inside `MenuTrigger`, include the visible value, and add a\ntrailing chevron to communicate that the control opens a menu."},"424":{"id":"/docs/components/chip-64","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#props","content":"For a menu trigger, the button and menu are composed as siblings inside\n`MenuTrigger`:"},"425":{"id":"/docs/components/circular-progress","page_id":"/docs/components/circular-progress","type":"page","content":"CircularProgress","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/circular-progress"},"426":{"id":"/docs/components/circular-progress-0","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress","content":"A circular progress indicator shows determinate or indeterminate progress of an operation over time"},"427":{"id":"/docs/components/circular-progress-1","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#installation","content":"Installation"},"428":{"id":"/docs/components/circular-progress-2","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#examples","content":"Examples"},"429":{"id":"/docs/components/circular-progress-3","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#default","content":"Default"},"430":{"id":"/docs/components/circular-progress-4","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#sizes","content":"Sizes"},"431":{"id":"/docs/components/circular-progress-5","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#emphasis","content":"Emphasis"},"432":{"id":"/docs/components/circular-progress-6","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#indeterminate","content":"Indeterminate"},"433":{"id":"/docs/components/circular-progress-7","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#accessibility","content":"Accessibility"},"434":{"id":"/docs/components/circular-progress-8","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#aria-support","content":"ARIA Support"},"435":{"id":"/docs/components/circular-progress-9","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#props","content":"Props"},"436":{"id":"/docs/components/circular-progress-10","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#circularprogress","content":"CircularProgress"},"437":{"id":"/docs/components/circular-progress-11","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#default","content":"A basic determinate progress indicator with a label and helper text."},"438":{"id":"/docs/components/circular-progress-12","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#sizes","content":"Four circle diameters are available: `sm` (64px), `md` (96px), `lg` (128px), and `xl` (160px)."},"439":{"id":"/docs/components/circular-progress-13","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#emphasis","content":"Use the `emphasis` prop to communicate status: `success`, `warning`, or `critical`. When omitted, the default teal fill is used."},"440":{"id":"/docs/components/circular-progress-14","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#indeterminate","content":"Use indeterminate progress while preparing an upload whose total size is unknown.\nOnce the total is known, set `isIndeterminate` to false and supply a measured value."},"441":{"id":"/docs/components/circular-progress-15","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`role=\"progressbar\"` on the container"},"442":{"id":"/docs/components/circular-progress-16","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuenow` is omitted while indeterminate; otherwise it reflects the current value (clamped to 0–100)"},"443":{"id":"/docs/components/circular-progress-17","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuemin` and `aria-valuemax` define the range (default `0`–`100`)"},"444":{"id":"/docs/components/circular-progress-18","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-valuetext` and visible value text are omitted while indeterminate; otherwise `aria-valuetext` provides a formatted string (e.g. `\"60%\"`) via `Intl.NumberFormat`; the same string is rendered inside the circle. Override the text with the `aria-valuetext` prop, or control formatting with `formatOptions`"},"445":{"id":"/docs/components/circular-progress-19","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-labelledby` associates the visible label when the `label` prop is provided"},"446":{"id":"/docs/components/circular-progress-20","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-describedby` wires the `helperText` to the progressbar for screen readers"},"447":{"id":"/docs/components/circular-progress-21","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"The decorative SVG and output text are hidden via `aria-hidden=\"true\"`"},"448":{"id":"/docs/components/collapsible","page_id":"/docs/components/collapsible","type":"page","content":"Collapsible","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/collapsible"},"449":{"id":"/docs/components/collapsible-0","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible","content":"Collapsible reveals or hides a section of content beneath a heading."},"450":{"id":"/docs/components/collapsible-1","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#features","content":"Features"},"451":{"id":"/docs/components/collapsible-2","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#installation","content":"Installation"},"452":{"id":"/docs/components/collapsible-3","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#examples","content":"Examples"},"453":{"id":"/docs/components/collapsible-4","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#default","content":"Default"},"454":{"id":"/docs/components/collapsible-5","page_id":"/docs/comp