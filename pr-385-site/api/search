cs/components/tabs#customization","content":"Use these attributes to extend styling without replacing the accessibility behavior supplied by React Aria Components. You can also use render props in `className` to style based on state (e.g., `className={({ isSelected }) => isSelected ? 'active' : ''}`)."},"1444":{"id":"/docs/components/tabs-30","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"Use `TabList`'s `containerProps` to customize the outer tab list shell, such as increasing its width."},"1445":{"id":"/docs/components/tabs-31","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Use Tabs for peer panels on the same page and URL."},"1446":{"id":"/docs/components/tabs-32","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Keep the number of tabs small enough for users to understand the available sections."},"1447":{"id":"/docs/components/tabs-33","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not use Tabs for primary application navigation or route changes."},"1448":{"id":"/docs/components/tabs-34","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not render a standalone `Tab`; compose it inside `Tabs` and `TabList`."},"1449":{"id":"/docs/components/tag","page_id":"/docs/components/tag","type":"page","content":"Tag","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tag"},"1450":{"id":"/docs/components/tag-0","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag","content":"Non-interactive labels that highlight statuses and categories."},"1451":{"id":"/docs/components/tag-1","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#installation","content":"Installat