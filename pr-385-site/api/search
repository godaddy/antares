."},"489":{"id":"/docs/components/collapsible-25","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"CollapsiblePanel provides the content spacing automatically. Use `contentProps` to customize its\ninner container with Box spacing props, a class name, or styles:"},"490":{"id":"/docs/components/collapsible-26","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `contentProps={{ padding: '0' }}` for content without padding. Props supplied directly to\nCollapsiblePanel, including `className`, `style`, and `ref`, apply to the outer panel."},"491":{"id":"/docs/components/collapsible-27","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `defaultExpanded` for initial expansion, or `isExpanded` with `onExpandedChange` for controlled\nstate. The callback receives a boolean. Use the Accordion component to coordinate several sections;\nin that composition, manage expansion through the group."},"492":{"id":"/docs/components/collapsible-28","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `className` and `style` to customize each component. Button supports string or state-based\n`className` values. Components expose these data attributes for state-based styling:"},"493":{"id":"/docs/components/collapsible-29","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"`Collapsible`: `data-expanded`, `data-disabled`, and `data-focus-visible-within`."},"494":{"id":"/docs/components/collapsible-30","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Trigger `Button`: `data-hovered`, `data-pressed`, `data-focus-visible`, and `data-disabled`."},"495":{"id":"/docs/components/collapsible-31","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"`CollapsiblePanel`: `data-focus-visible-within`."},"496":{"id":"/docs/components/collapsible-32","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"| Key                   | Action                                                              |\n| --------------------- | ------------------------------------------------------------------- |\n| `Tab` / `Shift + Tab` | Move between the enabled trigger and controls in the expanded panel |","table":"table-0"},"497":{"id":"/docs/components/collapsible-33","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"| Key               | Action                                         |\n| ----------------- | ---------------------------------------------- |\n| `Enter` / `Space` | Toggle the section; focus stays on the trigger |","table":"table-0"},"498":{"id":"/docs/components/collapsible-34","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`Button slot=\"trigger\"` renders a native button with `aria-expanded` for its open state and\n`aria-controls` linked to the panel automatically."},"499":{"id":"/docs/components/collapsible-35","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`CollapsiblePanel` is labeled by its trigger through `aria-labelledby` automatically."},"500":{"id":"/docs/components/collapsible-36","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`CollapsiblePanel` uses `role=\"group\"` by default. Keep it when the panel's content does not need\na navigation landmark; there is no need to set it explicitly."},"501":{"id":"/docs/components/collapsible-37","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"Set `role=\"region\"` on `CollapsiblePanel` when its content warrants a named landmark\nfor direct screen-reader navigation."},"502":{"id":"/docs/components/collapsible-38","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"Collapsed content stays mounted but is excluded from keyboard and screen-reader navigation."},"503":{"id":"/docs/components/collapsible-39","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`Icon slot=\"indicator\"` is decorative and receives `aria-hidden=\"true\"` automatically."},"504":{"id":"/docs/components/collapsible-40","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Use descriptive section titles and keep essential information visible."},"505":{"id":"/docs/components/collapsible-41","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Choose heading levels that fit the page hierarchy and avoid deeply nested sections."},"506":{"id":"/docs/components/collapsible-42","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Include text for status icons so their meaning is available to screen readers."},"507":{"id":"/docs/components/collapsible-43","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Put links, forms, and actions inside the panel."},"508":{"id":"/docs/components/collapsible-44","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#best-practices","content":"Open the panel before moving focus to an input that needs attention."},"509":{"id":"/docs/components/collapsible-45","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#controlled-state-not-updating","content":"Update `isExpanded` from `onExpandedChange`. Changing `defaultExpanded` after mounting does not\ncontrol expansion. Inside Accordion, update the group's `expandedKeys` instead."},"510":{"id":"/docs/components/collapsible-46","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#trigger-not-expanding-the-panel","content":"Place `Button slot=\"trigger\"` inside the section's Heading. A Button without that slot acts\nindependently and does not toggle the section."},"511":{"id":"/docs/components/collapsible-47","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#input-values-persist-after-closing","content":"Panel content stays mounted when collapsed. Reset form state explicitly when the application requires it."},"512":{"id":"/docs/components/date-picker","page_id":"/docs/components/date-picker","type":"page","content":"DatePicker","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/date-picker"},"513":{"id":"/docs/components/date-picker-0","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker","content":"Date fields that display the selected value as a label and open a responsive calendar to pick a single date (DatePicker) or a range (DateRangePicker)."},"514":{"id":"/docs/components/date-picker-1","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#features","content":"Features"},"515":{"id":"/docs/components/date-picker-2","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#installation","content":"Installation"},"516":{"id":"/docs/components/date-picker-3","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#working-with-dates","content":"Working with dates"},"517":{"id":"/docs/components/date-picker-4","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#examples","content":"Examples"},"518":{"id":"/docs/components/date-picker-5","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#mobile-1","content":"Mobile"},"519":{"id":"/docs/components/date-picker-6","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#accessibility","content":"Accessibility"},"520":{"id":"/docs/components/date-picker-7","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#props","content":"Props"},"521":{"id":"/docs/components/date-picker-8","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepicker","content":"DatePicker"},"522":{"id":"/docs/components/date-picker-9","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepicker","content":"DateRangePicker"},"523":{"id":"/docs/components/date-picker-10","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepickercalendar","content":"DatePickerCalendar"},"524":{"id":"/docs/components/date-picker-11","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepickercalendar","content":"DateRangePickerCalendar"},"525":{"id":"/docs/components/date-picker-12","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#datepickervalue","content":"DatePickerValue"},"526":{"id":"/docs/components/date-picker-13","page_id":"/docs/components/date-picker","type":"heading","tags":[],"url":"/docs/components/date-picker#daterangepickervalue","content":"DateRangePickerValue"},"527":{"id":"/docs/components/date-picker-14","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"**Composable interior**: Compose `Label`, a `Button slot=\"trigger\"`, `DatePickerCalendar`, and optional `Text` / `FieldError`. Nothing is added for you, and what you write keeps the order you wrote it in. `children` also accepts a function for picker state"},"528":{"id":"/docs/components/date-picker-15","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"**Trigger and calendar**: An empty `Button slot=\"trigger\"` renders a calendar icon and the formatted value from the field. `DatePickerCalendar` (and `DateRangePickerCalendar`) opens a responsive calendar: it takes `Calendar` props plus `popoverProps` and `drawerProps` for its overlay. Write `Popover`, `Content`, and `Calendar` yourself to replace the whole overlay"},"529":{"id":"/docs/components/date-picker-16","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"**Sizes**: Each picker is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets its label, trigger, description, error, and the calendar it opens; without it, the picker follows the surrounding scope"},"530":{"id":"/docs/components/date-picker-17","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"`DatePicker` (single) and `DateRangePicker` (range): a read-only formatted date label; the whole field opens a calendar"},"531":{"id":"/docs/components/date-picker-18","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"Built on React Aria - native form integration, validation, focus management, and screen-reader support"},"532":{"id":"/docs/components/date-picker-19","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"Label formatting via `formatOptions` / `placeholder` on the picker itself, or on `DatePickerValue` / `DateRangePickerValue` in a trigger you write"},"533":{"id":"/docs/components/date-picker-20","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#features","content":"`minValue` / `maxValue` bounds and `isDateUnavailable` per-day disabling"},"534":{"id":"/docs/components/date-picker-21","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#working-with-dates","content":"Values are `CalendarDate` objects. Import the date primitives you need from the `@godaddy/antares/date` subpath:"},"535":{"id":"/docs/components/date-picker-22","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#working-with-dates","content":"Import date helpers from `@godaddy/antares/date` (a re-export of\n`@internationalized/date`).\nWrap the app in `<I18nProvider>` so formatting and the calendar follow the user's locale."},"536":{"id":"/docs/components/date-picker-23","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#examples","content":"import { ArgTypes, Meta } from"},"537":{"id":"/docs/components/date-picker-24","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from"},"538":{"id":"/docs/components/date-picker-25","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nim"},"539":{"id":"/docs/components/date-picker-26","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#mobile-1","content":"Below `40rem`, `DatePickerCalendar` and `DateRangePickerCalendar` open a bottom drawer with vertically\nscrolling months. Each drawer page contains three months by default. Use Previous/Next to change pages,\nchoose a month, or type a year to jump directly. The initial date follows `focusedValue`,\n`defaultFocusedValue`, the selected date (range start), then today, constrained by the date bounds."},"540":{"id":"/docs/components/date-picker-27","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#mobile-1","content":"The overlay keeps its container until it closes, including during resizing. Its next opening uses the\ncurrent viewport. An initially open server-rendered picker keeps its popover through hydration."},"541":{"id":"/docs/components/date-picker-28","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#mobile-1","content":"Set `overlay=\"popover\"` on the calendar to always use the desktop presentation."},"542":{"id":"/docs/components/date-picker-29","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#mobile-1","content":"Use `drawerProps` for drawer presentation, such as `maxSize` or an accessible label. It defaults to\n`85dvh`. Open state stays on the picker; `popoverProps` configures the popover."},"543":{"id":"/docs/components/date-picker-30","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#mobile-1","content":"`pageCount` sets the number of months in either presentation. Defaults: three in the drawer, one in a\nsingle-date popover, and two in a range popover. Scrolling stays within the current page. Navigation\nadvances by a full page, or by one month with `pageBehavior=\"single\"`."},"544":{"id":"/docs/components/date-picker-31","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#mobile-1","content":"Range selection and endpoint dragging follow React Aria. Drawers default to `commitBehavior=\"reset\"`:\na calendar background press, focus leaving the calendar, or backdrop dismissal cancels a pending\nrange and preserves the previous value. Popovers default to `commitBehavior=\"select\"`, which commits\nthe pending range on background press or blur. Set `commitBehavior` on `DateRangePickerCalendar` to\noverride either default. Escape from a date cell cancels the pending selection."},"545":{"id":"/docs/components/date-picker-32","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#mobile-1","content":"`shouldCloseOnSelect={false}` on the picker keeps either presentation open after a selection."},"546":{"id":"/docs/components/date-picker-33","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#accessibility","content":"The drawer has the same accessible name as the picker. Escape, an outside press, or the screen-reader\ndismiss control closes it and returns focus to the trigger. Arrow keys and Page Up/Down retain React\nAria's calendar navigation. Scrolling does not move keyboard focus or change the selected value. The\nmonth/year controls follow the focused date, and each grid has its own month heading. Weekday\nlabels shorten when the calendar has limited space, including with enlarged text. The weekday row is\ndecorative; each date cell provides its full accessible name."},"547":{"id":"/docs/components/drawer","page_id":"/docs/components/drawer","type":"page","content":"Drawer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/drawer"},"548":{"id":"/docs/components/drawer-0","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer","content":"An overlay panel that slides in from a screen edge, supporting sidebar navigation and bottom sheets."},"549":{"id":"/docs/components/drawer-1","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#installation","content":"Installation"},"550":{"id":"/docs/components/drawer-2","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#examples","content":"Examples"},"551":{"id":"/docs/components/drawer-3","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#accessibility","content":"Accessibility"},"552":{"id":"/docs/components/drawer-4","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#keyboard","content":"Keyboard"},"553":{"id":"/docs/components/drawer-5","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#aria","content":"ARIA"},"554":{"id":"/docs/components/drawer-6","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#best-practices","content":"Best Practices"},"555":{"id":"/docs/components/drawer-7","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#props","content":"Props"},"556":{"id":"/docs/components/drawer-8","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#drawer","content":"Drawer"},"557":{"id":"/docs/components/drawer-9","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#drawertrigger","content":"DrawerTrigger"},"558":{"id":"/docs/components/drawer-10","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer","content":"An overlay panel that slides in from a screen edge. Built on the same RAC stack as `Modal` (a\nmodal overlay with an `elevation=\"overlay\"` panel and CSS transitions), it supports sidebar\nnavigation and bottom sheets."},"559":{"id":"/docs/components/drawer-11","page_id":"/docs/components/drawer","tags":[],"typ