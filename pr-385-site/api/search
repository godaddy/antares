-expanding-the-panel","content":"Trigger Not Expanding the Panel"},"465":{"id":"/docs/components/collapsible-16","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#input-values-persist-after-closing","content":"Input Values Persist After Closing"},"466":{"id":"/docs/components/collapsible-17","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#props","content":"Props"},"467":{"id":"/docs/components/collapsible-18","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#collapsible","content":"Collapsible"},"468":{"id":"/docs/components/collapsible-19","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#collapsiblepanel","content":"CollapsiblePanel"},"469":{"id":"/docs/components/collapsible-20","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Independent sections with controlled or uncontrolled expansion."},"470":{"id":"/docs/components/collapsible-21","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Composed headings, optional status icons, and flexible panel content."},"471":{"id":"/docs/components/collapsible-22","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Persistent panel content when collapsed."},"472":{"id":"/docs/components/collapsible-23","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Accessible keyboard interaction and button-to-panel relationships powered by React Aria Components."},"473":{"id":"/docs/components/collapsible-24","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#default","content":"Reveal optional