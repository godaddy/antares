cs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#format-options","content":"Controlling the trigger's label format via `formatOptions`."},"727":{"id":"/docs/components/date-picker-35","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#min--max","content":"Bounding selectable dates with `minValue` / `maxValue`."},"728":{"id":"/docs/components/date-picker-36","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#with-error","content":"An invalid picker showing a validation message via `isInvalid` and a `FieldError`."},"729":{"id":"/docs/components/date-picker-37","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#disabled","content":"A disabled picker via `isDisabled`."},"730":{"id":"/docs/components/date-picker-38","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#composed","content":"Write the trigger and the overlay yourself instead of composing `DatePickerCalendar`, for full\ncontrol over the popover and the calendar."},"731":{"id":"/docs/components/date-picker-39","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#composed-range","content":"Write a DateRangePicker's trigger and overlay from lower-level pieces the same way."},"732":{"id":"/docs/components/date-picker-40","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#sizes","content":"`size` sets the label, trigger, and calendar. Without it, the picker follows the surrounding\nsize scope."},"733":{"id":"/docs/components/drawer","page_id":"/docs/components/drawer","type":"page","content":"Drawer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/drawer"},"734":{"id":"/docs/components/drawer-0","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/d