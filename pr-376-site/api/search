ed disabled days; use `minValue` / `maxValue` for contiguous bounds."},"218":{"id":"/docs/components/calendar-35","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar#troubleshooting","content":"Dates not formatting per locale? Ensure the app is wrapped in `<I18nProvider locale=\"…\">`."},"219":{"id":"/docs/components/carousel","page_id":"/docs/components/carousel","type":"page","content":"Carousel","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/carousel"},"220":{"id":"/docs/components/carousel-0","page_id":"/docs/components/carousel","tags":[],"type":"text","url":"/docs/components/carousel","content":"The Carousel component allows users to cycle through a series of content panels (typically images, cards, or text) in a horizontal or vertical layout. It is commonly used for featured content, product showcases, or testimonials."},"221":{"id":"/docs/components/carousel-1","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#installation","content":"Installation"},"222":{"id":"/docs/components/carousel-2","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#examples","content":"Examples"},"223":{"id":"/docs/components/carousel-3","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#default","content":"Default"},"224":{"id":"/docs/components/carousel-4","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#controlled","content":"Controlled"},"225":{"id":"/docs/components/carousel-5","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#external-controls-uncontrolled","content":"External Controls (Uncontrolled)"},"226":{"id":"/docs/components/carousel-6","page_id":"/docs/components/carousel","type":"heading","tags":[],"url":"/docs/components/carousel#external-controls-controlled","content