type":"heading","tags":[],"url":"/docs/components/accordion#controlled-state-not-updating","content":"Controlled State Not Updating"},"41":{"id":"/docs/components/accordion-17","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#sections-close-when-another-opens","content":"Sections Close When Another Opens"},"42":{"id":"/docs/components/accordion-18","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#props","content":"Props"},"43":{"id":"/docs/components/accordion-19","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#features","content":"Single or multiple expanded sections."},"44":{"id":"/docs/components/accordion-20","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#features","content":"Controlled and uncontrolled group state."},"45":{"id":"/docs/components/accordion-21","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#features","content":"Group-level disabled state."},"46":{"id":"/docs/components/accordion-22","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#features","content":"Composable sections using Collapsible and CollapsiblePanel."},"47":{"id":"/docs/components/accordion-23","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#one-section-at-a-time","content":"Let people explore short answers one at a time."},"48":{"id":"/docs/components/accordion-24","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#multiple-sections-open","content":"Keep related answers visible together when people need to compare information."},"49":{"id":"/docs/components/accordion-25","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#controlled","content":"Coordinate