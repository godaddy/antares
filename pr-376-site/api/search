t","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#component-customization","content":"Component Customization"},"416":{"id":"/docs/components/chart/line-chart-35","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#accessibility","content":"Accessibility"},"417":{"id":"/docs/components/chart/line-chart-36","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#aria-support","content":"ARIA Support"},"418":{"id":"/docs/components/chart/line-chart-37","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#best-practices","content":"Best Practices"},"419":{"id":"/docs/components/chart/line-chart-38","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"When to Use LineChart"},"420":{"id":"/docs/components/chart/line-chart-39","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#troubleshooting","content":"Troubleshooting"},"421":{"id":"/docs/components/chart/line-chart-40","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#chart-not-sizing-or-empty","content":"Chart Not Sizing or Empty"},"422":{"id":"/docs/components/chart/line-chart-41","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#dates-not-displaying-correctly","content":"Dates Not Displaying Correctly"},"423":{"id":"/docs/components/chart/line-chart-42","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#tooltip-or-crosshair-not-showing","content":"Tooltip or Crosshair Not Showing"},"424":{"id":"/docs/components/chart/line-chart-43","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#props","content":"Props"},"425":{"id":"/docs/components/chart/line-chart-44","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#linechart","content":"LineChart"},"426":{"id":"/docs/components/chart/line-chart-45","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#default","content":"One line, a time-scale X axis, and almost nothing else configured - the everyday starting point. You give the chart a `series` array and it reads `x`/`y` from each point."},"427":{"id":"/docs/components/chart/line-chart-46","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#multiple-series","content":"Several lines sharing one X axis, with a legend naming each of them. Reach for this when the comparison between series is the story."},"428":{"id":"/docs/components/chart/line-chart-47","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#gridlines","content":"`xGridlines` and `yGridlines` add faint lines across the plot so it is easier to read a value back off an axis."},"429":{"id":"/docs/components/chart/line-chart-48","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#titles","content":"`xTitle` and `yTitle` label what each axis actually measures, e.g. \"Month\" and \"Temperature (°F)\"."},"430":{"id":"/docs/components/chart/line-chart-49","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#labels","content":"`xLabels` and `yLabels` toggle the tick labels on each axis. Turn them off for sparklines or when the surrounding UI already names the values."},"431":{"id":"/docs/components/chart/line-chart-50","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#ticks","content":"`xTickMarks` and `yTickMarks` draw the short lines at each tick value, which helps tie a label to its exact position on the axis."},"432":{"id":"/docs/components/chart/line-chart-51","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#baselines","content":"`xBaseline` and `yBaseline` control the main axis lines themselves. Dropping them gives a lighter, more editorial chart."},"433":{"id":"/docs/components/chart/line-chart-52","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#legend","content":"`legendPosition` puts the legend above or below the plot, or hides it with `null`. Multi-series charts get a bottom legend by default."},"434":{"id":"/docs/components/chart/line-chart-53","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#axis-and-tooltip-formatting","content":"`xTickFormat` and `yTickFormat` shape the axis labels - dates, currency, units, percentages - and the tooltip follows the same formatting."},"435":{"id":"/docs/components/chart/line-chart-54","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-accessors","content":"When your data does not use `x`/`y`, point `xAccessor` and `yAccessor` at the fields it does use (here `date` and `value`) instead of reshaping the data first."},"436":{"id":"/docs/components/chart/line-chart-55","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#missing-values","content":"A `null` Y value breaks the line instead of drawing through the gap, so missing data reads as missing rather than as a straight interpolation."},"437":{"id":"/docs/components/chart/line-chart-56","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#fixed-domain","content":"`xDomain` and `yDomain` pin the visible range. Use them to keep a fixed scale, or to keep several charts comparable."},"438":{"id":"/docs/components/chart/line-chart-57","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#nice-values","content":"`xNice` and `yNice` round the domain out to friendlier numbers (e.g. 0.2 to 1.0), so ticks land on values people expect."},"439":{"id":"/docs/components/chart/line-chart-58","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#zero-included","content":"`xZero` and `yZero` stretch the domain to include zero. Worth doing when the absolute size of the values matters, not just their movement."},"440":{"id":"/docs/components/chart/line-chart-59","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-ticks","content":"Choose the ticks yourself with `xTickValues`/`yTickValues`, or just ask for roughly how many you want with `xNumTicks`/`yNumTicks`."},"441":{"id":"/docs/components/chart/line-chart-60","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#band-padding","content":"`xPaddingOuter` and `yPaddingOuter` add breathing room at the ends of a band or point scale so the first and last values are not pinned to the edges."},"442":{"id":"/docs/components/chart/line-chart-61","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#tooltip-disabled","content":"Turn off the hover affordances entirely with `tooltip={false}`, `showCrosshair={false}`, and `showDataPoints={false}` - useful for a static or print-style chart."},"443":{"id":"/docs/components/chart/line-chart-62","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#crosshair-only","content":"Keep the vertical crosshair for orientation while hiding the tooltip and the data point glyphs."},"444":{"id":"/docs/components/chart/line-chart-63","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip-formatting","content":"`tooltipValueFormatter` shapes only the tooltip values, so you can show full currency or units there while the axis stays compact."},"445":{"id":"/docs/components/chart/line-chart-64","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#fixed-size","content":"Pass `width` and `height` to size the chart explicitly instead of letting it fill its container."},"446":{"id":"/docs/components/chart/line-chart-65","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#bitcoin-price","content":"A real time series: date formatting on the X axis, currency on the Y axis, gridlines, and a nice-rounded domain."},"447":{"id":"/docs/components/chart/line-chart-66","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#city-temperature","content":"Several cities over the same period, with a legend and a shared time axis - the multi-series case as it usually looks in a product."},"448":{"id":"/docs/components/chart/line-chart-67","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#browser-usage","content":"A categorical X axis (band scale) with several series and percentage formatting, for when the X values are names rather than numbers or dates."},"449":{"id":"/docs/components/chart/line-chart-68","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#rtl","content":"The chart follows the current layout direction, normally detected from the browser or system settings. In right-to-left it mirrors the axes and labels; this example forces RTL so you can see it in a left-to-right page."},"450":{"id":"/docs/components/chart/line-chart-69","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#color-index","content":"`colorIndex` pins each series to a palette color. Any series can use any index,\nindependently — here two pairs each share an index so an actual line and its\ndashed forecast read as the same color, distinguished only by line style."},"451":{"id":"/docs/components/chart/line-chart-70","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip","content":"`renderTooltip` lets you render a fully custom tooltip and know which curve is\nhovered. Paired series share a `colorIndex`; hovering either line shows a\ntooltip specific to that line, wrapped in the default styled popover."},"452":{"id":"/docs/components/chart/line-chart-71","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip-pair-change","content":"`renderTooltip` example combining a pair of series. Each pair shares a `colorIndex`\n(solid actual + dashed forecast); hovering either line shows the percent change of\nthe forecast against the actual for that pair, wrapped in the default styled popover."},"453":{"id":"/docs/components/chart/line-chart-72","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip-period-comparison","content":"`renderTooltip` example styled as a period-over-period comparison card. Paired series\n(solid current period + dashed previous period) share a `colorIndex`; hovering either\nline shows both dated values and the percent change, wrapped in the default popover."},"454":{"id":"/docs/components/chart/line-chart-73","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#line-styles","content":"`variant` sets each series' line style — 'solid' (default), 'dashed', or\n'dotted' — useful for distinguishing actuals from forecasts or targets. The\nlegend swatch mirrors each line's style."},"455":{"id":"/docs/components/chart/line-chart-74","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#data-attributes","content":"The chart root exposes data attributes that reflect prop state for styling:"},"456":{"id":"/docs/components/chart/line-chart-75","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#data-attributes","content":"**Chart container:** `data-width`, `data-height`, `data-x-labels`, `data-y-labels`, `data-x-labels-vertical`, `data-x-baseline`, `data-y-baseline`, `data-x-tick-marks`, `data-y-tick-marks`"},"457":{"id":"/docs/components/chart/line-chart-76","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#component-customization","content":"Use the `className` prop on the chart container to add or override styles:"},"458":{"id":"/docs/components/chart/line-chart-77","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"Provide **`aria-label`** to describe the chart (e.g. \"Monthly sales revenue from January to May 2024\")."},"459":{"id":"/docs/components/chart/line-chart-78","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"Use **`desc`** for a longer description rendered in the SVG `<desc>` for screen readers."},"460":{"id":"/docs/components/chart/line-chart-79","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"The component sets ARIA attributes on interactive and structural elements as needed."},"461":{"id":"/docs/components/chart/line-chart-80","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Use for trends over time or along a continuous scale."},"462":{"id":"/docs/components/chart/line-chart-81","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Use when comparing a few series (e.g. 2-5 lines); avoid too many overlapping lines."},"463":{"id":"/docs/components/chart/line-chart-82","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Prefer a single chart with a legend over multiple small charts when comparing the same X range."},"464":{"id":"/docs/components/chart/line-chart-83","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#chart-not-sizing-or-empty","content":"Ensure the chart has a non-zero size. Place it in a container with explicit dimensions or use `width` and `height`:"},"465":{"id":"/docs/components/chart/line-chart-84","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#dates-not-displaying-correctly","content":"Use `xType=\"time\"` when the X-axis values are Date objects:"},"466":{"id":"/docs/components/chart/line-chart-85","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#tooltip-or-crosshair-not-showing","content":"Ensure `tooltip`, `showCrosshair`, or `showDataPoints` are not set to `false`, and that the chart receives pointer events (e.g. no overlay blocking hover)."},"467":{"id":"/docs/components/checkbox","page_id":"/docs/components/checkbox","type":"page","content":"Checkbox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/checkbox"},"468":{"id":"/docs/components/checkbox-0","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox","content":"Accessible checkbox component for multi-select options with support for indeterminate states, validation, keyboard navigation, and flexible group layouts."},"469":{"id":"/docs/components/checkbox-1","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#installation","content":"Installation"},"470":{"id":"/docs/components/checkbox-2","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#examples","content":"Examples"},"471":{"id":"/docs/components/checkbox-3","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#default","content":"Default"},"472":{"id":"/docs/components/checkbox-4","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#indeterminate","content":"Indeterminate"},"473":{"id":"/docs/components/checkbox-5","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkbox-group","content":"Checkbox Group"},"474":{"id":"/docs/components/checkbox-6","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#controlled","content":"Controlled"},"475":{"id":"/docs/components/checkbox-7","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#horizontal-layout","content":"Horizontal Layout"},"476":{"id":"/docs/components/checkbox-8","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#disabled-states","content":"Disabled States"},"477":{"id":"/docs/components/checkbox-9","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#required-indicator","content":"Required Indicator"},"478":{"id":"/docs/components/checkbox-10","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#invalid-state","content":"Invalid State"},"479":{"id":"/docs/components/checkbox-11","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#customization","content":"Customization"},"480":{"id":"/docs/components/checkbox-12","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#data-attributes","content":"Data Attributes"},"481":{"id":"/docs/components/checkbox-13","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#component-customization","content":"Component Customization"},"482":{"id":"/docs/components/checkbox-14","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#key-features","content":"Key Features"},"483":{"id":"/docs/components/checkbox-15","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#indeterminate-state","content":"Indeterminate State"},"484":{"id":"/docs/components/checkbox-16","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#group-validation","content":"Group Validation"},"485":{"id":"/docs/components/checkbox-17","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#orientation","content":"Orientation"},"486":{"id":"/docs/components/checkbox-18","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#accessibility","content":"Accessibility"},"487":{"id":"/docs/components/checkbox-19","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#keyboard-navigation","content":"Keyboard Navigation"},"488":{"id":"/docs/components/checkbox-20","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#aria-support","content":"ARIA Support"},"489":{"id":"/docs/components/checkbox-21","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#troubleshooting","content":"Troubleshooting"},"490":{"id":"/docs/components/checkbox-22","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#selection-not-updating","content":"Selection Not Updating"},"491":{"id":"/docs/components/checkbox-23","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#indeterminate-state-not-updating","content":"Indeterminate State Not Updating"},"492":{"id":"/docs/components/checkbox-24","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#styling-overrides-not-applying","content":"Styling Overrides Not Applying"},"493":{"id":"/docs/components/checkbox-25","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#keyboard-navigation-not-working","content":"Keyboard Navigation Not Working"},"494":{"id":"/docs/components/checkbox-26","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#best-practices","content":"Best Practices"},"495":{"id":"/docs/components/checkbox-27","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#when-to-use-checkboxes","content":"When to Use Checkboxes"},"496":{"id":"/docs/components/checkbox-28","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#label-guidelines","content":"Label Guidelines"},"497":{"id":"/docs/components/checkbox-29","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#validation","content":"Validation"},"498":{"id":"/docs/components/checkbox-30","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#group-organization","content":"Group Organization"},"499":{"id":"/docs/components/checkbox-31","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#props","content":"Props"},"500":{"id":"/docs/components/checkbox-32","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkbox","content":"Checkbox"},"501":{"id":"/docs/components/checkbox-33","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkboxgroup","content":"CheckboxGroup"},"502":{"id":"/docs/components/checkbox-34","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkboxindicator","content":"CheckboxIndicator"},"503":{"id":"/docs/components/checkbox-35","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#default","content":"A single checkbox with a label."},"504":{"id":"/docs/components/checkbox-36","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate","content":"Checkboxes can display an indeterminate state (neither checked nor unchecked), with the use of the `isIndeterminate` prop, commonly used for \"select all\" functionality when some but not all child items are selected."},"505":{"id":"/docs/components/checkbox-37","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#checkbox-group","content":"Group multiple checkboxes together with a shared label."},"506":{"id":"/docs/components/checkbox-38","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#controlled","content":"Manage checkbox group state programmatically with controlled component pattern."},"507":{"id":"/docs/components/checkbox-39","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#horizontal-layout","content":"Display checkboxes in a horizontal row instead of vertical stack."},"508":{"id":"/docs/components/checkbox-40","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#disabled-states","content":"Individual checkboxes within a group can be disabled while others remain interactive."},"509":{"id":"/docs/components/checkbox-41","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#required-indicator","content":"Mark a checkbox group as required with visual indicator and validation."},"510":{"id":"/docs/components/checkbox-42","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#invalid-state","content":"Display error state and error message for validation feedback."},"511":{"id":"/docs/components/checkbox-43","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#customization","content":"`CheckboxGroup` is composed: write `Label`, a `Group` holding the `Checkbox` items, `Text slot=\"description\"`, and `FieldError`. The `Group` takes its axis, gap, and presentational role from the group's `orientation`, so a bare `<Group>` is all you need; pass your own `direction`/`gap` to lay the items out differently. Each `Checkbox` takes label text next to the indicator."},"512":{"id":"/docs/components/checkbox-44","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"Components automatically add data attributes for styling different states:"},"513":{"id":"/docs/components/checkbox-45","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"**CheckboxGroup Container:** `data-invalid`, `data-disabled`, `data-required`, `data-readonly`, `data-orientation`"},"514":{"id":"/docs/components/checkbox-46","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"**Checkbox:** `data-selected`, `data-indeterminate`, `data-hovered`, `data-pressed`, `data-focused`, `data-disabled`"},"515":{"id":"/docs/components/checkbox-47","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#component-customization","content":"Pass `className` or `style` to customize a checkbox field container. Use descendant data-attribute selectors to style the interactive checkbox state:"},"516":{"id":"/docs/components/checkbox-48","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate-state","content":"The `isIndeterminate` prop displays a minus icon to represent a partial selection state. This is useful for \"select all\" checkboxes when only some items in a collection are selected."},"517":{"id":"/docs/components/checkbox-49","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"CheckboxGroup supports validation states and error messages:"},"518":{"id":"/docs/components/checkbox-50","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**isRequired**: Marks the group as required with visual indicator"},"519":{"id":"/docs/components/checkbox-51","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**isInvalid**: Shows error state styling"},"520":{"id":"/docs/components/checkbox-52","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**`FieldError`**: Displays validation error text below the group"},"521":{"id":"/docs/components/checkbox-53","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#orientation","content":"Use `orientation=\"vertical\"` (default) to stack checkboxes, or `orientation=\"horizontal\"` to arrange them in a row."},"522":{"id":"/docs/components/checkbox-54","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Tab**: Moves focus to the next/previous checkbox"},"523":{"id":"/docs/components/checkbox-55","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Space**: Toggles the focused checkbox"},"524":{"id":"/docs/components/checkbox-56","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Shift + Tab**: Moves focus to the previous checkbox"},"525":{"id":"/docs/components/checkbox-57","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-disabled` for disabled checkboxes"},"526":{"id":"/docs/components/checkbox-58","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-required` when selection is required"},"527":{"id":"/docs/components/checkbox-59","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-invalid` for validation errors"},"528":{"id":"/docs/components/checkbox-60","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"Proper labeling with `aria-labelledby` and `aria-describedby`"},"529":{"id":"/docs/components/checkbox-61","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate-state-not-updating","content":"The `isIndeterminate` prop must be explicitly managed - it doesn't automatically reflect parent-child relationships:"},"530":{"id":"/docs/components/checkbox-62","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ For selecting multiple independent options"},"531":{"id":"/docs/components/checkbox-63","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ When users can select zero, one, or many items"},"532":{"id":"/docs/components/checkbox-64","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ For toggling settings or features on/off"},"533":{"id":"/docs/components/checkbox-65","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ When all available options should be visible"},"534":{"id":"/docs/components/checkbox-66","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"❌ For mutually exclusive options (use Radio instead)"},"535":{"id":"/docs/components/checkbox-67","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"❌ For simple on/off toggles without labels (use Toggle/Switch instead)"},"536":{"id":"/docs/components/checkbox-68","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Use clear, concise labels that describe what selecting the option means"},"537":{"id":"/docs/components/checkbox-69","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Keep labels short (1-5 words when possible)"},"538":{"id":"/docs/components/checkbox-70","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Ensure labels are descriptive without being verbose"},"539":{"id":"/docs/components/checkbox-71","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Place the most commonly selected options first in groups"},"540":{"id":"/docs/components/checkbox-72","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#validation","content":"Always provide clear error messages and use appropriate validation states:"},"541":{"id":"/docs/components/checkbox-73","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Limit checkbox groups to 7-10 options for better usability"},"542":{"id":"/docs/components/checkbox-74","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Use logical ordering (alphabetical, frequency of use, or importance)"},"543":{"id":"/docs/components/checkbox-75","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Consider using CheckboxGroup for related options, even if there are only 2-3"},"544":{"id":"/docs/components/checkbox-76","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Provide a group label that clearly describes the choice being made"},"545":{"id":"/docs/components/chip","page_id":"/docs/components/chip","type":"page","content":"Chip","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/chip"},"546":{"id":"/docs/components/chip-0","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip","content":"Grouped pill-shaped items for selecting values and removing user-added filters or tokens."},"547":{"id":"/docs/components/chip-1","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#features","content":"Features"},"548":{"id":"/docs/components/chip-2","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#installation","content":"Installation"},"549":{"id":"/docs/components/chip-3","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#quick-start","content":"Quick start"},"550":{"id":"/docs/components/chip-4","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#examples","content":"Examples"},"551":{"id":"/docs/components/chip-5","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#default","content":"Default"},"552":{"id":"/docs/components/chip-6","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#toggle-chips","content":"Toggle Chips"},"553":{"id":"/docs/components/chip-7","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#removable-chips","content":"Removable Chips"},"554":{"id":"/docs/components/chip-8","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#controlled-selection","content":"Controlled Selection"},"555":{"id":"/docs/components/chip-9","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#sizes","content":"Sizes"},"556":{"id":"/docs/components/chip-10","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#disabled","content":"Disabled"},"557":{"id":"/docs/components/chip-11","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#truncation","content":"Truncation"},"558":{"id":"/docs/components/chip-12","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#empty-state","content":"Empty State"},"559":{"id":"/docs/components/chip-13","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#menu-filter-trigger","content":"Menu filter trigger"},"560":{"id":"/docs/components/chip-14","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#customization","content":"Customization"},"561":{"id":"/docs/components/chip-15","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#content","content":"Content"},"562":{"id":"/docs/components/chip-16","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#selection-and-removal","content":"Selection and removal"},"563":{"id":"/docs/components/chip-17","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#layout-and-sizing","content":"Layout and sizing"},"564":{"id":"/docs/components/chip-18","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#button-composition","content":"Button composition"},"565":{"id":"/docs/components/chip-19","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#accessibility","content":"Accessibility"},"566":{"id":"/docs/components/chip-20","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#best-practices","content":"Best Practices"},"567":{"id":"/docs/components/chip-21","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#troubleshooting","content":"Troubleshooting"},"568":{"id":"/docs/components/chip-22","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"A ChipGroup has no accessible name"},"569":{"id":"/docs/components/chip-23","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"The remove action does not update the UI"},"570":{"id":"/docs/components/chip-24","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"A composed label is not truncating correctly"},"571":{"id":"/docs/components/chip-25","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"The menu trigger does not look like a Chip"},"572":{"id":"/docs/components/chip-26","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#props","content":"Props"},"573":{"id":"/docs/components/chip-27","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chip","content":"Chip"},"574":{"id":"/docs/components/chip-28","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipgroup","content":"ChipGroup"},"575":{"id":"/docs/components/chip-29","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chiplist","content":"ChipList"},"576":{"id":"/docs/components/chip-30","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipbutton","content":"ChipButton"},"577":{"id":"/docs/components/chip-31","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipGroup` + `ChipList` + `Chip` for grouped values, selection, keyboard navigation, and removal"},"578":{"id":"/docs/components/chip-32","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Toggle Chips for selecting multiple peer filters"},"579":{"id":"/docs/components/chip-33","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Removable Chips for user-added filters and input tokens"},"580":{"id":"/docs/components/chip-34","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Shared `sm`, `md`, and `lg` sizes, with optional leading icons"},"581":{"id":"/docs/components/chip-35","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipButton` for menu filters and other actions with a Chip-like appearance"},"582":{"id":"/docs/components/chip-36","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#default","content":"Start with a labeled group of related values. Add selection or removal when\nthe group needs interactive behavior."},"583":{"id":"/docs/components/chip-37","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#toggle-chips","content":"Use Toggle Chips for multiple peer filters. The Chip render prop supplies\nselection state for the checkmark, while `textValue` names composed content."},"584":{"id":"/docs/components/chip-38","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#removable-chips","content":"Use Removable Chips for user-added filters and tokens. `ChipGroup` reports\nremoved keys through `onRemove`; the owner updates its collection. A\nself-closing `Button` in the `remove` slot supplies each remove control."},"585":{"id":"/docs/components/chip-39","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#controlled-selection","content":"Use `selectedKeys` and `onSelectionChange` when another part of the page\nneeds to own the selected filter state."},"586":{"id":"/docs/components/chip-40","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#sizes","content":"Compare the supported `sm`, `md`, and `lg` sizes. Set `size` on `ChipGroup`\nso every Chip inherits one consistent size."},"587":{"id":"/docs/components/chip-41","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#disabled","content":"Disable individual options with `disabledKeys` when some values are unavailable."},"588":{"id":"/docs/components/chip-42","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#truncation","content":"By default, long labels truncate visually when space is constrained, while\nthe complete accessible value remains available."},"589":{"id":"/docs/components/chip-43","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#empty-state","content":"Give an empty collection useful guidance, then let the user add the first\nvalue. Removable items continue to be owned by the collection."},"590":{"id":"/docs/components/chip-44","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#menu-filter-trigger","content":"Use `ChipButton` for Chip presentation without collection semantics.\n`MenuTrigger` continues to own open state, focus, and keyboard behavior."},"591":{"id":"/docs/components/chip-45","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#content","content":"Use a string for a simple label. For icons or other composed content, wrap the\nvisible label in `Text` and provide `textValue` for the accessible name. See\n**Toggle Chips** and **Removable Chips** above."},"592":{"id":"/docs/components/chip-46","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#selection-and-removal","content":"`ChipGroup` owns selection and removal behavior. Use a Chip render prop for\nstate-dependent content, and `Button` with `slot=\"remove\"` together with\n`onRemove` for removable items. See **Toggle Chips** and **Removable Chips**."},"593":{"id":"/docs/components/chip-47","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#layout-and-sizing","content":"Set `size` on `ChipGroup` to keep a collection consistent. `ChipList` wraps by\ndefault and accepts layout props for custom arrangements. See **Sizes**."},"594":{"id":"/docs/components/chip-48","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#button-composition","content":"Use `ChipButton` when Chip presentation is needed without collection semantics.\nCompose it with components such as `MenuTrigger`; those components continue to\nown open state, focus, and keyboard behavior. See **Menu filter trigger**."},"595":{"id":"/docs/components/chip-49","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use `Label` or `aria-label` to name the `ChipGroup`; this names the collection,\nnot its individual Chips."},"596":{"id":"/docs/components/chip-50","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Give each Chip a visible label, `textValue`, or `aria-label`. Use `textValue`\nwhen a Chip contains icons, composed content, or a render prop."},"597":{"id":"/docs/components/chip-51","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use a descriptive group label so removal actions can be announced clearly."},"598":{"id":"/docs/components/chip-52","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Keep the visible label and the accessible value synchronized."},"599":{"id":"/docs/components/chip-53","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"`ChipButton` is a real button and exposes menu state through `MenuTrigger`; provide an accessible name when the visible content is incomplete."},"600":{"id":"/docs/components/chip-54","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep labels concise and let them truncate only when the available width requires it."},"601":{"id":"/docs/components/chip-55","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Prefer groups of three or more related values."},"602":{"id":"/docs/components/chip-56","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep one size per group."},"603":{"id":"/docs/components/chip-57","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Let `ChipList` wrap instead of forcing a single horizontal line."},"604":{"id":"/docs/components/chip-58","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Use removable Chips for user-added filters and tokens."},"605":{"id":"/docs/components/chip-59","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"For menu filters, use `ChipButton` with `MenuTrigger` and provide the chevron explicitly."},"606":{"id":"/docs/components/chip-60","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"Add a visible `Label` to the group or provide `aria-label`. For an individual Chip\nwith composed content, provide a visible label, `textValue`, or `aria-label`."},"607":{"id":"/docs/components/chip-61","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"Add `onRemove` to `ChipGroup` and remove the returned keys from the collection\nowned by your application."},"608":{"id":"/docs/components/chip-62","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"Keep the label in `Text`, preserve `textValue`, and constrain the available width\nof the surrounding layout. Truncation is visual; the complete accessible value\nshould remain available."},"609":{"id":"/docs/components/chip-63","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"Use `ChipButton` inside `MenuTrigger`, include the visible value, and add a\ntrailing chevron to communicate that the control opens a menu."},"610":{"id":"/docs/components/chip-64","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#props","content":"For a menu trigger, the button and menu are composed as siblings inside\n`MenuTrigger`:"},"611":{"id":"/docs/components/circular-progress","page_id":"/docs/components/circular-progress","type":"page","content":"CircularProgress","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/circular-progress"},"612":{"id":"/docs/components/circular-progress-0","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress","content":"A circular progress indicator shows determinate or indeterminate progress of an operation over time"},"613":{"id":"/docs/components/circular-progress-1","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#installation","content":"Installation"},"614":{"id":"/docs/components/circular-progress-2","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#examples","content":"Examples"},"615":{"id":"/docs/components/circular-progress-3","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#default","content":"Default"},"616":{"id":"/docs/components/circular-progress-4","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#sizes","content":"Sizes"},"617":{"id":"/docs/components/circular-progress-5","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#emphasis","content":"Emphasis"},"618":{"id":"/docs/components/circular-progress-6","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#indeterminate","content":"Indeterminate"},"619":{"id":"/docs/components/circular-progress-7","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#accessibility","content":"Accessibility"},"620":{"id":"/docs/components/circular-progress-8","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#aria-support","content":"ARIA Support"},"621":{"id":"/docs/components/circular-progress-9","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#props","content":"Props"},"622":{"id":"/docs/components/circular-progress-10","page_id":"/docs/components/circular-progress","type":"heading","tags":[],"url":"/docs/components/circular-progress#circularprogress","content":"CircularProgress"},"623":{"id":"/docs/components/circular-progress-11","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#default","content":"A basic determinate progress indicator with a label and helper text."},"624":{"id":"/docs/components/circular-progress-12","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#sizes","content":"Four circle diameters are available: `sm` (64px), `md` (96px), `lg` (128px), and `xl` (160px)."},"625":{"id":"/docs/components/circular-progress-13","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#emphasis","content":"Use the `emphasis` prop to communicate status: `success`, `warning`, or `critical`. When omitted, the default teal fill is used."},"626":{"id":"/docs/components/circular-progress-14","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#indeterminate","content":"Use indeterminate progress while preparing an upload whose total size is unknown.\nOnce the total is known, set `isIndeterminate` to false and supply a measured value."},"627":{"id":"/docs/components/circular-progress-15","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/c