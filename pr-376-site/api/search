,"content":"Avatar"},"122":{"id":"/docs/components/avatar-17","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Composable `Avatar`, `Image`, and `Text` parts"},"123":{"id":"/docs/components/avatar-18","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Circle and rounded-square shapes at four named sizes"},"124":{"id":"/docs/components/avatar-19","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Automatic image loading with a Text monogram fallback"},"125":{"id":"/docs/components/avatar-20","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Primary, subtle, and 15 categorical figure emphases"},"126":{"id":"/docs/components/avatar-21","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#features","content":"Avatar Button and Account Menu compositions built with Pressable"},"127":{"id":"/docs/components/avatar-22","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#default","content":"Use an Avatar with a one- or two-character monogram when no image is available."},"128":{"id":"/docs/components/avatar-23","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#image","content":"Place Image before Text so the monogram is available while the image loads or if it fails."},"129":{"id":"/docs/components/avatar-24","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#image-fallback","content":"Include a Text fallback so an unavailable photo never leaves an empty identity marker."},"130":{"id":"/docs/components/avatar-25","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#shapes-and-sizes","content":"Use circular Avatars for people and square Avatars for organizations, workspaces, and accounts."},"131":{"id":"/docs/components/avatar-26","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#emphasis","content":"Use primary or subtle for standard treatments, and a deterministic figure emphasis to categorize entities in a list."},"132":{"id":"/docs/components/avatar-27","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#avatar-button","content":"Use `Pressable` to add accessible interaction to an Avatar while preserving its shape."},"133":{"id":"/docs/components/avatar-28","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#account-menu","content":"Wrap an Avatar in a Pressable inside MenuTrigger for an account or profile menu."},"134":{"id":"/docs/components/avatar-29","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#customization","content":"Use Image native image props for responsive image sources. Choose a deterministic `figure0` through `figure14` emphasis in lists that categorize multiple entities."},"135":{"id":"/docs/components/avatar-30","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#customization","content":"When an Avatar triggers an action, compose it with `Pressable` so the Avatar keeps its own shape and receives the interaction behavior directly. Use this pattern for an Avatar Button, or place it inside `MenuTrigger` for an Account Menu:"},"136":{"id":"/docs/components/avatar-31","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Give Image meaningful `alt` text when the image conveys an identity."},"137":{"id":"/docs/components/avatar-32","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Text remains available to assistive technology when no image loads."},"138":{"id":"/docs/components/avatar-33","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Use `alt=\"\"` on the Image and `aria-hidden=\"true\"` on the Avatar when the entire avatar is purely decorative."},"139":{"id":"/docs/components/avatar-34","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"Give an Avatar Button or Account Menu an accessible name with `aria-label` or `aria-labelledby`."},"140":{"id":"/docs/components/avatar-35","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#accessibility","content":"When using `Pressable`, provide an interactive role for the non-semantic Avatar child."},"141":{"id":"/docs/components/avatar-36","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use Avatar for informational identity; compose it with `Pressable` for an Avatar Button or Account Menu when it is independently actionable."},"142":{"id":"/docs/components/avatar-37","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use circle for people and square for businesses, workspaces, and accounts."},"143":{"id":"/docs/components/avatar-38","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Keep monograms to one or two uppercase characters."},"144":{"id":"/docs/components/avatar-39","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#best-practices","content":"Use the same `figure*` emphasis for the same entity wherever it appears."},"145":{"id":"/docs/components/avatar-40","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"If an image is unavailable because of a bad URL or CORS policy, Text remains visible."},"146":{"id":"/docs/components/avatar-41","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"Long Text content is clipped to the avatar shape; provide a one- or two-character monogram."},"147":{"id":"/docs/components/avatar-42","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar#troubleshooting","content":"Figure colors repeat after 15 values; assign a deterministic figure emphasis in the consuming application."},"148":{"id":"/docs/components/button","page_id":"/docs/components/button","type":"page","content":"Button","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/button"},"149":{"id":"/docs/components/button-0","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"The Button component allows users to initiate actions or submit forms with a single click"},"150":{"id":"/docs/components/button-1","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#installation","content":"Installation"},"151":{"id":"/docs/components/button-2","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#examples","content":"Examples"},"152":{"id":"/docs/components/button-3","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#default","content":"Default"},"153":{"id":"/docs/components/button-4","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#primary","content":"Primary"},"154":{"id":"/docs/components/button-5","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#secondary","content":"Secondary"},"155":{"id":"/docs/components/button-6","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#tertiary","content":"Tertiary"},"156":{"id":"/docs/components/button-7","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#critical","content":"Critical"},"157":{"id":"/docs/components/button-8","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#disabled","content":"Disabled"},"158":{"id":"/docs/components/button-9","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#icon","content":"Icon"},"159":{"id":"/docs/components/button-10","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#icons-and-alignment","content":"Icons And Alignment"},"160":{"id":"/docs/components/button-11","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#inline","content":"Inline"},"161":{"id":"/docs/components/button-12","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#minimal","content":"Minimal"},"162":{"id":"/docs/components/button-13","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#sizes","content":"Sizes"},"163":{"id":"/docs/components/button-14","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#props","content":"Props"},"164":{"id":"/docs/components/button-15","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#button","content":"Button"},"165":{"id":"/docs/components/button-16","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#linkbutton","content":"LinkButton"},"166":{"id":"/docs/components/button-17","page_id":"/docs/components/button","type":"heading","tags":[],"url":"/docs/components/button#closebutton","content":"CloseButton"},"167":{"id":"/docs/components/button-18","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use the `LinkButton` component instead when you need navigation functionality with a button-like appearance."},"168":{"id":"/docs/components/button-19","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use `target=\"_blank\"` to open a link in a new tab without an icon. `isExternal` adds an icon and defaults\nto `target=\"_blank\"` and `rel=\"noopener noreferrer\"`; explicit `target` and `rel` override those defaults.\nYou can also compose an `Icon` as a child independently of navigation behavior."},"169":{"id":"/docs/components/button-20","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Use the `CloseButton` preset to dismiss an overlay (such as a `Modal`). It defaults to `slot=\"close\"`, so it picks up the overlay's close behavior with no wiring, and always renders an `x` icon with `aria-label=\"Close\"`. For a labelled dismiss action (e.g. \"Cancel\"), use a raw `<Button slot=\"close\">Cancel</Button>`."},"170":{"id":"/docs/components/button-21","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button","content":"Inside a field `Group`, `slot=\"control\"` and `slot=\"trigger\"` pick up the matching look, size, and\ndisabled state from context. See TextField for control affixes, and Select or DatePicker for trigger faces.\nThe `control` and `trigger` variants are field parts: the field sizes them, so use them only inside a field."},"171":{"id":"/docs/components/button-22","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#default","content":"The default/tertiary button is the base for all other buttons in the system. It provides no significant visual treatment other than to provide indication for the user to take a common action."},"172":{"id":"/docs/components/button-23","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#primary","content":"The primary button should be used to indicate the most important action for the user to take in their current experience."},"173":{"id":"/docs/components/button-24","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#secondary","content":"The secondary button indicates an action of secondary importance."},"174":{"id":"/docs/components/button-25","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#tertiary","content":"The tertiary button is the default, low-emphasis style used for common, non-critical actions."},"175":{"id":"/docs/components/button-26","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#critical","content":"The critical button signifies to the user a destructive action will take place."},"176":{"id":"/docs/components/button-27","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#disabled","content":"Any button variant can be disabled to prevent interaction, communicated with reduced opacity and a not-allowed cursor."},"177":{"id":"/docs/components/button-28","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#icon","content":"You may provide an optional `Icon` component to the button. Wrap the text beside an icon in a `Text`. If you do not include text, you must provide an aria-label attribute to identify the purpose of the button. This will produce a square button."},"178":{"id":"/docs/components/button-29","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#icons-and-alignment","content":"Control navigation with `target` and `rel`, and compose icons independently. Stretched inline content follows the browser's default alignment; other variants stay centered."},"179":{"id":"/docs/components/button-30","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#inline","content":"The inline button sits within a run of text, styled like a link while retaining button semantics."},"180":{"id":"/docs/components/button-31","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#minimal","content":"The minimal button is an icon-only button that's used when space is limited and/or when the action is universally understood."},"181":{"id":"/docs/components/button-32","page_id":"/docs/components/button","tags":[],"type":"text","url":"/docs/components/button#sizes","content":"Buttons come in small, medium, and large sizes to fit different layout densities. Without\n`size`, a button follows the surrounding size scope, and uses medium outside any scope. An\nicon-only button is square and as tall as a text button of the same size."},"182":{"id":"/docs/components/calendar","page_id":"/docs/components/calendar","type":"page","content":"Calendar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/calendar"},"183":{"id":"/docs/components/calendar-0","page_id":"/docs/components/calendar","tags":[],"type":"text","url":"/docs/components/calendar","content":"Accessible calendar grids for selecting a single date (Calendar) or a date range (RangeCalendar), built on React Aria."},"184":{"id":"/docs/components/calendar-1","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#features","content":"Features"},"185":{"id":"/docs/components/calendar-2","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#installation","content":"Installation"},"186":{"id":"/docs/components/calendar-3","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#working-with-dates","content":"Working with dates"},"187":{"id":"/docs/components/calendar-4","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/components/calendar#examples","content":"Examples"},"188":{"id":"/docs/components/calendar-5","page_id":"/docs/components/calendar","type":"heading","tags":[],"url":"/docs/