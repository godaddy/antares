_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#props","content":"Props"},"1902":{"id":"/docs/components/chart/gauge-chart-13","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#gaugechart","content":"GaugeChart"},"1903":{"id":"/docs/components/chart/gauge-chart-14","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#default","content":"A continuous gauge with a single label."},"1904":{"id":"/docs/components/chart/gauge-chart-15","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#continuous-values","content":"Multiple continuous gauges showing different fill percentages."},"1905":{"id":"/docs/components/chart/gauge-chart-16","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#segmented","content":"Segmented gauges divide the arc into discrete sections (1–5). The `value` prop selects how many segments are filled."},"1906":{"id":"/docs/components/chart/gauge-chart-17","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#with-range-labels","content":"Min/max labels positioned below the gauge arc at the left and right edges. Both `min` and `max` must be provided."},"1907":{"id":"/docs/components/chart/gauge-chart-18","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#variants","content":"Color variants convey meaning at a glance — use `success`, `warning`, or `critical` alongside descriptive text."},"1908":{"id":"/docs/components/chart/gauge-chart-19","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#label-type","content":"Control the font size of the primary label using `labelType`. Use `'value'` for numeric or percentage values and `'text'` for short descriptive strings."},"1909":{"id":"/docs/components/chart/gauge-chart-20","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#gauge-not-sizing-correctly","content":"The component uses `container-type: inline-size` and fills its parent width. Ensure the parent has a defined width:"},"1910":{"id":"/docs/components/chart/gauge-chart-21","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#value-out-of-range","content":"Values outside the valid range are clamped silently at runtime. For continuous mode the range is 0–100; for segmented mode the range is 0 to the segment count."},"1911":{"id":"/docs/components/chart/donut-chart","page_id":"/docs/components/chart/donut-chart","type":"page","content":"DonutChart","breadcrumbs":["Docs","Components","Chart"],"tags":[],"url":"/docs/components/chart/donut-chart"},"1912":{"id":"/docs/components/chart/donut-chart-0","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart","content":"Donut charts are for parts-to-whole comparison—how partial elements add up to a total—shown as a ring so a few categories are easy to compare at a glance."},"1913":{"id":"/docs/components/chart/donut-chart-1","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#installation","content":"Installation"},"1914":{"id":"/docs/components/chart/donut-chart-2","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#examples","content":"Examples"},"1915":{"id":"/docs/components/chart/donut-chart-3","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#default","content":"Default"},"1916":{"id":"/docs/components/chart/donut-chart-4","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#single-slice","content":"Single slice"},"1917":{"id":"/docs/components/chart/donut-chart-5","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#legend-placement","content":"Legend placement"},"1918":{"id":"/docs/components/chart/donut-chart-6","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#small-slices","content":"Small slices"},"1919":{"id":"/docs/components/chart/donut-chart-7","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#format-value","content":"Format value"},"1920":{"id":"/docs/components/chart/donut-chart-8","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#props","content":"Props"},"1921":{"id":"/docs/components/chart/donut-chart-9","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#donutchart","content":"DonutChart"},"1922":{"id":"/docs/components/chart/donut-chart-10","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart#default","content":"You give the chart a `data` array (`id`, `name`, `value`) and a `label` in the middle - this is the everyday setup when you want several categories on one ring and a headline number or title in the hole."},"1923":{"id":"/docs/components/chart/donut-chart-11","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart#single-slice","content":"When there is only one slice, the ring is full. Add `subLabel` if you want a smaller second line under the main center text."},"1924":{"id":"/docs/components/chart/donut-chart-12","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart#legend-placement","content":"Switch `legend` to `right` to sit the legend beside the donut, or `bottom` to stack it underneath. `legendLabel` is there when you want a title above the legend items."},"1925":{"id":"/docs/components/chart/donut-chart-13","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart#small-slices","content":"Very thin slices can be noisy to hover. Anything at or below `smallSliceThreshold` (default `0.05` of the total) is treated as “small,” and if those slices sit next to each other on the ring, one hover opens a single tooltip that lists the whole group."},"1926":{"id":"/docs/components/chart/donut-chart-14","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart#format-value","content":"Use `formatValue` when the raw numbers in the tooltip should read like money, counts with separators, or whatever your product expects. The percentage of the total still formats on its own; your function only shapes the value column."},"1927":{"id":"/docs/components/chart/line-chart","page_id":"/docs/components/chart/line-chart","type":"page","content":"LineChart","breadcrumbs":["Docs","Components","Chart"],"tags":[],"url":"/docs/components/chart/line-chart"},"1928":{"id":"/docs/components/chart/line-chart-0","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart","content":"Line Chart shows how something changes over time or along a continuous scale. It connects data points with lines so people can quickly spot trends, peaks, dips, and patterns."},"1929":{"id":"/docs/components/chart/line-chart-1","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#installation","content":"Installation"},"1930":{"id":"/docs/components/chart/line-chart-2","page_id":"/docs/components/ch