/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#props","content":"Props"},"1509":{"id":"/docs/components/tag-11","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#tag","content":"Tag"},"1510":{"id":"/docs/components/tag-12","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#examples","content":"import { ArgTypes, Meta } from '@storybook/a"},"1511":{"id":"/docs/components/tag-13","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '"},"1512":{"id":"/docs/components/tag-14","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as"},"1513":{"id":"/docs/components/tag-15","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#examples","content":"<Meta of={Stories} name=\""},"1514":{"id":"/docs/components/tag-16","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#screen-readers","content":"Tags are `<span>` elements with no special ARIA role. Screen readers announce the tag's text as part of normal page content — no extra markup is needed."},"1515":{"id":"/docs/components/tag-17","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#decorative-icons","content":"Icons passed as children must include `aria-hidden=\"true\"` so they are skipped by screen readers. The text label is the sole carrier of meaning."},"1516":{"id":"/docs/components/tag-18","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#indicator-dot","content":"The colored dot is decorative and invisible to screen readers. The text label must convey the status on its own — never rely on the dot alone to communicate meaning."},"1517":{"id":"/docs/components/tag-19","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Use the indicator style in dense layouts like tables and dashboards. Use the filled style when the tag is a prominent, standalone element on a card or hero section."},"1518":{"id":"/docs/components/tag-20","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Default to the small size in compact layouts like tables and lists. Use medium or large only when the tag needs to stand out as a primary piece of information."},"1519":{"id":"/docs/components/tag-21","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Use the inline design only within running prose. In grouped or standalone contexts, the filled style provides better visual separation."},"1520":{"id":"/docs/components/tag-22","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Do not stack multiple tags of different emphasis on the same item. Choose the most important one — too many competing labels lose their meaning."},"1521":{"id":"/docs/components/tag-23","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Showing the status of an item on a card, table row, or list entry (e.g. \"Active\", \"Expired\", \"Pending\")"},"1522":{"id":"/docs/components/tag-24","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Categorizing or grouping content so users can scan and filter quickly (e.g. \"New\", \"Sale\", \"Beta\")"},"1523":{"id":"/docs/components/tag-25","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Surfacing metadata about an item (e.g. \"Pro\", \"Free trial\", \"Internal\")"},"1524":{"id":"/docs/components/tag-26","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Communicating priority or category in project management and collaboration tools (e.g. \"High priority\", \"In review\")"},"1525":{"id":"/docs/components/tag-27","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-not-to-use","content":"If users need to click or dismiss it — use a **Button** instead."},"1526":{"id":"/docs/components/tag-28","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-not-to-use","content":"If the label is part of a sentence with no visual distinction — just use text."},"1527":{"id":"/docs/components/text-area","page_id":"/docs/components/text-area","type":"page","content":"TextArea","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-area"},"1528":{"id":"/docs/components/text-area-0","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area","content":"Multiline text control for use inside a field."},"1529":{"id":"/docs/components/text-area-1","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#installation","content":"Installation"},"1530":{"id":"/docs/components/text-area-2","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#examples","content":"Examples"},"1531":{"id":"/docs/components/text-area-3","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#props","content":"Props"},"1532":{"id":"/docs/components/text-area-4","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#textarea","content":"TextArea"},"1533":{"id":"/docs/components/text-area-5","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area","content":"`TextArea` is the multiline control inside a field, not a field on its own. Prefer `TextField` as the parent; see that component for fuller examples."},"1534":{"id":"/docs/components/text-area-6","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area#examples","content":"import { ArgTypes, Me"},"1535":{"id":"/docs/components/text-field","page_id":"/docs/components/text-field","type":"page","content":"TextField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-field"},"1536":{"id":"/docs/components/text-field-0","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field","content":"TextField is a composed single-line or multiline text input. Use it in forms for short answers (email, search, name) or longer content (comments)."},"1537":{"id":"/docs/components/text-field-1","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#features","content":"Features"},"1538":{"id":"/docs/components/text-field-2","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#installation","content":"Installation"},"1539":{"id":"/docs/components/text-field-3","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#examples","content":"Examples"},"1540":{"id":"/docs/components/text-field-4","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#blocks","content":"Blocks"},"1541":{"id":"/docs/components/text-field-5","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#props","content":"Props"},"1542":{"id":"/docs/components/text-field-6","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#textfield","content":"TextField"},"1543":{"id":"/docs/components/text-field-7","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Composable interior**: Compose `Label`, `Input` or `TextArea`, `Text slot=\"description\"`, and `FieldError`. Omitting `Group` leaves the control as a direct field child with box chrome. Use an explicit `Group` for controls or adornments"},"1544":{"id":"/docs/components/text-field-8","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Adornments**: Fixed text or icons before or after the input (e.g. `$`, `.00`, `px`) are composed inside `Group`, positioned by source order"},"1545":{"id":"/docs/components/text-field-9","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controls**: A `Button slot=\"control\"` beside the input is an interactive affix; it picks up field chrome from context"},"1546":{"id":"/docs/components/text-field-10","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"1547":{"id":"/docs/components/text-field-11","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Multiline**: Compose a `TextArea` instead of an `Input` for multiline entry"},"1548":{"id":"/docs/components/text-field-12","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"1549":{"id":"/docs/components/text-field-13","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Sizes**: The field is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets its label, input, description, error, and composed controls; without it, the field follows the surrounding scope. An explicit `size` on a part still wins for that part"},"1550":{"id":"/docs/components/text-field-14","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#examples","content":"import { ArgTypes, Meta } from '@st"},"1551":{"id":"/docs/components/text-field-15","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#examples","content":"import { ArgTypes, Meta } from '@storybook/"},"1552":{"id":"/docs/components/text-field-16","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/b"},"1553":{"id":"/docs/components/text-field-17","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } fr"},"1554":{"id":"/docs/components/text-field-18","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-e"},"1555":{"id":"/docs/components/text-lockup","page_id":"/docs/components/text-lockup","type":"page","content":"TextLockup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-lockup"},"1556":{"id":"/docs/components/text-lockup-0","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup","content":"TextLockup stacks an eyebrow, title, and body text as one coordinated type group across six sizes."},"1557":{"id":"/docs/components/text-lockup-1","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#features","content":"Features"},"1558":{"id":"/docs/components/text-lockup-2","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#installation","content":"Installation"},"1559":{"id":"/docs/components/text-lockup-3","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#examples","content":"Examples"},"1560":{"id":"/docs/components/text-lockup-4","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#customization","content":"Customization"},"1561":{"id":"/docs/components/text-lockup-5","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#accessibility","content":"Accessibility"},"1562":{"id":"/docs/components/text-lockup-6","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#best-practices","content":"Best Practices"},"1563":{"id":"/docs/components/text-lockup-7","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#props","content":"Props"},"1564":{"id":"/docs/components/text-lockup-8","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#textlockup","content":"TextLockup"},"1565":{"id":"/docs/components/text-lockup-9","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Six coordinated sizes, from a `2xl` page title down to `xs`"},"1566":{"id":"/docs/components/text-lockup-10","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"An eyebrow that takes plain text or a `Tag`, sized to match the lockup"},"1567":{"id":"/docs/components/text-lockup-11","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Slotted parts, so nested components keep their own type"},"1568":{"id":"/docs/components/text-lockup-12","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Any heading level, chosen independently of the visual size"},"1569":{"id":"/docs/components/text-lockup-13","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Start or center alignment"},"1570":{"id":"/docs/components/text-lockup-14","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"A legible line-length clamp, on by default"},"1571":{"id":"/docs/components/text-lockup-15","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#examples","content":"## Fe"},"1572":{"id":"/docs/components/text-lockup-16","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#examples","content":"## Features\n\n- Six coordinated sizes, from a `2xl` page title down to"},"1573":{"id":"/docs/components/text-lockup-17","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"`TextLockup` positions and type-sets its parts; you supply them. That means anything else can\nsit alongside them — a call to action, a second paragraph, an image — without the component\ngrowing a prop for it."},"1574":{"id":"/docs/components/text-lockup-18","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**Every part names its role with a slot**: `eyebrow`, `title`, `body`. Unslotted text follows\nthe lockup's tier too: a bare `Heading` takes the title tier and a bare `Text` the body tier."},"1575":{"id":"/docs/components/text-lockup-19","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The eyebrow is `slot=\"eyebrow\"`**, on either a `Text` or a `Tag`. The two forms swap\nfreely, and a `Tag` is sized to pair with the lockup."},"1576":{"id":"/docs/components/text-lockup-20","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The title is `<Heading slot=\"title\">`.** Pick the level from the document outline, not the\nvisual size: `size` handles the visuals, so `level={1}` in an `xs` lockup is perfectly valid."},"1577":{"id":"/docs/components/text-lockup-21","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The body is `<Text slot=\"body\">`**, once or as many times as the copy needs."},"1578":{"id":"/docs/components/text-lockup-22","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**An explicit prop on a child always wins** over what the lockup supplies. Pass\n`<Tag slot=\"eyebrow\" size=\"sm\">` to break the pairing, for instance."},"1579":{"id":"/docs/components/text-lockup-23","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**Controls keep the scale size.** A `Button` inside a lockup follows the surrounding\n`SizeProvider` or its own `size` prop, never the lockup's tier."},"1580":{"id":"/docs/components/text-lockup-24","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**`size` is the tier.** The eyebrow reads it on the `detail` ramp, the title on `heading`, and\nthe body on `body`, so there is no table to memorize. Without `size`, the lockup follows the\nsurrounding size scope. A tier is the same at every container width."},"1581":{"id":"/docs/components/text-lockup-25","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"Pass `className` to extend the styles, or select on `[data-align]`."},"1582":{"id":"/docs/components/text-lockup-26","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"The title carries the heading semantics. Choose `level` so the page outline stays correct\nrather than to achieve a size."},"1583":{"id":"/docs/components/text-lockup-27","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"Slots resolve against the lockup, so `slot=\"title\"` names the lockup's title, not an outer\ncontainer's. Inside a\n`Modal`, `Drawer` or `Popover`, give the dialog its own `<Heading slot=\"title\">` as a direct\nchild for the accessible name, and use the lockup for the body."},"1584":{"id":"/docs/components/text-lockup-28","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"The eyebrow is decorative in most designs. If it carries meaning, make sure the title still\nreads sensibly on its own, since screen reader users often navigate by heading."},"1585":{"id":"/docs/components/text-lockup-29","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Use one `2xl` lockup per page at most — it is the page title."},"1586":{"id":"/docs/components/text-lockup-30","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Keep `legibleLines` on for running prose. Turn it off only when the lockup already sits in a\nnarrow column, where the clamp does nothing but complicate the layout."},"1587":{"id":"/docs/components/text-lockup-31","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Prefer a `Tag` eyebrow for status or category, and plain text for a kicker or section label."},"1588":{"id":"/docs/components/text-lockup-32","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Reach for `MetricsLockup` instead when the emphasis is a single number rather than prose."},"1589":{"id":"/docs/components/text-lockup-33","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#props","content":"Place the title directly inside `TextLockup` when there are no corner actions. The eyebrow can\nbe `Text` or `Tag` and comes before the title."},"1590":{"id":"/docs/components/text-lockup-34","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#props","content":"Wrap the title in `Header` when using `CornerActions`."},"1591":{"id":"/docs/components/text","page_id":"/docs/components/text","type":"page","content":"Text","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text"},"1592":{"id":"/docs/components/text-0","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text","content":"Body copy and supporting detail, with size, emphasis, alignment, and truncation options"},"1593":{"id":"/docs/components/text-1","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#features","content":"Features"},"1594":{"id":"/docs/components/text-2","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#installation","content":"Installation"},"1595":{"id":"/docs/components/text-3","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#examples","content":"Examples"},"1596":{"id":"/docs/components/text-4","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#props","content":"Props"},"1597":{"id":"/docs/components/text-5","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#text","content":"Text"},"1598":{"id":"/docs/components/text-6","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#detail-1","content":"Detail"},"1599":{"id":"/docs/components/text-7","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text","content":"`Text` is body copy and `Detail` is supporting copy: captions, metadata, and hints."},"1600":{"id":"/docs/components/text-8","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`Text` applies the body role and `Detail` the detail role, each at the tier of the nearest\n`SizeProvider`, or `md` outside any scope."},"1601":{"id":"/docs/components/text-9","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"Inside a component's named part, such as a field description or a lockup body, the part sets the\ntreatment. Inside a control, the label keeps the control's type, so\n`<Button><Text>Save</Text></Button>` looks exactly like `<Button>Save</Button>`."},"1602":{"id":"/docs/components/text-10","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`size` picks a step on the component's own ramp (`xs` to `2xl`) and changes only the font size."},"1603":{"id":"/docs/components/text-11","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`emphasis` picks a feedback color and changes only the color."},"1604":{"id":"/docs/components/text-12","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"For semantic emphasis, render `as=\"strong\"` or `as=\"em\"`."},"1605":{"id":"/docs/components/text-13","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#examples","content":"import { ArgTyp"},"1606":{"id":"/docs/components/text-14","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Exam"},"1607":{"id":"/docs/components/text-15","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './text.s"},"1608":{"id":"/docs/components/toast","page_id":"/docs/components/toast","type":"page","content":"Toast","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/toast"},"1609":{"id":"/docs/components/toast-0","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast","content":"Toasts are short, non-modal notifications in the top-right corner of the page that tell the user a system event has happened."},"1610":{"id":"/docs/components/toast-1","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#features","content":"Features"},"1611":{"id":"/docs/components/toast-2","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#installation","content":"Installation"},"1612":{"id":"/docs/components/toast-3","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#usage","content":"Usage"},"1613":{"id":"/docs/components/toast-4","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#examples","content":"Examples"},"1614":{"id":"/docs/components/toast-5","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#several-copies-of-antares-on-one-page","content":"Several copies of Antares on one page"},"1615":{"id":"/docs/components/toast-6","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#accessibility","content":"Accessibility"},"1616":{"id":"/docs/components/toast-7","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#keyboard","content":"Keyboard"},"1617":{"id":"/docs/components/toast-8","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#screen-readers","content":"Screen readers"},"1618":{"id":"/docs/components/toast-9","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#timing","content":"Timing"},"1619":{"id":"/docs/components/toast-10","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#best-practices","content":"Best Practices"},"1620":{"id":"/docs/components/toast-11","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#props","content":"Props"},"1621":{"id":"/docs/components/toast-12","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#toastregion","content":"ToastRegion"},"1622":{"id":"/docs/components/toast-13","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#toastaddoptions","content":"toast.add(options)"},"1623":{"id":"/docs/components/toast-14","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#new-toastqueueoptions","content":"new ToastQueue(options)"},"1624":{"id":"/docs/components/toast-15","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#features","content":"Call `toast.add()` from anywhere; mount one `<ToastRegion />` per app"},"1625":{"id":"/docs/components/toast-16","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#features","content":"Emphasis variants with status icons: none, success, critical, warning"},"1626":{"id":"/docs/components/toast-17","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#features","content":"Closes on its own after 5 seconds by default, or stays until dismissed"},"1627":{"id":"/docs/components/toast-18","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#features","content":"Timers pause while the pointer or keyboard focus is on the toasts"},"1628":{"id":"/docs/components/toast-19","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#features","content":"Safe with several copies of Antares on one page: they share one stack in the corner"},"1629":{"id":"/docs/components/toast-20","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#usage","content":"Mount one region inside your app's providers, so toast content keeps your context (i18n, theme, and so on):"},"1630":{"id":"/docs/components/toast-21","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#usage","content":"Toasts added before the region mounts wait in the queue and show once it does."},"1631":{"id":"/docs/components/toast-22","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './toast.stori"},"1632":{"id":"/docs/components/toast-23","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#examples","content":"## Features\n\n- Call `toast.add()` from anyw"},"1633":{"id":"/docs/components/toast-24","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#several-copies-of-antares-on-one-page","content":"A page can load more than one copy of Antares, such as a shared header and the app it wraps, possibly at\ndifferent versions. Each copy renders its own toasts, with its own components and React context, into one\npage-wide element (`[data-antares-toast-host=\"1\"]`) that the first copy creates. So toasts stack instead of\noverlapping, and nothing has to be shared between versions."},"1634":{"id":"/docs/components/toast-25","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#several-copies-of-antares-on-one-page","content":"Toasts are grouped by copy: the header's toasts stay together, and the app's stay together. Give each copy's\nregion its own label with `ariaLabels={{ region }}`, so screen readers can tell them apart."},"1635":{"id":"/docs/components/toast-26","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#several-copies-of-antares-on-one-page","content":"If micro front-ends share **one** copy of Antares, their `<ToastRegion />`s all render the same default\nqueue. Only the first one mounted shows the toasts, so none appear twice; if it unmounts, the next one\ntakes over. Those toasts render inside the active region's app, so a micro front-end that needs its own\ncontext (such as its own i18n) should use its own `new ToastQueue()` and `<ToastRegion queue={queue} />`."},"1636":{"id":"/docs/components/toast-27","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#keyboard","content":"| Key               | Description                                          |\n| ----------------- | ---------------------------------------------------- |\n| `F6` / `Shift+F6` | Moves focus into and out of the notifications region |","table":"table-0"},"1637":{"id":"/docs/components/toast-28","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#keyboard","content":"| Key                 | Description                                  |\n| ------------------- | -------------------------------------------- |\n| `Tab` / `Shift+Tab` | Moves between toasts and their close buttons |","table":"table-0"},"1638":{"id":"/docs/components/toast-29","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#keyboard","content":"| Key               | Description                                       |\n| ----------------- | ------------------------------------------------- |\n| `Space` / `Enter` | Closes the toast when its close button is focused |","table":"table-0"},"1639":{"id":"/docs/components/toast-30","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#keyboard","content":"When the focused toast closes, focus moves to the next toast, or back to where it was before entering the region."},"1640":{"id":"/docs/components/toast-31","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#screen-readers","content":"The region is a landmark labelled with the number of notifications. Each toast is announced when it appears,\nand is labelled by its title (or its message when there is no title). Translate the labels with\n`ariaLabels={{ region, close }}` on `ToastRegion`."},"1641":{"id":"/docs/components/toast-32","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#timing","content":"Timeouts pause while the user hovers or focuses the toasts. The default of 5 seconds follows WCAG's guidance\non adjustable timing; avoid shorter timeouts."},"1642":{"id":"/docs/components/toast-33","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#best-practices","content":"Keep the title to one or two words and the message to one sentence."},"1643":{"id":"/docs/components/toast-34","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#best-practices","content":"Don't put links or actions in a toast that times out; the user may not reach them in time."},"1644":{"id":"/docs/components/toast-35","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#best-practices","content":"Use `timeout: null` for messages the user must see, and close them from code when the work finishes."},"1645":{"id":"/docs/components/toast-36","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#best-practices","content":"Only hide the close button (`dismissible: false`) on short, timed toasts. Persistent toasts always show it."},"1646":{"id":"/docs/components/toast-37","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#best-practices","content":"Use `critical` for failures the user can fix, and `warning` for things that matter but don't need action now."},"1647":{"id":"/docs/components/toast-38","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#toastaddoptions","content":"Returns the key to pass to `toast.close(key)`."},"1648":{"id":"/docs/components/toast-39","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#new-toastqueueoptions","content":"A separate queue with the same `add` and `close` methods. Render it with `<ToastRegion queue={queue} />`."},"1649":{"id":"/docs/components/toggle-button","page_id":"/docs/components/toggle-button","type":"page","content":"ToggleButton","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/toggle-button"},"1650":{"id":"/docs/components/toggle-button-0","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button","content":"Accessible toggle button component for grouped contextual actions with single or multiple selection, keyboard navigation, and RTL-aware layouts."},"1651":{"id":"/docs/components/toggle-button-1","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#installation","content":"Installation"},"1652":{"id":"/docs/components/toggle-button-2","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#exampl