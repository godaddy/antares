con","tags":[],"type":"text","url":"/docs/components/icon#inherit-from-parent-default","content":"By default, icons inherit the color from their parent element via `currentColor`:"},"725":{"id":"/docs/components/icon-84","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#explicit-colors","content":"Override the color with specific values:"},"726":{"id":"/docs/components/icon-85","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#icon-transformations","content":"Transform capabilities are inherited from the Bento Illustration component. For complete transformation options and implementation details, see the `@bento/illustration` package documentation."},"727":{"id":"/docs/components/icon-86","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#rotation","content":"Rotate icons by 90-degree increments:"},"728":{"id":"/docs/components/icon-87","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#flipping","content":"Flip icons horizontally or vertically:"},"729":{"id":"/docs/components/icon-88","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#placeholder-content","content":"Provide fallback SVG content while icons load from the CDN:"},"730":{"id":"/docs/components/icon-89","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#decorative-icons","content":"For purely decorative icons, no additional attributes are needed. The icon will have `role=\"presentation\"` and be ignored by screen readers:"},"731":{"id":"/docs/components/icon-90","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#semantic-icons","content":"For icons that convey meaning, use the `title` prop. This automatically adds `role=\"img\"` and provides screen reader accessible text:"},"732":{"id":"/docs/components/icon-91","page_id":"/docs/components/icon","tags":[