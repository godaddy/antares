ponents/slider-32","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#features","content":"Single `number` value with configurable minimum, maximum, and step"},"1181":{"id":"/docs/components/slider-33","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#features","content":"Controlled and uncontrolled state with `onChange` and `onChangeEnd` callbacks"},"1182":{"id":"/docs/components/slider-34","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#features","content":"Optional localized value output, endpoint labels, description, and error message"},"1183":{"id":"/docs/components/slider-35","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#features","content":"Optional markers generated from the configured step positions"},"1184":{"id":"/docs/components/slider-36","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#features","content":"Required, disabled, keyboard, pointer, and touch behavior provided through React Aria"},"1185":{"id":"/docs/components/slider-37","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#default","content":"Use `Slider` when the user chooses one value, such as volume or quality."},"1186":{"id":"/docs/components/slider-38","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#controlled","content":"Use `value` and `onChange` when application state owns the selection."},"1187":{"id":"/docs/components/slider-39","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#disabled","content":"Disable the slider when the value is visible but unavailable."},"1188":{"id":"/docs/components/slider-40","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#labels","content":"Display the current value and endpoints when users need more context."},"1189":{"id":"/docs/components/slider-41","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#markers","content":"Use markers for a small set of meaningful steps."},"1190":{"id":"/docs/components/slider-42","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#customization","content":"`Slider` provides content props for common product requirements and CSS custom properties for visual adjustments. Prefer these APIs over targeting its internal DOM structure."},"1191":{"id":"/docs/components/slider-43","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#programmatic-focus","content":"Attach a `SliderRef` when an application needs to move focus after validation or navigate to the field. Calling `focus()` focuses the thumb; `container` exposes the root element for DOM operations such as scrolling."},"1192":{"id":"/docs/components/slider-44","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#value-display","content":"Use `valueLabel` to place content opposite the field label:"},"1193":{"id":"/docs/components/slider-45","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#value-display","content":"`true` displays the current value using `formatOptions` and the active locale."},"1194":{"id":"/docs/components/slider-46","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#value-display","content":"A React node displays static content, such as a unit or status."},"1195":{"id":"/docs/components/slider-47","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#value-display","content":"A render function receives the React Aria slider state and can derive custom content from the current value."},"1196":{"id":"/docs/components/slider-48","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#value-display","content":"`valueLabel` is visual supporting content. It does not replace the control's `label` or `aria-label`."},"1197":{"id":"/docs/components/slider-49","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#endpoint-labels-and-markers","content":"`minLabel` and `maxLabel` are independent `ReactNode` slots below the track. Provide either one or both; the component does not generate or format their content. Each slot uses at most 40% of the available width so long labels can wrap without colliding in the center."},"1198":{"id":"/docs/components/slider-50","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#endpoint-labels-and-markers","content":"Set `markers` to render one marker for every valid step beginning at `minValue`. Marker positions always use the same scale as the thumb, so they remain aligned. Use `minValue`, `maxValue`, and `step` to control their number and spacing."},"1199":{"id":"/docs/components/slider-51","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#number-formatting","content":"`formatOptions` accepts `Intl.NumberFormatOptions` and controls localized value output, including the default `valueLabel` and the value announced by assistive technology."},"1200":{"id":"/docs/components/slider-52","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#visual-styling","content":"Pass `className` to add a class to the root element. The following custom properties are the supported styling surface:"},"1201":{"id":"/docs/components/slider-53","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#visual-styling","content":"`--slider-track-height`"},"1202":{"id":"/docs/components/slider-54","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#visual-styling","content":"`--slider-fill-height`"},"1203":{"id":"/docs/components/slider-55","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#visual-styling","content":"`--slider-thumb-size`"},"1204":{"id":"/docs/components/slider-56","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#visual-styling","content":"`--slider-marker-size`"},"1205":{"id":"/docs/components/slider-57","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#visual-styling","content":"`--slider-fill-color`"},"1206":{"id":"/docs/components/slider-58","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#visual-styling","content":"`--slider-track-color`"},"1207":{"id":"/docs/components/slider-59","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#visual-styling","content":"`--slider-thumb-bg`"},"1208":{"id":"/docs/components/slider-60","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#visual-styling","content":"`--slider-thumb-border`"},"1209":{"id":"/docs/components/slider-61","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#visual-styling","content":"`--slider-label-color`"},"1210":{"id":"/docs/components/slider-62","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#visual-styling","content":"Scope overrides to a local class so other sliders are unaffected."},"1211":{"id":"/docs/components/slider-63","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#accessible-name","content":"Every slider needs an accessible name. Prefer a concise visible `label` because it gives the same context to sighted users and assistive technology. If the surrounding interface already supplies an equivalent visible label, provide `aria-label` instead. Do not use `valueLabel`, `minLabel`, `maxLabel`, or placeholder-like nearby text as the only name."},"1212":{"id":"/docs/components/slider-64","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#keyboard-interaction","content":"The thumb follows the React Aria slider keyboard model:"},"1213":{"id":"/docs/components/slider-65","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#keyboard-interaction","content":"Arrow Right and Arrow Up increase the value by `step`."},"1214":{"id":"/docs/components/slider-66","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#keyboard-interaction","content":"Arrow Left and Arrow Down decrease the value by `step`."},"1215":{"id":"/docs/components/slider-67","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#keyboard-interaction","content":"Home moves to `minValue`; End moves to `maxValue`."},"1216":{"id":"/docs/components/slider-68","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#keyboard-interaction","content":"Page Up and Page Down make larger changes."},"1217":{"id":"/docs/components/slider-69","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#keyboard-interaction","content":"Tab moves focus into and out of the control."},"1218":{"id":"/docs/components/slider-70","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#keyboard-interaction","content":"Directional behavior follows the user's locale where appropriate. Pointer, touch, and keyboard input all update the same value scale."},"1219":{"id":"/docs/components/slider-71","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#value-announcements","content":"Choose `formatOptions` that communicates the meaning of the number—not only its appearance. For example, announce `50` as 50 US dollars when the value represents a budget. The formatted value is exposed to assistive technology as the thumb changes."},"1220":{"id":"/docs/components/slider-72","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#value-announcements","content":"Markers are decorative and are hidden from the accessibility tree. Their meaning must therefore be represented by the slider's label, bounds, step, and formatted value."},"1221":{"id":"/docs/components/slider-73","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#instructions-required-state-and-errors","content":"Use `description` for persistent guidance that helps users make a selection. Set `isRequired` when the slider is required, and use `errorMessage` with the component's validation state to explain how to correct an invalid selection. React Aria associates this content with the control; error messages should state the problem and the corrective action."},"1222":{"id":"/docs/components/slider-74","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#disabled-state","content":"`isDisabled` prevents pointer and keyboard changes and exposes the disabled state semantically. The slider control is visually muted while its label, endpoint labels, description, and error text remain readable."},"1223":{"id":"/docs/components/slider-75","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#best-practices","content":"Use `Slider` for one approximate numeric choice within known bounds, such as volume, zoom, or intensity."},"1224":{"id":"/docs/components/slider-76","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#best-practices","content":"Use a numeric text field when users must enter or verify an exact value efficiently. A slider should not be the only input for high-precision or unbounded data."},"1225":{"id":"/docs/components/slider-77","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#best-practices","content":"Set meaningful `minValue`, `maxValue`, and `step` values. The step should match the smallest choice users need to make."},"1226":{"id":"/docs/components/slider-78","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#best-practices","content":"Show markers only when the available steps are few enough to scan. Dense markers add visual noise without improving comprehension."},"1227":{"id":"/docs/components/slider-79","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#best-practices","content":"Add `minLabel` and `maxLabel` when the endpoints have product meaning that the numeric bounds alone do not explain."},"1228":{"id":"/docs/components/slider-80","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#best-practices","content":"Use `formatOptions` for currencies, percentages, units, or other locale-sensitive values."},"1229":{"id":"/docs/components/slider-81","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#best-practices","content":"Use `onChange` for immediate UI feedback. Put expensive operations, such as network requests or large calculations, in `onChangeEnd` so they run after the interaction finishes."},"1230":{"id":"/docs/components/slider-82","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#best-practices","content":"In controlled usage, update `value` from `onChange`; otherwise the thumb cannot reflect the user's change."},"1231":{"id":"/docs/components/slider-83","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#best-practices","content":"Do not use this component to select a minimum and maximum simultaneously. `Slider` intentionally represents one number."},"1232":{"id":"/docs/components/slider-84","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#the-thumb-snaps-to-unexpected-values","content":"Check that `step` represents the intended interval from `minValue`. Slider values snap to valid steps within the configured bounds. Decimal steps should use values appropriate for the precision your product displays."},"1233":{"id":"/docs/components/slider-85","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#the-final-marker-is-missing","content":"Markers begin at `minValue` and are generated at each complete step. A marker appears at `maxValue` only when the range is evenly divisible by `step`. For example, a range from `0` to `10` with a step of `3` ends its markers at `9`."},"1234":{"id":"/docs/components/slider-86","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#markers-are-crowded-or-affect-rendering-performance","content":"Increase `step` or omit `markers`. Avoid producing hundreds of decorative positions; use a continuous track when every step is not useful to scan."},"1235":{"id":"/docs/components/slider-87","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#the-controlled-thumb-does-not-move","content":"The `value` prop is the source of truth. Update that value in `onChange`, and ensure it remains between `minValue` and `maxValue`."},"1236":{"id":"/docs/components/slider-88","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#the-value-label-is-not-visible","content":"Pass `valueLabel={true}`, a React node, or a render function. `formatOptions` only formats a value; it does not enable the visual value label."},"1237":{"id":"/docs/components/slider-89","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#an-endpoint-label-is-blank","content":"`minLabel` and `maxLabel` render only the content explicitly provided. They do not default to `minValue` or `maxValue`, and `formatOptions` is not applied to them."},"1238":{"id":"/docs/components/slider-90","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#negative-values-do-not-behave-as-expected","content":"Negative values are supported. Set a negative `minValue` and ensure the controlled or default value is within the configured range."},"1239":{"id":"/docs/components/slider-91","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#the-range-is-invalid","content":"Provide finite bounds where `minValue` is less than `maxValue`, and a finite `step` greater than zero. Invalid scale values also prevent markers from being generated."},"1240":{"id":"/docs/components/tag","page_id":"/docs/components/tag","type":"page","content":"Tag","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tag"},"1241":{"id":"/docs/components/tag-0","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag","content":"Non-interactive labels that highlight statuses and categories."},"1242":{"id":"/docs/components/tag-1","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#installation","content":"Installation"},"1243":{"id":"/docs/components/tag-2","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#props","content":"Props"},"1244":{"id":"/docs/components/tag-3","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#examples","content":"Examples"},"1245":{"id":"/docs/components/tag-4","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#basic","content":"Basic"},"1246":{"id":"/docs/components/tag-5","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#emphasis","content":"Emphasis"},"1247":{"id":"/docs/components/tag-6","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#sizes","content":"Sizes"},"1248":{"id":"/docs/components/tag-7","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#inline","content":"Inline"},"1249":{"id":"/docs/components/tag-8","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#high-contrast","content":"High Contrast"},"1250":{"id":"/docs/components/tag-9","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#with-icon","content":"With Icon"},"1251":{"id":"/docs/components/tag-10","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#indicator","content":"Indicator"},"1252":{"id":"/docs/components/tag-11","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#accessibility","content":"Accessibility"},"1253":{"id":"/docs/components/tag-12","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#screen-readers","content":"Screen readers"},"1254":{"id":"/docs/components/tag-13","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#decorative-icons","content":"Decorative icons"},"1255":{"id":"/docs/components/tag-14","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#indicator-dot","content":"Indicator dot"},"1256":{"id":"/docs/components/tag-15","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#best-practices","content":"Best Practices"},"1257":{"id":"/docs/components/tag-16","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#when-to-use","content":"When to Use"},"1258":{"id":"/docs/components/tag-17","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#when-not-to-use","content":"When Not to Use"},"1259":{"id":"/docs/components/tag-18","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#basic","content":"A minimal tag with the default emphasis and size."},"1260":{"id":"/docs/components/tag-19","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#emphasis","content":"Nine emphasis options are available. Choose the one that fits the visual tone of your context."},"1261":{"id":"/docs/components/tag-20","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#sizes","content":"Choose a size that fits the surrounding content. Smaller tags work well in compact layouts like tables; larger tags suit headings or hero sections."},"1262":{"id":"/docs/components/tag-21","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#inline","content":"Use `design=\"inline\"` to embed a tag within a sentence. The background and border are removed so the tag blends into the text flow."},"1263":{"id":"/docs/components/tag-22","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#high-contrast","content":"A bolder color treatment for when tags need to stand out more — for example, on colored backgrounds."},"1264":{"id":"/docs/components/tag-23","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#with-icon","content":"Icons reinforce the tag's meaning at a glance. Add an `Icon` as a child — it inherits the tag's color and scales with its size."},"1265":{"id":"/docs/components/tag-24","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#indicator","content":"A minimal style that pairs a small colored dot with a neutral background. Well suited for dense layouts like tables or dashboards where multiple tags in close proximity would otherwise compete for attention."},"1266":{"id":"/docs/components/tag-25","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#screen-readers","content":"Tags are `<span>` elements with no special ARIA role. Screen readers announce the tag's text as part of normal page content — no extra markup is needed."},"1267":{"id":"/docs/components/tag-26","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#decorative-icons","content":"Icons passed as children must include `aria-hidden=\"true\"` so they are skipped by screen readers. The text label is the sole carrier of meaning."},"1268":{"id":"/docs/components/tag-27","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#indicator-dot","content":"The colored dot is decorative and invisible to screen readers. The text label must convey the status on its own — never rely on the dot alone to communicate meaning."},"1269":{"id":"/docs/components/tag-28","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Use the indicator style in dense layouts like tables and dashboards. Use the filled style when the tag is a prominent, standalone element on a card or hero section."},"1270":{"id":"/docs/components/tag-29","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Default to the small size in compact layouts like tables and lists. Use medium or large only when the tag needs to stand out as a primary piece of information."},"1271":{"id":"/docs/components/tag-30","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Use the inline design only within running prose. In grouped or standalone contexts, the filled style provides better visual separation."},"1272":{"id":"/docs/components/tag-31","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Do not stack multiple tags of different emphasis on the same item. Choose the most important one — too many competing labels lose their meaning."},"1273":{"id":"/docs/components/tag-32","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Showing the status of an item on a card, table row, or list entry (e.g. \"Active\", \"Expired\", \"Pending\")"},"1274":{"id":"/docs/components/tag-33","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Categorizing or grouping content so users can scan and filter quickly (e.g. \"New\", \"Sale\", \"Beta\")"},"1275":{"id":"/docs/components/tag-34","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Surfacing metadata about an item (e.g. \"Pro\", \"Free trial\", \"Internal\")"},"1276":{"id":"/docs/components/tag-35","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Communicating priority or category in project management and collaboration tools (e.g. \"High priority\", \"In review\")"},"1277":{"id":"/docs/components/tag-36","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-not-to-use","content":"If users need to click or dismiss it — use a **Button** instead."},"1278":{"id":"/docs/components/tag-37","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-not-to-use","content":"If the label is part of a sentence with no visual distinction — just use text."},"1279":{"id":"/docs/components/text","page_id":"/docs/components/text","type":"page","content":"Text","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text"},"1280":{"id":"/docs/components/text-0","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text","content":"Text component for displaying and formatting text content with alignment and truncation options"},"1281":{"id":"/docs/components/text-1","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#installation","content":"Installation"},"1282":{"id":"/docs/components/text-2","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#props","content":"Props"},"1283":{"id":"/docs/components/text-3","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#examples","content":"Examples"},"1284":{"id":"/docs/components/text-4","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#as","content":"As"},"1285":{"id":"/docs/components/text-5","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#align","content":"Align"},"1286":{"id":"/docs/components/text-6","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#max-lines","content":"Max Lines"},"1287":{"id":"/docs/components/text-7","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#wrap","content":"Wrap"},"1288":{"id":"/docs/components/text-8","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text","content":"The `Text` component prepares content with a few properties."},"1289":{"id":"/docs/components/text-9","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#props","content":"The `Text` component accepts the following props:"},"1290":{"id":"/docs/components/text-10","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#as","content":"Setting the `as` prop allows you to change the HTML tag of the `Text` component."},"1291":{"id":"/docs/components/text-11","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#align","content":"Setting the `align` prop allows you to change the alignment of the text. You can choose from `start`, `center`, `end`, or `justify`.\n`start` works like `left` and `end` works like `right`. These keywords support RTL languages so you do not need to worry about the language of the text."},"1292":{"id":"/docs/components/text-12","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#max-lines","content":"Setting the `maxLines` prop allows you to limit the number of lines of text that are displayed using an ellipsis. In browsers that don't support multiline text truncation using `line-clamp`, the text will be truncated after a single line regardless of the number provided for `maxLines`."},"1293":{"id":"/docs/components/text-13","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#wrap","content":"Setting the `wrap` prop allows you to change the wrapping of the text. The values can be `wrap`, `nowrap`, `balance`, `pretty`, or `stable`."},"1294":{"id":"/docs/components/text-14","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#wrap","content":"`wrap` is the setting that is most commonly used. For most elements you will not to explicitly set this."},"1295":{"id":"/docs/components/text-15","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#wrap","content":"`nowrap` should be avoided except in cases where it is important to prevent the text from wrapping."},"1296":{"id":"/docs/components/text-16","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#wrap","content":"`balance` is most commonly used for headlines, titles, and labels."},"1297":{"id":"/docs/components/text-17","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#wrap","content":"`pretty` is most commonly used for body text."},"1298":{"id":"/docs/components/text-18","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#wrap","content":"`stable` is commonly used for editable text, such as textareas."},"1299":{"id":"/docs/components/text-field","page_id":"/docs/components/text-field","type":"page","content":"TextField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-field"},"1300":{"id":"/docs/components/text-field-0","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field","content":"TextField is a single-line or multiline text input with optional label, description, and error message. Use it in forms for short answers (email, search, name) or longer content (comments). It supports optional leading and trailing text adornments (e.g. currency or units)."},"1301":{"id":"/docs/components/text-field-1","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#features","content":"Features"},"1302":{"id":"/docs/components/text-field-2","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#installation","content":"Installation"},"1303":{"id":"/docs/components/text-field-3","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#props","content":"Props"},"1304":{"id":"/docs/components/text-field-4","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#examples","content":"Examples"},"1305":{"id":"/docs/components/text-field-5","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#basic","content":"Basic"},"1306":{"id":"/docs/components/text-field-6","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#controlled","content":"Controlled"},"1307":{"id":"/docs/components/text-field-7","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#invalid","content":"Invalid"},"1308":{"id":"/docs/components/text-field-8","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#disabled","content":"Disabled"},"1309":{"id":"/docs/components/text-field-9","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#adornments","content":"A