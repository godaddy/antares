":"/docs/components/radio#when-to-use-radio-buttons","content":"✅ When there are 2-7 mutually exclusive options"},"966":{"id":"/docs/components/radio-44","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"✅ When all options should be visible at once"},"967":{"id":"/docs/components/radio-45","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"✅ When the decision is important and deserves space"},"968":{"id":"/docs/components/radio-46","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ For more than 7 options (use Select instead)"},"969":{"id":"/docs/components/radio-47","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ For binary yes/no choices (use Checkbox or Toggle instead)"},"970":{"id":"/docs/components/radio-48","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ When space is limited (use Select dropdown)"},"971":{"id":"/docs/components/radio-49","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Use clear, concise labels"},"972":{"id":"/docs/components/radio-50","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Keep labels short (1-3 words when possible)"},"973":{"id":"/docs/components/radio-51","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Place the most common option first"},"974":{"id":"/docs/components/radio-52","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Ensure labels are descriptive without being verbose"},"975":{"id":"/docs/components/radio-53","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#validation","content":"Always provide clear error messages:"},"976":{"id":"/docs/components/range-slider","page_id":"/docs/components/range-slider","type":"page","content":"RangeSlider","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/range-slider"},"977":{"id":"/docs/components/range-slider-0","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider","content":"RangeSlider lets users choose exactly two values that define the start and end of a bounded numeric interval."},"978":{"id":"/docs/components/range-slider-1","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#features","content":"Features"},"979":{"id":"/docs/components/range-slider-2","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#installation","content":"Installation"},"980":{"id":"/docs/components/range-slider-3","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#props","content":"Props"},"981":{"id":"/docs/components/range-slider-4","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#examples","content":"Examples"},"982":{"id":"/docs/components/range-slider-5","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#default","content":"Default"},"983":{"id":"/docs/components/range-slider-6","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#controlled","content":"Controlled"},"984":{"id":"/docs/components/range-slider-7","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#disabled","content":"Disabled"},"985":{"id":"/docs/components/range-slider-8","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#labels","content":"Labels"},"986":{"id":"/docs/components/range-slider-9","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#markers","content":"Markers"},"987":{"id":"/docs/components/range-slider-10","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#form-submission","content":"Form submission"},"988":{"id":"/docs/components/range-slider-11","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#customization","content":"Customization"},"989":{"id":"/docs/components/range-slider-12","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#programmatic-focus","content":"Programmatic focus"},"990":{"id":"/docs/components/range-slider-13","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#value-display","content":"Value display"},"991":{"id":"/docs/components/range-slider-14","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#endpoint-labels-and-markers","content":"Endpoint labels and markers"},"992":{"id":"/docs/components/range-slider-15","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#number-formatting","content":"Number formatting"},"993":{"id":"/docs/components/range-slider-16","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#visual-styling","content":"Visual styling"},"994":{"id":"/docs/components/range-slider-17","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#accessibility","content":"Accessibility"},"995":{"id":"/docs/components/range-slider-18","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#accessible-names","content":"Accessible names"},"996":{"id":"/docs/components/range-slider-19","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#keyboard-interaction","content":"Keyboard interaction"},"997":{"id":"/docs/components/range-slider-20","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#value-announcements","content":"Value announcements"},"998":{"id":"/docs/components/range-slider-21","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#instructions-required-state-and-errors","content":"Instructions, required state, and errors"},"999":{"id":"/docs/components/range-slider-22","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#disabled-state","content":"Disabled state"},"1000":{"id":"/docs/components/range-slider-23","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#best-practices","content":"Best Practices"},"1001":{"id":"/docs/components/range-slider-24","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#troubleshooting","content":"Troubleshooting"},"1002":{"id":"/docs/components/range-slider-25","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#the-thumbs-are-indistinguishable-to-screen-reader-users","content":"The thumbs are indistinguishable to screen-reader users"},"1003":{"id":"/docs/components/range-slider-26","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#form-values-are-missing-or-use-the-wrong-keys","content":"Form values are missing or use the wrong keys"},"1004":{"id":"/docs/components/range-slider-27","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#a-controlled-range-does-not-move","content":"A controlled range does not move"},"1005":{"id":"/docs/components/range-slider-28","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#values-snap-unexpectedly","content":"Values snap unexpectedly"},"1006":{"id":"/docs/components/range-slider-29","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#the-final-marker-is-missing","content":"The final marker is missing"},"1007":{"id":"/docs/components/range-slider-30","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#markers-are-too-dense","content":"Markers are too dense"},"1008":{"id":"/docs/components/range-slider-31","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#the-value-or-endpoint-labels-are-blank","content":"The value or endpoint labels are blank"},"1009":{"id":"/docs/components/range-slider-32","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#negative-ranges-do-not-behave-as-expected","content":"Negative ranges do not behave as expected"},"1010":{"id":"/docs/components/range-slider-33","page_id":"/docs/components/range-slider","type":"heading","tags":[],"url":"/docs/components/range-slider#the-range-configuration-is-invalid","content":"The range configuration is invalid"},"1011":{"id":"/docs/components/range-slider-34","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#features","content":"Fixed `[start, end]` tuple with one independently adjustable thumb per value"},"1012":{"id":"/docs/components/range-slider-35","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#features","content":"Required accessible labels that distinguish the start and end thumbs"},"1013":{"id":"/docs/components/range-slider-36","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#features","content":"Controlled and uncontrolled state with `onChange` and `onChangeEnd` callbacks"},"1014":{"id":"/docs/components/range-slider-37","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#features","content":"Independent `startName` and `endName` values for native form submission"},"1015":{"id":"/docs/components/range-slider-38","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#features","content":"Configurable minimum, maximum, step, localized value output, endpoint labels, and markers"},"1016":{"id":"/docs/components/range-slider-39","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#features","content":"Required, disabled, keyboard, pointer, and touch behavior provided through React Aria"},"1017":{"id":"/docs/components/range-slider-40","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#default","content":"Use `RangeSlider` for fixed two-value selections such as price or date bounds."},"1018":{"id":"/docs/components/range-slider-41","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#controlled","content":"Use `value` and `onChange` when application state owns both ends of the range."},"1019":{"id":"/docs/components/range-slider-42","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#disabled","content":"Disable the range slider when its values are visible but unavailable."},"1020":{"id":"/docs/components/range-slider-43","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#labels","content":"Provide visible context and formatted values when precision matters."},"1021":{"id":"/docs/components/range-slider-44","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#markers","content":"Use markers to show a manageable set of meaningful steps across the range."},"1022":{"id":"/docs/components/range-slider-45","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#form-submission","content":"Use `startName` and `endName` to submit each thumb as a separate form value."},"1023":{"id":"/docs/components/range-slider-46","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#customization","content":"`RangeSlider` exposes content props for product-specific labels and CSS custom properties for visual adjustments. Prefer these APIs over targeting its internal DOM structure."},"1024":{"id":"/docs/components/range-slider-47","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#programmatic-focus","content":"Attach a `RangeSliderRef` when an application needs to move focus after validation or navigate to the field. Calling `focus()` focuses the start thumb; `container` exposes the root element for DOM operations such as scrolling."},"1025":{"id":"/docs/components/range-slider-48","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#value-display","content":"Use `valueLabel` to place content opposite the field label:"},"1026":{"id":"/docs/components/range-slider-49","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#value-display","content":"`true` displays both current values using `formatOptions` and the active locale."},"1027":{"id":"/docs/components/range-slider-50","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#value-display","content":"A React node displays static content."},"1028":{"id":"/docs/components/range-slider-51","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#value-display","content":"A render function receives the React Aria slider state and can format both values together."},"1029":{"id":"/docs/components/range-slider-52","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#value-display","content":"`valueLabel` is visual supporting content. It does not replace the field's accessible name or the individual `thumbLabels`."},"1030":{"id":"/docs/components/range-slider-53","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#endpoint-labels-and-markers","content":"`minLabel` and `maxLabel` are independent `ReactNode` slots below the track. Provide either one or both; the component does not generate or format their content. Each slot uses at most 40% of the available width so the labels remain separated."},"1031":{"id":"/docs/components/range-slider-54","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#endpoint-labels-and-markers","content":"Set `markers` to render one marker for every valid step beginning at `minValue`. Markers and thumbs share the same scale and remain aligned. `minValue`, `maxValue`, and `step` determine the marker positions."},"1032":{"id":"/docs/components/range-slider-55","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#number-formatting","content":"`formatOptions` accepts `Intl.NumberFormatOptions` and controls localized output for the default value label and assistive-technology announcements."},"1033":{"id":"/docs/components/range-slider-56","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#visual-styling","content":"Pass `className` to add a class to the root element. The following custom properties are the supported styling surface:"},"1034":{"id":"/docs/components/range-slider-57","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#visual-styling","content":"`--slider-track-height`"},"1035":{"id":"/docs/components/range-slider-58","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#visual-styling","content":"`--slider-fill-height`"},"1036":{"id":"/docs/components/range-slider-59","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#visual-styling","content":"`--slider-thumb-size`"},"1037":{"id":"/docs/components/range-slider-60","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#visual-styling","content":"`--slider-marker-size`"},"1038":{"id":"/docs/components/range-slider-61","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#visual-styling","content":"`--slider-fill-color`"},"1039":{"id":"/docs/components/range-slider-62","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#visual-styling","content":"`--slider-track-color`"},"1040":{"id":"/docs/components/range-slider-63","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#visual-styling","content":"`--slider-thumb-bg`"},"1041":{"id":"/docs/components/range-slider-64","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#visual-styling","content":"`--slider-thumb-border`"},"1042":{"id":"/docs/components/range-slider-65","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#visual-styling","content":"`--slider-label-color`"},"1043":{"id":"/docs/components/range-slider-66","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#visual-styling","content":"Scope overrides to a local class so other range sliders are unaffected."},"1044":{"id":"/docs/components/range-slider-67","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#accessible-names","content":"Every range slider needs two levels of naming:"},"1045":{"id":"/docs/components/range-slider-68","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#accessible-names","content":"Use a visible `label`, or `aria-label` when equivalent visible context already exists, to name the range as a whole."},"1046":{"id":"/docs/components/range-slider-69","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#accessible-names","content":"Use the required `thumbLabels` tuple to distinguish the purpose of each thumb, for example `['Minimum price', 'Maximum price']`."},"1047":{"id":"/docs/components/range-slider-70","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#accessible-names","content":"Thumb labels should describe meaning rather than repeat the current numbers. `startName` and `endName` configure form submission; they are not accessible labels."},"1048":{"id":"/docs/components/range-slider-71","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#keyboard-interaction","content":"Each thumb follows the React Aria slider keyboard model:"},"1049":{"id":"/docs/components/range-slider-72","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#keyboard-interaction","content":"Tab and Shift+Tab move between the two thumbs and surrounding controls."},"1050":{"id":"/docs/components/range-slider-73","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#keyboard-interaction","content":"Arrow Right and Arrow Up increase the focused value by `step`."},"1051":{"id":"/docs/components/range-slider-74","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#keyboard-interaction","content":"Arrow Left and Arrow Down decrease the focused value by `step`."},"1052":{"id":"/docs/components/range-slider-75","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#keyboard-interaction","content":"Home moves the focused thumb to its permitted minimum; End moves it to its permitted maximum."},"1053":{"id":"/docs/components/range-slider-76","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#keyboard-interaction","content":"Page Up and Page Down make larger changes."},"1054":{"id":"/docs/components/range-slider-77","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#keyboard-interaction","content":"Directional behavior follows the user's locale where appropriate. Each thumb remains within the configured range."},"1055":{"id":"/docs/components/range-slider-78","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#value-announcements","content":"Use `formatOptions` so each thumb announces values in the product's unit, such as a currency or percentage. `valueLabel` is visual output and does not replace either `thumbLabels` entry."},"1056":{"id":"/docs/components/range-slider-79","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#value-announcements","content":"Markers are decorative and hidden from the accessibility tree. Do not rely on marker appearance alone to explain available choices."},"1057":{"id":"/docs/components/range-slider-80","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#instructions-required-state-and-errors","content":"Use `description` for persistent guidance that applies to the range. Set `isRequired` when a selection is required, and use `errorMessage` with the component's validation state to explain how to correct an invalid range. React Aria associates this content with the control."},"1058":{"id":"/docs/components/range-slider-81","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#disabled-state","content":"`isDisabled` prevents interaction with both thumbs and exposes the disabled state semantically. Only the slider control is visually muted; the label, endpoint labels, description, and error text remain readable."},"1059":{"id":"/docs/components/range-slider-82","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#best-practices","content":"Use `RangeSlider` when users choose exactly two related values that define a bounded interval, such as a minimum and maximum price."},"1060":{"id":"/docs/components/range-slider-83","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#best-practices","content":"Write `thumbLabels` that clearly distinguish the lower and upper purpose. Avoid generic labels such as `Value 1` and `Value 2`."},"1061":{"id":"/docs/components/range-slider-84","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#best-practices","content":"Keep the tuple in semantic order: the first value and label represent the start or minimum, and the second represent the end or maximum."},"1062":{"id":"/docs/components/range-slider-85","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#best-practices","content":"Use `startName` and `endName` when a native form must submit both values. Choose stable, unique names that match the receiving API."},"1063":{"id":"/docs/components/range-slider-86","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#best-practices","content":"Set `minValue`, `maxValue`, and `step` to meaningful product constraints. Do not expose precision users cannot understand or act on."},"1064":{"id":"/docs/components/range-slider-87","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#best-practices","content":"Show markers only for a manageable number of meaningful steps. A dense set of dots is harder to scan than a continuous track."},"1065":{"id":"/docs/components/range-slider-88","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#best-practices","content":"Use `formatOptions` consistently for the visible value and screen-reader announcement."},"1066":{"id":"/docs/components/range-slider-89","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#best-practices","content":"Use `onChange` for immediate UI feedback and `onChangeEnd` for expensive filtering, requests, or calculations."},"1067":{"id":"/docs/components/range-slider-90","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#best-practices","content":"Use a single-value control when users choose only one number. Use separate numeric fields when exact entry is more important than visually exploring a range."},"1068":{"id":"/docs/components/range-slider-91","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#the-thumbs-are-indistinguishable-to-screen-reader-users","content":"Provide two specific `thumbLabels` in start/end order. Labels such as `Minimum price` and `Maximum price` communicate purpose even before the current values are announced."},"1069":{"id":"/docs/components/range-slider-92","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#form-values-are-missing-or-use-the-wrong-keys","content":"Set `startName` and `endName` to the field names expected by the form handler. They may be provided independently, but each submitted value needs its own unique name. Remember that these props do not replace `thumbLabels`."},"1070":{"id":"/docs/components/range-slider-93","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#a-controlled-range-does-not-move","content":"The `value` tuple is the source of truth. Update it in `onChange` and preserve its `[start, end]` shape. Both entries must remain within `minValue` and `maxValue`."},"1071":{"id":"/docs/components/range-slider-94","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#values-snap-unexpectedly","content":"Verify that `step` represents the intended interval from `minValue`. Both thumbs snap to valid positions on the same configured scale."},"1072":{"id":"/docs/components/range-slider-95","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#the-final-marker-is-missing","content":"Markers begin at `minValue` and appear at complete step positions. `maxValue` receives a marker only when the range is evenly divisible by `step`."},"1073":{"id":"/docs/components/range-slider-96","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#markers-are-too-dense","content":"Increase `step` or omit `markers`. Markers are most effective when users can visually distinguish the available choices."},"1074":{"id":"/docs/components/range-slider-97","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#the-value-or-endpoint-labels-are-blank","content":"Enable the current range with `valueLabel={true}` or provide custom output. `minLabel` and `maxLabel` display only explicitly supplied content; they are not generated from the numeric bounds and are not affected by `formatOptions`."},"1075":{"id":"/docs/components/range-slider-98","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#negative-ranges-do-not-behave-as-expected","content":"Negative values are supported. Set an appropriate negative `minValue` and keep both tuple entries inside the configured bounds."},"1076":{"id":"/docs/components/range-slider-99","page_id":"/docs/components/range-slider","tags":[],"type":"text","url":"/docs/components/range-slider#the-range-configuration-is-invalid","content":"Provide finite bounds where `minValue` is less than `maxValue`, a finite `step` greater than zero, and a two-number value in semantic start/end order."},"1077":{"id":"/docs/components/segmented-controller","page_id":"/docs/components/segmented-controller","type":"page","content":"SegmentedController","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/segmented-controller"},"1078":{"id":"/docs/components/segmented-controller-0","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller","content":"A segmented controller is a linear set of two or more segments, each of which functions as a button. A segmented controller allows users to select options, switch views, or sort elements."},"1079":{"id":"/docs/components/segmented-controller-1","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#installation","content":"Installation"},"1080":{"id":"/docs/components/segmented-controller-2","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#props","content":"Props"},"1081":{"id":"/docs/components/segmented-controller-3","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#examples","content":"Examples"},"1082":{"id":"/docs/components/segmented-controller-4","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#basic","content":"Basic"},"1083":{"id":"/docs/components/segmented-controller-5","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#controlled","content":"Controlled"},"1084":{"id":"/docs/components/segmented-controller-6","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#sizes","content":"Sizes"},"1085":{"id":"/docs/components/segmented-controller-7","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#icon--text","content":"Icon + Text"},"1086":{"id":"/docs/components/segmented-controller-8","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#icon-only","content":"Icon Only"},"1087":{"id":"/docs/components/segmented-controller-9","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#overflow","content":"Overflow"},"1088":{"id":"/docs/components/segmented-controller-10","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#rtl-direction","content":"RTL Direction"},"1089":{"id":"/docs/components/segmented-controller-11","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#disabled-states","content":"Disabled States"},"1090":{"id":"/docs/components/segmented-controller-12","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#customization","content":"Customization"},"1091":{"id":"/docs/components/segmented-controller-1