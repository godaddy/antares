/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**On-demand loading**: Icons are loaded asynchronously from CDN only when needed"},"682":{"id":"/docs/components/icon-41","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Automatic caching**: Once loaded, icons are cached for optimal performance"},"683":{"id":"/docs/components/icon-42","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Flexible sizing**: Support for `width` and `height` props"},"684":{"id":"/docs/components/icon-43","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Color inheritance**: Uses `currentColor` by default for seamless theme integration"},"685":{"id":"/docs/components/icon-44","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Accessibility ready**: Built-in support for screen readers and keyboard navigation"},"686":{"id":"/docs/components/icon-45","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**TypeScript support**: Fully typed with comprehensive prop interfaces"},"687":{"id":"/docs/components/icon-46","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Bento integration**: Extends Bento Icon with additional Antares-specific features"},"688":{"id":"/docs/components/icon-47","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"The component extends `BentoIconProps` and passes through all standard HTML attributes and accessibility props to the underlying Bento Icon component. This includes:"},"689":{"id":"/docs/components/icon-48","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Accessibility**: `aria-label`, `aria-describedby`, `role`, `title`"},"690":{"id":"/docs/components/icon-49","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Events**: `onClick`, `onMouseOver`, `onFocus`, etc."},"691":{"id":"/docs/components/icon-50","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Styling**: `className`, `style`, `data-*` attributes"},"692":{"id":"/docs/components/icon-51","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Transform**: `rotate`, `flip` for icon transformations"},"693":{"id":"/docs/components/icon-52","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#size-variants","content":"Specify explicit width and height values:"},"694":{"id":"/docs/components/icon-53","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#size-variants","content":"You can use different values for width and height:"},"695":{"id":"/docs/components/icon-54","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#slots","content":"The Icon component uses Bento's slot system with the following component hierarchy and available slot override points:"},"696":{"id":"/docs/components/icon-55","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#available-slot-overrides","content":"**`icon`**: Overrides the entire BentoIcon component - affects icon loading, caching, sprite/SVG mode switching, data attributes, and the overall icon wrapper"},"697":{"id":"/docs/components/icon-56","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#available-slot-overrides","content":"**`icon.content`**: Overrides the BentoIllustration component - affects SVG transformations (rotate, flip), accessibility attributes (`role`,