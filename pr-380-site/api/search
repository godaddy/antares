rs, and panels on the composed Collapsible sections."},"47":{"id":"/docs/components/accordion-23","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"| Key                   | Action                                                        |\n| --------------------- | ------------------------------------------------------------- |\n| `Tab` / `Shift + Tab` | Move between enabled triggers and controls in expanded panels |","table":"table-0"},"48":{"id":"/docs/components/accordion-24","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"| Key               | Action                                                 |\n| ----------------- | ------------------------------------------------------ |\n| `Enter` / `Space` | Toggle the focused section; focus stays on the trigger |","table":"table-0"},"49":{"id":"/docs/components/accordion-25","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#aria","content":"Each section's trigger is a native button with `aria-expanded` and `aria-controls` linked to its panel."},"50":{"id":"/docs/components/accordion-26","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#aria","content":"Each panel is labeled by its trigger through `aria-labelledby` automatically."},"51":{"id":"/docs/components/accordion-27","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Group related sections and keep essential information visible outside the accordion."},"52":{"id":"/docs/components/accordion-28","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Use descriptive section titles and heading levels that fit the page hierarchy."},"53":{"id":"/docs/components/accordion-29","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Use multiple expansion when users need to compare information across sections."},"54":{"id":"/docs/components/accordion-30","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Keep item IDs stable when reordering or filtering data."},"55":{"id":"/docs/components/accordion-31","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Manage expansion on Accordion when sections belong to a group."},"56":{"id":"/docs/components/accordion-32","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Keep form validation and step progression in application logic."},"57":{"id":"/docs/components/accordion-33","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#controlled-state-not-updating","content":"Update `expandedKeys` from `onExpandedChange` and make sure the keys match the item IDs.\nChanging `defaultExpandedKeys` after mounting does not control expansion."},"58":{"id":"/docs/components/accordion-34","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#sections-close-when-another-opens","content":"Enable `allowsMultipleExpanded` when several sections should remain open together.\nFor a single independent section, use Collapsible without an Accordion."},"59":{"id":"/docs/components/alert","page_id":"/docs/components/alert","type":"page","content":"Alert","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/alert"},"60":{"id":"/docs/components/alert-0","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert","content":"In-page alerts are non-intrusive notifications within a webpage, providing users with timely information or feedback without disrupting their experience."},"61":{"id":"/docs/components/alert-1","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#installation","content":"Installation"},"62":{"id":"/docs/components/alert-2","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#examples","content":"Examples"},"63":{"id":"/docs/components/alert-3","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#accessibility","content":"Accessibility"},"64":{"id":"/docs/components/alert-4","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#keyboard","content":"Keyboard"},"65":{"id":"/docs/components/alert-5","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#screen-readers","content":"Screen readers"},"66":{"id":"/docs/components/alert-6","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#dismiss-button-label","content":"Dismiss button label"},"67":{"id":"/docs/components/alert-7","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#best-practices","content":"Best Practices"},"68":{"id":"/docs/components/alert-8","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#props","content":"Props"},"69":{"id":"/docs/components/alert-9","page_id":"/docs/components/alert","type":"heading","tags":[],"url":"/docs/components/alert#alert","content":"Alert"},"70":{"id":"/docs/components/alert-10","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#examples","content":"import { Meta, ArgTypes } from '@story"},"71":{"id":"/docs/components/alert-11","page_id":"/docs/components/alert","tags":[],"type":"text","url":"/docs/components/alert#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-