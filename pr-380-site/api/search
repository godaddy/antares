7","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-add"},"423":{"id":"/docs/components/chip-28","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stor"},"424":{"id":"/docs/components/chip-29","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './chip.stories.tsx';\n\n<Meta of={Stories} name=\"Overview\""},"425":{"id":"/docs/components/chip-30","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#content","content":"Use a string for a simple label. For icons or other composed content, wrap the\nvisible label in `Text` and provide `textValue` for the accessible name. See\n**Toggle Chips** and **Removable Chips** above."},"426":{"id":"/docs/components/chip-31","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#selection-and-removal","content":"`ChipGroup` owns selection and removal behavior. Use a Chip render prop for\nstate-dependent content, and `Button` with `slot=\"remove\"` together with\n`onRemove` for removable items. See **Toggle Chips** and **Removable Chips**."},"427":{"id":"/docs/components/chip-32","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#layout-and-sizing","content":"Set `size` on `ChipGroup` to keep a collection consistent. `ChipList` wraps by\ndefault and accepts layout props for custom arrangements. See **Sizes**."},"428":{"id":"/docs/components/chip-33","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#button-composition","content":"Use `ChipButton` when Chip presentation is needed without collection semantics.\nCompose it with components such as `MenuTrigger`; those components continue to\nown open state, focus, and keyboard behavior. See **Menu filter trigger**."},"429":{"id":"/docs/components/chip-34","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use `Label` or `aria-label` to name the `ChipGroup`; this names the collection,\nnot its individual Chips."},"430":{"id":"/docs/components/chip-35","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Give each Chip a visible label, `textValue`, or `aria-label`. Use `textValue`\nwhen a Chip contains icons, composed content, or a render prop."},"431":{"id":"/docs/components/chip-36","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use a descriptive group label so removal actions can be announced clearly."},"432":{"id":"/docs/components/chip-37","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Keep the visible label and the accessible value synchronized."},"433":{"id":"/docs/components/chip-38","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"`ChipButton` is a real button and exposes menu state through `MenuTrigger`; provide an accessible name when the visible content is incomplete."},"434":{"id":"/docs/components/chip-39","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep labels concise and let them truncate only when the available width requires it."},"435":{"id":"/docs/components/chip-40","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/compone