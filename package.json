{
  "name": "antares-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "clean": "pnpm nx reset && pnpm -r exec rimraf node_modules dist && pnpm exec rimraf node_modules dist",
    "test:visual": "nx run-many -t test:visual --no-tui",
    "typecheck": "nx run-many -t typecheck --no-tui",
    "test:visual:update": "nx run-many -t test:visual:update --no-tui",
    "test": "pnpm nx run-many -t test --output-style=static",
    "playwright:install": "playwright install chromium",
    "format:package": "syncpack format",
    "bundle-size:check": "node scripts/bundle-analysis.ts --check",
    "build": "nx run-many -t build --no-tui",
    "prepare": "husky",
    "changeset": "changeset",
    "release": "pnpm run build && node scripts/publish-workspaces.mjs",
    "registry:validate": "pnpm dlx shadcn@4.21.0 registry validate ./registry.json",
    "commitlint": "commitlint --edit",
    "storybook": "nx run docs:storybook --no-tui",
    "format": "biome check",
    "site": "nx run site:dev --no-tui",
    "format:fix": "biome check --write",
    "lint": "nx run-many -t lint --no-tui",
    "version": "changeset version && pnpm install --no-frozen-lockfile",
    "deps:check": "syncpack lint && knip --reporter=symbols",
    "scripts:test": "pnpm nx run scripts:test",
    "registry:build": "node scripts/build-registry.ts",
    "site:build": "nx run site:build --no-tui",
    "deps:fix": "syncpack fix",
    "bundle-size:build": "pnpm nx run-many -t bundle-size:build && node scripts/bundle-analysis.ts --aggregate"
  },
  "homepage": "https://github.com/godaddy/antares/tree/main",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "catalog:",
    "rollup-plugin-visualizer": "^7.1.1",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "@commitlint/config-conventional": "^21.2.3",
    "@changesets/get-github-info": "^0.8.0",
    "@storybook/addon-docs": "catalog:",
    "playwright": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/css-modules": "^1.0.5",
    "size-limit": "^14.2.0",
    "react": "catalog:",
    "@rollup/plugin-replace": "^6.0.3",
    "@size-limit/file": "^14.2.0",
    "@types/mdx": "^2.0.14",
    "vitest": "catalog:",
    "@nx/vitest": "catalog:",
    "@changesets/cli": "^2.31.0",
    "@vitest/browser": "catalog:",
    "yaml": "^2.9.1",
    "assume": "^2.3.0",
    "vite": "catalog:",
    "nx": "catalog:",
    "knip": "^6.44.2",
    "@nx/vite": "catalog:",
    "lint-staged": "^17.6.0",
    "@tsdown/css": "catalog:",
    "esbuild": "^0.28.1",
    "syncpack": "^15.3.3",
    "@types/dashify": "^1.0.3",
    "@biomejs/biome": "^2.6.6",
    "@commitlint/cli": "^21.2.4",
    "husky": "^9.1.7",
    "@vitest/browser-playwright": "catalog:",
    "markdownlint-cli2": "^0.24.0",
    "react-frame-component": "^5.3.2",
    "@testing-library/user-event": "^14.6.8",
    "tsdown": "catalog:",
    "rimraf": "^6.1.4",
    "react-dom": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1"
    }
  },
  "engines": {
    "node": ">=24.12",
    "pnpm": ">=12"
  },
  "lint-staged": {
    "{,!(.agents|.claude|.codex|.cursor|.opencode)/**/}*.{js,jsx,ts,tsx,mjs,cjs,json,css}": [
      "biome lint --write --error-on-warnings",
      "biome format --write"
    ],
    "{,!(.agents|.claude|.codex|.cursor|.opencode)/**/}*.{md,mdx}": [
      "markdownlint-cli2 --fix"
    ]
  },
  "packageManager": "pnpm@12.16.1"
}
