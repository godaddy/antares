l` as shown in the Remix section."},"22":{"id":"/docs-20","page_id":"/docs","tags":[],"type":"text","url":"/docs#other-bundlers","content":"Any bundler that supports CSS imports will work with Antares. If your bundler does not process CSS imports from `node_modules` by default, ensure it is configured to do so. For example, with raw webpack you may need `css-loader` configured to handle `.css` files from `node_modules`."},"23":{"id":"/docs/components/accordion","page_id":"/docs/components/accordion","type":"page","content":"Accordion","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/accordion"},"24":{"id":"/docs/components/accordion-0","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion","content":"Accordion coordinates related collapsible sections with single or multiple expansion."},"25":{"id":"/docs/components/accordion-1","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#features","content":"Features"},"26":{"id":"/docs/components/accordion-2","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#installation","content":"Installation"},"27":{"id":"/docs/components/accordion-3","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#examples","content":"Examples"},"28":{"id":"/docs/components/accordion-4","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#one-section-at-a-time","content":"One section at a time"},"29":{"id":"/docs/components/accordion-5","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#multiple-sections-open","content":"Multiple sections open"},"30":{"id":"/docs/components/accordion-6","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#controlled","content":"Controlled"},"31":{"id":"/docs/components