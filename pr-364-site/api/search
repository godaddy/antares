,"page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`role=\"radiogroup\"` on the container"},"1516":{"id":"/docs/components/radio-48","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`role=\"radio\"` on each option"},"1517":{"id":"/docs/components/radio-49","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`aria-checked` indicates selection state"},"1518":{"id":"/docs/components/radio-50","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`aria-disabled` for disabled options"},"1519":{"id":"/docs/components/radio-51","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`aria-required` when selection is required"},"1520":{"id":"/docs/components/radio-52","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#aria-support","content":"`aria-invalid` for validation errors"},"1521":{"id":"/docs/components/radio-53","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"✅ When there are 2-7 mutually exclusive options"},"1522":{"id":"/docs/components/radio-54","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"✅ When all options should be visible at once"},"1523":{"id":"/docs/components/radio-55","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"✅ When the decision is important and deserves space"},"1524":{"id":"/docs/components/radio-56","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ For more than 7 options (use Select instead)"},"1525":{"id":"/docs/components/radio-57","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ For binary yes/no choices (use Checkbox or Toggle instead)"},"1526":{"id":"/docs/components/radio-58","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#when-to-use-radio-buttons","content":"❌ When space is limited (use Select dropdown)"},"1527":{"id":"/docs/components/radio-59","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Use clear, concise labels"},"1528":{"id":"/docs/components/radio-60","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Keep labels short (1-3 words when possible)"},"1529":{"id":"/docs/components/radio-61","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Place the most common option first"},"1530":{"id":"/docs/components/radio-62","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#label-guidelines","content":"Ensure labels are descriptive without being verbose"},"1531":{"id":"/docs/components/radio-63","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio#validation","content":"Always provide clear error messages:"},"1532":{"id":"/docs/components/range-field","page_id":"/docs/components/range-field","type":"page","content":"RangeField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/range-field"},"1533":{"id":"/docs/components/range-field-0","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field","content":"RangeField lets users select one numeric value or a related set of values on a bounded scale."},"1534":{"id":"/docs/components/range-field-1","page_id":"/docs/components/range-field","type":"h