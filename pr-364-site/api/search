/components/checkbox#when-to-use-checkboxes","content":"When to Use Checkboxes"},"493":{"id":"/docs/components/checkbox-28","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#label-guidelines","content":"Label Guidelines"},"494":{"id":"/docs/components/checkbox-29","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#validation","content":"Validation"},"495":{"id":"/docs/components/checkbox-30","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#group-organization","content":"Group Organization"},"496":{"id":"/docs/components/checkbox-31","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#props","content":"Props"},"497":{"id":"/docs/components/checkbox-32","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkbox","content":"Checkbox"},"498":{"id":"/docs/components/checkbox-33","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkboxgroup","content":"CheckboxGroup"},"499":{"id":"/docs/components/checkbox-34","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkboxindicator","content":"CheckboxIndicator"},"500":{"id":"/docs/components/checkbox-35","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#default","content":"A single checkbox with a label."},"501":{"id":"/docs/components/checkbox-36","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate","content":"Checkboxes can display an indeterminate state (neither checked nor unchecked), with the use of the `isIndeterminate` prop, commonly used for \"select all\" functionality when some but not all child items are selected."},"502":{"id":"/docs/components/checkbox-37","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#checkbox-group","content":"Group multiple checkboxes together with a shared label."},"503":{"id":"/docs/components/checkbox-38","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#controlled","content":"Manage checkbox group state programmatically with controlled component pattern."},"504":{"id":"/docs/components/checkbox-39","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#horizontal-layout","content":"Display checkboxes in a horizontal row instead of vertical stack."},"505":{"id":"/docs/components/checkbox-40","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#disabled-states","content":"Individual checkboxes within a group can be disabled while others remain interactive."},"506":{"id":"/docs/components/checkbox-41","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#required-indicator","content":"Mark a checkbox group as required with visual indicator and validation."},"507":{"id":"/docs/components/checkbox-42","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#invalid-state","content":"Display error state and error message for validation feedback."},"508":{"id":"/docs/components/checkbox-43","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#customization","content":"`CheckboxGroup` is composed: write `Label`, a `Group` holding the `Checkbox` items, `Text slot=\"description\"`, and `FieldError`. The `Group` takes its axis, gap, and presentational role from the group's `orientation`, so a bare `<Group>` is all you need; pass your own `direction`/`gap` to lay the items out differently. Each `Checkbox` takes label text next to the indicator."},"509":{"id":"/docs/components/checkbox-44","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"Components automatically add data attributes for styling different states:"},"510":{"id":"/docs/components/checkbox-45","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"**CheckboxGroup Container:** `data-invalid`, `data-disabled`, `data-required`, `data-readonly`, `data-orientation`"},"511":{"id":"/docs/components/checkbox-46","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"**Checkbox:** `data-selected`, `data-indeterminate`, `data-hovered`, `data-pressed`, `data-focused`, `data-disabled`"},"512":{"id":"/docs/components/checkbox-47","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#component-customization","content":"Pass `className` or `style` to customize a checkbox field container. Use descendant data-attribute selectors to style the interactive checkbox state:"},"513":{"id":"/docs/components/checkbox-48","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate-state","content":"The `isIndeterminate` prop displays a minus icon to represent a partial selection state. This is useful for \"select all\" checkboxes when only some items in a collection are selected."},"514":{"id":"/docs/components/checkbox-49","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"CheckboxGroup supports validation states and error messages:"},"515":{"id":"/docs/components/checkbox-50","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**isRequired**: Marks the group as required with visual indicator"},"516":{"id":"/docs/components/checkbox-51","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**isInvalid**: Shows error state styling"},"517":{"id":"/docs/components/checkbox-52","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**`FieldError`**: Displays validation error text below the group"},"518":{"id":"/docs/components/checkbox-53","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#orientation","content":"Use `orientation=\"vertical\"` (default) to stack checkboxes, or `orientation=\"horizontal\"` to arrange them in a row."},"519":{"id":"/docs/components/checkbox-54","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Tab**: Moves focus to the next/previous checkbox"},"520":{"id":"/docs/components/checkbox-55","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Space**: Toggles the focused checkbox"},"521":{"id":"/docs/components/checkbox-56","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Shift + Tab**: Moves focus to the previous checkbox"},"522":{"id":"/docs/components/checkbox-57","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-disabled` for disabled checkboxes"},"523":{"id":"/docs/components/checkbox-58","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-required` when selection is required"},"524":{"id":"/docs/components/checkbox-59","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-invalid` for validation errors"},"525":{"id":"/docs/components/checkbox-60","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"Proper labeling with `aria-labelledby` and `aria-describedby`"},"526":{"id":"/docs/components/checkbox-61","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate-state-not-updating","content":"The `isIndeterminate` prop must be explicitly managed - it doesn't automatically reflect parent-child relationships:"},"527":{"id":"/docs/components/checkbox-62","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ For selecting multiple independent options"},"528":{"id":"/docs/components/checkbox-63","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ When users can select zero, one, or many items"},"529":{"id":"/docs/components/checkbox-64","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ For toggling settings or features on/off"},"530":{"id":"/docs/components/checkbox-65","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ When all available options should be visible"},"531":{"id":"/docs/components/checkbox-66","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"❌ For mutually exclusive options (use Radio instead)"},"532":{"id":"/docs/components/checkbox-67","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"❌ For simple on/off toggles without labels (use Toggle/Switch instead)"},"533":{"id":"/docs/components/checkbox-68","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Use clear, concise labels that describe what selecting the option means"},"534":