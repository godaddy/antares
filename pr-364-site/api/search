"id":"/docs/components/text-area-7","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area#default","content":"TextArea inside TextField."},"1905":{"id":"/docs/components/text-field","page_id":"/docs/components/text-field","type":"page","content":"TextField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-field"},"1906":{"id":"/docs/components/text-field-0","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field","content":"TextField is a composed single-line or multiline text input. Use it in forms for short answers (email, search, name) or longer content (comments)."},"1907":{"id":"/docs/components/text-field-1","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#features","content":"Features"},"1908":{"id":"/docs/components/text-field-2","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#installation","content":"Installation"},"1909":{"id":"/docs/components/text-field-3","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#examples","content":"Examples"},"1910":{"id":"/docs/components/text-field-4","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#default","content":"Default"},"1911":{"id":"/docs/components/text-field-5","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#controlled","content":"Controlled"},"1912":{"id":"/docs/components/text-field-6","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#invalid","content":"Invalid"},"1913":{"id":"/docs/components/text-field-7","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#disabled","content":"Disabled"},"1914":{"id":"/docs/components/text-field-8","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#adornments","content":"Adornments"},"1915":{"id":"/docs/components/text-field-9","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#multiline","content":"Multiline"},"1916":{"id":"/docs/components/text-field-10","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#sizes","content":"Sizes"},"1917":{"id":"/docs/components/text-field-11","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#controls-and-icons","content":"Controls and icons"},"1918":{"id":"/docs/components/text-field-12","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#telephone-field","content":"Telephone Field"},"1919":{"id":"/docs/components/text-field-13","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#props","content":"Props"},"1920":{"id":"/docs/components/text-field-14","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#textfield","content":"TextField"},"1921":{"id":"/docs/components/text-field-15","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Composable interior**: Compose `Label`, `Input` or `TextArea`, `Text slot=\"description\"`, and `FieldError`. Omitting `Group` leaves the control as a direct field child with box chrome. Use an explicit `Group` for controls or adornments"},"1922":{"id":"/docs/components/text-field-16","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Adornments**: Fixed text or icons before or after the input (e.g. `$`, `.00`, `px`) are composed inside `Group`, positioned by source order"},"1923":{"id":"/docs/components/text-field-17","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controls**: A `Button slot=\"control\"` beside the input is an interactive affix; it picks up field chrome from context"},"1924":{"id":"/docs/components/text-field-18","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"1925":{"id":"/docs/components/text-field-19","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Multiline**: Compose a `TextArea` instead of an `Input` for multiline entry"},"1926":{"id":"/docs/components/text-field-20","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"1927":{"id":"/docs/components/text-field-21","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Sizes**: The field is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets its label, input, description, error, and composed controls; without it, the field follows the surrounding scope. An explicit `size` on a part still wins for that part"},"1928":{"id":"/docs/components/text-field-22","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#default","content":"Minimal usage: a `Label` and an `Input`."},"1929":{"id":"/docs/components/text-field-23","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#controlled","content":"Use `value` and `onChange` for controlled state."},"1930":{"id":"/docs/components/text-field-24","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#invalid","content":"Use `isInvalid` with a `FieldError` for validation feedback."},"1931":{"id":"/docs/components/text-field-25","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#disabled","content":"Use `isDisabled` to prevent input."},"1932":{"id":"/docs/components/text-field-26","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#adornments","content":"Fixed text before and after the input, such as currency. Leading and trailing content is\ncomposed inside the `Group` and its position comes from source order."},"1933":{"id":"/docs/components/text-field-27","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#multiline","content":"Compose a `TextArea` instead of an `Input` for multiline entry."},"1934":{"id":"/docs/components/text-field-28","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#sizes","content":"`size` sets the label, input, description, and any control composed inside. Without it, the\nfield follows the surrounding size scope."},"1935":{"id":"/docs/components/text-field-29","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#controls-and-icons","content":"Put a control or an icon beside the input. A `Button slot=\"control\"` is an\ninteractive affix; static content is wrapped in a `Flex as=\"span\"` to center it and give it a gutter."},"1936":{"id":"/docs/components/text-field-30","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#telephone-field","content":"Compose a telephone number input paired with a country-code select."},"1937":{"id":"/docs/components/text-lockup","page_id":"/docs/components/text-lockup","type":"page","content":"TextLockup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-lockup"},"1938":{"id":"/docs/components/text-lockup-0","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup","content":"TextLockup stacks an eyebrow, title, and body text as one coordinated type group across six sizes."},"1939":{"id":"/docs/components/text-lockup-1","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#features","content":"Features"},"1940":{"id":"/docs/components/text-lockup-2","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#installation","content":"Installation"},"1941":{"id":"/docs/components/text-lockup-3","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#examples","content":"Examples"},"1942":{"id":"/docs/components/text-lockup-4","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#default","content":"Default"},"1943":{"id":"/docs/components/text-lockup-5","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#sizes","content":"Sizes"},"1944":{"id":"/docs/components/text-lockup-6","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#tag-eyebrow","content":"Tag Eyebrow"},"1945":{"id":"/docs/components/text-lockup-7","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#alignment","content":"Alignment"},"1946":{"id":"/docs/components/text-lockup-8","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#legible-lines","content":"Legible Lines"},"1947":{"id":"/docs/components/text-lockup-9","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#with-actions","content":"With Actions"},"1948":{"id":"/docs/components/text-lockup-10","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#customization","content":"Customization"},"1949":{"id":"/docs/components/text-lockup-11","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#accessibility","content":"Accessibility"},"1950":{"id":"/docs/components/text-lockup-12","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#best-practices","content":"Best Practices"},"1951":{"id":"/docs/components/text-lockup-13","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#props","content":"Props"},"1952":{"id":"/docs/components/text-lockup-14","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#textlockup","content":"TextLockup"},"1953":{"id":"/docs/components/text-lockup-15","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Six coordinated sizes, from a `2xl` page title down to `xs`"},"1954":{"id":"/docs/components/text-lockup-16","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"An eyebrow that takes plain text or a `Tag`, sized to match the lockup"},"1955":{"id":"/docs/components/text-lockup-17","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Slotted parts, so nested components keep their own type"},"1956":{"id":"/docs/components/text-lockup-18","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Any heading level, chosen independently of the visual size"},"1957":{"id":"/docs/components/text-lockup-19","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Start or center alignment"},"1958":{"id":"/docs/components/text-lockup-20","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"A legible line-length clamp, on by default"},"1959":{"id":"/docs/components/text-lockup-21","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#default","content":"A lockup stacks an optional eyebrow, a title and body text as one coordinated type\ngroup. You supply the parts, so the title can be any heading level and the body any\nnumber of paragraphs; `size` sets the tier for all of them at once."},"1960":{"id":"/docs/components/text-lockup-22","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#sizes","content":"`size` sets every part, each on its own role ramp. Without it, the lockup follows the size\nscope."},"1961":{"id":"/docs/components/text-lockup-23","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#tag-eyebrow","content":"The eyebrow takes either plain text or a `Tag`. Both use `slot=\"eyebrow\"`, so the two\nforms swap freely, and the lockup pairs the tag's `size` with its own."},"1962":{"id":"/docs/components/text-lockup-24","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#alignment","content":"`align` centers the parts as well as the text, so a `Tag` eyebrow stays centered too."},"1963":{"id":"/docs/components/text-lockup-25","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#legible-lines","content":"The text parts are constrained to a comfortable line length by default. Set\n`legibleLines={false}` to let them run the full width of their container, which suits a\nlockup already inside a narrow column. Both lockups below share one wide container, so the\nclamp is what makes the first one narrower."},"1964":{"id":"/docs/components/text-lockup-26","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#with-actions","content":"Because you compose the parts, anything else can sit alongside them — a call to action\nhere. Controls keep their own type: the buttons are unaffected by the lockup's `size`."},"1965":{"id":"/docs/components/text-lockup-27","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"`TextLockup` positions and type-sets its parts; you supply them. That means anything else can\nsit alongside them — a call to action, a second paragraph, an image — without the component\ngrowing a prop for it."},"1966":{"id":"/docs/components/text-lockup-28","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**Every part names its role with a slot**: `eyebrow`, `title`, `body`. Unslotted text follows\nthe lockup's tier too: a bare `Heading` takes the title tier and a bare `Text` the body tier."},"1967":{"id":"/docs/components/text-lockup-29","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The eyebrow is `slot=\"eyebrow\"`**, on either a `Text` or a `Tag`. The two forms swap\nfreely, and a `Tag` is sized to pair with the lockup."},"1968":{"id":"/docs/components/text-lockup-30","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The title is `<Heading slot=\"title\">`.** Pick the level from the document outline, not the\nvisual size: `size` handles the visuals, so `level={1}` in an `xs` lockup is perfectly valid."},"1969":{"id":"/docs/components/text-lockup-31","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The body is `<Text slot=\"body\">`**, once or as many times as the copy needs."},"1970":{"id":"/docs/components/text-lockup-32","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**An explicit prop on a child always wins** over what the lockup supplies. Pass\n`<Tag slot=\"eyebrow\" size=\"sm\">` to break the pairing, for instance."},"1971":{"id":"/docs/components/text-lockup-33","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**Controls keep the scale size.** A `Button` inside a lockup follows the surrounding\n`SizeProvider` or its own `size` prop, never the lockup's tier."},"1972":{"id":"/docs/components/text-lockup-34","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**`size` is the tier.** The eyebrow reads it on the `detail` ramp, the title on `heading`, and\nthe body on `body`, so there is no table to memorize. Without `size`, the lockup follows the\nsurrounding size scope. A tier is the same at every container width."},"1973":{"id":"/docs/components/text-lockup-35","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"Pass `className` to extend the styles, or select on `[data-align]`."},"1974":{"id":"/docs/components/text-lockup-36","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"The title carries the heading semantics. Choose `level` so the page outline stays correct\nrather than to achieve a size."},"1975":{"id":"/docs/components/text-lockup-37","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"Slots resolve against the lockup, so `slot=\"title\"` names the lockup's title, not an outer\ncontainer's. Inside a\n`Modal`, `Drawer` or `Popover`, give the dialog its own `<Heading slot=\"title\">` as a direct\nchild for the accessible name, and use the lockup for the body."},"1976":{"id":"/docs/components/text-lockup-38","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"The eyebrow is decorative in most designs. If it carries meaning, make sure the title still\nreads sensibly on its own, since screen reader users often navigate by heading."},"1977":{"id":"/docs/components/text-lockup-39","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Use one `2xl` lockup per page at most — it is the page title."},"1978":{"id":"/docs/components/text-lockup-40","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Keep `legibleLines` on for running prose. Turn it off only when the lockup already sits in a\nnarrow column, where the clamp does nothing but complicate the layout."},"1979":{"id":"/docs/components/text-lockup-41","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Prefer a `Tag` eyebrow for status or category, and plain text for a kicker or section label."},"1980":{"id":"/docs/components/text-lockup-42","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Reach for `MetricsLockup` instead when the emphasis is a single number rather than prose."},"1981":{"id":"/docs/components/text","page_id":"/docs/components/text","type":"page","content":"Text","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text"},"1982":{"id":"/docs/components/text-0","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text","content":"Body copy and supporting detail, with size, emphasis, alignment, and truncation options"},"1983":{"id":"/docs/components/text-1","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#features","content":"Features"},"1984":{"id":"/docs/components/text-2","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#installation","content":"Installation"},"1985":{"id":"/docs/components/text-3","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#examples","content":"Examples"},"1986":{"id":"/docs/components/text-4","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#default","content":"Default"},"1987":{"id":"/docs/components/text-5","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#as","content":"As"},"1988":{"id":"/docs/components/text-6","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#align","content":"Align"},"1989":{"id":"/docs/components/text-7","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#max-lines","content":"Max Lines"},"1990":{"id":"/docs/components/text-8","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#wrap","content":"Wrap"},"1991":{"id":"/docs/components/text-9","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#sizes","content":"Sizes"},"1992":{"id":"/docs/components/text-10","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#emphasis","content":"Emphasis"},"1993":{"id":"/docs/components/text-11","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#detail","content":"Detail"},"1994":{"id":"/docs/components/text-12","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#props","content":"Props"},"1995":{"id":"/docs/components/text-13","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#text","content":"Text"},"1996":{"id":"/docs/components/text-14","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#detail-1","content":"Detail"},"1997":{"id":"/docs/components/text-15","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text","content":"`Text` is body copy and `Detail` is supporting copy: captions, metadata, and hints."},"1998":{"id":"/docs/components/text-16","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`Text` applies the body role and `Detail` the detail role, each at the tier of the nearest\n`SizeProvider`, or `md` outside any scope."},"1999":{"id":"/docs/components/text-17","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"Inside a component's named part, such as a field description or a lockup body, the part sets the\ntreatment. Inside a control, the label keeps the control's type, so\n`<Button><Text>Save</Text></Button>` looks exactly like `<Button>Save</Button>`."},"2000":{"id":"/docs/components/text-18","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`size` picks a step on the component's own ramp (`xs` to `2xl`) and changes only the font size."},"2001":{"id":"/docs/components/text-19","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`emphasis` picks a feedback color and changes only the color."},"2002":{"id":"/docs/components/text-20","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"For semantic emphasis, render `as=\"strong\"` or `as=\"em\"`."},"2003":{"id":"/docs/components/text-21","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#default","content":"Basic text content."},"2004":{"id":"/docs/components/text-22","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#as","content":"Setting the `as` prop allows you to change the HTML tag of the `Text` component."},"2005":{"id":"/docs/components/text-23","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#align","content":"Setting the `align` prop allows you to change the alignment of the text. Choose from `start`, `center`, `end`, or `justify`; the logical keywords support RTL languages."},"2006":{"id":"/docs/components/text-24","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#max-lines","content":"Setting the `maxLines` prop limits the number of displayed lines using an ellipsis."},"2007":{"id":"/docs/components/text-25","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#wrap","content":"Setting the `wrap` prop controls text wrapping with values such as `wrap`, `nowrap`, `balance`, `pretty`, or `stable`."},"2008":{"id":"/docs/components/text-26","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#sizes","content":"Without `size`, text takes the scope's body tier, or `md` outside any scope. `size` picks a step\non the body ramp and changes only the font size."},"2009":{"id":"/docs/components/text-27","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#emphasis","content":"`emphasis` selects a feedback color and changes nothing else. Without it, text inherits the\nsurrounding color."},"2010":{"id":"/docs/components/text-28","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#detail","content":"`Detail` is supporting copy, such as captions and metadata, on the detail ramp. It keeps the\nsurrounding color; add `emphasis=\"passive\"` to mute it."},"2011":{"id":"/docs/components/toggle-button","page_id":"/docs/components/toggle-button","type":"page","content":"ToggleButton","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/co