ress#aria-support","content":"`aria-labelledby` associates the visible label when the `label` prop is provided"},"629":{"id":"/docs/components/circular-progress-20","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"`aria-describedby` wires the `helperText` to the progressbar for screen readers"},"630":{"id":"/docs/components/circular-progress-21","page_id":"/docs/components/circular-progress","tags":[],"type":"text","url":"/docs/components/circular-progress#aria-support","content":"The decorative SVG and output text are hidden via `aria-hidden=\"true\"`"},"631":{"id":"/docs/components/collapsible","page_id":"/docs/components/collapsible","type":"page","content":"Collapsible","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/collapsible"},"632":{"id":"/docs/components/collapsible-0","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible","content":"Collapsible reveals or hides a section of content beneath a heading."},"633":{"id":"/docs/components/collapsible-1","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#features","content":"Features"},"634":{"id":"/docs/components/collapsible-2","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#installation","content":"Installation"},"635":{"id":"/docs/components/collapsible-3","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#examples","content":"Examples"},"636":{"id":"/docs/components/collapsible-4","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#default","content":"Default"},"637":{"id":"/docs/components/collapsible-5","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#controlled","content":"Controlled"},