ents/chart/line-chart-31","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#line-styles","content":"Line Styles"},"410":{"id":"/docs/components/chart/line-chart-32","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#customization","content":"Customization"},"411":{"id":"/docs/components/chart/line-chart-33","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#data-attributes","content":"Data Attributes"},"412":{"id":"/docs/components/chart/line-chart-34","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#component-customization","content":"Component Customization"},"413":{"id":"/docs/components/chart/line-chart-35","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#accessibility","content":"Accessibility"},"414":{"id":"/docs/components/chart/line-chart-36","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#aria-support","content":"ARIA Support"},"415":{"id":"/docs/components/chart/line-chart-37","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#best-practices","content":"Best Practices"},"416":{"id":"/docs/components/chart/line-chart-38","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"When to Use LineChart"},"417":{"id":"/docs/components/chart/line-chart-39","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#troubleshooting","content":"Troubleshooting"},"418":{"id":"/docs/components/chart/line-chart-40","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#chart-not-sizing-or-empty","content":"Chart Not Sizing or Empty"},"419":{"id":"/docs/components/chart/line-chart-41","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#dates-not-displaying-correctly","content":"Dates Not Displaying Correctly"},"420":{"id":"/docs/components/chart/line-chart-42","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#tooltip-or-crosshair-not-showing","content":"Tooltip or Crosshair Not Showing"},"421":{"id":"/docs/components/chart/line-chart-43","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#props","content":"Props"},"422":{"id":"/docs/components/chart/line-chart-44","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#linechart","content":"LineChart"},"423":{"id":"/docs/components/chart/line-chart-45","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#default","content":"One line, a time-scale X axis, and almost nothing else configured - the everyday starting point. You give the chart a `series` array and it reads `x`/`y` from each point."},"424":{"id":"/docs/components/chart/line-chart-46","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#multiple-series","content":"Several lines sharing one X axis, with a legend naming each of them. Reach for this when the comparison between series is the story."},"425":{"id":"/docs/components/chart/line-chart-47","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#gridlines","content":"`xGridlines` and `yGridlines` add faint lines across the plot so it is easier to read a value back off an axis."},"426":{"id":"/docs/components/chart/line-chart-48","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#titles","content":"`xTitle` and `yTitle` label what each axis actually measures, e.g. \"Month\" and \"Temperature (°F)\"."},"427":{"id":"/docs/components/chart/line-chart-49","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#labels","content":"`xLabels` and `yLabels` toggle the tick labels on each axis. Turn them off for sparklines or when the surrounding UI already names the values."},"428":{"id":"/docs/components/chart/line-chart-50","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#ticks","content":"`xTickMarks` and `yTickMarks` draw the short lines at each tick value, which helps tie a label to its exact position on the axis."},"429":{"id":"/docs/components/chart/line-chart-51","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#baselines","content":"`xBaseline` and `yBaseline` control the main axis lines themselves. Dropping them gives a lighter, more editorial chart."},"430":{"id":"/docs/components/chart/line-chart-52","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#legend","content":"`legendPosition` puts the legend above or below the plot, or hides it with `null`. Multi-series charts get a bottom legend by default."},"431":{"id":"/docs/components/chart/line-chart-53","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#axis-and-tooltip-formatting","content":"`xTickFormat` and `yTickFormat` shape the axis labels - dates, currency, units, percentages - and the tooltip follows the same formatting."},"432":{"id":"/docs/components/chart/line-chart-54","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-accessors","content":"When your data does not use `x`/`y`, point `xAccessor` and `yAccessor` at the fields it does use (here `date` and `value`) instead of reshaping the data first."},"433":{"id":"/docs/components/chart/line-chart-55","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#missing-values","content":"A `null` Y value breaks the line instead of drawing through the gap, so missing data reads as missing rather than as a straight interpolation."},"434":{"id":"/docs/components/chart/line-chart-56","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#fixed-domain","content":"`xDomain` and `yDomain` pin the visible range. Use them to keep a fixed scale, or to keep several charts comparable."},"435":{"id":"/docs/components/chart/line-chart-57","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#nice-values","content":"`xNice` and `yNice` round the domain out to friendlier numbers (e.g. 0.2 to 1.0), so ticks land on values people expect."},"436":{"id":"/docs/components/chart/line-chart-58","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#zero-included","content":"`xZero` and `yZero` stretch the domain to include zero. Worth doing when the absolute size of the values matters, not just their movement."},"437":{"id":"/docs/components/chart/line-chart-59","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-ticks","content":"Choose the ticks yourself with `xTickValues`/`yTickValues`, or just ask for roughly how many you want with `xNumTicks`/`yNumTicks`."},"438":{"id":"/docs/components/chart/line-chart-60","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#band-padding","content":"`xPaddingOuter` and `yPaddingOuter` add breathing room at the ends of a band or point scale so the first and last values are not pinned to the edges."},"439":{"id":"/docs/components/chart/line-chart-61","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#tooltip-disabled","content":"Turn off the hover affordances entirely with `tooltip={false}`, `showCrosshair={false}`, and `showDataPoints={false}` - useful for a static or print-style chart."},"440":{"id":"/docs/components/chart/line-chart-62","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#crosshair-only","content":"Keep the vertical crosshair for orientation while hiding the tooltip and the data point glyphs."},"441":{"id":"/docs/components/chart/line-chart-63","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip-formatting","content":"`tooltipValueFormatter` shapes only the tooltip values, so you can show full currency or units there while the axis stays compact."},"442":{"id":"/docs/components/chart/line-chart-64","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#fixed-size","content":"Pass `width` and `height` to size the chart explicitly instead of letting it fill its container."},"443":{"id":"/docs/components/chart/line-chart-65","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#bitcoin-price","content":"A real time series: date formatting on the X axis, currency on the Y axis, gridlines, and a nice-rounded domain."},"444":{"id":"/docs/components/chart/line-chart-66","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#city-temperature","content":"Several cities over the same period, with a legend and a shared time axis - the multi-series case as it usually looks in a product."},"445":{"id":"/docs/components/chart/line-chart-67","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#browser-usage","content":"A categorical X axis (band scale) with several series and percentage formatting, for when the X values are names rather than numbers or dates."},"446":{"id":"/docs/components/chart/line-chart-68","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#rtl","content":"The chart follows the current layout direction, normally detected from the browser or system settings. In right-to-left it mirrors the axes and labels; this example forces RTL so you can see it in a left-to-right page."},"447":{"id":"/docs/components/chart/line-chart-69","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#color-index","content":"`colorIndex` pins each series to a palette color. Any series can use any index,\nindependently — here two pairs each share an index so an actual line and its\ndashed forecast read as the same color, distinguished only by line style."},"448":{"id":"/docs/components/chart/line-chart-70","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip","content":"`renderTooltip` lets you render a fully custom tooltip and know which curve is\nhovered. Paired series share a `colorIndex`; hovering either line shows a\ntooltip specific to that line, wrapped in the default styled popover."},"449":{"id":"/docs/components/chart/line-chart-71","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip-pair-change","content":"`renderTooltip` example combining a pair of series. Each pair shares a `colorIndex`\n(solid actual + dashed forecast); hovering either line shows the percent change of\nthe forecast against the actual for that pair, wrapped in the default styled popover."},"450":{"id":"/docs/components/chart/line-chart-72","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#custom-tooltip-period-comparison","content":"`renderTooltip` example styled as a period-over-period comparison card. Paired series\n(solid current period + dashed previous period) share a `colorIndex`; hovering either\nline shows both dated values and the percent change, wrapped in the default popover."},"451":{"id":"/docs/components/chart/line-chart-73","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#line-styles","content":"`variant` sets each series' line style — 'solid' (default), 'dashed', or\n'dotted' — useful for distinguishing actuals from forecasts or targets. The\nlegend swatch mirrors each line's style."},"452":{"id":"/docs/components/chart/line-chart-74","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#data-attributes","content":"The chart root exposes data attributes that reflect prop state for styling:"},"453":{"id":"/docs/components/chart/line-chart-75","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#data-attributes","content":"**Chart container:** `data-width`, `data-height`, `data-x-labels`, `data-y-labels`, `data-x-labels-vertical`, `data-x-baseline`, `data-y-baseline`, `data-x-tick-marks`, `data-y-tick-marks`"},"454":{"id":"/docs/components/chart/line-chart-76","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#component-customization","content":"Use the `className` prop on the chart container to add or override styles:"},"455":{"id":"/docs/components/chart/line-chart-77","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"Provide **`aria-label`** to describe the chart (e.g. \"Monthly sales revenue from January to May 2024\")."},"456":{"id":"/docs/components/chart/line-chart-78","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"Use **`desc`** for a longer description rendered in the SVG `<desc>` for screen readers."},"457":{"id":"/docs/components/chart/line-chart-79","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#aria-support","content":"The component sets ARIA attributes on interactive and structural elements as needed."},"458":{"id":"/docs/components/chart/line-chart-80","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Use for trends over time or along a continuous scale."},"459":{"id":"/docs/components/chart/line-chart-81","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Use when comparing a few series (e.g. 2-5 lines); avoid too many overlapping lines."},"460":{"id":"/docs/components/chart/line-chart-82","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#when-to-use-linechart","content":"Prefer a single chart with a legend over multiple small charts when comparing the same X range."},"461":{"id":"/docs/components/chart/line-chart-83","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#chart-not-sizing-or-empty","content":"Ensure the chart has a non-zero size. Place it in a container with explicit dimensions or use `width` and `height`:"},"462":{"id":"/docs/components/chart/line-chart-84","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#dates-not-displaying-correctly","content":"Use `xType=\"time\"` when the X-axis values are Date objects:"},"463":{"id":"/docs/components/chart/line-chart-85","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart#tooltip-or-crosshair-not-showing","content":"Ensure `tooltip`, `showCrosshair`, or `showDataPoints` are not set to `false`, and that the chart receives pointer events (e.g. no overlay blocking hover)."},"464":{"id":"/docs/components/checkbox","page_id":"/docs/components/checkbox","type":"page","content":"Checkbox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/checkbox"},"465":{"id":"/docs/components/checkbox-0","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox","content":"Accessible checkbox component for multi-select options with support for indeterminate states, validation, keyboard navigation, and flexible group layouts."},"466":{"id":"/docs/components/checkbox-1","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#installation","content":"Installation"},"467":{"id":"/docs/components/checkbox-2","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#examples","content":"Examples"},"468":{"id":"/docs/components/checkbox-3","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#default","content":"Default"},"469":{"id":"/docs/components/checkbox-4","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#indeterminate","content":"Indeterminate"},"470":{"id":"/docs/components/checkbox-5","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#checkbox-group","content":"Checkbox Group"},"471":{"id":"/docs/components/checkbox-6","page_id":"/docs/components/checkbox","type":"heading","tags":[],"url":"/docs/components/checkbox#controlled","