":"/docs/components/label-6","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#label","content":"Label"},"1042":{"id":"/docs/components/label-7","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#features","content":"Associates the visible name with the field control."},"1043":{"id":"/docs/components/label-8","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#features","content":"Applies the label treatment, medium weight, at the surrounding\n`SizeProvider` tier. `size` and `emphasis` work as on `Text`."},"1044":{"id":"/docs/components/label-9","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#features","content":"Field CSS adds the required asterisk when the field root is `isRequired`. That is not a Label prop."},"1045":{"id":"/docs/components/label-10","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#default","content":"Label names a field. The required asterisk comes from Field CSS when the root is `isRequired`."},"1046":{"id":"/docs/components/layout/box","page_id":"/docs/components/layout/box","type":"page","content":"Box","breadcrumbs":["Docs","Components","Layout"],"tags":[],"url":"/docs/components/layout/box"},"1047":{"id":"/docs/components/layout/box-0","page_id":"/docs/components/layout/box","tags":[],"type":"text","url":"/docs/components/layout/box","content":"Polymorphic layout component providing consistent spacing, elevation, rounding, and self-alignment"},"1048":{"id":"/docs/components/layout/box-1","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#installation","content":"Installation"},"1049":{"id":"/docs/components/layout/box-2","page_id":"/docs/components/layout/box","type":"heading","tags":[],"url":"/docs/components/layout/box#scale-sizes","content":"Scale Sizes"},"1050":{"id":"/docs/components/layout/