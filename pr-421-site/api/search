m '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n<Meta"},"572":{"id":"/docs/components/drop-zone-11","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n<Meta of={Stories}"},"573":{"id":"/docs/components/drop-zone-12","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n\n\n## Installation\n\n```bash\nnpm install --save @godaddy"},"574":{"id":"/docs/components/drop-zone-13","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"| Key   | Description                  |\n| ----- | ---------------------------- |\n| `Tab` | Moves focus to the drop zone |","table":"table-0"},"575":{"id":"/docs/components/drop-zone-14","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"| Key               | Description                                                      |\n| ----------------- | ---------------------------------------------------------------- |\n| `Enter` / `Space` | Opens the file picker so files can be selected without a pointer |","table":"table-0"},"576":{"id":"/docs/components/drop-zone-15","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"The drop zone renders a visually hidden `<button>` inside the container. Assistive technology discovers and announces this button as an interactive element — activating it opens the native file picker without a pointer."},"577":{"id":"/docs/components/drop-zone-16","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"The button's accessible name is built from two sources, combined in order:"},"578":{"id":"/docs/components/drop-zone-17","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"**`<Text slot=\"label\">`** — any `Text` child with `slot=\"label\"` has its `id` linked to the button via `aria-labelledby`. This is the recommended way to provide a contextual label that is also visible to sighted users."},"579":{"id":"/docs/components/drop-zone-18","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"**`aria-label`** — pass `aria-label` on the `DropZone` component to override or supplement the label (e.g. `aria-label=\"Upload profile photo\"`). When no `Text slot=\"label\"` is present and no `aria-label` is set, the button falls back to the default \"DropZone\" label provided by React Aria."},"580":{"id":"/docs/components/drop-zone-19","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Use the drop zone alongside a button-based file picker — drag-and-drop is a convenience, never the only way to upload."},"581":{"id":"/docs/components/drop-zone-20","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Replace the default text with `children` to communicate the accepted file types and size limits up front."},"582":{"id":"/docs/components/drop-zone-21","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Let the drop zone fill its container; constrain it with the surrounding layout rather than setting a fixed width on the component itself."},"583":{"id":"/docs/components/drop-zone-22","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Reflect upload state (validating, uploading, error) outside the drop zone so the target area stays clear and predictable."},"584":{"id":"/docs/components/field-error","page_id":"/docs/components/field-error","type":"page","content":"FieldError","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/field-error"},"585":{"id":"/docs/components/field-error-0","page_id":"/docs/components/field-error","tags":[],"type":"text","url":"/docs/components/field-error","content":"Validation message for a field. Renders only when the field is invalid."},"586":{"id":"/docs/components/field-error-1","page_id":"/docs/components/field-error","type":"heading","tags":[],"url":"/docs/components/field-error#features","content":"Features"},"587":{"id":"/docs/components/field-error-2","page_id":"/docs/components/field-error","type":"heading","tags":[],"url":"/docs/components/field-error#installation","content":"Installation"},"588":{"id":"/docs/components/field-error-3","page_id":"/docs/components/field-error","type":"heading","tags":[],"url":"/docs/components/field-error#examples","content":"Examples"},"589":{"id":"/docs/components/field-error-4","page_id":"/docs/components/field-error","type":"heading","tags":[],"url":"/docs/components/field-error#props","content":"Props"},"590":{"id":"/docs/components/field-error-5","page_id":"/docs/components/field-error","type":"heading","tags":[],"url":"/docs/components/field-error#fielderror","content":"FieldError"},"591":{"id":"/docs/components/field-error-6","page_id":"/docs/components/field-error","tags":[],"type":"text","url":"/docs/components/field-error#features","content":