ocs/components/accordion-15","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#troubleshooting","content":"Troubleshooting"},"373":{"id":"/docs/components/accordion-16","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#controlled-state-not-updating","content":"Controlled State Not Updating"},"374":{"id":"/docs/components/accordion-17","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#sections-close-when-another-opens","content":"Sections Close When Another Opens"},"375":{"id":"/docs/components/accordion-18","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#props","content":"Props"},"376":{"id":"/docs/components/accordion-19","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#features","content":"Single or multiple expanded sections."},"377":{"id":"/docs/components/accordion-20","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#features","content":"Controlled and uncontrolled group state."},"378":{"id":"/docs/components/accordion-21","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#features","content":"Group-level disabled state."},"379":{"id":"/docs/components/accordion-22","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#features","content":"Composable sections using Collapsible and CollapsiblePanel."},"380":{"id":"/docs/components/accordion-23","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#one-section-at-a-time","content":"Let people explore short answers one at a time."},"381":{"id":"/docs/components/accordion-24","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#multiple-sections-open","content":"Keep related answers visible together when people need to compare information."},"382":{"id":"/docs/components/accordion-25","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#controlled","content":"Coordinate expanded sections with application state in either expansion mode."},"383":{"id":"/docs/components/accordion-26","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#disabled","content":"Keep unavailable options visible and explain the reason in their label."},"384":{"id":"/docs/components/accordion-27","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#form-steps","content":"Break a single-page form into steps while keeping entered values mounted."},"385":{"id":"/docs/components/accordion-28","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#nested","content":"Nested sections keep independent state. Prefer a flatter structure when possible."},"386":{"id":"/docs/components/accordion-29","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Compose related `Collapsible` sections inside Accordion. Give each section a stable, unique `id`.\nSee the Collapsible component documentation for more information about section anatomy, panel content, and trigger styling."},"387":{"id":"/docs/components/accordion-30","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Use `defaultExpandedKeys` for initial expansion, or `expandedKeys` with `onExpandedChange` for\ncontrolled state. Keys must match the section IDs; the callback receives a `Set` of expanded keys.\nBy default, only one section can stay open. Set `allowsMultipleExpanded` to keep several open.\nBoth behaviors are shown in the examples."},"388":{"id":"/docs/components/accordion-31","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Use `className` and `style` to customize the group container. `data-disabled` reflects the group's\ndisabled state. Customize individual headings, triggers, and panels on the composed Collapsible sections."},"389":{"id":"/docs/components/accordion-32","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"Key"},"390":{"id":"/docs/components/accordion-33","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"Action"},"391":{"id":"/docs/components/accordion-34","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"`Tab` / `Shift + Tab`"},"392":{"id":"/docs/components/accordion-35","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"Move between enabled triggers and controls in expanded panels"},"393":{"id":"/docs/components/accordion-36","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"`Enter` / `Space`"},"394":{"id":"/docs/components/accordion-37","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"Toggle the focused section; focus stays on the trigger"},"395":{"id":"/docs/components/accordion-38","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#aria","content":"Each section's trigger is a native button with `aria-expanded` and `aria-controls` linked to its panel."},"396":{"id":"/docs/components/accordion-39","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#aria","content":"Each panel is labeled by its trigger through `aria-labelledby` automatically."},"397":{"id":"/docs