":[],"url":"/docs/components/collapsible#trigger-not-expanding-the-panel","content":"Trigger Not Expanding the Panel"},"402":{"id":"/docs/components/collapsible-16","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#input-values-persist-after-closing","content":"Input Values Persist After Closing"},"403":{"id":"/docs/components/collapsible-17","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#props","content":"Props"},"404":{"id":"/docs/components/collapsible-18","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#collapsible","content":"Collapsible"},"405":{"id":"/docs/components/collapsible-19","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#collapsiblepanel","content":"CollapsiblePanel"},"406":{"id":"/docs/components/collapsible-20","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Independent sections with controlled or uncontrolled expansion."},"407":{"id":"/docs/components/collapsible-21","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Composed headings, optional status icons, and flexible panel content."},"408":{"id":"/docs/components/collapsible-22","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Persistent panel content when collapsed."},"409":{"id":"/docs/components/collapsible-23","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Accessible keyboard interaction and button-to-panel relationships powered by React Aria Components."},"410":{"id":"/docs/components/collapsible-24","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#default","content":"Reveal optional details without an Accordion group."},"411":{"id":"/docs/components/collapsible-25","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#controlled","content":"Control a section from application state or an external action."},"412":{"id":"/docs/components/collapsible-26","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#with-status","content":"Pair a status icon with text so completion is understandable without the icon."},"413":{"id":"/docs/components/collapsible-27","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#disabled","content":"Keep unavailable details disabled, including when their content starts visible."},"414":{"id":"/docs/components/collapsible-28","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Place a `Heading` containing `Button slot=\"trigger\"` inside Collapsible, followed by CollapsiblePanel.\nAdd an `Icon slot=\"indicator\"` inside the button for the expansion indicator. The panel accepts text,\nlinks, forms, and other components."},"415":{"id":"/docs/components/collapsible-29","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"CollapsiblePanel provides the content spacing automatically. Use `contentProps` to customize its\ninner container with Box spacing props, a class name, or styles:"},"416":{"id":"/docs/components/collapsible-30","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `contentProps={{ padding: '0' }}` for content without padding. Props supplied directly to\nCollapsiblePanel, including `className`, `style`, and `ref`, apply to the outer panel."},"417":{"id":"/docs/components/collapsible-31","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `defaultExpanded` for initial expansion, or `isExpanded` with `onExpandedChange` for controlled\nstate. The callback receives a boolean. Use the Accordion component to coordinate several sections;\nin that composition, manage expansion through the group."},"418":{"id":"/docs/components/collapsible-32","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `className` and `style` to customize each component. Button supports string or state-based\n`className` values. Components expose these data attributes for state-based styling:"},"419":{"id":"/docs/components/collapsible-33","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"`Collapsible`: `data-expanded`, `data-disabled`, and `data-focus-visible-within`."},"420":{"id":"/docs/components/collapsible-34","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Trigger `Button`: `data-hovered`, `data-pressed`, `data-focus-visible`, and `data-disabled`."},"421":{"id":"/docs/components/collapsible-35","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"`CollapsiblePanel`: `data-focus-visible-within`."},"422":{"id":"/docs/components/collapsible-36","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"Key"},"423":{"id":"/docs/components/collapsible-37","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"Action"},"424":{"id":"/docs/components/collapsible-38","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"`Tab` / `Shift + Tab`"},"425":{"id":"/docs/components/collapsible-39","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"Move between the enabled trigger and controls in the expanded panel"},"426":{"id":"/docs/components/collapsible-40","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"`Enter` / `Space`"},"427":{"id":"/docs/components/collapsible-41","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#keyboard","content":"Toggle the section; focus stays on the trigger"},"428":{"id":"/docs/components/collapsible-42","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`Button slot=\"trigger\"` renders a native button with `aria-expanded` for its open state and\n`aria-controls` linked to the panel automatically."},"429":{"id":"/docs/components/collapsible-43","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`CollapsiblePanel` is labeled by its trigger through `aria-labelledby` automatically."},"430":{"id":"/docs/components/collapsible-44","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"`CollapsiblePanel` uses `role=\"group\"` by default. Keep it when the panel's content does not need\na navigation landmark; there is no need to set it explicitly."},"431":{"id":"/docs/components/collapsible-45","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#aria","content":"Set `role=\"region\"` on `CollapsiblePanel` when its content warrants a named landmark\nfor direct screen-reader navigation."},"432":{"id":"/docs/components/collapsible-46","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsibl