mponents/skeleton#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './skeleton.stories.tsx';\n\n<"},"1434":{"id":"/docs/components/skeleton-19","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"Every Skeleton is hidden from assistive technology, so a page with many placeholders stays quiet."},"1435":{"id":"/docs/components/skeleton-20","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"Mark the region the Skeletons fill with `role=\"status\"`, `aria-busy=\"true\"`, and an `aria-label` that describes what is loading."},"1436":{"id":"/docs/components/skeleton-21","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"Set `aria-busy` to `false`, or remove it, once the real content replaces the Skeletons."},"1437":{"id":"/docs/components/skeleton-22","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"The shimmer stops when the user prefers reduced motion, and the shape gets an outline in forced colors mode."},"1438":{"id":"/docs/components/skeleton-23","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#best-practices","content":"Approximate the final layout; a skeleton doesn't need to be pixel-perfect."},"1439":{"id":"/docs/components/skeleton-24","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#best-practices","content":"Use size presets for text and basic controls, and `aspectRatio` for images and media."},"1440":{"id":"/docs/components/skeleton-25","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#best-practices","content":"Vary the wid