ents/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#features","content":"`default`, `full`, and `none` rounding"},"1415":{"id":"/docs/components/skeleton-12","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#features","content":"A subtle shimmer that reverses in right-to-left locales and stops when reduced motion is preferred"},"1416":{"id":"/docs/components/skeleton-13","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#features","content":"Composable into text blocks, avatars, cards, and other loading patterns"},"1417":{"id":"/docs/components/skeleton-14","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/block"},"1418":{"id":"/docs/components/skeleton-15","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } fro"},"1419":{"id":"/docs/components/skeleton-16","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/r"},"1420":{"id":"/docs/components/skeleton-17","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from '"},"1421":{"id":"/docs/components/skeleton-18","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './skeleton.stories.tsx';\n\n<"},"1422":{"id":"/docs/components/skeleton-19","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"Every Skeleton is hidden from assistive technology, so a page with many placeholders stays quiet."},"1423":{"id":"/docs/components/skeleton-20","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"Mark the region the Skeletons fill with `role=\"status\"`, `aria-busy=\"true\"`, and an `aria-label` that describes what is loading."},"1424":{"id":"/docs/components/skeleton-21","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"Set `aria-busy` to `false`, or remove it, once the real content replaces the Skeletons."},"1425":{"id":"/docs/components/skeleton-22","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#accessibility","content":"The shimmer stops when the user prefers reduced motion, and the shape gets an outline in forced colors mode."},"1426":{"id":"/docs/components/skeleton-23","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#best-practices","content":"Approximate the final layout; a skeleton doesn't need to be pixel-perfect."},"1427":{"id":"/docs/components/skeleton-24","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#best-practices","content":"Use size presets for text and basic controls, and `aspectRatio` for images and media."},"1428":{"id":"/docs/components/skeleton-25","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#best-practices","content":"Vary the widths of text bars so a paragraph reads like real sentences."},"1429":{"id":"/docs/components/skeleton-26","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#best-practices","content":"Match `width` to `size` for squares, and add `full` rounding for circles."},"1430":{"id":"/docs/components/skeleton-27","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#troubleshooting","content":"If the shimmer doesn't reverse in a right-to-left app, set `dir=\"rtl\"` on `<html>` or a parent element. Skeleton follows the `dir` attribute, and a locale set only through `I18nProvider` doesn't change it."},"1431":{"id":"/docs/components/structure","page_id":"/docs/components/structure","type":"page","content":"Structure primitives","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/structure"},"1432":{"id":"/docs/components/structure-0","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"Generic structural containers for composing a component's interior."},"1433":{"id":"/docs/components/structure-1","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#hybrid-styling","content":"Hybrid styling"},"1434":{"id":"/docs/components/structure-2","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#examples","content":"Examples"},"1435":{"id":"/docs/components/structure-3","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#props","content":"Props"},"1436":{"id":"/docs/components/structure-4","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#content","content":"Content"},"1437":{"id":"/docs/components/structure-5","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#header","content":"Header"},"1438":{"id":"/docs/components/structure-6","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#footer","content":"Footer"},"1439":{"id":"/docs/components/structure-7","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#buttongroup","content":"ButtonGroup"},"1440":{"id":"/docs/components/structure-8","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#group-1","content":"Group"},"1441":{"id":"/docs/components/structure-9","page_id":"/docs/components/structure","type":"heading","tags":[],"url":"/docs/components/structure#corneractions","content":"CornerActions"},"1442":{"id":"/docs/components/structure-10","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**Shared structural containers.** These generic, layout-only components are the building blocks for composing a component's interior (a `Modal`, a card, a panel). They are semantic containers built on `Flex`, so they accept the same layout props (`direction`, `gap`, `alignItems`, `justifyContent`, `padding`, ...)."},"1443":{"id":"/docs/components/structure-11","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Content`** — the primary body region (a `<section>`, a column that grows to fill)."},"1444":{"id":"/docs/components/structure-12","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Header`** — the top region: title area and optional trailing close (a `<header>` row that spaces its contents apart)."},"1445":{"id":"/docs/components/structure-13","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Footer`** — the bottom region: secondary content and/or actions (a `<footer>` row that spaces its contents apart)."},"1446":{"id":"/docs/components/structure-14","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`ButtonGroup`** - a cluster of related actions (a wrapping row with `role=\"group\"`). Overlay parents like `Modal` adopt it with end alignment and padding."},"1447":{"id":"/docs/components/structure-15","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`Group`** — semantic grouping container for field item controls. A parent field injects the box chrome."},"1448":{"id":"/docs/components/structure-16","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure","content":"**`CornerActions`** - an always-visible structural row for actions placed at a surface corner."},"1449":{"id":"/docs/components/structure-17","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"Each container works in two modes:"},"1450":{"id":"/docs/components/structure-18","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"**Standalone** - with no parent context it renders with its own structural defaults and looks the same everywhere."},"1451":{"id":"/docs/components/structure-19","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#hybrid-styling","content":"**Adopted** - inside a parent that provides its context (e.g. `Modal`), it picks up that parent's styling and spacing automatically. Consumer props still win over the adopted defaults."},"1452":{"id":"/docs/components/structure-20","page_id":"/docs/components/structure","tags":[],"type":"text","url":"/docs/components/structure#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './structure.stories.tsx';\n\n<Meta of={Stories} name=\"Overview"},"1453":{"id":"/docs/components/switch","page_id":"/docs/components/switch","type":"page","content":"Switch","breadcrumbs":["Docs","Componen