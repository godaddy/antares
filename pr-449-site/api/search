 a known range, rendered as a semicircle arc in continuous or segmented mode."},"286":{"id":"/docs/components/chart/gauge-chart-1","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#installation","content":"Installation"},"287":{"id":"/docs/components/chart/gauge-chart-2","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#examples","content":"Examples"},"288":{"id":"/docs/components/chart/gauge-chart-3","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#troubleshooting","content":"Troubleshooting"},"289":{"id":"/docs/components/chart/gauge-chart-4","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#gauge-not-sizing-correctly","content":"Gauge Not Sizing Correctly"},"290":{"id":"/docs/components/chart/gauge-chart-5","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#value-out-of-range","content":"Value Out of Range"},"291":{"id":"/docs/components/chart/gauge-chart-6","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#props","content":"Props"},"292":{"id":"/docs/components/chart/gauge-chart-7","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#gaugechart","content":"GaugeChart"},"293":{"id":"/docs/components/chart/gauge-chart-8","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#examples","content":"import { Meta, ArgTypes } from '@s"},"294":{"id":"/docs/components/chart/gauge-chart-9","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blo"},"295":{"id":"/docs/components/chart/gauge-chart-10","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon"},"296":{"id":"/docs/components/chart/gauge-chart-11","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stori"},"297":{"id":"/docs/components/chart/gauge-chart-12","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#gauge-not-sizing-correctly","content":"The component uses `container-type: inline-size` and fills its parent width. Ensure the parent has a defined width:"},"298":{"id":"/docs/components/chart/gauge-chart-13","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#value-out-of-range","content":"Values outside the valid range are clamped silently at runtime. For continuous mode the range is 0–100; for segmented mode the range is 0 to the segment count."},"299":{"id":"/docs/components/chart/heatmap","page_id":"/docs/components/chart/heatmap","type":"page","content":"Heatmap Chart","breadcrumbs":["Docs","Components","Chart"],"tags":[],"url":"/docs/components/chart/heatmap"},"300":{"id":"/docs/components/chart/heatmap-0","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap","content":"A two-dimensional categorical chart that fills cells with discrete threshold colors, with closed-cell support and hover cross-highlighting."},"301":{"id":"/docs/components/chart/heatmap-1","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#features","content":"Features"},"302":{"id":"/docs/components/chart/heatmap-2","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#installation","content":"Installation"},"303":{"id":"/docs/components/chart/heatmap-3","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#examples","content":"Examples"},"304":{"id":"/docs/components/chart/heatmap-4","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#quick-start","content":"Quick start"},"305":{"id":"/docs/components/chart/heatmap-5","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#custom-data-shape","content":"Custom data shape"},"306":{"id":"/docs/components/chart/heatmap-6","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#sizing","content":"Sizing"},"307":{"id":"/docs/components/chart/heatmap-7","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#color-buckets","content":"Color buckets"},"308":{"id":"/docs/components/chart/heatmap-8","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#closed-cells","content":"Closed cells"},"309":{"id":"/docs/components/chart/heatmap-9","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#titles-and-descriptions","content":"Titles and descriptions"},"310":{"id":"/docs/components/chart/heatmap-10","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#composition","content":"Composition"},"311":{"id":"/docs/components/chart/heatmap-11","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#legend","content":"Legend"},"312":{"id":"/docs/components/chart/heatmap-12","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#tooltip","content":"Tooltip"},"313":{"id":"/docs/components/chart/heatmap-13","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#accessibility","content":"Accessibility"},"314":{"id":"/docs/components/chart/heatmap-14","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#props","content":"Props"},"315":{"id":"/docs/components/chart/heatmap-15","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#heatmapchart","content":"HeatmapChart"},"316":{"id":"/docs/components/chart/heatmap-16","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#heatmapplot","content":"HeatmapPlot"},"317":{"id":"/docs/components/chart/heatmap-17","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#heatmaplegend","content":"HeatmapLegend"},"318":{"id":"/docs/components/chart/heatmap-18","page_id":"/docs/components/chart/heatmap","type":"heading","tags":[],"url":"/docs/components/chart/heatmap#heatmaptooltip","content":"HeatmapTooltip"},"319":{"id":"/docs/components/chart/heatmap-19","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**Discrete color buckets**: Define threshold ranges with explicit colors — no continuous gradient"},"320":{"id":"/docs/components/chart/heatmap-20","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**Closed cells**: Set `value: null` to render a dashed-border empty rectangle for unavailable slots"},"321":{"id":"/docs/components/chart/heatmap-21","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**Hover cross-highlight**: Hovering or focusing a cell bolds the matching row and column axis labels"},"322":{"id":"/docs/components/chart/heatmap-22","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**Keyboard accessible**: Focusing a cell shows its tooltip, the same as hovering"},"323":{"id":"/docs/components/chart/heatmap-23","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**Adjustable gap**: `cellPadding` sets the gap between cells in px"},"324":{"id":"/docs/components/chart/heatmap-24","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**Sized from its rows**: Without a `height`, the chart is as tall as its rows (`minCellHeight`, default 40px, plus the `cellPadding` gap), so it needs no sized container"},"325":{"id":"/docs/components/chart/heatmap-25","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**Fills its container**: Give the chart (or its parent) a height and the rows stretch to fill it, up to `maxCellHeight`; a smaller height makes it scroll"},"326":{"id":"/docs/components/chart/heatmap-26","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**Touch-friendly**: A cell is never smaller than 40px wide or tall, the minimum tap target. `minCellSize` (default 44, the cell plus its `cellPadding` gap) and `minCellHeight` (default 40) are raised to that floor if set lower; the SVG expands and the container scrolls"},"327":{"id":"/docs/components/chart/heatmap-27","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**Sticky axes**: Row and column labels remain visible while scrolling a large grid"},"328":{"id":"/docs/components/chart/heatmap-28","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**RTL support**: Right-to-left layout with the row labels on the right (`AxisRight`)"},"329":{"id":"/docs/components/chart/heatmap-29","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**Custom tooltips**: Replace the built-in tooltip with any React node via `renderTooltip`, for example a period-over-period comparison; it is wrapped in the shared chart tooltip container"},"330":{"id":"/docs/components/chart/heatmap-30","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#features","content":"**TypeScript**: Generic `HeatmapChart<T>` — bring your own data shape with typed accessors"},"331":{"id":"/docs/components/chart/heatmap-31","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@ben"},"332":{"id":"/docs/components/chart/heatmap-32","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './heatmap.stories.tsx';\n\n\n\n## Featur"},"333":{"id":"/docs/components/chart/heatmap-33","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './heatmap.stories.tsx';\n\n\n\n## Features\n\n- **Discrete color buckets**: De"},"334":{"id":"/docs/components/chart/heatmap-34","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './heatmap.stories.tsx';\n\n\n\n## Features\n\n- **Discrete color buckets**: Define threshold ranges with exp"},"335":{"id":"/docs/components/chart/heatmap-35","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#custom-data-shape","content":"When your data type is not `HeatmapCell`, provide typed accessors:"},"336":{"id":"/docs/components/chart/heatmap-36","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#sizing","content":"Cell width fills the available width. Row height has two modes, depending on whether the chart is given a height."},"337":{"id":"/docs/components/chart/heatmap-37","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#sizing","content":"**Wrap content** (no `height`, and the parent has none): the chart is as tall as its rows. Each row is `minCellHeight` (default `40`, and never less) plus the `cellPadding` gap, with the axis and legend below. It needs no sized container, and it grows or shrinks as rows are added or removed."},"338":{"id":"/docs/components/chart/heatmap-38","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#sizing","content":"**Fixed height** (the `height` prop, or a parent with a height): `height` is the total, including the axis and legend."},"339":{"id":"/docs/components/chart/heatmap-39","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#sizing","content":"Rows stretch equally to fill the height."},"340":{"id":"/docs/components/chart/heatmap-40","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#sizing","content":"Rows never go below `minCellHeight`. When they do not fit, the chart scrolls vertically and the axis labels stay pinned."},"341":{"id":"/docs/components/chart/heatmap-41","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#sizing","content":"Set `maxCellHeight` to stop rows stretching past a size, for example a single row in a tall chart. The chart then ends after the last row, and the leftover space sits below it."},"342":{"id":"/docs/components/chart/heatmap-42","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#sizing","content":"| Setup     | Result                                                |\n| --------- | ----------------------------------------------------- |\n| No height | Rows at `minCellHeight`; chart is as tall as its rows |","table":"table-0"},"343":{"id":"/docs/components/chart/heatmap-43","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#sizing","content":"| Setup                            | Result                                      |\n| -------------------------------- | ------------------------------------------- |\n| Height larger than the rows need | Rows grow to fill it, up to `maxCellHeight` |","table":"table-0"},"344":{"id":"/docs/components/chart/heatmap-44","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#sizing","content":"| Setup                             | Result                                          |\n| --------------------------------- | ----------------------------------------------- |\n| Height smaller than the rows need | Rows stay at `minCellHeight`; the chart scrolls |","table":"table-0"},"345":{"id":"/docs/components/chart/heatmap-45","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#sizing","content":"When `maxCellHeight` leaves the chart shorter than its box, `align` chooses where it sits: `start` (default) keeps it at the top, `end` moves it to the bottom, and `center` splits the space. It has no effect when the rows fill the height."},"346":{"id":"/docs/components/chart/heatmap-46","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#color-buckets","content":"`colorBuckets` is an ordered array of `ColorBucket` values. Each cell's fill is resolved by scanning the list and returning the first bucket where `value < bucket.max`. The last bucket should have `max: null` (open-ended); a value above every `max` also uses the last bucket. `min` is informational and is not used for matching, so list the buckets in ascending order:"},"347":{"id":"/docs/components/chart/heatmap-47","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#closed-cells","content":"A cell with no value renders as a dashed-border rectangle with no fill. That covers `null`, `undefined` and `NaN` values, a row and column with no datum, and an empty `colorBuckets` list. Its aria role is `presentation` and it is removed from pointer and keyboard events. Use `closedLabel` to customize its legend entry (default: `\"No data\"`)."},"348":{"id":"/docs/components/chart/heatmap-48","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#titles-and-descriptions","content":"By default the chart renders only the grid, axes, legend and tooltip. For a title or supporting text, use the composition below, or render them in your own layout around the chart."},"349":{"id":"/docs/components/chart/heatmap-49","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#composition","content":"`HeatmapChart` works on its own, and also exposes its parts so you can arrange them:"},"350":{"id":"/docs/components/chart/heatmap-50","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#composition","content":"`HeatmapPlot`: the cells and the row and column labels"},"351":{"id":"/docs/components/chart/heatmap-51","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#composition","content":"`HeatmapLegend`: the color legend. It reads the buckets from the chart, so moving it never duplicates color logic. `label` and `closedLabel` override the chart's `colorLegendLabel` and `closedLabel`."},"352":{"id":"/docs/components/chart/heatmap-52","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#composition","content":"`HeatmapTooltip`: the hover and focus tooltip. A render function as `children` replaces its content, the same as `renderTooltip`."},"353":{"id":"/docs/components/chart/heatmap-53","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#composition","content":"With no children the chart renders `HeatmapPlot`, then `HeatmapLegend` (unless `colorLegend` is `false`), then `HeatmapTooltip`. Children replace that default entirely, so include `HeatmapPlot`, and `HeatmapTooltip` when you want tooltips. The `colorLegend` and `renderTooltip` props only configure the default; with children, place `HeatmapLegend` yourself and pass a render function to `HeatmapTooltip`. `tooltip={false}` still turns every tooltip off. The parts must be rendered inside a `HeatmapChart`. Use `aria-labelledby` on the chart to label it with a visible heading."},"354":{"id":"/docs/components/chart/heatmap-54","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#composition","content":"See the *Title above, legend in the footer* and *Legend beside the title* examples."},"355":{"id":"/docs/components/chart/heatmap-55","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#legend","content":"The legend is centered below the chart, like the other chart types. Override its text per use case:"},"356":{"id":"/docs/components/chart/heatmap-56","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#legend","content":"`colorLegendLabel`: leading label (omitted when not set)"},"357":{"id":"/docs/components/chart/heatmap-57","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#legend","content":"`closedLabel`: entry for null cells (default `\"No data\"`)"},"358":{"id":"/docs/components/chart/heatmap-58","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#legend","content":"`label` on each `ColorBucket`: one entry per bucket"},"359":{"id":"/docs/components/chart/heatmap-59","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#tooltip","content":"The built-in tooltip is the same one the bar chart uses, with its arrow. It shows one row for the hovered cell: a swatch in the cell's bucket color, `{row} · {column}`, and the value (for example `● Monday · 12pm   380`)."},"360":{"id":"/docs/components/chart/heatmap-60","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#tooltip","content":"Use `tooltipValueFormatter` to format the value, such as adding a unit:"},"361":{"id":"/docs/components/chart/heatmap-61","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#tooltip","content":"For anything else, such as a title or a period-over-period comparison, use `renderTooltip`. It receives the hovered `datum`, so any extra field on your data (like a previous value) is available. Custom content is wrapped in the shared tooltip container and, like the other charts, has no arrow:"},"362":{"id":"/docs/components/chart/heatmap-62","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#tooltip","content":"See the *Custom tooltip* example for a full comparison card."},"363":{"id":"/docs/components/chart/heatmap-63","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#accessibility","content":"The `<svg>` element gets `role=\"img\"` and the `aria-label` prop"},"364":{"id":"/docs/components/chart/heatmap-64","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#accessibility","content":"Add `desc` for a longer screen-reader description: a `<desc>` element with a unique id is injected and `aria-describedby` points to it"},"365":{"id":"/docs/components/chart/heatmap-65","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#accessibility","content":"Each colored cell has `role=\"img\"` and an `aria-label` of `\"{row}, {column}: {value}\"`"},"366":{"id":"/docs/components/chart/heatmap-66","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#accessibility","content":"The legend is a `role=\"list\"` labelled by `colorLegendLabel`, falling back to `\"Heatmap legend\"`"},"367":{"id":"/docs/components/chart/heatmap-67","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#accessibility","content":"Focusing a cell with the keyboard shows its tooltip"},"368":{"id":"/docs/components/chart/heatmap-68","page_id":"/docs/components/chart/heatmap","tags":[],"type":"text","url":"/docs/components/chart/heatmap#props","content":"`HeatmapChart` composes the three parts below. With no children it renders them in order; with children you place them yourself."},"369":{"id":"/docs/components/chart/line-cha