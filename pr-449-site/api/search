ents/icon#accessibility","content":"Accessibility"},"726":{"id":"/docs/components/icon-29","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#decorative-icons","content":"Decorative Icons"},"727":{"id":"/docs/components/icon-30","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#semantic-icons","content":"Semantic Icons"},"728":{"id":"/docs/components/icon-31","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#interactive-icons","content":"Interactive Icons"},"729":{"id":"/docs/components/icon-32","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#performance-considerations","content":"Performance Considerations"},"730":{"id":"/docs/components/icon-33","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#default-icon-loading","content":"Default Icon Loading"},"731":{"id":"/docs/components/icon-34","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#sprite-mode-optimization","content":"Sprite Mode Optimization"},"732":{"id":"/docs/components/icon-35","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#recommendations","content":"Recommendations"},"733":{"id":"/docs/components/icon-36","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#troubleshooting","content":"Troubleshooting"},"734":{"id":"/docs/components/icon-37","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#icon-not-loading","content":"Icon Not Loading"},"735":{"id":"/docs/components/icon-38","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#performance-issues","content":"Performance Issues"},"736":{"id":"/docs/components/icon-39","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon","content":"The `Icon` component provides a flexible and performant way to display SVG icons with extensive customization options. Built on top of the Bento Icon system, it features on-demand loading from a CDN, automatic caching, and enhanced props for the Antares design system."},"737":{"id":"/docs/components/icon-40","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**On-demand loading**: Icons are loaded asynchronously from CDN only when needed"},"738":{"id":"/docs/components/icon-41","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Automatic caching**: Once loaded, icons are cached for optimal performance"},"739":{"id":"/docs/components/icon-42","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Flexible sizing**: Support for `width` and `height` props"},"740":{"id":"/docs/components/icon-43","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Color inheritance**: Uses `currentColor` by default for seamless theme integration"},"741":{"id":"/docs/components/icon-44","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Accessibility ready**: Built-in support for screen readers and keyboard navigation"},"742":{"id":"/docs/components/icon-45","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**TypeScript support**: Fully typed with comprehensive prop interfaces"},"743":{"id":"/docs/components/icon-46","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Bento integration**: Extends Bento Icon with additional Antares-specific features"},"744":{"id":"/docs/components/icon-47","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"The component extends `BentoIconProps` and passes through all standard HTML attributes and accessibility props to the underlying Bento Icon component. This includes:"},"745":{"id":"/docs/components/icon-48","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Accessibility**: `aria-label`, `aria-describedby`, `role`, `title`"},"746":{"id":"/docs/components/icon-49","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Events**: `onClick`, `onMouseOver`, `onFocus`, etc."},"747":{"id":"/docs/components/icon-50","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Styling**: `className`, `style`, `data-*` attributes"},"748":{"id":"/docs/components/icon-51","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Transform**: `rotate`, `flip` for icon transformations"},"749":{"id":"/docs/components/icon-52","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#size-variants","content":"Specify explicit width and height values:"},"750":{"id":"/docs/components/icon-53","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#size-variants","content":"You can use different values for width and height:"},"751":{"id":"/docs/components/icon-54","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#slots","content":"The Icon component uses Bento's slot system with the following component hierarchy and available slot override points:"},"752":{"id":"/docs/components/icon-55","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#available-slot-overrides","content":"**`icon`**: Overrides the entire BentoIcon component - affects icon loading, caching, sprite/SVG mode switching, data attributes, and the overall icon wrapper"},"753":{"id":"/docs/components/icon-56","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#available-slot-overrides","content":"**`icon.content`**: Overrides the BentoIllustration component - affects SVG transformations (rotate, flip), accessibility attributes (`role`, `focusable`, `aria-labelledby`), viewBox calculations, and final SVG element rendering"},"754":{"id":"/docs/components/icon-57","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#available-slot-overrides","content":"For complete slot override patterns and examples, see the `@bento/slots` package documentation."},"755":{"id":"/docs/components/icon-58","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icons","content":"While the Icon component loads design system approved icons from the CDN by default, teams can introduce custom icons using the underlying Bento Icon system."},"756":{"id":"/docs/components/icon-59","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#adding-icons-synchronously","content":"Use the `set` method to add custom icons that are available immediately:"},"757":{"id":"/docs/components/icon-60","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#adding-icons-asynchronously","content":"Use the `ondemand` method to load custom icons from your own sources:"},"758":{"id":"/docs/components/icon-61","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"The following methods are exported from `@godaddy/antares` for custom icon management:"},"759":{"id":"/docs/components/icon-62","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"**`set(icons)`**: Synchronously add icons to the store"},"760":{"id":"/docs/components/icon-63","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"**`ondemand(loader)`**: Register an asynchronous icon loader (returns unregister function)"},"761":{"id":"/docs/components/icon-64","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"**`parser(svgString)`**: Parse SVG strings into React elements"},"762":{"id":"/docs/components/icon-65","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"These are re-exports of the underlying Bento Icon system methods. For complete API documentation, advanced usage patterns, and implementation details, see the `@bento/icon` and `@bento/svg-parser` package documentation."},"763":{"id":"/docs/components/icon-66","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Custom icons integrate seamlessly with all Icon component features (transformations, accessibility, sprite mode, etc.)"},"764":{"id":"/docs/components/icon-67","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Multiple `ondemand` loaders can be registered and will be called in order until one returns content"},"765":{"id":"/docs/components/icon-68","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Use the `parser` function to convert SVG strings to React elements"},"766":{"id":"/docs/components/icon-69","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Custom icons are cached automatically just like CDN icons"},"767":{"id":"/docs/components/icon-70","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#css-classes","content":"The component accepts standard `className` and `style` props:"},"768":{"id":"/docs/components/icon-71","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#css-classes","content":"**Important**: When you supply a `className`, you make a commitment to take over all styling of the component as it will remove the standard class names. Use data attributes for targeted styling instead."},"769":{"id":"/docs/components/icon-72","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"The component automatically adds data attributes for styling hooks:"},"770":{"id":"/docs/components/icon-73","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-icon`: The icon name (always present)"},"771":{"id":"/docs/components/icon-74","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-color`: Applied when color prop is set"},"772":{"id":"/docs/components/icon-75","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-loading`: Applied during icon loading from CDN"},"773":{"id":"/docs/components/icon-76","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-mode`: Applied when mode prop is set (e.g., \"sprite\")"},"774":{"id":"/docs/components/icon-77","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-flip`: Applied when flip prop is set (\"horizontal\" or \"vertical\")"},"775":{"id":"/docs/components/icon-78","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-rotate`: Applied when rotate prop is set (90, 180, or 270)"},"776":{"id":"/docs/components/icon-79","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"The component also includes accessibility attributes:"},"777":{