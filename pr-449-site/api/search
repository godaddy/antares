orts from `node_modules` by default, ensure it is configured to do so. For example, with raw webpack you may need `css-loader` configured to handle `.css` files from `node_modules`."},"28":{"id":"/docs/components/accordion","page_id":"/docs/components/accordion","type":"page","content":"Accordion","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/accordion"},"29":{"id":"/docs/components/accordion-0","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion","content":"Accordion coordinates related collapsible sections with single or multiple expansion."},"30":{"id":"/docs/components/accordion-1","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#features","content":"Features"},"31":{"id":"/docs/components/accordion-2","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#installation","content":"Installation"},"32":{"id":"/docs/components/accordion-3","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#examples","content":"Examples"},"33":{"id":"/docs/components/accordion-4","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#customization","content":"Customization"},"34":{"id":"/docs/components/accordion-5","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#accessibility","content":"Accessibility"},"35":{"id":"/docs/components/accordion-6","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#keyboard","content":"Keyboard"},"36":{"id":"/docs/components/accordion-7","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#aria","content":"ARIA"},"37":{"id":"/docs/components/accordion-8","page_id":"/docs/components/accordion","type":"heading","tags":[],"url":"/docs/components/accordion#