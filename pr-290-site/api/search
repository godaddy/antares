chart-10","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#rtl-multi-series","content":"RTL multi-series"},"1259":{"id":"/docs/components/chart/bar-chart-11","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#rtl-horizontal-multi-series","content":"RTL horizontal multi-series"},"1260":{"id":"/docs/components/chart/bar-chart-12","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#design-system-alignment","content":"Design System Alignment"},"1261":{"id":"/docs/components/chart/bar-chart-13","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#spacing-and-sizing","content":"Spacing and Sizing"},"1262":{"id":"/docs/components/chart/bar-chart-14","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#responsive-behavior","content":"Responsive Behavior"},"1263":{"id":"/docs/components/chart/bar-chart-15","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#accessibility","content":"Accessibility"},"1264":{"id":"/docs/components/chart/bar-chart-16","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#performance-considerations","content":"Performance Considerations"},"1265":{"id":"/docs/components/chart/bar-chart-17","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#rendering-strategy","content":"Rendering Strategy"},"1266":{"id":"/docs/components/chart/bar-chart-18","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#scrolling-strategy","content":"Scrolling Strategy"},"1267":{"id":"/docs/components/chart/bar-chart-19","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#recommendations","content":"Recommendations"},"1268":{"id":"/docs/components/chart/bar-chart-20","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#development-status","content":"Development Status"},"1269":{"id":"/docs/components/chart/bar-chart-21","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#troubleshooting","content":"Troubleshooting"},"1270":{"id":"/docs/components/chart/bar-chart-22","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#bars-not-showing","content":"Bars Not Showing"},"1271":{"id":"/docs/components/chart/bar-chart-23","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#tooltip-positioning-issues","content":"Tooltip Positioning Issues"},"1272":{"id":"/docs/components/chart/bar-chart-24","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#performance-issues","content":"Performance Issues"},"1273":{"id":"/docs/components/chart/bar-chart-25","page_id":"/docs/components/chart/bar-chart","type":"heading","tags":[],"url":"/docs/components/chart/bar-chart#props","content":"Props"},"1274":{"id":"/docs/components/chart/bar-chart-26","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Single and multi-series support**: Display one or multiple data series with grouped bars"},"1275":{"id":"/docs/components/chart/bar-chart-27","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Vertical and horizontal orientations**: Choose the best layout for your data and use case"},"1276":{"id":"/docs/components/chart/bar-chart-28","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Responsive behavior**: Auto-sizing with horizontal scrolling for many data points, sticky axes"},"1277":{"id":"/docs/components/chart/bar-chart-29","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Design system alignment**: 8px border radius, 12px bar width (1.5 GU), consistent spacing"},"1278":{"id":"/docs/components/chart/bar-chart-30","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Interactive tooltips**: Hover to see exact values, with smart positioning and scroll-awareness"},"1279":{"id":"/docs/components/chart/bar-chart-31","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Customizable axes**: Control gridlines, tick marks, axis titles, and tick formatting"},"1280":{"id":"/docs/components/chart/bar-chart-32","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Custom domains**: Set explicit x and y ranges for controlled scales across multiple charts"},"1281":{"id":"/docs/components/chart/bar-chart-33","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**RTL support*&#x2A;: Full right-to-left layout support for international audiences &#x2A;(in development)*"},"1282":{"id":"/docs/components/chart/bar-chart-34","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**Accessibility ready**: Keyboard navigation, screen reader support, and semantic HTML"},"1283":{"id":"/docs/components/chart/bar-chart-35","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**TypeScript support**: Fully typed with comprehensive prop interfaces"},"1284":{"id":"/docs/components/chart/bar-chart-36","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#features","content":"**VisX integration**: Leverages VisX primitives for scales, axes, shapes, and responsive layout"},"1285":{"id":"/docs/components/chart/bar-chart-37","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#default","content":"You give the chart a \\`series\\` array plus \\`xAccessor\\` and \\`yAccessor\\` so it knows which field is the category and which is the value - this is the everyday setup for one set of vertical bars."},"1286":{"id":"/docs/components/chart/bar-chart-38","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#multi-series","content":"Pass more than one entry in \\`series\\` and the bars group by category, with a legend naming each series. Use it when the comparison between series matters as much as the values themselves."},"1287":{"id":"/docs/components/chart/bar-chart-39","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#horizontal-single-series","content":"\\`orientation=\"horizontal\"\\` swaps the axes: categories run down the side and values across the bottom. Reach for it when the labels are long or the chart is really a ranking."},"1288":{"id":"/docs/components/chart/bar-chart-40","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#horizontal-multi-series","content":"Grouped bars work horizontally too. With many categories the chart scrolls vertically, which is usually easier on a phone than scrolling sideways."},"1289":{"id":"/docs/components/chart/bar-chart-41","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#custom-domain","content":"\\`xDomain\\` and \\`yDomain\\` pin down exactly which categories and value range to draw. Here category \\`F\\` has no data and still gets an empty slot, and the Y range stays \\`\\[0, 40]\\` even though the largest bar is 30 - handy when several charts need to share a scale."},"1290":{"id":"/docs/components/chart/bar-chart-42","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#formatted-tick-marks","content":"\\`xTickFormat\\` and \\`yTickFormat\\` shape the axis labels - abbreviated dates on one axis, thousands separators on the other. The functions receive the raw accessor value, so they also cover currency, units, or percentages."},"1291":{"id":"/docs/components/chart/bar-chart-43","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#rtl-multi-series","content":"The chart follows the current layout direction, which is normally detected from the browser or system settings. In right-to-left it mirrors the axes, bars, and labels; this example forces RTL so you can see it in a left-to-right page. RTL support is still being refined - axis rendering and tick spacing in particular."},"1292":{"id":"/docs/components/chart/bar-chart-44","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#rtl-horizontal-multi-series","content":"Horizontal grouped bars in a right-to-left layout: bars grow from the right edge and the category axis moves to the right side."},"1293":{"id":"/docs/components/chart/bar-chart-45","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#spacing-and-sizing","content":"**Bar width**: 12px (1.5 grid units)"},"1294":{"id":"/docs/components/chart/bar-chart-46","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#spacing-and-sizing","content":"**Bar padding** (multi-series): 4px between bars within a group"},"1295":{"id":"/docs/components/chart/bar-chart-47","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#spacing-and-sizing","content":"**Group gap**: Minimum 24px between bar groups"},"1296":{"id":"/docs/components/chart/bar-chart-48","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#spacing-and-sizing","content":"**Border radius**: 8px on all bars"},"1297":{"id":"/docs/components/chart/bar-chart-49","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#spacing-and-sizing","content":"**Margins**: 20px top/right, 60px bottom/left for axes and labels"},"1298":{"id":"/docs/components/chart/bar-chart-50","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#responsive-behavior","content":"**Auto-sizing**: Uses VisX's `useParentSize` hook to adapt to container width"},"1299":{"id":"/docs/components/chart/bar-chart-51","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#responsive-behavior","content":"**Horizontal scrolling**: When data points exceed available width, the chart becomes horizontally scrollable"},"1300":{"id":"/docs/components/chart/bar-chart-52","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#responsive-behavior","content":"**Sticky y-axis**: The y-axis remains visible during horizontal scroll"},"1301":{"id":"/docs/components/chart/bar-chart-53","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#responsive-behavior","content":"**Minimum spacing**: Group gaps never fall below 24px, triggering scroll instead"},"1302":{"id":"/docs/components/chart/bar-chart-54","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#accessibility","content":"**Keyboard navigation**: Bar groups are keyboard accessible with `tabIndex={0}` and `role=\"group\"`"},"1303":{"id":"/docs/components/chart/bar-chart-55","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#accessibility","content":"**Screen reader support**: Semantic HTML structure with proper ARIA attributes"},"1304":{"id":"/docs/components/chart/bar-chart-56","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#accessibility","content":"**Tooltips**: Show on both hover and focus for keyboard users"},"1305":{"id":"/docs/components/chart/bar-chart-57","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#rendering-strategy","content":"The component uses VisX primitives for optimal SVG rendering:"},"1306":{"id":"/docs/components/chart/bar-chart-58","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#rendering-strategy","content":"**Scales**: VisX's `scaleBand` and `scaleLinear` for efficient coordinate mapping"},"1307":{"id":"/docs/components/chart/bar-chart-59","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#rendering-strategy","content":"**Grouped rendering**: Bars are rendered in SVG `<Group>` elements for logical organization"},"1308":{"id":"/docs/components/chart/bar-chart-60","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#rendering-strategy","content":"**Responsive sizing**: `useParentSize` hook provides efficient resize detection with debouncing (15ms)"},"1309":{"id":"/docs/components/chart/bar-chart-61","page_id":"/docs/components/chart/bar-chart","tags":[],"ty