/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#accessibility","content":"The calendar grid is fully keyboard navigable and screen-reader announced"},"277":{"id":"/docs/components/date-picker-35","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#best-practices","content":"Provide a `label` (or `aria-label`) on every picker."},"278":{"id":"/docs/components/date-picker-36","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#best-practices","content":"For typed/keyboard-fast date entry far from today, use the calendar's month dropdown and year input."},"279":{"id":"/docs/components/date-picker-37","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#troubleshooting","content":"Dates not localizing? Wrap the app in `<I18nProvider locale=\"…\">`."},"280":{"id":"/docs/components/date-picker-38","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#troubleshooting","content":"Form value missing on submit? Pass a `name` — React Aria renders the hidden input."},"281":{"id":"/docs/components/date-picker-39","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#props","content":"The `DatePicker` component accepts the following props:"},"282":{"id":"/docs/components/date-picker-40","page_id":"/docs/components/date-picker","tags":[],"type":"text","url":"/docs/components/date-picker#props","content":"The `DateRangePicker` component accepts the following props:"},"283":{"id":"/docs/components/drop-zone","page_id":"/docs/components/drop-zone","type":"page","content":"DropZone","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/drop-zone"},"284":{"id":"/docs/components/drop-zone-0","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone","content":"A standalone region that accepts drag-and-drop file interactions, rendering a clearly defined target area where users can drop files."},"285":{"id":"/docs/components/drop-zone-1","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#installation","content":"Installation"},"286":{"id":"/docs/components/drop-zone-2","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#examples","content":"Examples"},"287":{"id":"/docs/components/drop-zone-3","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#default","content":"Default"},"288":{"id":"/docs/components/drop-zone-4","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#disabled","content":"Disabled"},"289":{"id":"/docs/components/drop-zone-5","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#file-upload","content":"File Upload"},"290":{"id":"/docs/components/drop-zone-6","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#drop-target-label","content":"Drop Target Label"},"291":{"id":"/docs/components/drop-zone-7","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#replace-existing-file","content":"Replace Existing File"},"292":{"id":"/docs/components/drop-zone-8","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#accessibility","content":"Accessibility"},"293":{"id":"/docs/components/drop-zone-9","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#keyboard","content":"Keyboard"},"294":{"id":"/docs/components/drop-zone-10","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#screen-readers","content":"Screen readers"},"295":{"id":"/docs/components/drop-zone-11","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#best-practices","content":"Best Practices"},"296":{"id":"/docs/components/drop-zone-12","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#props","content":"Props"},"297":{"id":"/docs/components/drop-zone-13","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#default","content":"A minimal drop zone. The `onDrop` callback receives the dropped items; use the exported `isFileDropItem` guard to narrow them to files. Wrap the instructional text in `<Text slot=\"label\">` so it labels the visually hidden drop button for screen readers."},"298":{"id":"/docs/components/drop-zone-14","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#disabled","content":"Set `isDisabled` to prevent the drop zone from accepting interactions. The zone is dimmed and the cursor indicates it is not interactive."},"299":{"id":"/docs/components/drop-zone-15","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#file-upload","content":"A reference composition combining `DropZone` with `FileTrigger` to support both click-to-browse and drag-and-drop. Use this as a starting point and adapt the accepted formats, size limit, and handlers to your product's requirements."},"300":{"id":"/docs/components/drop-zone-16","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#drop-target-label","content":"Pass a render-prop function as `children` to change the zone's content while a valid drag is active. Branching on `isDropTarget` requires no extra state. Pair it with `getDropOperation` to reject unsupported types - the label only appears when the drag is accepted."},"301":{"id":"/docs/components/drop-zone-17","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#replace-existing-file","content":"Use `children` as a render function to show different content based on the current zone state - here, swapping the default label for \"Drop to replace\" when a file is already selected and a new drag is active. The same `onDrop` handler services both the drag path and the `FileTrigger` click path, so either gesture replaces the selection."},"302":{"id":"/docs/components/drop-zone-18","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"Key"},"303":{"id":"/docs/components/drop-zone-19","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"Description"},"304":{"id":"/docs/components/drop-zone-20","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"`Tab`"},"305":{"id":"/docs/components/drop-zone-21","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"Moves focus to the drop zone"},"306":{"id":"/docs/components/drop-zone-22","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"`Enter` / `Space`"},"307":{"id":"/docs/components/drop-zone-23","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"Opens the file picker so files can be selected without a pointer"},"308":{"id":"/docs/components/drop-zone-24","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"The drop zone renders a visually hidden `<button>` inside the container. Assistive technology discovers and announces this button as an interactive element — activating it opens the native file picker without a pointer."},"309":{"id":"/docs/components/drop-zone-25","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"The button's accessible name is built from two sources, combined in order:"},"310":{"id":"/docs/components/drop-zone-26","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"**`<Text slot=\"label\">`** — any `Text` child with `slot=\"label\"` has its `id` linked to the button via `aria-labelledby`. This is the recommended way to provide a contextual label that is also visible to sighted users."},"311":{"id":"/docs/components/drop-zone-27","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"**`aria-label`** — pass `aria-label` on the `DropZone` component to override or supplement the label (e.g. `aria-label=\"Upload profile photo\"`). When no `Text slot=\"label\"` is present and no `aria-label` is set, the button falls back to the default \"DropZone\" label provided by React Aria."},"312":{"id":"/docs/components/drop-zone-28","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Use the drop zone alongside a button-based file picker — drag-and-drop is a convenience, never the only way to upload."},"313":{"id":"/docs/components/drop-zone-29","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Replace the default text with `children` to communicate the accepted file types and size limits up front."},"314":{"id":"/docs/components/drop-zone-30","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Let the drop zone fill its container; constrain it with the surrounding layout rather than setting a fixed width on the component itself."},"315":{"id":"/docs/components/drop-zone-31","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Reflect upload state (validating, uploading, error) outside the drop zone so the target area stays clear and predictable."},"316":{"id":"/docs/components/drawer","page_id":"/docs/components/drawer","type":"page","content":"Drawer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/drawer"},"317":{"id":"/docs/components/drawer-0","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer","content":"An overlay panel that slides in from a screen edge, supporting sidebar navigation and bottom sheets."},"318":{"id":"/docs/components/drawer-1","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#installation","content":"Installation"},"319":{"id":"/docs/components/drawer-2","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#examples","content":"Examples"},"320":{"id":"/docs/components/drawer-3","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#default","content":"Default"},"321":{"id":"/docs/components/drawer-4","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#bottom-sheet","content":"Bottom Sheet"},"322":{"id":"/docs/components/drawer-5","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#placements","content":"Placements"},"323":{"id":"/docs/components/drawer-6","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#nested-popover","content":"Nested Popover"},"324":{"id":"/docs/components/drawer-7","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#no-escape-dismiss","content":"No Escape Dismiss"},"325":{"id":"/docs/components/drawer-8","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#scrollable-content","content":"Scrollable content"},"326":{"id":"/docs/components/drawer-9","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#accessibility","content":"Accessibility"},"327":{"id":"/docs/components/drawer-10","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#keyboard","content":"Keyboard"},"328":{"id":"/docs/components/drawer-11","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#aria","content":"ARIA"},"329":{"id":"/docs/components/drawer-12","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#best-practices","content":"Best Practices"},"330":{"id":"/docs/components/drawer-13","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#props","content":"Props"},"331":{"id":"/docs/components/drawer-14","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer","content":"An overlay panel that slides in from a screen edge. Built on the same RAC stack as `Modal` (a\nmodal overlay with an `elevation=\"overlay\"` panel and CSS transitions), it supports sidebar\nnavigation and bottom sheets."},"332":{"id":"/docs/components/drawer-15","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer","content":"`DrawerTrigger` wraps a trigger button and a `<Drawer>`, handling open\nstate automatically."},"333":{"id":"/docs/components/drawer-16","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#default","content":"Use `<DrawerTrigger>` to wrap a trigger button and a `<Drawer>`. The drawer opens when the trigger is pressed."},"334":{"id":"/docs/components/drawer-17","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#bottom-sheet","content":"Use `placement=\"bottom\"` with controlled state for a bottom sheet pattern. Compose a\n`CloseButton` for the dismiss affordance."},"335":{"id":"/docs/components/drawer-18","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#placements","content":"The drawer slides in from whichever edge you set with `placement`."},"336":{"id":"/docs/components/drawer-19","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#nested-popover","content":"Popovers rendered inside a drawer stay open without dismissing the drawer."},"337":{"id":"/docs/components/drawer-20","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#no-escape-dismiss","content":"Use `isKeyboardDismissDisabled` to prevent the drawer from being dismissed by the escape key."},"338":{"id":"/docs/components/drawer-21","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#scrollable-content","content":"When the content is taller than the drawer, the `Content` region scrolls while the title row\nstays pinned."},"339":{"id":"/docs/components/drawer-22","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#keyboard","content":"Key"},"340":{"id":"/docs/components/drawer-23","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#keyboard","content":"Action"},"341":{"id":"/docs/components/drawer-24","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#keyboard","content":"`Escape`"},"342":{"id":"/docs/components/drawer-25","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#keyboard","content":"Close the drawer (unless `isKeyboardDismissDisabled`)"},"343":{"id":"/docs/components/drawer-26","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#keyboard","content":"`Tab`"},"344":{"id":"/docs/components/drawer-27","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#keyboard","content":"Move focus within the drawer (focus is trapped)"},"345":{"id":"/docs/components/drawer-28","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#aria","content":"`role=\"dialog\"` with `aria-modal=\"true\"` on the drawer panel (via RAC Modal)"},"346":{"id":"/docs/components/drawer-29","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#aria","content":"A `Heading slot=\"title\"` labels the dialog via `aria-labelledby`; otherwise pass `aria-label`"},"347":{"id":"/docs/components/drawer-30","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#best-practices","content":"Provide a `Heading slot=\"title\"` or an `aria-label` so the dialog has an accessible name."},"348":{"id":"/docs/components/drawer-31","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#best-practices","content":"Use `isDismissable` to allow closing via backdrop click."},"349":{"id":"/docs/components/drawer-32","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#best-practices","content":"Don't nest drawers."},"350":{"id":"/docs/components/drawer-33","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#props","content":"The `Drawer` component accepts the following props:"},"351":{"id":"/docs/components/drawer-34","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#props","content":"The `DrawerTrigger` component accepts the following props:"},"352":{"id":"/docs/components/field","page_id":"/docs/components/field","type":"page","content":"Field primitives","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/field"},"353":{"id":"/docs/components/field-0","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"Composable primitives (Field, FieldLabel, FieldGroup, FieldError) for building form fields"},"354":{"id":"/docs/components/field-1","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#usage","content":"Usage"},"355":{"id":"/docs/components/field-2","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#composition","content":"Composition"},"356":{"id":"/docs/components/field-3","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#positioning-controls-inside-the-group","content":"Positioning controls inside the group"},"357":{"id":"/docs/components/field-4","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#states","content":"States"},"358":{"id":"/docs/components/field-5","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#examples","content":"Examples"},"359":{"id":"/docs/components/field-6","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#default","content":"Default"},"360":{"id":"/docs/components/field-7","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#leading-control","content":"Leading control"},"361":{"id":"/docs/components/field-8","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#trailing-control","content":"Trailing control"},"362":{"id":"/docs/components/field-9","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#icon-accessories","content":"Icon accessories"},"363":{"id":"/docs/components/field-10","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#props","content":"Props"},"364":{"id":"/docs/components/field-11","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"**Composition primitives.** The field components (TextField, NumberField, DateField, Select, RadioGroup, CheckboxGroup) compose these internally — reach for those first. These primitives are also the building blocks for custom composite fields, e.g. an input and a select sharing one bordered box."},"365":{"id":"/docs/components/field-12","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"The field decoration is split into granular, composable pieces so the same structure is shared across every field:"},"366":{"id":"/docs/components/field-13","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"**`Field`** — stacks a field's label, control, description, and error in one consistently spaced column (pure layout — a `Flex` column with the standard field gap)."},"367":{"id":"/docs/components/field-14","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"**`FieldLabel`** — names the field and flags whether it's required (wraps React Aria `Label`, rendering an optional `*` indicator)."},"368":{"id":"/docs/components/field-15","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"**`FieldGroup`** — the bordered box that visually unites a field's controls and reflects their shared focus, disabled, and invalid state. Used only by \"boxed\" fields (TextField, NumberField, Select, DateField); presentationally it is a React Aria `Group`."},"369":{"id":"/docs/components/field-16","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"**`FieldInput`** — the single-line control the user types into (a normalized React Aria `Input` given antares spacing via `Box`)."},"370":{"id":"/docs/components/field-17","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"**`FieldTextArea`** — the multiline control the user types into (a normalized React Aria `TextArea` given antares spacing via `Box`)."},"371":{"id":"/docs/components/field-18","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"**`FieldButton`** — an actionable control placed inside the box, such as the NumberField steppers or a search submit (a click target within the group)."},"372":{"id":"/docs/components/field-19","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"**`FieldTrigger`** — a full-width value-display button inside the box that opens an overlay (used by Select and DatePicker): a value area plus a trailing icon, laid out across the group. `variant=\"select\"` is transparent and input-like; `variant=\"control\"` is a filled segment inside a shared group."},"373":{"id":"/docs/components/field-20","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"**`FieldDescription`** — helper text that explains the field; renders nothing when empty (wraps the antares `Text` with `slot=\"description\"`)."},"374":{"id":"/docs/components/field-21","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"**`FieldError`** — surfaces the field's validation messages when it is invalid, and nothing when valid (a thin wrapper over React Aria `FieldError`)."},"375":{"id":"/docs/components/field-22","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"`FieldLabel`, `FieldDescription`, and `FieldError` each render `null` when they have no content, so callers pass `label` / `description` / `errorMessage` straight through without guarding."},"376":{"id":"/docs/components/field-23","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#composition","content":"A boxed field composes the primitives inside its React Aria field wrapper. Use\n`Field as={...}` to merge the field wrapper and the layout column into a single\nelement:"},"377":{"id":"/docs/components/field-24","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#composition","content":"A field without a box (RadioGroup / CheckboxGroup) composes `Field` + `FieldLabel` + `FieldError` and omits `FieldGroup`."},"378":{"id":"/docs/components/field-25","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#composition","content":"`FieldGroup` is purely presentational — it renders the styled `Group` and holds no React Aria context. The surrounding field wires value, disabled, and validation state into its controls."},"379":{"id":"/docs/components/field-26","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#positioning-controls-inside-the-group","content":"`FieldGroup` rounds its outer corners from DOM order: the group's CSS rounds the start corners of its **first child** and the end corners of its **last child**, so controls are seamless inside and rounded only at the box edges. Author children in visual order and the rounding follows — no per-control positioning prop. A lone control (a TextField input, a Select trigger) is both first and last, so it rounds both edges. The rules are RTL-safe (they use logical `start`/`end` corners)."},"380":{"id":"/docs/components/field-27","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#states","content":"The states **disabled**, **readonly**, and **invalid** are applied by the field wrapper (e.g. TextField, NumberField, Select). The group reflects them via data attributes on the group."},"381":{"id":"/docs/components/field-28","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#states","content":"State"},"382":{"id":"/docs/components/field-29","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#states","content":"CSS Selector"},"383":{"id":"/docs/components/field-30","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#states","content":"disabled — Applied when the field wrapper is disabled."},"384":{"id":"/docs/components/field-31","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#states","content":"`[data-disabled]`"},"385":{"id":"/docs/components/field-32","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#states","content":"invalid — Applied when the field wrapper is invalid (e.g. validation failed)."},"386":{"id":"/docs/components/field-33","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#states","content":"`[data-invalid]`"},"387":{"id":"/docs/components/field-34","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#states","content":"focus — Whether an element within the group has keyboard focus (for focus-ring styling)."},"388":{"id":"/docs/components/field-35","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#states","content":"`[data-focused]`"},"389":{"id":"/docs/components/field-36","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#default","content":"Composes the presentational field primitives (Field, FieldLabel, FieldGroup,\nFieldDescription) into a minimal boxed field, showing how the group and its\nposition markers are assembled. The fill is a static placeholder - real value,\nfocus, and validation behavior is wired up by the field components (TextField,\nNumberField, Select)."},"390":{"id":"/docs/components/field-37","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#leading-control","content":"A field group with a leading control before the input area."},"391":{"id":"/docs/components/field-38","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#trailing-control","content":"A field group with an input and a trailing action control."},"392":{"id":"/docs/components/field-39","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#icon-accessories","content":"A field group with leading icon and trailing action accessories."},"393":{"id":"/docs/components/field-40","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#props","content":"The `FieldGroup` component has the following props:"},"394":{"id":"/docs/components/file-trigger","page_id":"/docs/components/file-trigger","type":"page","content":"FileTrigger","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/file-trigger"},"395":{"id":"/docs/components/file-trigger-0","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger","content":"A style-less primitive that wraps any pressable component and opens the native file picker when it is activated."},"396":{"id":"/docs/components/file-trigger-1","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#features","content":"Features"},"397":{"id":"/docs/components/file-trigger-2","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#installation","content":"Installation"},"398":{"id":"/docs/components/file-trigger-3","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#examples","content":"Examples"},"399":{"id":"/docs/components/file-trigger-4","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#default","content":"Default"},"400":{"id":"/docs/components/file-trigger-5","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#accepted-types","content":"Accepted Types"},"401":{"id":"/docs/components/file-trigger-6","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#accessibility","content":"Accessibility"},"402":{"id":"/docs/components/file-trigger-7","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#best-practices","content":"Best Practices"},"403":{"id":"/docs/components/file-trigger-8","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#props","content":"Props"},"404":{"id":"/docs/components/file-trigger-9","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Turns any pressable component (such as an Antares `Button`) into a file picker trigger."},"405":{"id":"/docs/components/file-trigger-10","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Renders a visually hidden `<input type=\"file\">` — no styling of its own."},"406":{"id":"/docs/components/file-trigger-11","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Restricts selection by MIME type, allows multiple files, directory selection, and camera capture."},"407":{"id":"/docs/components/file-trigger-12","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Resets the input value before every open, so re-selecting the same file still fires `onSelect`."},"408":{"id":"/docs/components/file-trigger-13","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#default","content":"Wrap any pressable component. Activating the child opens the native file picker; the selected files arrive in `onSelect`."},"409":{"id":"/docs/components/file-trigger-14","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#accepted-types","content":"Restrict the picker to specific MIME types with `acceptedFileTypes`, and allow more than one file with `allowsMultiple`."},"410":{"id":"/docs/components/file-trigger-15","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#accessibility","content":"`FileTrigger` adds no visuals or ARIA of its own — accessibility comes from the pressable child you provide. Use a component with an accessible name (e.g. an Antares `Button` with clear label text) so assistive technology announces the action. The underlying `<input>` is visually hidden but remains operable by keyboard through the child's press behavior."},"411":{"id":"/docs/components/file-trigger-16","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#best-practices","content":"`acceptedFileTypes` is a best-effort filter for the OS picker — always validate file type and size again in your `onSelect` handler, since it can be bypassed."},"412":{"id":"/docs/components/file-trigger-17","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#best-practices","content":"Pair `FileTrigger` with `DropZone` to offer both click-to-browse and drag-and-drop. See the DropZone \"File Upload\" example."},"413":{"id":"/docs/components/file-trigger-18","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#best-practices","content":"Keep the child a single pressable element; `FileTrigger` forwards press behavior to whatever you nest inside it."},"414":{"id":"/docs/components/icon","page_id":"/docs/components/icon","type":"page","content":"Icon","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/icon"},"415":{"id":"/docs/components/icon-0","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon","content":"Flexible SVG icon component with on-demand loading, automatic caching, and extensive customization options"},"416":{"id":"/docs/components/icon-1","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#features","content":"Features"},"417":{"id":"/docs/components/icon-2","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#installation","content":"Installation"},"418":{"id":"/docs/components/icon-3","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#props","content":"Props"},"419":{"id":"/docs/components/icon-4","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#prop-inheritance","content":"Prop Inheritance"},"420":{"id":"/docs/components/icon-5","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#basic-usage","content":"Basic Usage"},"421":{"id":"/docs/components/icon-6","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#size-variants","content":"Size Variants"},"422":{"id":"/docs/components/icon-7","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#customization","content":"Customization"},"423":{"id":"/docs/components/icon-8","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#slots","content":"Slots"},"424":{"id":"/docs/components/icon-9","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#component-hierarchy","content":"Component Hierarchy"},"425":{"id":"/docs/components/icon-10","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#available-slot-overrides","content":"Available Slot Overrides"},"426":{"id":"/docs/components/icon-11","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#custom-icons","content":"Custom Icons"},"427":{"id":"/docs/components/icon-12","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#adding-icons-synchronously","content":"Adding Icons Synchronously"},"428":{"id":"/docs/components/icon-13","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#adding-icons-asynchronously","content":"Adding Icons Asynchronously"},"429":{"id":"/docs/components/icon-14","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#custom-icon-apis","content":"Custom Icon APIs"},"430":{"id":"/docs/components/icon-15","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#notes","content":"Notes"},"431":{"id":"/docs/components/icon-16","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#styling","content":"Styling"},"432":{"id":"/docs/components/icon-17","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#css-classes","content":"CSS Classes"},"433":{"id":"/docs/components/icon-18","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#data-attributes","content":"Data Attributes"},"434":{"id":"/docs/components/icon-19","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#color-customization","content":"Color Customization"},"435":{"id":"/docs/components/icon-20","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#inherit-from-parent-default","content":"Inherit from Parent (Default)"},"436":{"id":"/docs/components/icon-21","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#explicit-colors","content":"Explicit Colors"},"437":{"id":"/docs/components/icon-22","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#icon-transformations","content":"Icon Transformations"},"438":{"id":"/docs/components/icon-23","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#rotation","content":"Rotation"},"439":{"id":"/docs/components/icon-24","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#flipping","content":"Flipping"},"440":{"id":"/docs/components/icon-25","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#loading-states","content":"Loading States"},"441":{"id":"/docs/components/icon-26","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#placeholder-content","content":"Placeholder Content"},"442":{"id":"/docs/components/icon-27","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#accessibility","content":"Accessibility"},"443":{"id":"/docs/components/icon-28","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#decorative-icons","content":"Decorative Icons"},"444":{"id":"/docs/components/icon-29","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#semantic-icons","content":"Semantic Icons"},"445":{"id":"/docs/components/icon-30","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#interactive-icons","content":"Interactive Icons"},"446":{"id":"/docs/components/icon-31","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#performance-considerations","content":"Performance Considerations"},"447":{"id":"/docs/components/icon-32","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#default-icon-loading","content":"Default Icon Loading"},"448":{"id":"/docs/components/icon-33","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#sprite-mode-optimization","content":"Sprite Mode Optimization"},"449":{"id":"/docs/components/icon-34","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#recommendations","content":"Recommendations"},"450":{"id":"/docs/components/icon-35","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#troubleshooting","content":"Troubleshooting"},"451":{"id":"/docs/components/icon-36","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#icon-not-loading","content":"Icon Not Loading"},"452":{"id":"/docs/components/icon-37","page_id":"/docs/components/icon","type":"heading","tags":[],"url":"/docs/components/icon#performance-issues","content":"Performance Issues"},"453":{"id":"/docs/components/icon-38","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon","content":"The `Icon` component provides a flexible and performant way to display SVG icons with extensive customization options. Built on top of the Bento Icon system, it features on-demand loading from a CDN, automatic caching, and enhanced props for the Antares design system."},"454":{"id":"/docs/components/icon-39","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**On-demand loading**: Icons are loaded asynchronously from CDN only when needed"},"455":{"id":"/docs/components/icon-40","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Automatic caching**: Once loaded, icons are cached for optimal performance"},"456":{"id":"/docs/components/icon-41","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Flexible sizing**: Support for `width` and `height` props"},"457":{"id":"/docs/components/icon-42","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Color inheritance**: Uses `currentColor` by default for seamless theme integration"},"458":{"id":"/docs/components/icon-43","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Accessibility ready**: Built-in support for screen readers and keyboard navigation"},"459":{"id":"/docs/components/icon-44","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**TypeScript support**: Fully typed with comprehensive prop interfaces"},"460":{"id":"/docs/components/icon-45","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#features","content":"**Bento integration**: Extends Bento Icon with additional Antares-specific features"},"461":{"id":"/docs/components/icon-46","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#props","content":"The `Icon` component accepts the following props:"},"462":{"id":"/docs/components/icon-47","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"The component extends `BentoIconProps` and passes through all standard HTML attributes and accessibility props to the underlying Bento Icon component. This includes:"},"463":{"id":"/docs/components/icon-48","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Accessibility**: `aria-label`, `aria-describedby`, `role`, `title`"},"464":{"id":"/docs/components/icon-49","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Events**: `onClick`, `onMouseOver`, `onFocus`, etc."},"465":{"id":"/docs/components/icon-50","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Styling**: `className`, `style`, `data-*` attributes"},"466":{"id":"/docs/components/icon-51","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#prop-inheritance","content":"**Transform**: `rotate`, `flip` for icon transformations"},"467":{"id":"/docs/components/icon-52","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#size-variants","content":"Specify explicit width and height values:"},"468":{"id":"/docs/components/icon-53","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#size-variants","content":"You can use different values for width and height:"},"469":{"id":"/docs/components/icon-54","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#slots","content":"The Icon component uses Bento's slot system with the following component hierarchy and available slot override points:"},"470":{"id":"/docs/components/icon-55","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#available-slot-overrides","content":"**`icon`**: Overrides the entire BentoIcon component - affects icon loading, caching, sprite/SVG mode switching, data attributes, and the overall icon wrapper"},"471":{"id":"/docs/components/icon-56","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#available-slot-overrides","content":"**`icon.content`**: Overrides the BentoIllustration component - affects SVG transformations (rotate, flip), accessibility attributes (`role`, `focusable`, `aria-labelledby`), viewBox calculations, and final SVG element rendering"},"472":{"id":"/docs/components/icon-57","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#available-slot-overrides","content":"For complete slot override patterns and examples, see the `@bento/slots` package documentation."},"473":{"id":"/docs/components/icon-58","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icons","content":"While the Icon component loads design system approved icons from the CDN by default, teams can introduce custom icons using the underlying Bento Icon system."},"474":{"id":"/docs/components/icon-59","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#adding-icons-synchronously","content":"Use the `set` method to add custom icons that are available immediately:"},"475":{"id":"/docs/components/icon-60","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#adding-icons-asynchronously","content":"Use the `ondemand` method to load custom icons from your own sources:"},"476":{"id":"/docs/components/icon-61","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"The following methods are exported from `@godaddy/antares` for custom icon management:"},"477":{"id":"/docs/components/icon-62","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"**`set(icons)`**: Synchronously add icons to the store"},"478":{"id":"/docs/components/icon-63","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"**`ondemand(loader)`**: Register an asynchronous icon loader (returns unregister function)"},"479":{"id":"/docs/components/icon-64","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"**`parser(svgString)`**: Parse SVG strings into React elements"},"480":{"id":"/docs/components/icon-65","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#custom-icon-apis","content":"These are re-exports of the underlying Bento Icon system methods. For complete API documentation, advanced usage patterns, and implementation details, see the `@bento/icon` and `@bento/svg-parser` package documentation."},"481":{"id":"/docs/components/icon-66","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Custom icons integrate seamlessly with all Icon component features (transformations, accessibility, sprite mode, etc.)"},"482":{"id":"/docs/components/icon-67","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Multiple `ondemand` loaders can be registered and will be called in order until one returns content"},"483":{"id":"/docs/components/icon-68","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Use the `parser` function to convert SVG strings to React elements"},"484":{"id":"/docs/components/icon-69","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#notes","content":"Custom icons are cached automatically just like CDN icons"},"485":{"id":"/docs/components/icon-70","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#css-classes","content":"The component accepts standard `className` and `style` props:"},"486":{"id":"/docs/components/icon-71","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#css-classes","content":"**Important**: When you supply a `className`, you make a commitment to take over all styling of the component as it will remove the standard class names. Use data attributes for targeted styling instead."},"487":{"id":"/docs/components/icon-72","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"The component automatically adds data attributes for styling hooks:"},"488":{"id":"/docs/components/icon-73","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-icon`: The icon name (always present)"},"489":{"id":"/docs/components/icon-74","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-color`: Applied when color prop is set"},"490":{"id":"/docs/components/icon-75","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-loading`: Applied during icon loading from CDN"},"491":{"id":"/docs/components/icon-76","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-mode`: Applied when mode prop is set (e.g., \"sprite\")"},"492":{"id":"/docs/components/icon-77","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-flip`: Applied when flip prop is set (\"horizontal\" or \"vertical\")"},"493":{"id":"/docs/components/icon-78","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`data-rotate`: Applied when rotate prop is set (90, 180, or 270)"},"494":{"id":"/docs/components/icon-79","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"The component also includes accessibility attributes:"},"495":{"id":"/docs/components/icon-80","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`role=\"presentation\"`: For decorative icons"},"496":{"id":"/docs/components/icon-81","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`role=\"img\"`: When title prop is provided"},"497":{"id":"/docs/components/icon-82","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#data-attributes","content":"`focusable=\"false\"`: Prevents keyboard focus"},"498":{"id":"/docs/components/icon-83","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#inherit-from-parent-default","content":"By default, icons inherit the color from their parent element via `currentColor`:"},"499":{"id":"/docs/components/icon-84","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#explicit-colors","content":"Override the color with specific values:"},"500":{"id":"/docs/components/icon-85","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#icon-transformations","content":"Transform capabilities are inherited from the Bento Illustration component. For complete transformation options and implementation details, see the `@bento/illustration` package documentation."},"501":{"id":"/docs/components/icon-86","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#rotation","content":"Rotate icons by 90-degree increments:"},"502":{"id":"/docs/components/icon-87","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#flipping","content":"Flip icons horizontally or vertically:"},"503":{"id":"/docs/components/icon-88","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#placeholder-content","content":"Provide fallback SVG content while icons load from the CDN:"},"504":{"id":"/docs/components/icon-89","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#decorative-icons","content":"For purely decorative icons, no additional attributes are needed. The icon will have `role=\"presentation\"` and be ignored by screen readers:"},"505":{"id":"/docs/components/icon-90","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#semantic-icons","content":"For icons that convey meaning, use the `title` prop. This automatically adds `role=\"img\"` and provides screen reader accessible text:"},"506":{"id":"/docs/components/icon-91","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#interactive-icons","content":"For interactive icons within buttons or links, use the `title` prop on the icon and `aria-label` on the interactive element:"},"507":{"id":"/docs/components/icon-92","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#default-icon-loading","content":"Icons are loaded on-demand from a CDN using the following process:"},"508":{"id":"/docs/components/icon-93","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#default-icon-loading","content":"**First Request**: When an icon is first encountered, it triggers an asynchronous fetch from the CDN"},"509":{"id":"/docs/components/icon-94","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#default-icon-loading","content":"**SVG Parsing**: The fetched SVG string is parsed into a React element using `@bento/svg-parser`"},"510":{"id":"/docs/components/icon-95","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#default-icon-loading","content":"**Automatic Caching**: Once loaded, the icon is cached in memory to avoid subsequent network requests"},"511":{"id":"/docs/components/icon-96","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#default-icon-loading","content":"**Full SVG Rendering**: Each icon instance renders as a complete SVG element with all path data"},"512":{"id":"/docs/components/icon-97","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#default-icon-loading","content":"This approach works well for SSR and small numbers of icons, but can lead to DOM bloat when the same icon appears many times."},"513":{"id":"/docs/components/icon-98","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"When `mode=\"sprite\"` is enabled, the component switches to a more efficient rendering strategy:"},"514":{"id":"/docs/components/icon-99","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**What happens with sprite mode:**"},"515":{"id":"/docs/components/icon-100","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**Sprite Sheet Creation**: A hidden SVG sprite sheet is automatically injected into the DOM containing symbol definitions"},"516":{"id":"/docs/components/icon-101","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**Reference Rendering**: Each icon renders as a lightweight `<use>` element that references the sprite"},"517":{"id":"/docs/components/icon-102","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**Deduplication**: Icon path data only exists once in the sprite sheet, regardless of how many times it's used"},"518":{"id":"/docs/components/icon-103","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**Client-Side Hydration**: The sprite sheet is generated and injected after hydration, causing a brief paint event"},"519":{"id":"/docs/components/icon-104","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**DOM Output:**"},"520":{"id":"/docs/components/icon-105","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**Performance Benefits:**"},"521":{"id":"/docs/components/icon-106","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**Reduced DOM Size**: Path data stored once instead of duplicated"},"522":{"id":"/docs/components/icon-107","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**Lower Memory Usage**: Especially beneficial with many repeated icons"},"523":{"id":"/docs/components/icon-108","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**Faster Rendering**: Browser optimizations for `<use>` elements"},"524":{"id":"/docs/components/icon-109","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**Trade-offs:**"},"525":{"id":"/docs/components/icon-110","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**SSR Limitation**: Sprite references render empty until client-side hydration"},"526":{"id":"/docs/components/icon-111","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#sprite-mode-optimization","content":"**Initial Flash**: Brief moment where icons appear/disappear during sprite injection"},"527":{"id":"/docs/components/icon-112","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#recommendations","content":"**Use default mode** for SSR applications or when icons appear infrequently"},"528":{"id":"/docs/components/icon-113","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#recommendations","content":"**Use sprite mode** when the same icons appear many times (navigation, lists, tables)"},"529":{"id":"/docs/components/icon-114","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#recommendations","content":"**Consider preloading** frequently used icons to reduce loading delays"},"530":{"id":"/docs/components/icon-115","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#recommendations","content":"**Provide fallback content** for critical icons to handle loading states"},"531":{"id":"/docs/components/icon-116","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#icon-not-loading","content":"If an icon fails to load:"},"532":{"id":"/docs/components/icon-117","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#icon-not-loading","content":"**Check icon name**: Ensure the icon exists in the CDN"},"533":{"id":"/docs/components/icon-118","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#icon-not-loading","content":"**Network connectivity**: Verify CDN is accessible"},"534":{"id":"/docs/components/icon-119","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#icon-not-loading","content":"**Check browser console**: Look for network errors"},"535":{"id":"/docs/components/icon-120","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#icon-not-loading","content":"**Fallback content**: Provide placeholder content for loading states"},"536":{"id":"/docs/components/icon-121","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#performance-issues","content":"For performance optimization:"},"537":{"id":"/docs/components/icon-122","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#performance-issues","content":"**Preload common icons**: Consider preloading frequently used icons"},"538":{"id":"/docs/components/icon-123","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#performance-issues","content":"**Use sprite mode**: For repeated icons, consider sprite mode which consolidates multiple icons into a single SVG sprite sheet, reducing DOM size and improving performance when the same icon appears multiple times"},"539":{"id":"/docs/components/icon-124","page_id":"/docs/components/icon","tags":[],"type":"text","url":"/docs/components/icon#performance-issues","content":"**Minimize icon sets**: Only load icons that are actually used"},"540":{"id":"/docs/components/inline-drawer","page_id":"/docs/components/inline-drawer","type":"page","content":"InlineDrawer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/inline-drawer"},"541":{"id":"/docs/components/inline-drawer-0","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer","content":"An in-flow collapsible built on RAC Disclosure. Compose a trigger and content to make an accordion or a sidebar rail."},"542":{"id":"/docs/components/inline-drawer-1","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#features","content":"Features"},"543":{"id":"/docs/components/inline-drawer-2","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#installation","content":"Installation"},"544":{"id":"/docs/components/inline-drawer-3","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#examples","content":"Examples"},"545":{"id":"/docs/components/inline-drawer-4","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#default","content":"Default"},"546":{"id":"/docs/components/inline-drawer-5","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#controlled","content":"Controlled"},"547":{"id":"/docs/components/inline-drawer-6","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#sidebar-nav","content":"Sidebar Nav"},"548":{"id":"/docs/components/inline-drawer-7","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#accessibility","content":"Accessibility"},"549":{"id":"/docs/components/inline-drawer-8","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#keyboard","content":"Keyboard"},"550":{"id":"/docs/components/inline-drawer-9","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#aria","content":"ARIA"},"551":{"id":"/docs/components/inline-drawer-10","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#best-practices","content":"Best Practices"},"552":{"id":"/docs/components/inline-drawer-11","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#props","content":"Props"},"553":{"id":"/docs/components/inline-drawer-12","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer","content":"`InlineDrawerPanel` is the collapsible content for the accordion pattern — a thin wrapper over RAC `DisclosurePanel` that hides when collapsed. The trigger is any component you slot in with `slot=\"trigger\"` — there's no dedicated trigger component."},"554":{"id":"/docs/components/inline-drawer-13","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"In-flow collapsible built on RAC Disclosure — bring your own trigger via `slot=\"trigger\"`"},"555":{"id":"/docs/components/inline-drawer-14","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Animated by default; `animate={false}` disables the transition"},"556":{"id":"/docs/components/inline-drawer-15","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"`placement` selects the collapse axis (`left`/`right` → width, `top`/`bottom` → height)"},"557":{"id":"/docs/components/inline-drawer-16","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Controlled and uncontrolled modes (`isExpanded` / `defaultExpanded` / `onExpandedChange`)"},"558":{"id":"/docs/components/inline-drawer-17","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Accordion collapse uses the browser's `hidden=\"until-found\"` for find-in-page"},"559":{"id":"/docs/components/inline-drawer-18","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"`prefers-reduced-motion` support"},"560":{"id":"/docs/components/inline-drawer-19","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#default","content":"Put a `<Button slot=\"trigger\">` and an `<InlineDrawerPanel>` inside `InlineDrawer`. The panel hides when collapsed and animates open."},"561":{"id":"/docs/components/inline-drawer-20","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#controlled","content":"Use `isExpanded` and `onExpandedChange` to drive state externally."},"562":{"id":"/docs/components/inline-drawer-21","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#sidebar-nav","content":"A rail whose content stays visible when collapsed is a composition, not a mode: drive `isExpanded` yourself, render always-visible children (no `InlineDrawerPanel`), and let `minSize`/`maxSize` size the rail. Use numeric (px) sizes so the width animates; intrinsic keywords like `min-content`/`max-content` fit the content exactly but don't animate."},"563":{"id":"/docs/components/inline-drawer-22","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Key"},"564":{"id":"/docs/components/inline-drawer-23","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Action"},"565":{"id":"/docs/components/inline-drawer-24","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"`Enter` / `Space`"},"566":{"id":"/docs/components/inline-drawer-25","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Toggle via the slotted trigger"},"567":{"id":"/docs/components/inline-drawer-26","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"`Tab`"},"568":{"id":"/docs/components/inline-drawer-27","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Move focus through the content"},"569":{"id":"/docs/components/inline-drawer-28","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#aria","content":"A `<Button slot=\"trigger\">` gets `aria-expanded` + `aria-controls` wired to the `InlineDrawerPanel` automatically (via RAC Disclosure)."},"570":{"id":"/docs/components/inline-drawer-29","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#aria","content":"For the sidebar rail, the toggle is your own control (e.g. a `ToggleButton`) — give icon-only buttons an `aria-label`, and the content stays in the DOM and accessible since nothing is hidden."},"571":{"id":"/docs/components/inline-drawer-30","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"Accordion → `Button slot=\"trigger\"` + `InlineDrawerPanel`. Sidebar rail → controlled state + always-visible children."},"572":{"id":"/docs/components/inline-drawer-31","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"For the rail, use numeric (px) `minSize`/`maxSize` so the width animates; `min-content`/`max-content` fit the content exactly but won't animate."},"573":{"id":"/docs/components/inline-drawer-32","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"`placement` does not flip in RTL; the side is decided by document/flex order."},"574":{"id":"/docs/components/inline-drawer-33","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"Don't nest InlineDrawers."},"575":{"id":"/docs/components/inline-drawer-34","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#props","content":"The `InlineDrawerPanel` component accepts the following props:"},"576":{"id":"/docs/components/listbox","page_id":"/docs/components/listbox","type":"page","content":"ListBox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/listbox"},"577":{"id":"/docs/components/listbox-0","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox","content":"ListBox is a selectable collection of items rendered inline. Use it for non-popover pickers, inline lists, or as a building block for higher-level components like Select."},"578":{"id":"/docs/components/listbox-1","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#features","content":"Features"},"579":{"id":"/docs/components/listbox-2","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#installation","content":"Installation"},"580":{"id":"/docs/components/listbox-3","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#examples","content":"Examples"},"581":{"id":"/docs/components/listbox-4","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#default","content":"Default"},"582":{"id":"/docs/components/listbox-5","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#list-box-controlled","content":"List Box Controlled"},"583":{"id":"/docs/components/listbox-6","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#list-box-multiple","content":"List Box Multiple"},"584":{"id":"/docs/components/listbox-7","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#props","content":"Props"},"585":{"id":"/docs/components/listbox-8","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Single or multiple selection**: Set `selectionMode=\"single\"` or `\"multiple\"`."},"586":{"id":"/docs/components/listbox-9","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Controlled or uncontrolled**: Use `selectedKeys` and `onSelectionChange` for controlled state, or `defaultSelectedKeys` for uncontrolled."},"587":{"id":"/docs/components/listbox-10","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Layout primitive**: `ListBox` and `ListBoxItem` accept layout props (`gap`, `padding`, etc.) — they extend `FlexOwnProps`."},"588":{"id":"/docs/components/listbox-11","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**Composes into other components**: `Select` uses `ListBox` internally; reach for `ListBox` directly when you need an inline list rather than a popover dropdown."},"589":{"id":"/docs/components/listbox-12","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"**React Aria integration**: Built on React Aria ListBox for accessibility, keyboard navigation, and typeahead."},"590":{"id":"/docs/components/listbox-13","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#features","content":"`ListBox` requires either `aria-label` or `aria-labelledby`. For a labeled, popover-style picker, prefer `Select`."},"591":{"id":"/docs/components/listbox-14","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#default","content":"Single selection with static children. Use `aria-label` to give the listbox an accessible name."},"592":{"id":"/docs/components/listbox-15","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-controlled","content":"Use `selectedKeys` and `onSelectionChange` for controlled state."},"593":{"id":"/docs/components/listbox-16","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#list-box-multiple","content":"Set `selectionMode=\"multiple\"` to allow multiple values. `selectedKeys` is a `Set<Key>` (or the literal `'all'`)."},"594":{"id":"/docs/components/listbox-17","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox#props","content":"The ListBox component accepts the following props:"},"595":{"id":"/docs/components/menu","page_id":"/docs/components/menu","type":"page","content":"Menu","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/menu"},"596":{"id":"/docs/components/menu-0","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"Accessible dropdown menu with grouping, multi-select checkbox items, leading icons, and submenus."},"597":{"id":"/docs/components/menu-1","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#features","content":"Features"},"598":{"id":"/docs/components/menu-2","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#installation","content":"Installation"},"599":{"id":"/docs/components/menu-3","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#examples","content":"Examples"},"600":{"id":"/docs/components/menu-4","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#default","content":"Default"},"601":{"id":"/docs/components/menu-5","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#controlled","content":"Controlled"},"602":{"id":"/docs/components/menu-6","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#bottom-sheet","content":"Bottom Sheet"},"603":{"id":"/docs/components/menu-7","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#groups","content":"Groups"},"604":{"id":"/docs/components/menu-8","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#multiple-selection","content":"Multiple Selection"},"605":{"id":"/docs/components/menu-9","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#rich-content-from-an-item","content":"Rich Content From an Item"},"606":{"id":"/docs/components/menu-10","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#single-selection","content":"Single Selection"},"607":{"id":"/docs/components/menu-11","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#sizes","content":"Sizes"},"608":{"id":"/docs/components/menu-12","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenu","content":"Submenu"},"609":{"id":"/docs/components/menu-13","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#accessibility","content":"Accessibility"},"610":{"id":"/docs/components/menu-14","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#best-practices","content":"Best Practices"},"611":{"id":"/docs/components/menu-15","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#props","content":"Props"},"612":{"id":"/docs/components/menu-16","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menu","content":"Menu"},"613":{"id":"/docs/components/menu-17","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menutrigger","content":"MenuTrigger"},"614":{"id":"/docs/components/menu-18","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menugroup","content":"MenuGroup"},"615":{"id":"/docs/components/menu-19","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#menuitem","content":"MenuItem"},"616":{"id":"/docs/components/menu-20","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenutrigger","content":"SubmenuTrigger"},"617":{"id":"/docs/components/menu-21","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"An accessible dropdown menu built on React Aria. It supports grouping with optional\ntitles, multi-select checkbox items, leading icons, submenus, and two sizes. It\nreuses Antares' `Popover` for the overlay and `Checkbox` indicator for selection."},"618":{"id":"/docs/components/menu-22","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Grouping with an optional title via `MenuGroup`, plus `MenuSeparator` dividers"},"619":{"id":"/docs/components/menu-23","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Multi-select groups: set `selectionMode=\"multiple\"` on a `MenuGroup` to render\nits items as checkboxes, while other groups stay plain action items"},"620":{"id":"/docs/components/menu-24","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Optional leading `icon` per item; links (`href`) and disabled items"},"621":{"id":"/docs/components/menu-25","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Submenus via `SubmenuTrigger`"},"622":{"id":"/docs/components/menu-26","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Two sizes (`sm`, `md`); set `size` explicitly on each submenu `Menu`"},"623":{"id":"/docs/components/menu-27","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#features","content":"Usable anchored to a trigger or standalone (e.g. inside a bottom-sheet `Drawer`)"},"624":{"id":"/docs/components/menu-28","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#default","content":"A trigger with plain action items."},"625":{"id":"/docs/components/menu-29","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#controlled","content":"`MenuTrigger` exposes its open state via `isOpen`/`onOpenChange`,\nwhich can be used to drive the rotation of a chevron icon."},"626":{"id":"/docs/components/menu-30","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#bottom-sheet","content":"On small screens a menu often reads better as a bottom sheet than an anchored\npopover. Since `Menu` works standalone, drop it into a bottom `Drawer`."},"627":{"id":"/docs/components/menu-31","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#groups","content":"Labeled groups separated by dividers, a multi-select checkbox group mixed with\nplain action groups, leading icons, a disabled item, and a link."},"628":{"id":"/docs/components/menu-32","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#multiple-selection","content":"A `MenuGroup` with `selectionMode=\"multiple\"` renders its items as checkboxes.\nDrive the checked items with `selectedKeys` + `onSelectionChange` or\nseed them uncontrolled with `defaultSelectedKeys`. Keys correspond to each\n`MenuItem`'s `id`."},"629":{"id":"/docs/components/menu-33","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#rich-content-from-an-item","content":"A `Menu` is a collection, so it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger` children. Rich content inside a `Menu`\nor submenu is not supported. To show a `Calendar`, let the item close the\nmenu from `onAction` and open a separate `Popover` anchored to the trigger\nwith `triggerRef`."},"630":{"id":"/docs/components/menu-34","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#single-selection","content":"A `MenuGroup` with `selectionMode=\"single\"` lets one item be selected at a time.\nDrive it with `selectedKeys` + `onSelectionChange` or seed it uncontrolled with\n`defaultSelectedKeys`. Keys correspond to each `MenuItem`'s `id`."},"631":{"id":"/docs/components/menu-35","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#sizes","content":"`size` controls item density. Shown here as two standalone menus so both\nsizes are visible at once; in practice you set `size` on the `Menu` inside a\n`MenuTrigger`."},"632":{"id":"/docs/components/menu-36","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#submenu","content":"Nested menus via `SubmenuTrigger`."},"633":{"id":"/docs/components/menu-37","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Space/Enter**: activate an item; **Escape**: close"},"634":{"id":"/docs/components/menu-38","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Up/Down**: move between items; **Home/End**: first/last"},"635":{"id":"/docs/components/menu-39","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Arrow Right/Left**: open/close a submenu"},"636":{"id":"/docs/components/menu-40","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"**Type to select**: jump to a matching item (string labels are used as `textValue`)"},"637":{"id":"/docs/components/menu-41","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#accessibility","content":"Multi-select items use RAC's `menuitemcheckbox` role; the checkbox indicator is\ndecorative (`aria-hidden`) and the item owns interaction"},"638":{"id":"/docs/components/menu-42","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Give each selectable `MenuItem` a stable `id`, and provide the `Menu` an\n`aria-label` when there is no visible label."},"639":{"id":"/docs/components/menu-43","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Use a leading `icon` for recognition, not as the only label - keep a text label."},"640":{"id":"/docs/components/menu-44","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"Reserve checkbox groups for multi-select; use plain groups for one-shot actions."},"641":{"id":"/docs/components/menu-45","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#best-practices","content":"A `Menu` is a collection: it only renders `MenuItem`, `MenuGroup`,\n`MenuSeparator`, and `SubmenuTrigger`. For rich content (a `Calendar`, a form),\nclose the menu from `onAction` and open a separate `Popover` anchored with\n`triggerRef` instead of putting it in a submenu."},"642":{"id":"/docs/components/modal","page_id":"/docs/components/modal","type":"page","content":"Modal","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/modal"},"643":{"id":"/docs/components/modal-0","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"The Modal component presents a dialog window over the page that focuses the user's attention on a single task or piece of information."},"644":{"id":"/docs/components/modal-1","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#installation","content":"Installation"},"645":{"id":"/docs/components/modal-2","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#examples","content":"Examples"},"646":{"id":"/docs/components/modal-3","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#default","content":"Default"},"647":{"id":"/docs/components/modal-4","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#controlled","content":"Controlled"},"648":{"id":"/docs/components/modal-5","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#scrollable","content":"Scrollable"},"649":{"id":"/docs/components/modal-6","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#triggerless","content":"Triggerless"},"650":{"id":"/docs/components/modal-7","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#accessibility","content":"Accessibility"},"651":{"id":"/docs/components/modal-8","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#keyboard-interaction","content":"Keyboard interaction"},"652":{"id":"/docs/components/modal-9","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#aria","content":"ARIA"},"653":{"id":"/docs/components/modal-10","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#best-practices","content":"Best Practices"},"654":{"id":"/docs/components/modal-11","page_id":"/docs/components/modal","type":"heading","tags":[],"url":"/docs/components/modal#props","content":"Props"},"655":{"id":"/docs/components/modal-12","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal","content":"`ModalTrigger` wraps a trigger button and a `<Modal>`, handling open state automatically. Based on RAC `DialogTrigger`."},"656":{"id":"/docs/components/modal-13","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#default","content":"Compose a Modal from a `Heading slot=\"title\"`, a `CloseButton`, `Content`, and a\n`ButtonGroup`. `ModalTrigger` opens the Modal and manages its open/close state."},"657":{"id":"/docs/components/modal-14","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#controlled","content":"Pass `isOpen` and `onOpenChange` to `ModalTrigger` to control the open state externally."},"658":{"id":"/docs/components/modal-15","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#scrollable","content":"When the content is taller than the viewport, the `Content` region scrolls while the title\nrow and the `ButtonGroup` stay pinned."},"659":{"id":"/docs/components/modal-16","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#triggerless","content":"`Modal` accepts `isOpen` and `onOpenChange` directly, so it can be controlled without a\n`ModalTrigger`. Useful when the modal is opened from several places at once."},"660":{"id":"/docs/components/modal-17","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Key"},"661":{"id":"/docs/components/modal-18","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Action"},"662":{"id":"/docs/components/modal-19","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"`Tab`"},"663":{"id":"/docs/components/modal-20","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"Moves focus to the next focusable element inside the modal"},"664":{"id":"/docs/components/modal-21","page_id":"/docs/components/modal","tags":[],"type":"text","url":"/docs/components/modal#keyboard-interaction","content":"`Escape`"},"665":{"id":"/docs/components/modal-22","page_id":"/docs/com