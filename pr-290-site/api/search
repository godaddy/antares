er is missing"},"872":{"id":"/docs/components/range-field-22","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#markers-are-crowded-or-rendering-is-slow","content":"Markers are crowded or rendering is slow"},"873":{"id":"/docs/components/range-field-23","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-value-or-endpoint-labels-are-blank","content":"The value or endpoint labels are blank"},"874":{"id":"/docs/components/range-field-24","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#negative-values-do-not-behave-as-expected","content":"Negative values do not behave as expected"},"875":{"id":"/docs/components/range-field-25","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-range-configuration-is-invalid","content":"The range configuration is invalid"},"876":{"id":"/docs/components/range-field-26","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Select one value or render one thumb for each value in an array"},"877":{"id":"/docs/components/range-field-27","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Supports controlled and uncontrolled values with typed change callbacks"},"878":{"id":"/docs/components/range-field-28","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Provides localized value output, endpoint labels, descriptions, and markers"},"879":{"id":"/docs/components/range-field-29","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Integrates with native forms, keyboard, pointer, and touch interaction through React Aria"},"880":{"id":"/docs/components/range-field-30","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#default","content":"Minimal usage with a single value and min/max bounds."},"881":{"id":"/docs/components/range-field-31","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#controlled","content":"Use \\`onChange\\` for immediate updates and \\`onChangeEnd\\` for work that should run after interaction finishes."},"882":{"id":"/docs/components/range-field-32","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#disabled","content":"Use \\`isDisabled\\` when the value is visible but unavailable for interaction."},"883":{"id":"/docs/components/range-field-33","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#labels","content":"Combine an input label, value label, range labels, and helper text when users need additional context."},"884":{"id":"/docs/components/range-field-34","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#value-display","content":"Use \\`valueLabel\\` to show formatted values, static context, or output derived from the current slider state."},"885":{"id":"/docs/components/range-field-35","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#markers","content":"Use \\`markers\\` to expose a manageable set of discrete steps for a single value."},"886":{"id":"/docs/components/range-field-36","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#range","content":"Pass a \\`number\\[]\\` to render a range with two thumbs and step markers."},"887":{"id":"/docs/components/range-field-37","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"For a single value, prefer a visible `label`; use `aria-label` only when equivalent visible context already exists."},"888":{"id":"/docs/components/range-field-38","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"For an array, provide one descriptive `thumbLabels` entry for every value. Entries are matched by index, so keep them aligned when values are added, removed, or reordered. Describe each thumb's purpose, such as `Lower warning threshold`, rather than its current number."},"889":{"id":"/docs/components/range-field-39","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"`thumbNames` configures native form field names and does not provide accessible labels. Likewise, `valueLabel`, `minLabel`, and `maxLabel` are visual context rather than substitutes for accessible naming."},"890":{"id":"/docs/components/range-field-40","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Each thumb follows the React Aria slider keyboard model:"},"891":{"id":"/docs/components/range-field-41","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Tab and Shift+Tab move among thumbs and surrounding controls."},"892":{"id":"/docs/components/range-field-42","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Arrow Right and Arrow Up increase the focused value by `step`."},"893":{"id":"/docs/components/range-field-43","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Arrow Left and Arrow Down decrease the focused value by `step`."},"894":{"id":"/docs/components/range-field-44","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Home and End move the focused thumb to its permitted bounds."},"895":{"id":"/docs/components/range-field-45","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Page Up and Page Down make larger changes."},"896":{"id":"/docs/components/range-field-46","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Directional behavior follows the user's locale where appropriate. Pointer, touch, and keyboard interaction all use the same scale and constraints."},"897":{"id":"/docs/components/range-field-47","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Markers are decorative and hidden from the accessibility tree. Ensure the field label, thumb labels, bounds, step, and formatted values communicate all required information without relying on marker appearance."},"898":{"id":"/docs/components/range-field-48","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use an array only when every entry has a clear, independently adjustable meaning."},"899":{"id":"/docs/components/range-field-49","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Keep `value`, `thumbLabels`, and `thumbNames` aligned by index."},"900":{"id":"/docs/components/range-field-50","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use thumb labels that explain purpose instead of repeating the current number."},"901":{"id":"/docs/components/range-field-51","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Keep array values in a stable semantic order. If crossing or reordering thumbs would make their meaning ambiguous, enforce the appropriate ordering in product state."},"902":{"id":"/docs/components/range-field-52","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Avoid large value arrays. Every entry creates another focusable control, which increases keyboard effort and cognitive load."},"903":{"id":"/docs/components/range-field-53","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Set meaningful `minValue`, `maxValue`, and `step` values. The scale should match the precision users actually need."},"904":{"id":"/docs/components/range-field-54","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use markers only when there are few enough steps to scan. Tiny steps across a large range can create an excessive number of DOM elements."},"905":{"id":"/docs/components/range-field-55","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `formatOptions` for currency, percentages, measurements, and other locale-sensitive units so values display and announce their meaning."},"906":{"id":"/docs/components/range-field-56","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `description` for persistent guidance and `isRequired` when a value is required."},"907":{"id":"/docs/components/range-field-57","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `isDisabled` when the value should remain visible but unavailable for interaction."},"908":{"id":"/docs/components/range-field-58","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `onChange` for lightweight immediate feedback and `onChangeEnd` for expensive requests, filtering, or calculations."},"909":{"id":"/docs/components/range-field-59","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use a text-entry control when exact numeric input is essential. A track is best for exploring or adjusting values within known bounds."},"910":{"id":"/docs/components/range-field-60","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#a-thumb-is-missing-a-label-or-form-value","content":"Check the same index in `thumbLabels` and `thumbNames`. Each array entry renders a thumb, and its accessible label and form name are read from the corresponding positions. A form name does not replace an accessible label."},"911":{"id":"/docs/components/range-field-61","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#typescript-reports-the-wrong-callback-value-type","content":"Keep the controlled or default value and callback signatures consistent. When inference is unavailable, provide the generic explicitly: `<RangeField<number>>` for a scalar or `<RangeField<number[]>>` for an array."},"912":{"id":"/docs/components/range-field-62","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-controlled-thumbs-do-not-move","content":"The `value` prop is the source of truth. Update the scalar or array in `onChange` without changing its intended shape. For arrays, return a new array so application state observes the update."},"913":{"id":"/docs/components/range-field-63","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#values-snap-unexpectedly","content":"Verify that `step` represents the intended interval from `minValue`. Every thumb snaps to valid positions on the same configured scale."},"914":{"id":"/docs/components/range-field-64","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-final-marker-is-missing","content":"Markers begin at `minValue` and appear at complete step positions. `maxValue` receives a marker only when the range is evenly divisible by `step`."},"915":{"id":"/docs/components/range-field-65","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#markers-are-crowded-or-rendering-is-slow","content":"Increase `step` or omit `markers`. Large ranges with small steps can produce many decorative elements even when users cannot distinguish them visually."},"916":{"id":"/docs/components/range-field-66","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-value-or-endpoint-labels-are-blank","content":"Enable automatic current-value output with `valueLabel={true}` or provide custom content. `minLabel` and `maxLabel` display only explicitly supplied content; neither defaults to a numeric bound or receives `formatOptions`."},"917":{"id":"/docs/components/range-field-67","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#negative-values-do-not-behave-as-expected","content":"Negative values are supported. Set a negative `minValue` and ensure every scalar or array value remains within the configured bounds."},"918":{"id":"/docs/components/range-field-68","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-range-configuration-is-invalid","content":"Provide finite bounds where `minValue` is less than `maxValue`, a finite `step` greater than zero, and finite values inside the configured range."},"919":{"id":"/docs/components/radio","page_id":"/docs/components/radio","type":"page","content":"Radio","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/radio"},"920":{"id":"/docs/components/radio-0","page_id":"/docs/components/radio","tags":[],"type":"text","url":"/docs/components/radio","content":"Accessible radio button component for mutually exclusive selections with keyboard navigation, validation states, and flexible layouts."},"921":{"id":"/docs/components/radio-1","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#installation","content":"Installation"},"922":{"id":"/docs/components/radio-2","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#examples","content":"Examples"},"923":{"id":"/docs/components/radio-3","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#default","content":"Default"},"924":{"id":"/docs/components/radio-4","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#radio-controlled","content":"Radio Controlled"},"925":{"id":"/docs/components/radio-5","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#horizontal-layout","content":"Horizontal Layout"},"926":{"id":"/docs/components/radio-6","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#disabled-states","content":"Disabled States"},"927":{"id":"/docs/components/radio-7","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#required-indicator","content":"Required Indicator"},"928":{"id":"/docs/components/radio-8","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#description-text","content":"Description Text"},"929":{"id":"/docs/components/radio-9","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"/docs/components/radio#error-state","content":"Error State"},"930":{"id":"/docs/components/radio-10","page_id":"/docs/components/radio","type":"heading","tags":[],"url":"