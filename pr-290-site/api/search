ding","tags":[],"url":"/docs/components/file-trigger#installation","content":"Installation"},"528":{"id":"/docs/components/file-trigger-3","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#examples","content":"Examples"},"529":{"id":"/docs/components/file-trigger-4","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#default","content":"Default"},"530":{"id":"/docs/components/file-trigger-5","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#accepted-types","content":"Accepted Types"},"531":{"id":"/docs/components/file-trigger-6","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#accessibility","content":"Accessibility"},"532":{"id":"/docs/components/file-trigger-7","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#best-practices","content":"Best Practices"},"533":{"id":"/docs/components/file-trigger-8","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#props","content":"Props"},"534":{"id":"/docs/components/file-trigger-9","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Turns any pressable component (such as an Antares `Button`) into a file picker trigger."},"535":{"id":"/docs/components/file-trigger-10","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Renders a visually hidden `<input type=\"file\">` — no styling of its own."},"536":{"id":"/docs/components/file-trigger-11","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Restricts selection by MIME type, allows multiple files, directory selection, and camera capture."},"537":{"id":"/docs/components/file-trigger-12","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Resets the input value before every open, so re-selecting the same file still fires `onSelect`."},"538":{"id":"/docs/components/file-trigger-13","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#default","content":"Wrap any pressable component. Activating the child opens the native file picker; the selected files arrive in \\`onSelect\\`."},"539":{"id":"/docs/components/file-trigger-14","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#accepted-types","content":"Restrict the picker to specific MIME types with \\`acceptedFileTypes\\`, and allow more than one file with \\`allowsMultiple\\`."},"540":{"id":"/docs/components/file-trigger-15","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#accessibility","content":"`FileTrigger` adds no visuals or ARIA of its own — accessibility comes from the pressable child you provide. Use a component with an accessible name (e.g. an Antares `Button` with clear label text) so assistive technology announces the action. The underlying `<input>` is visually hidden but remains operable by keyboard through the child's press behavior."},"541":{"id":"/docs/components/file-trigger-16","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#best-practices","content":"`acceptedFileTypes` is a best-effort filter for the OS picker — always validate file type and size again in your `onSelect` handler, since it can be bypassed."},"542":{"id":"/docs/components/file-trigger-17","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#best-practices","content":"Pair `FileTrigger` with `DropZone` to offer both click-to-browse and drag-and-drop. See the DropZone \"File Upload\" example."},"543":{"id":"/docs/components/file-trigger-18","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#best-practices","content":"Keep the child a single pressable element; `FileTrigger` forwards press behavior to whatever you nest inside it."},"544":{"id":"/docs/components/inline-drawer","page_id":"/docs/components/inline-drawer","type":"page","content":"InlineDrawer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/inline-drawer"},"545":{"id":"/docs/components/inline-drawer-0","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer","content":"An in-flow collapsible built on RAC Disclosure. Compose a trigger and content to make an accordion or a sidebar rail."},"546":{"id":"/docs/components/inline-drawer-1","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#features","content":"Features"},"547":{"id":"/docs/components/inline-drawer-2","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#installation","content":"Installation"},"548":{"id":"/docs/components/inline-drawer-3","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#examples","content":"Examples"},"549":{"id":"/docs/components/inline-drawer-4","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#default","content":"Default"},"550":{"id":"/docs/components/inline-drawer-5","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#controlled","content":"Controlled"},"551":{"id":"/docs/components/inline-drawer-6","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#sidebar-nav","content":"Sidebar Nav"},"552":{"id":"/docs/components/inline-drawer-7","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#accessibility","content":"Accessibility"},"553":{"id":"/docs/components/inline-drawer-8","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#keyboard","content":"Keyboard"},"554":{"id":"/docs/components/inline-drawer-9","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#aria","content":"ARIA"},"555":{"id":"/docs/components/inline-drawer-10","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#best-practices","content":"Best Practices"},"556":{"id":"/docs/components/inline-drawer-11","page_id":"/docs/components/inline-drawer","type":"heading","tags":[],"url":"/docs/components/inline-drawer#props","content":"Props"},"557":{"id":"/docs/components/inline-drawer-12","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer","content":"`InlineDrawerPanel` is the collapsible content for the accordion pattern — a thin wrapper over RAC `DisclosurePanel` that hides when collapsed. The trigger is any component you slot in with `slot=\"trigger\"` — there's no dedicated trigger component."},"558":{"id":"/docs/components/inline-drawer-13","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"In-flow collapsible built on RAC Disclosure — bring your own trigger via `slot=\"trigger\"`"},"559":{"id":"/docs/components/inline-drawer-14","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Animated by default; `animate={false}` disables the transition"},"560":{"id":"/docs/components/inline-drawer-15","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"`placement` selects the collapse axis (`left`/`right` → width, `top`/`bottom` → height)"},"561":{"id":"/docs/components/inline-drawer-16","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Controlled and uncontrolled modes (`isExpanded` / `defaultExpanded` / `onExpandedChange`)"},"562":{"id":"/docs/components/inline-drawer-17","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"Accordion collapse uses the browser's `hidden=\"until-found\"` for find-in-page"},"563":{"id":"/docs/components/inline-drawer-18","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#features","content":"`prefers-reduced-motion` support"},"564":{"id":"/docs/components/inline-drawer-19","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#default","content":"Put a \\`\\<Button slot=\"trigger\">\\` and an \\`\\<InlineDrawerPanel>\\` inside \\`InlineDrawer\\`. The panel hides when collapsed and animates open."},"565":{"id":"/docs/components/inline-drawer-20","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#controlled","content":"Use \\`isExpanded\\` and \\`onExpandedChange\\` to drive state externally."},"566":{"id":"/docs/components/inline-drawer-21","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#sidebar-nav","content":"A rail whose content stays visible when collapsed is a composition, not a mode: drive \\`isExpanded\\` yourself, render always-visible children (no \\`InlineDrawerPanel\\`), and let \\`minSize\\`/\\`maxSize\\` size the rail. Use numeric (px) sizes so the width animates; intrinsic keywords like \\`min-content\\`/\\`max-content\\` fit the content exactly but don't animate."},"567":{"id":"/docs/components/inline-drawer-22","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Key"},"568":{"id":"/docs/components/inline-drawer-23","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Action"},"569":{"id":"/docs/components/inline-drawer-24","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"`Enter` / `Space`"},"570":{"id":"/docs/components/inline-drawer-25","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Toggle via the slotted trigger"},"571":{"id":"/docs/components/inline-drawer-26","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"`Tab`"},"572":{"id":"/docs/components/inline-drawer-27","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#keyboard","content":"Move focus through the content"},"573":{"id":"/docs/components/inline-drawer-28","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#aria","content":"A `<Button slot=\"trigger\">` gets `aria-expanded` + `aria-controls` wired to the `InlineDrawerPanel` automatically (via RAC Disclosure)."},"574":{"id":"/docs/components/inline-drawer-29","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#aria","content":"For the sidebar rail, the toggle is your own control (e.g. a `ToggleButton`) — give icon-only buttons an `aria-label`, and the content stays in the DOM and accessible since nothing is hidden."},"575":{"id":"/docs/components/inline-drawer-30","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"Accordion → `Button slot=\"trigger\"` + `InlineDrawerPanel`. Sidebar rail → controlled state + always-visible children."},"576":{"id":"/docs/components/inline-drawer-31","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"For the rail, use numeric (px) `minSize`/`maxSize` so the width animates; `min-content`/`max-content` fit the content exactly but won't animate."},"577":{"id":"/docs/components/inline-drawer-32","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"`placement` does not flip in RTL; the side is decided by document/flex order."},"578":{"id":"/docs/components/inline-drawer-33","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#best-practices","content":"Don't nest InlineDrawers."},"579":{"id":"/docs/components/inline-drawer-34","page_id":"/docs/components/inline-drawer","tags":[],"type":"text","url":"/docs/components/inline-drawer#props","content":"The `InlineDrawerPanel` component accepts the following props:"},"580":{"id":"/docs/components/listbox","page_id":"/docs/components/listbox","type":"page","content":"ListBox","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/listbox"},"581":{"id":"/docs/components/listbox-0","page_id":"/docs/components/listbox","tags":[],"type":"text","url":"/docs/components/listbox","content":"ListBox is a selectable collection of items rendered inline. Use it for non-popover pickers, inline lists, or as a building block for higher-level components like Select."},"582":{"id":"/docs/components/listbox-1","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#features","content":"Features"},"583":{"id":"/docs/components/listbox-2","page_id":"/docs/components/listbox","type":"heading","tags":[],"url":"/docs/components/listbox#installation","content":"Installation"},"584"