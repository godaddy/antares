lity"},"897":{"id":"/docs/components/range-field-12","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#accessible-names","content":"Accessible names"},"898":{"id":"/docs/components/range-field-13","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#keyboard-interaction","content":"Keyboard interaction"},"899":{"id":"/docs/components/range-field-14","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#best-practices","content":"Best Practices"},"900":{"id":"/docs/components/range-field-15","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#props","content":"Props"},"901":{"id":"/docs/components/range-field-16","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#troubleshooting","content":"Troubleshooting"},"902":{"id":"/docs/components/range-field-17","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#a-thumb-is-missing-a-label-or-form-value","content":"A thumb is missing a label or form value"},"903":{"id":"/docs/components/range-field-18","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#typescript-reports-the-wrong-callback-value-type","content":"TypeScript reports the wrong callback value type"},"904":{"id":"/docs/components/range-field-19","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-controlled-thumbs-do-not-move","content":"The controlled thumbs do not move"},"905":{"id":"/docs/components/range-field-20","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#values-snap-unexpectedly","content":"Values snap unexpectedly"},"906":{"id":"/docs/components/range-field-21","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-final-marker-is-missing","content":"The final marker is missing"},"907":{"id":"/docs/components/range-field-22","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#markers-are-crowded-or-rendering-is-slow","content":"Markers are crowded or rendering is slow"},"908":{"id":"/docs/components/range-field-23","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-value-or-endpoint-labels-are-blank","content":"The value or endpoint labels are blank"},"909":{"id":"/docs/components/range-field-24","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#negative-values-do-not-behave-as-expected","content":"Negative values do not behave as expected"},"910":{"id":"/docs/components/range-field-25","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-range-configuration-is-invalid","content":"The range configuration is invalid"},"911":{"id":"/docs/components/range-field-26","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Select one value or render one thumb for each value in an array"},"912":{"id":"/docs/components/range-field-27","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Supports controlled and uncontrolled values with typed change callbacks"},"913":{"id":"/docs/components/range-field-28","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Provides localized value output, endpoint labels, descriptions, and markers"},"914":{"id":"/docs/components/range-field-29","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Integrates with native forms, keyboard, pointer, and touch interaction through React Aria"},"915":{"id":"/docs/components/range-field-30","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#default","content":"Minimal usage with a single value and min/max bounds."},"916":{"id":"/docs/components/range-field-31","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#controlled","content":"Use `onChange` for immediate updates and `onChangeEnd` for work that should run after interaction finishes."},"917":{"id":"/docs/components/range-field-32","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#disabled","content":"Use `isDisabled` when the value is visible but unavailable for interaction."},"918":{"id":"/docs/components/range-field-33","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#labels","content":"Combine an input label, value label, range labels, and helper text when users need additional context."},"919":{"id":"/docs/components/range-field-34","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#value-display","content":"Use `valueLabel` to show formatted values, static context, or output derived from the current slider state."},"920":{"id":"/docs/components/range-field-35","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#markers","content":"Use `markers` to expose a manageable set of discrete steps for a single value."},"921":{"id":"/docs/components/range-field-36","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#range","content":"Pass a `number[]` to render a range with two thumbs and step markers."},"922":{"id":"/docs/components/range-field-37","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"For a single value, prefer a visible `label`; use `aria-label` only when equivalent visible context already exists."},"923":{"id":"/docs/components/range-field-38","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"For an array, provide one descriptive `thumbLabels` entry for every value. Entries are matched by index, so keep them aligned when values are added, removed, or reordered. Describe each thumb's purpose, such as `Lower warning threshold`, rather than its current number."},"924":{"id":"/docs/components/range-field-39","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"`thumbNames` configures native form field names and does not provide accessible labels. Likewise, `valueLabel`, `minLabel`, and `maxLabel` are visual context rather than substitutes for accessible naming."},"925":{"id":"/docs/components/range-field-40","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Each thumb follows the React Aria slider keyboard model:"},"926":{"id":"/docs/components/range-field-41","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Tab and Shift+Tab move among thumbs and surrounding controls."},"927":{"id":"/docs/components/range-field-42","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Arrow Right and Arrow Up increase the focused value by `step`."},"928":{"id":"/docs/components/range-field-43","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Arrow Left and Arrow Down decrease the focused value by `step`."},"929":{"id":"/docs/components/range-field-44","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Home and End move the focused thumb to its permitted bounds."},"930":{"id":"/docs/components/range-field-45","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Page Up and Page Down make larger changes."},"931":{"id":"/docs/components/range-field-46","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Directional behavior follows the user's locale where appropriate. Pointer, touch, and keyboard interaction all use the same scale and constraints."},"932":{"id":"/docs/components/range-field-47","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Markers are decorative and hidden from the accessibility tree. Ensure the field label, thumb labels, bounds, step, and formatted values communicate all required information without relying on marker appearance."},"933":{"id":"/docs/components/range-field-48","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use an array only when every entry has a clear, independently adjustable meaning."},"934":{"id":"/docs/components/range-field-49","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Keep `value`, `thumbLabels`, and `thumbNames` aligned by index."},"935":{"id":"/docs/components/range-field-50","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use thumb labels that explain purpose instead of repeating the current number."},"936":{"id":"/docs/components/range-field-51","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Keep array values in a stable semantic order. If crossing or reordering thumbs would make their meaning ambiguous, enforce the appropriate ordering in product state."},"937":{"id":"/docs/components/range-field-52","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Avoid large value arrays. Every entry creates another focusable control, which increases keyboard effort and cognitive load."},"938":{"id":"/docs/components/range-field-53","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Set meaningful `minValue`, `maxValue`, and `step` values. The scale should match the precision users actually need."},"939":{"id":"/docs/components/range-field-54","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use markers only when there are few enough steps to scan. Tiny steps across a large range can create an excessive number of DOM elements."},"940":{"id":"/docs/components/range-field-55","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `formatOptions` for currency, percentages, measurements, and other locale-sensitive units so values display and announce their meaning."},"941":{"id":"/docs/components/range-field-56","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `description` for persistent guidance and `isRequired` when a value is required."},"942":{"id":"/docs/components/range-field-57","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `isDisabled` when the value should remain visible but unavailable for interaction."},"943":{"id":"/docs/components/range-field-58","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `onChange` for lightweight immediate feedback and `onChangeEnd` for expensive requests, filtering, or calculations."},"944":{"id":"/docs/components/range-field-59","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use a text-entry control when exact numeric input is essential. A track is best for exploring or adjusting values within known bounds."},"945":{"id":"/docs/components/range-field-60","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#a-thumb-is-missing-a-label-or-form-value","content":"Check the same index in `thumbLabels` and `thumbNames`. Each array entry renders a thumb, and its accessible label and form name are read from the corresponding positions. A form name does not replace an accessible label."},"946":{"id":"/docs/components/range-field-61","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#typescript-reports-the-wrong-callback-value-type","content":"Keep the controlled or default value and callback signatures consistent. When inference is unavailable, provide the generic explicitly: `<RangeField<number>>` for a scalar or `<RangeField<number[]>>` for an array."},"947":{"id":"/docs/components/range-field-62","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-controlled-thumbs-do-not-move","content":"The `value` prop is the source of truth. Update the scalar or array in `onChange` without changing its intended shape. For arrays, return a new array so application state observes the update."},"948":{"id":"/docs/components/range-field-63","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#values-snap-unexpectedly","content":"Verify that `step` represents the intended interval from `minValue`. Every thumb snaps to valid positions on the same configured scale."},"949":{"id":"/docs/components/range-field-64","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-final-marker-is-missing","content":"Markers begin at `minValue` and appear at complete step positions. `maxValue` receives a marker only when the range is evenly divisible by `step`."},"950":{"id":"/docs/components/range-field-65","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#markers-are-crowded-or-rendering-is-slow","content":"Increase `step` or omit `markers`. Large ranges with small steps can produce many decorative elements even when users cannot distinguish them visually."},"951":{"id":"/docs/components/range-field-66","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-value-or-endpoint-labels-are-blank","content":"Enable automatic current-value output with `valueLabel={true}` or provide custom content. `minLabel` and `maxLabel` display only explicitly supplied content; neither defaults to a numeric bound or receives `formatOptions`."},"952":{"id":"/docs/components/range-field-67","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#negative-values-do-not-behave-as-expected","content":"Negative values are supported. Set a negative `minValue` and ensure every scalar or array value remains within the configured bounds."},"953":{"id":"/docs/components/range-field-68","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-range-configuration-is-invalid","content":"Provide finite bounds where `minValue` is less than `maxValue`, a finite `step` greater than zero, and finite values inside the configured range."},"954":{"id":"/docs/components/segmented-controller","page_id":"/docs/components/segmented-controller","type":"page","content":"SegmentedController","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/segmented-controller"},"955":{"id":"/docs/components/segmented-controller-0","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller","content":"A segmented controller is a linear set of two or more segments, each of which functions as a button. A segmented controller allows users to select options, switch views, or sort elements."},"956":{"id":"/docs/components/segmented-controller-1","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#installation","content":"Installation"},"957":{"id":"/docs/components/segmented-controller-2","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#examples","content":"Examples"},"958":{"id":"/docs/components/segmented-controller-3","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#default","content":"Default"},"959":{"id":"/docs/components/segmented-controller-4","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#controlled","content":"Controlled"},"960":{"id":"/docs/components/segmented-controller-5","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#sizes","content":"Sizes"},"961":{"id":"/docs/components/segmented-controller-6","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#icon--text","content":"Icon + Text"},"962":{"id":"/docs/components/segmented-controller-7","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/compo