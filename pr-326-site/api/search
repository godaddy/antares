/components/chart/bar-chart-73","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"✅ Custom domains"},"1610":{"id":"/docs/components/chart/bar-chart-74","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"✅ Design system alignment"},"1611":{"id":"/docs/components/chart/bar-chart-75","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"🚧 RTL compatibility (axis rendering and spacing refinement)"},"1612":{"id":"/docs/components/chart/bar-chart-76","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"🚧 Tick mark positioning improvements"},"1613":{"id":"/docs/components/chart/bar-chart-77","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#development-status","content":"🚧 Additional customization options (tick formatting, axis configuration)"},"1614":{"id":"/docs/components/chart/bar-chart-78","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#bars-not-showing","content":"If bars are not visible:"},"1615":{"id":"/docs/components/chart/bar-chart-79","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#bars-not-showing","content":"**Check data**: Ensure `series` array has data and `xAccessor`/`yAccessor` return valid values"},"1616":{"id":"/docs/components/chart/bar-chart-80","page_id":"/docs/components/chart/bar-chart","tags":[],"type":"text","url":"/docs/components/chart/bar-chart#bars-not-showing","content":"**Check domains**: Verify `yDomain` (if set) includes your data values"},"1617":{"id":"/docs/components/chart/bar-chart-81","page_id":"/docs/component