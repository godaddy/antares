ices","content":"Best Practices"},"584":{"id":"/docs/components/drop-zone-8","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#props","content":"Props"},"585":{"id":"/docs/components/drop-zone-9","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#dropzone","content":"DropZone"},"586":{"id":"/docs/components/drop-zone-10","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n<Meta"},"587":{"id":"/docs/components/drop-zone-11","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n<Meta of={Stories}"},"588":{"id":"/docs/components/drop-zone-12","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n\n\n## Installation\n\n```bash\nnpm install --save @godaddy"},"589":{"id":"/docs/components/drop-zone-13","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"| Key   | Description                  |\n| ----- | ---------------------------- |\n| `Tab` | Moves focus to the drop zone |","table":"table-0