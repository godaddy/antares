:"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#best-practices","content":"Best Practices"},"583":{"id":"/docs/components/drop-zone-8","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#props","content":"Props"},"584":{"id":"/docs/components/drop-zone-9","page_id":"/docs/components/drop-zone","type":"heading","tags":[],"url":"/docs/components/drop-zone#dropzone","content":"DropZone"},"585":{"id":"/docs/components/drop-zone-10","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n<Meta"},"586":{"id":"/docs/components/drop-zone-11","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n<Meta of={Stories}"},"587":{"id":"/docs/components/drop-zone-12","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport { BlockLink } from '@bento/block-explorer/runtime';\nimport * as Stories from './drop-zone.stories.tsx';\n\n\n\n## Installation\n\n```bash\nnpm install --save @godaddy"},"588":{"id":"/docs/components/drop-zone-13","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"| Key   | Description                  |\n| ----- | ---------------------------- |\n| `Tab` | Moves focus to the drop zone |","table":"table-0"},"589":{"id":"/docs/components/drop-zone-14","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#keyboard","content":"| Key               | Description                                                      |\n| ----------------- | ---------------------------------------------------------------- |\n| `Enter` / `Space` | Opens the file picker so files can be selected without a pointer |","table":"table-0"},"590":{"id":"/docs/components/drop-zone-15","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"The drop zone renders a visually hidden `<button>` inside the container. Assistive technology discovers and announces this button as an interactive element — activating it opens the native file picker without a pointer."},"591":{"id":"/docs/components/drop-zone-16","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"The button's accessible name is built from two sources, combined in order:"},"592":{"id":"/docs/components/drop-zone-17","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"**`<Text slot=\"label\">`** — any `Text` child with `slot=\"label\"` has its `id` linked to the button via `aria-labelledby`. This is the recommended way to provide a contextual label that is also visible to sighted users."},"593":{"id":"/docs/components/drop-zone-18","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#screen-readers","content":"**`aria-label`** — pass `aria-label` on the `DropZone` component to override or supplement the label (e.g. `aria-label=\"Upload profile photo\"`). When no `Text slot=\"label\"` is present and no `aria-label` is set, the button falls back to the default \"DropZone\" label provided by React Aria."},"594":{"id":"/docs/components/drop-zone-19","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Use the drop zone alongside a button-based file picker — drag-and-drop is a convenience, never the only way to upload."},"595":{"id":"/docs/components/drop-zone-20","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Replace the default text with `children` to communicate the accepted file types and size limits up front."},"596":{"id":"/docs/components/drop-zone-21","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Let the drop zone fill its container; constrain it with the surrounding layout rather than setting a fixed width on the component itself."},"597":{"id":"/docs/components/drop-zone-22","page_id":"/docs/components/drop-zone","tags":[],"type":"text","url":"/docs/components/drop-zone#best-practices","content":"Reflect upload state (validating, uploading, error) outside the drop zone so the target area stays clear and predictable."},"598":{"id":"/docs/components/field-error","page_id":"/docs/components/field-error","type":"page","content":"FieldError","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/field-error"},"599":{"id":"/docs/components/field-error-0","page_id":"/docs/components/field-error","tags":[],"type":"text","url":"/docs/components/field-error","content":"Validation message for a field. Renders only when the field is invalid."},"600":{"id":"/docs/components/field-error-1","page_id":"/docs/components/field-error","type":"heading","tags":[],"url":"/docs/components/field-error#features","content":"Features"},"601":{"id":"/docs/components/field-error-2","page_id":"/docs/components/field-error","type":"heading","tags":[],"url":"/docs/components/field-error#installation","content":"Installation"},"602":{"id":"/docs/components/field-error-3","page_id":"/docs/components/field-error","type":"heading","tags":[],"url":"/docs/components/field-error#examples","content":"Examples"},"603":{"id":"/docs/components/field-error-4","page_id":"/docs/components/field-error","type":"heading","tags":[],"url":"/docs/components/field-error#props","content":"Props"},"604":{"id":"/docs/components/field-error-5","page_id":"/docs/components/field-error","type":"heading","tags":[],"url":"/docs/components/field-error#fielderror","content":"FieldError"},"605":{"id":"/docs/components/field-error-6","page_id":"/docs/components/field-error","tags":[],"type":"text","url":"/docs/components/field-error#features","content":"Shown when the parent field is invalid (`isInvalid` or native constraint validation)."},"606":{"id":"/docs/components/field-error-7","page_id":"/docs/components/field-error","tags":[],"type":"text","url":"/docs/components/field-error#examples","content":"import { ArgTypes, Meta } from '@storybo"},"607":{"id":"/docs/components/file-trigger","page_id":"/docs/components/file-trigger","type":"page","content":"FileTrigger","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/file-trigger"},"608":{"id":"/docs/components/file-trigger-0","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger","content":"A style-less primitive that wraps any pressable component and opens the native file picker when it is activated."},"609":{"id":"/docs/components/file-trigger-1","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#features","content":"Features"},"610":{"id":"/docs/components/file-trigger-2","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#installation","content":"Installation"},"611":{"id":"/docs/components/file-trigger-3","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#examples","content":"Examples"},"612":{"id":"/docs/components/file-trigger-4","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#accessibility","content":"Accessibility"},"613":{"id":"/docs/components/file-trigger-5","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#best-practices","content":"Best Practices"},"614":{"id":"/docs/components/file-trigger-6","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#props","content":"Props"},"615":{"id":"/docs/components/file-trigger-7","page_id":"/docs/components/file-trigger","type":"heading","tags":[],"url":"/docs/components/file-trigger#filetrigger","content":"FileTrigger"},"616":{"id":"/docs/components/file-trigger-8","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Turns any pressable component (such as an Antares `Button`) into a file picker trigger."},"617":{"id":"/docs/components/file-trigger-9","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Renders a visually hidden `<input type=\"file\">` — no styling of its own."},"618":{"id":"/docs/components/file-trigger-10","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Restricts selection by MIME type, allows multiple files, directory selection, and camera capture."},"619":{"id":"/docs/components/file-trigger-11","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#features","content":"Resets the input value before every open, so re-selecting the same file still fires `onSelect`."},"620":{"id":"/docs/components/file-trigger-12","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#examples","content":"import { Meta, ArgTypes } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-help"},"621":{"id":"/docs/components/file-trigger-13","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#accessibility","content":"`FileTrigger` adds no visuals or ARIA of its own — accessibility comes from the pressable child you provide. Use a component with an accessible name (e.g. an Antares `Button` with clear label text) so assistive technology announces the action. The underlying `<input>` is visually hidden but remains operable by keyboard through the child's press behavior."},"622":{"id":"/docs/components/file-trigger-14","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#best-practices","content":"`acceptedFileTypes` is a best-effort filter for the OS picker — always validate file type and size again in your `onSelect` handler, since it can be bypassed."},"623":{"id":"/docs/components/file-trigger-15","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#best-practices","content":"Pair `FileTrigger` with `DropZone` to offer both click-to-browse and drag-and-drop. See the DropZone \"File Upload\" example."},"624":{"id":"/docs/components/file-trigger-16","page_id":"/docs/components/file-trigger","tags":[],"type":"text","url":"/docs/components/file-trigger#best-practices","content":"Keep the child a single pressable element; `FileTrigger` forwards press behavior to whatever you nest inside it."},"625":{"id":"/docs/components/heading","page_id":"/docs/components/heading","type":"page","content":"Heading","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/heading"},"626":{"id":"/docs/components/heading-0","page_id":"/docs/components/heading","tags":[],"type":"text","url":"/docs/components/heading","content":"Semantic h1-h6 heading. Use slot=\"title\" inside a Modal or Dialog to name the overlay."},"627":{"id":"/docs/components/heading-1","page_id":"/docs/components/heading","type":"heading","tags":[],"url":"/docs/components/heading#features","content":"Features"},"628":{"id":"/docs/components/heading-2","page_id":"/docs/components/heading","type":"heading","tags":[],"url":"/docs/components/heading#installation","content":"Installation"},"629":{"id":"/docs/components/heading-3","page_id":"/docs/components/heading","type":"heading","tags":[],"url":"/docs/components/heading#examples","content":"Examples"},"630":{"id":"/docs/components/heading-4","page_id":"/docs/components/heading","type":"heading","tags":[],"url":"/docs/components/heading#props","content":"Props"},"631":{"id":"/docs/components/heading-5","page_id":"/docs/components/heading","type":"heading","tags":[],"url":"/docs/components/heading#heading","content":"Heading"},"632":{"id":"/docs/components/heading-6","page_id":"/docs/components/heading","tags":[],"type":"text","url":"/docs/components/heading#features","content":"Renders `h1`-`h6` from the `level` prop (default `3`). The level never changes the visual size."},"633":{"id":"/docs/components/heading-7","page_id":"/docs/components/heading","tags":[],"type":"text","url":"/docs/components/heading#features","content":"Without `size`, takes the heading tier of the surrounding `SizeProvider`.\n`size` picks a step on the heading ramp (`xs` to `2xl`)."},"634":{"id":"/docs/components/heading-8","page_id":"/docs/components/heading","tags":[],"type":"text","url":"/docs/components/heading#features","content":"`emphasis` picks a feedback color and changes only the color."},"635":{"id":"/docs/components/heading-9","page_id":"/docs/components/heading","tags":[],"type":"text","url":"/docs/components/heading#features","content":"`slot=\"title\"` inside a `Modal` or `Dialog` sets the accessible name, and takes the overlay's\ntitle tier, one step above the heading tier."},"636":{"id":"/docs/components/