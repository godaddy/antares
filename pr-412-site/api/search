/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#data-attributes","content":"**Checkbox:** `data-selected`, `data-indeterminate`, `data-hovered`, `data-pressed`, `data-focused`, `data-disabled`"},"367":{"id":"/docs/components/checkbox-33","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#component-customization","content":"Pass `className` or `style` to customize a checkbox field container. Use descendant data-attribute selectors to style the interactive checkbox state:"},"368":{"id":"/docs/components/checkbox-34","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate-state","content":"The `isIndeterminate` prop displays a minus icon to represent a partial selection state. This is useful for \"select all\" checkboxes when only some items in a collection are selected."},"369":{"id":"/docs/components/checkbox-35","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"CheckboxGroup supports validation states and error messages:"},"370":{"id":"/docs/components/checkbox-36","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**isRequired**: Marks the group as required with visual indicator"},"371":{"id":"/docs/components/checkbox-37","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**isInvalid**: Shows error state styling"},"372":{"id":"/docs/components/checkbox-38","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-validation","content":"**`FieldError`**: Displays validation error text below the group"},"373":{"id":"/docs/components/checkbox-39","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#orientation","content":"Use `orientation=\"vertical\"` (default) to stack checkboxes, or `orientation=\"horizontal\"` to arrange them in a row."},"374":{"id":"/docs/components/checkbox-40","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Tab**: Moves focus to the next/previous checkbox"},"375":{"id":"/docs/components/checkbox-41","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Space**: Toggles the focused checkbox"},"376":{"id":"/docs/components/checkbox-42","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#keyboard-navigation","content":"**Shift + Tab**: Moves focus to the previous checkbox"},"377":{"id":"/docs/components/checkbox-43","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-disabled` for disabled checkboxes"},"378":{"id":"/docs/components/checkbox-44","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-required` when selection is required"},"379":{"id":"/docs/components/checkbox-45","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"`aria-invalid` for validation errors"},"380":{"id":"/docs/components/checkbox-46","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#aria-support","content":"Proper labeling with `aria-labelledby` and `aria-describedby`"},"381":{"id":"/docs/components/checkbox-47","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#indeterminate-state-not-updating","content":"The `isIndeterminate` prop must be explicitly managed - it doesn't automatically reflect parent-child relationships:"},"382":{"id":"/docs/components/checkbox-48","page_id":"/docs/components/checkbox","tags":[],"t