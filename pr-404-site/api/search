ents/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#values-snap-unexpectedly","content":"Values snap unexpectedly"},"1199":{"id":"/docs/components/range-field-15","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-final-marker-is-missing","content":"The final marker is missing"},"1200":{"id":"/docs/components/range-field-16","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#markers-are-crowded-or-rendering-is-slow","content":"Markers are crowded or rendering is slow"},"1201":{"id":"/docs/components/range-field-17","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-value-or-endpoint-labels-are-blank","content":"The value or endpoint labels are blank"},"1202":{"id":"/docs/components/range-field-18","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#negative-values-do-not-behave-as-expected","content":"Negative values do not behave as expected"},"1203":{"id":"/docs/components/range-field-19","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-range-configuration-is-invalid","content":"The range configuration is invalid"},"1204":{"id":"/docs/components/range-field-20","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Select one value or render one thumb for each value in an array"},"1205":{"id":"/docs/components/range-field-21","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Supports controlled and uncontrolled values with typed change callbacks"},"1206":{"id":"/docs/components/range-field-22","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Provides localized value output, endpoint labels, descriptions, and markers"},"1207":{"id":"/docs/components/range-field-23","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Integrates with native forms, keyboard, pointer, and touch interaction through React Aria"},"1208":{"id":"/docs/components/range-field-24","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#examples","content":"import { ArgTypes, Meta } from '@storybook/addon"},"1209":{"id":"/docs/components/range-field-25","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storyb"},"1210":{"id":"/docs/components/range-field-26","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"For a single value, prefer a visible `label`; use `aria-label` only when equivalent visible context already exists."},"1211":{"id":"/docs/components/range-field-27","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"For an array, provide one descriptive `thumbLabels` entry for every value. Entries are matched by index, so keep them aligned when values are added, removed, or reordered. Describe each thumb's purpose, such as `Lower warning threshold`, rather than its current number."},"1212":{"id":"/docs/components/range-field-28","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"`thumbNames` configures native form field names and does not provide accessible labels. Likewise, `valueLabel`, `minLabel`, and `maxLabel` are visual context rather than substitutes for accessible naming."},"1213":{"id":"/docs/components/range-field-29","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Each thumb follows the React Aria slider keyboard model:"},"1214":{"id":"/docs/components/range-field-30","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Tab and Shift+Tab move among thumbs and surrounding controls."},"1215":{"id":"/docs/components/range-field-31","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Arrow Right and Arrow Up increase the focused value by `step`."},"1216":{"id":"/docs/components/range-field-32","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Arrow Left and Arrow Down decrease the focused value by `step`."},"1217":{"id":"/docs/components/range-field-33","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Home and End move the focused thumb to its permitted bounds."},"1218":{"id":"/docs/components/range-field-34","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Page Up and Page Down make larger changes."},"1219":{"id":"/docs/components/range-field-35","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Directional behavior follows the user's locale where appropriate. Pointer, touch, and keyboard interaction all use the same scale and constraints."},"1220":{"id":"/docs/components/range-field-36","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Markers are decorative and hidden from the accessibility tree. Ensure the field label, thumb labels, bounds, step, and formatted values communicate all required information without relying on marker appearance."},"1221":{"id":"/docs/components/range-field-37","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use an array only when every entry has a clear, independently adjustable meaning."},"1222":{"id":"/docs/components/range-field-38","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Keep `value`, `thumbLabels`, and `thumbNames` aligned by index."},"1223":{"id":"/docs/components/range-field-39","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use thumb labels that explain purpose instead of repeating the current number."},"1224":{"id":"/docs/components/range-field-40","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Keep array values in a stable semantic order. If crossing or reordering thumbs would make their meaning ambiguous, enforce the appropriate ordering in product state."},"1225":{"id":"/docs/components/range-field-41","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Avoid large value arrays. Every entry creates another focusable control, which increases keyboard effort and cognitive load."},"1226":{"id":"/docs/components/range-field-42","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Set meaningful `minValue`, `maxValue`, and `step` values. The scale should match the precision users actually need."},"1227":{"id":"/docs/components/range-field-43","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use markers only when there are few enough steps to scan. Tiny steps across a large range can create an excessive number of DOM elements."},"1228":{"id":"/docs/components/range-field-44","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `formatOptions` for currency, percentages, measurements, and other locale-sensitive units so values display and announce their meaning."},"1229":{"id":"/docs/components/range-field-45","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `description` for persistent guidance and `isRequired` when a value is required."},"1230":{"id":"/docs/components/range-field-46","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `isDisabled` when the value should remain visible but unavailable for interaction."},"1231":{"id":"/docs/components/range-field-47","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `onChange` for lightweight immediate feedback and `onChangeEnd` for expensive requests, filtering, or calculations."},"1232":{"id":"/docs/components/range-field-48","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use a text-entry control when exact numeric input is essential. A track is best for exploring or adjusting values within known bounds."},"1233":{"id":"/docs/components/range-field-49","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#a-thumb-is-missing-a-label-or-form-value","content":"Check the same index in `thumbLabels` and `thumbNames`. Each array entry renders a thumb, and its accessible label and form name are read from the corresponding positions. A form name does not replace an accessible label."},"1234":{"id":"/docs/components/range-field-50","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#typescript-reports-the-wrong-callback-value-type","content":"Keep the controlled or default value and callback signatures consistent. When inference is unavailable, provide the generic explicitly: `<RangeField<number>>` for a scalar or `<RangeField<number[]>>` for an array."},"1235":{"id":"/docs/components/range-field-51","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-controlled-thumbs-do-not-move","content":"The `value` prop is the source of truth. Update the scalar or array in `onChange` without changing its intended shape. For arrays, return a new array so application state observes the update."},"1236":{"id":"/docs/components/range-field-52","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#values-snap-unexpectedly","content":"Verify that `step` represents the intended interval from `minValue`. Every thumb snaps to valid positions on the same configured scale."},"1237":{"id":"/docs/components/range-field-53","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-final-marker-is-missing","content":"Markers begin at `minValue` and appear at complete step positions. `maxValue` receives a marker only when the range is evenly divisible by `step`."},"1238":{"id":"/docs/components/range-field-54","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#markers-are-crowded-or-rendering-is-slow","content":"Increase `step` or omit `markers`. Large ranges with small steps can produce many decorative elements even when users cannot distinguish them visually."},"1239":{"id":"/docs/components/range-field-55","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-value-or-endpoint-labels-are-blank","content":"Enable automatic current-value output with `valueLabel={true}` or provide custom content. `minLabel` and `maxLabel` display only explicitly supplied content; neither defaults to a numeric bound or receives `formatOptions`."},"1240":{"id":"/docs/components/range-field-56","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#negative-values-do-not-behave-as-expected","content":"Negative values are supported. Set a negative `minValue` and ensure every scalar or array value remains within the configured bounds."},"1241":{"id":"/docs/components/range-field-57","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-range-configuration-is-invalid","content":"Provide finite bounds where `minValue` is less than `maxValue`, a finite `step` greater than zero, and finite values inside the configured range."},"1242":{"id":"/docs/components/responsive","page_id":"/docs/components/responsive","type":"page","content":"Responsive","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/responsive"},"1243":{"id":"/docs/components/responsive-0","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive","content":"How Antares components adapt, and how to build responsive layouts around them with native CSS."},"1244":{"id":"/docs/components/responsive-1","page_id":"/docs/components/responsive","type":"heading","tags":[],"url":"/docs/components/responsive#features","content":"Features"},"1245":{"id":"/docs/components/responsive-2","page_id":"/docs/components/responsive","type":"heading","tags":[],"url":"/docs/components/responsive#examples","content":"Examples"},"1246":{"id":"/docs/components/responsive-3","page_id":"/docs/components/responsive","type":"heading","tags":[],"url":"/docs/components/responsive#customization","content":"Customization"},"1247":{"id":"/docs/components/responsive-4","page_id":"/docs/components/responsive","type":"heading","tags":[],"url":"/docs/components/responsive#responsive-size-1","content":"Responsive size"},"1248":{"id":"/docs/components/responsive-5","page_id":"/docs/components/responsive","type":"heading","tags":[],"url":"/docs/components/responsive#accessibility","content":"Accessibility"},"1249":{"id":"/docs/components/responsive-6","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#features","content":"Components adapt to the space they are given with intrinsic CSS and container queries."},"1250":{"id":"/docs/components/responsive-7","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#features","content":"Page layout stays in your CSS, with your own media queries and breakpoints."},"1251":{"id":"/docs/components/responsive-8","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#features","content":"Component sizes can follow `--antares-size`, so your CSS can change them at any breakpoint."},"1252":{"id":"/docs/components/responsive-9","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#features","content":"Responsive styles are plain CSS, so server rendering needs no viewport guess."},"1253":{"id":"/docs/components/responsive-10","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#examples","content":"import { Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './responsive.stories.tsx';\n\n<Me"},"1254":{"id":"/docs/components/responsive-11","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#examples","content":"import { Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './responsive.stories.tsx';\n\n\n\n## Features\n\n- Components adapt to the space they are given with intrinsic CSS a"},"1255":{"id":"/docs/components/responsive-12","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#customization","content":"Antares publishes no viewport breakpoints. Components don't change by viewport width, except overlays\nsuch as Modal and Drawer, which document their own thresholds. Choose the breakpoints your layout needs,\nand write them in your own media or container queries."},"1256":{"id":"/docs/components/responsive-13","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#customization","content":"The examples include their CSS in `<style>` blocks so the complete code is visible. Applications can\nplace those rules in their own stylesheets. Layout props such as `columns` and `gap` write inline styles,\nwhich beat stylesheet rules. When your CSS changes a property across a query, set it in CSS for every\nwidth and leave the prop unset."},"1257":{"id":"/docs/components/responsive-14","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#customization","content":"A container can't take its width from its content, so give it one from its parent, as the container\nexample does with the `flex` basis of its sidebar and main area. Otherwise it collapses in flex rows and\nother shrink-to-fit layouts. Portaled content is outside the container, so it needs a container in its\nown DOM ancestry."},"1258":{"id":"/docs/components/responsive-15","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#customization","content":"In media queries, `rem` uses the browser's initial font size."},"1259":{"id":"/docs/components/responsive-16","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#responsive-size-1","content":"Component props, including `size`, take a single value. For a size that changes with the layout, leave\n`size` unset and set `--antares-size` in your CSS. TextLockup reads it for its text parts, so you can set\nthe variable on the lockup itself or an ancestor. The responsive size example sets it on a parent. The\nnearest value wins, and an explicit `size` beats it. Without the variable, components follow the\nsurrounding `SizeProvider`. Browsers without container style queries ignore the variable."},"1260":{"id":"/docs/components/responsive-17","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#responsive-size-1","content":"These components follow `--antares-size`:"},"1261":{"id":"/docs/components/responsive-18","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#responsive-size-1","content":"| Component    | Values     | Notes                               |\n| ------------ | ---------- | ----------------------------------- |\n| `TextLockup` | `xs`-`2xl` | A `Tag` eyebrow keeps its own size. |","table":"table-0"},"1262":{"id":"/docs/components/responsive-19","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#accessibility","content":"Preserve reading order, keyboard focus, and entered values as layouts change: reflow one DOM tree with\nCSS instead of rendering different trees. Validate layouts with long text, RTL, narrow widths, text\nenlargement, and browser zoom. Resizing the viewport alone does not test every effect of zoom. Use\npointer and hover media features to detect input capabilities, not widths."},"1263":{"id":"/docs/components/segmented-controller","page_id":"/docs/components/segmented-controller","type":"page","content":"SegmentedController","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/segmented-controller"},"1264":{"id":"/docs/components/segmented-controller-0","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller","content":"A segmented controller is a linear set of two or more segments, each of which functions as a button. A segmented controller allows users to select options, switch views, or sort elements."},"1265":{"id":"/docs/components/segmented-controller-1","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#installation","content":"Installation"},"1266":{"id":"/docs/components/segmented-controller-2","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#examples","content":"Examples"},"1267":{"id":"/docs/components/segmented-controller-3","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#customization","content":"Customization"},"1268":{"id":"/docs/components/segmented-controller-4","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#data-attributes","content":"Data Attributes"},"1269":{"id":"/docs/components/segmented-controller-5","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#accessibility","content":"Accessibility"},"1270":{"id":"/docs/components/segmented-controller-6","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#keyboard-navigation","content":"Keyboard Navigation"},"1271":{"id":"/docs/components/segmented-controller-7","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#aria-support","content":"ARIA Support"},"1272":{"id":"/docs/components/segmented-controller-8","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#best-practices","content":"Best Practices"},"1273":{"id":"/docs/components/segmented-controller-9","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#when-to-use-a-segmented-controller","content":"When to Use a Segmented Controller"},"1274":{"id":"/docs/components/segmented-controller-10","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#when-not-to-use","content":"When Not to Use"},"1275":{"id":"/docs/components/segmented-controller-11","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#props","content":"Props"},"1276":{"id":"/docs/components/segmented-controller-12","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#segmentedcontroller","content":"SegmentedController"},"1277":{"id":"/docs/components/segmented-controller-13","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#segmentedcontrolleritem","content":"SegmentedControllerItem"},"1278":{"id":"/docs/components/segmented-controller-14","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runt"},"1279":{"id":"/docs/components/segmented-controller-15","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime'"},"1280":{"id":"/docs/components/segmented-controller-16","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './segmented-controller.stories.ts"},"1281":{"id":"/docs/components/segmented-controller-17","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#data-attributes","content":"Components automatically add data attributes for styling different states:"},"1282":{"id":"/docs/components/segmented-controller-18","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#data-attributes","content":"**SegmentedController Container:** `data-disabled`"},"1283":{"id":"/docs/components/segmented-controller-19","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#data-attributes","content":"**SegmentedControllerItem:** `data-selected`, `data-hovered`, `data-pressed`, `data-focus-visible`, `data-disabled`"},"1284":{"id":"/docs/components/segmented-controller-20","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#keyboard-navigation","content":"**Tab**: Moves focus to/from the segmented controller"},"1285":{"id":"/docs/components/segmented-controller-21","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#keyboard-navigation","content":"**Arrow Left/Right**: Move to next/previous segment"},"1286":{"id":"/docs/components/segmented-controller-22","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#keyboard-navigation","content":"**Space/Enter**: Select the focused segment"},"1287":{"id":"/docs/components/segmented-controller-23","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#aria-support","content":"`role=\"radiogroup\"` on the container"},"1288":{"id":"/docs/components/segmented-controller-24","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#aria-support","content":"`role=\"radio\"` on each segment"},"1289":{"id":"/docs/components/segmented-controller-25","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#aria-support","content":"`aria-checked` indicates selection state"},"1290":{"id":"/docs/components/segmented-controller-26","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#aria-support","content":"`aria-disabled` for disabled segments"},"1291":{"id":"/docs/components/segmented-controller-27","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#aria-support","content":"`aria-label` required on the container for screen readers"},"1292":{"id":"/docs/components/segmented-controller-28","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#when-to-use-a-segmented-controller","content":"When switching between 2-5 related views within the same context"},"1293":{"id":"/docs/components/segmented-controller-29","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#when-to-use-a-segmented-controller","content":"When all options should be visible at once"},"1294":{"id":"/docs/components/segmented-controller-30","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#when-to-use-a-segmented-controller","content":"When the selection immediately changes the displayed content"},"1295":{"id":"/docs/components/segmented-controller-31","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#when-not-to-use","content":"For more than 5 options (use Tabs or Select instead)"},"1296":{"id":"/docs/components/segmented-controller-32","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller#when-not-to-use","content":"For form input (use RadioGroup instead)"},"1297":{"id":"/docs/components/select","page_id":"/docs/components/select","type":"page","content":"Select","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/select"},"1298":{"id":"/docs/components/select-0","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select","content":"Select is a dropdown for picking one or more values from a list of options. It renders a labeled trigger and a popover listbox, supports single and multiple selection, and submits naturally inside a form."},"1299":{"id":"/docs/components/select-1","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#features","content":"Features"},"1300":{"id":"/docs/components/select-2","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#installation","content":"Installation"},"1301":{"id":"/docs/components/select-3","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#examples","content":"Examples"},"1302":{"id":"/docs/components/select-4","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#props","content":"Props"},"1303":{"id":"/docs/components/select-5","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#select","content":"Select"},"1304":{"id":"/docs/components/select-6","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#selectoptions","content":"SelectOptions"},"1305":{"id":"/docs/components/select-7","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#selectvalue","content":"SelectValue"},"1306":{"id":"/docs/components/select-8","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#selectitem","content":"SelectItem"},"1307":{"id":"/docs/components/select-9","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Composable interior**: Compose `Label`, a `Button slot=\"trigger\"`, `SelectOptions`, and optional `Text` / `FieldError`. Nothing is added for you, and what you write keeps the order you wrote it in"},"1308":{"id":"/docs/components/select-10","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Trigger and options**: An empty `Button slot=\"trigger\"` renders the selected value and a chevron from the field. `SelectOptions` is the list in the popover the Select opens: it takes `ListBox` props (including `items` with a render function for a dynamic collection) plus `popoverProps` for the overlay. Write `Popover`, `Content`, and `ListBox` yourself to replace the whole overlay"},"1309":{"id":"/docs/components/select-11","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Composed in another field**: Use `variant=\"control\"` to sit inside another field's `Group`, as a country-code select beside a phone `Input`"},"1310":{"id":"/docs/components/select-12","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Single or multiple selection**: Set `selectionMode=\"multiple\"` to allow multiple values"},"1311":{"id":"/docs/components/select-13","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"1312":{"id":"/docs/components/select-14","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"1313":{"id":"/docs/components/select-15","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Sizes**: The field is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets the label, trigger, and options, which open at the same size even though they render in a portal. Without it, the Select follows the surrounding scope"},"1314":{"id":"/docs/components/select-16","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**Form integration**: Set `name` and the value submits as part of a native `<form>` (multiple values submit as repeated entries)"},"1315":{"id":"/docs/components/select-17","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#features","content":"**React Aria integration**: Built on React Aria Select for accessibility, keyboard navigation, and typeahead"},"1316":{"id":"/docs/components/select-18","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-d"},"1317":{"id":"/docs/components/select-19","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples"},"1318":{"id":"/docs/components/select-20","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers"},"1319":{"id":"/docs/components/select-21","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/run"},"1320":{"id":"/docs/components/size-provider","page_id":"/docs/components/size-provider","type":"page","content":"SizeProvider","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/size-provider"},"1321":{"id":"/docs/components/size-provider-0","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider","content":"Sizes a section, so the text, controls, and default spacing inside it follow one size."},"1322":{"id":"/docs/components/size-provider-1","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#features","content":"Features"},"1323":{"id":"/docs/components/size-provider-2","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#examples","content":"Examples"},"1324":{"id":"/docs/components/size-provider-3","page_id":"/docs/components/size-provider","type":"heading","tags":[],"url":"/docs/components/size-provider#props","content":"Props"},"1325":{"id":"/docs/components/size-provider-4","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"`sm`, `md`, or `lg` for the adopted components inside (listed below): their text, controls, and\ndefault spacing."},"1326":{"id":"/docs/components/size-provider-5","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"The nearest scope wins, and nested scopes replace the size rather than compounding it."},"1327":{"id":"/docs/components/size-provider-6","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"A component's own `size` prop wins for that component only."},"1328":{"id":"/docs/components/size-provider-7","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Overlays opened inside, such as Modal and Select options, open at the scope's size even though\nthey render in a portal."},"1329":{"id":"/docs/components/size-provider-8","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Renders no element, so it never affects layout. Only Antares components follow it; plain HTML\nkeeps its own typography, so put copy in `Text`."},"1330":{"id":"/docs/components/size-provider-9","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Without any scope, components use `md`."},"1331":{"id":"/docs/components/size-provider-10","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#features","content":"Adopted so far by Text, Detail, Heading, Label, Button, LinkButton, TextField, NumberField, Select,\nDatePicker, DateRangePicker, Calendar, TextLockup, Modal, Drawer, Popover, and Tooltip. Other\ncomponents keep their own size. Layout spacing props keep their meaning: `gap=\"md\"` is the layout\n`md` gap in any scope."},"1332":{"id":"/docs/components/size-provider-11","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storyboo"},"1333":{"id":"/docs/components/size-provider-12","page_id":"/docs/components/size-provider","tags":[],"type":"text","url":"/docs/components/size-provider#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories fr"},