 when focused"},"1347":{"id":"/docs/components/switch-21","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#features","content":"Optional label, positioned at the `start` or `end` of the track, or omitted entirely"},"1348":{"id":"/docs/components/switch-22","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#features","content":"Two sizes: `md` (default) and `sm`"},"1349":{"id":"/docs/components/switch-23","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#features","content":"Supports controlled (`isSelected` + `onChange`) and uncontrolled (`defaultSelected`) usage"},"1350":{"id":"/docs/components/switch-24","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#features","content":"Takes effect immediately — no form submission required"},"1351":{"id":"/docs/components/switch-25","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\ni"},"1352":{"id":"/docs/components/switch-26","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Exa"},"1353":{"id":"/docs/components/switch-27","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Exampl"},"1354":{"id":"/docs/components/switch-28","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } fr"},"1355":{"id":"/docs/components/switch-29","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#data-attributes","content":