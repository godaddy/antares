nts/tabs#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks"},"1399":{"id":"/docs/components/tabs-20","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nim"},"1400":{"id":"/docs/components/tabs-21","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/"},"1401":{"id":"/docs/components/tabs-22","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"Tabs require an accessible label on `TabList`. Use the keyboard to move between tabs with the arrow keys. Disabled tabs are skipped. Use `keyboardActivation=\"manual\"` when focus should move independently of selection."},"1402":{"id":"/docs/components/tabs-23","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"`overflowLabels` is optional and defaults to \"Previous tabs\" and \"Next tabs\". Provide localized labels when needed; they should describe the logical direction rather than physical directions like \"left\" or \"right\", as the component automatically handles RTL layouts."},"1403":{"id":"/docs/components/tabs-24","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"`TabList` must be rendered inside `Tabs` and must provide `aria-label` or `aria-labelledby`. Give each `Tab` and its corresponding `TabPanel` the same `id`; React Aria uses that key to build their accessible relationship."},"1404":{"id":"/docs/components/tabs-25","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"The component exposes state through data attributes:"},"1405":{"id":"/docs/components/tabs-26","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`Tabs`: `data-design=\"underline\"` or `data-design=\"manilla\"`."},"1406":{"id":"/docs/components/tabs-27","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`Tab`: `data-selected`, `data-hovered`, `data-pressed`, `data-focus-visible`, and `data-disabled`."},"1407":{"id":"/docs/components/tabs-28","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`TabPanel`: `data-inert` when a force-mounted inactive panel is not interactive."},"1408":{"id":"/docs/components/tabs-29","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"Use these attributes to extend styling without replacing the accessibility behavior supplied by React Aria Components. You can also use render props in `className` to style based on state (e.g., `className={({ isSelected }) => isSelected ? 'active' : ''}`)."},"1409":{"id":"/docs/components/tabs-30","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"Use `TabList`'s `containerProps` to customize the outer tab list shell, such as increasing its width."},"1410":{"id":"/docs/components/tabs-31","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Use Tabs for peer panels on the same page and URL."},"1411":{"id":"/docs/components/tabs-32","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Keep the number of tabs small enough for users to understand the available sections."},"1412":{"id":"/docs/components/tabs-33","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not use Tabs for primary application navigation or route changes."},"1413":{"id":"/docs/components/tabs-34","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not render a standalone `Tab`; compose it inside `Tabs` and `TabList`."},"1414":{"id":"/docs/components/tag","page_id":"/docs/components/tag","type":"page","content":"Tag","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tag"},"1415":{"id":"/docs/components/tag-0","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag","content":"Non-interactive labels that highlight statuses and categories."},"1416":{"id":"/docs/components/tag-1","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#installation","content":"Installation"},"1417":{"id":"/docs/components/tag-2","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#examples","content":"Examples"},"1418":{"id":"/docs/components/tag-3","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#accessibility","content":"Accessibility"},"1419":{"id":"/docs/components/tag-4","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#screen-readers","content":"Screen readers"},"1420":{"id":"/docs/components/tag-5","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#decorative-icons","content":"Decorative icons"},"1421":{"id":"/docs/components/tag-6","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#indicator-dot","content":"Indicator dot"},"1422":{"id":"/docs/components/tag-7","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#best-practices","content":"Best Practices"},"1423":{"id":"/docs/components/tag-8","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#when-to-use","content":"When to Use"},"1424":{"id":"/docs/components/tag-9","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#when-not-to-use","content":"When Not to Use"},"1425":{"id":"/docs/components/tag-10","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#props","content":"Props"},"1426":{"id":"/docs/components/tag-11","page_id":"/docs/components/tag","type":"heading","tags":[],"url":"/docs/components/tag#tag","content":"Tag"},"1427":{"id":"/docs/components/tag-12","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#examples","content":"import { ArgTypes, Meta } from '@storybook/a"},"1428":{"id":"/docs/components/tag-13","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '"},"1429":{"id":"/docs/components/tag-14","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as"},"1430":{"id":"/docs/components/tag-15","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './tag.stories.tsx';\n\n<Meta of={Stories} name=\""},"1431":{"id":"/docs/components/tag-16","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#screen-readers","content":"Tags are `<span>` elements with no special ARIA role. Screen readers announce the tag's text as part of normal page content — no extra markup is needed."},"1432":{"id":"/docs/components/tag-17","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#decorative-icons","content":"Icons passed as children must include `aria-hidden=\"true\"` so they are skipped by screen readers. The text label is the sole carrier of meaning."},"1433":{"id":"/docs/components/tag-18","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#indicator-dot","content":"The colored dot is decorative and invisible to screen readers. The text label must convey the status on its own — never rely on the dot alone to communicate meaning."},"1434":{"id":"/docs/components/tag-19","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Use the indicator style in dense layouts like tables and dashboards. Use the filled style when the tag is a prominent, standalone element on a card or hero section."},"1435":{"id":"/docs/components/tag-20","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Default to the small size in compact layouts like tables and lists. Use medium or large only when the tag needs to stand out as a primary piece of information."},"1436":{"id":"/docs/components/tag-21","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Use the inline design only within running prose. In grouped or standalone contexts, the filled style provides better visual separation."},"1437":{"id":"/docs/components/tag-22","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#best-practices","content":"Do not stack multiple tags of different emphasis on the same item. Choose the most important one — too many competing labels lose their meaning."},"1438":{"id":"/docs/components/tag-23","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Showing the status of an item on a card, table row, or list entry (e.g. \"Active\", \"Expired\", \"Pending\")"},"1439":{"id":"/docs/components/tag-24","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Categorizing or grouping content so users can scan and filter quickly (e.g. \"New\", \"Sale\", \"Beta\")"},"1440":{"id":"/docs/components/tag-25","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Surfacing metadata about an item (e.g. \"Pro\", \"Free trial\", \"Internal\")"},"1441":{"id":"/docs/components/tag-26","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-to-use","content":"Communicating priority or category in project management and collaboration tools (e.g. \"High priority\", \"In review\")"},"1442":{"id":"/docs/components/tag-27","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-not-to-use","content":"If users need to click or dismiss it — use a **Button** instead."},"1443":{"id":"/docs/components/tag-28","page_id":"/docs/components/tag","tags":[],"type":"text","url":"/docs/components/tag#when-not-to-use","content":"If the label is part of a sentence with no visual distinction — just use text."},"1444":{"id":"/docs/components/text-area","page_id":"/docs/components/text-area","type":"page","content":"TextArea","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-area"},"1445":{"id":"/docs/components/text-area-0","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area","content":"Multiline text control for use inside a field."},"1446":{"id":"/docs/components/text-area-1","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#installation","content":"Installation"},"1447":{"id":"/docs/components/text-area-2","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#examples","content":"Examples"},"1448":{"id":"/docs/components/text-area-3","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/t