,"410":{"id":"/docs/components/chip-17","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#props","content":"Props"},"411":{"id":"/docs/components/chip-18","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chip","content":"Chip"},"412":{"id":"/docs/components/chip-19","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipgroup","content":"ChipGroup"},"413":{"id":"/docs/components/chip-20","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chiplist","content":"ChipList"},"414":{"id":"/docs/components/chip-21","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipbutton","content":"ChipButton"},"415":{"id":"/docs/components/chip-22","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipGroup` + `ChipList` + `Chip` for grouped values, selection, keyboard navigation, and removal"},"416":{"id":"/docs/components/chip-23","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Toggle Chips for selecting multiple peer filters"},"417":{"id":"/docs/components/chip-24","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Removable Chips for user-added filters and input tokens"},"418":{"id":"/docs/components/chip-25","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Shared `sm`, `md`, and `lg` sizes, with optional leading icons"},"419":{"id":"/docs/components/chip-26","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipButton` for menu filters and other actions with a Chip-like appearance"},"420":{"id":"/docs/components/chip-27","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-add"},"421":{"id":"/docs/components/chip-28","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stor"},"422":{"id":"/docs/components/chip-29","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './chip.stories.tsx';\n\n<Meta of={Stories} name=\"Overview\""},"423":{"id":"/docs/components/chip-30","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#content","content":"Use a string for a simple label. For icons or other composed content, wrap the\nvisible label in `Text` and provide `textValue` for the accessible name. See\n**Toggle Chips** and **Removable Chips** above."},"424":{"id":"/docs/components/chip-31","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#selection-and-removal","content":"`ChipGroup` owns selection and removal behavior. Use a Chip render prop for\nstate-dependent content, and `Button` with `slot=\"remove\"` together with\n`onRemove` for removable items. See **Toggle Chips** and **Removable Chips**."},"425":{"id":"/docs/components/chip-32","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#layout-and-sizing","content":"Set `size` on `ChipGroup` to keep a collection consistent. `ChipList` wraps by\ndefault and accepts layout props for custom arrangements. See **Sizes**."},"426":{"id":"/docs/components/chip-33","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#button-composition","content":"Use `ChipButton` when Chip presentation is needed without collection semantics.\nCompose it with components such as `MenuTrigger`; those components continue to\nown open state, focus, and keyboard behavior. See **Menu filter trigger**."},"427":{"id":"/docs/components/chip-34","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use `Label` or `aria-label` to name the `ChipGroup`; this names the collection,\nnot its individual Chips."},"428":{"id":"/docs/components/chip-35","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Give each Chip a visible label, `textValue`, or `aria-label`. Use `textValue`\nwhen a Chip contains icons, composed content, or a render prop."},"429":{"id":"/docs/components/chip-36","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use a descriptive group label so removal actions can be announced clearly."},"430":{"id":"/docs/components/chip-37","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Keep the visible label and the accessible value synchronized."},"431":{"id":"/docs/components/chip-38","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"`ChipButton` is a real button and exposes menu state through `MenuTrigger`; provide an accessible name when the visible content is incomplete."},"432":{"id":"/docs/components/chip-39","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep labels concise and let them truncate only when the available width requires it."},"433":{"id":"/docs/components/chip-40","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Prefer groups of three or more related values."},"434":{"id":"/docs/components/chip-41","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep one size per group."},"435":{"id":"/docs/components/chip-42","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Let `ChipList` wrap instead of forcing a single horizontal line."},"436":{"id":"/docs/components/chip-43","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Use removable Chips for user-added filters and tokens."},"437":{"id":"/docs/components/chip-44","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"For menu filters, use `ChipButton` with `MenuTrigger` and provide the chevron explicitly."},"438":{"id":"/docs/components/chip-45","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"Add a visible `Label` to the group or provide `aria-label`. For an individual Chip\nwith composed content, provide a visible label, `textValue`, or `aria-label`."},"439":{"id":"/docs/components/chip-46","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"Add `onRemove` to `ChipGroup` and remove the returned keys from the collection\nowned by your application."},"440":{"id":"/docs/components/chip-47","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"Keep the label in `Text`, preserve `textValue`, and constrain the available width\nof the surrounding layout. Truncation is visual; the complete accessible value\nshould remain available."},"441":{"id":"/docs/components/chip-48","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-menu-trigge