9":{"id":"/docs/components/tabs-11","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#customization","content":"Customization"},"1530":{"id":"/docs/components/tabs-12","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#best-practices","content":"Best Practices"},"1531":{"id":"/docs/components/tabs-13","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#props","content":"Props"},"1532":{"id":"/docs/components/tabs-14","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#tabs","content":"Tabs"},"1533":{"id":"/docs/components/tabs-15","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#tablist","content":"TabList"},"1534":{"id":"/docs/components/tabs-16","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#tab","content":"Tab"},"1535":{"id":"/docs/components/tabs-17","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#tabpanels","content":"TabPanels"},"1536":{"id":"/docs/components/tabs-18","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#tabpanel","content":"TabPanel"},"1537":{"id":"/docs/components/tabs-19","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Accessible Tabs semantics powered by React Aria Components."},"1538":{"id":"/docs/components/tabs-20","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Underline and Manilla visual treatments."},"1539":{"id":"/docs/components/tabs-21","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Controlled and uncontrolled selection."},"1540":{"id":"/docs/components/tabs-22","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Automatic horizontal overflow controls that move one tab at a time."},"1541":{"id":"/docs/components/tabs-23","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Localized labels for the automatic overflow controls."},"1542":{"id":"/docs/components/tabs-24","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#default","content":"Switch between peer sections of content on the same page."},"1543":{"id":"/docs/components/tabs-25","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#controlled","content":"Control the selected panel from application state."},"1544":{"id":"/docs/components/tabs-26","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#disabled","content":"Disable a section while keeping the remaining sections available."},"1545":{"id":"/docs/components/tabs-27","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#manilla","content":"Use the folder-style Manilla treatment for document-oriented sections."},"1546":{"id":"/docs/components/tabs-28","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#overflow","content":"When the tab strip is narrower than its content, the group adds controls that move one tab at a time."},"1547":{"id":"/docs/components/tabs-29","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#rtl","content":"Overflow controls follow the logical reading direction."},"1548":{"id":"/docs/components/tabs-30","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"Tabs require an accessible label on `TabList`. Use the keyboard to move between tabs with the arrow keys. Disabled tabs are skipped. Use `keyboardActivation=\"manual\"` when focus should move independently of selection."},"1549":{"id":"/docs/components/tabs-31","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"`overflowLabels` is optional and defaults to \"Previous tabs\" and \"Next tabs\". Provide localized labels when needed; they should describe the logical direction rather than physical directions like \"left\" or \"right\", as the component automatically handles RTL layouts."},"1550":{"id":"/docs/components/tabs-32","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"`TabList` must be rendered inside `Tabs` and must provide `aria-label` or `aria-labelledby`. Give each `Tab` and its corresponding `TabPanel` the same `id`; React Aria uses that key to build their accessible relationship."},"1551":{"id":"/docs/components/tabs-33","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"The component exposes state through data attributes:"},"1552":{"id":"/docs/components/tabs-34","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`Tabs`: `data-design=\"underline\"` or `data-design=\"manilla\"`."},"1553":{"id":"/docs/components/tabs-35","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`Tab`: `data-selected`, `data-hovered`, `data-pressed`, `data-focus-visible`, and `data-disabled`."},"1554":{"id":"/docs/components/tabs-36","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`TabPanel`: `data-inert` when a force-mounted inactive panel is not interactive."},"1555":{"id":"/docs/components/tabs-37","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"Use these attributes to extend styling without replacing the accessibility behavior supplied by React Aria Components. You can also use render props in `className` to style based on state (e.g., `className={({ isSelected }) => isSelected ? 'active' : ''}`)."},"1556":{"id":"/docs/components/tabs-38","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"Use `TabList`'s `containerProps` to customize the outer tab list shell, such as increasing its width."},"1557":{"id":"/docs/components/tabs-39","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Use Tabs for peer panels on the same page and URL."},"1558":{"id":"/docs/components/tabs-40","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Keep the number of tabs small enough for users to understand the available sections."},"1559":{"id":"/docs/components/tabs-41","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not use Tabs for primary application navigation or route changes."},"1560":{"id":"/docs/components/tabs-42","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not render a standalone `Tab`; compose it inside `Tabs` and `TabList`."},"1561":{"id":"/docs/components/text","page_id":"/docs/components/text","type":"page","content":"Text","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text"},"1562":{"id":"/docs/components/text-0","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text","content":"Body copy and supporting detail, with size, emphasis, alignment, and truncation options"},"1563":{"id":"/docs/components/text-1","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#features","content":"Features"},"1564":{"id":"/docs/components/text-2","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#installation","content":"Installation"},"1565":{"id":"/docs/components/text-3","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#examples","content":"Examples"},"1566":{"id":"/docs/components/text-4","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#default","content":"Default"},"1567":{"id":"/docs/components/text-5","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#as","content":"As"},"1568":{"id":"/docs/components/text-6","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#align","content":"Align"},"1569":{"id":"/docs/components/text-7","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#max-lines","content":"Max Lines"},"1570":{"id":"/docs/components/text-8","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#wrap","content":"Wrap"},"1571":{"id":"/docs/components/text-9","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#sizes","content":"Sizes"},"1572":{"id":"/docs/components/text-10","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#emphasis","content":"Emphasis"},"1573":{"id":"/docs/components/text-11","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#detail","content":"Detail"},"1574":{"id":"/docs/components/text-12","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#props","content":"Props"},"1575":{"id":"/docs/components/text-13","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#text","content":"Text"},"1576":{"id":"/docs/components/text-14","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#detail-1","content":"Detail"},"1577":{"id":"/docs/components/text-15","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text","content":"`Text` is body copy and `Detail` is supporting copy: captions, metadata, and hints."},"1578":{"id":"/docs/components/text-16","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`Text` applies the body role and `Detail` the detail role, each at the tier of the nearest\n`SizeProvider`, or `md` outside any scope."},"1579":{"id":"/docs/components/text-17","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"Inside a component's named part, such as a field description or a lockup body, the part sets the\ntreatment. Inside a control, the label keeps the control's type, so\n`<Button><Text>Save</Text></Button>` looks exactly like `<Button>Save</Button>`."},"1580":{"id":"/docs/components/text-18","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`size` picks a step on the component's own ramp (`xs` to `2xl`) and changes only the font size."},"1581":{"id":"/docs/components/text-19","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`emphasis` picks a feedback color and changes only the color."},"1582":{"id":"/docs/components/text-20","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"For semantic emphasis, render `as=\"strong\"` or `as=\"em\"`."},"1583":{"id":"/docs/components/text-21","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#default","content":"Basic text content."},"1584":{"id":"/docs/components/text-22","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#as","content":"Setting the `as` prop allows you to change the HTML tag of the `Text` component."},"1585":{"id":"/docs/components/text-23","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#align","content":"Setting the `align` prop allows you to change the alignment of the text. Choose from `start`, `center`, `end`, or `justify`; the logical keywords support RTL languages."},"1586":{"id":"/docs/components/text-24","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#max-lines","content":"Setting the `maxLines` prop limits the number of displayed lines using an ellipsis."},"1587":{"id":"/docs/components/text-25","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#wrap","content":"Setting the `wrap` prop controls text wrapping with values such as `wrap`, `nowrap`, `balance`, `pretty`, or `stable`."},"1588":{"id":"/docs/components/text-26","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#sizes","content":"Without `size`, text takes the scope's body tier, or `md` outside any scope. `size` picks a step\non the body ramp and changes only the font size."},"1589":{"id":"/docs/components/text-27","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#emphasis","content":"`emphasis` selects a feedback color and changes nothing else. Without it, text inherits the\nsurrounding color."},"1590":{"id":"/docs/components/text-28","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#detail","content":"`Detail` is supporting copy, such as captions and metadata, on the detail ramp. It keeps the\nsurrounding color; add `emphasis=\"passive\"` to mute it."},"1591":{"id":"/docs/components/text-area","page_id":"/docs/components/text-area","type":"page","content":"TextArea","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-area"},"1592":{"id":"/docs/components/text-area-0","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area","content":"Multiline text control for use inside a field."},"1593":{"id":"/docs/components/text-area-1","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#installation","content":"Installation"},"1594":{"id":"/docs/components/text-area-2","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#examples","content":"Examples"},"1595":{"id":"/docs/components/text-area-3","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#default","content":"Default"},"1596":{"id":"/docs/components/text-area-4","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#props","content":"Props"},"1597":{"id":"/docs/components/text-area-5","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#textarea","content":"TextArea"},"1598":{"id":"/docs/components/text-area-6","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area","content":"`TextArea` is the multiline control inside a field, not a field on its own. Prefer `TextField` as the parent; see that component for fuller examples."},"1599":{"id":"/docs/components/text-area-7","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area#default","content":"TextArea inside TextField."},"1600":{"id":"/docs/components/text-field","page_id":"/docs/components/text-field","type":"page","content":"TextField","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-field"},"1601":{"id":"/docs/components/text-field-0","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field","content":"TextField is a composed single-line or multiline text input. Use it in forms for short answers (email, search, name) or longer content (comments)."},"1602":{"id":"/docs/components/text-field-1","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#features","content":"Features"},"1603":{"id":"/docs/components/text-field-2","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#installation","content":"Installation"},"1604":{"id":"/docs/components/text-field-3","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#examples","content":"Examples"},"1605":{"id":"/docs/components/text-field-4","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#default","content":"Default"},"1606":{"id":"/docs/components/text-field-5","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#controlled","content":"Controlled"},"1607":{"id":"/docs/components/text-field-6","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#invalid","content":"Invalid"},"1608":{"id":"/docs/components/text-field-7","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#disabled","content":"Disabled"},"1609":{"id":"/docs/components/text-field-8","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#adornments","content":"Adornments"},"1610":{"id":"/docs/components/text-field-9","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#multiline","content":"Multiline"},"1611":{"id":"/docs/components/text-field-10","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#sizes","content":"Sizes"},"1612":{"id":"/docs/components/text-field-11","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#controls-and-icons","content":"Controls and icons"},"1613":{"id":"/docs/components/text-field-12","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#telephone-field","content":"Telephone Field"},"1614":{"id":"/docs/components/text-field-13","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#blocks","content":"Blocks"},"1615":{"id":"/docs/components/text-field-14","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#props","content":"Props"},"1616":{"id":"/docs/components/text-field-15","page_id":"/docs/components/text-field","type":"heading","tags":[],"url":"/docs/components/text-field#textfield","content":"TextField"},"1617":{"id":"/docs/components/text-field-16","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Composable interior**: Compose `Label`, `Input` or `TextArea`, `Text slot=\"description\"`, and `FieldError`. Omitting `Group` leaves the control as a direct field child with box chrome. Use an explicit `Group` for controls or adornments"},"1618":{"id":"/docs/components/text-field-17","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Adornments**: Fixed text or icons before or after the input (e.g. `$`, `.00`, `px`) are composed inside `Group`, positioned by source order"},"1619":{"id":"/docs/components/text-field-18","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controls**: A `Button slot=\"control\"` beside the input is an interactive affix; it picks up field chrome from context"},"1620":{"id":"/docs/components/text-field-19","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Controlled or uncontrolled**: Use `value` and `onChange` for controlled state, or `defaultValue` for uncontrolled"},"1621":{"id":"/docs/components/text-field-20","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Multiline**: Compose a `TextArea` instead of an `Input` for multiline entry"},"1622":{"id":"/docs/components/text-field-21","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Validation states**: Use `isInvalid` with a `FieldError` and `isDisabled` for validation and disabled state"},"1623":{"id":"/docs/components/text-field-22","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#features","content":"**Sizes**: The field is a `SizeProvider`. `size` (`sm`, `md`, `lg`) sets its label, input, description, error, and composed controls; without it, the field follows the surrounding scope. An explicit `size` on a part still wins for that part"},"1624":{"id":"/docs/components/text-field-23","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#default","content":"Minimal usage: a `Label` and an `Input`."},"1625":{"id":"/docs/components/text-field-24","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#controlled","content":"Use `value` and `onChange` for controlled state."},"1626":{"id":"/docs/components/text-field-25","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#invalid","content":"Use `isInvalid` with a `FieldError` for validation feedback."},"1627":{"id":"/docs/components/text-field-26","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#disabled","content":"Use `isDisabled` to prevent input."},"1628":{"id":"/docs/components/text-field-27","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#adornments","content":"Fixed text before and after the input, such as currency. Leading and trailing content is\ncomposed inside the `Group` and its position comes from source order."},"1629":{"id":"/docs/components/text-field-28","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#multiline","content":"Compose a `TextArea` instead of an `Input` for multiline entry."},"1630":{"id":"/docs/components/text-field-29","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#sizes","content":"`size` sets the label, input, description, and any control composed inside. Without it, the\nfield follows the surrounding size scope."},"1631":{"id":"/docs/components/text-field-30","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#controls-and-icons","content":"Put a control or an icon beside the input. A `Button slot=\"control\"` is an\ninteractive affix; static content is wrapped in a `Flex as=\"span\"` to center it and give it a gutter."},"1632":{"id":"/docs/components/text-field-31","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#telephone-field","content":"Compose a telephone number input paired with a country-code select."},"1633":{"id":"/docs/components/text-field-32","page_id":"/docs/components/text-field","tags":[],"type":"text","url":"/docs/components/text-field#blocks","content":"sign-in-form"},"1634":{"id":"/docs/components/text-lockup","page_id":"/docs/components/text-lockup","type":"page","content":"TextLockup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-lockup"},"1635":{"id":"/docs/components/text-lockup-0","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup","content":"TextLockup stacks an eyebrow, title, and body text as one coordinated type group across six sizes."},"1636":{"id":"/docs/components/text-lockup-1","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#features","content":"Features"},"1637":{"id":"/docs/components/text-lockup-2","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#installation","content":"Installation"},"1638":{"id":"/docs/components/text-lockup-3","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#examples","content":"Examples"},"1639":{"id":"/docs/components/text-lockup-4","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#default","content":"Default"},"1640":{"id":"/docs/components/text-lockup-5","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#sizes","content":"Sizes"},"1641":{"id":"/docs/components/text-lockup-6","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#tag-eyebrow","content":"Tag Eyebrow"},"1642":{"id":"/docs/components/text-lockup-7","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#alignment","content":"Alignment"},"1643":{"id":"/docs/components/text-lockup-8","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#legible-lines","content":"Legible Lines"},"1644":{"id":"/docs/components/text-lockup-9","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#with-actions","content":"With Actions"},"1645":{"id":"/docs/components/text-lockup-10","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#customization","content":"Customization"},"1646":{"id":"/docs/components/text-lockup-11","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#accessibility","content":"Accessibility"},"1647":{"id":"/docs/components/text-lockup-12","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#best-practices","content":"Best Practices"},"1648":{"id":"/docs/components/text-lockup-13","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#props","content":"Props"},"1649":{"id":"/docs/components/text-lockup-14","page_id":"/docs/components/text-lockup","type":"heading","tags":[],"url":"/docs/components/text-lockup#textlockup","content":"TextLockup"},"1650":{"id":"/docs/components/text-lockup-15","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Six coordinated sizes, from a `2xl` page title down to `xs`"},"1651":{"id":"/docs/components/text-lockup-16","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"An eyebrow that takes plain text or a `Tag`, sized to match the lockup"},"1652":{"id":"/docs/components/text-lockup-17","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Slotted parts, so nested components keep their own type"},"1653":{"id":"/docs/components/text-lockup-18","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Any heading level, chosen independently of the visual size"},"1654":{"id":"/docs/components/text-lockup-19","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"Start or center alignment"},"1655":{"id":"/docs/components/text-lockup-20","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#features","content":"A legible line-length clamp, on by default"},"1656":{"id":"/docs/components/text-lockup-21","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#default","content":"A lockup stacks an optional eyebrow, a title and body text as one coordinated type\ngroup. You supply the parts, so the title can be any heading level and the body any\nnumber of paragraphs; `size` sets the tier for all of them at once."},"1657":{"id":"/docs/components/text-lockup-22","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#sizes","content":"`size` sets every part, each on its own role ramp. Without it, the lockup follows the size\nscope."},"1658":{"id":"/docs/components/text-lockup-23","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#tag-eyebrow","content":"The eyebrow takes either plain text or a `Tag`. Both use `slot=\"eyebrow\"`, so the two\nforms swap freely, and the lockup pairs the tag's `size` with its own."},"1659":{"id":"/docs/components/text-lockup-24","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#alignment","content":"`align` centers the parts as well as the text, so a `Tag` eyebrow stays centered too."},"1660":{"id":"/docs/components/text-lockup-25","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#legible-lines","content":"The text parts are constrained to a comfortable line length by default. Set\n`legibleLines={false}` to let them run the full width of their container, which suits a\nlockup already inside a narrow column. Both lockups below share one wide container, so the\nclamp is what makes the first one narrower."},"1661":{"id":"/docs/components/text-lockup-26","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#with-actions","content":"Because you compose the parts, anything else can sit alongside them — a call to action\nhere. Controls keep their own type: the buttons are unaffected by the lockup's `size`."},"1662":{"id":"/docs/components/text-lockup-27","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"`TextLockup` positions and type-sets its parts; you supply them. That means anything else can\nsit alongside them — a call to action, a second paragraph, an image — without the component\ngrowing a prop for it."},"1663":{"id":"/docs/components/text-lockup-28","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**Every part names its role with a slot**: `eyebrow`, `title`, `body`. Unslotted text follows\nthe lockup's tier too: a bare `Heading` takes the title tier and a bare `Text` the body tier."},"1664":{"id":"/docs/components/text-lockup-29","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The eyebrow is `slot=\"eyebrow\"`**, on either a `Text` or a `Tag`. The two forms swap\nfreely, and a `Tag` is sized to pair with the lockup."},"1665":{"id":"/docs/components/text-lockup-30","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The title is `<Heading slot=\"title\">`.** Pick the level from the document outline, not the\nvisual size: `size` handles the visuals, so `level={1}` in an `xs` lockup is perfectly valid."},"1666":{"id":"/docs/components/text-lockup-31","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**The body is `<Text slot=\"body\">`**, once or as many times as the copy needs."},"1667":{"id":"/docs/components/text-lockup-32","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**An explicit prop on a child always wins** over what the lockup supplies. Pass\n`<Tag slot=\"eyebrow\" size=\"sm\">` to break the pairing, for instance."},"1668":{"id":"/docs/components/text-lockup-33","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**Controls keep the scale size.** A `Button` inside a lockup follows the surrounding\n`SizeProvider` or its own `size` prop, never the lockup's tier."},"1669":{"id":"/docs/components/text-lockup-34","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"**`size` is the tier.** The eyebrow reads it on the `detail` ramp, the title on `heading`, and\nthe body on `body`, so there is no table to memorize. Without `size`, the lockup follows the\nsurrounding size scope. A tier is the same at every container width."},"1670":{"id":"/docs/components/text-lockup-35","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#customization","content":"Pass `className` to extend the styles, or select on `[data-align]`."},"1671":{"id":"/docs/components/text-lockup-36","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"The title carries the heading semantics. Choose `level` so the page outline stays correct\nrather than to achieve a size."},"1672":{"id":"/docs/components/text-lockup-37","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"Slots resolve against the lockup, so `slot=\"title\"` names the lockup's title, not an outer\ncontainer's. Inside a\n`Modal`, `Drawer` or `Popover`, give the dialog its own `<Heading slot=\"title\">` as a direct\nchild for the accessible name, and use the lockup for the body."},"1673":{"id":"/docs/components/text-lockup-38","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#accessibility","content":"The eyebrow is decorative in most designs. If it carries meaning, make sure the title still\nreads sensibly on its own, since screen reader users often navigate by heading."},"1674":{"id":"/docs/components/text-lockup-39","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Use one `2xl` lockup per page at most — it is the page title."},"1675":{"id":"/docs/components/text-lockup-40","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Keep `legibleLines` on for running prose. Turn it off only when the lockup already sits in a\nnarrow column, where the clamp does nothing but complicate the layout."},"1676":{"id":"/docs/components/text-lockup-41","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Prefer a `Tag` eyebrow for status or category, and plain text for a kicker or section label."},"1677":{"id":"/docs/components/text-lockup-42","page_id":"/docs/components/text-lockup","tags":[],"type":"text","url":"/docs/components/text-lockup#best-practices","content":"Reach for `MetricsLockup` instead when the emphasis is a single number rather than prose."},"1678":{"id":"/docs/components/toggle-button","page_id":"/docs/components/toggle-button","type":"page","content":"ToggleButton","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/toggle-button"},"1679":{"id":"/docs/components/toggle-button-0","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button","content":"Accessible toggle button component for grouped contextual actions with single or multiple selection, keyboard navigation, and RTL-aware layouts."},"1680":{"id":"/docs/components/toggle-button-1","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#installation","content":"Installation"},"1681":{"id":"/docs/components/toggle-button-2","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#examples","content":"Examples"},"1682":{"id":"/docs/components/toggle-button-3","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#default","content":"Default"},"1683":{"id":"/docs/components/toggle-button-4","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#multiple-selection","content":"Multiple Selection"},"1684":{"id":"/docs/components/toggle-button-5","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#controlled","content":"Controlled"},"1685":{"id":"/docs/components/toggle-button-6","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#disabled-states","content":"Disabled States"},"1686":{"id":"/docs/components/toggle-button-7","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#sizes","content":"Sizes"},"1687":{"id":"/docs/components/toggle-button-8","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#icon--text","content":"Icon + Text"},"1688":{"id":"/docs/components/toggle-button-9","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#icon-only","content":"Icon Only"},"1689":{"id":"/docs/components/toggle-button-10","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#with-dropdown","content":"With Dropdown"},"1690":{"id":"/docs/components/toggle-button-11","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#rtl-direction","content":"RTL Direction"},"1691":{"id":"/docs/components/toggle-button-12","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#customization","content":"Customization"},"1692":{"id":"/docs/components/toggle-button-13","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#data-attributes","content":"Data Attributes"},"1693":{"id":"/docs/components/toggle-button-14","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#component-customization","content":"Component Customization"},"1694":{"id":"/docs/components/toggle-button-15","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#accessibility","content":"Accessibility"},"1695":{"id":"/docs/components/toggle-button-16","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#keyboard-navigation","content":"Keyboard Navigation"},"1696":{"id":"/docs/components/toggle-button-17","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#aria-support","content":"ARIA Support"},"1697":{"id":"/docs/components/toggle-button-18","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#troubleshooting","content":"Troubleshooting"},"1698":{"id":"/docs/components/toggle-button-19","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#selection-not-updating","content":"Selection Not Updating"},"1699":{"id":"/docs/components/toggle-button-20","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#styling-overrides-not-applying","content":"Styling Overrides Not Applying"},"1700":{"id":"/docs/components/toggle-button-21","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#keyboard-navigation-not-working","content":"Keyboard Navigation Not Working"},"1701":{"id":"/docs/components/toggle-button-22","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#best-practices","content":"Best Practices"},"1702":{"id":"/docs/components/toggle-button-23","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#when-to-use","content":"When to Use"},"1703":{"id":"/docs/components/toggle-button-24","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#keep-variants-consistent","content":"Keep Variants Consistent"},"1704":{"id":"/docs/components/toggle-button-25","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#balance-label-lengths","content":"Balance Label Lengths"},"1705":{"id":"/docs/components/toggle-button-26","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#alignment","content":"Alignment"},"1706":{"id":"/docs/components/toggle-button-27","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#label-guidelines","content":"Label Guidelines"},"1707":{"id":"/docs/components/toggle-button-28","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#icon-only-items","content":"Icon-Only Items"},"1708":{"id":"/docs/components/toggle-button-29","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#props","content":"Props"},"1709":{"id":"/docs/components/toggle-button-30","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#togglebuttongroup","content":"ToggleButtonGroup"},"1710":{"id":"/docs/components/toggle-button-31","page_id":"/docs/components/toggle-button","type":"heading","tags":[],"url":"/docs/components/toggle-button#togglebutton","content":"ToggleButton"},"1711":{"id":"/docs/components/toggle-button-32","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#default","content":"A `ToggleButton` toggles between selected and unselected. Wrap multiple inside a `ToggleButtonGroup` to link them with shared selection and keyboard navigation."},"1712":{"id":"/docs/components/toggle-button-33","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#multiple-selection","content":"Use `selectionMode=\"multiple\"` to allow more than one item to be active at a time."},"1713":{"id":"/docs/components/toggle-button-34","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#controlled","content":"Use `selectedKeys` and `onSelectionChange` to control selection from parent state."},"1714":{"id":"/docs/components/toggle-button-35","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#disabled-states","content":"Disable the entire group with `isDisabled` on the container, or disable individual items with `isDisabled` on specific `ToggleButton` elements."},"1715":{"id":"/docs/components/toggle-button-36","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#sizes","content":"Two sizes are available: `sm` and `md` (default)."},"1716":{"id":"/docs/components/toggle-button-37","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#icon--text","content":"Items can include an `Icon` alongside text for added visual context."},"1717":{"id":"/docs/components/toggle-button-38","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#icon-only","content":"For compact layouts, items can contain only icons. Always provide an `aria-label` on each icon-only item."},"1718":{"id":"/docs/components/toggle-button-39","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#with-dropdown","content":"Wrap a `ToggleButton` in a `MenuTrigger` to add sub-options to a group item."},"1719":{"id":"/docs/components/toggle-button-40","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#rtl-direction","content":"The group follows the document's layout direction, detected automatically from the browser locale."},"1720":{"id":"/docs/components/toggle-button-41","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#data-attributes","content":"Components automatically add data attributes for styling different states:"},"1721":{"id":"/docs/components/toggle-button-42","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#data-attributes","content":"**ToggleButtonGroup Container:** `data-size`"},"1722":{"id":"/docs/components/toggle-button-43","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#data-attributes","content":"**ToggleButton Item:** `data-selected`, `data-hovered`, `data-pressed`, `data-focus-visible`, `data-disabled`"},"1723":{"id":"/docs/components/toggle-button-44","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#component-customization","content":"Individual components can be styled by passing `className` props:"},"1724":{"id":"/docs/components/toggle-button-45","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"Key"},"1725":{"id":"/docs/components/toggle-button-46","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"Action"},"1726":{"id":"/docs/components/toggle-button-47","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"**Tab**"},"1727":{"id":"/docs/components/toggle-button-48","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"Moves focus to/from the button group (single tab stop)"},"1728":{"id":"/docs/components/toggle-button-49","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"**Arrow Left / Right**"},"1729":{"id":"/docs/components/toggle-button-50","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"Move focus between items (RAC automatically reverses in RTL)"},"1730":{"id":"/docs/components/toggle-button-51","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"**Space / Enter**"},"1731":{"id":"/docs/components/toggle-button-52","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"Toggle the focused item"},"1732":{"id":"/docs/components/toggle-button-53","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"**Home**"},"1733":{"id":"/docs/components/toggle-button-54","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"Move focus to the first item"},"1734":{"id":"/docs/components/toggle-button-55","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"**End**"},"1735":{"id":"/docs/components/toggle-button-56","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keyboard-navigation","content":"Move focus to the last item"},"1736":{"id":"/docs/components/toggle-button-57","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#aria-support","content":"`selectionMode=\"single\"` → `role=\"radiogroup\"` on container, `role=\"radio\"` + `aria-checked` per item"},"1737":{"id":"/docs/components/toggle-button-58","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#aria-support","content":"`selectionMode=\"multiple\"` → `role=\"toolbar\"` on container, `role=\"button\"` + `aria-pressed` per item"},"1738":{"id":"/docs/components/toggle-button-59","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#aria-support","content":"`aria-label` (or `aria-labelledby`) is required on the group container"},"1739":{"id":"/docs/components/toggle-button-60","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#aria-support","content":"Icon-only items require `aria-label` on each `ToggleButton`"},"1740":{"id":"/docs/components/toggle-button-61","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"✅ For grouped contextual actions — two or more closely related actions that belong together (e.g. Bold / Italic / Underline, Align Left / Center / Right)"},"1741":{"id":"/docs/components/toggle-button-62","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"✅ For compact action grouping — related actions in space-constrained layouts (e.g. Undo / Redo, Zoom In / Out / Reset)"},"1742":{"id":"/docs/components/toggle-button-63","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"✅ For multi-select scenarios — when users need to select multiple options simultaneously"},"1743":{"id":"/docs/components/toggle-button-64","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"❌ For unrelated actions that perform disconnected tasks without shared context"},"1744":{"id":"/docs/components/toggle-button-65","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"❌ For more than 5 choices — cognitive overload; consider a **Select** instead"},"1745":{"id":"/docs/components/toggle-button-66","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"❌ When actions require strong visual distinction (e.g. Save vs. Delete)"},"1746":{"id":"/docs/components/toggle-button-67","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"❌ When selecting an option leads to a different page or workflow — use navigation instead"},"1747":{"id":"/docs/components/toggle-button-68","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#when-to-use","content":"❌ For mutually exclusive content views (e.g. Monthly / Yearly) — use **SegmentedController** instead"},"1748":{"id":"/docs/components/toggle-button-69","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#keep-variants-consistent","content":"Avoid mixing different content types (text-only, icon-only, icon+text) within the same group. Mixing styles creates visual noise and makes the set feel fragmented rather than unified."},"1749":{"id":"/docs/components/toggle-button-70","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#balance-label-lengths","content":"Keep button labels of similar length. Large differences in text length cause irregular button widths and make the group appear uneven. Prefer short, concise wording."},"1750":{"id":"/docs/components/toggle-button-71","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#alignment","content":"Align the group to reflect its relationship to surrounding content:"},"1751":{"id":"/docs/components/toggle-button-72","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#alignment","content":"**Left** — when the group controls content directly below or within the same column (dashboards, tables)."},"1752":{"id":"/docs/components/toggle-button-73","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#alignment","content":"**Center** — when the group acts as a prominent toggle affecting an entire section or page."},"1753":{"id":"/docs/components/toggle-button-74","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#alignment","content":"**Right** — when the group represents utility or contextual controls (e.g. grid/list view toggle)."},"1754":{"id":"/docs/components/toggle-button-75","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#label-guidelines","content":"Use **title case**: capitalize the first letter of each word, except short prepositions."},"1755":{"id":"/docs/components/toggle-button-76","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#label-guidelines","content":"Keep labels to one or two words. Omit articles (a, an, the) and filler words."},"1756":{"id":"/docs/components/toggle-button-77","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#label-guidelines","content":"Prefer action-focused or descriptive language that communicates the option instantly."},"1757":{"id":"/docs/components/toggle-button-78","page_id":"/docs/components/toggle-button","tags":[],"type":"text","url":"/docs/components/toggle-button#icon-only-items","content":"Use icon-only items only when the icon's meaning is universally recognized. Always provide an `aria-label` on each icon-only `ToggleButton`:"},"1758":{"id":"/docs/components/tooltip","page_id":"/docs/components/tooltip","type":"page","content":"Tooltip","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tooltip"},"1759":{"id":"/docs/components/tooltip-0","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip","content":"The Tooltip component displays a description of an element on hover or focus."},"1760":{"id":"/docs/components/tooltip-1","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#features","content":"Features"},"1761":{"id":"/docs/components/tooltip-2","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#installation","content":"Installation"},"1762":{"id":"/docs/components/tooltip-3","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#examples","content":"Examples"},"1763":{"id":"/docs/components/tooltip-4","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#default","content":"Default"},"1764":{"id":"/docs/components/tooltip-5","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#custom-anchor","content":"Custom Anchor"},"1765":{"id":"/docs/components/tooltip-6","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#customization","content":"Customization"},"1766":{"id":"/docs/components/tooltip-7","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#accessibility","content":"Accessibility"},"1767":{"id":"/docs/components/tooltip-8","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#keyboard","content":"Keyboard"},"1768":{"id":"/docs/components/tooltip-9","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#aria","content":"ARIA"},"1769":{"id":"/docs/components/tooltip-10","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#best-practices","content":"Best Practices"},"1770":{"id":"/docs/components/tooltip-11","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#props","content":"Props"},"1771":{"id":"/docs/components/tooltip-12","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#tooltip","content":"Tooltip"},"1772":{"id":"/docs/components/tooltip-13","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#tooltiptrigger","content":"TooltipTrigger"},"1773":{"id":"/docs/components/tooltip-14","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip","content":"Tooltips appear after a short delay when hovering, and immediately when the element receives focus.\nOnce a tooltip has been shown, subsequent tooltips appear without delay."},"1774":{"id":"/docs/components/tooltip-15","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip","content":"`TooltipTrigger` wraps a focusable element and a `<Tooltip>`, handling hover/focus state and positioning automatically."},"1775":{"id":"/docs/components/tooltip-16","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#features","content":"`overlay` elevation panel positioned relative to its trigger, with an optional arrow"},"1776":{"id":"/docs/components/tooltip-17","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#features","content":"Flips and shifts to stay in the viewport"},"1777":{"id":"/docs/components/tooltip-18","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#features","content":"Configurable open and close delays"},"1778":{"id":"/docs/components/tooltip-19","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#default","content":"Use it with `TooltipTrigger`, which wraps both the tooltip content and a focusable element such as a `Button`. The tooltip appears on hover and focus."},"1779":{"id":"/docs/components/tooltip-20","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#custom-anchor","content":"To position a tooltip relative to a different focusable element, use the `triggerRef` prop. `TooltipTrigger` still handles showing and hiding on hover and focus."},"1780":{"id":"/docs/components/tooltip-21","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#customization","content":"`className` and `style` apply to the tooltip panel."},"1781":{"id":"/docs/components/tooltip-22","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Key"},"1782":{"id":"/docs/components/tooltip-23","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Action"},"1783":{"id":"/docs/components/tooltip-24","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"`Tab`"},"1784":{"id":"/docs/components/tooltip-25","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Moves focus to the focusable element and shows the tooltip"},"1785":{"id":"/docs/components/tooltip-26","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"`Escape`"},"1786":{"id":"/docs/components/tooltip-27","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#keyboard","content":"Closes the tooltip"},"1787":{"id":"/docs/components/tooltip-28","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#aria","content":"The tooltip uses `role=\"tooltip\"` and is associated with its focusable element via `aria-describedby`"},"1788":{"id":"/docs/components/tooltip-29","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Keep tooltip content short and informative."},"1789":{"id":"/docs/components/tooltip-30","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Tooltips are not shown on touch screen interactions. Ensure your UI is usable without tooltips."},"1790":{"id":"/docs/components/tooltip-31","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#best-practices","content":"Do not place interactive content inside tooltips. Use a `Popover` instead."},"1791":{"id":"/docs/components/chart/donut-chart","page_id":"/docs/components/chart/donut-chart","type":"page","content":"DonutChart","breadcrumbs":["Docs","Components","Chart"],"tags":[],"url":"/docs/components/chart/donut-chart"},"1792":{"id":"/docs/components/chart/donut-chart-0","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart","content":"Donut charts are for parts-to-whole comparison—how partial elements add up to a total—shown as a ring so a few categories are easy to compare at a glance."},"1793":{"id":"/docs/components/chart/donut-chart-1","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#installation","content":"Installation"},"1794":{"id":"/docs/components/chart/donut-chart-2","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#examples","content":"Examples"},"1795":{"id":"/docs/components/chart/donut-chart-3","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#default","content":"Default"},"1796":{"id":"/docs/components/chart/donut-chart-4","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#single-slice","content":"Single slice"},"1797":{"id":"/docs/components/chart/donut-chart-5","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#legend-placement","content":"Legend placement"},"1798":{"id":"/docs/components/chart/donut-chart-6","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#small-slices","content":"Small slices"},"1799":{"id":"/docs/components/chart/donut-chart-7","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#format-value","content":"Format value"},"1800":{"id":"/docs/components/chart/donut-chart-8","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#props","content":"Props"},"1801":{"id":"/docs/components/chart/donut-chart-9","page_id":"/docs/components/chart/donut-chart","type":"heading","tags":[],"url":"/docs/components/chart/donut-chart#donutchart","content":"DonutChart"},"1802":{"id":"/docs/components/chart/donut-chart-10","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart#default","content":"You give the chart a `data` array (`id`, `name`, `value`) and a `label` in the middle - this is the everyday setup when you want several categories on one ring and a headline number or title in the hole."},"1803":{"id":"/docs/components/chart/donut-chart-11","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart#single-slice","content":"When there is only one slice, the ring is full. Add `subLabel` if you want a smaller second line under the main center text."},"1804":{"id":"/docs/components/chart/donut-chart-12","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart#legend-placement","content":"Switch `legend` to `right` to sit the legend beside the donut, or `bottom` to stack it underneath. `legendLabel` is there when you want a title above the legend items."},"1805":{"id":"/docs/components/chart/donut-chart-13","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart#small-slices","content":"Very thin slices can be noisy to hover. Anything at or below `smallSliceThreshold` (default `0.05` of the total) is treated as “small,” and if those slices sit next to each other on the ring, one hover opens a single tooltip that lists the whole group."},"1806":{"id":"/docs/components/chart/donut-chart-14","page_id":"/docs/components/chart/donut-chart","tags":[],"type":"text","url":"/docs/components/chart/donut-chart#format-value","content":"Use `formatValue` when the raw numbers in the tooltip should read like money, counts with separators, or whatever your product expects. The percentage of the total still formats on its own; your function only shapes the value column."},"1807":{"id":"/docs/components/chart/gauge-chart","page_id":"/docs/components/chart/gauge-chart","type":"page","content":"Gauge Chart","breadcrumbs":["Docs","Components","Chart"],"tags":[],"url":"/docs/components/chart/gauge-chart"},"1808":{"id":"/docs/components/chart/gauge-chart-0","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart","content":"A visual indicator for representing a single quantitative value within a known range, rendered as a semicircle arc in continuous or segmented mode."},"1809":{"id":"/docs/components/chart/gauge-chart-1","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#installation","content":"Installation"},"1810":{"id":"/docs/components/chart/gauge-chart-2","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#examples","content":"Examples"},"1811":{"id":"/docs/components/chart/gauge-chart-3","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#default","content":"Default"},"1812":{"id":"/docs/components/chart/gauge-chart-4","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#continuous-values","content":"Continuous Values"},"1813":{"id":"/docs/components/chart/gauge-chart-5","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#segmented","content":"Segmented"},"1814":{"id":"/docs/components/chart/gauge-chart-6","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#with-range-labels","content":"With Range Labels"},"1815":{"id":"/docs/components/chart/gauge-chart-7","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#variants","content":"Variants"},"1816":{"id":"/docs/components/chart/gauge-chart-8","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#label-type","content":"Label Type"},"1817":{"id":"/docs/components/chart/gauge-chart-9","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#troubleshooting","content":"Troubleshooting"},"1818":{"id":"/docs/components/chart/gauge-chart-10","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#gauge-not-sizing-correctly","content":"Gauge Not Sizing Correctly"},"1819":{"id":"/docs/components/chart/gauge-chart-11","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#value-out-of-range","content":"Value Out of Range"},"1820":{"id":"/docs/components/chart/gauge-chart-12","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#props","content":"Props"},"1821":{"id":"/docs/components/chart/gauge-chart-13","page_id":"/docs/components/chart/gauge-chart","type":"heading","tags":[],"url":"/docs/components/chart/gauge-chart#gaugechart","content":"GaugeChart"},"1822":{"id":"/docs/components/chart/gauge-chart-14","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#default","content":"A continuous gauge with a single label."},"1823":{"id":"/docs/components/chart/gauge-chart-15","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#continuous-values","content":"Multiple continuous gauges showing different fill percentages."},"1824":{"id":"/docs/components/chart/gauge-chart-16","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#segmented","content":"Segmented gauges divide the arc into discrete sections (1–5). The `value` prop selects how many segments are filled."},"1825":{"id":"/docs/components/chart/gauge-chart-17","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#with-range-labels","content":"Min/max labels positioned below the gauge arc at the left and right edges. Both `min` and `max` must be provided."},"1826":{"id":"/docs/components/chart/gauge-chart-18","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#variants","content":"Color variants convey meaning at a glance — use `success`, `warning`, or `critical` alongside descriptive text."},"1827":{"id":"/docs/components/chart/gauge-chart-19","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#label-type","content":"Control the font size of the primary label using `labelType`. Use `'value'` for numeric or percentage values and `'text'` for short descriptive strings."},"1828":{"id":"/docs/components/chart/gauge-chart-20","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#gauge-not-sizing-correctly","content":"The component uses `container-type: inline-size` and fills its parent width. Ensure the parent has a defined width:"},"1829":{"id":"/docs/components/chart/gauge-chart-21","page_id":"/docs/components/chart/gauge-chart","tags":[],"type":"text","url":"/docs/components/chart/gauge-chart#value-out-of-range","content":"Values outside the valid range are clamped silently at runtime. For continuous mode the range is 0–100; for segmented mode the range is 0 to the segment count."},"1830":{"id":"/docs/components/chart/line-chart","page_id":"/docs/components/chart/line-chart","type":"page","content":"LineChart","breadcrumbs":["Docs","Components","Chart"],"tags":[],"url":"/docs/components/chart/line-chart"},"1831":{"id":"/docs/components/chart/line-chart-0","page_id":"/docs/components/chart/line-chart","tags":[],"type":"text","url":"/docs/components/chart/line-chart","content":"Line Chart shows how something changes over time or along a continuous scale. It connects data points with lines so people can quickly spot trends, peaks, dips, and patterns."},"1832":{"id":"/docs/components/chart/line-chart-1","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#installation","content":"Installation"},"1833":{"id":"/docs/components/chart/line-chart-2","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#examples","content":"Examples"},"1834":{"id":"/docs/components/chart/line-chart-3","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#default","content":"Default"},"1835":{"id":"/docs/components/chart/line-chart-4","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#multiple-series","content":"Multiple series"},"1836":{"id":"/docs/components/chart/line-chart-5","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#gridlines","content":"Gridlines"},"1837":{"id":"/docs/components/chart/line-chart-6","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#titles","content":"Titles"},"1838":{"id":"/docs/components/chart/line-chart-7","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#labels","content":"Labels"},"1839":{"id":"/docs/components/chart/line-chart-8","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#ticks","content":"Ticks"},"1840":{"id":"/docs/components/chart/line-chart-9","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#baselines","content":"Baselines"},"1841":{"id":"/docs/components/chart/line-chart-10","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#legend","content":"Legend"},"1842":{"id":"/docs/components/chart/line-chart-11","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#axis-and-tooltip-formatting","content":"Axis and tooltip formatting"},"1843":{"id":"/docs/components/chart/line-chart-12","page_id":"/docs/components/chart/line-chart","type":"heading","tags":[],"url":"/docs/components/chart/line-chart#custom-accessors","content":"Custom accessors"},"1844