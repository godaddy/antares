docs/components/progress-bar-11","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#default","content":"A determinate progress bar with a label and helper text."},"1105":{"id":"/docs/components/progress-bar-12","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#sizes","content":"Three track heights are available: `xs` (6px), `sm` (12px), and `md` (24px)."},"1106":{"id":"/docs/components/progress-bar-13","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#statuses","content":"Use the `status` prop to communicate intent: `default`, `success`, `warning`, or `critical`. Pair with `helperText` to provide additional context."},"1107":{"id":"/docs/components/progress-bar-14","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#indeterminate","content":"Use indeterminate progress while preparing an upload whose total size is unknown.\nOnce the total is known, set `isIndeterminate` to false and supply a measured value."},"1108":{"id":"/docs/components/progress-bar-15","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#aria-support","content":"`role=\"progressbar\"` on the container"},"1109":{"id":"/docs/components/progress-bar-16","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#aria-support","content":"`aria-valuenow` is omitted while indeterminate; otherwise it reflects the current value"},"1110":{"id":"/docs/components/progress-bar-17","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/components/progress-bar#aria-support","content":"`aria-valuemin` and `aria-valuemax` define the range (default `0`–`100`)"},"1111":{"id":"/docs/components/progress-bar-18","page_id":"/docs/components/progress-bar","tags":[],"type":"text","url":"/docs/compone