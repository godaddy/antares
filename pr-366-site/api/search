id":"/docs/components/accordion-45","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#best-practices","content":"Keep form validation and step progression in application logic."},"102":{"id":"/docs/components/accordion-46","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#controlled-state-not-updating","content":"Update `expandedKeys` from `onExpandedChange` and make sure the keys match the item IDs.\nChanging `defaultExpandedKeys` after mounting does not control expansion."},"103":{"id":"/docs/components/accordion-47","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#sections-close-when-another-opens","content":"Enable `allowsMultipleExpanded` when several sections should remain open together.\nFor a single independent section, use Collapsible without an Accordion."},"104":{"id":"/docs/components/avatar","page_id":"/docs/components/avatar","type":"page","content":"Avatar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/avatar"},"105":{"id":"/docs/components/avatar-0","page_id":"/docs/components/avatar","tags":[],"type":"text","url":"/docs/components/avatar","content":"A visual representation of a user or entity, shown as a photo or a monogram of their initials."},"106":{"id":"/docs/components/avatar-1","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#features","content":"Features"},"107":{"id":"/docs/components/avatar-2","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#installation","content":"Installation"},"108":{"id":"/docs/components/avatar-3","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#examples","content":"Examples"},"109":{"id":"/docs/components/avatar-4","page_id":"/docs/components/avatar","type":"heading","tags":[],"url":"/docs/components/avatar#default","cont