d group state."},"77":{"id":"/docs/components/accordion-21","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#features","content":"Group-level disabled state."},"78":{"id":"/docs/components/accordion-22","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#features","content":"Composable sections using Collapsible and CollapsiblePanel."},"79":{"id":"/docs/components/accordion-23","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#one-section-at-a-time","content":"Let people explore short answers one at a time."},"80":{"id":"/docs/components/accordion-24","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#multiple-sections-open","content":"Keep related answers visible together when people need to compare information."},"81":{"id":"/docs/components/accordion-25","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#controlled","content":"Coordinate expanded sections with application state in either expansion mode."},"82":{"id":"/docs/components/accordion-26","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#disabled","content":"Keep unavailable options visible and explain the reason in their label."},"83":{"id":"/docs/components/accordion-27","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#form-steps","content":"Break a single-page form into steps while keeping entered values mounted."},"84":{"id":"/docs/components/accordion-28","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#nested","content":"Nested sections keep independent state. Prefer a flatter structure when possible."},"85":{"id":"/docs/components/accordion-29","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Compose related `Collapsible` sections inside Accordion. Give each section a stable, unique `id`.\nSee the Collapsible component documentation for more information about section anatomy, panel content, and trigger styling."},"86":{"id":"/docs/components/accordion-30","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Use `defaultExpandedKeys` for initial expansion, or `expandedKeys` with `onExpandedChange` for\ncontrolled state. Keys must match the section IDs; the callback receives a `Set` of expanded keys.\nBy default, only one section can stay open. Set `allowsMultipleExpanded` to keep several open.\nBoth behaviors are shown in the examples."},"87":{"id":"/docs/components/accordion-31","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#customization","content":"Use `className` and `style` to customize the group container. `data-disabled` reflects the group's\ndisabled state. Customize individual headings, triggers, and panels on the composed Collapsible sections."},"88":{"id":"/docs/components/accordion-32","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"Key"},"89":{"id":"/docs/components/accordion-33","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"Action"},"90":{"id":"/docs/components/accordion-34","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"`Tab` / `Shift + Tab`"},"91":{"id":"/docs/components/accordion-35","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/docs/components/accordion#keyboard","content":"Move between enabled triggers and controls in expanded panels"},"92":{"id":"/docs/components/accordion-36","page_id":"/docs/components/accordion","tags":[],"type":"text","url":"/d