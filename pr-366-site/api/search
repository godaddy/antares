","page_id":"/docs/components/text","type":"heading","tags":[],"url":"/docs/components/text#detail-1","content":"Detail"},"1596":{"id":"/docs/components/text-15","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text","content":"`Text` is body copy and `Detail` is supporting copy: captions, metadata, and hints."},"1597":{"id":"/docs/components/text-16","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`Text` applies the body role and `Detail` the detail role, each at the tier of the nearest\n`SizeProvider`, or `md` outside any scope."},"1598":{"id":"/docs/components/text-17","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"Inside a component's named part, such as a field description or a lockup body, the part sets the\ntreatment. Inside a control, the label keeps the control's type, so\n`<Button><Text>Save</Text></Button>` looks exactly like `<Button>Save</Button>`."},"1599":{"id":"/docs/components/text-18","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`size` picks a step on the component's own ramp (`xs` to `2xl`) and changes only the font size."},"1600":{"id":"/docs/components/text-19","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"`emphasis` picks a feedback color and changes only the color."},"1601":{"id":"/docs/components/text-20","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#features","content":"For semantic emphasis, render `as=\"strong\"` or `as=\"em\"`."},"1602":{"id":"/docs/components/text-21","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#default","content":"Basic text content."},"1603":{"id":"/docs/components/text-22","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#as","content":"Setting the `as` prop allows you to change the HTML tag of the `Text` component."},"1604":{"id":"/docs/components/text-23","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#align","content":"Setting the `align` prop allows you to change the alignment of the text. Choose from `start`, `center`, `end`, or `justify`; the logical keywords support RTL languages."},"1605":{"id":"/docs/components/text-24","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#max-lines","content":"Setting the `maxLines` prop limits the number of displayed lines using an ellipsis."},"1606":{"id":"/docs/components/text-25","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#wrap","content":"Setting the `wrap` prop controls text wrapping with values such as `wrap`, `nowrap`, `balance`, `pretty`, or `stable`."},"1607":{"id":"/docs/components/text-26","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#sizes","content":"Without `size`, text takes the scope's body tier, or `md` outside any scope. `size` picks a step\non the body ramp and changes only the font size."},"1608":{"id":"/docs/components/text-27","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#emphasis","content":"`emphasis` selects a feedback color and changes nothing else. Without it, text inherits the\nsurrounding color."},"1609":{"id":"/docs/components/text-28","page_id":"/docs/components/text","tags":[],"type":"text","url":"/docs/components/text#detail","content":"`Detail` is supporting copy, such as captions and metadata, on the detail ramp. It keeps the\nsurrounding color; add `emphasis=\"passive\"` to mute it."},"1610":{"id":"/docs/components/tabs","page_id":"/docs/components/tabs","type":"page","content":"Tabs","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tabs"},"1611":{"id":"/docs/components/tabs-0","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs","content":"Tabs organize peer sections of content and let users switch between them without leaving the page."},"1612":{"id":"/docs/components/tabs-1","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#features","content":"Features"},"1613":{"id":"/docs/components/tabs-2","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#installation","content":"Installation"},"1614":{"id":"/docs/components/tabs-3","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#examples","content":"Examples"},"1615":{"id":"/docs/components/tabs-4","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#default","content":"Default"},"1616":{"id":"/docs/components/tabs-5","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#controlled","content":"Controlled"},"1617":{"id":"/docs/components/tabs-6","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#disabled","content":"Disabled"},"1618":{"id":"/docs/components/tabs-7","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#manilla","content":"Manilla"},"1619":{"id":"/docs/components/tabs-8","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#overflow","content":"Overflow"},"1620":{"id":"/docs/components/tabs-9","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#rtl","content":"RTL"},"1621":{"id":"/docs/components/tabs-10","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#accessibility","content":"Accessibility"},"1622":{"id":"/docs/components/tabs-11","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#customization","content":"Customization"},"1623":{"id":"/docs/components/tabs-12","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#best-practices","content":"Best Practices"},"1624":{"id":"/docs/components/tabs-13","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#props","content":"Props"},"1625":{"id":"/docs/components/tabs-14","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#tabs","content":"Tabs"},"1626":{"id":"/docs/components/tabs-15","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#tablist","content":"TabList"},"1627":{"id":"/docs/components/tabs-16","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#tab","content":"Tab"},"1628":{"id":"/docs/components/tabs-17","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#tabpanels","content":"TabPanels"},"1629":{"id":"/docs/components/tabs-18","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#tabpanel","content":"TabPanel"},"1630":{"id":"/docs/components/tabs-19","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Accessible Tabs semantics powered by React Aria Components."},"1631":{"id":"/docs/components/tabs-20","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Underline and Manilla visual treatments."},"1632":{"id":"/docs/components/tabs-21","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Controlled and uncontrolled selection."},"1633":{"id":"/docs/components/tabs-22","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Automatic horizontal overflow controls that move one tab at a time."},"1634":{"id":"/docs/components/tabs-23","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#features","content":"Localized labels for the automatic overflow controls."},"1635":{"id":"/docs/components/tabs-24","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#default","content":"Switch between peer sections of content on the same page."},"1636":{"id":"/docs/components/tabs-25","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#controlled","content":"Control the selected panel from application state."},"1637":{"id":"/docs/components/tabs-26","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#disabled","content":"Disable a section while keeping the remaining sections available."},"1638":{"id":"/docs/components/tabs-27","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#manilla","content":"Use the folder-style Manilla treatment for document-oriented sections."},"1639":{"id":"/docs/components/tabs-28","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#overflow","content":"When the tab strip is narrower than its content, the group adds controls that move one tab at a time."},"1640":{"id":"/docs/components/tabs-29","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#rtl","content":"Overflow controls follow the logical reading direction."},"1641":{"id":"/docs/components/tabs-30","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"Tabs require an accessible label on `TabList`. Use the keyboard to move between tabs with the arrow keys. Disabled tabs are skipped. Use `keyboardActivation=\"manual\"` when focus should move independently of selection."},"1642":{"id":"/docs/components/tabs-31","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"`overflowLabels` is optional and defaults to \"Previous tabs\" and \"Next tabs\". Provide localized labels when needed; they should describe the logical direction rather than physical directions like \"left\" or \"right\", as the component automatically handles RTL layouts."},"1643":{"id":"/docs/components/tabs-32","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#accessibility","content":"`TabList` must be rendered inside `Tabs` and must provide `aria-label` or `aria-labelledby`. Give each `Tab` and its corresponding `TabPanel` the same `id`; React Aria uses that key to build their accessible relationship."},"1644":{"id":"/docs/components/tabs-33","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"The component exposes state through data attributes:"},"1645":{"id":"/docs/components/tabs-34","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`Tabs`: `data-design=\"underline\"` or `data-design=\"manilla\"`."},"1646":{"id":"/docs/components/tabs-35","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`Tab`: `data-selected`, `data-hovered`, `data-pressed`, `data-focus-visible`, and `data-disabled`."},"1647":{"id":"/docs/components/tabs-36","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"`TabPanel`: `data-inert` when a force-mounted inactive panel is not interactive."},"1648":{"id":"/docs/components/tabs-37","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"Use these attributes to extend styling without replacing the accessibility behavior supplied by React Aria Components. You can also use render props in `className` to style based on state (e.g., `className={({ isSelected }) => isSelected ? 'active' : ''}`)."},"1649":{"id":"/docs/components/tabs-38","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#customization","content":"Use `TabList`'s `containerProps` to customize the outer tab list shell, such as increasing its width."},"1650":{"id":"/docs/components/tabs-39","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Use Tabs for peer panels on the same page and URL."},"1651":{"id":"/docs/components/tabs-40","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Keep the number of tabs small enough for users to understand the available sections."},"1652":{"id":"/docs/components/tabs-41","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not use Tabs for primary application navigation or route changes."},"1653":{"id":"/docs/components/tabs-42","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#best-practices","content":"Do not render a standalone `Tab`; compose it inside `Tabs` and `TabList`."},"1654":{"id":"/docs/components/text-area","page_id":"/docs/components/text-area","type":"page","content":"TextArea","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-area"},"1655":{"id":"/docs/components/text-area-0","page_id":"/docs/components/text-area","tags":[],"type":"text","url":"/docs/components/text-area","content":"Multiline text control for use inside a field."},"1656":{"id":"/docs/components/text-area-1","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#installation","content":"Installation"},"1657":{"id":"/docs/components/text-area-2","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#examples","content":"Examples"},"1658":{"id":"/docs/components/text-area-3","page_id":"/docs/components/text-area","type":"heading","tags":[],"url":"/docs/components/text-area#default","cont