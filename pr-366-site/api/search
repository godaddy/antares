mponents/range-field#troubleshooting","content":"Troubleshooting"},"1190":{"id":"/docs/components/range-field-11","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#a-thumb-is-missing-a-label-or-form-value","content":"A thumb is missing a label or form value"},"1191":{"id":"/docs/components/range-field-12","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#typescript-reports-the-wrong-callback-value-type","content":"TypeScript reports the wrong callback value type"},"1192":{"id":"/docs/components/range-field-13","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-controlled-thumbs-do-not-move","content":"The controlled thumbs do not move"},"1193":{"id":"/docs/components/range-field-14","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#values-snap-unexpectedly","content":"Values snap unexpectedly"},"1194":{"id":"/docs/components/range-field-15","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-final-marker-is-missing","content":"The final marker is missing"},"1195":{"id":"/docs/components/range-field-16","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#markers-are-crowded-or-rendering-is-slow","content":"Markers are crowded or rendering is slow"},"1196":{"id":"/docs/components/range-field-17","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-value-or-endpoint-labels-are-blank","content":"The value or endpoint labels are blank"},"1197":{"id":"/docs/components/range-field-18","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#negative-values-do-not-behave-as-expected","content":"Negative values do not behave as expected"},"1198":{"id":"/docs/components/range-field-19","page_id":"/docs/components/range-field","type":"heading","tags":[],"url":"/docs/components/range-field#the-range-configuration-is-invalid","content":"The range configuration is invalid"},"1199":{"id":"/docs/components/range-field-20","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Select one value or render one thumb for each value in an array"},"1200":{"id":"/docs/components/range-field-21","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Supports controlled and uncontrolled values with typed change callbacks"},"1201":{"id":"/docs/components/range-field-22","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Provides localized value output, endpoint labels, descriptions, and markers"},"1202":{"id":"/docs/components/range-field-23","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#features","content":"Integrates with native forms, keyboard, pointer, and touch interaction through React Aria"},"1203":{"id":"/docs/components/range-field-24","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#examples","content":"import { ArgTypes, Meta } from '@storybook/addon"},"1204":{"id":"/docs/components/range-field-25","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#examples","content":"import { ArgTypes, Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storyb"},"1205":{"id":"/docs/components/range-field-26","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"For a single value, prefer a visible `label`; use `aria-label` only when equivalent visible context already exists."},"1206":{"id":"/docs/components/range-field-27","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"For an array, provide one descriptive `thumbLabels` entry for every value. Entries are matched by index, so keep them aligned when values are added, removed, or reordered. Describe each thumb's purpose, such as `Lower warning threshold`, rather than its current number."},"1207":{"id":"/docs/components/range-field-28","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#accessible-names","content":"`thumbNames` configures native form field names and does not provide accessible labels. Likewise, `valueLabel`, `minLabel`, and `maxLabel` are visual context rather than substitutes for accessible naming."},"1208":{"id":"/docs/components/range-field-29","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Each thumb follows the React Aria slider keyboard model:"},"1209":{"id":"/docs/components/range-field-30","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Tab and Shift+Tab move among thumbs and surrounding controls."},"1210":{"id":"/docs/components/range-field-31","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Arrow Right and Arrow Up increase the focused value by `step`."},"1211":{"id":"/docs/components/range-field-32","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Arrow Left and Arrow Down decrease the focused value by `step`."},"1212":{"id":"/docs/components/range-field-33","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Home and End move the focused thumb to its permitted bounds."},"1213":{"id":"/docs/components/range-field-34","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Page Up and Page Down make larger changes."},"1214":{"id":"/docs/components/range-field-35","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Directional behavior follows the user's locale where appropriate. Pointer, touch, and keyboard interaction all use the same scale and constraints."},"1215":{"id":"/docs/components/range-field-36","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#keyboard-interaction","content":"Markers are decorative and hidden from the accessibility tree. Ensure the field label, thumb labels, bounds, step, and formatted values communicate all required information without relying on marker appearance."},"1216":{"id":"/docs/components/range-field-37","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use an array only when every entry has a clear, independently adjustable meaning."},"1217":{"id":"/docs/components/range-field-38","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Keep `value`, `thumbLabels`, and `thumbNames` aligned by index."},"1218":{"id":"/docs/components/range-field-39","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use thumb labels that explain purpose instead of repeating the current number."},"1219":{"id":"/docs/components/range-field-40","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Keep array values in a stable semantic order. If crossing or reordering thumbs would make their meaning ambiguous, enforce the appropriate ordering in product state."},"1220":{"id":"/docs/components/range-field-41","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Avoid large value arrays. Every entry creates another focusable control, which increases keyboard effort and cognitive load."},"1221":{"id":"/docs/components/range-field-42","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Set meaningful `minValue`, `maxValue`, and `step` values. The scale should match the precision users actually need."},"1222":{"id":"/docs/components/range-field-43","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use markers only when there are few enough steps to scan. Tiny steps across a large range can create an excessive number of DOM elements."},"1223":{"id":"/docs/components/range-field-44","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `formatOptions` for currency, percentages, measurements, and other locale-sensitive units so values display and announce their meaning."},"1224":{"id":"/docs/components/range-field-45","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `description` for persistent guidance and `isRequired` when a value is required."},"1225":{"id":"/docs/components/range-field-46","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `isDisabled` when the value should remain visible but unavailable for interaction."},"1226":{"id":"/docs/components/range-field-47","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use `onChange` for lightweight immediate feedback and `onChangeEnd` for expensive requests, filtering, or calculations."},"1227":{"id":"/docs/components/range-field-48","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#best-practices","content":"Use a text-entry control when exact numeric input is essential. A track is best for exploring or adjusting values within known bounds."},"1228":{"id":"/docs/components/range-field-49","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#a-thumb-is-missing-a-label-or-form-value","content":"Check the same index in `thumbLabels` and `thumbNames`. Each array entry renders a thumb, and its accessible label and form name are read from the corresponding positions. A form name does not replace an accessible label."},"1229":{"id":"/docs/components/range-field-50","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#typescript-reports-the-wrong-callback-value-type","content":"Keep the controlled or default value and callback signatures consistent. When inference is unavailable, provide the generic explicitly: `<RangeField<number>>` for a scalar or `<RangeField<number[]>>` for an array."},"1230":{"id":"/docs/components/range-field-51","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-controlled-thumbs-do-not-move","content":"The `value` prop is the source of truth. Update the scalar or array in `onChange` without changing its intended shape. For arrays, return a new array so application state observes the update."},"1231":{"id":"/docs/components/range-field-52","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#values-snap-unexpectedly","content":"Verify that `step` represents the intended interval from `minValue`. Every thumb snaps to valid positions on the same configured scale."},"1232":{"id":"/docs/components/range-field-53","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-final-marker-is-missing","content":"Markers begin at `minValue` and appear at complete step positions. `maxValue` receives a marker only when the range is evenly divisible by `step`."},"1233":{"id":"/docs/components/range-field-54","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#markers-are-crowded-or-rendering-is-slow","content":"Increase `step` or omit `markers`. Large ranges with small steps can produce many decorative elements even when users cannot distinguish them visually."},"1234":{"id":"/docs/components/range-field-55","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-value-or-endpoint-labels-are-blank","content":"Enable automatic current-value output with `valueLabel={true}` or provide custom content. `minLabel` and `maxLabel` display only explicitly supplied content; neither defaults to a numeric bound or receives `formatOptions`."},"1235":{"id":"/docs/components/range-field-56","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#negative-values-do-not-behave-as-expected","content":"Negative values are supported. Set a negative `minValue` and ensure every scalar or array value remains within the configured bounds."},"1236":{"id":"/docs/components/range-field-57","page_id":"/docs/components/range-field","tags":[],"type":"text","url":"/docs/components/range-field#the-range-configuration-is-invalid","content":"Provide finite bounds where `minValue` is less than `maxValue`, a finite `step` greater than zero, and finite values inside the configured range."},"1237":{"id":"/docs/components/responsive","page_id":"/docs/components/responsive","type":"page","content":"Responsive","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/responsive"},"1238":{"id":"/docs/components/responsive-0","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive","content":"How Antares components adapt, and how to build responsive layouts around them with native CSS."},"1239":{"id":"/docs/components/responsive-1","page_id":"/docs/components/responsive","type":"heading","tags":[],"url":"/docs/components/responsive#features","content":"Features"},"1240":{"id":"/docs/components/responsive-2","page_id":"/docs/components/responsive","type":"heading","tags":[],"url":"/docs/components/responsive#examples","content":"Examples"},"1241":{"id":"/docs/components/responsive-3","page_id":"/docs/components/responsive","type":"heading","tags":[],"url":"/docs/components/responsive#customization","content":"Customization"},"1242":{"id":"/docs/components/responsive-4","page_id":"/docs/components/responsive","type":"heading","tags":[],"url":"/docs/components/responsive#responsive-size-1","content":"Responsive size"},"1243":{"id":"/docs/components/responsive-5","page_id":"/docs/components/responsive","type":"heading","tags":[],"url":"/docs/components/responsive#accessibility","content":"Accessibility"},"1244":{"id":"/docs/components/responsive-6","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#features","content":"Components adapt to the space they are given with intrinsic CSS and container queries."},"1245":{"id":"/docs/components/responsive-7","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#features","content":"Page layout stays in your CSS, with your own media queries and breakpoints."},"1246":{"id":"/docs/components/responsive-8","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#features","content":"Component sizes can follow `--antares-size`, so your CSS can change them at any breakpoint."},"1247":{"id":"/docs/components/responsive-9","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#features","content":"Responsive styles are plain CSS, so server rendering needs no viewport guess."},"1248":{"id":"/docs/components/responsive-10","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#examples","content":"import { Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './responsive.stories.tsx';\n\n<Me"},"1249":{"id":"/docs/components/responsive-11","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#examples","content":"import { Meta } from '@storybook/addon-docs/blocks';\nimport { Examples } from '@bento/storybook-addon-helpers/runtime';\nimport * as Stories from './responsive.stories.tsx';\n\n\n\n## Features\n\n- Components adapt to the space they are given with intrinsic CSS a"},"1250":{"id":"/docs/components/responsive-12","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#customization","content":"Antares publishes no viewport breakpoints. Components don't change by viewport width, except overlays\nsuch as Modal and Drawer, which document their own thresholds. Choose the breakpoints your layout needs,\nand write them in your own media or container queries."},"1251":{"id":"/docs/components/responsive-13","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#customization","content":"The examples include their CSS in `<style>` blocks so the complete code is visible. Applications can\nplace those rules in their own stylesheets. Layout props such as `columns` and `gap` write inline styles,\nwhich beat stylesheet rules. When your CSS changes a property across a query, set it in CSS for every\nwidth and leave the prop unset."},"1252":{"id":"/docs/components/responsive-14","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#customization","content":"A container can't take its width from its content, so give it one from its parent, as the container\nexample does with the `flex` basis of its sidebar and main area. Otherwise it collapses in flex rows and\nother shrink-to-fit layouts. Portaled content is outside the container, so it needs a container in its\nown DOM ancestry."},"1253":{"id":"/docs/components/responsive-15","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#customization","content":"In media queries, `rem` uses the browser's initial font size."},"1254":{"id":"/docs/components/responsive-16","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#responsive-size-1","content":"Component props, including `size`, take a single value. For a size that changes with the layout, leave\n`size` unset and set `--antares-size` in your CSS. TextLockup reads it for its text parts, so you can set\nthe variable on the lockup itself or an ancestor. The responsive size example sets it on a parent. The\nnearest value wins, and an explicit `size` beats it. Without the variable, components follow the\nsurrounding `SizeProvider`. Browsers without container style queries ignore the variable."},"1255":{"id":"/docs/components/responsive-17","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#responsive-size-1","content":"These components follow `--antares-size`:"},"1256":{"id":"/docs/components/responsive-18","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#responsive-size-1","content":"| Component    | Values     | Notes                               |\n| ------------ | ---------- | ----------------------------------- |\n| `TextLockup` | `xs`-`2xl` | A `Tag` eyebrow keeps its own size. |","table":"table-0"},"1257":{"id":"/docs/components/responsive-19","page_id":"/docs/components/responsive","tags":[],"type":"text","url":"/docs/components/responsive#accessibility","content":"Preserve reading order, keyboard focus, and entered values as layouts change: reflow one DOM tree with\nCSS instead of rendering different trees. Validate layouts with long text, RTL, narrow widths, text\nenlargement, and browser zoom. Resizing the viewport alone does not test every effect of zoom. Use\npointer and hover media features to detect input capabilities, not widths."},"1258":{"id":"/docs/components/segmented-controller","page_id":"/docs/components/segmented-controller","type":"page","content":"SegmentedController","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/segmented-controller"},"1259":{"id":"/docs/components/segmented-controller-0","page_id":"/docs/components/segmented-controller","tags":[],"type":"text","url":"/docs/components/segmented-controller","content":"A segmented controller is a linear set of two or more segments, each of which functions as a button. A segmented controller allows users to select options, switch views, or sort elements."},"1260":{"id":"/docs/components/segmented-controller-1","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#installation","content":"Installation"},"1261":{"id":"/docs/components/segmented-controller-2","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#examples","content":"Examples"},"1262":{"id":"/docs/components/segmented-controller-3","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#customization","content":"Customization"},"1263":{"id":"/docs/components/segmented-controller-4","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#data-attributes","content":"Data Attributes"},"1264":{"id":"/docs/components/segmented-controller-5","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#accessibility","content":"Accessibility"},"1265":{"id":"/docs/components/segmented-controller-6","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#keyboard-navigation","content":"Keyboard Navigation"},"1266":{"id":"/docs/components/segmented-controller-7","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#aria-support","content":"ARIA Support"},"1267":{"id":"/docs/components/segmented-controller-8","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#best-practices","content":"Best Practices"},"1268":{"id":"/docs/components/segmented-controller-9","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#when-to-use-a-segmented-controller","content":"When to Use a Segmented Controller"},"1269":{"id":"/docs/components/segmented-controller-10","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#when-not-to-use","content":"When Not to Use"},"1270":{"id":"/docs/components/segmented-controller-11","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#props","content":"Props"},"1271":{"id":"/docs/components/segmented-controller-12","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-controller#segmentedcontroller","content":"SegmentedController"},"1272":{"id":"/docs/components/segmented-controller-13","page_id":"/docs/components/segmented-controller","type":"heading","tags":[],"url":"/docs/components/segmented-con