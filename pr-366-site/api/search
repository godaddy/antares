p#menu-filter-trigger","content":"Menu filter trigger"},"396":{"id":"/docs/components/chip-14","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#customization","content":"Customization"},"397":{"id":"/docs/components/chip-15","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#content","content":"Content"},"398":{"id":"/docs/components/chip-16","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#selection-and-removal","content":"Selection and removal"},"399":{"id":"/docs/components/chip-17","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#layout-and-sizing","content":"Layout and sizing"},"400":{"id":"/docs/components/chip-18","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#button-composition","content":"Button composition"},"401":{"id":"/docs/components/chip-19","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#accessibility","content":"Accessibility"},"402":{"id":"/docs/components/chip-20","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#best-practices","content":"Best Practices"},"403":{"id":"/docs/components/chip-21","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#troubleshooting","content":"Troubleshooting"},"404":{"id":"/docs/components/chip-22","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"A ChipGroup has no accessible name"},"405":{"id":"/docs/components/chip-23","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"The remove action does not update the UI"},"406":{"id":"/docs/components/chip-24","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"A composed label is not truncating correctly"},"407":{"id":"/docs/components/chip-25","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"The menu trigger does not look like a Chip"},"408":{"id":"/docs/components/chip-26","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#props","content":"Props"},"409":{"id":"/docs/components/chip-27","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chip","content":"Chip"},"410":{"id":"/docs/components/chip-28","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipgroup","content":"ChipGroup"},"411":{"id":"/docs/components/chip-29","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chiplist","content":"ChipList"},"412":{"id":"/docs/components/chip-30","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#chipbutton","content":"ChipButton"},"413":{"id":"/docs/components/chip-31","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipGroup` + `ChipList` + `Chip` for grouped values, selection, keyboard navigation, and removal"},"414":{"id":"/docs/components/chip-32","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Toggle Chips for selecting multiple peer filters"},"415":{"id":"/docs/components/chip-33","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Removable Chips for user-added filters and input tokens"},"416":{"id":"/docs/components/chip-34","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"Shared `sm`, `md`, and `lg` sizes, with optional leading icons"},"417":{"id":"/docs/components/chip-35","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#features","content":"`ChipButton` for menu filters and other actions with a Chip-like appearance"},"418":{"id":"/docs/components/chip-36","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#default","content":"Start with a labeled group of related values. Add selection or removal when\nthe group needs interactive behavior."},"419":{"id":"/docs/components/chip-37","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#toggle-chips","content":"Use Toggle Chips for multiple peer filters. The Chip render prop supplies\nselection state for the checkmark, while `textValue` names composed content."},"420":{"id":"/docs/components/chip-38","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#removable-chips","content":"Use Removable Chips for user-added filters and tokens. `ChipGroup` reports\nremoved keys through `onRemove`; the owner updates its collection. A\nself-closing `Button` in the `remove` slot supplies each remove control."},"421":{"id":"/docs/components/chip-39","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#controlled-selection","content":"Use `selectedKeys` and `onSelectionChange` when another part of the page\nneeds to own the selected filter state."},"422":{"id":"/docs/components/chip-40","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#sizes","content":"Compare the supported `sm`, `md`, and `lg` sizes. Set `size` on `ChipGroup`\nso every Chip inherits one consistent size."},"423":{"id":"/docs/components/chip-41","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#disabled","content":"Disable individual options with `disabledKeys` when some values are unavailable."},"424":{"id":"/docs/components/chip-42","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#truncation","content":"By default, long labels truncate visually when space is constrained, while\nthe complete accessible value remains available."},"425":{"id":"/docs/components/chip-43","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#empty-state","content":"Give an empty collection useful guidance, then let the user add the first\nvalue. Removable items continue to be owned by the collection."},"426":{"id":"/docs/components/chip-44","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#menu-filter-trigger","content":"Use `ChipButton` for Chip presentation without collection semantics.\n`MenuTrigger` continues to own open state, focus, and keyboard behavior."},"427":{"id":"/docs/components/chip-45","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#content","content":"Use a string for a simple label. For icons or other composed content, wrap the\nvisible label in `Text` and provide `textValue` for the accessible name. See\n**Toggle Chips** and **Removable Chips** above."},"428":{"id":"/docs/components/chip-46","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#selection-and-removal","content":"`ChipGroup` owns selection and removal behavior. Use a Chip render prop for\nstate-dependent content, and `Button` with `slot=\"remove\"` together with\n`onRemove` for removable items. See **Toggle Chips** and **Removable Chips**."},"429":{"id":"/docs/components/chip-47","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#layout-and-sizing","content":"Set `size` on `ChipGroup` to keep a collection consistent. `ChipList` wraps by\ndefault and accepts layout props for custom arrangements. See **Sizes**."},"430":{"id":"/docs/components/chip-48","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#button-composition","content":"Use `ChipButton` when Chip presentation is needed without collection semantics.\nCompose it with components such as `MenuTrigger`; those components continue to\nown open state, focus, and keyboard behavior. See **Menu filter trigger**."},"431":{"id":"/docs/components/chip-49","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use `Label` or `aria-label` to name the `ChipGroup`; this names the collection,\nnot its individual Chips."},"432":{"id":"/docs/components/chip-50","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Give each Chip a visible label, `textValue`, or `aria-label`. Use `textValue`\nwhen a Chip contains icons, composed content, or a render prop."},"433":{"id":"/docs/components/chip-51","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Use a descriptive group label so removal actions can be announced clearly."},"434":{"id":"/docs/components/chip-52","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"Keep the visible label and the accessible value synchronized."},"435":{"id":"/docs/components/chip-53","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#accessibility","content":"`ChipButton` is a real button and exposes menu state through `MenuTrigger`; provide an accessible name when the visible content is incomplete."},"436":{"id":"/docs/components/chip-54","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep labels concise and let them truncate only when the available width requires it."},"437":{"id":"/docs/components/chip-55","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Prefer groups of three or more related values."},"438":{"id":"/docs/components/chip-56","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Keep one size per group."},"439":{"id":"/docs/components/chip-57","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Let `ChipList` wrap instead of forcing a single horizontal line."},"440":{"id":"/docs/components/chip-58","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"Use removable Chips for user-added filters and tokens."},"441":{"id":"/docs/components/chip-59","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#best-practices","content":"For menu filters, use `ChipButton` with `MenuTrigger` and provide the chevron explicitly."},"442":{"id":"/docs/components/chip-60","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-chipgroup-has-no-accessible-name","content":"Add a visible `Label` to the group or provide `aria-label`. For an individual Chip\nwith composed content, provide a visible label, `textValue`, or `aria-label`."},"443":{"id":"/docs/components/chip-61","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-remove-action-does-not-update-the-ui","content":"Add `onRemove` to `ChipGroup` and remove the returned keys from the collection\nowned by your application."},"444":{"id":"/docs/components/chip-62","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#a-composed-label-is-not-truncating-correctly","content":"Keep the label in `Text`, preserve `textValue`, and constrain the available width\nof the surrounding layout. Truncation is visual; the complete accessible value\nshould remain available."},"445":{"id":"/docs/components/chip-63","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#the-menu-trigger-does-not-look-like-a-chip","content":"Use `ChipButton` inside `MenuTrigger`, include the visible value, and add a\ntrailing chevron to communicate that the control opens a menu."},"446":{"id":"/docs/components/chip-64","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip#props","content":"For a menu trigger, the button and menu are composed as siblings inside\n`MenuTrigger`:"},"447":{"id":"/docs/components/collapsible","page_id":"/docs/components/collapsible","type":"page","content":"Collapsible","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/collapsible"},"448":{"id":"/docs/components/collapsible-0","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible","content":"Collapsible reveals or hides a section of content beneath a heading."},"449":{"id":"/docs/components/collapsible-1","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#features","content":"Features"},"450":{"id":"/docs/components/collapsible-2","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#installation","content":"Installation"},"451":{"id":"/docs/components/collapsible-3","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#examples","content":"Examples"},"452":{"id":"/docs/components/collapsible-4","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#default","content":"Default"},"453":{"id":"/docs/components/collapsible-5","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#controlled","content":"Controlled"},"454":{"id":"/docs/components/collapsible-6","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#with-status","content":"With Status"},"455":{"id":"/docs/components/collapsible-7","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#disabled","content":"Disabled"},"456":{"id":"/docs/components/collapsible-8","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#customization","content":"Customization"},"457":{"id":"/docs/components/collapsible-9","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#accessibility","content":"Accessibility"},"458":{"id":"/docs/components/collapsible-10","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#keyboard","content":"Keyboard"},"459":{"id":"/docs/components/collapsible-11","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#aria","content":"ARIA"},"460":{"id":"/docs/components/collapsible-12","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#best-practices","content":"Best Practices"},"461":{"id":"/docs/components/collapsible-13","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#troubleshooting","content":"Troubleshooting"},"462":{"id":"/docs/components/collapsible-14","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#controlled-state-not-updating","content":"Controlled State Not Updating"},"463":{"id":"/docs/components/collapsible-15","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#trigger-not-expanding-the-panel","content":"Trigger Not Expanding the Panel"},"464":{"id":"/docs/components/collapsible-16","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#input-values-persist-after-closing","content":"Input Values Persist After Closing"},"465":{"id":"/docs/components/collapsible-17","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#props","content":"Props"},"466":{"id":"/docs/components/collapsible-18","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#collapsible","content":"Collapsible"},"467":{"id":"/docs/components/collapsible-19","page_id":"/docs/components/collapsible","type":"heading","tags":[],"url":"/docs/components/collapsible#collapsiblepanel","content":"CollapsiblePanel"},"468":{"id":"/docs/components/collapsible-20","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Independent sections with controlled or uncontrolled expansion."},"469":{"id":"/docs/components/collapsible-21","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Composed headings, optional status icons, and flexible panel content."},"470":{"id":"/docs/components/collapsible-22","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Persistent panel content when collapsed."},"471":{"id":"/docs/components/collapsible-23","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#features","content":"Accessible keyboard interaction and button-to-panel relationships powered by React Aria Components."},"472":{"id":"/docs/components/collapsible-24","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#default","content":"Reveal optional details without an Accordion group."},"473":{"id":"/docs/components/collapsible-25","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#controlled","content":"Control a section from application state or an external action."},"474":{"id":"/docs/components/collapsible-26","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#with-status","content":"Pair a status icon with text so completion is understandable without the icon."},"475":{"id":"/docs/components/collapsible-27","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#disabled","content":"Keep unavailable details disabled, including when their content starts visible."},"476":{"id":"/docs/components/collapsible-28","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Place a `Heading` containing `Button slot=\"trigger\"` inside Collapsible, followed by CollapsiblePanel.\nAdd an `Icon slot=\"indicator\"` inside the button for the expansion indicator. The panel accepts text,\nlinks, forms, and other components."},"477":{"id":"/docs/components/collapsible-29","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"CollapsiblePanel provides the content spacing automatically. Use `contentProps` to customize its\ninner container with Box spacing props, a class name, or styles:"},"478":{"id":"/docs/components/collapsible-30","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `contentProps={{ padding: '0' }}` for content without padding. Props supplied directly to\nCollapsiblePanel, including `className`, `style`, and `ref`, apply to the outer panel."},"479":{"id":"/docs/components/collapsible-31","page_id":"/docs/components/collapsible","tags":[],"type":"text","url":"/docs/components/collapsible#customization","content":"Use `defaultExpanded` for initial expansion, or `isExpanded` with `onExpandedChange` for controlled\nstate. The callback receives a boolean. Use the Accordion component to coordinate several sections;\nin that composition, manage expansion through the group."},"480":{"id":"/do