"page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"✅ When all available options should be visible"},"308":{"id":"/docs/components/checkbox-66","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"❌ For mutually exclusive options (use Radio instead)"},"309":{"id":"/docs/components/checkbox-67","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#when-to-use-checkboxes","content":"❌ For simple on/off toggles without labels (use Toggle/Switch instead)"},"310":{"id":"/docs/components/checkbox-68","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Use clear, concise labels that describe what selecting the option means"},"311":{"id":"/docs/components/checkbox-69","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Keep labels short (1-5 words when possible)"},"312":{"id":"/docs/components/checkbox-70","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Ensure labels are descriptive without being verbose"},"313":{"id":"/docs/components/checkbox-71","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#label-guidelines","content":"Place the most commonly selected options first in groups"},"314":{"id":"/docs/components/checkbox-72","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#validation","content":"Always provide clear error messages and use appropriate validation states:"},"315":{"id":"/docs/components/checkbox-73","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Limit checkbox groups to 7-10 options for better usability"},"316":{"id":"/docs/components/checkbox-74","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Use logical ordering (alphabetical, frequency of use, or importance)"},"317":{"id":"/docs/components/checkbox-75","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Consider using CheckboxGroup for related options, even if there are only 2-3"},"318":{"id":"/docs/components/checkbox-76","page_id":"/docs/components/checkbox","tags":[],"type":"text","url":"/docs/components/checkbox#group-organization","content":"Provide a group label that clearly describes the choice being made"},"319":{"id":"/docs/components/chip","page_id":"/docs/components/chip","type":"page","content":"Chip","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/chip"},"320":{"id":"/docs/components/chip-0","page_id":"/docs/components/chip","tags":[],"type":"text","url":"/docs/components/chip","content":"Grouped pill-shaped items for selecting values and removing user-added filters or tokens."},"321":{"id":"/docs/components/chip-1","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#features","content":"Features"},"322":{"id":"/docs/components/chip-2","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#installation","content":"Installation"},"323":{"id":"/docs/components/chip-3","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#quick-start","content":"Quick start"},"324":{"id":"/docs/components/chip-4","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#examples","content":"Examples"},"325":{"id":"/docs/components/chip-5","page_id":"/docs/components/chip","type":"heading","tags":[],"url":"/docs/components/chip#default","content":"Default"},"326":{"id":"/docs/components/chi